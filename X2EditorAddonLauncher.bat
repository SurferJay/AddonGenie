            /// <summary>
            /// A turning ring, as the status pill's, in ink (null: grey). Turns only while shown, so a hidden one costs
            /// nothing. Each time it's shown it starts its turn over, so one replaced by a new one on every update
            /// jumps back: keep the same one while the work goes on (a Border's Child set to what it holds already
            /// changes nothing). Example: Package Loader's running job, in place of its play icon.
            /// </summary>
            public static FrameworkElement CreateSpinner(double size = 14, Brush ink = null) {
                System.Windows.Media.RotateTransform turn = new System.Windows.Media.RotateTransform(0, 7, 7);
                Canvas ring = new Canvas { Width = 14, Height = 14, RenderTransform = turn };
                ring.Children.Add(new System.Windows.Shapes.Path {
                    Data            = Geometry.Parse("M 7,1 A 6,6 0 1 1 6.99,1"),
                    Stroke          = ink ?? Theme.NeutralTagBorder,
                    StrokeThickness = 2,
                    Opacity         = ink == null ? 1 : 0.3,
                });
                ring.Children.Add(new System.Windows.Shapes.Path {
                    Data               = Geometry.Parse("M 7,1 A 6,6 0 0 1 13,7"),
                    Stroke             = ink ?? Theme.NeutralTagText,
                    StrokeThickness    = 2,
                    StrokeStartLineCap = PenLineCap.Round,
                    StrokeEndLineCap   = PenLineCap.Round,
                });
                Viewbox spinner = new Viewbox {
                    Child             = ring,
                    Width             = size,
                    Height            = size,
                    VerticalAlignment = VerticalAlignment.Center,
                    IsHitTestVisible  = false,
                };
                spinner.IsVisibleChanged += delegate {
                    System.Windows.Media.Animation.DoubleAnimation spin = null;
                    if (spinner.IsVisible) {
                        spin = new System.Windows.Media.Animation.DoubleAnimation(
                            0, 360, new Duration(TimeSpan.FromSeconds(0.9)));
                        spin.RepeatBehavior = System.Windows.Media.Animation.RepeatBehavior.Forever;
                    }
                    turn.BeginAnimation(System.Windows.Media.RotateTransform.AngleProperty, spin);
                };
                return spinner;
            }

