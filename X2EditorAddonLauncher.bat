    // What a window on its own thread gets from the UI thread.
    internal sealed class OwnThreadHome {
        internal IntPtr           Frame;
        internal int?             Left, Top;     // remembered, device pixels
        internal int              PillWidth;     // remembered, DIPs; 0 for none
        internal Action<int, int> SavePosition;  // callable from any thread
        internal Action<int>      SavePillWidth; // callable from any thread
    }

    // Keeps a window on its own thread where one owned by the editor would be: above the editor and its windows, under
    // other apps, hidden while the frame is minimized, gone with it. It can't really be owned: Windows joins the input
    // of owner and owned windows across threads, so a busy editor would freeze it. Over the editor it's topmost; a
    // hung frame counts as in front, as Windows then puts a ghost of it in front in another process's name. Win events
    // arrive through this thread's message loop and never wait on the editor; nor do the calls made here.
    internal sealed class EditorFollower {
        private const uint EVENT_SYSTEM_FOREGROUND    = 0x0003;
        private const uint EVENT_SYSTEM_MINIMIZESTART = 0x0016;
        private const uint EVENT_SYSTEM_MINIMIZEEND   = 0x0017;
        private const uint EVENT_OBJECT_DESTROY       = 0x8001;
        private const uint WINEVENT_OUTOFCONTEXT      = 0;
        private const uint SWP_NOSIZE                 = 0x0001;
        private const uint SWP_NOMOVE                 = 0x0002;
        private const uint SWP_NOACTIVATE             = 0x0010;
        private const uint GW_HWNDPREV                = 3;
        private const int  GWL_EXSTYLE                = -20;
        private const int  WS_EX_TOPMOST              = 0x00000008;
        private const int  SW_HIDE                    = 0;
        private const int  SW_SHOWNOACTIVATE          = 4;

        private static readonly IntPtr HWND_TOPMOST   = new IntPtr(-1);
        private static readonly IntPtr HWND_NOTOPMOST = new IntPtr(-2);

        private delegate void WinEventProc(IntPtr hook, uint evt, IntPtr hwnd, int obj, int child, uint thread,
                                           uint time);

        [DllImport("user32.dll")]
        private static extern IntPtr SetWinEventHook(uint min, uint max, IntPtr module, WinEventProc proc, uint pid,
                                                     uint thread, uint flags);
        [DllImport("user32.dll")]
        private static extern bool UnhookWinEvent(IntPtr hook);
        [DllImport("user32.dll")]
        private static extern IntPtr GetForegroundWindow();
        [DllImport("user32.dll")]
        private static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
        [DllImport("user32.dll")]
        private static extern bool IsHungAppWindow(IntPtr h);
        [DllImport("user32.dll")]
        private static extern bool IsIconic(IntPtr h);
        [DllImport("user32.dll")]
        private static extern IntPtr GetWindow(IntPtr h, uint cmd);
        [DllImport("user32.dll", EntryPoint = "GetWindowLongW")]
        private static extern int GetWindowLong(IntPtr h, int index);
        [DllImport("user32.dll")]
        private static extern bool ShowWindow(IntPtr h, int cmd);
        [DllImport("user32.dll")]
        private static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int cx, int cy, uint flags);

        private readonly IntPtr       _window, _frame;
        private readonly uint         _process;
        private readonly Action       _onFrameGone;
        private readonly WinEventProc _proc; // kept alive: the hooks call it
        private readonly              IntPtr[] _hooks;

        internal EditorFollower(IntPtr window, IntPtr frame, Action onFrameGone) {
            _window      = window;
            _frame       = frame;
            _onFrameGone = onFrameGone;
            _proc        = OnEvent;
            uint thread  = GetWindowThreadProcessId(frame, out _process);
            _hooks       = new[] {
                Hook(EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, 0, 0), // any app's, to see the editor lose it
                Hook(EVENT_SYSTEM_MINIMIZESTART, EVENT_SYSTEM_MINIMIZEEND, _process, thread),
                Hook(EVENT_OBJECT_DESTROY, EVENT_OBJECT_DESTROY, _process, thread),
            };
            if (IsIconic(frame)) ShowWindow(window, SW_HIDE);
            Stack();
        }

        internal void Stop() {
            foreach (IntPtr hook in _hooks) {
                if (hook != IntPtr.Zero) UnhookWinEvent(hook);
            }
        }

        private IntPtr Hook(uint first, uint last, uint process, uint thread) {
            return SetWinEventHook(first, last, IntPtr.Zero, _proc, process, thread, WINEVENT_OUTOFCONTEXT);
        }

        private void OnEvent(IntPtr hook, uint evt, IntPtr hwnd, int obj, int child, uint thread, uint time) {
            try {
                if (evt == EVENT_SYSTEM_FOREGROUND)
                    Stack();
                else if (hwnd != _frame)
                    return;
                else if (evt == EVENT_SYSTEM_MINIMIZESTART)
                    ShowWindow(_window, SW_HIDE);
                else if (evt == EVENT_SYSTEM_MINIMIZEEND)
                    ShowWindow(_window, SW_SHOWNOACTIVATE);
                else if (obj == 0 && child == 0) // the window itself
                    _onFrameGone();
            } catch {} // cosmetic; never let it break the editor
        }

        private void Stack() {
            const uint Flags      = SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE;
            IntPtr     foreground = GetForegroundWindow();
            if (foreground == IntPtr.Zero) return; // between two windows; the next event settles it
            uint process;
            GetWindowThreadProcessId(foreground, out process);
            if (process == _process || IsHungAppWindow(_frame)) {
                SetWindowPos(_window, HWND_TOPMOST, 0, 0, 0, 0, Flags);
                return;
            }
            SetWindowPos(_window, HWND_NOTOPMOST, 0, 0, 0, 0, Flags);
            IntPtr above = GetWindow(_frame, GW_HWNDPREV); // going under it puts this right over the frame
            if (above != IntPtr.Zero && above != _window && (GetWindowLong(above, GWL_EXSTYLE) & WS_EX_TOPMOST) == 0)
                SetWindowPos(_window, above, 0, 0, 0, 0, Flags);
        }
    }

    // A floating Content Browser is a top-level window owned by the editor frame, as ours are, so focusing it brings
    // it over them. When it takes the foreground, it goes back under the lowest of ours, still active. Nothing else
    // moves: windows above ours, such as a prompt that opened as the browser took the foreground (this event arrives
    // a moment late), stay above. Lifting ours to the top instead covered those prompts. SWP_NOOWNERZORDER, or its
    // owned windows (its prompts) would go down with it. Docked in another floating window, that window is the
    // browser's. Hooked once, for the session: foreground changes in this process only, delivered on the UI thread's
    // message loop.
    internal static class BrowserBelowOurs {
        private const uint EVENT_SYSTEM_FOREGROUND = 3;
        private const uint WINEVENT_OUTOFCONTEXT   = 0;
        private const uint GA_ROOT                 = 2;
        private const uint SWP_NOSIZE              = 0x0001;
        private const uint SWP_NOMOVE              = 0x0002;
        private const uint SWP_NOACTIVATE          = 0x0010;
        private const uint SWP_NOOWNERZORDER       = 0x0200;

        private delegate void WinEventProc(IntPtr hook, uint evt, IntPtr hwnd, int obj, int child, uint thread,
                                           uint time);
        private delegate bool EnumWindowsProc(IntPtr h, IntPtr p);

        [DllImport("user32.dll")]
        private static extern IntPtr SetWinEventHook(uint min, uint max, IntPtr module, WinEventProc proc, uint pid,
                                                     uint thread, uint flags);
        [DllImport("user32.dll")]
        private static extern bool EnumWindows(EnumWindowsProc cb, IntPtr p);
        [DllImport("user32.dll")]
        private static extern IntPtr GetAncestor(IntPtr h, uint flags);
        [DllImport("user32.dll")]
        private static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int cx, int cy, uint flags);

        private static WinEventProc _proc; // kept alive: the hook calls it for the whole session
        private static IntPtr       _hook;

        internal static void Start() {
            if (_hook != IntPtr.Zero) return;
            _proc = OnForeground;
            _hook = SetWinEventHook(EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, IntPtr.Zero, _proc,
                                    (uint)System.Diagnostics.Process.GetCurrentProcess().Id, 0,
                                    WINEVENT_OUTOFCONTEXT);
            if (_hook == IntPtr.Zero)
                GenieBootstrap.Log("Couldn't watch the foreground window, so the Content Browser can cover addon " +
                                   "windows.");
        }

        private static void OnForeground(IntPtr hook, uint evt, IntPtr hwnd, int obj, int child, uint thread,
                                         uint time) {
            try {
                if (hwnd == IntPtr.Zero || hwnd != BrowserWindow()) return;
                IntPtr          lowest = IntPtr.Zero; // EnumWindows goes front to back, so the last of ours seen
                EnumWindowsProc cb     = delegate(IntPtr h, IntPtr p) {
                    if (GenieWindow.IsShownWindow(h)) lowest = h;
                    return true;
                };
                EnumWindows(cb, IntPtr.Zero);
                GC.KeepAlive(cb);
                if (lowest == IntPtr.Zero) return; // none of ours showing
                SetWindowPos(hwnd, lowest, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
            } catch {} // cosmetic; never let it break the editor
        }

        // The top-level window holding the Content Browser, or zero if none or it's in the editor frame (already
        // under ours).
        private static IntPtr BrowserWindow() {
            System.Windows.Media.Visual main = BrowserReflection.MainControl() as System.Windows.Media.Visual;
            System.Windows.Interop.HwndSource src =
                main == null ? null : PresentationSource.FromVisual(main) as System.Windows.Interop.HwndSource;
            if (src == null) return IntPtr.Zero;
            IntPtr root = GetAncestor(src.Handle, GA_ROOT);
            return root == Genie.WindowUtils.FindEditorFrame() ? IntPtr.Zero : root;
        }
    }

    // Typing in our own windows. The editor runs wx's message loop, which hands messages for windows outside wx's tree
    // to IsDialogMessage (wxEventLoop::PreProcessMessage). It asks WM_GETDLGCODE first: want every key and character,
    // or arrows, Tab, Enter and Escape become dialog navigation and never reach WPF. Key presses then reach WPF, but
    // their WM_CHAR never does: it's queued, then removed before delivery. So once WPF has handled a key press, its
    // queued characters go straight to the window (translating the key first if nothing has), as a normal message
    // loop would. Where the loop does deliver them, nothing is queued by then, so this does nothing.
    internal static class WxKeyboard {
        private const int  WM_GETDLGCODE    = 0x0087;
        private const int  DLGC_WANTALLKEYS = 0x0004;
        private const int  DLGC_WANTCHARS   = 0x0080;
        private const int  WM_KEYDOWN       = 0x0100;
        private const int  WM_SYSKEYDOWN    = 0x0104;
        private const int  WM_CHAR          = 0x0102;
        private const int  WM_DEADCHAR      = 0x0103;
        private const int  WM_SYSCHAR       = 0x0106;
        private const int  WM_SYSDEADCHAR   = 0x0107;
        private const int  VK_SPACE         = 0x20;
        private const uint PM_NOREMOVE      = 0x0000;
        private const uint PM_REMOVE        = 0x0001;

        // An HwndSourceHook. A window holds its hooks weakly, so whoever adds this keeps the delegate.
        internal static IntPtr Hook(IntPtr hwnd, int msg, IntPtr w, IntPtr l, ref bool handled) {
            switch (msg) {
                case WM_GETDLGCODE:
                    handled = true;
                    return new IntPtr(DLGC_WANTALLKEYS | DLGC_WANTCHARS);

                case WM_KEYDOWN:
                case WM_SYSKEYDOWN: {
                    NativeMsg pending;
                    if (!PeekChar(hwnd, out pending, PM_NOREMOVE)) {
                        NativeMsg key = new NativeMsg { hwnd = hwnd, message = msg, wParam = w, lParam = l };
                        TranslateMessage(ref key);
                    }
                    while (PeekChar(hwnd, out pending, PM_REMOVE)) {
                        // A TextBox types its space from the key press (WPF's Space command): this would be a second.
                        if (msg == WM_KEYDOWN && w.ToInt64() == VK_SPACE && pending.message == WM_CHAR &&
                            pending.wParam.ToInt64() == VK_SPACE)
                            continue;
                        SendMessageW(hwnd, pending.message, pending.wParam, pending.lParam);
                    }
                    return IntPtr.Zero; // not handled: WPF still gets the key press
                }
            }
            return IntPtr.Zero;
        }

        // A character message queued for this window, in either range (the key messages between them stay queued).
        private static bool PeekChar(IntPtr hwnd, out NativeMsg msg, uint remove) {
            return PeekMessageW(out msg, hwnd, WM_CHAR, WM_DEADCHAR, remove) ||
                   PeekMessageW(out msg, hwnd, WM_SYSCHAR, WM_SYSDEADCHAR, remove);
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct NativeMsg {
            public IntPtr hwnd;
            public int    message;
            public IntPtr wParam, lParam;
            public int    time, x, y;
        }

        [DllImport("user32.dll")]
        private static extern bool TranslateMessage(ref NativeMsg msg);
        [DllImport("user32.dll")]
        private static extern IntPtr SendMessageW(IntPtr hwnd, int msg, IntPtr w, IntPtr l);
        [DllImport("user32.dll")]
        private static extern bool PeekMessageW(out NativeMsg msg, IntPtr hwnd, int first, int last, uint remove);
    }

    /// <summary>
    /// Holds an addon's one window: Show creates it the first time (or after it was closed), otherwise
    /// brings the open one to the front. Use from the UI thread.
    /// </summary>
    public sealed class GenieWindowSlot {
        private readonly Func<GenieWindow> _create;
        private GenieWindow                _window;

        /// <param name="create">Builds a new window: Genie.WindowUtils.CreateWindow plus content.</param>
        public GenieWindowSlot(Func<GenieWindow> create) {
            _create = create;
        }

        /// <summary>The open window, or null.</summary>
        public GenieWindow Current {
            get { return (_window != null && _window.IsOpen) ? _window : null; }
        }

        public void Show() {
            if (Current == null) {
                GenieWindow window = _create();
                if (window == null) return;
                // Only if it's still this window, so a late Closed can't drop a newer one.
                window.Closed += delegate {
                    if (_window == window) _window = null;
                };
                _window = window;
            }
            _window.Show();
        }

        public void Close() {
            if (Current != null) _window.Close();
        }
    }

    public static partial class Genie {
        // == Genie.PathUtils ==========================================================================
        // The engine's object name strings:
        //   full name: "Class Package.Group.Object" (ObjectUtils.GetFullName)
        //   path name: "Package.Group.Object"       (ObjectUtils.GetPathName)

        public static class PathUtils {
            /// <summary>"Material Pkg.Obj" -> "Pkg.Obj". A path name without a class is returned unchanged.</summary>
            public static string RemoveClassPrefix(string fullName) {
                if (fullName == null) return null;
                int sp = fullName.IndexOf(' ');
                return (sp >= 0) ? fullName.Substring(sp + 1) : fullName;
            }

            /// <summary>"Material Pkg.Obj" -> "Material". Null if there is no class prefix.</summary>
            public static string GetClassName(string fullName) {
                if (fullName == null) return null;
                int sp = fullName.IndexOf(' ');
                return (sp > 0) ? fullName.Substring(0, sp) : null;
            }

            /// <summary>"Pkg.Group.Obj" -> "Pkg" (the outermost package).</summary>
            public static string GetOutermostName(string pathName) {
                if (pathName == null) return null;
                int dot = pathName.IndexOf('.');
                return (dot >= 0) ? pathName.Substring(0, dot) : pathName;
            }

            /// <summary>Same as GetOutermostName: an object's package is its outermost.</summary>
            public static string GetPackageName(string pathName) {
                return GetOutermostName(pathName);
            }

            /// <summary>
            /// "Pkg.Group1.Group2.Obj" -> "Group1.Group2.Obj": everything after the package. Null for a package's
            /// own name ("Pkg"), which leaves nothing.
            /// </summary>
            public static string RemovePackageName(string pathName) {
                if (pathName == null) return null;
                int dot = pathName.IndexOf('.');
                return (dot >= 0) ? pathName.Substring(dot + 1) : null;
            }

            /// <summary>
            /// "Pkg.Group.Obj" -> "Pkg.Group" (the object's outer: its group, or its package if it has none). Null
            /// for a top-level name, which has no outer.
            /// </summary>
            public static string GetOuterName(string pathName) {
                if (pathName == null) return null;
                int dot = pathName.LastIndexOf('.');
                return (dot >= 0) ? pathName.Substring(0, dot) : null;
            }

            /// <summary>"Pkg.Group.Obj" -> "Obj" (the object's own name).</summary>
            public static string GetLeafName(string pathName) {
                if (pathName == null) return null;
                int dot = pathName.LastIndexOf('.');
                return (dot >= 0) ? pathName.Substring(dot + 1) : pathName;
            }
        }

        // == Genie.TextUtils ==========================================================================

        public static class TextUtils {
            /// <summary>
            /// "1 movie", "3 movies": n and the noun, plural unless n is 1. plural: for nouns that don't just take an
            /// "s" ("box", "boxes").
            /// </summary>
            public static string Count(long n, string noun, string plural = null) {
                return n + " " + (n == 1 ? noun : plural ?? noun + "s");
            }

            /// <summary>
            /// A length of time as a clock reads it: "0:42", "12:05", "1:02:05". Example: Package Loader's run time.
            /// </summary>
            public static string Duration(TimeSpan t) {
                long s = Math.Max(0, (long)t.TotalSeconds);
                return s >= 3600 ? string.Format("{0}:{1:00}:{2:00}", s / 3600, s / 60 % 60, s % 60)
                                 : string.Format("{0}:{1:00}", s / 60, s % 60);
            }

            /// <summary>
            /// How long something took: "0.4 s", "12.6 s" under a minute (tenths, in the user's culture), else as
            /// Duration. Example: Package Loader's run history.
            /// </summary>
            public static string ShortDuration(TimeSpan t) {
                double s = Math.Max(0, t.TotalSeconds);
                return s < 59.95 ? s.ToString("0.0", System.Globalization.CultureInfo.CurrentCulture) + " s"
                                 : Duration(t);
            }

            /// <summary>
            /// When something happened, as short as it stays clear: "23:41" today, "Nov 14" this year, "Nov 14 2025"
            /// before, in the user's culture. Pair it with WhenInFull in its tooltip. Example: Package Loader's last
            /// run times.
            /// </summary>
            public static string When(DateTime t) {
                System.Globalization.CultureInfo culture = System.Globalization.CultureInfo.CurrentCulture;
                if (t.Date == DateTime.Today) return t.ToString("HH:mm", culture);
                return t.ToString(t.Year == DateTime.Today.Year ? "MMM d" : "MMM d yyyy", culture);
            }

            /// <summary>
            /// A size in bytes as Explorer shows it: "512 bytes", "12.3 KB", "1.4 MB", "2.1 GB" (1024 per step, one
            /// decimal, in the user's culture). Example: Dependency Viewer's unreferenced objects.
            /// </summary>
            public static string Bytes(long n) {
                if (n < 1024) return Count(n, "byte");
                string[] units = { "KB", "MB", "GB" };
                double   size  = n / 1024.0;
                int      unit  = 0;
                for (; size >= 1024 && unit < units.Length - 1; unit++) size /= 1024;
                return size.ToString("0.0", System.Globalization.CultureInfo.CurrentCulture) + " " + units[unit];
            }

            /// <summary>The date and time in full, in the user's culture, for When's tooltip. Null for null.</summary>
            public static string WhenInFull(DateTime? t) {
                return t.HasValue ? t.Value.ToString("f", System.Globalization.CultureInfo.CurrentCulture) : null;
            }

            /// <summary>
            /// A name that's free: stem itself, else "stem 2", "stem 3" and on, the first isFree takes. Example:
            /// Package Loader's "New job".
            /// </summary>
            public static string FreeName(string stem, Predicate<string> isFree) {
                if (isFree(stem)) return stem;
                for (int n = 2;; n++) {
                    if (isFree(stem + " " + n)) return stem + " " + n;
                }
            }
        }

        // == Genie.ObjectUtils ========================================================================
        // Live objects and packages (UObject*, UPackage*).

        public static class ObjectUtils {
            /// <summary>A loaded (or placeholder) top-level package by name, or Zero. See IsPackageLoaded.</summary>
            public static IntPtr FindPackage(string name) {
                if (string.IsNullOrEmpty(name)) return IntPtr.Zero;
                MethodInfo m = EngineThunks.Find("FindObject<class UPackage>");
                if (m == null) return IntPtr.Zero;
                ParameterInfo[] p = m.GetParameters();
                IntPtr np         = Marshal.StringToHGlobalUni(name);
                try {
                    // Outer = null: top-level objects only. ANY_PACKAGE ((UPackage*)-1) also matches groups, which
                    // are UPackages too, so "Materials" could return some package's Materials group (no Guid, so
                    // never "loaded") instead of the stock Materials package.
                    return EngineThunks.Unbox(m.Invoke(null, new object[] {
                        EngineThunks.Box(IntPtr.Zero, p[0].ParameterType),
                        EngineThunks.Box(np, p[1].ParameterType),
                        (uint)0,
                    }));
                } catch (Exception ex) {
                    EngineThunks.Trace("FindPackage failed: " + ex.Message);
                    return IntPtr.Zero;
                } finally {
                    Marshal.FreeHGlobal(np);
                }
            }

            /// <summary>A loaded object by path name ("Pkg.Group.Obj"), or Zero. Never loads anything.</summary>
            public static IntPtr FindObject(string pathName) {
                if (string.IsNullOrEmpty(pathName)) return IntPtr.Zero;
                MethodInfo m = EngineThunks.Find("UObject.StaticFindObject");
                if (m == null) return IntPtr.Zero;
                ParameterInfo[] p = m.GetParameters();
                IntPtr np         = Marshal.StringToHGlobalUni(pathName);
                try {
                    return EngineThunks.Unbox(m.Invoke(null, new object[] {
                        EngineThunks.Box(IntPtr.Zero, p[0].ParameterType),
                        EngineThunks.Box(IntPtr.Zero, p[1].ParameterType),
                        EngineThunks.Box(np, p[2].ParameterType),
                        (uint)0,
                    }));
                } catch (Exception ex) {
                    EngineThunks.Trace("FindObject failed: " + ex.Message);
                    return IntPtr.Zero;
                } finally {
                    Marshal.FreeHGlobal(np);
                }
            }

            /// <summary>
            /// An object by path, loading it from its package file if it isn't in memory
            /// (UObject::StaticLoadObject, the engine's own load-by-name). classPath: its class
            /// ("GFxUI.SwfMovie"), or a base class: "Core.Object" takes any. Loading reads from disk; nothing is
            /// changed or saved. The Content Browser shows it loaded, as if loaded there, so package watches hear of it
            /// (ContentBrowserUtils.WatchPackage). Zero if it can't be found or loaded (the engine logs why).
            /// </summary>
            public static IntPtr LoadObject(string classPath, string objectPath) {
                if (string.IsNullOrEmpty(objectPath)) return IntPtr.Zero;
                IntPtr found = FindObject(objectPath);
                if (found != IntPtr.Zero) return found;
                IntPtr cls = FindObject(classPath);
                if (cls == IntPtr.Zero) {
                    EngineThunks.Trace("LoadObject: class " + classPath + " isn't loaded");
                    return IntPtr.Zero;
                }
                MethodInfo m = EngineThunks.Find("UObject.StaticLoadObject");
                if (m == null) return IntPtr.Zero;
                ParameterInfo[] p = m.GetParameters();
                if (p.Length != 7) {
                    EngineThunks.Trace("StaticLoadObject has an unexpected signature");
                    return IntPtr.Zero;
                }
                IntPtr name = Marshal.StringToHGlobalUni(objectPath);
                IntPtr loaded;
                try {
                    // (UClass* Class, UObject* Outer, const TCHAR* Name, const TCHAR* Filename, DWORD LoadFlags,
                    //  UPackageMap* Sandbox, UBOOL bAllowObjectReconciliation)
                    loaded = EngineThunks.Unbox(m.Invoke(null, new object[] {
                        EngineThunks.Box(cls, p[0].ParameterType),
                        EngineThunks.Box(IntPtr.Zero, p[1].ParameterType),
                        EngineThunks.Box(name, p[2].ParameterType),
                        EngineThunks.Box(IntPtr.Zero, p[3].ParameterType),
                        (uint)0,
                        EngineThunks.Box(IntPtr.Zero, p[5].ParameterType),
                        (uint)1,
                    }));
                } catch (Exception ex) {
                    EngineThunks.Trace("LoadObject " + objectPath + " failed: " + ex.Message);
                    return IntPtr.Zero;
                } finally {
                    Marshal.FreeHGlobal(name);
                }
                // StaticLoadObject tells the Content Browser nothing: without this it, and every package watch, still
                // shows the package unloaded.
                if (loaded != IntPtr.Zero) ContentBrowserUtils.ShowLoadedObject(loaded);
                return loaded;
            }

            /// <summary>Object flags, as this build tests them at UObject+0x10.</summary>
            public const ulong FlagPublic     = 0x0000000400000000; // other packages can import it
            public const ulong FlagStandalone = 0x0008000000000000; // kept and saved though nothing references it

            /// <summary>
            /// Creates an object of a loaded class ("Core.ObjectRedirector") in outer, a loaded package or group, the
            /// way the editor's tools do: UObject::StaticConstructObject(Class, Outer, Name, Flags, NULL, GError,
            /// NULL, NULL), as ObjectTools::ConsolidateObjects makes its redirectors (with FlagPublic |
            /// FlagStandalone). A taken name is refused: the engine would replace that object in place, or stop the
            /// editor through GError if the classes differ (CheckNewName says so first). Marks the package unsaved.
            /// Until saved it isn't in the package's export table, but GetObjectsInPackage lists it and IsNew is
            /// true. Zero (logged) on failure.
            /// </summary>
            public static IntPtr ConstructObject(string classPath, IntPtr outer, string name, ulong flags) {
                if (outer == IntPtr.Zero || !PackageUtils.IsValidName(name)) return IntPtr.Zero;
                string outerPath = GetPathName(outer);
                if (outerPath == null) return IntPtr.Zero;
                string path = outerPath + "." + name;
                if (FindObject(path) != IntPtr.Zero) {
                    EngineThunks.Trace(path + " already exists; not creating it.");
                    return IntPtr.Zero;
                }
                IntPtr cls = FindObject(classPath);
                if (cls == IntPtr.Zero) {
                    EngineThunks.Trace("ConstructObject: class " + classPath + " isn't loaded");
                    return IntPtr.Zero;
                }
                MethodInfo m = EngineThunks.Find("UObject.StaticConstructObject");
                if (m == null) return IntPtr.Zero;
                ParameterInfo[] p = m.GetParameters();
                if (p.Length != 8 || p[2].ParameterType.IsPointer) {
                    EngineThunks.Trace("StaticConstructObject has an unexpected signature");
                    return IntPtr.Zero;
                }
                object fname  = EngineThunks.NewFName(name, p[2].ParameterType);
                IntPtr gError = EngineThunks.Global("GError");
                if (fname == null || gError == IntPtr.Zero) return IntPtr.Zero;
                try {
                    IntPtr obj = EngineThunks.Unbox(m.Invoke(null, new object[] {
                        EngineThunks.Box(cls, p[0].ParameterType),
                        EngineThunks.Box(outer, p[1].ParameterType),
                        fname,
                        flags,
                        EngineThunks.Box(IntPtr.Zero, p[4].ParameterType), // Template
                        EngineThunks.Box(gError, p[5].ParameterType),
                        EngineThunks.Box(IntPtr.Zero, p[6].ParameterType), // SubobjectRoot
                        EngineThunks.Box(IntPtr.Zero, p[7].ParameterType), // InstanceGraph
                    }));
                    if (obj == IntPtr.Zero) return obj;
                    _constructed.Add(new KeyValuePair<string, IntPtr>(path, obj));
                    _deleted.RemoveAll(gone => string.Equals(gone, path, StringComparison.OrdinalIgnoreCase));
                    MarkPackageDirty(obj);
                    return obj;
                } catch (Exception ex) {
                    EngineThunks.Trace("ConstructObject " + path + " failed: " + ex.Message);
                    return IntPtr.Zero;
                }
            }

            // Objects made by ConstructObject, by path, which outlives the object: an address can be reused once it's
            // deleted, so an entry counts only while its path still finds that address.
            private static readonly List<KeyValuePair<string, IntPtr>> _constructed =
                new List<KeyValuePair<string, IntPtr>>();

            // The constructed objects still alive, in packageName or anywhere (null). Drops the rest.
            private static List<IntPtr> LiveConstructed(string packageName) {
                _constructed.RemoveAll(c => FindObject(c.Key) != c.Value);
                List<IntPtr> live = new List<IntPtr>();
                foreach (KeyValuePair<string, IntPtr> c in _constructed) {
                    if (packageName == null ||
                        string.Equals(PathUtils.GetPackageName(c.Key), packageName, StringComparison.OrdinalIgnoreCase))
                        live.Add(c.Value);
                }
                return live;
            }

            /// <summary>
            /// True for an object made with ConstructObject that isn't in its package's export table yet: nothing in
            /// a file uses it, and it has no saved state to read back (LinkerUtils).
            /// </summary>
            public static bool IsNew(IntPtr obj) {
                return obj != IntPtr.Zero && LiveConstructed(null).Contains(obj) && LinkerUtils.GetExportIndex(obj) < 0;
            }

            /// <summary>The objects made in packageName with ConstructObject that are still in memory.</summary>
            internal static List<IntPtr> GetConstructed(string packageName) {
                return LiveConstructed(packageName);
            }

            // Paths deleted with ForceDelete while their package is unsaved. The export table still lists them, and
            // an export not in memory reads the same as one never loaded, so this tells the two apart.
            private static readonly List<string> _deleted = new List<string>();

            /// <summary>
            /// True if ForceDelete deleted the object at pathName and its package hasn't been saved or reloaded since:
            /// its export table still lists it, though it's gone. Example: RedirectorUtils.FindInPackage.
            /// </summary>
            public static bool IsDeleted(string pathName) {
                _deleted.RemoveAll(p => !IsPackageDirty(FindPackage(PathUtils.GetPackageName(p))));
                return pathName != null &&
                       _deleted.Exists(p => string.Equals(p, pathName, StringComparison.OrdinalIgnoreCase));
            }

            /// <summary>
            /// Why name can't name a new object in outerPath ("Pkg" or "Pkg.Group"), or null: PackageUtils.CheckName,
            /// then a taken path. except: an object that may keep the name, such as one being renamed. A taken path
            /// is refused, not risked: ConstructObject over an object replaces it in place, or stops the editor if
            /// the classes differ.
            /// </summary>
            public static string CheckNewName(string outerPath, string name, IntPtr except = default(IntPtr)) {
                string problem = PackageUtils.CheckName(name);
                if (problem != null) return problem;
                IntPtr taken = FindObject(outerPath + "." + name);
                return taken != IntPtr.Zero && taken != except ? outerPath + "." + name + " already exists." : null;
            }

            /// <summary>"Class Package.Group.Object", or null.</summary>
            public static string GetFullName(IntPtr obj) {
                return EngineThunks.CallObjectName("UObject.GetFullName", obj);
            }

            /// <summary>"Package.Group.Object", or null.</summary>
            public static string GetPathName(IntPtr obj) {
                return EngineThunks.CallObjectName("UObject.GetPathName", obj);
            }

            /// <summary>The object's outermost package, or Zero.</summary>
            public static IntPtr GetOutermost(IntPtr obj) {
                return EngineThunks.CallPtr1("UObject.GetOutermost", obj);
            }

            /// <summary>The object's UClass*, or Zero.</summary>
            public static IntPtr GetClass(IntPtr obj) {
                return EngineThunks.CallPtr1("UObject.GetClass", obj);
            }

            /// <summary>
            /// Write an object to a file with the engine's exporter for the file's extension, as the Content
            /// Browser's "Export to file" does, but with no dialogs: a Texture2D to .tga, for example. Creates the
            /// folder; replaces an existing file. False (logged) if there's no exporter for that type, or it fails.
            /// </summary>
            public static bool ExportToFile(IntPtr obj, string file) {
                if (obj == IntPtr.Zero || string.IsNullOrEmpty(file)) return false;
                EngineNative.ExportToFileExFn export = EngineNative.ExportToFileEx();
                if (export == null) return false;
                IntPtr name = IntPtr.Zero, p = IntPtr.Zero;
                try {
                    file = Path.GetFullPath(file);
                    Directory.CreateDirectory(Path.GetDirectoryName(file));
                    name = Marshal.StringToHGlobalUni(file);
                    p    = Marshal.AllocHGlobal(EngineNative.ExportParamsSize);
                    for (int i = 0; i < EngineNative.ExportParamsSize; i += 8)
                        Marshal.WriteInt64(p, i, 0); // no prompt, no options
                    Marshal.WriteIntPtr(p, 0x00, obj);
                    Marshal.WriteIntPtr(p, 0x10, name);
                    if (export(p) == 1) return true;
                    EngineThunks.Trace("Couldn't export " + (GetPathName(obj) ?? "the object") + " to " + file + ".");
                    return false;
                } catch (Exception ex) {
                    EngineThunks.Trace("Export to " + file + " failed: " + ex.Message);
                    return false;
                } finally {
                    if (p != IntPtr.Zero) Marshal.FreeHGlobal(p);
                    if (name != IntPtr.Zero) Marshal.FreeHGlobal(name);
                }
            }

            /// <summary>
            /// The object's class as "Package.ClassName" ("Engine.MaterialInstanceConstant"), or null.
            /// </summary>
            public static string GetClassPathName(IntPtr obj) {
                IntPtr cls = GetClass(obj);
                return (cls == IntPtr.Zero) ? null : GetPathName(cls);
            }

            /// <summary>True if the object's class is exactly "Package.ClassName" (no subclass check).</summary>
            public static bool IsClass(IntPtr obj, string classPathName) {
                string c = GetClassPathName(obj);
                return c != null && string.Equals(c, classPathName, StringComparison.OrdinalIgnoreCase);
            }

            /// <summary>
            /// True if the package was really loaded from a file. When a linker loads a package it copies
            /// the file's Summary.Guid into UPackage.Guid (linker code: [linker+0xB4] -> [package+0x80]).
            /// The empty placeholder the engine creates for a package whose file could not be found keeps
            /// a zero Guid, though FindPackage finds it and the Content Browser counts it as loaded. The Guid
            /// stays when the package is cut loose from its file (PackageUtils.RenamePackage), so this stays
            /// true: LinkerUtils.GetLinker tells whether a file is still attached.
            /// </summary>
            public static bool IsPackageLoaded(string packageName) {
                return IsPackageLoaded(FindPackage(packageName));
            }

            public static bool IsPackageLoaded(IntPtr package) {
                if (package == IntPtr.Zero) return false;
                MethodInfo m = EngineThunks.Find("UPackage.GetGuid");
                if (m == null) return false;
                IntPtr g = Marshal.AllocHGlobal(16);
                try {
                    Marshal.WriteInt64(g, 0, 0);
                    Marshal.WriteInt64(g, 8, 0);
                    ParameterInfo[] p = m.GetParameters();
                    m.Invoke(null, new object[] {
                        EngineThunks.Box(package, p[0].ParameterType),
                        EngineThunks.Box(g, p[1].ParameterType),
                    });
                    return Marshal.ReadInt64(g, 0) != 0 || Marshal.ReadInt64(g, 8) != 0;
                } catch (Exception ex) {
                    EngineThunks.Trace("GetGuid failed: " + ex.Message);
                    return false;
                } finally {
                    Marshal.FreeHGlobal(g);
                }
            }

            /// <summary>
            /// True if the object's package has unsaved changes (UPackage::IsDirty). The same flag drives the
            /// Content Browser's "*" after a package name, so the two always agree.
            /// </summary>
            public static bool IsPackageDirty(IntPtr obj) {
                IntPtr pkg = GetOutermost(obj); // a package is its own outermost
                if (pkg == IntPtr.Zero) return false;
                MethodInfo m = EngineThunks.Find("UPackage.IsDirty"); // uint IsDirty(const UPackage*)
                if (m == null) return false;
                try {
                    object dirty =
                        m.Invoke(null, new object[] { EngineThunks.Box(pkg, m.GetParameters()[0].ParameterType) });
                    return dirty != null && Convert.ToUInt32(dirty) != 0;
                } catch (Exception ex) {
                    EngineThunks.Trace("IsDirty failed: " + ex.Message);
                    return false;
                }
            }

            /// <summary>
            /// True if every object in the package's file is loaded (UPackage::IsFullyLoaded): nothing is left for a
            /// load or the Content Browser's Fully Load to read. False for a package not in memory.
            /// </summary>
            public static bool IsPackageFullyLoaded(IntPtr package) {
                if (package == IntPtr.Zero) return false;
                MethodInfo m = EngineThunks.Find("UPackage.IsFullyLoaded"); // uint IsFullyLoaded(UPackage*)
                if (m == null) return false;
                try {
                    object full =
                        m.Invoke(null, new object[] { EngineThunks.Box(package, m.GetParameters()[0].ParameterType) });
                    return full != null && Convert.ToUInt32(full) != 0;
                } catch (Exception ex) {
                    EngineThunks.Trace("IsFullyLoaded failed: " + ex.Message);
                    return false;
                }
            }

            /// <summary>Marks the object's package modified, so it shows as unsaved. See SetPackageDirty.</summary>
            public static bool MarkPackageDirty(IntPtr obj) {
                return SetPackageDirty(obj, true);
            }

            /// <summary>
            /// Sets or clears the unsaved flag of the object's package (UPackage::SetDirtyFlag), the flag behind the
            /// Content Browser's "*". Clearing it keeps the changes in memory; nothing asks to save them any more.
            /// Either way the package's watches hear of it (ContentBrowserUtils.WatchPackage).
            /// </summary>
            public static bool SetPackageDirty(IntPtr obj, bool isDirty) {
                IntPtr pkg = GetOutermost(obj);
                if (pkg == IntPtr.Zero) return false;
                MethodInfo m = EngineThunks.Find("UPackage.SetDirtyFlag");
                if (m == null) return false;
                try {
                    m.Invoke(null, new object[] {
                        EngineThunks.Box(pkg, m.GetParameters()[0].ParameterType),
                        (uint)(isDirty ? 1 : 0),
                    });
                    PackageEdits.Notify(GetPathName(pkg));
                    return true;
                } catch (Exception ex) {
                    EngineThunks.Trace("SetDirtyFlag failed: " + ex.Message);
                    return false;
                }
            }

            /// <summary>
            /// Every loaded object listed in the export table of a package whose file is attached
            /// (LinkerUtils.GetLinker), then those made in it with ConstructObject since (IsNew). A package without
            /// its file, a renamed one included until saved, has only the latter. A package's objects can also be in
            /// memory without its own file loaded (brought in by another package): look those up with FindObject. Use
            /// LinkerUtils for the table itself.
            /// </summary>
            public static IntPtr[] GetObjectsInPackage(string packageName) {
                List<IntPtr> res    = new List<IntPtr>();
                IntPtr       linker = LinkerUtils.GetLinker(packageName);
                int          count  = LinkerUtils.GetExportCount(linker); // 0 without a linker
                for (int i = 0; i < count; i++) {
                    IntPtr obj = FindObject(LinkerUtils.GetExportPathName(linker, i));
                    if (obj != IntPtr.Zero) res.Add(obj);
                }
                foreach (IntPtr obj in LiveConstructed(packageName)) {
                    if (!res.Contains(obj)) res.Add(obj);
                }
                return res.ToArray();
            }

            /// <summary>
            /// Delete an object even if it is referenced (ObjectTools::ForceDeleteObjects); references to
            /// it become null. Can't be undone. Marks the package unsaved: save it to keep the change; until then
            /// IsDeleted is true for its path. Returns the number deleted, or -1 if the engine function is unavailable.
            /// </summary>
            public static int ForceDelete(IntPtr obj) {
                return ForceDelete(new IntPtr[] { obj });
            }

            /// <summary>
            /// ForceDelete for several at once, in one engine call: the engine's function takes a list, and sweeps
            /// for references once for them all, where one call each would sweep once each. Zero and repeated entries
            /// are ignored. Returns the number deleted, or -1 if the engine function is unavailable. Example:
            /// Redirector Manager deleting a selection.
            /// </summary>
            public static int ForceDelete(IList<IntPtr> objs) {
                List<IntPtr> live = new List<IntPtr>();
                if (objs != null)
                    foreach (IntPtr obj in objs)
                        if (obj != IntPtr.Zero && !live.Contains(obj)) live.Add(obj);
                if (live.Count == 0) return 0;
                MethodInfo force = EngineThunks.Find("ObjectTools.ForceDeleteObjects");
                if (force == null) return -1;
                // Read before: gone afterwards.
                string[] paths    = new string[live.Count];
                IntPtr[] packages = new IntPtr[live.Count];
                for (int i = 0; i < live.Count; i++) {
                    paths[i]    = GetPathName(live[i]);
                    packages[i] = GetOutermost(live[i]);
                }
                int deleted = ForceDeleteObjects(force, live.ToArray());
                if (deleted <= 0) return deleted;
                List<IntPtr> dirtied = new List<IntPtr>();
                for (int i = 0; i < live.Count; i++) {
                    // All deleted, or this one's path no longer finds it (another object can share a path, so not
                    // just any object there).
                    bool gone = deleted >= live.Count || FindObject(paths[i]) != live[i];
                    if (!gone) continue;
                    if (paths[i] != null) _deleted.Add(paths[i]);
                    if (packages[i] != IntPtr.Zero && !dirtied.Contains(packages[i])) dirtied.Add(packages[i]);
                }
                foreach (IntPtr package in dirtied) SetPackageDirty(package, true); // a package is its own outermost
                return deleted;
            }

            private static int ForceDeleteObjects(MethodInfo force, IntPtr[] objs) {
                IntPtr data, emptyData;
                IntPtr arr   = EngineThunks.NewPointerArray(objs, out data);
                IntPtr empty = EngineThunks.NewPointerArray(new IntPtr[0], out emptyData);
                try {
                    ParameterInfo[] p = force.GetParameters();
                    object r          = force.Invoke(null, new object[] {
                        EngineThunks.Box(arr, p[0].ParameterType),
                        EngineThunks.Box(empty, p[1].ParameterType),
                             });
                    return (r == null) ? 0 : Convert.ToInt32(r);
                } finally {
                    Marshal.FreeHGlobal(data);
                    Marshal.FreeHGlobal(arr);
                    Marshal.FreeHGlobal(emptyData);
                    Marshal.FreeHGlobal(empty);
                }
            }

            /// <summary>
            /// A pointer-sized field at a byte offset in a native object, for layouts the API doesn't cover.
            /// </summary>
            public static IntPtr ReadPointer(IntPtr obj, int offset) {
                if (obj == IntPtr.Zero) return IntPtr.Zero;
                try {
                    return Marshal.ReadIntPtr(obj, offset);
                } catch {
                    return IntPtr.Zero;
                }
            }

            /// <summary>
            /// Write a pointer-sized field at a byte offset in a native object. This changes engine memory
            /// directly: use only for fields whose layout you have confirmed, and mark the package dirty
            /// (MarkPackageDirty) if the change should be saved. Returns false if the write didn't take.
            /// </summary>
            public static bool WritePointer(IntPtr obj, int offset, IntPtr value) {
                if (obj == IntPtr.Zero) return false;
                try {
                    Marshal.WriteIntPtr(obj, offset, value);
                    return Marshal.ReadIntPtr(obj, offset) == value;
                } catch {
                    return false;
                }
            }

            /// <summary>True if the object lives in the transient package (temporary; never saved).</summary>
            public static bool IsTransient(IntPtr obj) {
                IntPtr transient = EngineThunks.CallPtr0("UObject.GetTransientPackage");
                return transient != IntPtr.Zero && GetOutermost(obj) == transient;
            }

            /// <summary>
            /// The string for an FName stored at a native address (for example inside a linker table
            /// entry), through the engine's CLRTools.FNameToString. Null if unreadable.
            /// </summary>
            public static string ReadFName(IntPtr fnameAddress) {
                if (fnameAddress == IntPtr.Zero) return null;
                MethodInfo m = EngineThunks.Find("CLRTools.FNameToString");
                if (m == null) return null;
                Type arg = m.GetParameters()[0].ParameterType; // FName*: we pass the FName where it already lives
                if (!arg.IsPointer) {
                    EngineThunks.Trace("FNameToString has an unexpected signature");
                    return null;
                }
                try {
                    object r = m.Invoke(null, new object[] { EngineThunks.Box(fnameAddress, arg) });
                    return (r == null) ? null : r.ToString();
                } catch (Exception ex) {
                    EngineThunks.Trace("FNameToString failed: " + ex.Message);
                    return null;
                }
            }

            // UProperty::Offset, the property's byte offset inside an object. The engine's own checks read
            // it at [property+0x94] (e.g. "pfunc->ReturnValueOffset == returnProp->Offset").
            private const int PropertyOffsetField = 0x94;

            /// <summary>
            /// The byte offset of a script property inside objects of its class, found by the property's
            /// path ("GFxUI.GFxRawData.RawDataFiraxis": package, class, property). -1 if the property isn't
            /// loaded. Read the property's value with the offset, e.g. ReadByteArray(obj, offset).
            /// </summary>
            public static int GetPropertyOffset(string propertyPath) {
                IntPtr prop = FindObject(propertyPath);
                if (prop == IntPtr.Zero) return -1;
                string cls = GetClassPathName(prop);
                if (cls == null || !cls.EndsWith("Property", StringComparison.Ordinal)) {
                    EngineThunks.Trace(propertyPath + " is a " + (cls ?? "?") + ", not a property");
                    return -1;
                }
                return Marshal.ReadInt32(prop, PropertyOffsetField);
            }

            /// <summary>
            /// Replace a byte array property (TArray&lt;BYTE&gt;) at a byte offset in an object with `bytes`, through
            /// the engine's own TArray&lt;BYTE&gt; functions, so its memory is the engine's: Empty(0) releases the old
            /// storage, Add(n) allocates n bytes, then the bytes are copied in. Changes the object in memory only:
            /// mark its package dirty (MarkPackageDirty) so the user can save it. Returns false if it couldn't.
            /// </summary>
            public static bool WriteByteArray(IntPtr obj, int offset, byte[] bytes) {
                if (obj == IntPtr.Zero || offset < 0 || bytes == null) return false;
                MethodInfo empty = EngineThunks.Find("TArray<unsigned char,FDefaultAllocator>.Empty");
                MethodInfo add   = EngineThunks.Find("TArray<unsigned char,FDefaultAllocator>.Add");
                if (empty == null || add == null) return false;
                IntPtr array = new IntPtr(obj.ToInt64() + offset);
                try {
                    // Empty(Slack, ElementSize): count 0, storage released (slack 0).
                    empty.Invoke(null, new object[] {
                        EngineThunks.Box(array, empty.GetParameters()[0].ParameterType),
                        0,
                        (uint)1,
                    });
                    if (bytes.Length > 0) {
                        add.Invoke(null, new object[] {
                            EngineThunks.Box(array, add.GetParameters()[0].ParameterType),
                            bytes.Length,
                        });
                        IntPtr data = Marshal.ReadIntPtr(array, 0);
                        if (data == IntPtr.Zero || Marshal.ReadInt32(array, IntPtr.Size) != bytes.Length) {
                            EngineThunks.Trace("WriteByteArray: the engine didn't allocate the array");
                            return false;
                        }
                        Marshal.Copy(bytes, 0, data, bytes.Length);
                    }
                    return true;
                } catch (Exception ex) {
                    EngineThunks.Trace("WriteByteArray failed: " + ex.Message);
                    return false;
                }
            }

            /// <summary>
            /// A byte at an offset in an object (a ByteProperty, by GetPropertyOffset), or -1 if it can't be read.
            /// An enum property's byte is the value's index in its enum: TEXTUREGROUP_UI reads 16.
            /// </summary>
            public static int ReadByte(IntPtr obj, int offset) {
                if (obj == IntPtr.Zero || offset < 0) return -1;
                try {
                    return Marshal.ReadByte(obj, offset);
                } catch (Exception ex) {
                    EngineThunks.Trace("ReadByte failed: " + ex.Message);
                    return -1;
                }
            }

            /// <summary>
            /// A copy of a byte array property (TArray&lt;BYTE&gt;: data pointer, then count) at a byte offset
            /// in an object. Empty if the array is empty; null if it can't be read.
            /// </summary>
            public static byte[] ReadByteArray(IntPtr obj, int offset) {
                if (obj == IntPtr.Zero || offset < 0) return null;
                try {
                    IntPtr data  = Marshal.ReadIntPtr(obj, offset);
                    int    count = Marshal.ReadInt32(obj, offset + IntPtr.Size);
                    if (count < 0 || count > 1 << 30 || (count > 0 && data == IntPtr.Zero)) return null;
                    byte[] bytes = new byte[count];
                    if (count > 0) Marshal.Copy(data, bytes, 0, count);
                    return bytes;
                } catch (Exception ex) {
                    EngineThunks.Trace("ReadByteArray failed: " + ex.Message);
                    return null;
                }
            }
        }

        // == Genie.RedirectorUtils ====================================================================
        // An ObjectRedirector is the forwarding address left at a moved or renamed object's old path. A linker that
        // imports the old path follows it one hop, and takes its destination only if the destination's class is
        // exactly the one the import asks for (ULinkerLoad, 0x2332C5); otherwise the import fails and the reference
        // loads empty. So a redirector can't usefully point at another redirector, nor at a transient object, which
        // isn't saved. Example: Redirector Manager.

        public static class RedirectorUtils {
            public const string ClassPathName = "Core.ObjectRedirector";

            // ObjectRedirector.DestinationObject: the first field after UObject, which is 0x60 bytes in this build
            // (UPackage::IsDirty reads its own first field at +0x60).
            private const int DestinationOffset = 0x60;

            /// <summary>A redirector in a package (FindInPackage).</summary>
            public struct Found {
                public string PathName;    // "Pkg.Group.OldName"
                public IntPtr Redirector;  // Zero: not loaded; only PathName and GetRecordedDestination can be read
                public int    ExportIndex; // in its package's export table; -1 for one made since (ObjectUtils.IsNew)
            }

            /// <summary>
            /// Every redirector in a package, loaded or not: its export table's in table order, then those made in it
            /// since it was saved. A partly loaded package's unloaded ones load with it (the Content Browser's Fully
            /// Load). Ones deleted since the package was saved aren't listed (ObjectUtils.IsDeleted). Empty for a
            /// package not in memory.
            /// </summary>
            public static List<Found> FindInPackage(string packageName) {
                List<Found> found  = new List<Found>();
                IntPtr      linker = LinkerUtils.GetLinker(packageName);
                foreach (int i in LinkerUtils.FindExports(linker, ShortClassName)) {
                    string path = LinkerUtils.GetExportPathName(linker, i);
                    if (path == null) continue;
                    IntPtr obj = ObjectUtils.FindObject(path);
                    if (obj == IntPtr.Zero && ObjectUtils.IsDeleted(path)) continue;
                    found.Add(new Found { PathName = path, Redirector = IsRedirector(obj) ? obj : IntPtr.Zero,
                                          ExportIndex = i });
                }
                foreach (IntPtr obj in ObjectUtils.GetConstructed(packageName)) {
                    if (!IsRedirector(obj) || found.Exists(f => f.Redirector == obj)) continue;
                    found.Add(new Found { PathName = ObjectUtils.GetPathName(obj), Redirector = obj,
                                          ExportIndex = -1 });
                }
                return found;
            }

            private const string ShortClassName = "ObjectRedirector";

            /// <summary>Where a redirector's package file says it points: GetRecordedDestination.</summary>
            public struct RecordedDestination {
                public string PathName;     // "bin.Group.AngelHead_MAT", or null: see Problem
                public string PackageName;  // "bin"
                public string ObjectName;   // "AngelHead_MAT"
                public string ClassName;    // "Material", as the Content Browser names it ("Material Pkg.Obj")
                public string ClassPackage; // "Engine", for a destination in another package; else null
                public string Problem;      // why PathName is null ("its package isn't loaded from a file")
            }

            public static bool IsRedirector(IntPtr obj) {
                return ObjectUtils.IsClass(obj, ClassPathName);
            }

            /// <summary>
            /// The object a redirector points at, or Zero: broken (its destination failed to load, see
            /// GetRecordedDestination), or not a redirector.
            /// </summary>
            public static IntPtr GetDestination(IntPtr redirector) {
                return IsRedirector(redirector) ? ObjectUtils.ReadPointer(redirector, DestinationOffset) : IntPtr.Zero;
            }

            /// <summary>True for a redirector that points nowhere.</summary>
            public static bool IsBroken(IntPtr redirector) {
                return IsRedirector(redirector) && GetDestination(redirector) == IntPtr.Zero;
            }

            /// <summary>
            /// Points a redirector at destination (Zero: nowhere) and marks its package unsaved. Saving writes the
            /// new destination; a broken one is written as nothing, so saving deletes it in effect. Checks nothing
            /// about destination: see the class rule above. False if redirector isn't one, or the write didn't take.
            /// </summary>
            public static bool SetDestination(IntPtr redirector, IntPtr destination) {
                if (!IsRedirector(redirector) ||
                    !ObjectUtils.WritePointer(redirector, DestinationOffset, destination))
                    return false;
                ObjectUtils.MarkPackageDirty(redirector);
                return true;
            }

            /// <summary>
            /// A new redirector named name in outer (a loaded package or group), pointing at destination (Zero:
            /// nowhere). Public and standalone, as ObjectTools::ConsolidateObjects makes one, so it saves and other
            /// packages can import it. Marks the package unsaved. Zero (logged) on failure; check the name first with
            /// ObjectUtils.CheckNewName.
            /// </summary>
            public static IntPtr Create(IntPtr outer, string name, IntPtr destination) {
                IntPtr r = ObjectUtils.ConstructObject(ClassPathName, outer, name,
                                                       ObjectUtils.FlagPublic | ObjectUtils.FlagStandalone);
                if (r == IntPtr.Zero || SetDestination(r, destination)) return r;
                EngineThunks.Trace("Created " + (ObjectUtils.GetPathName(r) ?? name) +
                                   " but couldn't set its destination; deleted it.");
                ObjectUtils.ForceDelete(r);
                return IntPtr.Zero;
            }

            /// <summary>
            /// Where a redirector points, as its package file records it: the way to name a broken one's destination.
            /// SavePackage writes each export's references to DependsMap, and a redirector's only serialized reference
            /// is DestinationObject, so that entry leads to the import (or export) the editor failed to load. Exact,
            /// not a name match, so it works for redirectors left by renames too. Needs the redirector's package
            /// loaded from its file, and the redirector saved in it (not ObjectUtils.IsNew).
            /// </summary>
            public static RecordedDestination GetRecordedDestination(IntPtr redirector) {
                RecordedDestination d    = new RecordedDestination();
                string              path = ObjectUtils.GetPathName(redirector);
                if (path == null || !IsRedirector(redirector)) return Unrecorded(d, "it isn't a redirector");
                LinkerUtils.LinkerStatus status;
                IntPtr linker = LinkerUtils.GetLinker(PathUtils.GetPackageName(path), false, out status);
                if (status == LinkerUtils.LinkerStatus.NotLoaded) return Unrecorded(d, "its package isn't loaded");
                if (status == LinkerUtils.LinkerStatus.NoLinker)
                    return Unrecorded(d, "its package " + LinkerUtils.NoLinkerReason);
                if (linker == IntPtr.Zero) return Unrecorded(d, "its package's tables aren't available");
                int exportIndex = LinkerUtils.GetExportIndex(redirector);
                if (exportIndex < 0) return Unrecorded(d, "it isn't in its package's export table");
                return GetRecordedDestination(linker, exportIndex);
            }

            /// <summary>
            /// As the overload above, by export: works for a redirector that isn't loaded (FindInPackage), since the
            /// export and dependency tables are in memory while its package is.
            /// </summary>
            public static RecordedDestination GetRecordedDestination(IntPtr linker, int exportIndex) {
                RecordedDestination d = new RecordedDestination();
                if (!string.Equals(LinkerUtils.GetExportClassName(linker, exportIndex), ShortClassName,
                                   StringComparison.OrdinalIgnoreCase))
                    return Unrecorded(d, "it isn't a redirector");
                int[] dependencies = LinkerUtils.GetExportDependencies(linker, exportIndex);
                if (dependencies == null) {
                    EngineThunks.Trace("Can't read where " + LinkerUtils.GetExportPathName(linker, exportIndex) +
                                       " points: " + LinkerUtils.DescribeDependencyTable(linker) + ".");
                    return Unrecorded(d, "its package's dependency table isn't in memory");
                }

                // DependsMap can also list the redirector's own class and its default object. Excluding those by
                // identity leaves the DestinationObject reference.
                string    ownClass   = ShortClassName;
                List<int> candidates = new List<int>();
                foreach (int index in dependencies) {
                    if (index == 0) continue;
                    if (index < 0) {
                        LinkerUtils.Import import = LinkerUtils.GetImport(linker, -index - 1);
                        StringComparison   nocase = StringComparison.OrdinalIgnoreCase;
                        bool isOwnClass   = string.Equals(import.ClassName, "Class", nocase) &&
                                            string.Equals(import.ObjectName, ownClass, nocase);
                        bool isOwnDefault = string.Equals(import.ObjectName, "Default__" + ownClass, nocase);
                        if (isOwnClass || isOwnDefault) continue;
                    }
                    candidates.Add(index);
                }
                if (candidates.Count != 1) {
                    return Unrecorded(d, candidates.Count == 0 ? "it records no destination"
                                                               : "it records " + candidates.Count + " references");
                }

                int destIndex = candidates[0];
                if (destIndex < 0) {
                    LinkerUtils.Import import = LinkerUtils.GetImport(linker, -destIndex - 1);
                    d.PathName                = import.PathName;
                    d.PackageName             = import.PackageName;
                    d.ObjectName              = import.ObjectName;
                    d.ClassName               = import.ClassName;
                    d.ClassPackage            = import.ClassPackage;
                } else { // an export: the destination is in the redirector's own package, loaded or not
                    d.PathName    = LinkerUtils.GetExportPathName(linker, destIndex - 1);
                    d.PackageName = PathUtils.GetPackageName(d.PathName);
                    d.ObjectName  = PathUtils.GetLeafName(d.PathName);
                    d.ClassName   = LinkerUtils.GetExportClassName(linker, destIndex - 1);
                }
                return d.PathName != null ? d : Unrecorded(d, "couldn't read the destination's name");
            }

            private static RecordedDestination Unrecorded(RecordedDestination d, string problem) {
                d.PathName = d.PackageName = d.ObjectName = d.ClassName = d.ClassPackage = null;
                d.Problem  = problem;
                return d;
            }
        }

        // == Genie.LinkerUtils ========================================================================
        // A loaded package's tables (ULinkerLoad*).

        public static class LinkerUtils {
            /// <summary>One entry of a linker's import table.</summary>
            public struct Import {
                public int    Index;        // import index (package index = -(Index+1))
                public string ObjectName;   // leaf name
                public string ClassPackage; // e.g. "Engine"
                public string ClassName;    // e.g. "Material", "Package"
                public int    OuterIndex;   // package index of the outer (0 = none)
                public string PathName;     // full path, outermost first ("bin.Group.Obj")
                public string PackageName;  // outermost package name
            }

            // ULinker layout for this build, read from the engine's own code in XComGame.exe:
            //  * Package-index resolver: ImportMap at +0x130 with index*0x30 (lea x3, shl 4),
            //    ExportMap count at +0x148.
            //  * SavePackage: writes ImportMap, ExportMap (index*0x64, from +0x140), then DependsMap
            //    (index*0x10, from +0x150) after check(DependsMap.Num()==ExportMap.Num()), storing the
            //    file offset of DependsMap in Summary at +0xA0.
            //  * ULinkerLoad::GetExportClassName: ExportMap(i) at +0x140 + i*0x64, its ClassIndex (a package
            //    index; 0 means UClass) at +0x0C.
            // FObjectExport starts with FObjectResource as FObjectImport does, then stock UE3's order:
            //   +0x00 FName ObjectName  +0x08 INT OuterIndex  +0x0C INT ClassIndex  +0x10 INT SuperIndex
            //   +0x14 INT ArchetypeIndex  +0x18 QWORD ObjectFlags  +0x20 INT SerialSize  +0x24 INT SerialOffset
            // Not from engine code: no native accessor exists, UE3 reads the fields inline. Probed on ABN_HallwayDeco,
            // 1031 exports: every OuterIndex rebuilds its export's path (GetExportPathName), and the serial spans run
            // back to back, ending at the file's last byte.
            // The structs are 4-byte packed, so FObjectImport is 0x30 bytes:
            //   +0x00 FName ObjectName  +0x08 INT OuterIndex  +0x0C FName ClassPackage
            //   +0x14 FName ClassName   +0x1C UObject* XObject +0x24 ULinkerLoad* SourceLinker
            //   +0x2C INT SourceIndex
            // A package index is 0 for none, -(i+1) for import i, or i+1 for export i.
            private const int ImportMapData        = 0x130;
            private const int ImportMapNum         = 0x138;
            private const int ExportMapNum         = 0x148;
            private const int DependsMapData       = 0x150;
            private const int DependsMapNum        = 0x158;
            private const int SummaryDependsOffset = 0xA0;
            private const int ImportStride         = 0x30;
            private const int TArrayStride         = 0x10;
            private const int ImportObjectName     = 0x00;
            private const int ImportOuterIndex     = 0x08;
            private const int ImportClassPackage   = 0x0C;
            private const int ImportClassName      = 0x14;
            private const int ExportMapData        = 0x140;
            private const int ExportStride         = 0x64;
            private const int ExportOuterIndex     = 0x08;
            private const int ExportClassIndex     = 0x0C;
            private const int ExportArchetypeIndex = 0x14;
            private const int ExportSerialSize     = 0x20;
            private const int ExportSerialOffset   = 0x24;
            // TArray<FName> NameMap, the slot before ImportMap as in stock UE3's ULinker. Not from engine code:
            // TextureLodProbe matched its count and every name to the file's name table (AACSJ_UI,
            // UILibrary_DLC3Images).
            private const int NameMapData          = 0x120;
            private const int NameMapNum           = 0x128;
            // FString Filename, the file the package was loaded from. Found by a runtime scan for an FString naming
            // the package's own file, consistent across stock, SDK Mods and Workshop packages; not from engine code.
            private const int FileName = 0x1A8;

            /// <summary>
            /// Why GetLinker returned Zero, or Found. NoLinker is normal after a save: SavePackage (0x1D9760) resets
            /// the loader whose file it overwrites (ResetLoaders, called at 0x1DAD83), so the linker leaves
            /// GObjLoaders while the package and its objects stay in memory, still loaded. Nothing in the editor
            /// remakes it.
            /// </summary>
            public enum LinkerStatus {
                Found,
                NotLoaded, // the package isn't in memory
                NoLinker,  // in memory without one: saved since it loaded, made in the editor, or an empty placeholder
                Failed,    // the engine was asked but gave no linker
            }

            /// <summary>Why a package has no tables, to follow its name in a sentence (NoLinker).</summary>
            public const string NoLinkerReason = "has no tables in memory: saving drops them, a new package has none";

            /// <summary>A package's linker, or Zero. See the overload with status.</summary>
            public static IntPtr GetLinker(string packageName, bool openFile = false) {
                LinkerStatus status;
                return GetLinker(packageName, openFile, out status);
            }

            /// <summary>
            /// A package's linker, or Zero with status saying why. By default only a linker already attached is
            /// returned (NoLinker if none). openFile restores a missing one first (ReloadLinker), so Failed means it
            /// couldn't.
            /// </summary>
            public static IntPtr GetLinker(string packageName, bool openFile, out LinkerStatus status) {
                IntPtr pkg = ObjectUtils.FindPackage(packageName);
                status     = LinkerStatus.NotLoaded;
                if (pkg == IntPtr.Zero) return IntPtr.Zero;
                IntPtr linker = EngineNative.FindLinker(pkg);
                if (linker == IntPtr.Zero && openFile && ReloadLinker(packageName))
                    linker = EngineNative.FindLinker(pkg);
                status = linker != IntPtr.Zero ? LinkerStatus.Found
                                               : (openFile ? LinkerStatus.Failed : LinkerStatus.NoLinker);
                return linker;
            }

            /// <summary>
            /// Gives packages in memory without a linker (NoLinker) their linkers back, in one pass, read from the
            /// files the editor saves them to (PackageUtils.GetPackageFile), as the engine's own load makes them. Their
            /// objects in memory are left as they are: nothing is reread or replaced. Returns the packages still
            /// without one: not in memory, with no file under their name (never saved, a placeholder, or renamed since
            /// they loaded), or the engine gave none. Example: Dependency Viewer's Reload Linkers, after a save.
            /// </summary>
            public static List<string> ReloadLinkers(IEnumerable<string> packageNames) {
                List<string> failed = new List<string>(), pending = new List<string>();
                List<IntPtr> packages = new List<IntPtr>();
                foreach (string name in packageNames) {
                    IntPtr pkg = ObjectUtils.FindPackage(name);
                    if (pkg != IntPtr.Zero && EngineNative.FindLinker(pkg) != IntPtr.Zero) continue;
                    if (pkg == IntPtr.Zero || PackageUtils.GetPackageFile(name) == null) {
                        failed.Add(name);
                        continue;
                    }
                    pending.Add(name);
                    packages.Add(pkg);
                }
                if (packages.Count > 0) EngineNative.ReloadLinkers(packages);
                for (int i = 0; i < packages.Count; i++) {
                    if (EngineNative.FindLinker(packages[i]) == IntPtr.Zero) failed.Add(pending[i]);
                }
                return failed;
            }

            /// <summary>ReloadLinkers for one package: true if it has a linker now.</summary>
            public static bool ReloadLinker(string packageName) {
                return ReloadLinkers(new[] { packageName }).Count == 0;
            }

            /// <summary>
            /// Every linker the editor holds: one per package read from a file, its objects loaded or not
            /// (GObjLoaders). Reading their tables loads nothing. Example: Dependency Viewer, finding which open
            /// packages import an object.
            /// </summary>
            public static List<IntPtr> GetLinkers() {
                return EngineNative.Loaders();
            }

            /// <summary>
            /// Packages in the package tree that are in memory with no linker (LinkerStatus.NoLinker), so GetLinkers
            /// misses them: what they import can't be read. Mostly packages saved since they loaded.
            /// </summary>
            public static List<string> GetUnlinkedPackages() {
                return ContentBrowserUtils.GetListedPackages().FindAll(
                    n => ObjectUtils.FindPackage(n) != IntPtr.Zero && GetLinker(n) == IntPtr.Zero);
            }

            public static int GetImportCount(IntPtr linker) {
                return TableCount(linker, ImportMapNum);
            }
            public static int GetExportCount(IntPtr linker) {
                return TableCount(linker, ExportMapNum);
            }

            /// <summary>
            /// Full path of the file the package was loaded from, or null. When a package name exists in several
            /// folders, only one copy loads: this is that copy.
            /// </summary>
            public static string GetFileName(IntPtr linker) {
                if (linker == IntPtr.Zero) return null;
                string file = EngineThunks.ReadFString(EngineThunks.Offset(linker, FileName));
                if (string.IsNullOrEmpty(file)) return null;
                try {
                    // Stock packages store it relative to the exe's folder ("..\..\XComGame\..."), mods absolute.
                    return Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, file));
                } catch {
                    return null;
                }
            }

            /// <summary>
            /// Full path of the file a package's linker reads, or null without one: null after a save too
            /// (LinkerStatus.NoLinker). For the file a package comes from, use PackageUtils.GetPackageFile.
            /// </summary>
            public static string GetFileName(string packageName) {
                return GetFileName(GetLinker(packageName));
            }

            /// <summary>Path name of export i ("Pkg.Group.Obj"), via the engine's ULinker::GetExportPathName.</summary>
            public static string GetExportPathName(IntPtr linker, int exportIndex) {
                if (linker == IntPtr.Zero || exportIndex < 0 || exportIndex >= GetExportCount(linker)) return null;
                MethodInfo m = EngineThunks.Find("ULinker.GetExportPathName");
                if (m == null) return null;
                ParameterInfo[] p = m.GetParameters();
                IntPtr fbuf       = EngineThunks.NewFString();
                try {
                    m.Invoke(null, new object[] {
                        EngineThunks.Box(linker, p[0].ParameterType),
                        EngineThunks.Box(fbuf, p[1].ParameterType),
                        exportIndex,
                        EngineThunks.Box(IntPtr.Zero, p[3].ParameterType),
                        (uint)0,
                    });
                    return EngineThunks.TakeFString(fbuf);
                } catch (Exception ex) {
                    EngineThunks.Trace("GetExportPathName failed: " + ex.Message);
                    return null;
                } finally {
                    Marshal.FreeHGlobal(fbuf);
                }
            }

            /// <summary>
            /// Class name of export i ("MaterialInstanceConstant"), via the engine's ULinkerLoad::GetExportClassName.
            /// Reads the linker's table, so it works for exports that aren't loaded yet. Null if unreadable.
            /// </summary>
            public static string GetExportClassName(IntPtr linker, int exportIndex) {
                if (linker == IntPtr.Zero || exportIndex < 0 || exportIndex >= GetExportCount(linker)) return null;
                MethodInfo m = EngineThunks.Find("ULinkerLoad.GetExportClassName");
                if (m == null) return null;
                ParameterInfo[] p = m.GetParameters();
                // FName* GetExportClassName(ULinkerLoad* this, FName* result, INT ExportIndex): the result comes back
                // in the buffer we pass, an FName of two INTs (name index, number).
                if (p.Length != 3) {
                    EngineThunks.Trace("GetExportClassName has an unexpected signature");
                    return null;
                }
                IntPtr name = Marshal.AllocHGlobal(8);
                try {
                    Marshal.WriteInt64(name, 0);
                    m.Invoke(null, new object[] {
                        EngineThunks.Box(linker, p[0].ParameterType),
                        EngineThunks.Box(name, p[1].ParameterType),
                        exportIndex,
                    });
                    return ObjectUtils.ReadFName(name);
                } catch (Exception ex) {
                    EngineThunks.Trace("GetExportClassName failed: " + ex.Message);
                    return null;
                } finally {
                    Marshal.FreeHGlobal(name);
                }
            }

            /// <summary>
            /// Package index of export i's class: an import below 0, an export of the same package above 0, 0 for
            /// UClass itself or if unreadable. DependsMap can leave an export's class out (archetypes in
            /// AACSJ_Stunlancer_Arcs_NSFW listed nothing from XComGame), so this is how a class import gets credited.
            /// </summary>
            public static int GetExportClassIndex(IntPtr linker, int exportIndex) {
                IntPtr e = ExportEntry(linker, exportIndex);
                return e == IntPtr.Zero ? 0 : Marshal.ReadInt32(e, ExportClassIndex);
            }

            /// <summary>
            /// Package index of export i's outer: 0 for the package itself, else an export (a group, or the object a
            /// subobject belongs to). 0 if unreadable. Reads the table, so it works for exports not loaded.
            /// </summary>
            public static int GetExportOuterIndex(IntPtr linker, int exportIndex) {
                IntPtr e = ExportEntry(linker, exportIndex);
                return e == IntPtr.Zero ? 0 : Marshal.ReadInt32(e, ExportOuterIndex);
            }

            /// <summary>
            /// Package index of export i's archetype, the template it was made from; 0 for its class's default object
            /// or if unreadable. Component templates read as imports, as expected, but no value was checked against
            /// the object.
            /// </summary>
            public static int GetExportArchetypeIndex(IntPtr linker, int exportIndex) {
                IntPtr e = ExportEntry(linker, exportIndex);
                return e == IntPtr.Zero ? 0 : Marshal.ReadInt32(e, ExportArchetypeIndex);
            }

            /// <summary>
            /// Bytes export i takes in the package file, its subobjects not included (they're exports of their own).
            /// 0 for none or if unreadable.
            /// </summary>
            public static int GetExportSerialSize(IntPtr linker, int exportIndex) {
                IntPtr e = ExportEntry(linker, exportIndex);
                int    n = e == IntPtr.Zero ? 0 : Marshal.ReadInt32(e, ExportSerialSize);
                return n < 0 ? 0 : n;
            }

            /// <summary>Import entry i, with names resolved through the engine's FNameToString.</summary>
            public static Import GetImport(IntPtr linker, int importIndex) {
                Import r = new Import();
                r.Index  = importIndex;
                IntPtr e = ImportEntry(linker, importIndex);
                if (e == IntPtr.Zero) return r;
                r.ObjectName   = ObjectUtils.ReadFName(EngineThunks.Offset(e, ImportObjectName));
                r.ClassPackage = ObjectUtils.ReadFName(EngineThunks.Offset(e, ImportClassPackage));
                r.ClassName    = ObjectUtils.ReadFName(EngineThunks.Offset(e, ImportClassName));
                r.OuterIndex   = Marshal.ReadInt32(e, ImportOuterIndex);

                // Walk the outer chain (an import's outers are always imports) to build the path.
                List<string> parts = new List<string>();
                parts.Add(r.ObjectName);
                int outer = r.OuterIndex;
                for (int guard = 0; outer < 0 && guard < 64; guard++) {
                    IntPtr oe = ImportEntry(linker, -outer - 1);
                    if (oe == IntPtr.Zero) break;
                    parts.Insert(0, ObjectUtils.ReadFName(EngineThunks.Offset(oe, ImportObjectName)));
                    outer = Marshal.ReadInt32(oe, ImportOuterIndex);
                }
                if (parts.Contains(null)) return r;
                r.PackageName = parts[0];
                r.PathName    = string.Join(".", parts.ToArray());
                return r;
            }

            /// <summary>
            /// The top-level packages a linker imports objects from (its imports with no outer), each once. Cheaper
            /// than GetImport on every import: only those entries' names are read. Example: Package Renamer, finding
            /// the loaded packages that use a package.
            /// </summary>
            public static List<string> GetImportedPackages(IntPtr linker) {
                List<string> names = new List<string>();
                int          count = GetImportCount(linker);
                for (int i = 0; i < count; i++) {
                    IntPtr e = ImportEntry(linker, i);
                    if (e == IntPtr.Zero || Marshal.ReadInt32(e, ImportOuterIndex) != 0) continue;
                    string name = ObjectUtils.ReadFName(EngineThunks.Offset(e, ImportObjectName));
                    if (name != null && !names.Exists(n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase)))
                        names.Add(name);
                }
                return names;
            }

            /// <summary>
            /// The package indices export i references, from the linker's DependsMap. Null if the
            /// linker has no DependsMap in memory (its count must equal the export count, which the
            /// engine itself requires).
            /// </summary>
            public static int[] GetExportDependencies(IntPtr linker, int exportIndex) {
                if (linker == IntPtr.Zero) return null;
                int exports = GetExportCount(linker);
                if (TableCount(linker, DependsMapNum) != exports || exportIndex < 0 || exportIndex >= exports)
                    return null;
                IntPtr data = Marshal.ReadIntPtr(linker, DependsMapData);
                if (data == IntPtr.Zero) return null;
                IntPtr arr   = EngineThunks.Offset(data, exportIndex * TArrayStride);
                IntPtr items = Marshal.ReadIntPtr(arr, 0);
                int    n     = Marshal.ReadInt32(arr, 8);
                if (n < 0 || n > EngineThunks.MaxTable || (n > 0 && items == IntPtr.Zero)) return null;
                int[] res = new int[n];
                for (int i = 0; i < n; i++) res[i] = Marshal.ReadInt32(items, i * 4);
                return res;
            }

            /// <summary>Why GetExportDependencies returned null, for diagnostics.</summary>
            public static string DescribeDependencyTable(IntPtr linker) {
                if (linker == IntPtr.Zero) return "no linker";
                return "DependsMap.Num=" + TableCount(linker, DependsMapNum) +
                       " ExportMap.Num=" + GetExportCount(linker) + " Summary.DependsOffset=0x" +
                       Marshal.ReadInt32(linker, SummaryDependsOffset).ToString("X");
            }

            /// <summary>
            /// The indices of a linker's exports of this class (its short name, "ObjectRedirector"), in table order,
            /// loaded or not: reads the table only (GetExportClassName).
            /// </summary>
            public static List<int> FindExports(IntPtr linker, string className) {
                List<int> found = new List<int>();
                int       count = GetExportCount(linker);
                for (int i = 0; i < count; i++) {
                    if (string.Equals(GetExportClassName(linker, i), className, StringComparison.OrdinalIgnoreCase))
                        found.Add(i);
                }
                return found;
            }

            /// <summary>Path name of whatever a package index refers to (import or export), or null.</summary>
            public static string GetPackageIndexPathName(IntPtr linker, int packageIndex) {
                if (packageIndex < 0) return GetImport(linker, -packageIndex - 1).PathName;
                if (packageIndex > 0) return GetExportPathName(linker, packageIndex - 1);
                return null;
            }

            /// <summary>A loaded object's index in its own package's export table, or -1.</summary>
            public static int GetExportIndex(IntPtr obj) {
                string path = ObjectUtils.GetPathName(obj);
                if (path == null) return -1;
                IntPtr linker = GetLinker(PathUtils.GetPackageName(path));
                if (linker == IntPtr.Zero) return -1;
                int count = GetExportCount(linker);
                for (int i = 0; i < count; i++) {
                    string p = GetExportPathName(linker, i);
                    if (p != null && string.Equals(p, path, StringComparison.OrdinalIgnoreCase) &&
                        ObjectUtils.FindObject(p) == obj)
                        return i;
                }
                return -1;
            }

            private static int TableCount(IntPtr linker, int numOffset) {
                if (linker == IntPtr.Zero) return 0;
                int n = Marshal.ReadInt32(linker, numOffset);
                return (n < 0 || n > EngineThunks.MaxTable) ? 0 : n;
            }

            private static IntPtr ImportEntry(IntPtr linker, int importIndex) {
                if (linker == IntPtr.Zero || importIndex < 0 || importIndex >= GetImportCount(linker))
                    return IntPtr.Zero;
                IntPtr data = Marshal.ReadIntPtr(linker, ImportMapData);
                return (data == IntPtr.Zero) ? IntPtr.Zero : EngineThunks.Offset(data, importIndex * ImportStride);
            }

            private static IntPtr ExportEntry(IntPtr linker, int exportIndex) {
                if (linker == IntPtr.Zero || exportIndex < 0 || exportIndex >= GetExportCount(linker))
                    return IntPtr.Zero;
                IntPtr data = Marshal.ReadIntPtr(linker, ExportMapData);
                return (data == IntPtr.Zero) ? IntPtr.Zero : EngineThunks.Offset(data, exportIndex * ExportStride);
            }

            // == Saved Properties =====================================================================
            // An export's script properties as its package file saves them, for objects that aren't loaded: reading
            // them from memory would mean loading the object. The linker still gives the offsets and the names; only
            // the property values are read from the file.

            /// <summary>
            /// One saved property (UE3 tagged property). A property at its class default isn't saved, so it has no
            /// tag: a missing LODGroup is TEXTUREGROUP_World.
            /// </summary>
            public sealed class PropertyTag {
                public string Name;       // "LODGroup"
                public string Type;       // "ByteProperty"
                public string TypeName;   // the struct ("Guid") or enum ("TextureGroup"); null for other types
                public int    ArrayIndex;
                public int    Size;       // the value's bytes
                public string Value;      // Int, Bool, Name and enum values as text ("TEXTUREGROUP_UI"); else null
            }

            /// <summary>
            /// Reads exports' saved properties from the file a linker loaded. Open once per package, Read per export,
            /// then Dispose, which closes the file. A loaded object's memory can differ from its file (unsaved edits),
            /// so read those from memory. Example: Dependency Viewer's UI texture check.
            /// </summary>
            public sealed class SavedProperties : IDisposable {
                private const uint PackageTag      = 0x9E2A83C1;
                private const uint StoreCompressed = 0x02000000; // PKG_StoreCompressed: offsets aren't file offsets
                private const int  EnumNameVersion = 633;        // VER_BYTEPROP_SERIALIZE_ENUM: ByteProperty tags
                                                                 // name their enum, and an enum value is an FName

                /// <summary>Open's problem when the file was rewritten since the linker read it.</summary>
                public const string FileChanged = "its file changed since it loaded";

                private readonly IntPtr       _linker;
                private readonly FileStream   _file;
                private readonly List<string> _names;

                private SavedProperties(IntPtr linker, FileStream file, List<string> names) {
                    _linker = linker;
                    _file   = file;
                    _names  = names;
                }

                /// <summary>
                /// A reader for the linker's file, or null with problem saying why, to follow "can't be read: ".
                /// Refused when the file isn't the one the linker read (its exports must end at the file's last byte,
                /// as every probed package's did) or is compressed.
                /// </summary>
                public static SavedProperties Open(IntPtr linker, out string problem) {
                    problem     = null;
                    string path = GetFileName(linker);
                    if (path == null) {
                        problem = "it has no file";
                        return null;
                    }
                    FileStream file = null;
                    try {
                        file    = new FileStream(path, FileMode.Open, FileAccess.Read,
                                                 FileShare.ReadWrite | FileShare.Delete);
                        problem = CheckFile(linker, file);
                        List<string> names = problem == null ? NameMap(linker, file, out problem) : null;
                        if (problem == null) return new SavedProperties(linker, file, names);
                    } catch (Exception ex) {
                        problem = "its file can't be opened (" + ex.Message + ")";
                    }
                    if (file != null) file.Dispose();
                    return null;
                }

                public void Dispose() {
                    _file.Dispose();
                }

                /// <summary>
                /// Export i's saved properties, in file order, or null if they don't parse. Expects an INT NetIndex
                /// before the tags, as textures have (probed); an object with a state frame or other leading data
                /// doesn't parse and gets null rather than a misread.
                /// </summary>
                public List<PropertyTag> Read(int exportIndex) {
                    IntPtr e = ExportEntry(_linker, exportIndex);
                    if (e == IntPtr.Zero) return null;
                    int offset = Marshal.ReadInt32(e, ExportSerialOffset);
                    int size   = Marshal.ReadInt32(e, ExportSerialSize);
                    if (offset < 0 || size < 4 || (long)offset + size > _file.Length) return null;
                    byte[] data = new byte[size];
                    try {
                        _file.Seek(offset, SeekOrigin.Begin);
                        if (ReadFully(_file, data) != size) return null;
                    } catch (IOException) {
                        return null;
                    }
                    return ParseTags(data, 4);
                }

                // Every export must end within the file, the last at its last byte: a file rewritten since the linker
                // read it (a save elsewhere, another tool) moves the data. Then the header: tag, version, flags.
                private static string CheckFile(IntPtr linker, FileStream file) {
                    long end = 0;
                    for (int i = 0; i < GetExportCount(linker); i++) {
                        IntPtr e = ExportEntry(linker, i);
                        end      = Math.Max(end, (long)Marshal.ReadInt32(e, ExportSerialOffset) +
                                                 Marshal.ReadInt32(e, ExportSerialSize));
                    }
                    if (end != file.Length) return FileChanged;
                    Header h = ReadHeader(file);
                    if (h.Tag != PackageTag) return "its file isn't a package";
                    if (h.Version < EnumNameVersion) return "its file is too old a version (" + h.Version + ")";
                    if ((h.Flags & StoreCompressed) != 0) return "it's compressed";
                    return null;
                }

                // The linker's NameMap: saved FNames index it. Its count must match the header's.
                private static List<string> NameMap(IntPtr linker, FileStream file, out string problem) {
                    problem    = null;
                    IntPtr data = Marshal.ReadIntPtr(linker, NameMapData);
                    int    num  = Marshal.ReadInt32(linker, NameMapNum);
                    if (data == IntPtr.Zero || num != ReadHeader(file).NameCount) {
                        problem = "its name table isn't where this build keeps it";
                        return null;
                    }
                    List<string> names = new List<string>(num);
                    for (int i = 0; i < num; i++) names.Add(ObjectUtils.ReadFName(EngineThunks.Offset(data, i * 8)));
                    return names;
                }

                private struct Header {
                    public uint Tag, Flags;
                    public int  Version, NameCount;
                }

                // FPackageFileSummary up to NameCount: tag, version (licensee in the high word), header size,
                // FolderName, PackageFlags, NameCount.
                private static Header ReadHeader(FileStream file) {
                    byte[] b = new byte[1024];
                    file.Seek(0, SeekOrigin.Begin);
                    int    n = ReadFully(file, b);
                    Header h = new Header();
                    if (n < 16) return h;
                    h.Tag     = BitConverter.ToUInt32(b, 0);
                    h.Version = BitConverter.ToInt32(b, 4) & 0xFFFF;
                    int len   = BitConverter.ToInt32(b, 12); // FolderName: negative length means UTF-16
                    int pos   = 16 + (len >= 0 ? len : -len * 2);
                    if (pos < 16 || pos + 8 > n) return h;
                    h.Flags     = BitConverter.ToUInt32(b, pos);
                    h.NameCount = BitConverter.ToInt32(b, pos + 4);
                    return h;
                }

                // FName Name (None ends them), FName Type, INT Size, INT ArrayIndex, then the struct name
                // (StructProperty), a BYTE value (BoolProperty, Size 0) or the enum name (ByteProperty), then Size
                // bytes of value. Null for anything out of place.
                private List<PropertyTag> ParseTags(byte[] b, int pos) {
                    List<PropertyTag> tags = new List<PropertyTag>();
                    while (pos + 8 <= b.Length) {
                        string name = Name(b, ref pos);
                        if (name == null) return null;
                        if (name == "None") return tags;
                        if (pos + 16 > b.Length) return null;
                        PropertyTag t = new PropertyTag { Name = name, Type = Name(b, ref pos) };
                        t.Size        = BitConverter.ToInt32(b, pos);
                        t.ArrayIndex  = BitConverter.ToInt32(b, pos + 4);
                        pos          += 8;
                        if (t.Type == null || !t.Type.EndsWith("Property", StringComparison.Ordinal) || t.Size < 0)
                            return null;
                        if (t.Type == "StructProperty") {
                            if (pos + 8 > b.Length) return null;
                            t.TypeName = Name(b, ref pos);
                        } else if (t.Type == "BoolProperty") {
                            if (pos + 1 > b.Length) return null;
                            t.Value = b[pos++] != 0 ? "true" : "false";
                        } else if (t.Type == "ByteProperty") {
                            if (pos + 8 > b.Length) return null;
                            string e = Name(b, ref pos);
                            t.TypeName = e == "None" ? null : e;
                        }
                        if (t.Type == "BoolProperty") {
                            tags.Add(t);
                            continue;
                        }
                        if (pos + t.Size > b.Length) return null;
                        t.Value = Value(t, b, pos);
                        pos    += t.Size;
                        tags.Add(t);
                    }
                    return null; // no None before the data ended
                }

                private string Value(PropertyTag t, byte[] b, int pos) {
                    int at = pos;
                    if (t.Type == "IntProperty" && t.Size == 4) return BitConverter.ToInt32(b, pos).ToString();
                    if (t.Type == "NameProperty" && t.Size == 8) return Name(b, ref at);
                    if (t.Type == "ByteProperty" && t.TypeName != null && t.Size == 8) return Name(b, ref at);
                    if (t.Type == "ByteProperty" && t.Size == 1) return b[pos].ToString();
                    return null;
                }

                // A saved FName: NameMap index, then number (0 none; n is the suffix _n-1).
                private string Name(byte[] b, ref int pos) {
                    int index = BitConverter.ToInt32(b, pos), number = BitConverter.ToInt32(b, pos + 4);
                    pos      += 8;
                    if (index < 0 || index >= _names.Count || number < 0 || _names[index] == null) return null;
                    return number == 0 ? _names[index] : _names[index] + "_" + (number - 1);
                }

                private static int ReadFully(FileStream file, byte[] into) {
                    int read = 0, n;
                    while (read < into.Length && (n = file.Read(into, read, into.Length - read)) > 0) read += n;
                    return read;
                }
            }
        }

        // == Genie.ContentBrowserUtils ================================================================
        // The editor's Content Browser, through its own controls and backend. Notifications: see
        // "Content Browser Notifications" below.

        public static partial class ContentBrowserUtils {
            /// <summary>
            /// Names of the selected packages, each once, in the order selected: the packages of the selected assets,
            /// else the packages selected in the tree (a selected group counts as its package). So in All Assets,
            /// selecting an object selects its package. Empty if none. Example: Package Loader's Use.
            /// </summary>
            public static string[] GetSelectedPackageNames() {
                List<string> names = new List<string>();
                foreach (BrowserAsset a in GetSelectedAssets()) {
                    if (!string.IsNullOrEmpty(a.Package) &&
                        !names.Exists(n => string.Equals(n, a.Package, StringComparison.OrdinalIgnoreCase)))
                        names.Add(a.Package);
                }
                // Clicking a tree node clears the asset selection first, so a stale asset never wins over it.
                return (names.Count > 0 ? names : SelectedTreePackages()).ToArray();
            }

            /// <summary>The first of GetSelectedPackageNames, or null.</summary>
            public static string GetSelectedPackageName() {
                string[] names = GetSelectedPackageNames();
                return names.Length > 0 ? names[0] : null;
            }

            // The top-level packages of the tree's selection, in its order. A selected group counts as its package.
            internal static List<string> SelectedTreePackages() {
                List<string> names = new List<string>();
                try {
                    object panel = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
                    IEnumerable list =
                        BrowserReflection.Invoke0(panel, "MakeSelectedTopLevelPackageList") as IEnumerable;
                    if (list == null) return names;
                    foreach (object package in list) names.Add(BrowserReflection.NameOf(package));
                } catch {}
                return names;
            }

            /// <summary>
            /// Loaded objects selected in the asset view (backend GetSelectedObjects). Empty if none.
            /// </summary>
            public static IntPtr[] GetSelectedObjects() {
                List<IntPtr> res     = new List<IntPtr>();
                object       backend = BrowserReflection.Backend();
                if (backend == null) return res.ToArray();
                MethodInfo m = BrowserReflection.PickMethod(backend.GetType(), "GetSelectedObjects", 1);
                if (m == null) return res.ToArray();
                IntPtr arr = EngineThunks.NewEmptyArray();
                try {
                    m.Invoke(backend, new object[] { EngineThunks.Box(arr, m.GetParameters()[0].ParameterType) });
                    IntPtr data = Marshal.ReadIntPtr(arr, 0);
                    int    n    = Marshal.ReadInt32(arr, 8);
                    for (int i = 0; i < n && data != IntPtr.Zero && i < EngineThunks.MaxTable; i++) {
                        IntPtr o = Marshal.ReadIntPtr(data, i * IntPtr.Size);
                        if (o != IntPtr.Zero) res.Add(o);
                    }
                } catch (Exception ex) {
                    EngineThunks.Trace("GetSelectedObjects failed: " + ex.Message);
                } finally {
                    // The engine allocated the array's storage; release it with the engine's destructor.
                    MethodInfo dtor = EngineThunks.Find("TArray<UObject *,FDefaultAllocator>.{dtor}");
                    if (dtor != null && Marshal.ReadIntPtr(arr, 0) != IntPtr.Zero) {
                        try {
                            dtor.Invoke(null,
                                        new object[] { EngineThunks.Box(arr, dtor.GetParameters()[0].ParameterType) });
                        } catch (Exception ex) {
                            EngineThunks.Trace("TArray dtor failed: " + ex.Message);
                        }
                    }
                    Marshal.FreeHGlobal(arr);
                }
                return res.ToArray();
            }

            /// <summary>
            /// Opens the object's editor, as double-clicking it does. Does nothing for types without one.
            /// </summary>
            public static bool OpenEditor(IntPtr obj) {
                if (obj == IntPtr.Zero) return false;
                return BrowserReflection.CallBackendWithArray("OpenObjectEditorFor", new IntPtr[] { obj });
            }

            /// <summary>
            /// Opens an asset's editor by full name ("Class Pkg.Group.Obj"), loaded or not: as double-clicking an
            /// unloaded asset does, it's loaded from its package first (ObjectUtils.LoadObject, of any class). Loading
            /// reads from disk; nothing is changed. False if it couldn't be loaded. Pair with IsAssetListed to enable
            /// an Open button for assets that aren't loaded.
            /// </summary>
            public static bool OpenEditor(string fullName) {
                string path = PathUtils.RemoveClassPrefix(fullName);
                if (string.IsNullOrEmpty(path)) return false;
                return OpenEditor(ObjectUtils.LoadObject("Core.Object", path));
            }

            /// <summary>
            /// Calls onChanged (on the UI thread, coalesced) whenever the package tree's selection changes,
            /// including a switch to All Assets. Returns null if the Content Browser isn't available. Dispose to
            /// unsubscribe.
            /// </summary>
            public static IDisposable SubscribeToPackageSelection(Action onChanged) {
                return (onChanged == null)
                           ? null
                           : Subscribe("get_MySourcesPanel", "SelectionChanged", new Coalescer(onChanged));
            }

            // An event of one of MainControl's parts, through a coalescer the caller may share between subscriptions.
            private static IDisposable Subscribe(string part, string eventName, Coalescer coalescer) {
                object source = BrowserReflection.Invoke0(BrowserReflection.MainControl(), part);
                if (source == null) return null;
                try {
                    return SelectionSubscription.Create(source, eventName, coalescer);
                } catch (Exception ex) {
                    EngineThunks.Trace("Couldn't subscribe to the Content Browser's " + eventName + ": " + ex.Message);
                    return null;
                }
            }

            /// <summary>An asset as the Content Browser lists it, loaded or not.</summary>
            public sealed class BrowserAsset {
                /// <summary>The asset's class, as the browser names it ("SwfMovie").</summary>
                public string Type;
                /// <summary>"Package.Group.Object". FindObject finds it if it's loaded.</summary>
                public string Path;
                /// <summary>The top-level package ("Package").</summary>
                public string Package;
            }

            /// <summary>
            /// The assets selected in the Content Browser, including assets that aren't loaded
            /// (GetSelectedObjects returns loaded objects only). Read from the browser's own asset items.
            /// </summary>
            public static BrowserAsset[] GetSelectedAssets() {
                return ReadAssets(BrowserReflection.Invoke0(AssetView(), "get_SelectedAssets"));
            }

            /// <summary>
            /// Every asset the Content Browser currently lists (its asset view, with its filters applied),
            /// loaded or not. In All Assets that's every asset the editor knows (about 300,000, 0.2 s to read):
            /// for one package's assets, use GetPackageAssets.
            /// </summary>
            public static BrowserAsset[] GetListedAssets() {
                object view = AssetView();
                if (view == null) return new BrowserAsset[0];
                const BindingFlags Fields = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
                FieldInfo          f      = view.GetType().GetField("m_AssetListView", Fields);
                object             list   = (f == null) ? null : f.GetValue(view);
                return ReadAssets(BrowserReflection.Invoke0(list, "get_Items"));
            }

            /// <summary>
            /// A package's assets, loaded or not, whatever the Content Browser shows and however it's filtered;
            /// FindObject finds the loaded ones. type: the browser's name for a class ("SwfMovie"), or null for all.
            /// Milliseconds while the tree selects just this package; otherwise from the asset database (about 0.15 s,
            /// then cached for a few seconds), which lacks packages it hasn't indexed, such as a mod's own.
            /// </summary>
            public static BrowserAsset[] GetPackageAssets(string packageName, string type = null) {
                List<BrowserAsset> assets = new List<BrowserAsset>();
                if (string.IsNullOrEmpty(packageName)) return assets.ToArray();

                // MyAssets is the browser's source before its filters: here, the package's assets. The whole package
                // must be selected: a group alone shows just its own assets.
                if (IsSelectedNode(packageName)) {
                    object source = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MyAssets");
                    foreach (BrowserAsset a in ReadAssets(source)) {
                        if (string.Equals(a.Package, packageName, StringComparison.OrdinalIgnoreCase) &&
                            (type == null || string.Equals(a.Type, type, StringComparison.OrdinalIgnoreCase)))
                            assets.Add(a);
                    }
                    return assets.ToArray();
                }

                // Entries read "Class Pkg.Group.Obj".
                string prefix = packageName + ".";
                foreach (string full in AssetDatabaseUtils.GetAllAssets()) {
                    int space = full.IndexOf(' ');
                    if (space <= 0 || string.Compare(full, space + 1, prefix, 0, prefix.Length,
                                                     StringComparison.OrdinalIgnoreCase) != 0)
                        continue;
                    string cls = full.Substring(0, space);
                    if (type != null && !string.Equals(cls, type, StringComparison.OrdinalIgnoreCase)) continue;
                    assets.Add(
                        new BrowserAsset { Type = cls, Path = full.Substring(space + 1), Package = packageName });
                }
                return assets.ToArray();
            }

            /// <summary>
            /// Load the selected assets that aren't loaded yet, as the Content Browser does before acting on
            /// a selection (its LoadSelectedObjectsIfNeeded). Loading reads from disk; nothing is changed.
            /// </summary>
            public static bool LoadSelectedAssets() {
                object backend = BrowserReflection.Backend();
                if (backend == null) return false;
                MethodInfo m = BrowserReflection.PickMethod(backend.GetType(), "LoadSelectedObjectsIfNeeded", 0);
                if (m == null) return false;
                try {
                    m.Invoke(backend, null);
                    return true;
                } catch (Exception ex) {
                    EngineThunks.Trace("LoadSelectedAssets failed: " + ex.Message);
                    return false;
                }
            }

            /// <summary>The package tree node SelectAsset selects.</summary>
            public enum AssetScope {
                Outer,     // the asset's outer: its group, or its package if it has none
                Outermost, // the asset's package, with all its groups
            }

            /// <summary>
            /// Selects an asset in the Content Browser by full name ("Class Pkg.Group.Obj") and scrolls to it, loaded
            /// or not. Never loads it. The defaults do what the browser's own sync does.
            ///   scope: the package tree node to select.
            ///   forceScope: select scope even if the current selection already shows the asset (a parent group,
            ///     say). False leaves such a selection as it is.
            ///   clearFilter: clear the browser's filters first (FilterPanel.ClearFilterForBrowserSync), as its own
            ///     sync does. Without it, an asset the filters hide is still selected, but unseen.
            /// After a tree change the asset is selected once the view has refilled (StartDeferredAssetSelection), so
            /// the selection can land a moment after this returns. False if the browser or the node isn't available.
            /// </summary>
            public static bool SelectAsset(string fullName, AssetScope scope = AssetScope.Outer, bool forceScope = true,
                                           bool clearFilter = true) {
                object view = AssetView();
                string path = PathUtils.RemoveClassPrefix(fullName);
                if (view == null || string.IsNullOrEmpty(path)) return false;
                if (clearFilter) {
                    object filters = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_FilterPanel");
                    BrowserReflection.Invoke0(filters, "ClearFilterForBrowserSync");
                }

                string node = scope == AssetScope.Outermost ? PathUtils.GetOutermostName(path)
                                                            : PathUtils.GetOuterName(path);
                object item = CallAssetView(view, "FindAssetItem", fullName);
                // Already in view, and either allowed to stay or already on the node: select it in place. Reselecting
                // the node may not refill the view, and the deferred selection below waits for a refill.
                if (item != null && (!forceScope || IsSelectedNode(node))) {
                    CallAssetView(view, "SetSelection", item);
                    CallAssetView(view, "SynchronizeViewToAsset", item);
                    return true;
                }
                if (!SelectPackage(node)) return false;
                // The view refills for the new node; an item found before this belongs to the old one.
                CallAssetView(view, "StartDeferredAssetSelection", new List<string> { fullName });
                return true;
            }

            /// <summary>Selects a loaded object's asset, by its full name. See SelectAsset(string, ...).</summary>
            public static bool SelectAsset(IntPtr obj, AssetScope scope = AssetScope.Outer, bool forceScope = true,
                                           bool clearFilter = true) {
                return SelectAsset(ObjectUtils.GetFullName(obj), scope, forceScope, clearFilter);
            }

            /// <summary>
            /// True if the Content Browser can list this asset ("Class Pkg.Group.Obj"), loaded or not: the asset
            /// database knows it, or it's loaded in a package the tree has. The database lacks packages it hasn't
            /// indexed (a mod's own, an SDK Mod package at startup); the browser lists their loaded assets anyway,
            /// but never a subobject ("Obj:Sub"), such as a mesh's sockets.
            /// </summary>
            public static bool IsAssetListed(string fullName) {
                if (AssetDatabaseUtils.Contains(fullName)) return true;
                string path = PathUtils.RemoveClassPrefix(fullName);
                if (string.IsNullOrEmpty(path) || path.IndexOf(':') >= 0) return false;

                // Loaded, of the class asked for, and not a group (a tree node, not an asset).
                IntPtr obj = ObjectUtils.FindObject(path);
                if (obj == IntPtr.Zero || ObjectUtils.IsClass(obj, "Core.Package")) return false;
                if (!string.Equals(ObjectUtils.GetFullName(obj), fullName, StringComparison.OrdinalIgnoreCase))
                    return false;
                return IsPackageListed(PathUtils.GetPackageName(path));
            }

            /// <summary>True if the package tree has this package or group ("Pkg", "Pkg.Group").</summary>
            public static bool IsPackageListed(string pathName) {
                return FindTreeNode(pathName) != null;
            }

            /// <summary>
            /// Selects a package or group in the package tree by path name ("Pkg", "Pkg.Group.Subgroup"), as a
            /// click does: the asset view then lists its assets. Never loads anything. False if the tree has no such
            /// node (SourcesPanelModel.FindPackage) or the browser isn't available.
            /// </summary>
            public static bool SelectPackage(string pathName) {
                if (string.IsNullOrEmpty(pathName)) return false;
                object panel    = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
                Type   nodeType = BrowserReflection.FindType("ContentBrowser.ObjectContainerNode");
                object node     = FindTreeNode(pathName);
                if (panel == null || nodeType == null || node == null) return false;
                MethodInfo select = BrowserReflection.PickMethod(panel.GetType(), "SetSelectedPackages", 1);
                if (select == null) return false;
                try {
                    IList nodes = (IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(nodeType));
                    nodes.Add(node);
                    object r = select.Invoke(panel, new object[] { nodes });
                    // SetSelectedPackages returns false when nothing changed: the node was already the selection.
                    return !(r is bool) || (bool)r || IsSelectedNode(pathName);
                } catch (Exception ex) {
                    EngineThunks.Trace("SelectPackage " + pathName + " failed: " + (ex.InnerException ?? ex).Message);
                    return false;
                }
            }

            /// <summary>
            /// Selects these packages in the tree together. False, selecting nothing, unless the tree lists them all.
            /// </summary>
            public static bool SelectPackages(IList<string> pathNames) {
                object panel    = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
                Type   nodeType = BrowserReflection.FindType("ContentBrowser.ObjectContainerNode");
                if (panel == null || nodeType == null || pathNames == null) return false;
                MethodInfo select = BrowserReflection.PickMethod(panel.GetType(), "SetSelectedPackages", 1);
                if (select == null) return false;
                try {
                    IList nodes = (IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(nodeType));
                    foreach (string name in pathNames) {
                        object node = FindTreeNode(name);
                        if (node == null) return false;
                        nodes.Add(node);
                    }
                    select.Invoke(panel, new object[] { nodes });
                    return true;
                } catch (Exception ex) {
                    EngineThunks.Trace("SelectPackages failed: " + (ex.InnerException ?? ex).Message);
                    return false;
                }
            }

            /// <summary>
            /// Runs onExecute instead of the editor's handler for a package command, a property of the host's
            /// PackageCommands ("OpenPackage"), until you dispose the result. Null if the browser or command isn't
            /// there. Only the main Content Browser: a cloned one keeps the editor's. Example: Addons > Options >
            /// Fix Dependency Handling for Open.
            /// </summary>
            // PreviewExecuted tunnels from the browser's root to whatever fired the command, so it comes before the
            // host's binding wherever that sits, for any control firing it. Handling it stops the host's. CanExecute
            // stays the host's. Nothing is attached until asked, so the command is otherwise stock.
            public static IDisposable TakeOverPackageCommand(string command, Action onExecute) {
                UIElement    main     = BrowserReflection.MainControl() as UIElement;
                Type         commands = BrowserReflection.FindType("ContentBrowser.PackageCommands");
                PropertyInfo property =
                    commands != null ? commands.GetProperty(command, BindingFlags.Public | BindingFlags.Static) : null;
                object taken = property != null ? property.GetValue(null, null) : null;
                if (main == null || taken == null) return null;
                System.Windows.Input.ExecutedRoutedEventHandler handler =
                    delegate(object sender, System.Windows.Input.ExecutedRoutedEventArgs e) {
                    if (e.Command != taken) return;
                    e.Handled = true;
                    try {
                        onExecute();
                    } catch (Exception ex) {
                        GenieBootstrap.Log(command + " failed: " + ex);
                    }
                };
                System.Windows.Input.CommandManager.AddPreviewExecutedHandler(main, handler);
                return new CommandTakeover(main, handler);
            }

            private sealed class CommandTakeover : IDisposable {
                private readonly System.Windows.Input.ExecutedRoutedEventHandler _handler;
                private UIElement                                                _main;

                internal CommandTakeover(UIElement main, System.Windows.Input.ExecutedRoutedEventHandler handler) {
                    _main    = main;
                    _handler = handler;
                }

                public void Dispose() {
                    if (_main != null)
                        System.Windows.Input.CommandManager.RemovePreviewExecutedHandler(_main, _handler);
                    _main = null;
                }
            }

            /// <summary>
            /// The Content Browser's "Open an external package", with every chosen file known to the editor before any
            /// loads (PackageUtils.LoadPackagesFromFiles), so dependencies among them resolve in any order. As the
            /// editor's: starts in its last folder and sets it, a package the tree lists is selected and not loaded,
            /// and what opens ends up selected. Unlike it, two chosen files of one name are
            /// asked about first, and one dialog at the end maps what opened against what it needs.
            /// </summary>
            public static void OpenPackages() {
                Visual    main    = BrowserReflection.MainControl() as Visual;
                object    backend = BrowserReflection.Backend();
                FieldInfo folder =
                    backend == null
                        ? null
                        : backend.GetType().GetField("LastOpenPath", BindingFlags.Instance | BindingFlags.Public |
                                                                         BindingFlags.NonPublic);
                string[] files = WindowUtils.PickFiles(main, "Open packages", "Packages", "*.upk;*.umap",
                                                       folder != null ? folder.GetValue(backend) as string : null);
                if (files.Length == 0) return;
                if (folder != null) folder.SetValue(backend, Path.GetDirectoryName(files[0]));

                files = OpenPackagesDialogs.ChooseCopies(main, files);
                if (files == null) return;

                HashSet<string>    listed = new HashSet<string>(GetListedPackages(), StringComparer.OrdinalIgnoreCase);
                List<string>       toLoad = new List<string>(), select = new List<string>();
                OpenPackagesReport report = new OpenPackagesReport();
                foreach (string file in files) {
                    string name = Path.GetFileNameWithoutExtension(file);
                    if (!listed.Contains(name)) {
                        toLoad.Add(file);
                        continue;
                    }
                    select.Add(name);
                    string known = PackageUtils.GetPackageFile(name);
                    if (known != null && !FileUtils.IsSamePath(known, file)) report.AddListed(name, known);
                }
                foreach (PackageUtils.LoadResult r in PackageUtils.LoadPackagesFromFiles(toLoad)) {
                    if (r.IsLoaded) select.Add(r.PackageName); // after the listed: SelectOnceListed waits on the last
                    report.Add(r);
                }
                SelectOnceListed(select);
                report.Show();
            }

            // A package just loaded joins the tree on a later tick of the browser's.
            private static void SelectOnceListed(List<string> names) {
                if (names.Count == 0 || SelectPackages(names)) return;
                PackageWatch    watch  = null;
                DispatcherTimer giveUp = new DispatcherTimer { Interval = TimeSpan.FromSeconds(5) };
                Action          stop   = delegate {
                    giveUp.Stop();
                    if (watch != null) watch.Dispose();
                    watch = null;
                };
                watch        = WatchPackage(names[names.Count - 1], delegate {
                    if (SelectPackages(names)) stop();
                });
                giveUp.Tick += delegate {
                    stop();
                };
                giveUp.Start();
            }

            /// <summary>Every top-level package in the package tree ("Pkg"), loaded or not.</summary>
            public static List<string> GetListedPackages() {
                List<string> names    = new List<string>();
                object       model    = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySources");
                Type         nodeType = BrowserReflection.FindType("ContentBrowser.Package");
                if (model == null || nodeType == null) return names;
                // GetChildNodes<Package>(List<Package>, bool recurse): from the root, through every folder.
                MethodInfo walk = null;
                foreach (MethodInfo m in model.GetType().GetMethods()) {
                    if (m.Name == "GetChildNodes" && m.IsGenericMethodDefinition && m.GetParameters().Length == 2)
                        walk = m;
                }
                if (walk == null) return names;
                try {
                    IList nodes = (IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(nodeType));
                    walk.MakeGenericMethod(nodeType).Invoke(model, new object[] { nodes, true });
                    foreach (object node in nodes) {
                        string path = BrowserReflection.Invoke0(node, "get_ObjectPathName") as string;
                        if (!string.IsNullOrEmpty(path)) names.Add(path);
                    }
                } catch (Exception ex) {
                    EngineThunks.Trace("GetListedPackages failed: " + (ex.InnerException ?? ex).Message);
                }
                return names;
            }

            /// <summary>
            /// Takes a package off the package tree (SourcesPanelModel.RemovePackage). Only the tree changes: a package
            /// whose file is still on disk comes back with the browser's next full package-list rebuild, which lists
            /// every file in GPackageFileCache except those outside the game's folders (PackageTools.
            /// IsPackagePathExternal): stock packages come back, loose files don't. False if the tree has no such
            /// package.
            /// </summary>
            public static bool RemovePackageFromTree(string packageName) {
                object model = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySources");
                object node  = FindTreeNode(packageName);
                if (model == null || node == null) return false;
                MethodInfo remove = BrowserReflection.PickMethod(model.GetType(), "RemovePackage", 1);
                if (remove == null) return false;
                try {
                    // RemovePackage only unhooks the node from its parent: the tree view would keep it selected, and
                    // the selection would still name the removed package.
                    Unselect(node);
                    remove.Invoke(model, new object[] { node });
                    return FindTreeNode(packageName) == null;
                } catch (Exception ex) {
                    EngineThunks.Trace("RemovePackage " + packageName + " failed: " +
                                       (ex.InnerException ?? ex).Message);
                    return false;
                }
            }

            /// <summary>
            /// Lists a package that's in memory with no file at the path the browser's full rebuild gives one
            /// (MContentBrowserControl.UpdatePackagesTree): SourcesPanelModel.AddPackage("..\..\NewPackages\" + name),
            /// so it shows under NewPackages until saved. Same path, so a later rebuild replaces this node in place
            /// (SourceTreeNode.AddChildNode), and the replacement takes over its selection (AbstractTreeNode.
            /// InitializeNode). True if it's listed afterwards.
            /// </summary>
            public static bool AddPackageToTree(string packageName) {
                if (string.IsNullOrEmpty(packageName)) return false;
                if (IsPackageListed(packageName)) return true;
                object panel = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
                object model = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySources");
                object flat  = BrowserReflection.Invoke0(panel, "get_UsingFlatList");
                if (model == null || !(flat is bool)) return false;
                MethodInfo add = BrowserReflection.PickMethod(model.GetType(), "AddPackage", 2);
                if (add == null) return false;
                try {
                    add.Invoke(model, new object[] { @"..\..\NewPackages\" + packageName, flat });
                } catch (Exception ex) {
                    EngineThunks.Trace("AddPackage " + packageName + " failed: " + (ex.InnerException ?? ex).Message);
                    return false;
                }
                return IsPackageListed(packageName);
            }

            // What the browser does after loading an asset itself (MContentBrowserControl.LoadSelectedObjectsIfNeeded):
            // a refresh for the object; then, if its package is in the tree, one for the package once fully loaded,
            // and a node for each group the object is in that the tree doesn't show yet. It does this while the user's
            // selection stands, so the selection does too (unlike the package open's refresh, SendLoadRefresh).
            internal static void ShowLoadedObject(IntPtr obj) {
                EngineNative.SendAssetLoadRefresh(obj);
                IntPtr pkg  = ObjectUtils.GetOutermost(obj);
                object node = FindTreeNode(ObjectUtils.GetPathName(pkg));
                Type   kind = BrowserReflection.FindType("ContentBrowser.Package"); // not a folder or group node
                if (node == null || kind == null || !kind.IsInstanceOfType(node)) return;
                if (ObjectUtils.IsPackageFullyLoaded(pkg)) EngineNative.SendFullyLoadedRefresh(pkg);
                AddGroupNodes(node, ObjectUtils.GetPathName(obj));
            }

            // The host's walk from the package down: each group's node under its parent (SourceTreeNode.FindPackage),
            // else a new GroupPackage added there (AddChildNode). "Pkg.G1.G2.Obj" has groups G1 and G2; a subobject's
            // ":Sub" stays on the last part.
            private static void AddGroupNodes(object node, string pathName) {
                string[] parts = (pathName ?? "").Split('.');
                if (parts.Length < 3) return;
                Type       group = BrowserReflection.FindType("ContentBrowser.GroupPackage");
                MethodInfo add   = group == null ? null : AddChildNodeMethod(node.GetType(), group);
                if (add == null) return;
                try {
                    for (int i = 1; i < parts.Length - 1 && node != null; i++) {
                        MethodInfo find  = BrowserReflection.PickMethod(node.GetType(), "FindPackage", 1);
                        object     child = find == null ? null : find.Invoke(node, new object[] { parts[i] });
                        if (child == null)
                            child = add.Invoke(node, new object[] { Activator.CreateInstance(group, node, parts[i]) });
                        node = child;
                    }
                } catch (Exception ex) {
                    EngineThunks.Trace("Adding the group nodes of " + pathName +
                                       " failed: " + (ex.InnerException ?? ex).Message);
                }
            }

            // SourceTreeNode.AddChildNode<TNodeType>, made for nodeType.
            private static MethodInfo AddChildNodeMethod(Type treeNodeType, Type nodeType) {
                foreach (MethodInfo m in treeNodeType.GetMethods(BindingFlags.Instance | BindingFlags.Public)) {
                    if (m.Name == "AddChildNode" && m.IsGenericMethodDefinition) return m.MakeGenericMethod(nodeType);
                }
                return null;
            }

            /// <summary>
            /// The tray in the Content Browser's Packages header, left of its tree/list switch, for actions on the
            /// package selected there: AddButton. Docked into the header beside the switch, the one change made to the
            /// browser's tree (PackagesTrayHost), once the browser is up. An addon's own button with an on/off
            /// setting: AddShortcut. Example: Package Renamer's shortcut.
            /// </summary>
            public static GenieTray PackagesTray {
                get { return PackagesTrayHost.Tray; }
            }

            // Takes a node out of the package tree's selection (CustomControls.TreeView.Unselect(item)).
            private static void Unselect(object node) {
                object panel = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
                object tree  = BrowserReflection.Invoke0(panel, "get_PackagesTreeView");
                if (tree == null) return;
                // Unselect has an item overload and a list overload; take the item one.
                foreach (MethodInfo m in tree.GetType().GetMethods(BindingFlags.Instance | BindingFlags.Public |
                                                                   BindingFlags.NonPublic)) {
                    ParameterInfo[] p = m.GetParameters();
                    if (m.Name != "Unselect" || p.Length != 1 || !p[0].ParameterType.IsInstanceOfType(node)) continue;
                    m.Invoke(tree, new object[] { node });
                    return;
                }
            }

            // The package tree's node for a package or group path (SourcesPanelModel.FindPackage), or null.
            private static object FindTreeNode(string pathName) {
                if (string.IsNullOrEmpty(pathName)) return null;
                object     model = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySources");
                if (model == null) return null;
                MethodInfo find = BrowserReflection.PickMethod(model.GetType(), "FindPackage", 1);
                if (find == null) return null;
                try {
                    return find.Invoke(model, new object[] { pathName });
                } catch (Exception ex) {
                    EngineThunks.Trace("FindPackage " + pathName + " failed: " + (ex.InnerException ?? ex).Message);
                    return null;
                }
            }

            // True if the package tree's selection is this node: the node and its subgroups, since selecting a
            // package or group also selects every group under it.
            private static bool IsSelectedNode(string pathName) {
                object      panel = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
                IEnumerable nodes = BrowserReflection.Invoke0(panel, "MakeSelectedNodeList") as IEnumerable;
                if (nodes == null || string.IsNullOrEmpty(pathName)) return false;
                string under = pathName + ".";
                bool   self  = false;
                foreach (object node in nodes) {
                    string path = BrowserReflection.Invoke0(node, "get_ObjectPathName") as string;
                    if (string.Equals(path, pathName, StringComparison.OrdinalIgnoreCase))
                        self = true;
                    else if (path == null || !path.StartsWith(under, StringComparison.OrdinalIgnoreCase))
                        return false;
                }
                return self;
            }

            // AssetView's one-argument methods. Null for a void method, or if the call failed (logged).
            private static object CallAssetView(object view, string method, object arg) {
                MethodInfo m = BrowserReflection.PickMethod(view.GetType(), method, 1);
                if (m == null) {
                    EngineThunks.Trace("AssetView has no " + method);
                    return null;
                }
                try {
                    return m.Invoke(view, new object[] { arg });
                } catch (Exception ex) {
                    EngineThunks.Trace(method + " failed: " + (ex.InnerException ?? ex).Message);
                    return null;
                }
            }

            private static object AssetView() {
                return BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_AssetView");
            }

            private static BrowserAsset[] ReadAssets(object items) {
                List<BrowserAsset> assets = new List<BrowserAsset>();
                IEnumerable e             = items as IEnumerable;
                if (e == null) return assets.ToArray();
                foreach (object item in e) {
                    BrowserAsset a = new BrowserAsset {
                        Type    = BrowserReflection.Invoke0(item, "get_AssetType") as string,
                        Path    = BrowserReflection.Invoke0(item, "get_FullyQualifiedPath") as string,
                        Package = BrowserReflection.Invoke0(item, "get_PackageName") as string,
                    };
                    if (!string.IsNullOrEmpty(a.Path)) assets.Add(a);
                }
                return assets.ToArray();
            }

            /// <summary>
            /// Fully loads a package by name, as the Content Browser's own Fully Load command does: from the file the
            /// engine finds for that name, whichever copy that is. Nothing is changed or saved. False if it couldn't.
            /// To load from a file of your choosing: PackageUtils.LoadPackagesFromFiles.
            /// </summary>
            public static bool FullyLoadPackage(string packageName) {
                if (string.IsNullOrEmpty(packageName)) return false;
                object backend = BrowserReflection.Backend();
                if (backend == null) return false;
                MethodInfo m = BrowserReflection.PickMethod(backend.GetType(), "FullyLoadPackage", 1);
                if (m == null) return false;
                try {
                    object r = m.Invoke(backend, new object[] { packageName });
                    return !(r is bool) || (bool)r;
                } catch (Exception ex) {
                    EngineThunks.Trace("FullyLoadPackage " + packageName + " failed: " + ex.Message);
                    return false;
                }
            }

            /// <summary>
            /// Calls onChanged (on the UI thread, coalesced) whenever the Content Browser's object (asset)
            /// selection changes. Read it with GetSelectedAssets, or GetSelectedObjects for loaded ones.
            /// Returns null if the Content Browser isn't available. Dispose the result to stop.
            /// </summary>
            public static IDisposable SubscribeToObjectSelection(Action onChanged) {
                return (onChanged == null)
                           ? null
                           : Subscribe("get_AssetView", "AssetSelectionChanged", new Coalescer(onChanged));
            }

            /// <summary>
            /// Calls onChanged (on the UI thread, coalesced) when the named package loads, unloads, is
            /// modified or saved, or appears or disappears in the package tree. Modified: the browser's first
            /// unsaved change, and every change made through Genie (MarkPackageDirty, ForceDelete). The package
            /// needn't be in the tree yet; null watches nothing until ChangePackage. Returns null if the Content
            /// Browser isn't available. Dispose to stop. In a window, the owner overload saves the disposing.
            /// </summary>
            public static PackageWatch WatchPackage(string packageName, Action onChanged) {
                if (onChanged == null) return null;
                PackageWatch watch = new PackageWatch(packageName, onChanged);
                if (watch.Start()) return watch;
                watch.Dispose();
                return null;
            }

            /// <summary>
            /// The same, while owner is loaded: from when its window opens until it closes, and again if it
            /// reopens, on the package it was last given. Not null (given an owner and a handler): while the
            /// Content Browser isn't available it watches nothing. Example: Redirector Manager's destination.
            /// </summary>
            public static PackageWatch WatchPackage(FrameworkElement owner, string packageName, Action onChanged) {
                if (owner == null || onChanged == null) return null;
                PackageWatch watch = new PackageWatch(packageName, onChanged);
                ControlUtils.WhileLoaded(owner, delegate { watch.Start(); }, watch.Stop);
                return watch;
            }

            /// <summary>
            /// WatchPackage for a set of packages, one handler for them all: a burst of changes across the set calls
            /// it once. Name the set with SetPackages, again as it changes; a name kept keeps its watch. While owner
            /// is loaded, as WatchPackage's owner overload. Example: Dependency Viewer's mod view.
            /// </summary>
            public static PackageSetWatch WatchPackages(FrameworkElement owner, Action onChanged) {
                if (owner == null || onChanged == null) return null;
                PackageSetWatch watch = new PackageSetWatch(onChanged);
                ControlUtils.WhileLoaded(owner, watch.Start, watch.Stop);
                return watch;
            }

            /// <summary>From WatchPackages: a PackageWatch per package, one handler. Dispose to stop sooner.</summary>
            public sealed class PackageSetWatch : IDisposable {
                private readonly Coalescer                        _coalescer;
                private readonly Dictionary<string, PackageWatch> _watches =
                    new Dictionary<string, PackageWatch>(StringComparer.OrdinalIgnoreCase);
                private bool _started, _disposed;

                internal PackageSetWatch(Action handler) {
                    _coalescer = new Coalescer(handler);
                }

                /// <summary>The packages watched.</summary>
                public ICollection<string> Packages {
                    get { return _watches.Keys; }
                }

                /// <summary>Watch exactly these packages. Null or empty: none.</summary>
                public void SetPackages(IEnumerable<string> packageNames) {
                    if (_disposed) return;
                    HashSet<string> wanted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    foreach (string name in packageNames ?? new string[0]) {
                        if (!string.IsNullOrEmpty(name)) wanted.Add(name);
                    }
                    foreach (string name in new List<string>(_watches.Keys)) {
                        if (wanted.Contains(name)) continue;
                        _watches[name].Dispose();
                        _watches.Remove(name);
                    }
                    foreach (string name in wanted) {
                        if (_watches.ContainsKey(name)) continue;
                        PackageWatch watch = new PackageWatch(name, _coalescer.Fire);
                        _watches[name]     = watch;
                        if (_started) watch.Start();
                    }
                }

                public void Dispose() {
                    if (_disposed) return;
                    _disposed = true;
                    _coalescer.Dispose();
                    foreach (PackageWatch watch in _watches.Values) watch.Dispose();
                    _watches.Clear();
                }

                internal void Start() {
                    if (_disposed) return;
                    _started = true;
                    foreach (PackageWatch watch in _watches.Values) watch.Start();
                }

                internal void Stop() {
                    _started = false;
                    foreach (PackageWatch watch in _watches.Values) watch.Stop();
                }
            }

            /// <summary>
            /// From WatchPackage. Notifies when one package's Content Browser state changes: it loads or
            /// unloads, is modified or saved, or its node appears or disappears from the tree. Works for
            /// packages not in the tree yet. Dispose to stop.
            /// </summary>
            public sealed class PackageWatch : IDisposable {
                private readonly Coalescer _coalescer;

                // Set by Start: the browser's sources model and the hooks into it.
                private object             _model;
                private MethodInfo         _find;
                private DependencyProperty _statusProp;

                private string           _name;
                private DependencyObject _node;
                private bool             _started, _disposed;

                internal PackageWatch(string name, Action handler) {
                    _name      = name;
                    _coalescer = new Coalescer(handler);
                }

                public string PackageName {
                    get { return _name; }
                }

                /// <summary>
                /// Watch another package (null: nothing, until changed again). Cheaper than a new watch: the
                /// shared tree hooks stay in place.
                /// </summary>
                public void ChangePackage(string packageName) {
                    if (_disposed || string.Equals(_name, packageName, StringComparison.OrdinalIgnoreCase)) return;
                    _name = packageName;
                    if (_started) Attach(Find());
                }

                public void Dispose() {
                    if (_disposed) return;
                    _disposed = true;
                    _coalescer.Dispose();
                    Stop();
                }

                // Hooks the package tree. False if the Content Browser isn't available.
                internal bool Start() {
                    if (_disposed || _started) return _started;
                    object main  = BrowserReflection.MainControl();
                    object model = main == null ? null : BrowserReflection.Invoke0(main, "get_MySources");
                    object root  = model == null ? null : BrowserReflection.Invoke0(model, "get_RootFolder");
                    if (root == null) return false;
                    try {
                        _model      = model;
                        _find       = FindPackageMethod(model.GetType());
                        _statusProp = StatusProperty();
                        PackageTreeStructure.AddRef(root, BrowserReflection.FindType("ContentBrowser.Folder"));
                    } catch (Exception ex) {
                        EngineThunks.Trace("WatchPackage failed: " + ex.Message);
                        return false;
                    }
                    PackageTreeStructure.Changed += OnStructure;
                    PackageEdits.Changed         += OnEdit;
                    _started                      = true;
                    Attach(Find());
                    return true;
                }

                internal void Stop() {
                    if (!_started) return;
                    _started = false;
                    Detach();
                    PackageTreeStructure.Changed -= OnStructure;
                    PackageEdits.Changed         -= OnEdit;
                    PackageTreeStructure.Release();
                }

                // ObjectContainerNode.StatusProperty: a node's loaded, modified and saved state.
                private static DependencyProperty StatusProperty() {
                    Type               nodeType = BrowserReflection.FindType("ContentBrowser.ObjectContainerNode");
                    const BindingFlags Statics  = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
                    if (nodeType != null) {
                        FieldInfo          f      = nodeType.GetField("StatusProperty", Statics);
                        DependencyProperty status = f == null ? null : f.GetValue(null) as DependencyProperty;
                        if (status != null) return status;
                    }
                    EngineThunks.Trace("WatchPackage: ObjectContainerNode.StatusProperty not found; " +
                                       "watching tree changes and IsModified only");
                    return null;
                }

                private void OnEdit(string packageName) {
                    if (_started && string.Equals(packageName, _name, StringComparison.OrdinalIgnoreCase))
                        _coalescer.Fire();
                }

                // The sources model's FindPackage(string): package name -> tree node.
                private static MethodInfo FindPackageMethod(Type modelType) {
                    const BindingFlags Methods = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
                    foreach (MethodInfo m in modelType.GetMethods(Methods)) {
                        ParameterInfo[] p = m.GetParameters();
                        if (m.Name == "FindPackage" && p.Length == 1 && p[0].ParameterType == typeof(string)) return m;
                    }
                    return null;
                }

                private DependencyObject Find() {
                    if (_find == null || string.IsNullOrEmpty(_name)) return null;
                    try {
                        return _find.Invoke(_model, new object[] { _name }) as DependencyObject;
                    } catch {
                        return null;
                    }
                }

                private void Attach(DependencyObject node) {
                    Detach();
                    _node = node;
                    if (_node == null) return;
                    System.ComponentModel.DependencyPropertyDescriptor status = StatusDescriptor();
                    if (status != null) status.AddValueChanged(_node, OnNodeChanged);
                    System.ComponentModel.INotifyPropertyChanged notifier =
                        _node                                    as System.ComponentModel.INotifyPropertyChanged;
                    if (notifier != null) notifier.PropertyChanged += OnNodePropertyChanged;
                }

                private void Detach() {
                    if (_node == null) return;
                    System.ComponentModel.DependencyPropertyDescriptor status = StatusDescriptor();
                    if (status != null) {
                        try {
                            status.RemoveValueChanged(_node, OnNodeChanged);
                        } catch {}
                    }
                    System.ComponentModel.INotifyPropertyChanged notifier =
                        _node                                    as System.ComponentModel.INotifyPropertyChanged;
                    if (notifier != null) {
                        try {
                            notifier.PropertyChanged -= OnNodePropertyChanged;
                        } catch {}
                    }
                    _node = null;
                }

                private System.ComponentModel.DependencyPropertyDescriptor StatusDescriptor() {
                    if (_statusProp == null) return null;
                    return System.ComponentModel.DependencyPropertyDescriptor.FromProperty(_statusProp,
                                                                                           _node.GetType());
                }

                // The package's node may be replaced when the tree changes.
                private void OnStructure() {
                    if (!_started) return;
                    DependencyObject node = Find();
                    if (ReferenceEquals(node, _node)) return;
                    Attach(node);
                    _coalescer.Fire();
                }

                private void OnNodeChanged(object sender, EventArgs e) {
                    _coalescer.Fire();
                }

                private void OnNodePropertyChanged(object sender, System.ComponentModel.PropertyChangedEventArgs e) {
                    _coalescer.Fire();
                }
            }

            // == Following the User's Package =========================================================
            // The browser's source is the package tree, All Assets or a collection, and only the tree selects
            // packages. So the selected assets name the package first (in All Assets they're all there is), then
            // the tree. Clicking a tree node clears the asset selection before either event arrives, so a stale
            // asset never names the previous package.

            /// <summary>What a PackageFollower does when its deciding selection spans several packages.</summary>
            public enum MultiPackage {
                Refuse, // no package; the header shows MultiPackageText
                First,  // the package of the asset (or tree package) selected first
                Last,   // the package of the asset (or tree package) selected last
            }

            /// <summary>Which of the Content Browser's selections decides a PackageFollower's package.</summary>
            public enum PackageSource {
                AssetsThenTree, // the selected assets' package, else the tree's: the one the user is looking at
                Tree,           // the tree's only: for an action on the package selected there. None in All Assets
            }

            /// <summary>
            /// Keep a header on the package the user is looking at in the Content Browser, and say when it changes:
            /// see PackageFollower. Follows while the header is loaded, so from when its window opens until it closes.
            /// </summary>
            public static PackageFollower FollowPackage(GenieHeader header) {
                return (header == null) ? null : new PackageFollower(header, header);
            }

            /// <summary>
            /// The same, with nothing to show it in: no header, so no pin. Follows while owner is loaded, such as a
            /// tray button while the browser is up. Example: Redirector Manager's shortcut.
            /// </summary>
            public static PackageFollower FollowPackage(FrameworkElement owner) {
                return (owner == null) ? null : new PackageFollower(owner, null);
            }

            /// <summary>
            /// From FollowPackage. By default (Source) the package is the selected assets' (PreferredType's first, if
            /// any are selected), else the package selected in the tree, else none: so in All Assets it's the selected
            /// assets' package. With a header, sets its Package, and holds still while its pin is on. Events run on
            /// the UI thread, once per burst of changes.
            /// </summary>
            public sealed class PackageFollower {
                private static bool _reportedUnavailable;

                private readonly GenieHeader _header; // or null
                private Coalescer            _coalescer;
                private IDisposable          _treeEvents, _assetEvents;
                private PackageWatch         _watch;
                private bool                 _attached, _starting;
                private string               _package; // without a header
                private bool                 _refused;
                private string               _preferredType;
                private MultiPackage         _multiPackage;
                private PackageSource        _source;

                /// <summary>Raised when the package changes, to none included, and once on starting.</summary>
                public event Action PackageChanged;

                /// <summary>Raised when the selection changes but the package doesn't. Not while pinned.</summary>
                public event Action SelectionChanged;

                /// <summary>Raised when the package loads or unloads, or is modified or saved. Pinned or not.</summary>
                public event Action PackageModified;

                internal PackageFollower(FrameworkElement owner, GenieHeader header) {
                    _header = header;
                    if (_header != null) {
                        _header.Controls.PinToolTip  = "Pin: stay on this package";
                        _header.Controls.PinChanged += delegate(bool pinned) {
                            if (!pinned && _attached) _coalescer.Fire(); // catch up with the Content Browser
                        };
                    }
                    ControlUtils.WhileLoaded(owner, Attach, Detach);
                    UpdatePin();
                }

                /// <summary>
                /// The browser's type name ("SwfMovie") of assets that decide the package before any others: with one
                /// selected beside a texture from another package, the package is the movie's. Null: all assets alike.
                /// </summary>
                public string PreferredType {
                    get { return _preferredType; }
                    set {
                        _preferredType = value;
                        Reconsider();
                    }
                }

                /// <summary>What to do when the deciding selection spans several packages. Default Refuse.</summary>
                public MultiPackage MultiPackage {
                    get { return _multiPackage; }
                    set {
                        _multiPackage = value;
                        Reconsider();
                    }
                }

                /// <summary>Which selection decides the package. Default AssetsThenTree.</summary>
                public PackageSource Source {
                    get { return _source; }
                    set {
                        _source = value;
                        Reconsider();
                    }
                }

                // A setting changed: decide again, as a browser event would. Set right after FollowPackage, it's in
                // place before the first decision anyway.
                private void Reconsider() {
                    if (_attached) _coalescer.Fire();
                }

                /// <summary>The package followed, or null for none.</summary>
                public string Package {
                    get { return _header != null ? _header.Package : _package; }
                }

                /// <summary>Always false without a header.</summary>
                public bool IsPinned {
                    get { return _header != null && _header.Controls.IsPinned; }
                }

                private bool IsRefused {
                    get { return _header != null ? _header.IsRefused : _refused; }
                }

                /// <summary>
                /// Read the Content Browser again now, raising no events: for a Refresh button, which rebuilds anyway.
                /// Notifications keep the package current otherwise. Does nothing while pinned.
                /// </summary>
                public void Update() {
                    if (IsPinned) return;
                    string package;
                    bool   refused;
                    Resolve(out package, out refused);
                    Show(package, refused);
                }

                private void Attach() {
                    _attached    = true;
                    _coalescer   = new Coalescer(OnBrowser);
                    _treeEvents  = Subscribe("get_MySourcesPanel", "SelectionChanged", _coalescer);
                    _assetEvents = Subscribe("get_AssetView", "AssetSelectionChanged", _coalescer);
                    if ((_treeEvents == null || _assetEvents == null) && !_reportedUnavailable) {
                        _reportedUnavailable = true;
                        GenieBootstrap.Log("Content Browser notifications aren't available, so addon windows follow " +
                                           "its selection only on Refresh.");
                    }
                    _watch    = WatchPackage(Package, OnModified);
                    _starting = true;
                    _coalescer.Fire(); // after every Loaded handler, so the owner's are done before it hears
                }

                private void Detach() {
                    _attached = false;
                    _coalescer.Dispose();
                    if (_treeEvents != null) _treeEvents.Dispose();
                    if (_assetEvents != null) _assetEvents.Dispose();
                    if (_watch != null) _watch.Dispose();
                    _treeEvents = _assetEvents = null;
                    _watch                     = null;
                }

                // Both events end up here, coalesced: a tree click raises both, and this runs once for it.
                private void OnBrowser() {
                    bool starting = _starting;
                    _starting     = false;
                    if (IsPinned) {
                        if (starting) Raise(PackageChanged);
                        return;
                    }
                    string package;
                    bool   refused;
                    Resolve(out package, out refused);
                    bool changed = starting || refused != IsRefused ||
                                   !string.Equals(package, Package, StringComparison.OrdinalIgnoreCase);
                    Show(package, refused);
                    Raise(changed ? PackageChanged : SelectionChanged);
                }

                // The package can change its file as it loads or unloads, which the header shows.
                private void OnModified() {
                    if (_header != null) _header.Render();
                    Raise(PackageModified);
                }

                private void Show(string package, bool refused) {
                    _package = package;
                    _refused = refused;
                    if (_header != null) _header.Show(package, refused);
                    if (_watch != null) _watch.ChangePackage(Package);
                    UpdatePin();
                }

                private void UpdatePin() {
                    if (_header != null) _header.Controls.IsPinEnabled = Package != null;
                }

                // refused: the deciding packages differ and MultiPackage is Refuse.
                private void Resolve(out string package, out bool refused) {
                    BrowserAsset[] selected =
                        Source == PackageSource.Tree ? new BrowserAsset[0] : GetSelectedAssets();

                    List<string> order = new List<string>(); // one per deciding asset, in selection order
                    if (!string.IsNullOrEmpty(PreferredType)) {
                        foreach (BrowserAsset a in selected) {
                            if (string.Equals(a.Type, PreferredType, StringComparison.OrdinalIgnoreCase))
                                order.Add(a.Package);
                        }
                    }
                    if (order.Count == 0) {
                        foreach (BrowserAsset a in selected) order.Add(a.Package);
                    }
                    order.RemoveAll(string.IsNullOrEmpty);
                    if (order.Count == 0) order = SelectedTreePackages(); // no assets selected

                    package = null;
                    refused = false;
                    if (order.Count == 0) return;
                    bool several = order.Exists(p => !string.Equals(p, order[0], StringComparison.OrdinalIgnoreCase));
                    if (!several || MultiPackage == MultiPackage.First)
                        package = order[0];
                    else if (MultiPackage == MultiPackage.Last)
                        package = order[order.Count - 1];
                    else
                        refused = true;
                }

                private static void Raise(Action handler) {
                    if (handler != null) handler();
                }
            }
        }

        // == Genie.AssetDatabaseUtils =================================================================

        public static class AssetDatabaseUtils {
            private const int CacheSeconds = 5;

            private static List<string> _cache;
            private static DateTime     _cachedAt;

            // Contains' lookup, rebuilt when GetAllAssets returns a new list. A Dictionary as a set: the framework
            // compiles without System.Core, so HashSet isn't available.
            private static Dictionary<string, bool> _index;
            private static List<string>             _indexed;

            /// <summary>
            /// Every asset the editor knows, loaded or not, as "Class Package.Group.Name" ("SwfMovie
            /// gfxCommon.gfxfontlib"): the Game Asset Database the Content Browser itself queries, so it doesn't
            /// depend on what the browser is showing. About 300,000 entries; a query takes ~0.1 s, so results are
            /// reused for a few seconds. Empty if the database isn't available.
            /// </summary>
            public static List<string> GetAllAssets() {
                if (_cache != null && (DateTime.Now - _cachedAt).TotalSeconds < CacheSeconds) return _cache;
                List<string> result = new List<string>();
                MethodInfo   get    = EngineThunks.Find("FGameAssetDatabase.Get");
                MethodInfo   all    = EngineThunks.Find("FGameAssetDatabase.QueryAllAssets");
                if (get == null || all == null) return result;
                try {
                    object db = get.Invoke(null, null);
                    if (db == null || EngineThunks.Unbox(db) == IntPtr.Zero) return result;
                    object[] args = { db, result };
                    all.Invoke(null, args);
                    result = args[1] as List<string> ?? result; // a by-ref parameter: read it back from args
                } catch (Exception ex) {
                    EngineThunks.Trace("Asset database query failed: " + ex.Message);
                    return result;
                }
                _cache    = result;
                _cachedAt = DateTime.Now;
                return result;
            }

            /// <summary>True if the database knows this asset ("Class Pkg.Group.Obj"), loaded or not.</summary>
            public static bool Contains(string fullName) {
                if (string.IsNullOrEmpty(fullName)) return false;
                List<string> all = GetAllAssets();
                if (!ReferenceEquals(all, _indexed)) {
                    _index = new Dictionary<string, bool>(all.Count, StringComparer.OrdinalIgnoreCase);
                    foreach (string a in all) _index[a] = true;
                    _indexed = all;
                }
                return _index.ContainsKey(fullName);
            }

            /// <summary>
            /// The path names of known assets of this class (its short name, "SwfMovie") with this object name, in
            /// any package ("gfxfontlib" -> "gfxCommon.gfxfontlib"). Case-insensitive.
            /// </summary>
            public static List<string> FindAssets(string className, string objectName) {
                List<string> found  = new List<string>();
                string       prefix = className + " ";
                foreach (string full in GetAllAssets()) {
                    if (!full.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) continue;
                    string path = full.Substring(prefix.Length);
                    if (string.Equals(PathUtils.GetLeafName(path), objectName, StringComparison.OrdinalIgnoreCase))
                        found.Add(path);
                }
                return found;
            }
        }

        // == Genie.PackageUtils =======================================================================
        // Packages as the editor manages them, through its own commands (EditorUtils.Exec) and the engine functions
        // they call: what its menus do, without its dialogs.

        public static class PackageUtils {
            /// <summary>
            /// The longest package name the SDK takes without complaint, extension aside: at 40 characters or more
            /// it warns that names must be shorter. A warning, not a refusal, so IsValidName doesn't check it.
            /// </summary>
            public const int MaxNameLength = 39;

            /// <summary>
            /// The SDK's own content folders, full paths: SDK\XComGame\Content and SDK\Engine\Content. A new array
            /// each call. Mods are kept in one of them (GetSdkModFolder): see IsStockFile.
            /// </summary>
            public static string[] GetStockFolders() {
                return new[] {
                    Path.Combine(GetSdkFolder(), @"XComGame\Content"),
                    Path.Combine(GetSdkFolder(), @"Engine\Content"),
                };
            }

            /// <summary>
            /// The file a package comes from: its linker's, else the one the package file cache lists for its name,
            /// if that file is on disk. The cache is where a load by name reads, how the Content Browser lists
            /// packages that aren't loaded, and where the editor saves: its save (0x15AEF10) asks the cache by
            /// GetName, then detaches the linker (LinkerUtils.LinkerStatus.NoLinker), so after a save the cache is the
            /// only record. Null for a name the cache doesn't know (a package never saved, or a placeholder whose file
            /// was missing) or whose file is gone. Example: Package Loader's Use, on a package that isn't loaded yet.
            /// </summary>
            public static string GetPackageFile(string packageName) {
                if (string.IsNullOrEmpty(packageName)) return null;
                string loaded = LinkerUtils.GetFileName(packageName);
                if (loaded != null) {
                    lock (SeenFiles) SeenFiles[packageName] = loaded;
                    return loaded;
                }
                // Not the cache's FindPackageFile, which answers the same: given a name whose file is gone it deletes
                // the entry (FileCacheProbe v2: 7976 entries, 7975 after one lookup), so asking would change what the
                // editor knows.
                string listed;
                if (!Listed().TryGetValue(packageName, out listed)) return null;
                listed = FullCachePath(listed);
                return listed != null && File.Exists(listed) ? listed : null;
            }

            /// <summary>
            /// The last file known for a package name, even one gone from disk, or null: the package file cache's
            /// entry, else the last one this session saw. The cache deletes an entry once any lookup, the editor's
            /// included, finds its file gone, so a file renamed or deleted on disk stays known here. Null for a name
            /// never seen with a file: a package made in the editor and not saved. Example: Dependency Viewer's File
            /// missing card, naming where the file was.
            /// </summary>
            public static string GetCachedPackageFile(string packageName) {
                if (string.IsNullOrEmpty(packageName)) return null;
                string file;
                if (Listed().TryGetValue(packageName, out file)) return FullCachePath(file);
                lock (SeenFiles) return SeenFiles.TryGetValue(packageName, out file) ? FullCachePath(file) : null;
            }

            // Every file seen for a package name this session, in the cache's list or as a linker's: the last one seen
            // wins, and none is dropped.
            private static readonly Dictionary<string, string> SeenFiles =
                new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            // The cache's list by package name, kept until the UI thread next goes idle: an audit asks about many
            // names at once, and the list holds about 8000. Off the UI thread, read fresh every time.
            private static Dictionary<string, string> _listed;

            private static Dictionary<string, string> Listed() {
                Dispatcher ui   = GenieBootstrap.UiDispatcher;
                bool       onUi = ui != null && ui.CheckAccess();
                if (onUi && _listed != null) return _listed;
                Dictionary<string, string> listed =
                    new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (string file in EngineNative.GetPackageFileList()) {
                    try {
                        listed[Path.GetFileNameWithoutExtension(file)] = file;
                    } catch (ArgumentException) {} // a path Windows can't parse names no package
                }
                lock (SeenFiles) {
                    foreach (KeyValuePair<string, string> entry in listed) SeenFiles[entry.Key] = entry.Value;
                }
                if (onUi) {
                    _listed = listed;
                    ui.BeginInvoke(DispatcherPriority.ApplicationIdle, (Action)ForgetListed);
                }
                return listed;
            }

            /// <summary>Drops the kept list, so the next lookup reads the cache again (after adding to it).</summary>
            internal static void ForgetListed() {
                _listed = null;
            }

            // Stock cache entries are relative to the exe's folder, as a linker's are.
            private static string FullCachePath(string file) {
                if (string.IsNullOrEmpty(file)) return null;
                try {
                    return Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, file));
                } catch {
                    return null;
                }
            }

            /// <summary>SDK\XComGame\Content\Mods: mod content the editor lists, inside a stock folder.</summary>
            public static string GetSdkModFolder() {
                return Path.Combine(GetSdkFolder(), @"XComGame\Content\Mods");
            }

            /// <summary>
            /// True if the file ships with the SDK: under a stock folder (GetStockFolders), but not the mods folder
            /// inside one (GetSdkModFolder). Compares paths only. Examples: Dependency Viewer's Stock tag, Package
            /// Renamer's prompt.
            /// </summary>
            public static bool IsStockFile(string file) {
                if (string.IsNullOrEmpty(file) || FileUtils.IsUnder(file, GetSdkModFolder())) return false;
                foreach (string folder in GetStockFolders()) {
                    if (FileUtils.IsUnder(file, folder)) return true;
                }
                return false;
            }

            /// <summary>
            /// Characters the editor refuses in object and package names, as its Move or Rename checks them (the
            /// list it reads lives at RVA 0x3E12B58). File names refuse more: see IsValidName.
            /// </summary>
            public const string InvalidNameCharacters = "\"' ,/.:|&!\n\r\t";

            /// <summary>
            /// True if the editor accepts this as a package or object name, and Windows as a file name: none of
            /// InvalidNameCharacters, nor \ * ? &lt; &gt;.
            /// </summary>
            public static bool IsValidName(string name) {
                if (string.IsNullOrEmpty(name)) return false;
                return name.IndexOfAny(RefusedCharacters.ToCharArray()) < 0;
            }

            /// <summary>
            /// Why IsValidName refuses name, worded for the user, or null. Taken names are the caller's to check:
            /// ObjectUtils.CheckNewName for objects.
            /// </summary>
            public static string CheckName(string name) {
                if (string.IsNullOrEmpty(name)) return "Type a name.";
                if (IsValidName(name)) return null;
                // Spaces, tabs and line breaks are "spaces"; the rest are listed: " ' , / . : | & ! \ * ? < >
                List<string> listed = new List<string>();
                foreach (char c in RefusedCharacters) {
                    if (!char.IsWhiteSpace(c)) listed.Add(c.ToString());
                }
                return "Names can\u2019t contain spaces or any of these: " + string.Join(" ", listed.ToArray());
            }

            private const string RefusedCharacters = InvalidNameCharacters + "\\*?<>";

            /// <summary>
            /// Moves an object to another package and group (OBJ RENAME, the editor's own command). As it does:
            /// creates the package and groups as needed, dirties both packages and tells the Content Browser. Unlike
            /// Move or Rename, it leaves no redirector, so packages that use the object point at its new path only
            /// once they're saved. groupPath: "Group.Sub", or null for the package root. newName: null keeps the
            /// object's name. True if it's at the new path afterwards.
            /// </summary>
            public static bool MoveObject(IntPtr obj, string packageName, string groupPath, string newName = null) {
                string path = ObjectUtils.GetPathName(obj);
                if (path == null || path.IndexOf(':') >= 0) return false; // a subobject moves with its outer
                string leaf  = PathUtils.GetLeafName(path);
                string pkg   = PathUtils.GetPackageName(path);
                string outer = PathUtils.GetOuterName(path);
                string group = (outer != null && outer.Length > pkg.Length) ? outer.Substring(pkg.Length + 1) : null;
                newName      = newName ?? leaf;
                // Unquoted: valid names hold no spaces or quotes. A missing NEWGROUP means the package root.
                string command = "OBJ RENAME OLDPACKAGE=" + pkg + (group != null ? " OLDGROUP=" + group : "") +
                                 " OLDNAME=" + leaf + " NEWPACKAGE=" + packageName +
                                 (string.IsNullOrEmpty(groupPath) ? "" : " NEWGROUP=" + groupPath) +
                                 " NEWNAME=" + newName;
                EditorUtils.Exec(command);
                string target = packageName + (string.IsNullOrEmpty(groupPath) ? "" : "." + groupPath) + "." + newName;
                return ObjectUtils.FindObject(target) == obj;
            }

            /// <summary>
            /// Renames a top-level package in memory, its groups and objects with it (UObject::Rename on the package).
            /// First its loader is detached (ResetLoaders), with bulk data loaded, so nothing reads its file again:
            /// load the whole package first (ContentBrowserUtils.FullyLoadPackage), or what wasn't loaded is lost from
            /// it. Then it's marked unsaved, listed under its new name at once (ContentBrowserUtils.AddPackageToTree),
            /// and the Content Browser is refreshed as OBJ RENAME does it, queuing a rebuild of its list for the next
            /// tick. That rebuild lists the old name again if its file is in the game's folders (see
            /// ContentBrowserUtils.RemovePackageFromTree), and passes a node's selection on to its replacement: select
            /// the new name before it, not the old. One call, no unload, no redirector, nothing on disk. Loaded
            /// packages that use it point at the new paths once saved. False (logged) if newName is taken or the engine
            /// refused. Example: Package Renamer.
            /// </summary>
            public static bool RenamePackage(string packageName, string newName) {
                IntPtr pkg = ObjectUtils.FindPackage(packageName);
                if (pkg == IntPtr.Zero || !IsValidName(newName)) return false;
                EngineNative.RenameFn       rename = EngineNative.Rename(pkg);
                EngineNative.ResetLoadersFn reset  = EngineNative.ResetLoaders();
                if (rename == null || reset == null) return false;
                IntPtr name = Marshal.StringToHGlobalUni(newName);
                try {
                    // A clash without REN_Test is an engine error, so test first.
                    if (rename(pkg, name, IntPtr.Zero,
                               EngineNative.RenTest | EngineNative.RenForceNoResetLoaders) == 0) {
                        EngineThunks.Trace("Can't rename " + packageName + ": " + newName + " is taken.");
                        return false;
                    }
                    reset(pkg);
                    if (rename(pkg, name, IntPtr.Zero, EngineNative.RenForceNoResetLoaders) == 0) {
                        EngineThunks.Trace("The engine didn't rename " + packageName + " to " + newName + ".");
                        return false;
                    }
                } catch (Exception ex) {
                    EngineThunks.Trace("Rename " + packageName + " failed: " + ex.Message);
                    return false;
                } finally {
                    Marshal.FreeHGlobal(name);
                }
                ObjectUtils.MarkPackageDirty(pkg);
                ContentBrowserUtils.AddPackageToTree(newName);
                EngineNative.SendRenameRefresh(pkg);
                return true;
            }

            /// <summary>
            /// Unloads a package (PackageTools::UnloadPackages, the Content Browser's Unload). The editor asks about
            /// unsaved changes first; discardChanges clears the package's unsaved flag so it unloads without asking,
            /// and the changes are lost. True if the editor reports it unloaded. Slow: it runs a full garbage
            /// collection per package, which can freeze the editor for seconds.
            /// </summary>
            public static bool UnloadPackage(string packageName, bool discardChanges = false) {
                IntPtr pkg = ObjectUtils.FindPackage(packageName);
                if (pkg == IntPtr.Zero) return true; // not in memory
                if (discardChanges) ObjectUtils.SetPackageDirty(pkg, false);
                MethodInfo unload = EngineThunks.Find("PackageTools.UnloadPackages");
                if (unload == null) return false;
                IntPtr data;
                IntPtr arr = EngineThunks.NewPointerArray(new IntPtr[] { pkg }, out data);
                try {
                    object r = unload.Invoke(null, new object[] {
                        EngineThunks.Box(arr, unload.GetParameters()[0].ParameterType),
                    });
                    return r != null && Convert.ToUInt32(r) != 0;
                } catch (Exception ex) {
                    EngineThunks.Trace("UnloadPackages " + packageName + " failed: " + ex.Message);
                    return false;
                } finally {
                    Marshal.FreeHGlobal(data);
                    Marshal.FreeHGlobal(arr);
                }
            }

            // == Loading From Files ===================================================================

            public enum LoadErrorKind {
                MissingPackage, // "Can't find file for package 'X' while loading <file>"
                MissingObject,  // "X.Obj (Check the log to see all references!)"; what uses it is only in the log
                Other,
            }

            /// <summary>A load error, in the editor's words, as its Load Errors dialog would list it.</summary>
            public sealed class LoadError {
                public LoadErrorKind Kind;
                public string        Text;

                /// <summary>
                /// Text fit to read alone. The dialog says what a missing object's row is only by its column heading;
                /// a missing package's text says so itself.
                /// </summary>
                public string Description {
                    get { return Kind == LoadErrorKind.MissingObject ? MissingObjectPrefix + Text : Text; }
                }
            }

            private const string MissingObjectPrefix = "Missing object: ";

            /// <summary>
            /// True if both name one load error, each as a Description, a LoadErrorIdentity or the Load Errors dialog's
            /// row, typed or pasted. Case doesn't count. Example: Package Loader's ignored errors.
            /// </summary>
            public static bool IsSameLoadError(string a, string b) {
                return string.Equals(BareLoadError(a), BareLoadError(b), StringComparison.OrdinalIgnoreCase);
            }

            private static string BareLoadError(string error) {
                string text = LoadErrorIdentity(error);
                return text.StartsWith(MissingObjectPrefix, StringComparison.OrdinalIgnoreCase)
                           ? text.Substring(MissingObjectPrefix.Length).Trim()
                           : text;
            }

            /// <summary>
            /// A load error's Description less what can change while it stays the same error: the file being loaded
            /// and the log hint. For remembering an error across runs. Example: Package Loader's ignored errors.
            /// </summary>
            public static string LoadErrorIdentity(string description) {
                const string LogHint = " (Check the log to see all references!)";
                string       text    = (description ?? "").Trim();
                int          loading = text.IndexOf(" while loading ", StringComparison.Ordinal);
                if (loading >= 0) text = text.Substring(0, loading);
                if (text.EndsWith(LogHint, StringComparison.Ordinal))
                    text = text.Substring(0, text.Length - LogHint.Length);
                return text;
            }

            /// <summary>
            /// One file of LoadPackagesFromFiles. Refused (Problem set): never registered or loaded. Loaded with
            /// errors: Package set and Errors listing what it couldn't find.
            /// </summary>
            public sealed class LoadResult {
                public string          File;        // full path
                public string          PackageName; // the file's name without its extension: UE3 names a package so
                public IntPtr          Package;     // Zero if it didn't load
                public string          Problem;     // why it was refused, or null
                public bool            WasLoaded;   // fully loaded from this file before the call: nothing was read
                public List<LoadError> Errors = new List<LoadError>();

                public bool IsLoaded {
                    get { return Package != IntPtr.Zero; }
                }
            }

            /// <summary>
            /// Why the file can't load as its package now, or null. Refused: no file, not a .upk or .umap, or its
            /// package already in memory from another file, or with objects and no file. Loading anyway would point
            /// the editor's lookups by that name at this file for the session. LoadPackagesFromFiles refuses the same,
            /// so check here to say why beforehand. Its package loaded from this same file is fine: loading it again
            /// changes nothing. Example: Package Loader's substep issues.
            /// </summary>
            public static string CheckLoadFromFile(string file) {
                string full = FileUtils.GetFullPath(file);
                if (full == null) return "No file given.";
                string extension = Path.GetExtension(full);
                if (!string.Equals(extension, ".upk", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(extension, ".umap", StringComparison.OrdinalIgnoreCase))
                    return "Not a package file (.upk or .umap).";
                if (!File.Exists(full)) return "No file at this path.";

                string name    = Path.GetFileNameWithoutExtension(full);
                IntPtr package = ObjectUtils.FindPackage(name);
                if (package == IntPtr.Zero) return null;
                string loaded = LinkerUtils.GetFileName(name);
                // Saved since it loaded: no linker, but fully loaded, and the cache names the file it was saved to.
                if (loaded == null && ObjectUtils.IsPackageFullyLoaded(package)) loaded = GetPackageFile(name);
                if (loaded != null)
                    return FileUtils.IsSamePath(loaded, full) ? null : name + " is already loaded from " + loaded + ".";
                // A package whose file was missing when something imported from it stays as an empty placeholder;
                // loading its file fills it, as the editor's own open does.
                if (ObjectUtils.GetObjectsInPackage(name).Length == 0) return null;
                return name + " is in memory with no file, so another file can't load as it.";
            }

            /// <summary>
            /// Loads packages from their files in one pass, as the Content Browser's "Open an external package" does
            /// each: every file is registered with the editor's package file cache first, so imports between them
            /// resolve by name whatever their order, as at launch. Then one component detach and reattach for all,
            /// not one per file, which is most of the editor's per-file cost. Each loaded package shows in the
            /// package tree. Unlike the editor's open, no Load Errors dialog: each result lists its errors instead.
            /// Refused files (CheckLoadFromFile, or a second file of the same name) are left alone; one
            /// fully loaded from it already counts as loaded at no cost. A result per file,
            /// in order; the same file twice loads once. Example: Package Loader.
            /// </summary>
            public static LoadResult[] LoadPackagesFromFiles(IList<string> files) {
                List<LoadResult>               results = new List<LoadResult>();
                Dictionary<string, LoadResult> byName =
                    new Dictionary<string, LoadResult>(StringComparer.OrdinalIgnoreCase);
                List<LoadResult> toLoad = new List<LoadResult>();
                foreach (string file in files ?? new string[0]) {
                    string     full = FileUtils.GetFullPath(file) ?? file;
                    LoadResult r    = new LoadResult { File = full, Problem = CheckLoadFromFile(file) };
                    r.PackageName   = string.IsNullOrEmpty(full) ? null : Path.GetFileNameWithoutExtension(full);
                    results.Add(r);
                    if (r.Problem != null) continue;
                    // Fully loaded from this file already (CheckLoadFromFile passed it, so a file means this one):
                    // nothing to read, so it skips the load and, if all do, the detach and reattach of every
                    // component in the editor. Saved since it loaded counts (GetPackageFile). Not an empty
                    // placeholder with no file, which the load fills.
                    IntPtr package = ObjectUtils.FindPackage(r.PackageName);
                    if (package != IntPtr.Zero && GetPackageFile(r.PackageName) != null &&
                        ObjectUtils.IsPackageFullyLoaded(package)) {
                        r.Package   = package;
                        r.WasLoaded = true;
                        continue;
                    }
                    LoadResult first;
                    if (!byName.TryGetValue(r.PackageName, out first)) {
                        byName[r.PackageName] = r;
                        toLoad.Add(r);
                    } else if (!FileUtils.IsSamePath(first.File, full)) {
                        r.Problem = "Another file in this load is also named " + r.PackageName + ".";
                    }
                }
                if (toLoad.Count == 0) return Finish(results, byName);
                if (!EngineNative.CanLoadPackageFiles()) {
                    foreach (LoadResult r in toLoad) r.Problem = "The editor's loader isn't where this build keeps it.";
                    return Finish(results, byName);
                }

                List<LoadResult> registered = new List<LoadResult>();
                foreach (LoadResult r in toLoad) {
                    if (EngineNative.RegisterPackageFile(r.File))
                        registered.Add(r);
                    else
                        r.Problem = "The editor's package file cache didn't take this file.";
                }
                IntPtr context = EngineNative.BeginReattach();
                try {
                    foreach (LoadResult r in registered) {
                        List<EngineNative.LoadError> raised = new List<EngineNative.LoadError>();
                        r.Package                           = EngineNative.LoadPackageFile(r.File, raised);
                        foreach (EngineNative.LoadError e in raised) {
                            LoadErrorKind kind = e.Type == 0   ? LoadErrorKind.MissingPackage
                                                 : e.Type == 1 ? LoadErrorKind.MissingObject
                                                               : LoadErrorKind.Other;
                            r.Errors.Add(new LoadError { Kind = kind, Text = e.Text ?? "" });
                        }
                    }
                } finally {
                    EngineNative.EndReattach(context);
                }
                // After the reattach, as the editor's open sends it after its own.
                foreach (LoadResult r in registered) {
                    if (r.IsLoaded) EngineNative.SendLoadRefresh(r.Package);
                }
                return Finish(results, byName);
            }

            /// <summary>One file: LoadPackagesFromFiles with a list of one.</summary>
            public static LoadResult LoadPackageFromFile(string file) {
                return LoadPackagesFromFiles(new[] { file })[0];
            }

            // A file listed twice shares the first one's outcome.
            private static LoadResult[] Finish(List<LoadResult> results, Dictionary<string, LoadResult> byName) {
                for (int i = 0; i < results.Count; i++) {
                    LoadResult r = results[i], first;
                    if (r.Problem != null || r.PackageName == null || !byName.TryGetValue(r.PackageName, out first) ||
                        first == r)
                        continue;
                    LoadResult copy = new LoadResult { File = r.File, PackageName = r.PackageName };
                    copy.Package    = first.Package;
                    copy.WasLoaded  = first.WasLoaded;
                    copy.Problem    = first.Problem;
                    copy.Errors     = first.Errors;
                    results[i]      = copy;
                }
                return results.ToArray();
            }
        }

