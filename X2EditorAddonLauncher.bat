            /// </summary>
            public static FrameworkElement CreatePackageCell(string pathName, string text = null, string line = null,
                                                             string missingTip = null, Action afterFind = null) {
                StackPanel       cell = new StackPanel { Margin = new Thickness(4, 5, 4, 5) };
