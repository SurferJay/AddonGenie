                    HorizontalAlignment = HorizontalAlignment.Right,
                    VerticalAlignment   = VerticalAlignment.Top,
                    Margin              = new Thickness(0, -1, -1, 0),
                    Visibility          = Visibility.Collapsed,
                };
                Grid glyph = new Grid { Width = 14, Height = 14 };
                glyph.Children.Add(gear);
                glyph.Children.Add(dot);
                Border icon = FlatIcon(glyph, new[] { gear }, new[] { gear }, onClick, tooltip,
                                       stroke ?? (fill != null ? Theme.UseIconStroke : null), fill);
                icon.SetValue(DotProperty, dot);
                return icon;
            }

            /// <summary>Shows or hides a gear's dot (CreateGearIcon): something in what it opens is set.</summary>
            public static void SetDot(FrameworkElement gear, bool on) {
                UIElement dot = gear == null ? null : gear.GetValue(DotProperty) as UIElement;
                if (dot != null) dot.Visibility = on ? Visibility.Visible : Visibility.Collapsed;
            }

