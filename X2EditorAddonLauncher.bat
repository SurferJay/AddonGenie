                DependencyProperty.RegisterAttached("GenieDot", typeof(UIElement), typeof(ControlUtils));

            /// <summary>
            /// A Use icon for packages: it follows the packages selected in the Content Browser, the selected objects'
            /// in All Assets too (ContentBrowserUtils.GetSelectedPackageNames), loaded or not. It disables itself,
            /// saying why, while none is selected or none has a file (PackageUtils.GetPackageFile). onClick reads the
            /// selection with those two. Example: a package substep, filled from the selection.
            /// </summary>
            public static Border
            CreateUsePackageIcon(Action onClick, string tooltip = "Use the package selected in the Content Browser",
                                 Brush fill = null, Brush stroke = null) {
                System.Windows.Shapes.Path arrow = IconPath(UseArrow, 1.2);
                Border use = FlatIcon(arrow, new[] { arrow }, new[] { arrow }, onClick, tooltip,
                                      stroke ?? Theme.UseIconStroke, fill ?? Theme.UseIconFill);
                WatchPackageSelection(use, delegate {
                    string[] names = ContentBrowserUtils.GetSelectedPackageNames();
                    string why     = null;
                    if (names.Length == 0)
                        why = "No package is selected in the Content Browser";
                    else if (!Array.Exists(names, n => PackageUtils.GetPackageFile(n) != null))
                        why = names.Length == 1 ? names[0] + " has no file"
                                                : "None of the selected packages has a file";
                    SetAvailable(use, why == null, why);
                });
                return use;
            }

            /// <summary>
            /// While owner is loaded, calls onChanged now and whenever GetSelectedPackageNames may answer differently:
            /// the tree's selection or the assets'.
            /// </summary>
            public static void WatchPackageSelection(FrameworkElement owner, Action onChanged) {
                IDisposable packages = null, objects = null;
                WhileLoaded(owner,
                            delegate {
                                packages = ContentBrowserUtils.SubscribeToPackageSelection(onChanged);
                                objects  = ContentBrowserUtils.SubscribeToObjectSelection(onChanged);
                                onChanged();
                            },
                            delegate {
                                if (packages != null) packages.Dispose();
                                if (objects != null) objects.Dispose();
                                packages = objects = null;
                            });
            }

            /// <summary>How a row last ran, for CreateStatusMark.</summary>
            public enum StatusMark { NotRun, Done, Failed, Skipped, Running }

            /// <summary>
            /// A 14px mark of how something ran: a green circled check (Done), a red circled exclamation (Failed), a
            /// grey ring (NotRun), a ring with a dash (Skipped), a spinner (Running). The marks CreateNote uses.
            /// onClick: clickable, with a hand pointer and a soft ring while hovered. Change it in place as the thing
            /// runs (GenieStatusMark). Example: Package Loader's status circles, which open the run history at that
            /// row's latest run.
            /// </summary>
            public static GenieStatusMark CreateStatusMark(StatusMark mark, string tooltip = null,
                                                           Action onClick = null) {
                GenieStatusMark box = new GenieStatusMark(mark, onClick);
                if (tooltip != null) SetToolTip(box, tooltip);
                return box;
            }

            internal static FrameworkElement StatusMarkFace(StatusMark mark) {
                if (mark == StatusMark.Running) return CreateSpinner(14);
                string inner = "";
                Brush  ink   = Theme.TextDisabled;
                if (mark == StatusMark.Done) {
                    inner = " M 4.2,7.2 L 6.2,9.2 L 9.8,5.4";
                    ink   = Theme.SuccessTagText;
                } else if (mark == StatusMark.Failed) {
                    inner = " M 7,3.8 L 7,7.8 M 7,10.2 L 7,10.3";
                    ink   = Theme.DangerTagText;
                } else if (mark == StatusMark.Skipped) {
                    inner = " M 4.3,7 L 9.7,7";
                }
                System.Windows.Shapes.Path path = IconPath(Ring + inner, 1.3);
                path.Stroke                     = ink;
                return path;
            }

