            /// <summary>
            /// Enables a find control if the Content Browser lists its target; otherwise disables it with the tooltip
            /// "Not in the Content Browser", until enabled again with its own. For a find button whose target
            /// changes, call it on each change. Example: Redirector Manager's Find icons.
            /// </summary>
            public static void SetFindable(FrameworkElement control, bool listed) {
                SetAvailable(control, listed, "Not in the Content Browser");
            }

            /// <summary>
            /// Enables an open control if its object is loaded; otherwise disables it with the tooltip "Not loaded",
            /// until enabled again with its own. As SetFindable. Example: Redirector Manager's Open icon.
            /// </summary>
            public static void SetOpenable(FrameworkElement control, bool loaded) {
                SetAvailable(control, loaded, "Not loaded");
            }

            /// <summary>
            /// Disables a control for your own reason, shown as its tooltip, until Unblock. Wins over the reasons a
            /// control sets itself (SetFindable, SetOpenable, a Use icon's selection), which still track underneath,
            /// so Unblock leaves it as they say. Example: a Use icon while the field it fills is disabled.
            /// </summary>
            public static void Block(FrameworkElement control, string reason) {
                if (control == null) return;
                control.SetValue(BlockReasonProperty, reason ?? "");
                ApplyAvailability(control);
            }

            /// <summary>
            /// Locks a whole area, such as a view whose subject is busy: disabled and dimmed, so nothing in it takes
            /// input and tooltips still show. Set it only when it changes: it restyles every control inside.
            /// Example: Package Loader's job view while the job runs.
            /// </summary>
            public static void SetLocked(FrameworkElement area, bool locked) {
                if (area == null) return;
                area.IsEnabled = !locked;
                area.Opacity   = locked ? 0.55 : 1;
            }

            /// <summary>
            /// Cleans a text box as it's typed in or pasted into: clean gets the text and returns what may stay
            /// (ProcessUtils.CleanVariableName, say), and the caret keeps its place. Call it before handling the
            /// box's TextChanged yourself, so your handler sees the cleaned text.
            /// </summary>
            public static void FilterInput(TextBox box, Func<string, string> clean) {
                if (box == null || clean == null) return;
                box.TextChanged += delegate {
                    string text = box.Text, kept = clean(text) ?? "";
                    if (kept == text) return;
                    int caret      = Math.Max(0, box.CaretIndex - (text.Length - kept.Length));
                    box.Text       = kept;
                    box.CaretIndex = Math.Min(caret, kept.Length);
                };
            }

            /// <summary>Lifts Block: the control is enabled again, unless its own reason still disables it.</summary>
            public static void Unblock(FrameworkElement control) {
                if (control == null) return;
                control.ClearValue(BlockReasonProperty);
                ApplyAvailability(control);
            }

            /// <summary>
            /// Paints a flat icon or a button (CreateButton) in a tone, with reason as its tooltip (null: its own),
            /// still clickable, until ClearTone. A flat icon takes the tone's text colour for strokes and its border
            /// colour for fill, as the Use icon's green is Success's; a button is coloured in the tone at rest, hovered
            /// and pressed, as a Danger button is in red. A text box (CreateTextBox, CreatePathBox) or a field group
            /// (CreateFieldGroup) takes the tone's fill, bordered in its text colour: Package Loader's red and orange
            /// substep issues. A reason to be disabled (Block, SetFindable and the like) wins while it lasts; the tone
            /// comes back after it. Example: Redirector Manager's Use icon, Warning for a
            /// selection of the wrong class.
            /// </summary>
            public static void SetTone(FrameworkElement control, TagTone tone, string reason) {
                if (control == null) return;
                control.SetValue(ToneProperty, tone);
                control.SetValue(ToneReasonProperty, reason);
                ApplyAvailability(control);
            }

            /// <summary>Lifts SetTone: the icon's own look and tooltip come back.</summary>
            public static void ClearTone(FrameworkElement control) {
                if (control == null) return;
                control.ClearValue(ToneProperty);
                control.ClearValue(ToneReasonProperty);
                ApplyAvailability(control);
            }

            // A text box's colours: a tone's fill and text colour as border (its border colour is too faint for a
            // field), else the input look, grey for a read-only box.
            private static void PaintField(TextBox box) {
                object tone = box.GetValue(ToneProperty);
                if (tone != null) {
                    Brush fill, edge, ink;
                    ToneBrushes((TagTone)tone, out fill, out edge, out ink);
                    box.Background  = fill;
                    box.BorderBrush = ink;
                } else {
                    box.Background  = box.IsReadOnly ? Theme.PanelBackground : Theme.InputBackground;
                    box.BorderBrush = Theme.InputBorder;
                }
                box.Foreground = box.IsReadOnly ? Theme.TextSecondary : Theme.TextPrimary;
            }

            // A flat icon's pressed-in look, as a toggle that's on, while what it opened is open (GenieMenu).
            internal static void SetActive(FrameworkElement control, bool active) {
                if (control == null) return;
                control.SetValue(ActiveProperty, active);
                Action repaint = control.GetValue(RepaintProperty) as Action;
                if (repaint != null) repaint();
            }

            // A control's own reason to be disabled (SetFindable and the like); null when it's available.
            private static void SetAvailable(FrameworkElement control, bool available, string whyNot) {
                if (control == null) return;
                control.SetValue(UnavailableReasonProperty, available ? null : whyNot ?? "");
                ApplyAvailability(control);
            }

            // Block's reason, else the control's own, disables it and becomes its tooltip; else a tone's reason becomes
            // its tooltip; with none, it gets its own tooltip back. A flat icon then repaints (in its tone, if any).
            private static void ApplyAvailability(FrameworkElement control) {
                string why = (string)control.GetValue(BlockReasonProperty) ??
                             (string)control.GetValue(UnavailableReasonProperty);
                string tip = why ?? (string)control.GetValue(ToneReasonProperty);
                object own = control.GetValue(OwnToolTipProperty);
                if (tip == null && own != null) {
                    SetToolTip(control, own == NoToolTip ? null : own);
                    control.ClearValue(OwnToolTipProperty);
                } else if (tip != null) {
                    if (own == null) control.SetValue(OwnToolTipProperty, GenieToolTip.Get(control) ?? NoToolTip);
                    SetToolTip(control, tip.Length > 0 ? tip : null);
                }
                control.IsEnabled = why == null; // a repaint follows IsEnabledChanged, but not a tone alone
                Action repaint    = control.GetValue(RepaintProperty) as Action;
                if (repaint != null) repaint();
            }

            // While another tooltip shows (a reason, or a tone's): the control's own, or NoToolTip. The reasons:
            // Block's, and its own. Tone: a TagTone, or unset. Repaint: a flat icon's or a button's paint. Recheck: a
            // Use icon's selection check. UntonedLook: a toned button's own colours and template.
            private static readonly object             NoToolTip = new object();
            private static readonly DependencyProperty OwnToolTipProperty =
                DependencyProperty.RegisterAttached("GenieOwnToolTip", typeof(object), typeof(ControlUtils));
            // SetTone's tone, for controls that paint themselves (GenieFieldGroup).
            internal static DependencyProperty ToneValueProperty {
                get { return ToneProperty; }
            }

            private static readonly DependencyProperty ToneProperty =
                DependencyProperty.RegisterAttached("GenieTone", typeof(object), typeof(ControlUtils));
            private static readonly DependencyProperty ToneReasonProperty =
                DependencyProperty.RegisterAttached("GenieToneReason", typeof(string), typeof(ControlUtils));
            private static readonly DependencyProperty RepaintProperty =
                DependencyProperty.RegisterAttached("GenieRepaint", typeof(Action), typeof(ControlUtils));
            private static readonly DependencyProperty ActiveProperty =
                DependencyProperty.RegisterAttached("GenieActive", typeof(bool), typeof(ControlUtils));
            private static readonly DependencyProperty RecheckProperty =
                DependencyProperty.RegisterAttached("GenieRecheck", typeof(Action), typeof(ControlUtils));
            private static readonly DependencyProperty UntonedLookProperty =
                DependencyProperty.RegisterAttached("GenieUntonedLook", typeof(object), typeof(ControlUtils));
            private static readonly DependencyProperty BlockReasonProperty =
                DependencyProperty.RegisterAttached("GenieBlockReason", typeof(string), typeof(ControlUtils));
            private static readonly DependencyProperty UnavailableReasonProperty =
                DependencyProperty.RegisterAttached("GenieUnavailableReason", typeof(string), typeof(ControlUtils));

            /// <summary>
            /// A clickable copy symbol that puts text on the clipboard, placed after what it copies ("Objects used").
            /// Styled like CreateFindIcon; shows a check for a moment once copied. text is read on each click; null
            /// or empty copies nothing.
            /// </summary>
            public static Border CreateCopyIcon(Func<string> text, string tooltip = "Copy", Brush stroke = null,
                                                Brush fill = null) {
                const double CopiedSeconds = 1.5;

                System.Windows.Shapes.Path front = IconPath(CopyFront, 1.3), back = IconPath(CopyBack, 1.3);
                System.Windows.Shapes.Path check = IconPath("M 3.2,7.4 L 5.8,10 L 11,4.6", 1.6);
                check.Stroke                     = Theme.SuccessTagText;
                check.Visibility                 = Visibility.Collapsed;
                Grid glyph                       = new Grid { Width = 14, Height = 14 };
                glyph.Children.Add(back);
                glyph.Children.Add(front);
                glyph.Children.Add(check);

                Border          icon   = null;
                DispatcherTimer settle = new DispatcherTimer { Interval = TimeSpan.FromSeconds(CopiedSeconds) };
                Action<bool>    copied = delegate(bool on) {
                    front.Visibility = back.Visibility = on ? Visibility.Collapsed : Visibility.Visible;
                    check.Visibility                   = on ? Visibility.Visible : Visibility.Collapsed;
                    SetToolTip(icon, on ? "Copied" : tooltip);
                };
                settle.Tick += delegate {
                    settle.Stop();
                    copied(false);
                };
                icon = FlatIcon(glyph, new[] { front, back }, new[] { front }, delegate {
                    string value = (text != null) ? text() : null;
                    if (string.IsNullOrEmpty(value) || !ClipboardUtils.SetText(value)) return;
                    copied(true);
                    settle.Stop(); // a second copy restarts the moment
                    settle.Start();
                }, tooltip, stroke, fill);
                return icon;
            }

            // Two rounded squares, the front one over the back one's corner, in a 14px box.
            private const string CopyFront = "M 5.87,4.64 L 10.59,4.64 A 1.23,1.23 0 0 1 11.82,5.87 " +
                                             "L 11.82,10.59 A 1.23,1.23 0 0 1 10.59,11.82 " +
                                             "L 5.87,11.82 A 1.23,1.23 0 0 1 4.64,10.59 " +
                                             "L 4.64,5.87 A 1.23,1.23 0 0 1 5.87,4.64 Z";
            private const string CopyBack = "M 9.36,4.64 L 9.36,3.41 A 1.23,1.23 0 0 0 8.13,2.18 " +
                                            "L 3.41,2.18 A 1.23,1.23 0 0 0 2.18,3.41 " +
                                            "L 2.18,8.13 A 1.23,1.23 0 0 0 3.41,9.36 L 4.64,9.36";

            // A flat 18px square around a 14px glyph, for an icon that acts on the thing beside it: muted at rest, the
            // link colour on a light square while hovered, faded while disabled, in a tone while set (SetTone).
            // inked: the strokes that take the colour; filled: the closed shapes that take fill. stroke: a fixed
            // colour instead of muted and link.
            private static Border FlatIcon(UIElement glyph, IEnumerable<System.Windows.Shapes.Path> inked,
                                           IEnumerable<System.Windows.Shapes.Path> filled, Action onClick,
                                           string tooltip, Brush stroke, Brush fill) {
                Border icon = new Border {
                    Child             = glyph,
                    Width             = 18,
                    Height            = 18,
                    CornerRadius      = new CornerRadius(3),
                    Background        = Brushes.Transparent, // the whole square takes the click, not just the strokes
                    Cursor            = System.Windows.Input.Cursors.Hand,
                    VerticalAlignment = VerticalAlignment.Center,
                };
                Action paint = delegate {
                    bool hot    = icon.IsMouseOver && icon.IsEnabled;
                    bool active = icon.IsEnabled && (bool)icon.GetValue(ActiveProperty);
                    object tone = icon.IsEnabled ? icon.GetValue(ToneProperty) : null; // disabled: just faded
                    Brush  ink  = stroke ?? (active ? Theme.ToggleOnText : hot ? Theme.LinkHover : Theme.TextSecondary);
                    Brush  body = fill, unused;
                    if (tone != null) ToneBrushes((TagTone)tone, out unused, out body, out ink);
                    foreach (System.Windows.Shapes.Path part in inked) part.Stroke = ink;
                    foreach (System.Windows.Shapes.Path part in filled) part.Fill = body;
                    icon.Background = active ? Theme.ToggleOnBackground
                                      : hot  ? Theme.ButtonHoverBackground
                                             : Brushes.Transparent;
                    icon.Opacity    = icon.IsEnabled ? 1 : 0.4;
                };
                icon.SetValue(RepaintProperty, paint);
                icon.MouseEnter += delegate {
                    paint();
                };
                icon.MouseLeave += delegate {
                    paint();
                };
                icon.IsEnabledChanged += delegate {
                    paint();
                };
                icon.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled = true; // a list row under it would take the click as a selection
                    if (onClick != null) onClick();
                };
                paint();
                if (tooltip != null) SetToolTip(icon, tooltip);
                return icon;
            }

            /// <summary>
            /// A dialog icon: a symbol drawn in a tone's colours (no font dependency). Warning is a triangle; the
            /// others sit in a circle. Default symbol by tone:
            ///   Danger: Warning   Warning, Caution: Exclamation   Success: Check
            ///   Info, Type: Info   Neutral: Question
            /// </summary>
            public static FrameworkElement CreateDialogIcon(TagTone tone, DialogSymbol symbol = DialogSymbol.Default,
                                                            double size = 28) {
                if (symbol == DialogSymbol.Default)
                    symbol = tone == TagTone.Danger                         ? DialogSymbol.Warning
                             : tone == TagTone.Info || tone == TagTone.Type ? DialogSymbol.Info
                             : tone == TagTone.Success                      ? DialogSymbol.Check
                             : tone == TagTone.Neutral                      ? DialogSymbol.Question
                                                                            : DialogSymbol.Exclamation;
                if (symbol == DialogSymbol.None) return null;
                Brush fill, edge, ink;
                ToneBrushes(tone, out fill, out edge, out ink);
                Canvas c = new Canvas { Width = 28, Height = 28 };
                if (symbol == DialogSymbol.Warning)
                    c.Children.Add(new System.Windows.Shapes.Path {
                        Data = Geometry.Parse(
                            "M 14,2.2 L 26.6,24.6 Q 27.2,25.8 25.8,25.8 L 2.2,25.8 Q 0.8,25.8 1.4,24.6 Z"),
                        Fill            = fill,
                        Stroke          = edge,
                        StrokeThickness = 1.2,
                        StrokeLineJoin  = PenLineJoin.Round,
                    });
                else
                    c.Children.Add(new System.Windows.Shapes.Path {
                        Data            = Geometry.Parse("M 14,1 A 13,13 0 1 1 13.99,1 Z"),
                        Fill            = fill,
                        Stroke          = edge,
                        StrokeThickness = 1.2,
                    });
                string mark = null, dot = null;
                switch (symbol) {
                    case DialogSymbol.Exclamation:
                        mark = "M 14,8 L 14,15.5";
                        dot  = "M 14,19.5 m -1.4,0 a 1.4,1.4 0 1 0 2.8,0 a 1.4,1.4 0 1 0 -2.8,0";
                        break;
                    case DialogSymbol.Warning:
                        mark = "M 14,10 L 14,17.2";
                        dot  = "M 14,21.3 m -1.4,0 a 1.4,1.4 0 1 0 2.8,0 a 1.4,1.4 0 1 0 -2.8,0";
                        break;
                    case DialogSymbol.Question:
                        mark = "M 10.6,11.2 C 10.6,8.9 12.2,7.6 14.1,7.6 C 16,7.6 17.5,8.9 17.5,10.7 C 17.5,12.6 " +
                               "15.9,13.2 14.9,14 C 14.3,14.5 14,15 14,16";
                        dot = "M 14,19.8 m -1.35,0 a 1.35,1.35 0 1 0 2.7,0 a 1.35,1.35 0 1 0 -2.7,0";
                        break;
                    case DialogSymbol.Info:
                        mark = "M 14,12.5 L 14,20";
                        dot  = "M 14,8.6 m -1.4,0 a 1.4,1.4 0 1 0 2.8,0 a 1.4,1.4 0 1 0 -2.8,0";
                        break;
                    case DialogSymbol.Check:
                        mark = "M 9,14.4 L 12.6,18 L 19.2,10.6";
                        break;
                    case DialogSymbol.Reload: // the window controls' refresh arrow
                        mark = "M 19.2,13.2 A 5.3,5.3 0 1 0 18,17.3 M 19.4,8.9 L 19.4,13.3 L 15,13.3";
                        break;
                    case DialogSymbol.FileMissing:
                        mark = Page + " M 12.2,14.2 L 15.8,17.8 M 15.8,14.2 L 12.2,17.8";
                        break;
                    case DialogSymbol.FileNew:
                        mark = Page + " M 14,13.6 L 14,18 M 11.8,15.8 L 16.2,15.8";
                        break;
                }
                bool outline = symbol == DialogSymbol.Reload || symbol == DialogSymbol.FileMissing ||
                               symbol == DialogSymbol.FileNew; // line drawings, thinner than a mark
                if (mark != null)
                    c.Children.Add(new System.Windows.Shapes.Path {
                        Data               = Geometry.Parse(mark),
                        Stroke             = ink,
                        StrokeThickness    = outline ? 1.5 : 2.2,
                        StrokeStartLineCap = PenLineCap.Round,
                        StrokeEndLineCap   = PenLineCap.Round,
                        StrokeLineJoin     = PenLineJoin.Round,
                    });
                if (dot != null)
                    c.Children.Add(new System.Windows.Shapes.Path { Data = Geometry.Parse(dot), Fill = ink });
                return new Viewbox {
                    Child             = c,
                    Width             = size,
                    Height            = size,
                    VerticalAlignment = VerticalAlignment.Top,
                };
            }

            // A page with its corner folded, for the file symbols; their marks go on it.
            private const string Page = "M 15.5,7.8 L 10.2,7.8 A 1,1 0 0 0 9.2,8.8 L 9.2,19.2 A 1,1 0 0 0 10.2,20.2 " +
                                        "L 17.8,20.2 A 1,1 0 0 0 18.8,19.2 L 18.8,11.1 Z";

            // == Tooltips and Dialogs =================================================================

            /// <summary>
            /// Give any element the themed tooltip: a light card with a pointer, centred above the element (below
            /// if there's no room), shown almost at once, and also while the element is disabled, so a greyed-out
            /// button can say why. tooltip is text, or any element; null removes it. Use this, not .ToolTip.
            /// </summary>
            public static void SetToolTip(FrameworkElement element, object tooltip) {
                GenieToolTip.Set(element, tooltip);
            }

            /// <summary>
            /// One line for a dialog's list: a name in the code font, followed by tags or notes
            /// ("gfxAlerts.Alerts" [605 KB] 37 bytes larger).
            /// </summary>
            public static FrameworkElement CreateDialogItem(string name, params UIElement[] after) {
                WrapPanel line = new WrapPanel();
                TextBlock n    = CreateMonoText(name, Theme.FontSizeBody);
                n.Margin       = new Thickness(0, 0, Theme.Spacing, 0);
                line.Children.Add(n);
                foreach (UIElement u in after) {
                    FrameworkElement fe = u as FrameworkElement;
                    if (fe != null) {
                        fe.Margin            = new Thickness(0, 0, Theme.Spacing, 0);
                        fe.VerticalAlignment = VerticalAlignment.Center;
                    }
                    line.Children.Add(u);
                }
                return line;
            }

            /// <summary>
            /// As CreateDialogItem, with the tags at the line's right end, so they line up down the list; a long name
            /// ends in an ellipsis before them, its whole in a tooltip. Example: Redirector Manager's delete prompt.
            /// </summary>
            public static FrameworkElement CreateDialogItemTagged(string name, params UIElement[] tags) {
                DockPanel  line  = new DockPanel();
                StackPanel right = new StackPanel { Orientation = Orientation.Horizontal };
                foreach (UIElement u in tags) {
                    FrameworkElement fe = u as FrameworkElement;
                    if (fe != null) {
                        fe.Margin            = new Thickness(Theme.Spacing, 0, 0, 0);
                        fe.VerticalAlignment = VerticalAlignment.Center;
                    }
                    right.Children.Add(u);
                }
                DockPanel.SetDock(right, Dock.Right);
                line.Children.Add(right);
                TextBlock n    = CreateMonoText(name, Theme.FontSizeBody);
                n.Margin       = new Thickness(0);
                n.TextTrimming = TextTrimming.CharacterEllipsis;
                SetToolTip(n, name);
                line.Children.Add(n);
                return line;
            }

            /// <summary>
            /// A light card that opens under an element and points at it (GeniePopover.Show), for a small form or a
            /// confirm that belongs to that element, where a dialog would be too heavy. Closes on a click outside it
            /// or Escape. Example: Package Renamer's shortcut and its prompt.
            /// </summary>
            public static GeniePopover CreatePopover() {
                return new GeniePopover();
            }

            /// <summary>
            /// Ask before doing something, in a themed dialog modal to the window that contains `within` (any
            /// element of your window). Returns true if the user chose `action`. Cancel is the default, so Enter
            /// or Escape cancels.
            ///   question: the heading ("Import 1 movie?").
            ///   action:   the button that goes ahead, named for what it does ("Import", "Delete"), not "OK".
            ///   note:     the consequences, under the items (optional): a string, or a paragraph with tags among
            ///             its words (CreateParagraph).
            ///   items:    lines listing what's affected (optional; see CreateDialogItem).
            ///   tone:     Warning (orange, changes something; default), Danger (red, throws something away:
            ///             the action button turns red too), Caution, Info, Success, Type or Neutral.
            ///   symbol:   the icon's mark; Default picks the tone's own. icon: your own icon instead.
            ///   detail:   a short muted line right under the question, saying why it's asked (optional).
            /// </summary>
            public static bool Confirm(Visual within, string question, string action, object note = null,
                                       IEnumerable<UIElement> items = null, TagTone tone = TagTone.Warning,
                                       DialogSymbol symbol = DialogSymbol.Default, FrameworkElement icon = null,
                                       string detail = null) {
                return GenieDialog.Show(within, question, detail, new[] { action }, note, items, tone,
                                        icon ?? CreateDialogIcon(tone, symbol)) == 0;
            }

            /// <summary>
            /// Body text that wraps, with tags (CreateTag), links (CreateParagraphLink) and icons among its words:
            /// strings, tags, links and any other element, in order; nulls are skipped. A link is part of the words'
            /// text. A tag sits on the words' baseline and wraps as they do: at a
            /// line's end it breaks between its own words, its pill cut in two, open at the break. A tag with an
            /// icon stays whole. An icon keeps a 5px gap from what's beside it (it sets its own Margin), so leave
            /// out the space there; it's centred on its line, and can wrap away from its words like any word. Use
            /// it as a dialog's note, or for a status line: SetParts changes it, FontSize and Foreground restyle it.
            /// Examples: Redirector Manager's class prompt and note, Package Renamer's result.
            /// </summary>
            public static GenieParagraph CreateParagraph(params object[] parts) {
                GenieParagraph paragraph = new GenieParagraph();
                paragraph.SetParts(parts);
                return paragraph;
            }

            /// <summary>
            /// A link among a paragraph's words, for CreateParagraph: CreateLink's look, drawn as part of the words'
            /// own text, so it sits on their baseline and wraps as they do. A CreateLink in an InlineUIContainer
            /// can't: an element has no baseline, so it's aligned by its box and sits off the words' line. tooltip:
            /// text or an element. blocked: why it's off, or null; off, it's muted, takes no clicks, and the reason is
            /// its tooltip. Example: Dependency Viewer's File missing card ("its file").
            /// </summary>
            public static GenieParagraphLink CreateParagraphLink(string text, Action onClick, object tooltip = null,
                                                                 string blocked = null) {
                return new GenieParagraphLink(text, onClick, tooltip, blocked);
            }

            /// <summary>
            /// A dialog that only tells: its one button closes it. note and items as Confirm's. Example: the problems
            /// ContentBrowserUtils.OpenPackages met.
            /// </summary>
            public static void Inform(Visual within, string message, object note = null,
                                      IEnumerable<UIElement> items = null, TagTone tone = TagTone.Info) {
                GenieDialog.Show(within, message, null, new string[0], note, items, tone,
                                 CreateDialogIcon(tone, DialogSymbol.Default), "OK");
            }

            /// <summary>
            /// Confirm with more than one way to go ahead ("Reset primary", "Reset all"). Returns the index of
            /// the action chosen, or -1 for Cancel, which stays the default. Actions show left to right in the order
            /// given; with Danger, every one of them turns red.
            /// </summary>
            public static int Choose(Visual within, string question, string[] actions, object note = null,
                                     IEnumerable<UIElement> items = null, TagTone tone = TagTone.Warning,
                                     DialogSymbol symbol = DialogSymbol.Default, FrameworkElement icon = null,
                                     string detail = null) {
                return GenieDialog.Show(within, question, detail, actions, note, items, tone,
                                        icon ?? CreateDialogIcon(tone, symbol));
            }

            /// <summary>
            /// A dialog's face, for a window of your own: icon (CreateDialogIcon) | the question, a muted detail line
            /// (optional), then body (optional), over a shaded strip holding footer (your buttons). Confirm and Choose
            /// are made of it. For a question that can't hold up the editor by waiting modally, or that no window
            /// owns (one asked at launch), put it in a GenieWindow. Example: Package Loader's unfinished-startup
            /// prompt.
            /// </summary>
            public static FrameworkElement CreateDialogPanel(FrameworkElement icon, string question, string detail,
                                                             UIElement body, UIElement footer) {
                Grid main = new Grid { Margin = new Thickness(18, 18, 20, 14) };
                main.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
                main.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
                if (icon != null) {
                    icon.Margin            = new Thickness(0, 0, 14, 0);
                    icon.VerticalAlignment = VerticalAlignment.Top;
                    main.Children.Add(icon);
                }
                StackPanel text = new StackPanel();
                text.Children.Add(new TextBlock {
                    Text         = question ?? "",
                    FontSize     = Theme.FontSizeTitle - 1,
                    FontWeight   = FontWeights.SemiBold,
                    Foreground   = Theme.TextPrimary,
                    TextWrapping = TextWrapping.Wrap,
                    Margin       = new Thickness(0, 3, 0, 0),
                });
                if (!string.IsNullOrEmpty(detail))
                    text.Children.Add(new TextBlock {
                        Text         = detail,
                        FontSize     = Theme.FontSizeBody,
                        Foreground   = Theme.TextSecondary,
                        TextWrapping = TextWrapping.Wrap,
                        Margin       = new Thickness(0, 2, 0, 0),
                    });
                if (body != null) text.Children.Add(body);
                Grid.SetColumn(text, 1);
                main.Children.Add(text);

                Border    strip  = CreateFooter(footer, new Thickness(14, 10, 14, 10), Theme.PanelBackground);
                DockPanel layout = new DockPanel { LastChildFill = true };
                DockPanel.SetDock(strip, Dock.Bottom);
                layout.Children.Add(strip);
                layout.Children.Add(main);
                return layout;
            }

            // == Internals ============================================================================

            // A square button around a 14px icon, as tall as a text button of its size (a hidden line of text sees to
            // that).
            // The window controls' and an icon group's box: a button's face and edge, around parts that fill it.
            internal static void StyleButtonBox(Border box) {
                box.Background          = Theme.ButtonBackground;
                box.BorderBrush         = Theme.ButtonBorder;
                box.BorderThickness     = new Thickness(1);
                box.CornerRadius        = new CornerRadius(Theme.ButtonCornerRadius);
                box.VerticalAlignment   = VerticalAlignment.Center;
                box.SnapsToDevicePixels = true;
            }

            // A part's corners in such a box: rounded, inside its 1px border, only where the box's are.
            internal static CornerRadius BoxedCorners(int index, int count) {
                double inner = Math.Max(0, Theme.ButtonCornerRadius - 1);
                bool   first = index == 0, last = index == count - 1;
                return new CornerRadius(first ? inner : 0, last ? inner : 0, last ? inner : 0, first ? inner : 0);
            }

            internal static Button CreateIconButton(UIElement icon, ButtonSize size, string tooltip, string name) {
                Grid face = new Grid();
                face.Children.Add(new TextBlock { Text = " ", Visibility = Visibility.Hidden });
                face.Children.Add(icon);
                double inset = (size == ButtonSize.Small) ? 2 : 4; // the text buttons' own vertical padding
                Button button =
                    CreateButton("", size: size, tooltip: tooltip, padding: new Thickness(0, inset, 0, inset));
                button.Content = face;
                button.Margin  = new Thickness(0);
                button.SetBinding(FrameworkElement.WidthProperty, new System.Windows.Data.Binding("ActualHeight") {
                    RelativeSource = System.Windows.Data.RelativeSource.Self,
                });
                System.Windows.Automation.AutomationProperties.SetName(button, name);
                return button;
            }

            // A 14px icon stroke in its button's text colour, so it greys out with the button.
            internal static System.Windows.Shapes.Path IconPath(string data, double thickness) {
                System.Windows.Shapes.Path icon = new System.Windows.Shapes.Path {
                    Data                = Geometry.Parse(data),
                    StrokeThickness     = thickness,
                    StrokeLineJoin      = PenLineJoin.Round,
                    StrokeStartLineCap  = PenLineCap.Round,
                    StrokeEndLineCap    = PenLineCap.Round,
                    Width               = 14,
                    Height              = 14,
                    Stretch             = Stretch.None,
                    HorizontalAlignment = HorizontalAlignment.Center,
                    VerticalAlignment   = VerticalAlignment.Center,
                };
                icon.SetBinding(System.Windows.Shapes.Shape.StrokeProperty, InkBinding());
                return icon;
            }

            // The element's inherited text colour, which a disabled button's template turns grey.
            internal static System.Windows.Data.Binding InkBinding() {
                return new System.Windows.Data.Binding {
                    Path           = new PropertyPath(System.Windows.Documents.TextElement.ForegroundProperty),
                    RelativeSource = System.Windows.Data.RelativeSource.Self,
                };
            }

            // A 1px underline, 2px below the baseline. DashStyles.Dot has zero-length dashes, which a flat-capped
            // pen draws as nothing, so dotted is a 1-on 2-off dash instead.
            internal static TextDecorationCollection Underline(Brush brush, bool dotted) {
                Pen pen = new Pen(brush, 1);
                if (dotted) pen.DashStyle = new DashStyle(new double[] { 1, 2 }, 0);
                TextDecorationCollection underline = new TextDecorationCollection();
                underline.Add(new TextDecoration {
                    Location  = TextDecorationLocation.Underline,
                    Pen       = pen,
                    PenOffset = 2,
                });
                underline.Freeze();
                return underline;
            }

            // A small flat ×, tinted on hover, for closing a note.
            private static Button DismissButton(Brush ink, Brush hover) {
                ControlTemplate         t  = new ControlTemplate(typeof(Button));
                FrameworkElementFactory bd = new FrameworkElementFactory(typeof(Border));
                bd.Name                    = "bd";
                bd.SetValue(Border.BackgroundProperty, Brushes.Transparent);
                bd.SetValue(Border.CornerRadiusProperty, new CornerRadius(3));
                bd.AppendChild(new FrameworkElementFactory(typeof(ContentPresenter)));
                t.VisualTree = bd;
                Trigger over = new Trigger { Property = UIElement.IsMouseOverProperty, Value = true };
                over.Setters.Add(new Setter(Border.BackgroundProperty, hover, "bd"));
                t.Triggers.Add(over);
                t.Seal();

                Button b = new Button {
                    Template          = t,
                    Width             = 20,
                    Height            = 20,
                    VerticalAlignment = VerticalAlignment.Top,
                    Margin            = new Thickness(8, -2, 0, -2),
                    Content =
                        new System.Windows.Shapes.Path {
                            Data                = Geometry.Parse("M 1,1 L 8,8 M 8,1 L 1,8"),
                            Stroke              = ink,
                            StrokeThickness     = 1.3,
                            StrokeStartLineCap  = PenLineCap.Round,
                            StrokeEndLineCap    = PenLineCap.Round,
                            Width               = 9,
                            Height              = 9,
                            Stretch             = Stretch.None,
                            HorizontalAlignment = HorizontalAlignment.Center,
                            VerticalAlignment   = VerticalAlignment.Center,
                        },
                };
                System.Windows.Automation.AutomationProperties.SetName(b, "Dismiss");
                SetToolTip(b, "Dismiss");
                return b;
            }

            // Wrapping text with an optional bold lead: "Lead text".
            private static TextBlock LeadText(string lead, string text, double fontSize, Brush ink) {
                TextBlock t = new TextBlock {
                    FontSize     = fontSize,
                    Foreground   = ink,
                    TextWrapping = TextWrapping.Wrap,
                    LineHeight   = 18,
                };
                if (!string.IsNullOrEmpty(lead)) {
                    System.Windows.Documents.Run strong = new System.Windows.Documents.Run(lead);
                    strong.FontWeight                   = FontWeights.SemiBold;
                    t.Inlines.Add(strong);
                    if (!string.IsNullOrEmpty(text)) t.Inlines.Add(new System.Windows.Documents.Run(" "));
                }
                if (!string.IsNullOrEmpty(text)) AddStressed(t.Inlines, text);
                return t;
            }

            // Text with **stressed** words: the odd pieces between the markers are semibold and underlined. An
            // unpaired marker stays as written.
            private static void AddStressed(System.Windows.Documents.InlineCollection inlines, string text) {
                string[] pieces = text.Split(new[] { "**" }, StringSplitOptions.None);
                if (pieces.Length % 2 == 0) {
                    inlines.Add(new System.Windows.Documents.Run(text));
                    return;
                }
                for (int i = 0; i < pieces.Length; i++) {
                    if (pieces[i].Length == 0) continue;
                    System.Windows.Documents.Run run = new System.Windows.Documents.Run(pieces[i]);
                    if (i % 2 == 1) {
                        run.FontWeight      = FontWeights.SemiBold;
                        run.TextDecorations = TextDecorations.Underline;
                    }
                    inlines.Add(run);
                }
            }

            internal static void ToneBrushes(TagTone tone, out Brush fill, out Brush edge, out Brush ink) {
                switch (tone) {
                    case TagTone.Success:
                        fill = Theme.SuccessTagBackground;
                        edge = Theme.SuccessTagBorder;
                        ink  = Theme.SuccessTagText;
                        break;
                    case TagTone.Danger:
                        fill = Theme.DangerTagBackground;
                        edge = Theme.DangerTagBorder;
                        ink  = Theme.DangerTagText;
                        break;
                    case TagTone.Info:
                        fill = Theme.InfoTagBackground;
                        edge = Theme.InfoTagBorder;
                        ink  = Theme.InfoTagText;
                        break;
                    case TagTone.Type:
                        fill = Theme.TypeTagBackground;
                        edge = Theme.TypeTagBorder;
                        ink  = Theme.TypeTagText;
                        break;
                    case TagTone.Caution:
                        fill = Theme.CautionTagBackground;
                        edge = Theme.CautionTagBorder;
                        ink  = Theme.CautionTagText;
                        break;
                    case TagTone.Warning:
                        fill = Theme.WarningTagBackground;
                        edge = Theme.WarningTagBorder;
                        ink  = Theme.WarningTagText;
                        break;
                    default:
                        fill = Theme.NeutralTagBackground;
                        edge = Theme.NeutralTagBorder;
                        ink  = Theme.NeutralTagText;
                        break;
                }
            }

            internal static void ApplyTone(Border b, TextBlock text, TagTone tone) {
                Brush fill, edge, ink;
                ToneBrushes(tone, out fill, out edge, out ink);
                b.Background    = fill;
                b.BorderBrush   = edge;
                text.Foreground = ink;
            }

            // A button's colours at rest, hovered and pressed, by tone.
            private static void ButtonBrushes(ButtonTone tone, out Brush fill, out Brush edge, out Brush ink,
                                              out Brush hoverFill, out Brush hoverEdge, out Brush pressedFill) {
                switch (tone) {
                    case ButtonTone.Danger:
                        fill        = Theme.DangerButtonBackground;
                        edge        = Theme.DangerButtonBorder;
                        ink         = Theme.Danger;
                        hoverFill   = Theme.DangerButtonHoverBackground;
                        hoverEdge   = Theme.DangerButtonHoverBorder;
                        pressedFill = Theme.DangerButtonPressedBackground;
                        break;
                    case ButtonTone.Primary:
                        // Border matches the fill, so the button reads as one solid shape.
                        fill        = Theme.PrimaryButtonBackground;
                        edge        = Theme.PrimaryButtonBackground;
                        ink         = Theme.PrimaryButtonText;
                        hoverFill   = Theme.PrimaryButtonHoverBackground;
                        hoverEdge   = Theme.PrimaryButtonHoverBackground;
                        pressedFill = Theme.PrimaryButtonPressedBackground;
                        break;
                    default:
                        fill        = Theme.ButtonBackground;
                        edge        = Theme.ButtonBorder;
                        ink         = Theme.TextPrimary;
                        hoverFill   = Theme.ButtonHoverBackground;
                        hoverEdge   = Theme.ButtonHoverBorder;
                        pressedFill = Theme.ButtonPressedBackground;
                        break;
                }
            }

            private static ControlTemplate ButtonTemplate(ButtonTone tone) {
                ControlTemplate cached = tone == ButtonTone.Danger    ? _dangerButtonTemplate
                                         : tone == ButtonTone.Primary ? _primaryButtonTemplate
                                                                      : _buttonTemplate;
                if (cached != null) return cached;
                Brush fill, edge, ink, hoverFill, hoverEdge, pressedFill;
                ButtonBrushes(tone, out fill, out edge, out ink, out hoverFill, out hoverEdge, out pressedFill);
                ControlTemplate t = NewButtonTemplate(hoverFill, hoverEdge, pressedFill,
                                                      tone == ButtonTone.Primary ? pressedFill : null,
                                                      tone == ButtonTone.Danger);
                if (tone == ButtonTone.Danger)
                    _dangerButtonTemplate = t;
                else if (tone == ButtonTone.Primary)
                    _primaryButtonTemplate = t;
                else
                    _buttonTemplate = t;
                return t;
            }

            // A toned button's (SetTone): hovered and pressed in its tone, as a Danger button is in red. Disabled, it
            // looks as any disabled button does, as a toned flat icon just fades.
            private static ControlTemplate TonedButtonTemplate(TagTone tone) {
                if (_tonedButtonTemplates == null) _tonedButtonTemplates = new Dictionary<TagTone, ControlTemplate>();
                ControlTemplate t;
                if (_tonedButtonTemplates.TryGetValue(tone, out t)) return t;
                Brush fill, edge, ink, hoverFill, hoverEdge, pressedFill;
                Theme.ToneButtonBrushes(tone, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                                        out pressedFill);
                t                           = NewButtonTemplate(hoverFill, hoverEdge, pressedFill, null, false);
                _tonedButtonTemplates[tone] = t;
                return t;
            }

            // A button's face and label, with its hovered, pressed and disabled looks. Its resting colours are the
            // button's own Background, BorderBrush and Foreground. pressedEdge: null keeps the edge as hovered.
            // danger: a Danger button's disabled look.
            private static ControlTemplate NewButtonTemplate(Brush hoverFill, Brush hoverEdge, Brush pressedFill,
                                                             Brush pressedEdge, bool danger) {
                ControlTemplate t = new ControlTemplate(typeof(Button));

                FrameworkElementFactory bd = new FrameworkElementFactory(typeof(Border));
                bd.Name                    = "bd";
                bd.SetBinding(Border.CornerRadiusProperty, new System.Windows.Data.Binding {
                    RelativeSource = System.Windows.Data.RelativeSource.TemplatedParent,
                    Path           = new PropertyPath(CornerRadiusProperty),
                });
                bd.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));
                bd.SetValue(Border.BorderBrushProperty, new TemplateBindingExtension(Control.BorderBrushProperty));
                bd.SetValue(Border.BorderThicknessProperty,
                            new TemplateBindingExtension(Control.BorderThicknessProperty));
                bd.SetValue(Border.PaddingProperty, new TemplateBindingExtension(Control.PaddingProperty));
                bd.SetValue(Border.SnapsToDevicePixelsProperty, true);

                FrameworkElementFactory cp = new FrameworkElementFactory(typeof(ContentPresenter));
                cp.Name                    = "cp";
                cp.SetValue(ContentPresenter.HorizontalAlignmentProperty, HorizontalAlignment.Center);
                cp.SetValue(ContentPresenter.VerticalAlignmentProperty, VerticalAlignment.Center);
                bd.AppendChild(cp);
                t.VisualTree = bd;

                Trigger over = new Trigger { Property = UIElement.IsMouseOverProperty, Value = true };
                over.Setters.Add(new Setter(Border.BackgroundProperty, hoverFill, "bd"));
                over.Setters.Add(new Setter(Border.BorderBrushProperty, hoverEdge, "bd"));
                t.Triggers.Add(over);
                Trigger pressed = new Trigger {
                    Property = System.Windows.Controls.Primitives.ButtonBase.IsPressedProperty,
                    Value    = true,
                };
                pressed.Setters.Add(new Setter(Border.BackgroundProperty, pressedFill, "bd"));
                if (pressedEdge != null) pressed.Setters.Add(new Setter(Border.BorderBrushProperty, pressedEdge, "bd"));
                t.Triggers.Add(pressed);

                // Disabled. Buttons set Foreground locally, which outranks a trigger on the button
                // itself, so the text color goes on the ContentPresenter (TextElement.Foreground is
                // inherited by the label). After the hover trigger so it wins when both apply.
                // A danger button keeps its red, dimmed, so it still says what it would do.
                Trigger dis = new Trigger { Property = UIElement.IsEnabledProperty, Value = false };
                dis.Setters.Add(new Setter(System.Windows.Documents.TextElement.ForegroundProperty,
                                           danger ? Theme.Danger : Theme.TextDisabled, "cp"));
                Brush disabledFill = danger ? Theme.DangerButtonBackground : Theme.DisabledButtonBackground;
                Brush disabledEdge = danger ? Theme.DangerButtonBorder : Theme.DisabledButtonBorder;
                dis.Setters.Add(new Setter(Border.BackgroundProperty, disabledFill, "bd"));
                dis.Setters.Add(new Setter(Border.BorderBrushProperty, disabledEdge, "bd"));
                dis.Setters.Add(new Setter(UIElement.OpacityProperty, 0.6, "bd"));
                t.Triggers.Add(dis);

                t.Seal();
                return t;
            }

            // A 14px rounded box, dark when checked, then the label. Background and Padding apply to the whole row, so
            // a menu can highlight and pad it.
            private static ControlTemplate CheckBoxTemplate() {
                if (_checkBoxTemplate != null) return _checkBoxTemplate;
                ControlTemplate         t    = new ControlTemplate(typeof(CheckBox));
                FrameworkElementFactory root = new FrameworkElementFactory(typeof(Border));
                root.Name                    = "root";
                root.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));
                root.SetValue(Border.PaddingProperty, new TemplateBindingExtension(Control.PaddingProperty));
                root.SetValue(UIElement.SnapsToDevicePixelsProperty, true);

                FrameworkElementFactory row = new FrameworkElementFactory(typeof(StackPanel));
                row.SetValue(StackPanel.OrientationProperty, Orientation.Horizontal);
                FrameworkElementFactory box = new FrameworkElementFactory(typeof(Border));
                box.Name                    = "box";
                box.SetValue(FrameworkElement.WidthProperty, 14.0);
                box.SetValue(FrameworkElement.HeightProperty, 14.0);
                box.SetValue(Border.CornerRadiusProperty, new CornerRadius(3));
                box.SetValue(Border.BorderThicknessProperty, new Thickness(1));
                box.SetValue(Border.BackgroundProperty, Theme.CheckBoxBackground);
                box.SetValue(Border.BorderBrushProperty, Theme.CheckBoxBorder);
                box.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                FrameworkElementFactory mark = new FrameworkElementFactory(typeof(System.Windows.Shapes.Path));
                mark.Name                    = "mark";
                mark.SetValue(System.Windows.Shapes.Path.DataProperty, Geometry.Parse("M 1,4 L 3.8,6.6 L 9,1.2"));
                mark.SetValue(System.Windows.Shapes.Shape.StrokeProperty, Theme.CheckMark);
                mark.SetValue(System.Windows.Shapes.Shape.StrokeThicknessProperty, 1.6);
                mark.SetValue(System.Windows.Shapes.Shape.StrokeStartLineCapProperty, PenLineCap.Round);
                mark.SetValue(System.Windows.Shapes.Shape.StrokeEndLineCapProperty, PenLineCap.Round);
                mark.SetValue(System.Windows.Shapes.Shape.StrokeLineJoinProperty, PenLineJoin.Round);
                mark.SetValue(System.Windows.Shapes.Shape.StretchProperty, Stretch.None);
                mark.SetValue(FrameworkElement.HorizontalAlignmentProperty, HorizontalAlignment.Center);
                mark.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                mark.SetValue(UIElement.VisibilityProperty, Visibility.Collapsed);
                // Partly checked (IsChecked null), as a list's select-all box with some rows ticked: a dash.
                FrameworkElementFactory dash = new FrameworkElementFactory(typeof(System.Windows.Shapes.Path));
                dash.Name                    = "dash";
                // In a 8x2 box of its own, through its middle: a zero-height line would hang half its stroke outside
                // its box, off centre.
                dash.SetValue(System.Windows.Shapes.Path.DataProperty, Geometry.Parse("M 1,1 L 7,1"));
                dash.SetValue(FrameworkElement.WidthProperty, 8.0);
                dash.SetValue(FrameworkElement.HeightProperty, 2.0);
                dash.SetValue(System.Windows.Shapes.Shape.StrokeProperty, Theme.CheckMark);
                dash.SetValue(System.Windows.Shapes.Shape.StrokeThicknessProperty, 1.6);
                dash.SetValue(System.Windows.Shapes.Shape.StrokeStartLineCapProperty, PenLineCap.Round);
                dash.SetValue(System.Windows.Shapes.Shape.StrokeEndLineCapProperty, PenLineCap.Round);
                dash.SetValue(System.Windows.Shapes.Shape.StretchProperty, Stretch.None);
                dash.SetValue(FrameworkElement.HorizontalAlignmentProperty, HorizontalAlignment.Center);
                dash.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                dash.SetValue(UIElement.VisibilityProperty, Visibility.Collapsed);
                FrameworkElementFactory marks = new FrameworkElementFactory(typeof(Grid));
                marks.AppendChild(mark);
                marks.AppendChild(dash);
                box.AppendChild(marks);
                row.AppendChild(box);
                FrameworkElementFactory label = new FrameworkElementFactory(typeof(ContentPresenter));
                label.Name                    = "label";
                label.SetValue(FrameworkElement.MarginProperty, new Thickness(7, 0, 0, 0));
                label.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                row.AppendChild(label);
                root.AppendChild(row);
                t.VisualTree = root;

                // No label, no gap: the box is then the whole control, so a tooltip centres on it.
                foreach (object none in new object[] { null, "" }) {
                    Trigger bare = new Trigger { Property = ContentControl.ContentProperty, Value = none };
                    bare.Setters.Add(new Setter(UIElement.VisibilityProperty, Visibility.Collapsed, "label"));
                    t.Triggers.Add(bare);
                }

                Trigger over = new Trigger { Property = UIElement.IsMouseOverProperty, Value = true };
                over.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxHoverBorder, "box"));
                over.Setters.Add(new Setter(Border.BackgroundProperty, Theme.ButtonBackground, "box"));
                t.Triggers.Add(over);
                Trigger on = new Trigger {
                    Property = System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty,
                    Value    = true,
                };
                on.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxChecked, "box"));
                on.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxChecked, "box"));
                on.Setters.Add(new Setter(UIElement.VisibilityProperty, Visibility.Visible, "mark"));
                t.Triggers.Add(on);
                Trigger some = new Trigger {
                    Property = System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty,
                    Value    = null,
                };
                some.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxChecked, "box"));
                some.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxChecked, "box"));
                some.Setters.Add(new Setter(UIElement.VisibilityProperty, Visibility.Visible, "dash"));
                t.Triggers.Add(some);
                MultiTrigger someOver = new MultiTrigger();
                someOver.Conditions.Add(new Condition(UIElement.IsMouseOverProperty, true));
                someOver.Conditions.Add(
                    new Condition(System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty, null));
                someOver.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxCheckedHover, "box"));
                someOver.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxCheckedHover, "box"));
                t.Triggers.Add(someOver);
                MultiTrigger onOver = new MultiTrigger(); // after both, so it wins when both apply
                onOver.Conditions.Add(new Condition(UIElement.IsMouseOverProperty, true));
                onOver.Conditions.Add(
                    new Condition(System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty, true));
                onOver.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxCheckedHover, "box"));
                onOver.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxCheckedHover, "box"));
                t.Triggers.Add(onOver);
                // Disabled: a grey box (fading alone left a white box looking the same), the label faded; ticked or
                // partly, a muted fill. Last, so it wins over hover, which still shows (for the tooltip).
                Trigger off = new Trigger { Property = UIElement.IsEnabledProperty, Value = false };
                off.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxDisabledBackground, "box"));
                off.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxDisabledBorder, "box"));
                off.Setters.Add(new Setter(UIElement.OpacityProperty, 0.6, "label"));
                t.Triggers.Add(off);
                foreach (object state in new object[] { true, null }) {
                    MultiTrigger offOn = new MultiTrigger();
                    offOn.Conditions.Add(new Condition(UIElement.IsEnabledProperty, false));
                    offOn.Conditions.Add(
                        new Condition(System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty, state));
                    offOn.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxDisabledChecked, "box"));
                    offOn.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxDisabledChecked, "box"));
                    t.Triggers.Add(offOn);
                }

                t.Seal();
                _checkBoxTemplate = t;
                return t;
            }

            // The dropdown: a toggle drawing the box and chevron, the selected item over it (clicks
            // pass through), and the list in a popup at least as wide as the box.
            private static ControlTemplate DropdownTemplate() {
                if (_dropdownTemplate != null) return _dropdownTemplate;
                ControlTemplate         t    = new ControlTemplate(typeof(ComboBox));
                FrameworkElementFactory root = new FrameworkElementFactory(typeof(Grid));
                root.Name                    = "root";

                FrameworkElementFactory toggle =
                    new FrameworkElementFactory(typeof(System.Windows.Controls.Primitives.ToggleButton));
                toggle.SetValue(Control.TemplateProperty, DropdownToggleTemplate());
                toggle.SetValue(UIElement.FocusableProperty, false);
                toggle.SetValue(System.Windows.Controls.Primitives.ButtonBase.ClickModeProperty, ClickMode.Press);
                toggle.SetBinding(System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty,
                                  new System.Windows.Data.Binding("IsDropDownOpen") {
                                      Mode           = System.Windows.Data.BindingMode.TwoWay,
                                      RelativeSource = System.Windows.Data.RelativeSource.TemplatedParent,
                                  });
                toggle.SetValue(Control.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));
                toggle.SetValue(Control.BorderBrushProperty, new TemplateBindingExtension(Control.BorderBrushProperty));
                toggle.SetValue(Control.BorderThicknessProperty,
                                new TemplateBindingExtension(Control.BorderThicknessProperty));
                toggle.SetValue(Control.ForegroundProperty, new TemplateBindingExtension(Control.ForegroundProperty));
                toggle.SetBinding(CornerRadiusProperty, new System.Windows.Data.Binding {
                    RelativeSource = System.Windows.Data.RelativeSource.TemplatedParent,
                    Path           = new PropertyPath(CornerRadiusProperty),
                });
                root.AppendChild(toggle);

                FrameworkElementFactory selected = new FrameworkElementFactory(typeof(ContentPresenter));
                selected.SetValue(ContentPresenter.ContentProperty,
                                  new TemplateBindingExtension(ComboBox.SelectionBoxItemProperty));
                selected.SetValue(ContentPresenter.ContentTemplateProperty,
                                  new TemplateBindingExtension(ComboBox.SelectionBoxItemTemplateProperty));
                selected.SetValue(FrameworkElement.MarginProperty,
                                  new TemplateBindingExtension(Control.PaddingProperty));
                selected.SetValue(FrameworkElement.HorizontalAlignmentProperty, HorizontalAlignment.Left);
                selected.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                selected.SetValue(UIElement.IsHitTestVisibleProperty, false);
                root.AppendChild(selected);

                FrameworkElementFactory popup =
                    new FrameworkElementFactory(typeof(System.Windows.Controls.Primitives.Popup));
                popup.Name = "PART_Popup";
                popup.SetBinding(System.Windows.Controls.Primitives.Popup.IsOpenProperty,
                                 new System.Windows.Data.Binding("IsDropDownOpen") {
                                     RelativeSource = System.Windows.Data.RelativeSource.TemplatedParent,
                                 });
                popup.SetValue(System.Windows.Controls.Primitives.Popup.PlacementProperty,
                               System.Windows.Controls.Primitives.PlacementMode.Bottom);
                popup.SetValue(System.Windows.Controls.Primitives.Popup.AllowsTransparencyProperty, true);
                popup.SetValue(System.Windows.Controls.Primitives.Popup.PopupAnimationProperty,
                               System.Windows.Controls.Primitives.PopupAnimation.None);
                popup.SetValue(UIElement.FocusableProperty, false);

                FrameworkElementFactory list = new FrameworkElementFactory(typeof(Border));
                list.SetValue(Border.BackgroundProperty, Brushes.White);
                list.SetValue(Border.BorderBrushProperty, Theme.ButtonBorder);
                list.SetValue(Border.BorderThicknessProperty, new Thickness(1));
                list.SetValue(Border.CornerRadiusProperty, new CornerRadius(Theme.ButtonCornerRadius));
                list.SetValue(Border.PaddingProperty, new Thickness(3));
                list.SetValue(FrameworkElement.MarginProperty, new Thickness(0, 2, 0, 0));
                list.SetBinding(FrameworkElement.MinWidthProperty, new System.Windows.Data.Binding("ActualWidth") {
                    RelativeSource = System.Windows.Data.RelativeSource.TemplatedParent,
                });
                list.SetBinding(FrameworkElement.MaxHeightProperty,
                                new System.Windows.Data.Binding("MaxDropDownHeight") {
                                    RelativeSource = System.Windows.Data.RelativeSource.TemplatedParent,
                                });
                FrameworkElementFactory scroll = new FrameworkElementFactory(typeof(ScrollViewer));
                scroll.SetValue(ScrollViewer.VerticalScrollBarVisibilityProperty, ScrollBarVisibility.Auto);
                scroll.AppendChild(new FrameworkElementFactory(typeof(ItemsPresenter)));
                list.AppendChild(scroll);
                popup.AppendChild(list);
                root.AppendChild(popup);
                t.VisualTree = root;

                Trigger dis = new Trigger { Property = UIElement.IsEnabledProperty, Value = false };
                dis.Setters.Add(new Setter(UIElement.OpacityProperty, 0.6, "root"));
                t.Triggers.Add(dis);

                t.Seal();
                _dropdownTemplate = t;
                return t;
            }

            // The box itself: same look as a button, with a drawn chevron on the right.
