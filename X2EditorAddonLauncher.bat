            /// <summary>
            /// A count beside a flat icon's glyph (CreateDeleteIcon and its kin), inside its square, which widens to
            /// fit: 1 to 999, "999+" past that. 0 or less: none, the plain square again. It fades with the icon.
            /// Example: Redirector Manager's trash, counting the redirectors it deletes.
            /// </summary>
            public static void SetBadgeCount(Border icon, int count) {
                if (icon == null) return;
                TextBlock text = icon.GetValue(BadgeTextProperty) as TextBlock;
                if (text == null) {
                    if (count <= 0) return;
                    UIElement glyph = icon.Child;
                    icon.Child      = null;
                    text            = new TextBlock {
                        FontSize          = Theme.FontSizeLabel,
                        FontWeight        = FontWeights.SemiBold,
                        Foreground        = Theme.TextPrimary,
                        VerticalAlignment = VerticalAlignment.Center,
                        Margin            = new Thickness(2, 0, 0, 0),
                    };
                    StackPanel both = new StackPanel { Orientation = Orientation.Horizontal };
                    both.Children.Add(glyph);
                    both.Children.Add(text);
                    icon.Child = both;
                    icon.SetValue(BadgeTextProperty, text);
                }
                bool shown      = count > 0;
                text.Text       = !shown ? "" : count > 999 ? "999+" : count.ToString();
                text.Visibility = shown ? Visibility.Visible : Visibility.Collapsed;
                icon.Width      = shown ? double.NaN : 18;
                icon.MinWidth   = 18;
                icon.Padding    = shown ? new Thickness(2, 0, 4, 0) : new Thickness(0);
            }

            private static readonly DependencyProperty BadgeTextProperty =
                DependencyProperty.RegisterAttached("GenieBadgeText", typeof(TextBlock), typeof(ControlUtils));

