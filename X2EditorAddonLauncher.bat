    // == Our Splash ==================================================================================================
    // Exactly where the SDK's splash will be, so its arrival reads as one window. Everything before it shows here.

    internal sealed class SplashForm : Form {
        internal enum Bar { None, Busy, Countdown }

        private const int Pad = 30, StatusHeight = 26, IconSize = 24;

        private readonly IconArt _icon;
        private readonly string  _footer;
        private readonly System.Windows.Forms.Timer _animation = new System.Windows.Forms.Timer();

        private string    _message, _detail, _hint, _status = "";
        private bool      _isError;
        private Bar       _bar;
        private Stopwatch _barClock = new Stopwatch();
        private TimeSpan  _barLength;
        internal const int ColumnGap = 20; // between the divider and the right column (the slow-start tip)

        private int       _titleTop, _rightMargin = Pad;
        private Rectangle _messageRect, _detailRect, _hintRect, _column;

        internal SplashForm(Rectangle bounds, IconArt icon, string footer) {
            _icon           = icon;
            _footer         = footer;
            Text            = "AddonGenie";
            FormBorderStyle = FormBorderStyle.None;
            StartPosition   = FormStartPosition.Manual;
            Bounds          = bounds;
            BackColor       = Look.Ground;
            DoubleBuffered  = true;
            if (icon != null) Icon = System.Drawing.Icon.FromHandle(icon.Render(32).GetHicon());
            _animation.Interval  = 33;
            _animation.Tick     += delegate {
                Invalidate(new Rectangle(0, Height - 3, Width, 3));
            };
        }

        // The token's tip opens in our top-right corner; children aren't painted over by our own redraws.
        protected override CreateParams CreateParams {
            get {
                CreateParams p  = base.CreateParams;
                p.Style        |= Win32.WS_CLIPCHILDREN;
                return p;
            }
        }

        /// <summary>A right column, in client coordinates: a divider runs beside it. Empty: none.</summary>
        internal void SetColumn(Rectangle column) {
            _column = column;
            Invalidate();
        }

        /// <summary>Room kept clear on the right by the next ShowView's text, at least Pad.</summary>
        internal void SetRightMargin(int margin) {
            _rightMargin = margin > 0 ? margin + 12 : Pad;
        }

        internal void ShowView(string message, bool isError, string detail, string hint,
                               params SplashAction[] actions) {
            _message = message;
            _isError = isError;
            _detail  = detail;
            _hint    = hint;
            Controls.Clear();
            int textWidth = Width - Pad - _rightMargin;
            int height    = IconSize + 12 + Look.Height(message, isError ? Look.StrongFont : Look.BodyFont, textWidth);
            if (detail != null) height += 10 + 22;
            if (hint != null) height += 8 + Look.Height(hint, Look.SmallFont, textWidth);
            if (actions.Length > 0) height += 14 + 26;

            int y         = Math.Max(16, (Height - StatusHeight - height) / 2);
            _titleTop     = y;
            y            += IconSize + 12;
            _messageRect  = new Rectangle(Pad, y, textWidth,
                                          Look.Height(message, isError ? Look.StrongFont : Look.BodyFont, textWidth));
            y             = _messageRect.Bottom;
            _detailRect   = Rectangle.Empty;
            if (detail != null) {
                _detailRect = new Rectangle(Pad, y + 10, textWidth, 22);
                y           = _detailRect.Bottom;
            }
            _hintRect = Rectangle.Empty;
            if (hint != null) {
                _hintRect = new Rectangle(Pad, y + 8, textWidth, Look.Height(hint, Look.SmallFont, textWidth));
                y         = _hintRect.Bottom;
            }
            int x = Pad;
            foreach (SplashAction action in actions) {
                SplashAction a = action;
                Button       b = Look.MakeButton(a.Text, delegate { a.OnClick(); });
                b.Location     = new Point(x, y + 14);
                Controls.Add(b);
                x += b.Width + 8;
            }
            Invalidate();
        }

        internal void SetStatus(string status) {
            if (status == _status) return;
            _status = status;
            Invalidate(new Rectangle(0, Height - StatusHeight, Width, StatusHeight));
        }

        internal void SetBar(Bar bar) {
            SetBar(bar, TimeSpan.Zero);
        }

        internal void SetBar(Bar bar, TimeSpan length) {
            _bar       = bar;
            _barLength = length;
            _barClock.Restart();
            _animation.Enabled = bar != Bar.None;
            Invalidate(new Rectangle(0, Height - 3, Width, 3));
        }

        protected override void OnPaint(PaintEventArgs e) {
            Graphics g = e.Graphics;
            using (Pen edge = new Pen(Look.Edge)) g.DrawRectangle(edge, 0, 0, Width - 1, Height - 1);

            Look.DrawIcon(g, _icon, Pad, _titleTop, IconSize);
            int titleX = _icon != null ? Pad + IconSize + 10 : Pad;
            TextRenderer.DrawText(g, "AddonGenie", Look.TitleFont,
                                  new Rectangle(titleX, _titleTop - 4, Width, IconSize + 8), Look.Title, Look.Line);
            if (_message != null)
                TextRenderer.DrawText(g, _message, _isError ? Look.StrongFont : Look.BodyFont, _messageRect,
                                      _isError ? Look.Error : Look.Text, Look.Wrap);
            if (_detail != null) {
                using (Pen box = new Pen(Look.BoxEdge))
                    g.DrawRectangle(box, _detailRect.X, _detailRect.Y, _detailRect.Width - 1, _detailRect.Height - 1);
                Rectangle inner = Rectangle.Inflate(_detailRect, -8, 0);
                TextRenderer.DrawText(g, _detail, Look.MonoFont, inner, Look.Text, Look.Line);
            }
            if (_hint != null) TextRenderer.DrawText(g, _hint, Look.SmallFont, _hintRect, Look.Quiet, Look.Wrap);
            if (!_column.IsEmpty) {
                int x = _column.Left - ColumnGap;
                using (Pen divider = new Pen(Look.Edge)) g.DrawLine(divider, x, _column.Top, x, _column.Bottom - 1);
            }

            Rectangle status = new Rectangle(10, Height - StatusHeight, Width - 20, StatusHeight - 4);
            TextRenderer.DrawText(g, _status, Look.StatusFont, status, Look.Faint, Look.Line);
            TextRenderer.DrawText(g, _footer, Look.StatusFont, status, Look.Faint, Look.Line | TextFormatFlags.Right);
            PaintBar(g);
        }

        private void PaintBar(Graphics g) {
            if (_bar == Bar.None) return;
            Rectangle track = new Rectangle(1, Height - 3, Width - 2, 2);
            using (SolidBrush b = new SolidBrush(Look.Edge)) g.FillRectangle(b, track);
            Rectangle fill;
            if (_bar == Bar.Busy) {
                // A segment a third as wide sweeping across, eased, every 1.6 s.
                double t     = (_barClock.Elapsed.TotalSeconds % 1.6) / 1.6;
                double eased = t < 0.5 ? 2 * t * t : 1 - 2 * (1 - t) * (1 - t);
                int    w     = track.Width * 3 / 10;
                fill         = new Rectangle(track.X - w + (int)((track.Width + w) * eased), track.Y, w, track.Height);
                fill.Intersect(track);
            } else {
                double left = 1 - _barClock.Elapsed.TotalSeconds / Math.Max(_barLength.TotalSeconds, 0.001);
                fill        = new Rectangle(track.X, track.Y, (int)(track.Width * Math.Max(0, left)), track.Height);
            }
            using (SolidBrush b = new SolidBrush(_bar == Bar.Busy ? Look.Accent : Look.Faint)) g.FillRectangle(b, fill);
        }

        protected override void Dispose(bool disposing) {
            if (disposing) _animation.Dispose();
            base.Dispose(disposing);
        }
    }

    // == Token =======================================================================================================
    // "AddonGenie · m:ss" in the SDK splash's top-right corner, which its own text leaves clear. A child of that
    // splash (cross-process), so Windows draws it on the splash and moves, stacks, hides and destroys it with it.
    // That links the two threads' input, which is fine: the splash's thread only runs its message loop. Never takes
    // focus; the splash has it.
    // The slow-start tip opens on our splash first, bare: no box or header, as our splash shows those itself. When
    // the SDK's appears, the same window moves over and gains them around the text, which stays on the same screen
    // pixels: ours sits exactly where the SDK's does, and the bare tip sits a header row lower.

    internal sealed class TokenForm : Form {
        internal const int   TipWidth     = 300;
        internal const int   NativeInset  = 9;  // in the SDK splash's client area, past its 1 px border
        internal const int   OwnInset     = 10; // ours has no border, so the same screen spot is 1 px further in
        private const int    HeaderHeight = 26, TipPad = 12;
        private const string WidestTime   = "00:00"; // sized for up to 99:59

        private IntPtr          _splash;
        private int             _inset;
        private bool            _isBoxed; // header and border; false only for the tip on our splash
        private readonly IconArt _icon;
        private readonly string  _sourcePath, _shadersPath;
        private string          _time = "0:00";
        private bool            _isTipShown;
        private Button          _copy, _never;
        private Rectangle       _tipTitle, _tipText, _tipBox;
        private int             _tipBottom;

        internal event MethodInvoker CopyPaths;
        internal event MethodInvoker DismissTip;

        internal TokenForm(IntPtr splash, int inset, bool isBoxed, IconArt icon, string sourcePath,
                           string shadersPath) {
            _splash         = splash;
            _inset          = inset;
            _isBoxed        = isBoxed;
            _icon           = icon;
            _sourcePath     = sourcePath;
            _shadersPath    = shadersPath;
            FormBorderStyle = FormBorderStyle.None;
            StartPosition   = FormStartPosition.Manual;
            ShowInTaskbar   = false;
            BackColor       = Look.Ground;
            DoubleBuffered  = true;
            Fit();
        }

        protected override bool ShowWithoutActivation {
            get { return true; }
        }

        // A child, made one at creation: WS_CHILD in place of WS_POPUP, the splash as parent, so Bounds are in its
        // client coordinates. Both windows are DPI-unaware, as Windows requires of a cross-process child. Windows
        // 11's rounded corners are for top-level windows only, so the corners are square.
        protected override CreateParams CreateParams {
            get {
                CreateParams p  = base.CreateParams;
                p.Parent        = _splash;
                p.Style         = (p.Style & ~Win32.WS_POPUP) | Win32.WS_CHILD;
                p.ExStyle      |= Win32.WS_EX_NOACTIVATE;
                return p;
            }
        }

        // Gotcha: Form.CreateHandle then sets a top-level form's GWL_HWNDPARENT to WinForms' hidden taskbar owner
        // (ShowInTaskbar is false). On a child that reparents it under that hidden window: on our own splash the
        // token existed but never showed. So the parent is set again once the handle exists.
        protected override void CreateHandle() {
            base.CreateHandle();
            Win32.SetParent(Handle, _splash);
            Fit();
        }

        /// <summary>To the SDK's splash, boxed. Same window, so an open tip isn't closed or redrawn elsewhere.</summary>
        internal void MoveTo(IntPtr splash, int inset) {
            _splash  = splash;
            _inset   = inset;
            _isBoxed = true;
            LayOutTip(); // controls shift down a header row in the window, which grows up by as much
            Win32.SetParent(Handle, splash);
            Fit();
            Invalidate();
        }

        internal void SetTime(string time) {
            if (time == _time) return;
            _time = time;
            if (!_isBoxed) return; // no header to show it
            Fit();
            Invalidate();
        }

        internal void ShowTip(bool show) {
            _isTipShown = show;
            Controls.Clear();
            if (show) {
                _copy        = Look.MakeButton("Copy full paths", delegate { Raise(CopyPaths); });
                _never       = Look.MakeButton("Don't show this again", delegate { Raise(DismissTip); });
                _never.FlatAppearance.BorderSize = 0;
                _never.BackColor                 = Look.Ground;
                _never.ForeColor                 = Look.Quiet;
                _never.Font                      = Look.LinkFont;
                Controls.Add(_copy);
                Controls.Add(_never);
                LayOutTip();
            }
            Fit();
            Invalidate();
        }

        private const string TipText =
            "Your antivirus scans each SDK script file as the editor reads it, and a reboot " +
            "makes it scan them all again. Excluding these folders removes most of the wait:";

        private int TipTop {
            get { return _isBoxed ? HeaderHeight : 0; }
        }

        private void LayOutTip() {
            if (!_isTipShown) return;
            int width       = TipWidth - 2 * TipPad;
            int y           = TipTop + 6;
            _tipTitle       = new Rectangle(TipPad, y, width, 18);
            y               = _tipTitle.Bottom + 2;
            _tipText        = new Rectangle(TipPad, y, width, Look.Height(TipText, Look.SmallFont, width));
            y               = _tipText.Bottom + 6;
            _tipBox         = new Rectangle(TipPad, y, width, 38);
            y               = _tipBox.Bottom + 8;
            _copy.Location  = new Point(TipPad, y);
            _never.Location = new Point(_copy.Right + 6, y);
            _tipBottom      = _copy.Bottom;
        }

        // Right edge pinned to the splash's, _inset in from the top-right corner of its client area. Unboxed, the
        // window starts a header row lower, so its text has the boxed window's screen position.
        private void Fit() {
            Win32.RECT r;
            if (!Win32.GetClientRect(_splash, out r)) return;
            int width  = _isTipShown ? TipWidth : HeaderWidth();
            int height = _isTipShown ? _tipBottom + TipPad : HeaderHeight;
            int top    = _inset + HeaderHeight - TipTop;
            Bounds     = new Rectangle(r.Right - _inset - width, top, width, height);
        }

        // A fixed width, so it doesn't jump as the time gains digits. Segoe UI's digits are all one width.
        private int HeaderWidth() {
            string widest = _time.Length > WidestTime.Length ? _time : WidestTime;
            return 10 + 14 + 6 + TextRenderer.MeasureText(HeaderText(widest), Look.BoldSmall).Width + 10;
        }

        private static string HeaderText(string time) {
            return "AddonGenie · " + time;
        }

        protected override void OnPaint(PaintEventArgs e) {
            Graphics g = e.Graphics;
            if (_isBoxed) {
                using (Pen edge = new Pen(Look.BoxEdge)) g.DrawRectangle(edge, 0, 0, Width - 1, Height - 1);
                Look.DrawIcon(g, _icon, 10, (HeaderHeight - 14) / 2, 14);
                Rectangle header = new Rectangle(30, 0, Width - 30, HeaderHeight);
                TextRenderer.DrawText(g, HeaderText(_time), Look.BoldSmall, header, Look.ButtonText, Look.Line);
            }
            if (!_isTipShown) return;

            TextRenderer.DrawText(g, "Slow start?", Look.StrongFont, _tipTitle, Look.ButtonText, Look.Line);
            TextRenderer.DrawText(g, TipText, Look.SmallFont, _tipText, Look.Quiet, Look.Wrap);
            using (Pen box = new Pen(Look.BoxEdge))
                g.DrawRectangle(box, _tipBox.X, _tipBox.Y, _tipBox.Width - 1, _tipBox.Height - 1);
            Rectangle line = new Rectangle(_tipBox.X + 8, _tipBox.Y + 3, _tipBox.Width - 16, 16);
            TextRenderer.DrawText(g, _sourcePath, Look.MonoFont, line, Look.Text,
                                  Look.Line | TextFormatFlags.PathEllipsis);
            line.Y += 16;
            TextRenderer.DrawText(g, _shadersPath, Look.MonoFont, line, Look.Text,
                                  Look.Line | TextFormatFlags.PathEllipsis);
        }

        private static void Raise(MethodInvoker handler) {
            if (handler != null) handler();
        }
    }

    // == Win32 =======================================================================================================

    internal static class Win32 {
        internal const int  SM_CXSCREEN = 0, SM_CYSCREEN = 1, OBJID_WINDOW = 0;
        internal const uint GW_OWNER = 4, EVENT_OBJECT_SHOW = 0x8002, WINEVENT_OUTOFCONTEXT = 0;
        internal const int  WS_EX_NOACTIVATE = 0x08000000, WS_CHILD = 0x40000000, WS_POPUP = unchecked((int)0x80000000);
        internal const int  WS_CLIPCHILDREN  = 0x02000000;

        [StructLayout(LayoutKind.Sequential)]
        internal struct RECT {
            public int Left, Top, Right, Bottom;
        }

        internal delegate bool EnumWindowsProc(IntPtr h, IntPtr l);
        internal delegate void WinEventProc(IntPtr hook, uint e, IntPtr h, int obj, int child, uint thread, uint time);

        // XComGame.exe is DPI-unaware: no manifest entry, no DPI API imported. Windows made on an unaware thread get
        // the same virtualized coordinates and stretching as its splash. Windows 10 1607 and up; before that, the
        // process's own mode, which for powershell.exe is unaware too.
        internal static void UseHostDpiMode() {
            try {
                SetThreadDpiAwarenessContext(new IntPtr(-1)); // DPI_AWARENESS_CONTEXT_UNAWARE
            } catch (EntryPointNotFoundException) {}
        }

        internal static string ClassName(IntPtr h) {
            StringBuilder name = new StringBuilder(256);
            GetClassNameW(h, name, name.Capacity);
            return name.ToString();
        }

        // clang-format off: P/Invoke table
        [DllImport("user32.dll")] internal static extern bool   EnumWindows(EnumWindowsProc cb, IntPtr l);
        [DllImport("user32.dll")] internal static extern uint   GetWindowThreadProcessId(IntPtr h, out uint pid);
        [DllImport("user32.dll")] internal static extern bool   IsWindowVisible(IntPtr h);
        [DllImport("user32.dll")] internal static extern bool   IsWindow(IntPtr h);
        [DllImport("user32.dll")] internal static extern IntPtr GetMenu(IntPtr h);
        [DllImport("user32.dll")] internal static extern IntPtr GetWindow(IntPtr h, uint cmd);
        [DllImport("user32.dll")] internal static extern bool   GetClientRect(IntPtr h, out RECT r);
        [DllImport("user32.dll")] internal static extern IntPtr SetParent(IntPtr child, IntPtr parent);
        [DllImport("user32.dll")] internal static extern int    GetSystemMetrics(int index);
        [DllImport("user32.dll")] internal static extern IntPtr SetThreadDpiAwarenessContext(IntPtr context);
        [DllImport("user32.dll")]
        internal static extern IntPtr SetWinEventHook(uint min, uint max, IntPtr module, WinEventProc proc, uint pid,
                                                      uint thread, uint flags);
        [DllImport("user32.dll")] internal static extern bool   UnhookWinEvent(IntPtr hook);
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern int GetClassNameW(IntPtr h, StringBuilder name, int size);
        // clang-format on
    }
}

