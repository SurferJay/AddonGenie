        /// <summary>Raised on click, after IsExpanded has flipped; gets the new state.</summary>
        public event Action<bool> Toggled;

        internal GenieExpandButton(bool isExpanded, string tooltip) {
            _chevron = new System.Windows.Shapes.Path {
                Data                  = Geometry.Parse("M 4.5,2.5 L 8,6 L 4.5,9.5"),
                StrokeThickness       = 1.5,
                StrokeStartLineCap    = PenLineCap.Round,
                StrokeEndLineCap      = PenLineCap.Round,
