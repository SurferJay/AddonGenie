            // == Lifetime =============================================================================

            /// <summary>
            /// Runs onLoaded when the element loads and onUnloaded when it unloads, so a subscription lasts only
            /// while its window is open. A static event's handler must go this way, or the event keeps the closed
            /// window alive. Loaded can fire again without an Unloaded between (a window's content moving), so each
            /// runs once per load. Runs onLoaded now if the element is already loaded. Either may be null.
            /// </summary>
            public static void WhileLoaded(FrameworkElement element, Action onLoaded, Action onUnloaded) {
                if (element == null) return;
                bool   attached = false;
                Action load     = delegate {
                    if (attached) return;
                    attached = true;
                    if (onLoaded != null) onLoaded();
                };
                element.Loaded += delegate {
                    load();
                };
                element.Unloaded += delegate {
                    if (!attached) return;
                    attached = false;
                    if (onUnloaded != null) onUnloaded();
                };
                if (element.IsLoaded) load();
            }

