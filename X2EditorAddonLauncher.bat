    // One log entry: a timestamped line, plus any continuation lines (stack traces), which
    // belong to the same session.
    internal sealed class LogEntry {
        internal string Tag;
        internal string Text;
        internal int    Session;
    }

    internal sealed class LogPanel : UserControl {
        private const string Global     = "Global";
        private const int    MaxEntries = 20000; // kept in memory
        private const int    MaxShown   = 5000;  // shown at once

        private readonly List<LogEntry> _entries = new List<LogEntry>();
        private int                     _clearedAt; // "Clear view" hides entries before this index
        private string                  _filter;    // null = Global

        private readonly ComboBox  _filterBox;
        private readonly CheckBox  _sessionOnly;
        private readonly TextBox   _text;
        private readonly GenieNumberBox _keepBox;
        private readonly TextBlock      _keepNote;
        private readonly Action<string, string> _onWritten;

        internal LogPanel(GenieWindow window) {
            Grid root = new Grid();
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            root.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });

            // Top bar: filter and session toggle | Copy, Clear view, Open log folder.
            DockPanel top = new DockPanel { Margin = new Thickness(10, 8, 10, 8) };
            Button    openFolder =
                Genie.ControlUtils.CreateButton("Open log folder", tooltip: "Open Addons\\Logs in Explorer.");
            openFolder.Click += delegate {
                Genie.FileUtils.OpenFolder(GenieBootstrap.LogsDir, true);
            };
            Button clear = Genie.ControlUtils.CreateButton(
                "Clear view", tooltip: "Empty this window. The log file is not changed.");
            clear.Click += delegate {
                _clearedAt = _entries.Count;
                Render();
            };
            Button copy  = Genie.ControlUtils.CreateButton("Copy", tooltip: "Copy the lines shown to the clipboard.");
            copy.Click  += delegate {
                Genie.ClipboardUtils.SetText(_text.Text);
            };
            GenieSettingsButton settings =
                Genie.ControlUtils.CreateSettingsButton(window, tooltip: "Settings for the log");
            settings.Margin = new Thickness(0);
            foreach (FrameworkElement b in new FrameworkElement[] { settings, openFolder, clear, copy }) {
                DockPanel.SetDock(b, Dock.Right);
                top.Children.Add(b);
            }

            // Wraps rather than hiding behind the buttons when narrow.
            WrapPanel left         = new WrapPanel { VerticalAlignment = VerticalAlignment.Center };
            TextBlock show         = Genie.ControlUtils.CreateFieldLabel("Show");
            show.Margin            = new Thickness(0, 0, 6, 0);
            show.VerticalAlignment = VerticalAlignment.Center;
            left.Children.Add(show);
            const string FilterTip = "Show lines from everything, the framework, or one addon.";
            _filterBox = Genie.ControlUtils.CreateDropdown(null, 160, FilterTip, Genie.ControlUtils.ButtonSize.Regular);
            _filterBox.Margin = new Thickness(0, 0, 14, 0);
            _filterBox.Items.Add(Global);
            _filterBox.Items.Add(LogStore.FrameworkTag);
            foreach (LoadedAddon a in AddonRegistry.Loaded) _filterBox.Items.Add(a.Name);
            _filterBox.SelectedIndex     = 0;
            _filterBox.SelectionChanged += delegate {
                string sel = _filterBox.SelectedItem as string;
                _filter    = (sel == null || sel == Global) ? null : sel;
                Render();
            };
            left.Children.Add(_filterBox);
            _sessionOnly =
                Genie.ControlUtils.CreateCheckBox("Current session only", true, "Hide lines from earlier sessions");
            _sessionOnly.Checked += delegate {
                Render();
            };
            _sessionOnly.Unchecked += delegate {
                Render();
            };
            left.Children.Add(_sessionOnly);
            top.Children.Add(left);
            Grid.SetRow(top, 0);
            root.Children.Add(top);

            // The log text.
            _text = new TextBox {
                IsReadOnly                    = true,
                FontFamily                    = Genie.Theme.MonoFont,
                FontSize                      = Genie.Theme.FontSizeLabel,
                TextWrapping                  = TextWrapping.NoWrap,
                VerticalScrollBarVisibility   = ScrollBarVisibility.Auto,
                HorizontalScrollBarVisibility = ScrollBarVisibility.Auto,
                BorderBrush                   = Genie.Theme.Separator,
                BorderThickness               = new Thickness(0, 1, 0, 1),
                Padding                       = new Thickness(6, 4, 6, 4),
            };
            Grid.SetRow(_text, 1);
            root.Children.Add(_text);

            // Bottom bar: retention setting, on the right; the window's credit label sits bottom-left.
            DockPanel  bar    = new DockPanel { Margin = new Thickness(10, 7, 10, 8), LastChildFill = false };
            StackPanel bottom = new StackPanel { Orientation = Orientation.Horizontal };
            DockPanel.SetDock(bottom, Dock.Right);
            bar.Children.Add(bottom);
            TextBlock keepA         = Genie.ControlUtils.CreateFieldLabel("Keep last");
            keepA.Margin            = new Thickness(0, 0, 6, 0);
            keepA.VerticalAlignment = VerticalAlignment.Center;
            bottom.Children.Add(keepA);
            // A bad value is put back: the note beside it has the room a problem line would take.
            _keepBox = Genie.ControlUtils.CreateNumberBox(KeepSessions(), 1, LogStore.MaxKeepSessions, CommitKeep,
                                                          tooltip: "1 to " + LogStore.MaxKeepSessions);
            _keepBox.RevertInvalid = true;
            bottom.Children.Add(_keepBox);
            TextBlock keepB         = Genie.ControlUtils.CreateFieldLabel("sessions");
            keepB.Margin            = new Thickness(6, 0, 12, 0);
            keepB.VerticalAlignment = VerticalAlignment.Center;
            bottom.Children.Add(keepB);
            _keepNote =
                Genie.ControlUtils.CreateNoteText("Older sessions are removed from the log when the editor starts.");
            _keepNote.VerticalAlignment = VerticalAlignment.Center;
            bottom.Children.Add(_keepNote);
            Grid.SetRow(bar, 2);
            root.Children.Add(bar);

            Content = root;

            Load();
            _onWritten = delegate(string tag, string line) {
                Dispatcher d = GenieBootstrap.UiDispatcher;
                if (d == null) return;
                d.BeginInvoke((Action)delegate { Append(Parse(line, null)); });
            };
            Genie.ControlUtils.WhileLoaded(this, Attach, Detach);
        }

        private void Attach() {
            LogStore.Written += _onWritten;
            Render();
        }

        private void Detach() {
            LogStore.Written -= _onWritten;
        }

        private void Load() {
            LogEntry current = null;
            foreach (string line in LogStore.ReadAllLines()) {
                if (LogStore.IsEntryStart(line)) {
                    current = Parse(line, null);
                    AddEntry(current);
                } else if (current != null)
                    current.Text += Environment.NewLine + line; // continuation (stack traces)
                else {
                    current = Parse(line, null);
                    AddEntry(current);
                }
            }
        }

        private static LogEntry Parse(string line, string tag) {
            return new LogEntry { Text = line, Tag = tag ?? LogStore.TagOf(line), Session = LogStore.SessionOf(line) };
        }

        private void AddEntry(LogEntry e) {
            _entries.Add(e);
            if (_entries.Count > MaxEntries) {
                int drop = _entries.Count - MaxEntries;
                _entries.RemoveRange(0, drop);
                _clearedAt = Math.Max(0, _clearedAt - drop);
            }
        }

        private bool Matches(LogEntry e) {
            if (_sessionOnly.IsChecked == true && e.Session != LogStore.CurrentSession) return false;
            return _filter == null || string.Equals(e.Tag, _filter, StringComparison.OrdinalIgnoreCase);
        }

        private void Render() {
            List<string> shown = new List<string>();
            for (int i = _clearedAt; i < _entries.Count; i++) { // "Clear view" hides entries before _clearedAt
                if (Matches(_entries[i])) shown.Add(_entries[i].Text);
            }
            int           skip = Math.Max(0, shown.Count - MaxShown);
            StringBuilder sb   = new StringBuilder();
            for (int i = skip; i < shown.Count; i++) sb.Append(shown[i]).Append(Environment.NewLine);
            _text.Text = sb.ToString();
            _text.ScrollToEnd();
        }

        // Live line: shown at once if it passes the filter. Follows new lines only while the
        // view is already at the bottom, so reading earlier lines isn't interrupted.
        private void Append(LogEntry e) {
            AddEntry(e);
            if (!Matches(e)) return;
            bool atBottom = _text.VerticalOffset + _text.ViewportHeight >= _text.ExtentHeight - 2;
            _text.AppendText(e.Text + Environment.NewLine);
            if (atBottom) _text.ScrollToEnd();
        }

        private static int KeepSessions() {
            int    n;
            string v = AddonRegistry.ConfigFor(typeof(LogPanel).Assembly).Get("Logging", "KeepSessions");
            return (v != null && int.TryParse(v, out n) && n > 0) ? n : LogStore.DefaultKeepSessions;
        }

        private void CommitKeep(int? keep) {
            int n = keep ?? KeepSessions();
            if (n == KeepSessions()) return;
            AddonRegistry.ConfigFor(typeof(LogPanel).Assembly).Set("Logging", "KeepSessions", n.ToString());
            GenieBootstrap.Log("Log retention set to " + n + " sessions.");
        }
    }

    // About & Help: a header, then one card per topic, on the panel background.
    internal sealed class AboutPanel : UserControl {

        internal AboutPanel() {
            StackPanel body = new StackPanel { Margin = new Thickness(18, 16, 18, 18) };

            // Header: name, version tag, author, what it is.
            StackPanel title = new StackPanel { Orientation = Orientation.Horizontal };
            title.Children.Add(new TextBlock {
                Text              = LogStore.FrameworkTag,
                FontSize          = Genie.Theme.FontSizeTitle + 4,
                FontWeight        = FontWeights.SemiBold,
                Foreground        = Genie.Theme.TextPrimary,
                VerticalAlignment = VerticalAlignment.Center,
            });
            GenieTag version          = Genie.ControlUtils.CreateTag(AddonRegistry.Framework.DisplayVersion);
            version.Margin            = new Thickness(8, 2, 0, 0);
            version.VerticalAlignment = VerticalAlignment.Center;
            title.Children.Add(version);
            TextBlock by         = Genie.ControlUtils.CreateNoteText("by " + Genie.Author);
            by.Margin            = new Thickness(8, 2, 0, 0);
            by.VerticalAlignment = VerticalAlignment.Center;
            title.Children.Add(by);
            body.Children.Add(title);
            body.Children.Add(Para(
                "An addon framework for the XCOM 2 War of the Chosen SDK's Unreal Editor. Authors write addons; " +
                    "AddonGenie loads them into the editor, gives each one an entry in the Addons menu, and provides " +
                    "helpers for Unreal objects, packages and the Content Browser, along with themed UI controls.",
                6));

            // Getting started: what the user does first, then how it works.
            StackPanel start = Card(body, "Getting started", null);
            start.Children.Add(Step(1, "Put `X2EditorAddonLauncher.bat` in `SDK\\Binaries\\Win64`.", 0));
            start.Children.Add(
                Step(2, "Put addons in the `Addons` folder beside it. It's created the first time you launch.", 8));
            start.Children.Add(
                Step(3, "Launch the editor with the batch file. Your addons appear in the Addons menu.", 8));
            Border easy = Genie.ControlUtils.CreateNote(
                Genie.ControlUtils.TagTone.Success, "Using addons is no-code, no-install. Easy in, easy out.",
                "Nothing to configure, and the SDK isn't modified. To remove " +
                    "AddonGenie, delete the batch file, its DLL and the Addons folder.");
            easy.Margin = new Thickness(0, 10, 0, 0);
            start.Children.Add(easy);
            TextBlock hood = Genie.ControlUtils.CreateNoteText("Under the hood");
            hood.Margin    = new Thickness(0, 14, 0, 0);
            start.Children.Add(hood);
            start.Children.Add(Para(
                "The batch and every addon are readable source, so you can inspect all of it. When run, the " +
                    "batch compiles the C# at its bottom into a DLL, sets environment variables that make .NET load " +
                    "that DLL into the editor at startup, and launches the editor. AddonGenie then adds the Addons " +
                    "menu and compiles every addon in the Addons folder.",
                4));

            // Troubleshooting.
            StackPanel trouble = Card(body, "Troubleshooting", null);
            DockPanel  tRow    = new DockPanel();
            Button     logs  = Genie.ControlUtils.CreateButton("View Logs", size: Genie.ControlUtils.ButtonSize.Small);
            logs.Click      += delegate {
                FrameworkWindows.ShowLogs();
            };
            Button configs = Genie.ControlUtils.CreateButton("View Configs", size: Genie.ControlUtils.ButtonSize.Small);
            configs.Margin = new Thickness(0);
            configs.Click += delegate {
                Genie.FileUtils.OpenFolder(GenieBootstrap.ConfigDir, true);
            };
            StackPanel tButtons        = Genie.ControlUtils.CreateButtonRow(logs, configs);
            tButtons.Margin            = new Thickness(12, 0, 0, 0);
            tButtons.VerticalAlignment = VerticalAlignment.Center;
            DockPanel.SetDock(tButtons, Dock.Right);
            tRow.Children.Add(tButtons);
            tRow.Children.Add(Para("The log shows what the framework and each addon reported. Each addon keeps its " +
                                       "settings in its own file under `Addons\\Config`.",
                                   0));
            trouble.Children.Add(tRow);

            // Writing addons.
            StackPanel writing = Card(body, "Writing addons", null);
            writing.Children.Add(Para("Addons are written in C#, so you'll need C# programming experience.", 0));
            writing.Children.Add(Para(
                "AddonGenie's utilities do the heavy lifting: reacting live to the Content Browser's selection " +
                    "and package changes, finding and inspecting Unreal objects, a modern set of themed controls, " +
                    "crash reporting and protection, and a log and settings file for every addon. An addon is a " +
                    "single .cs file; AddonGenie compiles it when the editor starts.",
                8));
            writing.Children.Add(Para(
                "To learn what the SDK's Unreal Editor offers, you'll read its code, which comes in three forms:", 8));
            Grid sources = new Grid { Margin = new Thickness(0, 2, 0, 0) };
            sources.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(155, GridUnitType.Pixel) });
            sources.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            AddSource(sources, "UnrealEdCSharp.dll", "Editor UI", "C#", "The Content Browser and editor UI.");
            AddSource(sources, "XComGame.exe", "Managed parts", "C++/CLI",
                      "Firaxis' editor classes and the bridges into native engine functions. They decompile to " +
                          "readable C#.");
            AddSource(sources, "XComGame.exe", "Engine", "C++",
                      "The native engine: object layouts, field offsets and everything below the bridges.");
            writing.Children.Add(sources);

            // Addons: loaded, then not loaded.
            int        total = AddonRegistry.Loaded.Count + AddonRegistry.Refused.Count;
            StackPanel addons =
                Card(body, "Addons", total > 0 ? Genie.ControlUtils.CreateCountPill(total.ToString()) : null);
            addons.Margin = new Thickness(0);
            if (total == 0) {
                TextBlock none = Genie.ControlUtils.CreateNoteText("No addons in SDK\\Binaries\\Win64\\Addons.");
                none.Margin    = new Thickness(12, 9, 12, 10);
                addons.Children.Add(none);
            }
            int row = 0;
            foreach (LoadedAddon a in AddonRegistry.Loaded) {
                DockPanel line   = new DockPanel();
                GenieTag  loaded = Genie.ControlUtils.CreateTag("Loaded", Genie.ControlUtils.TagTone.Success);
                DockPanel.SetDock(loaded, Dock.Right);
                line.Children.Add(loaded);
                TextBlock file  = Genie.ControlUtils.CreateMonoText(a.FileName, Genie.Theme.FontSizeLabel);
                file.Foreground = Genie.Theme.TextSecondary;
                DockPanel.SetDock(file, Dock.Right);
                line.Children.Add(file);
                StackPanel who = new StackPanel {
                    Orientation       = Orientation.Horizontal,
                    VerticalAlignment = VerticalAlignment.Center,
                };
                who.Children.Add(new TextBlock {
                    Text       = a.Name,
                    FontSize   = Genie.Theme.FontSizeBody,
                    FontWeight = FontWeights.SemiBold,
                    Foreground = Genie.Theme.TextPrimary,
                });
                if (a.Credit != null) {
                    TextBlock credit         = Genie.ControlUtils.CreateNoteText(a.Credit);
                    credit.Margin            = new Thickness(8, 1, 0, 0);
                    credit.VerticalAlignment = VerticalAlignment.Center;
                    who.Children.Add(credit);
                }
                line.Children.Add(who);
                addons.Children.Add(AddonRow(line, row++ < total - 1));
            }
            foreach (KeyValuePair<string, string> r in AddonRegistry.Refused) {
                StackPanel block   = new StackPanel();
                DockPanel  line    = new DockPanel();
                GenieTag   refused = Genie.ControlUtils.CreateTag("Not loaded", Genie.ControlUtils.TagTone.Danger);
                DockPanel.SetDock(refused, Dock.Right);
                line.Children.Add(refused);
                line.Children.Add(Genie.ControlUtils.CreateMonoText(r.Key, Genie.Theme.FontSizeLabel));
                block.Children.Add(line);
                TextBlock why = Genie.ControlUtils.CreateNoteText(Sentence(r.Value));
                why.Margin    = new Thickness(0, 2, 0, 0);
                block.Children.Add(why);
                addons.Children.Add(AddonRow(block, row++ < total - 1));
            }

            Content = new ScrollViewer {
                Content                     = body,
                VerticalScrollBarVisibility = ScrollBarVisibility.Auto,
                Background                  = Genie.Theme.PanelBackground,
            };
        }

        // Adds an info card to the page and returns its body.
        private static StackPanel Card(StackPanel page, string title, UIElement beside) {
            GenieInfoCard card = Genie.ControlUtils.CreateInfoCard(title, beside);
            card.Margin        = new Thickness(0, 12, 0, 0);
            page.Children.Add(card);
            return card.Body;
        }

        // Body text. `Backticks` mark names and paths, shown in the monospace font.
        private static TextBlock Para(string text, double top) {
            TextBlock t = new TextBlock {
                FontSize = Genie.Theme.FontSizeBody,  Foreground = Genie.Theme.TextPrimary,
                TextWrapping = TextWrapping.Wrap,     LineHeight = 19,
                Margin = new Thickness(0, top, 0, 0),
            };
            string[] parts = text.Split('`');
            for (int i = 0; i < parts.Length; i++) {
                if (parts[i].Length == 0) continue;
                System.Windows.Documents.Run run = new System.Windows.Documents.Run(parts[i]);
                if (i % 2 == 1) {
                    run.FontFamily = Genie.Theme.MonoFont;
                    run.FontSize   = Genie.Theme.FontSizeLabel;
                }
                t.Inlines.Add(run);
            }
            return t;
        }

        private static DockPanel Step(int number, string text, double top) {
            DockPanel d = Genie.ControlUtils.CreateStep(number, Para(text, 0));
            d.Margin    = new Thickness(0, top, 0, 0);
            return d;
        }

        // One "Writing addons" row: file, subtitle and language tag on the left; what it is on the right.
        private static void AddSource(Grid grid, string file, string subtitle, string language, string text) {
            int r = grid.RowDefinitions.Count;
            grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            double     top  = 10;
            StackPanel left = new StackPanel { Margin = new Thickness(0, top, 12, 0) };
            TextBlock  name = Genie.ControlUtils.CreateFileLink(LoadedFrom(file), file, Genie.Theme.FontSizeLabel);
            name.Margin     = new Thickness(0, 1, 0, 0);
            name.HorizontalAlignment = HorizontalAlignment.Left;
            left.Children.Add(name);
            StackPanel sub =
                new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 3, 0, 0) };
            TextBlock subText         = Genie.ControlUtils.CreateNoteText(subtitle);
            subText.VerticalAlignment = VerticalAlignment.Center;
            sub.Children.Add(subText);
            GenieTag tag          = Genie.ControlUtils.CreateTag(language);
            tag.Margin            = new Thickness(6, 0, 0, 0);
            tag.VerticalAlignment = VerticalAlignment.Center;
            sub.Children.Add(tag);
            left.Children.Add(sub);
            TextBlock what = Para(text, top);
            Grid.SetRow(left, r);
            Grid.SetColumn(left, 0);
            Grid.SetRow(what, r);
            Grid.SetColumn(what, 1);
            grid.Children.Add(left);
            grid.Children.Add(what);
        }

        // Where the editor loaded a file from, by its assembly name, since they don't share a folder
        // (UnrealEdCSharp.dll is in Binaries\Win64\Editor\Release). Null if it isn't loaded.
        private static string LoadedFrom(string file) {
            string name = Path.GetFileNameWithoutExtension(file);
            foreach (Assembly a in AppDomain.CurrentDomain.GetAssemblies()) {
                try {
                    if (a.GetName().Name == name) return a.Location;
                } catch {} // dynamic assemblies throw here
            }
            return null;
        }

        // An addon row inside the Addons card, with a divider below unless it's the last.
        private static Border AddonRow(UIElement content, bool divider) {
            return new Border {
                Child           = content,
                Padding         = new Thickness(12, 8, 12, 8),
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, divider ? 1 : 0),
            };
        }

        // Loader reasons are lowercase clauses ("compile error."); shown alone, they start with a capital.
        private static string Sentence(string reason) {
            if (string.IsNullOrEmpty(reason)) return "";
            return char.ToUpperInvariant(reason[0]) + reason.Substring(1);
        }
    }
