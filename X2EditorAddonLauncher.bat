    /// <summary>Made by Genie.ControlUtils.CreateTitledCard: an icon and title over Body, in a card.</summary>
    public sealed class GenieTitledCard : Border {
        private readonly ContentControl _icon;
        private readonly TextBlock      _title;
        private readonly StackPanel     _body;

        internal GenieTitledCard(double width) {
            _icon  = new ContentControl { Focusable = false, Margin = new Thickness(0, 0, 10, 0) };
            _title = new TextBlock {
                FontSize          = Genie.Theme.FontSizeValue + 1,
                FontWeight        = FontWeights.SemiBold,
                VerticalAlignment = VerticalAlignment.Center,
            };
            StackPanel top = new StackPanel { Orientation = Orientation.Horizontal };
            top.Children.Add(_icon);
            top.Children.Add(_title);
            _body = new StackPanel { Margin = new Thickness(0, 10, 0, 0) };
            StackPanel all = new StackPanel();
            all.Children.Add(top);
            all.Children.Add(_body);
            Child = all;
            Genie.ControlUtils.StyleCard(this, width);
        }

        /// <summary>Before the title, such as ControlUtils.CreateDialogIcon. Null for none.</summary>
        public UIElement Icon {
            get { return _icon.Content as UIElement; }
            set { _icon.Content = value; }
        }

        public string Title {
            get { return _title.Text; }
            set { _title.Text = value ?? ""; }
        }

        /// <summary>What to do, under the title: your lines, stacked as you space them.</summary>
        public StackPanel Body {
            get { return _body; }
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateRelationTable. Add rows after the header it starts with.</summary>
    public sealed class GenieRelationTable : Border {
        private const double ArrowColumn  = 22;
        private const double MinLeftShare = 0.25;

        private readonly Grid                   _grid = new Grid();
        private readonly bool                   _arrows;
        private readonly List<FrameworkElement> _lefts  = new List<FrameworkElement>();
        private readonly List<FrameworkElement> _rights = new List<FrameworkElement>();
        private double _leftNeed, _rightNeed; // natural widths, measured once loaded

        internal GenieRelationTable(string leftHeader, string rightHeader, bool arrows) {
            _arrows = arrows;
            _grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            _grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(ArrowColumn) });
            _grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            Add(HeaderCell(leftHeader),
                arrows ? Genie.ControlUtils.CreateArrowIcon(Genie.ControlUtils.ArrowDirection.Right) : null,
                HeaderCell(rightHeader), Genie.Theme.PanelBackground);

            Child           = _grid;
            BorderBrush     = Genie.Theme.Separator;
            BorderThickness = new Thickness(1);
            CornerRadius    = new CornerRadius(4);
            ClipToBounds    = true;
            // Text above leaves the table at a fractional y, which blurs a 1px top line into the header's shade.
            SnapsToDevicePixels = true;
            UseLayoutRounding   = true;

            // Natural widths need the window's fonts, so they're measured once loaded; the split is redone on resize.
            _grid.Loaded += delegate {
                _leftNeed  = NaturalWidth(_lefts);
                _rightNeed = NaturalWidth(_rights);
                _grid.InvalidateMeasure(); // the unconstrained measure left the cells sized for it
                Fit();
            };
            _grid.SizeChanged += delegate {
                Fit();
            };
        }

        /// <summary>
        /// A row: left beside right, which may stack several things (a StackPanel). The arrow, if any, sits level
        /// with the first line on each side rather than centred on a tall right cell.
        /// </summary>
        public void AddRow(FrameworkElement left, FrameworkElement right) {
            FrameworkElement arrow = null;
            if (_arrows) {
                arrow                   = Genie.ControlUtils.CreateArrowIcon(Genie.ControlUtils.ArrowDirection.Right);
                arrow.VerticalAlignment = VerticalAlignment.Top;
                arrow.Margin            = new Thickness(0, 8, 0, 0); // the cells' top margin, plus half the find icon
            }
            _lefts.Add(left);
            _rights.Add(right);
            Add(left, arrow, right, null);
        }

        /// <summary>A muted line across the table, such as "Nothing found".</summary>
        public void AddNote(string text) {
            TextBlock note = new TextBlock {
                Text                = text,
                FontSize            = Genie.Theme.FontSizeLabel,
                Foreground          = Genie.Theme.TextSecondary,
                HorizontalAlignment = HorizontalAlignment.Center,
                TextWrapping        = TextWrapping.Wrap,
                Margin              = new Thickness(6, 12, 6, 12),
            };
            Add(note, null, null, null);
            Grid.SetColumnSpan(note, 3);
        }

        private void Add(UIElement a, UIElement arrow, UIElement b, Brush background) {
            int r = _grid.RowDefinitions.Count;
            _grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            Border band = new Border {
                Background      = background ?? Brushes.Transparent,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, r == 0 ? 0 : 1, 0, 0),
            };
            Grid.SetRow(band, r);
            Grid.SetColumnSpan(band, 3);
            _grid.Children.Add(band);
            UIElement[] cells = { a, arrow, b };
            for (int c = 0; c < 3; c++) {
                if (cells[c] == null) continue;
                Grid.SetRow(cells[c], r);
                Grid.SetColumn(cells[c], c);
                _grid.Children.Add(cells[c]);
            }
        }

        // The left never passes half, so a wide left keeps 50/50.
        private void Fit() {
            double room = _grid.ActualWidth - ArrowColumn;
            if (room <= 0 || _leftNeed <= 0) return;
            double left = Math.Max(_leftNeed, room - _rightNeed);
            left        = Math.Min(room / 2, Math.Max(room * MinLeftShare, left));

            _grid.ColumnDefinitions[0].Width = new GridLength(left);
        }

        // The widest a set of cells gets with no limit: untrimmed text, margins included.
        private static double NaturalWidth(List<FrameworkElement> cells) {
            double widest = 0;
            foreach (FrameworkElement cell in cells) {
                cell.Measure(new Size(double.PositiveInfinity, double.PositiveInfinity));
                widest = Math.Max(widest, cell.DesiredSize.Width);
            }
            return widest;
        }

        private static UIElement HeaderCell(string text) {
            return new TextBlock {
                Text              = text ?? "",
                FontSize          = Genie.Theme.FontSizeTag,
                Foreground        = Genie.Theme.TextSecondary,
                TextTrimming      = TextTrimming.CharacterEllipsis,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(10, 5, 6, 5),
            };
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateFilterChips. Give it names and counts to show (SetItems).</summary>
    public sealed class GenieFilterChips : WrapPanel {
        // Every chip set on one key hears a toggle from any of them, by "file|section|key".
        private static event Action<string> Toggled;

        private const string EyeOff =
            "M 1.6,7 C 1.6,7 3.6,3.3 7,3.3 C 10.4,3.3 12.4,7 12.4,7 C 12.4,7 10.4,10.7 7,10.7 C 3.6,10.7 1.6,7 1.6,7 " +
            "Z M 7,5.3 A 1.7,1.7 0 1 1 7,8.7 A 1.7,1.7 0 1 1 7,5.3 Z M 2.2,11.8 L 11.8,2.2";

        private readonly string                     _key, _section, _callerFile, _id;
        private readonly Genie.ControlUtils.TagTone _tone;
        private HashSet<string>                     _hidden;
        private List<KeyValuePair<string, int>>     _items = new List<KeyValuePair<string, int>>();

        /// <summary>Raised when a name is hidden or shown, here or on another chip set with the same key.</summary>
        public event Action HiddenChanged;

        internal GenieFilterChips(string key, Genie.ControlUtils.TagTone tone, string section, string callerFile) {
            _key        = key;
            _tone       = tone;
            _section    = section;
            _callerFile = callerFile;
            _id         = callerFile + "|" + section + "|" + key;
            Load();
            Genie.ControlUtils.WhileLoaded(this, delegate { Toggled += OnToggled; },
                                           delegate { Toggled -= OnToggled; });
        }

        /// <summary>Whether name is hidden. Case-insensitive.</summary>
        public bool IsHidden(string name) {
            return name != null && _hidden.Contains(name);
        }

        /// <summary>One chip per name, with its count; the busiest first, then by name.</summary>
        public void SetItems(IEnumerable<KeyValuePair<string, int>> counts) {
            _items = new List<KeyValuePair<string, int>>(counts);
            _items.Sort((x, y) => x.Value != y.Value
                                      ? y.Value.CompareTo(x.Value)
                                      : string.Compare(x.Key, y.Key, StringComparison.OrdinalIgnoreCase));
            Build();
        }

        private void Load() {
            _hidden = new HashSet<string>(Genie.ConfigUtils.GetList(_key, _section, _callerFile),
                                          StringComparer.OrdinalIgnoreCase);
        }

        private void Toggle(string name) {
            if (!_hidden.Remove(name)) _hidden.Add(name);
            List<string> sorted = new List<string>(_hidden);
            sorted.Sort(StringComparer.OrdinalIgnoreCase);
            Genie.ConfigUtils.SetList(_key, sorted, _section, _callerFile);
            Action<string> handler = Toggled;
            if (handler != null) handler(_id);
            if (!IsLoaded) OnToggled(_id); // not listening, so tell itself
        }

        private void OnToggled(string id) {
            if (id != _id) return;
            Load();
            Build();
            Action handler = HiddenChanged;
            if (handler != null) handler();
        }

        private void Build() {
            Children.Clear();
            foreach (KeyValuePair<string, int> item in _items) Children.Add(Chip(item.Key, item.Value));
        }

        // [eye-off] name (count): the tone while shown; hidden, neutral and struck through.
        private Border Chip(string name, int count) {
            bool  off = IsHidden(name);
            Brush fill, edge, ink;
            Genie.ControlUtils.TagTone tone = off ? Genie.ControlUtils.TagTone.Neutral : _tone;
            Genie.ControlUtils.ToneBrushes(tone, out fill, out edge, out ink);
            StackPanel content = new StackPanel { Orientation = Orientation.Horizontal };
            if (off) {
                content.Children.Add(new System.Windows.Shapes.Path {
                    Data               = Geometry.Parse(EyeOff),
                    Stroke             = Genie.Theme.TextSecondary,
                    StrokeThickness    = 1.2,
                    StrokeStartLineCap = PenLineCap.Round,
                    StrokeEndLineCap   = PenLineCap.Round,
                    Width              = 14,
                    Height             = 14,
                    VerticalAlignment  = VerticalAlignment.Center,
                    Margin             = new Thickness(0, 0, 4, 0),
                });
            }
            content.Children.Add(new TextBlock {
                Text              = name,
                FontSize          = Genie.Theme.FontSizeTag + 0.5,
                Foreground        = off ? Genie.Theme.TextSecondary : ink,
                TextDecorations   = off ? TextDecorations.Strikethrough : null,
                VerticalAlignment = VerticalAlignment.Center,
            });
            content.Children.Add(new Border {
                Child = new TextBlock {
                    Text       = count.ToString(),
                    FontSize   = Genie.Theme.FontSizeCaption,
                    FontWeight = FontWeights.SemiBold,
                    Foreground = off ? Genie.Theme.TextSecondary : ink,
                },
                Background        = off ? fill : edge,
                CornerRadius      = new CornerRadius(8),
                Padding           = new Thickness(6, 0, 6, 0),
                Margin            = new Thickness(5, 0, 0, 0),
                VerticalAlignment = VerticalAlignment.Center,
            });
            Border chip = new Border {
                Child           = content,
                Height          = 24,
                Padding         = new Thickness(8, 0, 4, 0),
                Margin          = new Thickness(0, 0, 6, 6),
                CornerRadius    = new CornerRadius(12),
                BorderThickness = new Thickness(1),
                BorderBrush     = edge,
                Background      = off ? Genie.Theme.CardBackground : fill,
                Cursor          = System.Windows.Input.Cursors.Hand,
            };
            Genie.ControlUtils.SetToolTip(chip, off ? "Show " + name + " again" : "Hide " + name + " everywhere");
            chip.MouseLeftButtonUp += delegate {
                Toggle(name);
            };
            return chip;
        }
    }

    /// <summary>
    /// How a row list's column sizes (GenieRowList.SetColumns). Auto and AtLeast columns line up across rows (and
    /// across lists in one scope: GenieRowList.SharedColumns), sized to their widest cell.
    /// </summary>
    public sealed class GenieColumn {
        private enum Kind { Fill, Auto, Fixed, AtLeast, Fit, Number }

        private readonly Kind   _kind;
        private readonly double _width;

        private GenieColumn(Kind kind, double width) {
            _kind  = kind;
            _width = width;
        }

        /// <summary>Takes the width left over. Usually the first column, for a name or path.</summary>
        public static readonly GenieColumn Fill = new GenieColumn(Kind.Fill, 0);

        /// <summary>As wide as its widest cell; gone, gap and all, while no row has one (null or Collapsed).</summary>
        public static readonly GenieColumn Auto = new GenieColumn(Kind.Auto, 0);

        /// <summary>Always this wide, empty or not.</summary>
        public static GenieColumn Fixed(double width) {
            return new GenieColumn(Kind.Fixed, width);
        }

        /// <summary>
        /// As wide as this row's own cell, not lined up with other rows': for a cell whose width differs by level,
        /// such as a step's number ("2") and a substep's ("2.10"). Give cells a MinWidth to line up a level's rows.
        /// </summary>
        public static readonly GenieColumn Fit = new GenieColumn(Kind.Fit, 0);

        /// <summary>As Auto, but never narrower than this, so its slot stays even while every row's is empty.</summary>
        public static GenieColumn AtLeast(double width) {
            return new GenieColumn(Kind.AtLeast, width);
        }

        /// <summary>
        /// A row's number ("2", "2.10"), as wide as the widest of its level, so the levels' widths can differ. A row
        /// that expands has its chevron right after it, not at the row's start: for a list whose rows lead with what
        /// you manage (a checkbox, the number), as rows that lead with the chevron read as a tree. Child rows indent
        /// from there. The first Number column only. Example: Package Loader's steps box.
        /// </summary>
        public static readonly GenieColumn Number = new GenieColumn(Kind.Number, 0);

        internal bool IsNumber {
            get { return _kind == Kind.Number; }
        }

        // gap: the space before this column's cells, part of its width. The index names its shared size group, so
        // a column lines up with the same column of every row in scope; a Number column, of every row at its depth.
        internal ColumnDefinition Define(int index, double gap, int depth) {
            switch (_kind) {
                case Kind.Number:
                    return new ColumnDefinition {
                        Width           = GridLength.Auto,
                        SharedSizeGroup = "Column" + index + "_Level" + depth,
                    };
                case Kind.Fill:
                    return new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) };
                case Kind.Fixed:
                    return new ColumnDefinition { Width = new GridLength(_width + gap) };
                case Kind.Fit:
                    return new ColumnDefinition { Width = GridLength.Auto };
                case Kind.AtLeast:
                    return new ColumnDefinition {
                        Width           = GridLength.Auto,
                        MinWidth        = _width + gap,
                        SharedSizeGroup = "Column" + index,
                    };
                default:
                    return new ColumnDefinition { Width = GridLength.Auto, SharedSizeGroup = "Column" + index };
            }
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreateRowList. Shows its rows in the order added, then EmptyText while it has none,
    /// then its bars.
    /// </summary>
    public sealed class GenieRowList : Border {
        internal const double ExpanderWidth = 18;

        // On a row's cells (Cells): the chevron's slot in them, after a Number column. GenieRow puts it there, not at
        // the row's start.
        internal static readonly DependencyProperty ExpanderSlotProperty =
            DependencyProperty.RegisterAttached("GenieExpanderSlot", typeof(Border), typeof(GenieRowList));

        internal static Border NewExpanderSlot() {
            return new Border { Width = ExpanderWidth, Visibility = Visibility.Collapsed };
        }

        // A row's drag handle slot (GenieRow.SetDragHandle): the handle, then a gap before the chevron.
        internal const double HandleWidth = 10, HandleGap = 6;

        private readonly StackPanel _rows = new StackPanel();
        private readonly StackPanel _bars = new StackPanel();
        private readonly TextBlock  _emptyText;
        private readonly Border     _empty;
        private double              _childIndent = Genie.Theme.RowListIndent;
        private double              _rowPaddingY = 6;
        private bool                _keepExpanderSpace;
        private GenieColumn[]       _columns;
        private double              _columnGap = Genie.Theme.Spacing;
        private bool                _showInsertButtons;
        private Border              _allLine; // ShowExpandAll's
        private GenieExpandButton   _allButton;
        private TextBlock           _allText;
        private bool                _showExpandAll;
        private readonly Border         _head; // Caption's strip
        private readonly TextBlock      _caption;
        private readonly GenieCountPill _captionCount;
        private readonly StackPanel     _headActions = new StackPanel { Orientation = Orientation.Horizontal };

        /// <summary>
        /// Raised by a row's insert button (ShowInsertButtons): the row, and true for its top edge's. What to insert,
        /// and where, is yours.
        /// </summary>
        public event Action<GenieRow, bool> InsertRequested;

        /// <summary>
        /// Where rows dragged by a handle (GenieRow.SetDragHandle) can land. Given the row, the row under the pointer
        /// (never deeper than the dragged one) and whether the pointer is past its middle, returns a GenieRowDrop, or
        /// null where a drop leaves it as it is. Asked again whenever the pointer crosses a row's middle, and for every
        /// row by the arrow keys, so keep it cheap and free of side effects. Example: Package Loader's steps and
        /// substeps.
        /// </summary>
        public Func<GenieRow, GenieRow, bool, GenieRowDrop> RowDrop { get; set; }

        /// <summary>
        /// Every row keeps room for a drag handle (GenieRow.SetDragHandle) at its far left, before its chevron, so rows
        /// that can't be dragged line up with those that can. Example: a template's rows under a Package Loader step.
        /// </summary>
        public bool ReserveDragHandles {
            get { return _reserveDragHandles; }
            set {
                if (value == _reserveDragHandles) return;
                _reserveDragHandles = value;
                Thickness p         = _allLine.Padding;
                _allLine.Padding = new Thickness(10 + (value ? HandleWidth + HandleGap : 0), p.Top, p.Right, p.Bottom);
                foreach (GenieRow row in GetRows()) row.UpdateHandleSlot();
            }
        }
        private bool _reserveDragHandles;

        /// <summary>
        /// Raised as a drag's landing spot changes, with where it would land (null: where it was, or refused), and
        /// with null when the drag ends. For what only the addon knows, such as numbering the rows as they would be.
        /// </summary>
        public event Action<GenieRow, GenieRowDrop> RowDragPreview;

        internal void RaiseRowDragPreview(GenieRow row, GenieRowDrop drop) {
            if (RowDragPreview != null) RowDragPreview(row, drop);
        }

        // Grows by the gap while a row is dragged, so the rows the gap pushes down stay inside the border. Height 0,
        // not unset: an animation can't start from Auto (NaN).
        internal readonly Border DragSpace = new Border { Height = 0 };

        // The list's own bars and empty line, after the rows: the gap pushes them down too.
        internal IEnumerable<FrameworkElement> TrailingLines() {
            foreach (UIElement bar in _bars.Children) yield return (FrameworkElement)bar;
            yield return _empty;
        }

        internal GenieRowList() {
            _emptyText = new TextBlock { FontSize = Genie.Theme.FontSizeLabel, Foreground = Genie.Theme.TextSecondary };
            _empty     = Line(_emptyText, new Thickness(10, 8, 10, 8));
            _empty.Visibility = Visibility.Collapsed;
            StackPanel all    = new StackPanel();
            _allButton          = Genie.ControlUtils.CreateExpandButton();
            _allButton.Toggled += delegate(bool open) {
                ExpandAll(open);
            };
            _allText = new TextBlock {
                FontSize          = Genie.Theme.FontSizeLabel,
                Foreground        = Genie.Theme.TextSecondary,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(4, 0, 0, 0),
            };
            DockPanel allContent = new DockPanel();
            allContent.Children.Add(_allButton);
            allContent.Children.Add(_allText);
            // The whole line takes the click, not just its chevron.
            _allLine             = Line(allContent, new Thickness(10, 2, 10, 2));
            _allLine.Background  = Genie.Theme.PanelBackground;
            _allLine.Visibility  = Visibility.Collapsed;
            _allLine.Cursor      = System.Windows.Input.Cursors.Hand;
            _allLine.MouseEnter += delegate {
                _allLine.Background = Genie.Theme.ButtonHoverBackground;
            };
            _allLine.MouseLeave += delegate {
                _allLine.Background = Genie.Theme.PanelBackground;
            };
            _allLine.MouseLeftButtonUp += delegate(object sender, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled = true;
                ExpandAll(!_allButton.IsExpanded);
            };
            // As a list section's strip (GenieListSection), a little lower: rows here are taller than a list's.
            _caption                 = Genie.ControlUtils.CreateCaption("");
            _captionCount            = Genie.ControlUtils.CreateCountPill("");
            _captionCount.Margin     = new Thickness(8, 0, 0, 0);
            _captionCount.Visibility = Visibility.Collapsed;
            StackPanel title =
                new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };
            title.Children.Add(_caption);
            title.Children.Add(_captionCount);
            DockPanel head                 = new DockPanel();
            _headActions.VerticalAlignment = VerticalAlignment.Center;
            DockPanel.SetDock(_headActions, Dock.Right);
            head.Children.Add(_headActions);
            head.Children.Add(title);
            _head = new Border {
                Child           = head,
                MinHeight       = 30,
                Padding         = new Thickness(10, 0, 6, 0),
                Background      = Genie.Theme.FieldLabelBackground,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
                Visibility      = Visibility.Collapsed,
            };
            // ClipToBounds clips square, so the strip would cover the rounded corners.
            double inner     = Math.Max(0, Genie.Theme.BoxCornerRadius - 1);
            all.SizeChanged += delegate {
                all.Clip = _head.Visibility == Visibility.Visible
                               ? new RectangleGeometry(new Rect(all.RenderSize), inner, inner)
                               : null;
            };
            all.Children.Add(_head);
            all.Children.Add(_allLine);
            all.Children.Add(_rows);
            all.Children.Add(_empty);
            all.Children.Add(_bars);
            all.Children.Add(DragSpace);
            Child               = all;
            BorderBrush         = Genie.Theme.Separator;
            BorderThickness     = new Thickness(1, 1, 1, 0); // each row and bar draws the line under it
            CornerRadius        = new CornerRadius(Genie.Theme.BoxCornerRadius);
            ClipToBounds        = true;
            SnapsToDevicePixels = true;
            SharedColumns       = true;
            // As tall as its rows: stretched by its parent, the sides would run on below the last row's line.
            VerticalAlignment = VerticalAlignment.Top;
        }

        /// <summary>
        /// On by default: cells with the same SharedSizeGroup line up across this list's rows. Turn it off to line
        /// them up across several lists instead, with Grid.IsSharedSizeScope on a parent of them all.
        /// </summary>
        public bool SharedColumns {
            get { return Grid.GetIsSharedSizeScope(this); }
            set { Grid.SetIsSharedSizeScope(this, value); }
        }

        /// <summary>
        /// A shaded strip at the top naming the list ("CUSTOM"), as a list section's. Null or empty hides it. Example:
        /// Dependency Viewer's Source Folders.
        /// </summary>
        public string Caption {
            get { return _caption.Text; }
            set {
                _caption.Text    = (value ?? "").ToUpperInvariant();
                _head.Visibility = _caption.Text.Length > 0 ? Visibility.Visible : Visibility.Collapsed;
            }
        }

        /// <summary>The caption strip's count pill, hidden until you show it.</summary>
        public GenieCountPill CaptionCount {
            get { return _captionCount; }
        }

        /// <summary>A control at the caption strip's right end, such as an add icon. Several sit in the order
        /// added.</summary>
        public void AddCaptionAction(UIElement action) {
            FrameworkElement fe = action as FrameworkElement;
            if (fe != null && _headActions.Children.Count > 0) fe.Margin = new Thickness(2, 0, 0, 0);
            _headActions.Children.Add(action);
        }

        /// <summary>Shown while the list has no rows ("No custom sources."). Null or empty shows nothing.</summary>
        public string EmptyText {
            get { return _emptyText.Text; }
            set {
                _emptyText.Text = value ?? "";
                UpdateEmpty();
            }
        }

        /// <summary>
        /// A round + on a row's right edge while the pointer is on the row: on its bottom edge (InsertBelowTip) and
        /// its top (InsertAboveTip), each only while its tip is set. Clicks raise InsertRequested. Example: Package
        /// Loader's steps box, a step above or below a step, a substep below a substep.
        /// </summary>
        public bool ShowInsertButtons {
            get { return _showInsertButtons; }
            set {
                _showInsertButtons = value;
                foreach (GenieRow row in GetRows()) row.UpdateInsertButtons();
            }
        }

        /// <summary>
        /// Insert buttons on a bar (AddBar's, or a row's), as rows get: onAbove on its top edge, onBelow on its
        /// bottom, either null for none. Example: the closing bar's "add a step at the end", on its top edge.
        /// </summary>
        public void AddInsertButtons(Border bar, Action onAbove, string aboveTip, Action onBelow, string belowTip) {
            InsertButtons.Attach(bar, delegate { return true; }, onAbove, aboveTip, onBelow, belowTip);
        }

        internal void RaiseInsert(GenieRow row, bool above) {
            if (InsertRequested != null) InsertRequested(row, above);
        }

        /// <summary>
        /// A line at the top whose chevron, in the rows' chevron column, opens or closes every top-level row that
        /// expands: "Collapse all" while all of them are open, else "Expand all". Shown while any row expands.
        /// Example: Package Loader's steps box.
        /// </summary>
        public bool ShowExpandAll {
            get { return _showExpandAll; }
            set {
                _showExpandAll = value;
                UpdateExpandAll();
            }
        }

        /// <summary>Indent of each level of child rows. 0 keeps child rows' cells under their parent's.</summary>
        public double ChildIndent {
            get { return _childIndent; }
            set {
                _childIndent = value;
                foreach (GenieRow row in GetRows()) row.UpdatePadding();
            }
        }

        /// <summary>
        /// Space above and below each row's content (and bar's). Default 6; less for rows whose content is already
        /// tall, such as an icon group (ControlUtils.CreateIconGroup). Example: SWF Porter's rows.
        /// </summary>
        public double RowPaddingY {
            get { return _rowPaddingY; }
            set {
                _rowPaddingY = value;
                foreach (GenieRow row in GetRows()) row.UpdatePadding();
                foreach (UIElement bar in _bars.Children) ((Border)bar).Padding = RowPadding(0);
            }
        }

        /// <summary>
        /// Rows keep the chevron's room at each level where any row of that level can expand, so their contents line
        /// up; a level with none keeps none, so its rows' contents sit under their parent's, past its chevron. On:
        /// the top level keeps it even when none can, to line up with another list whose rows do.
        /// </summary>
        public bool KeepExpanderSpace {
            get { return _keepExpanderSpace; }
            set {
                _keepExpanderSpace = value;
                UpdateExpanderSpace();
            }
        }

        /// <summary>
        /// How AddRow's cells size, one per column; set it before adding rows. Unset: the first column Fill, the rest
        /// Auto. Lists lining up across one scope (SharedColumns off) need the same columns.
        /// </summary>
        public void SetColumns(params GenieColumn[] columns) {
            _columns = columns;
            UpdateAllLineLayout();
        }

        // With a Number column the rows' chevrons sit after it, so ShowExpandAll's line is cells too: its chevron in
        // the same slot, its text in the next column, lined up by the same shared sizes.
        private void UpdateAllLineLayout() {
            Detach(_allButton);
            Detach(_allText);
            int number = _columns == null ? -1 : Array.FindIndex(_columns, c => c.IsNumber);
            if (number < 0) {
                DockPanel content = new DockPanel();
                _allText.Margin   = new Thickness(4, 0, 0, 0);
                content.Children.Add(_allButton);
                content.Children.Add(_allText);
                _allLine.Child = content;
                return;
            }
            UIElement[] cells = new UIElement[_columns.Length];
            if (number + 1 < cells.Length) cells[number + 1] = _allText;
            _allText.Margin = new Thickness(0);
            Grid   grid     = Cells(cells, 0);
            Border slot     = (Border)grid.GetValue(ExpanderSlotProperty);
            slot.Child      = _allButton;
            slot.Visibility = Visibility.Visible;
            _allLine.Child  = grid;
        }

        private static void Detach(FrameworkElement element) {
            Panel panel   = element.Parent as Panel;
            Decorator box = element.Parent as Decorator;
            if (panel != null) panel.Children.Remove(element);
            if (box != null) box.Child = null;
        }

        /// <summary>Space before each cell after the first, added to its left margin. Set before adding rows.</summary>
        public double ColumnGap {
            get { return _columnGap; }
            set { _columnGap = value; }
        }

        /// <summary>A row of cells in the list's columns (SetColumns). A null cell is empty.</summary>
        public GenieRow AddRow(params UIElement[] cells) {
            return AddRow(Cells(cells, 0));
        }

        /// <summary>A row whose content is entirely yours, no columns. Cells that line up: AddRow(cells).</summary>
        public GenieRow AddRow(UIElement content) {
            GenieRow row = new GenieRow(this, 0, content);
            row.ExpandedChanged += delegate {
                UpdateExpandAll();
            };
            _rows.Children.Add(row);
            UpdateEmpty();
            UpdateExpanderSpace();
            UpdateExpandAll();
            return row;
        }

        /// <summary>Adds a strip after the rows, on the panel background, for buttons such as "Add".</summary>
        public Border AddBar(UIElement content) {
            Border bar = Bar(content, 0);
            _bars.Children.Add(bar);
            return bar;
        }

        /// <summary>The top-level rows, in order.</summary>
        public List<GenieRow> GetRows() {
            return GenieRow.RowsIn(_rows);
        }

        public void ClearRows() {
            _rows.Children.Clear();
            Changed();
        }

        // The cells in a grid of the list's columns. The gap goes on the cell, so an empty column takes none. After
        // the first Number column, a column of its own for the chevron's slot (ExpanderSlotProperty).
        internal Grid Cells(UIElement[] cells, int depth) {
            Grid   grid = new Grid();
            Border slot = null;
            for (int i = 0, at = 0; i < cells.Length; i++, at++) {
                GenieColumn column = (_columns != null && i < _columns.Length) ? _columns[i]
                                     : i == 0                                  ? GenieColumn.Fill
                                                                               : GenieColumn.Auto;
                double gap = i == 0 ? 0 : _columnGap;
                grid.ColumnDefinitions.Add(column.Define(i, gap, depth));
                FrameworkElement cell = cells[i] as FrameworkElement;
                if (cells[i] != null) {
                    if (cell != null && gap > 0)
                        cell.Margin = new Thickness(cell.Margin.Left + gap, cell.Margin.Top, cell.Margin.Right,
                                                    cell.Margin.Bottom);
                    Grid.SetColumn(cells[i], at);
                    grid.Children.Add(cells[i]);
                }
                if (!column.IsNumber || slot != null) continue;
                slot        = NewExpanderSlot();
                slot.Margin = new Thickness(_columnGap, 0, 0, 0);
                grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
                Grid.SetColumn(slot, ++at);
                grid.Children.Add(slot);
                grid.SetValue(ExpanderSlotProperty, slot);
            }
            return grid;
        }

        // After rows are added or removed anywhere in the list.
        internal void Changed() {
            UpdateEmpty();
            UpdateExpanderSpace();
            UpdateExpandAll();
        }

        internal Thickness RowPadding(int depth) {
            return new Thickness(10 + depth * _childIndent, _rowPaddingY, 10, _rowPaddingY);
        }

        internal Border Bar(UIElement content, int depth) {
            Border bar     = Line(content, RowPadding(depth));
            bar.Background = Genie.Theme.PanelBackground;
            return bar;
        }

        internal static Border Line(UIElement content, Thickness padding) {
            return new Border {
                Child           = content,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
                Padding         = padding,
            };
        }

        private void UpdateEmpty() {
            bool show         = _rows.Children.Count == 0 && _emptyText.Text.Length > 0;
            _empty.Visibility = show ? Visibility.Visible : Visibility.Collapsed;
        }

        private void UpdateExpanderSpace() {
            List<GenieRow> level = GetRows();
            for (bool top = true; level.Count > 0; top = false) {
                bool           keep = top && _keepExpanderSpace || level.Exists(r => r.Expandable);
                List<GenieRow> next = new List<GenieRow>();
                foreach (GenieRow row in level) {
                    row.ShowExpanderSpace(keep);
                    next.AddRange(row.GetRows());
                }
                level = next;
            }
        }

        private void ExpandAll(bool open) {
            foreach (GenieRow row in GetRows()) row.IsExpanded = open;
            UpdateExpandAll();
        }

        // Open reads as every row that expands being open.
        private void UpdateExpandAll() {
            List<GenieRow> rows = GetRows().FindAll(r => r.Expandable);
            _allLine.Visibility = _showExpandAll && rows.Count > 0 ? Visibility.Visible : Visibility.Collapsed;
            bool open            = rows.Count > 0 && rows.TrueForAll(r => r.IsExpanded);
            _allButton.IsExpanded = open;
            _allText.Text         = open ? "Collapse all" : "Expand all";
            Genie.ControlUtils.SetToolTip(_allButton, open ? "Close every row" : "Open every row");
        }
    }

    // A row's or bar's round + buttons, on its right edge: one on the top edge, one on the bottom, centred on the
    // lines so they read as "between these". An adorner, so they draw over the next row and past the list's border,
    // which clips its own content. Shown while the pointer is on the line or on them.
    internal sealed class InsertButtons : System.Windows.Documents.Adorner {
        private const double Size = 17;

        private static readonly DependencyProperty AttachedProperty =
            DependencyProperty.RegisterAttached("GenieInsertButtons", typeof(InsertButtons), typeof(InsertButtons));

        private readonly FrameworkElement _line;
        private readonly Func<bool>                   _enabled;
        private readonly Border                       _above, _below;
        private readonly VisualCollection             _visuals;
        private System.Windows.Documents.AdornerLayer _layer;

        private InsertButtons(FrameworkElement line, Func<bool> enabled, Action onAbove, string aboveTip,
                              Action onBelow, string belowTip)
            : base(line) {
            _line    = line;
            _enabled = enabled;
            _visuals = new VisualCollection(this);
            _above   = Button(onAbove);
            _below   = Button(onBelow);
            _visuals.Add(_above);
            _visuals.Add(_below);
            SetTips(aboveTip, belowTip);
            Visibility  = Visibility.Collapsed;
            MouseLeave += delegate {
                QueueHide();
            };
        }

        internal static void Attach(FrameworkElement line, Func<bool> enabled, Action onAbove, string aboveTip,
                                    Action onBelow, string belowTip) {
            InsertButtons buttons = new InsertButtons(line, enabled, onAbove, aboveTip, onBelow, belowTip);
            line.SetValue(AttachedProperty, buttons);
            Border border = line as Border;
            if (border != null && border.Background == null) border.Background = Brushes.Transparent; // hover anywhere
            line.Loaded += delegate {
                buttons._layer = System.Windows.Documents.AdornerLayer.GetAdornerLayer(line);
                if (buttons._layer != null) buttons._layer.Add(buttons); // none outside a GenieWindow: no buttons
            };
            line.Unloaded += delegate {
                if (buttons._layer != null) buttons._layer.Remove(buttons);
                buttons._layer = null;
            };
            line.MouseEnter += delegate {
                buttons.Visibility = buttons._enabled() ? Visibility.Visible : Visibility.Collapsed;
            };
            line.MouseLeave += delegate {
                buttons.QueueHide();
            };
        }

        internal static void SetTips(FrameworkElement line, string aboveTip, string belowTip) {
            InsertButtons buttons = line.GetValue(AttachedProperty) as InsertButtons;
            if (buttons != null) buttons.SetTips(aboveTip, belowTip);
        }

        private void SetTips(string aboveTip, string belowTip) {
            _above.Visibility = aboveTip == null ? Visibility.Collapsed : Visibility.Visible;
            _below.Visibility = belowTip == null ? Visibility.Collapsed : Visibility.Visible;
            Genie.ControlUtils.SetToolTip(_above, aboveTip);
            Genie.ControlUtils.SetToolTip(_below, belowTip);
        }

        // Moving from the line onto a button leaves the line first, so wait for the move to land.
        private void QueueHide() {
            Dispatcher.BeginInvoke(DispatcherPriority.Input, (Action)delegate {
                if (!_line.IsMouseOver && !IsMouseOver) Visibility = Visibility.Collapsed;
            });
        }

        private Border Button(Action onClick) {
            System.Windows.Shapes.Path plus = new System.Windows.Shapes.Path {
                Data               = Geometry.Parse("M 4.5,1 L 4.5,8 M 1,4.5 L 8,4.5"),
                StrokeThickness    = 1.4,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
                Width              = 9,
                Height             = 9,
                Stretch            = Stretch.None,
            };
            Border button = new Border {
                Child           = plus,
                Width           = Size,
                Height          = Size,
                CornerRadius    = new CornerRadius(Size / 2),
                BorderThickness = new Thickness(1),
                Cursor          = System.Windows.Input.Cursors.Hand,
            };
            Action paint = delegate {
                bool hot           = button.IsMouseOver;
                button.Background  = hot ? Genie.Theme.InfoTagBackground : Genie.Theme.InputBackground;
                button.BorderBrush = hot ? Genie.Theme.InfoTagText : Genie.Theme.InputBorder;
                plus.Stroke        = hot ? Genie.Theme.InfoTagText : Genie.Theme.TextPrimary;
            };
            button.MouseEnter += delegate {
                paint();
            };
            button.MouseLeave += delegate {
                paint();
            };
            button.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled  = true;
                Visibility = Visibility.Collapsed;
                if (onClick != null) onClick();
            };
            paint();
            return button;
        }

        protected override int VisualChildrenCount {
            get { return _visuals.Count; }
        }

        protected override Visual GetVisualChild(int index) {
            return _visuals[index];
        }

        protected override Size MeasureOverride(Size constraint) {
            _above.Measure(new Size(Size, Size));
            _below.Measure(new Size(Size, Size));
            return _line.RenderSize;
        }

        // Centred on the right border and on the top or bottom line: the line's own edges, plus half a border.
        protected override Size ArrangeOverride(Size finalSize) {
            double x = _line.ActualWidth - Size / 2 + 0.5;
            _above.Arrange(new Rect(x, -Size / 2, Size, Size));
            _below.Arrange(new Rect(x, _line.ActualHeight - Size / 2, Size, Size));
            return finalSize;
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateFieldTable. Rows show in the order added.</summary>
    /// <summary>Made by Genie.ControlUtils.CreateChangeBox.</summary>
    public sealed class GenieChangeBox : Border {
        // The arrow from the first caption to the second: down from under the first's start, a rounded turn, then
        // right to an open head. Lifted so its run and head sit level with the second caption's middle.
        private const string ArrowPath = "M 2,0.5 L 2,9.5 A 3,3 0 0 0 5,12.5 L 16.5,12.5 " +
                                         "M 14.2,10.2 L 16.5,12.5 L 14.2,14.8";
        private const double ArrowLift = 4;
        private const double RowGap    = 5;

        private readonly TextBlock _from, _to;

        internal GenieChangeBox(string fromName, string toName, UIElement fromTag, UIElement toTag,
                                string fromCaption, string toCaption) {
            Grid grid = new Grid();
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto }); // captions
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto }); // names
            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });

            TextBlock first = Genie.ControlUtils.CreateCaption(fromCaption);
            first.Margin    = new Thickness(0, 0, 10, 0);
            Place(grid, first, 0, 0);

            // The second caption at the column's right end, the arrow at its left.
            DockPanel second = new DockPanel { Margin = new Thickness(0, RowGap, 10, 0) };
            System.Windows.Shapes.Path arrow = new System.Windows.Shapes.Path {
                Data               = Geometry.Parse(ArrowPath),
                Stroke             = Genie.Theme.TextSecondary,
                StrokeThickness    = 1.1,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
                StrokeLineJoin     = PenLineJoin.Round,
                Width              = 18,
                Height             = 17,
                Stretch            = Stretch.None,
                VerticalAlignment  = VerticalAlignment.Center,
                RenderTransform    = new TranslateTransform(0, -ArrowLift),
            };
            DockPanel.SetDock(arrow, Dock.Left);
            second.Children.Add(arrow);
            TextBlock secondCaption           = Genie.ControlUtils.CreateCaption(toCaption);
            secondCaption.HorizontalAlignment = HorizontalAlignment.Right;
            second.Children.Add(secondCaption);
            Place(grid, second, 1, 0);

            _from = AddName(grid, fromName, 0);
            _to   = AddName(grid, toName, 1);
            AddTag(grid, fromTag, 0);
            AddTag(grid, toTag, 1);

            Child             = grid;
            Padding           = new Thickness(10, 6, 10, 6);
            Background        = Genie.Theme.FieldLabelBackground;
            BorderBrush       = Genie.Theme.Separator;
            BorderThickness   = new Thickness(1);
            CornerRadius      = new CornerRadius(Genie.Theme.BoxCornerRadius);
            UseLayoutRounding = true;
        }

        /// <summary>The first name, to give it hover text (its full path, say).</summary>
        public TextBlock FromText {
            get { return _from; }
        }

        /// <summary>The second name, to give it hover text.</summary>
        public TextBlock ToText {
            get { return _to; }
        }

        private static TextBlock AddName(Grid grid, string name, int row) {
            TextBlock text = Genie.ControlUtils.CreateMonoText(name ?? "-");
            text.Margin    = new Thickness(0, row == 0 ? 0 : RowGap, 8, 0);
            Place(grid, text, row, 1);
            return text;
        }

        private static void AddTag(Grid grid, UIElement tag, int row) {
            FrameworkElement fe = tag as FrameworkElement;
            if (fe == null) return;
            fe.Margin              = new Thickness(0, row == 0 ? 0 : RowGap, 0, 0);
            fe.HorizontalAlignment = HorizontalAlignment.Left;
            fe.VerticalAlignment   = VerticalAlignment.Center;
            Place(grid, fe, row, 2);
        }

        private static void Place(Grid grid, UIElement element, int row, int column) {
            Grid.SetRow(element, row);
            Grid.SetColumn(element, column);
            grid.Children.Add(element);
        }
    }

    public sealed class GenieFieldTable : Border {
        private const double IconSlot = 18; // CreateFindIcon and its kin
        private const double IconGap  = 2;

        private readonly StackPanel _rows = new StackPanel();

        internal GenieFieldTable() {
            Child               = _rows;
            BorderBrush         = Genie.Theme.Separator;
            BorderThickness     = new Thickness(1, 1, 1, 0); // each row draws the line under it
            CornerRadius        = new CornerRadius(Genie.Theme.BoxCornerRadius);
            SnapsToDevicePixels = true;
            // Text heights are fractional, so rows land between pixels: the last row's line, drawn at the clip's edge,
            // came out as a half-strength half pixel. Rounding puts every row, its line and the clip on whole pixels.
            UseLayoutRounding = true;
            Grid.SetIsSharedSizeScope(this, true);
            // ClipToBounds clips square, so the shaded labels would cover the rounded corners.
            double inner        = Math.Max(0, Genie.Theme.BoxCornerRadius - 1);
            _rows.SizeChanged  += delegate {
                _rows.Clip = new RectangleGeometry(new Rect(_rows.RenderSize), inner, inner);
            };
        }

        /// <summary>
        /// Adds a label and its value, then any icons at the row's end in Use, Find and Open slots (CreateUseIcon,
        /// CreateFindIcon, CreateOpenIcon). A row with an icon keeps all three slots, empty for a null, so each kind
        /// lines up down the table; a row with none gives its value the whole width. Every row is at least an icon
        /// tall, so rows with and without match. Collapse the returned row to leave it out.
        /// </summary>
        public FrameworkElement AddRow(string label, UIElement value, FrameworkElement use = null,
                                       FrameworkElement find = null, FrameworkElement open = null) {
            Grid row = new Grid();
            row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto, SharedSizeGroup = "Label" });
            row.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });

            row.Children.Add(new Border {
                Child =
                    new TextBlock {
                        Text              = label,
                        FontSize          = Genie.Theme.FontSizeLabel,
                        Foreground        = Genie.Theme.TextSecondary,
                        VerticalAlignment = VerticalAlignment.Center,
                    },
                Background      = Genie.Theme.FieldLabelBackground,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 1, 0),
                Padding         = new Thickness(10, 0, 10, 0),
            });
            Border cell = new Border { Child = Value(value, use, find, open), Padding = new Thickness(8, 5, 6, 5) };
            Grid.SetColumn(cell, 1);
            row.Children.Add(cell);

            Border line = new Border {
                Child           = row,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
            };
            _rows.Children.Add(line);
            return line;
        }

        /// <summary>
        /// False, the default: the table sizes its label column to its own labels. True: it shares the column with
        /// every table set so under the nearest element marked Grid.SetIsSharedSizeScope(element, true), so labels
        /// and values line up down a stack of tables. Example: Redirector Manager's multi-selection.
        /// </summary>
        public bool SharesLabelWidth {
            get { return !Grid.GetIsSharedSizeScope(this); }
            set { Grid.SetIsSharedSizeScope(this, !value); }
        }

        /// <summary>
        /// A heavier line under the rows so far, setting the rows after it apart as a group of their own. Example:
        /// Redirector Manager's multi-selection, between redirectors.
        /// </summary>
        public void AddBreak() {
            _rows.Children.Add(
                new Border { Height = 1, Background = Genie.Theme.Separator, SnapsToDevicePixels = true });
        }

        private static Grid Value(UIElement value, FrameworkElement use, FrameworkElement find, FrameworkElement open) {
            Grid cell = new Grid { MinHeight = IconSlot };
            cell.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            cell.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
            if (value != null) cell.Children.Add(value);
            if (use == null && find == null && open == null) return cell;
            StackPanel icons =
                new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(6, 0, 0, 0) };
            foreach (FrameworkElement icon in new[] { use, find, open }) {
                FrameworkElement slot = icon ?? new Border { Width = IconSlot };
                if (icons.Children.Count > 0) slot.Margin = new Thickness(IconGap, 0, 0, 0);
                icons.Children.Add(slot);
            }
            Grid.SetColumn(icons, 1);
            cell.Children.Add(icons);
            return cell;
        }
    }

    /// <summary>
    /// Where a dragged row would land, for GenieRowList.RowDrop: a gap before or after a row, at the top of an open
    /// row's children, or onto a row (into it, no gap), each with the move to make; or a refusal, saying why on the
    /// row. Label is its number there, shown in the gap and as the card's "To 4.2". UI thread only.
    /// </summary>
    public sealed class GenieRowDrop {
        internal enum Kinds { Before, After, AtStart, Into, Refused }

        internal readonly Kinds    Kind;
        internal readonly GenieRow Row;
        internal readonly Action   Apply;

        private GenieRowDrop(Kinds kind, GenieRow row, Action apply, string note) {
            Kind  = kind;
            Row   = row;
            Apply = apply;
            Note  = note;
        }

        /// <summary>Before the row.</summary>
        public static GenieRowDrop Before(GenieRow row, Action apply) {
            return new GenieRowDrop(Kinds.Before, row, apply, null);
        }

        /// <summary>After the row and its child rows.</summary>
        public static GenieRowDrop After(GenieRow row, Action apply) {
            return new GenieRowDrop(Kinds.After, row, apply, null);
        }

        /// <summary>First among an open row's children.</summary>
        public static GenieRowDrop AtStart(GenieRow parent, Action apply) {
            return new GenieRowDrop(Kinds.AtStart, parent, apply, null);
        }

        /// <summary>
        /// Onto the row: it's outlined, with the note ("Adds at the end"). A closed row that can open opens after a
        /// hold, and its children become places to drop.
        /// </summary>
        public static GenieRowDrop Into(GenieRow row, Action apply, string note = null) {
            return new GenieRowDrop(Kinds.Into, row, apply, note);
        }

        /// <summary>Not here: the row is tinted with why, and a drop puts the dragged row back.</summary>
        public static GenieRowDrop Refuse(GenieRow row, string why) {
            return new GenieRowDrop(Kinds.Refused, row, null, why);
        }

        /// <summary>Its number where it would land ("4.2").</summary>
        public string Label { get; set; }

        /// <summary>The card's chip: "To 4.2" by default, from Label.</summary>
        public string Result {
            get { return _result ?? (Label != null ? "To " + Label : "Moves here"); }
            set { _result = value; }
        }
        private string _result;

        /// <summary>On the highlighted row, for Into and Refuse.</summary>
        public string Note { get; private set; }

        /// <summary>Yours, such as the move it stands for, for RowDragPreview.</summary>
        public object Tag { get; set; }

        internal bool IsRefused {
            get { return Kind == Kinds.Refused; }
        }
    }

    /// <summary>
    /// Made by GenieRowList.AddRow or GenieRow.AddRow. Adding a child row or bar gives it the chevron that shows
    /// them; they start hidden.
    /// </summary>
    public sealed class GenieRow : StackPanel {
        private readonly GenieRowList _list;
        private readonly int          _depth;
        private readonly Border       _line, _expanderSlot;
        private readonly StackPanel   _rows = new StackPanel(), _bars = new StackPanel(), _below = new StackPanel();
        private GenieExpandButton     _expander;
        private string                _expandToolTip;
        private string                _insertAboveTip, _insertBelowTip = "Insert a row below";
        private bool                  _isDimmed, _expandsOnClick, _showBranchLines;
        private readonly UIElement    _content;

        /// <summary>
        /// Raised when the child rows show or hide, by the chevron or IsExpanded; gets the new state. Example: Package
        /// Loader's step rows, whose insert + below adds a substep while open and a step while closed.
        /// </summary>
        public event Action<bool> ExpandedChanged;
        private readonly HashSet<UIElement> _undimmed = new HashSet<UIElement>();

        internal GenieRow(GenieRowList list, int depth, UIElement content) {
            _content      = content;
            _list         = list;
            _depth        = depth;
            Border inCells = content != null ? (Border)content.GetValue(GenieRowList.ExpanderSlotProperty) : null;
            _expanderSlot  = inCells ?? GenieRowList.NewExpanderSlot();
            _handleSlot    = new Border {
                Width  = GenieRowList.HandleWidth,
                Margin = new Thickness(0, 0, GenieRowList.HandleGap, 0),
            };
            UpdateHandleSlot();

            // The handle first, then the chevron (unless it's in the cells, after a Number column): a handle at the far
            // left, as in most lists, reads as moving the row with what's in it.
            DockPanel line = new DockPanel();
            DockPanel.SetDock(_handleSlot, Dock.Left);
            line.Children.Add(_handleSlot);
            if (inCells == null) {
                DockPanel.SetDock(_expanderSlot, Dock.Left);
                line.Children.Add(_expanderSlot);
            }
            if (content != null) line.Children.Add(content);
            _line             = GenieRowList.Line(line, list.RowPadding(depth));
            _below.Visibility = Visibility.Collapsed;
            _below.Children.Add(_rows);
            _below.Children.Add(_bars);
            Children.Add(_line);
            Children.Add(_below);
            InsertButtons.Attach(_line, delegate { return _list.ShowInsertButtons; },
                                 delegate { _list.RaiseInsert(this, true); }, null,
                                 delegate { _list.RaiseInsert(this, false); }, _insertBelowTip);
        }

        /// <summary>
        /// The insert button on the row's top edge, by its tooltip ("Insert a step above"); null (the default) shows
        /// none. Needs the list's ShowInsertButtons.
        /// </summary>
        public string InsertAboveTip {
            get { return _insertAboveTip; }
            set {
                _insertAboveTip = value;
                UpdateInsertButtons();
            }
        }

        /// <summary>The insert button on the row's bottom edge, by its tooltip; null shows none.</summary>
        public string InsertBelowTip {
            get { return _insertBelowTip; }
            set {
                _insertBelowTip = value;
                UpdateInsertButtons();
            }
        }

        internal void UpdateInsertButtons() {
            InsertButtons.SetTips(_line, _insertAboveTip, _insertBelowTip);
            foreach (GenieRow row in GetRows()) row.UpdateInsertButtons();
        }

        /// <summary>
        /// Fades the row's own cells, not its child rows, as for something switched off; cells passed to
        /// KeepUndimmed stay as they are, such as the checkbox that turns it back on.
        /// </summary>
        public bool IsDimmed {
            get { return _isDimmed; }
            set {
                _isDimmed = value;
                ApplyDim();
            }
        }

        /// <summary>A cell IsDimmed leaves alone.</summary>
        public void KeepUndimmed(UIElement cell) {
            _undimmed.Add(cell);
            ApplyDim();
        }

        // A row of cells dims cell by cell, so some can stay; a row of your own content dims whole.
        private void ApplyDim() {
            Grid cells = _content as Grid;
            if (cells == null) {
                if (_content != null) _content.Opacity = _isDimmed ? DimOpacity : 1;
                return;
            }
            foreach (UIElement cell in cells.Children) { // an off row still opens: its chevron doesn't dim
                bool dims    = _isDimmed && !_undimmed.Contains(cell) && cell != _expanderSlot;
                cell.Opacity = dims ? DimOpacity : 1;
            }
        }

        private const double DimOpacity = 0.45;

        /// <summary>The row's own background, not its child rows'. Null for none.</summary>
        public Brush Fill {
            get { return _line.Background == Brushes.Transparent ? null : _line.Background; }
            set { _line.Background = value ?? Brushes.Transparent; } // hit-testable, for the insert buttons' hover
        }

        /// <summary>Shows the chevron. Adding a child row or bar turns it on.</summary>
        public bool Expandable {
            get { return _expander != null; }
            set {
                if (value == Expandable) return;
                if (value) {
                    _expander          = Genie.ControlUtils.CreateExpandButton(false, _expandToolTip);
                    _expander.Toggled += delegate(bool isExpanded) {
                        _below.Visibility = isExpanded ? Visibility.Visible : Visibility.Collapsed;
                        if (ExpandedChanged != null) ExpandedChanged(isExpanded);
                    };
                } else {
                    _below.Visibility = Visibility.Collapsed;
                    _expander         = null;
                }
                _expanderSlot.Child = _expander;
                _list.Changed();
            }
        }

        /// <summary>Whether the child rows and bars show. Only an Expandable row expands.</summary>
        public bool IsExpanded {
            get { return _below.Visibility == Visibility.Visible; }
            set {
                if (_expander == null || value == IsExpanded) return;
                _expander.IsExpanded = value;
                _below.Visibility    = value ? Visibility.Visible : Visibility.Collapsed;
                if (ExpandedChanged != null) ExpandedChanged(value);
            }
        }

        /// <summary>
        /// A click anywhere on the row opens or closes it, not just its chevron. Controls in the row that handle
        /// their clicks keep them. Example: Package Loader's job rows in the running window.
        /// </summary>
        public bool ExpandsOnClick {
            get { return _expandsOnClick; }
            set {
                if (value == _expandsOnClick) return;
                _expandsOnClick = value;
                _line.Cursor    = value ? System.Windows.Input.Cursors.Hand : null;
                if (value)
                    _line.MouseLeftButtonUp += OnLineClick;
                else
                    _line.MouseLeftButtonUp -= OnLineClick;
            }
        }

        private void OnLineClick(object sender, System.Windows.Input.MouseButtonEventArgs e) {
            if (e.Handled || _expander == null) return;
            e.Handled  = true;
            IsExpanded = !IsExpanded;
        }

        /// <summary>
        /// Joins the child rows to this row with elbow lines, down from under its chevron. Example: Package Loader's
        /// run history, a step's substeps.
        /// </summary>
        public bool ShowBranchLines {
            get { return _showBranchLines; }
            set {
                _showBranchLines = value;
                InvalidateVisual();
            }
        }

        // Under the rows, which have no fill of their own unless given one. Any row opening or closing changes this
        // row's size, which redraws it.
        protected override void OnRender(DrawingContext dc) {
            base.OnRender(dc);
            if (!_showBranchLines || !IsExpanded) return;
            List<Point> arms = new List<Point>();
            foreach (GenieRow row in GetRows()) {
                // To the row's chevron, or past its empty chevron slot to its content.
                UIElement target = row.Expandable ? row._expanderSlot : row._content;
                double    left   = target != null && target.Visibility == Visibility.Visible
                                       ? target.TranslatePoint(new Point(0, 0), this).X
                                       : row._line.Padding.Left;
                double    y      = row.TranslatePoint(new Point(0, row._line.ActualHeight / 2), this).Y;
                arms.Add(new Point(left - Genie.ControlUtils.BranchArmGap, y));
            }
            Genie.ControlUtils.DrawBranchLines(
                dc, _expanderSlot.TranslatePoint(new Point(0, 0), this).X + GenieRowList.ExpanderWidth / 2,
                _line.ActualHeight, arms);
        }

        /// <summary>
        /// Lets the handle (ControlUtils.CreateDragHandle, in one of the row's cells) drag this row, as the list's
        /// RowDrop allows. The row lifts into a card under the pointer and the rows part to show where it lands. Keys,
        /// with the handle focused: Space picks it up, Up and Down step through the places it can go, Space drops it,
        /// Esc puts it back.
        /// </summary>
        public void SetDragHandle(FrameworkElement handle) {
            _handleSlot.Child = handle;
            UpdateHandleSlot();
            RowDrag.Attach(this, handle);
        }

        private readonly Border _handleSlot;

        internal void UpdateHandleSlot() {
            _handleSlot.Visibility =
                _handleSlot.Child != null || _list.ReserveDragHandles ? Visibility.Visible : Visibility.Collapsed;
            foreach (GenieRow row in GetRows()) row.UpdateHandleSlot();
        }

        /// <summary>Washes the row's line green for a moment: where something just landed.</summary>
        public void Flash() {
            Brush           rest = _line.Background;
            Color           to   = rest is SolidColorBrush ? ((SolidColorBrush)rest).Color : Colors.Transparent;
            SolidColorBrush wash = new SolidColorBrush(((SolidColorBrush)Genie.Theme.SuccessTagBackground).Color);
            System.Windows.Media.Animation.ColorAnimation fade =
                new System.Windows.Media.Animation.ColorAnimation(to, TimeSpan.FromMilliseconds(900)) {
                    BeginTime = TimeSpan.FromMilliseconds(300),
                };
            fade.Completed += delegate {
                if (_line.Background == wash) _line.Background = rest;
            };
            _line.Background = wash;
            wash.BeginAnimation(SolidColorBrush.ColorProperty, fade);
        }

        // One drag of a row, from the first move past StartDistance (or Space) to the drop. Targets are read against
        // the rows' layout, which the gap never changes: the gap is drawn by render transforms that push the lines
        // below it down, so it can't move the row under the pointer and make the target flicker.
        private sealed class RowDrag {
            private const double StartDistance = 4, EdgeZone = 28, EdgeStep = 14;
            private const int    MoveMs = 160, OpenAfterMs = 650;

            private readonly GenieRow         _row;
            private readonly GenieRowList     _list;
            private readonly FrameworkElement _handle;
            private readonly ScrollViewer     _scroll;
            private readonly DragLayer        _layer;
            private readonly System.Windows.Documents.AdornerLayer _adorners;
            private readonly DispatcherTimer                       _edgeTimer, _openTimer;
            private readonly System.Windows.Input.Cursor _cursor;
            private readonly double                      _grab, _gapHeight;
            private readonly bool                        _keyboard;
            private GenieRowDrop                         _drop; // null: where it was
            private GenieRow                             _hold; // a closed row an Into drop waits on, to open it
            private GenieRow _peeked; // a row the hold opened, closed again if the drag leaves it
            private bool     _ending;

            internal static void Attach(GenieRow row, FrameworkElement handle) {
                Point   press               = new Point();
                bool    pressed             = false;
                RowDrag drag                = null;
                handle.Focusable            = true; // for the keys
                handle.FocusVisualStyle     = null;
                handle.MouseLeftButtonDown += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled = true;
                    if (row._list.RowDrop == null || drag != null) return;
                    handle.Focus();
                    press   = e.GetPosition(row._list);
                    pressed = handle.CaptureMouse();
                };
                handle.MouseMove += delegate(object s, System.Windows.Input.MouseEventArgs e) {
                    if (!pressed) return;
                    Point at = e.GetPosition(row._list);
                    if (drag == null) {
                        if (Math.Abs(at.Y - press.Y) < StartDistance && Math.Abs(at.X - press.X) < StartDistance)
                            return;
                        drag = new RowDrag(row, handle, press.Y, false);
                    }
                    drag.Follow(at.Y);
                };
                Action<bool> release = delegate(bool drop) {
                    pressed = false;
                    if (handle.IsMouseCaptured) handle.ReleaseMouseCapture();
                    RowDrag done = drag;
                    drag         = null;
                    if (done != null) done.End(drop);
                };
                handle.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled = true;
                    release(true);
                };
                handle.LostMouseCapture += delegate {
                    if (pressed) release(false);
                };
                handle.KeyDown += delegate(object s, System.Windows.Input.KeyEventArgs e) {
                    System.Windows.Input.Key key = e.Key;
                    if (key == System.Windows.Input.Key.Escape && drag != null) {
                        e.Handled = true;
                        release(false);
                    } else if (key == System.Windows.Input.Key.Space || key == System.Windows.Input.Key.Enter) {
                        if (pressed || row._list.RowDrop == null) return;
                        e.Handled = true;
                        if (drag == null)
                            drag = new RowDrag(row, handle, double.NaN, true);
                        else
                            release(true);
                    } else if ((key == System.Windows.Input.Key.Up || key == System.Windows.Input.Key.Down) &&
                               drag != null && drag._keyboard) {
                        e.Handled = true;
                        drag.Step(key == System.Windows.Input.Key.Up ? -1 : 1);
                    }
                };
            }

            // pressY: where the pointer took it, in the list; NaN for the keys.
            private RowDrag(GenieRow row, FrameworkElement handle, double pressY, bool keyboard) {
                _row       = row;
                _list      = row._list;
                _handle    = handle;
                _cursor    = handle.Cursor;
                _keyboard  = keyboard;
                double top = TopOf(row);
                _grab      = keyboard ? 0 : pressY - top;
                _gapHeight = row._line.ActualHeight;
                for (DependencyObject o = _list; o != null && _scroll == null; o = VisualTreeHelper.GetParent(o))
                    _scroll = o as ScrollViewer;

                // The card is a picture of the row's line as it is now; then the row folds away, its children too.
                _layer = new DragLayer(_list, row._line, row._line.TranslatePoint(new Point(0, 0), _list).X);
                row.Height       = 0;
                row.ClipToBounds = true;
                row.Opacity      = 0;
                _list.UpdateLayout();
                _adorners = System.Windows.Documents.AdornerLayer.GetAdornerLayer(_list);
                if (_adorners != null) _adorners.Add(_layer);
                _layer.MoveCard(top, false);

                _edgeTimer       = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(40) };
                _edgeTimer.Tick += delegate {
                    ScrollAtEdge();
                };
                if (_scroll != null && !keyboard) _edgeTimer.Start();
                _openTimer       = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(OpenAfterMs) };
                _openTimer.Tick += delegate {
                    _openTimer.Stop();
                    if (_hold == null || _hold.IsExpanded) return;
                    _peeked            = _hold;
                    _peeked.IsExpanded = true;
                    _list.UpdateLayout();
                    if (!_keyboard) Follow(System.Windows.Input.Mouse.GetPosition(_list).Y);
                };
                Show(null);
            }

            // == Following =========================================================================

            private void Follow(double y) {
                if (_ending) return;
                _layer.MoveCard(y - _grab, false);
                GenieRow over  = null;
                bool     below = false;
                Locate(_list.GetRows(), y, ref over, ref below);
                // Past the end of an open row, for a row that belongs inside one: after its last child.
                while (over != null && below && over._depth < _row._depth && over.IsExpanded &&
                       Children(over).Count > 0 && y >= TopOf(over) + over.ActualHeight)
                    over = Children(over)[Children(over).Count - 1];
                GenieRowDrop drop = over == null || over == _row ? null : _list.RowDrop(_row, over, below);
                if (!Same(drop, _drop)) Show(drop); // a move within one spot changes nothing but the card
            }

            // Each line's slide target, so a Show that keeps it doesn't start its slide over.
            private readonly Dictionary<TranslateTransform, double> _slides =
                new Dictionary<TranslateTransform, double>();

            // The row the pointer is on, no deeper than the dragged row: a row of its depth counts with its children.
        private void Locate(List<GenieRow> rows, double y, ref GenieRow over, ref bool below) {
            foreach (GenieRow r in rows) {
                if (r == _row) continue;
                double top = TopOf(r), bottom = top + r.ActualHeight, lineBottom = top + r._line.ActualHeight;
                if (y >= bottom) {
                    over  = r;
                    below = true;
                    continue;
                }
                List<GenieRow> children = r.IsExpanded ? Children(r) : new List<GenieRow>();
                if (r._depth >= _row._depth || y < lineBottom || children.Count == 0) {
                    over  = r;
                    below = y >= (top + (r._depth >= _row._depth ? bottom : lineBottom)) / 2;
                } else {
                    Locate(children, y, ref over, ref below);
                }
                return;
            }
            }

            private List<GenieRow> Children(GenieRow r) {
                return r.GetRows().FindAll(c => c != _row);
            }

            // Every place the keys can take it, top to bottom: each row asked above and below, kept once per spot.
            private List<GenieRowDrop> Places() {
                List<GenieRowDrop>     found = new List<GenieRowDrop>();
                List<double>           keys  = new List<double>();
                Action<GenieRow, bool> ask   = delegate(GenieRow r, bool below) {
                    GenieRowDrop d = _list.RowDrop(_row, r, below);
                    if (d == null || d.IsRefused) return;
                    double key = d.Kind == GenieRowDrop.Kinds.Into ? TopOf(d.Row) + 0.5 : GapY(d);
                    if (keys.Contains(key)) return;
                    keys.Add(key);
                    found.Add(d);
                };
                Action<List<GenieRow>> walk = null;
                walk                        = delegate(List<GenieRow> rows) {
                    foreach (GenieRow r in rows) {
                        if (r == _row || r._depth > _row._depth) continue;
                        ask(r, false);
                        if (r.IsExpanded && r._depth < _row._depth) walk(Children(r));
                        ask(r, true);
                    }
                };
                walk(_list.GetRows());
                double origin = TopOf(_row);
                found.Add(null); // where it was
                keys.Add(origin);
                List<int> order = new List<int>();
                for (int i = 0; i < found.Count; i++) order.Add(i);
                order.Sort((a, b) => keys[a].CompareTo(keys[b]));
                return order.ConvertAll(i => found[i]);
            }

            private void Step(int by) {
                List<GenieRowDrop> places = Places();
                int                at     = places.FindIndex(d => Same(d, _drop));
                if (at < 0) at = places.IndexOf(null);
                Show(places[Math.Max(0, Math.Min(places.Count - 1, at + by))]);
            }

            private static bool Same(GenieRowDrop a, GenieRowDrop b) {
                if (a == null || b == null) return a == b;
                return a.Kind == b.Kind && a.Row == b.Row;
            }

            // == Showing ===========================================================================

            private void Show(GenieRowDrop drop) {
                _drop = drop;

                // A closed row waited on opens after a hold; one the hold opened closes once the drag leaves it.
                GenieRow hold =
                    drop != null && drop.Kind == GenieRowDrop.Kinds.Into && drop.Row.Expandable && !drop.Row.IsExpanded
                        ? drop.Row
                        : null;
                if (hold != _hold) {
                    _hold = hold;
                    _openTimer.Stop();
                    if (hold != null) _openTimer.Start();
                }
                if (_peeked != null && (drop == null || !Within(drop.Row, _peeked))) {
                    _peeked.IsExpanded = false;
                    _peeked            = null;
                    _list.UpdateLayout();
                }

                bool   refused = drop != null && drop.IsRefused;
                bool   gap     = drop == null || refused || drop.Kind != GenieRowDrop.Kinds.Into;
                double gapY    = drop == null || refused ? TopOf(_row) : gap ? GapY(drop) : 0;
                PushLines(gap ? gapY : double.NaN);
                if (gap)
                    _layer.ShowGap(gapY, _gapHeight, Indent(drop),
                                   drop == null ? "Its place now"
                                   : refused    ? "Goes back here"
                                                : "Lands here",
                                   refused || drop == null ? null : drop.Label);
                else
                    _layer.HideGap();
                if (drop != null && (refused || drop.Kind == GenieRowDrop.Kinds.Into)) {
                    string note = drop.Note;
                    if (hold != null) note = (note != null ? note + " \u00b7 " : "") + "hold to open";
                    _layer.Highlight(TopOf(drop.Row), drop.Row._line.ActualHeight, note, refused);
                } else {
                    _layer.Highlight(0, 0, null, false);
                }
                _layer.SetChip(drop == null ? "Stays put" : refused ? "Can\u2019t go here" : drop.Result, refused);
                _handle.Cursor = refused ? System.Windows.Input.Cursors.No : System.Windows.Input.Cursors.SizeAll;
                if (_keyboard) _layer.MoveCard(gap ? gapY : TopOf(drop.Row), true);
                _list.RaiseRowDragPreview(_row, drop == null || refused ? null : drop);
            }

            private static bool Within(GenieRow row, GenieRow ancestor) {
                for (DependencyObject o = row; o != null; o = VisualTreeHelper.GetParent(o)) {
                    if (o == ancestor) return true;
                }
                return false;
            }

            private double GapY(GenieRowDrop d) {
                switch (d.Kind) {
                    case GenieRowDrop.Kinds.Before:
                        return TopOf(d.Row);
                    case GenieRowDrop.Kinds.After:
                        return TopOf(d.Row) + d.Row.ActualHeight;
                    default: // AtStart
                        return TopOf(d.Row) + d.Row._line.ActualHeight;
                }
            }

            private double Indent(GenieRowDrop d) {
                int depth = d == null || d.IsRefused               ? _row._depth
                            : d.Kind == GenieRowDrop.Kinds.AtStart ? d.Row._depth + 1
                                                                   : d.Row._depth;
                return _list.RowPadding(depth).Left + (_list.ReserveDragHandles ? GenieRowList.HandleWidth : 0);
            }

            // Every line and bar at or below the gap slides down by its height; the rest slide back.
            private void PushLines(double gapY) {
                foreach (FrameworkElement line in Lines()) {
                    TranslateTransform t = line.RenderTransform as TranslateTransform;
                    if (t == null || t.IsFrozen) line.RenderTransform = t = new TranslateTransform();
                    double top = line.TranslatePoint(new Point(0, 0), _list).Y - t.Y; // as laid out, not as pushed
                    Slide(t, !double.IsNaN(gapY) && top >= gapY - 0.5 ? _gapHeight : 0);
                }
                GrowSpace(double.IsNaN(gapY) ? 0 : _gapHeight);
            }

            private void GrowSpace(double height) {
                _list.DragSpace.BeginAnimation(
                    FrameworkElement.HeightProperty,
                    new System.Windows.Media.Animation.DoubleAnimation(height, TimeSpan.FromMilliseconds(MoveMs)));
            }

            private void Slide(TranslateTransform t, double to) {
                double was;
                if (_slides.TryGetValue(t, out was) ? was == to : t.Y == to) return;
                _slides[t] = to;
                t.BeginAnimation(TranslateTransform.YProperty, new System.Windows.Media.Animation.DoubleAnimation(
                                                                   to, TimeSpan.FromMilliseconds(MoveMs)) {
                    EasingFunction = new System.Windows.Media.Animation.QuadraticEase(),
                });
            }

            private IEnumerable<FrameworkElement> Lines() {
                List<FrameworkElement> lines = new List<FrameworkElement>();
                Action<GenieRow>       add   = null;
                add                          = delegate(GenieRow r) {
                    if (r == _row) return;
                    lines.Add(r._line);
                    if (!r.IsExpanded) return;
                    foreach (GenieRow c in r.GetRows()) add(c);
                    foreach (UIElement bar in r._bars.Children) lines.Add((FrameworkElement)bar);
                };
                foreach (GenieRow r in _list.GetRows()) add(r);
                lines.AddRange(_list.TrailingLines());
                return lines;
            }

            private void ScrollAtEdge() {
                double y  = System.Windows.Input.Mouse.GetPosition(_scroll).Y;
                double by = y < EdgeZone ? -EdgeStep : y > _scroll.ViewportHeight - EdgeZone ? EdgeStep : 0;
                double to = Math.Max(0, Math.Min(_scroll.ScrollableHeight, _scroll.VerticalOffset + by));
                if (to == _scroll.VerticalOffset) return;
                _scroll.ScrollToVerticalOffset(to);
                _scroll.UpdateLayout();
                Follow(System.Windows.Input.Mouse.GetPosition(_list).Y);
            }

            private double TopOf(GenieRow row) {
                return row.TranslatePoint(new Point(0, 0), _list).Y;
            }

            // == Ending ============================================================================

            // The card settles where it lands, or back where it was; then the row comes back and the move runs. The
            // move usually rebuilds the rows, the handle's among them, so it runs after this.
            private void End(bool drop) {
                if (_ending) return;
                _ending = true;
                _edgeTimer.Stop();
                _openTimer.Stop();
                GenieRowDrop d = drop && _drop != null && !_drop.IsRefused ? _drop : null;
                if (d == null && _peeked != null) {
                    _peeked.IsExpanded = false;
                    _peeked            = null;
                    _list.UpdateLayout();
                    PushLines(TopOf(_row));
                }
                double to = d == null ? TopOf(_row) : d.Kind == GenieRowDrop.Kinds.Into ? TopOf(d.Row) : GapY(d);
                _layer.MoveCard(to, true);
                DispatcherTimer settle  = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(MoveMs) };
                settle.Tick            += delegate {
                    settle.Stop();
                    Restore();
                    _list.RaiseRowDragPreview(_row, null);
                    if (d != null && d.Apply != null) d.Apply();
                };
                settle.Start();
            }

            private void Restore() {
                if (_adorners != null) _adorners.Remove(_layer);
                foreach (FrameworkElement line in Lines()) {
                    TranslateTransform t = line.RenderTransform as TranslateTransform;
                    if (t == null || t.IsFrozen) continue;
                    t.BeginAnimation(TranslateTransform.YProperty, null);
                    t.Y = 0;
                }
                _list.DragSpace.BeginAnimation(FrameworkElement.HeightProperty, null);
                _list.DragSpace.Height = 0;
                _row.ClearValue(FrameworkElement.HeightProperty);
                _row.ClipToBounds = false;
                _row.Opacity      = 1;
                _handle.Cursor    = _cursor;
            }
        }

        // Over the list while a row is dragged: the gap's dashed slot, a highlight on a row it would go into or can't,
        // and the card. Drawn as elements so text and the card's shadow come for free.
        private sealed class DragLayer : System.Windows.Documents.Adorner {
            private const int MoveMs = 160;

            private readonly Canvas    _canvas = new Canvas();
            private readonly Border    _card, _chip, _highlight, _note;
            private readonly TextBlock _chipText, _noteText, _gapText, _gapLabel;
            private readonly Grid      _gap;
            private readonly System.Windows.Shapes.Rectangle _gapEdge;
            private bool                                     _gapShown;

            // line: the dragged row's line, drawn live on the card (it keeps drawing while its row is folded away).
            internal DragLayer(FrameworkElement list, FrameworkElement line, double x) : base(list) {
                IsHitTestVisible = false;
                AddVisualChild(_canvas);

                _highlight = new Border { CornerRadius = new CornerRadius(2), Visibility = Visibility.Collapsed };
                _noteText =
                    new TextBlock { FontSize = Genie.Theme.FontSizeTag, VerticalAlignment = VerticalAlignment.Center };
                _note = new Border {
                    Child               = _noteText,
                    Padding             = new Thickness(7, 1, 7, 1),
                    CornerRadius        = new CornerRadius(9),
                    BorderThickness     = new Thickness(1),
                    HorizontalAlignment = HorizontalAlignment.Right,
                    VerticalAlignment   = VerticalAlignment.Center,
                    Margin              = new Thickness(0, 0, 10, 0),
                };
                _highlight.Child = _note;
                _canvas.Children.Add(_highlight);

                _gapEdge = new System.Windows.Shapes.Rectangle {
                    RadiusX         = 5,
                    RadiusY         = 5,
                    StrokeThickness = 1.5,
                    StrokeDashArray = new DoubleCollection { 4, 3 },
                };
                _gapLabel = new TextBlock {
                    FontFamily = Genie.Theme.MonoFont,    FontSize = Genie.Theme.FontSizeLabel,
                    Foreground = Genie.Theme.InfoTagText, VerticalAlignment = VerticalAlignment.Center,
                    Margin = new Thickness(0, 0, 8, 0),
                };
                _gapText = new TextBlock {
                    FontSize          = Genie.Theme.FontSizeLabel,
                    VerticalAlignment = VerticalAlignment.Center,
                };
                StackPanel gapLine = new StackPanel {
                    Orientation       = Orientation.Horizontal,
                    VerticalAlignment = VerticalAlignment.Center,
                    Margin            = new Thickness(12, 0, 0, 0),
                };
                gapLine.Children.Add(_gapLabel);
                gapLine.Children.Add(_gapText);
                _gap = new Grid { Visibility = Visibility.Collapsed };
                _gap.Children.Add(_gapEdge);
                _gap.Children.Add(gapLine);
                _canvas.Children.Add(_gap);

                _chipText =
                    new TextBlock { FontSize = Genie.Theme.FontSizeTag, VerticalAlignment = VerticalAlignment.Center };
                _chip = new Border {
                    Child               = _chipText,
                    Padding             = new Thickness(8, 1, 8, 1),
                    CornerRadius        = new CornerRadius(9),
                    BorderThickness     = new Thickness(1),
                    HorizontalAlignment = HorizontalAlignment.Right,
                    VerticalAlignment   = VerticalAlignment.Center,
                    Margin              = new Thickness(0, 0, 8, 0),
                };
                // The row drawn live, as vectors at 1:1, so its text is as sharp as the row's. A picture of it
                // (RenderTargetBitmap) loses ClearType and blurs. So does any effect on the card, which renders it
                // into a bitmap first: the shadow is a sibling under it.
                double w = line.ActualWidth, h = line.ActualHeight;
                Border face = new Border {
                    Width      = w,
                    Height     = h,
                    Background = new VisualBrush(line) {
                        Stretch      = Stretch.None,
                        AlignmentX   = AlignmentX.Left,
                        AlignmentY   = AlignmentY.Top,
                        ViewboxUnits = BrushMappingMode.Absolute,
                        Viewbox      = new Rect(0, 0, w, h),
                    },
                };
                Grid content = new Grid();
                content.Children.Add(face);
                content.Children.Add(_chip);
                Border shadow = new Border {
                    Background   = Genie.Theme.InputBackground,
                    CornerRadius = new CornerRadius(4),
                    Effect =
                        new System.Windows.Media.Effects.DropShadowEffect {
                            BlurRadius  = 18,
                            ShadowDepth = 5,
                            Direction   = 270,
                            Opacity     = 0.2,
                            Color       = Colors.Black,
                        },
                };
                Grid stack = new Grid();
                stack.Children.Add(shadow);
                stack.Children.Add(new Border {
                    Child           = content,
                    Background      = Genie.Theme.InputBackground,
                    BorderBrush     = Genie.Theme.ButtonBorder,
                    BorderThickness = new Thickness(1),
                    CornerRadius    = new CornerRadius(4),
                });
                _card = new Border {
                    Child  = stack,
                    Width  = w + 2, // and the border, just outside the row's line
                    Height = h + 2,
                };
                Canvas.SetLeft(_card, Math.Round(x) - 1);
                _canvas.UseLayoutRounding = true;
                _canvas.Children.Add(_card);
            }

            // animate: glide there (keys, the drop), else jump (the pointer).
            internal void MoveCard(double top, bool animate) {
                top = Math.Round(top) - 1; // whole pixels; the border sits just outside the row's line
                if (animate) {
                    _card.BeginAnimation(Canvas.TopProperty, new System.Windows.Media.Animation.DoubleAnimation(
                                                                 top, TimeSpan.FromMilliseconds(MoveMs)));
                } else {
                    _card.BeginAnimation(Canvas.TopProperty, null);
                    double height =
                        AdornedElement.RenderSize.Height; // the list's: not yet laid out, this layer has none
                    Canvas.SetTop(_card, Math.Max(-4, Math.Min(height - _card.Height + 4, top)));
                }
            }

            internal void SetChip(string text, bool refused) {
                _chipText.Text       = text ?? "";
                _chip.Visibility     = string.IsNullOrEmpty(text) ? Visibility.Collapsed : Visibility.Visible;
                _chip.Background     = refused               ? Genie.Theme.DangerTagBackground
                                       : text == "Stays put" ? Genie.Theme.PanelBackground
                                                             : Genie.Theme.InfoTagBackground;
                _chip.BorderBrush    = refused               ? Genie.Theme.DangerTagBorder
                                       : text == "Stays put" ? Genie.Theme.Separator
                                                             : Genie.Theme.InfoTagBorder;
                _chipText.Foreground = refused               ? Genie.Theme.DangerTagText
                                       : text == "Stays put" ? Genie.Theme.TextSecondary
                                                             : Genie.Theme.InfoTagText;
            }

            // label: its number there ("4.2"), or null where it was.
            internal void ShowGap(double y, double height, double left, string text, string label) {
                bool lands           = label != null;
                _gapEdge.Stroke      = lands ? Genie.Theme.InfoTagText : Genie.Theme.TextDisabled;
                _gapEdge.Fill        = lands ? Genie.Theme.InfoTagBackground : Genie.Theme.PanelBackground;
                _gapLabel.Text       = label ?? "";
                _gapLabel.Visibility = lands ? Visibility.Visible : Visibility.Collapsed;
                _gapText.Text        = text;
                _gapText.Foreground  = lands ? Genie.Theme.InfoTagText : Genie.Theme.TextSecondary;
                _gap.Width           = Math.Max(40, AdornedElement.RenderSize.Width - left - 6);
                _gap.Height          = Math.Max(10, height - 6);
                Canvas.SetLeft(_gap, left - 4);
                double top = y + 3;
                if (!_gapShown) {
                    _gap.BeginAnimation(Canvas.TopProperty, null);
                    Canvas.SetTop(_gap, top);
                } else {
                    _gap.BeginAnimation(Canvas.TopProperty, new System.Windows.Media.Animation.DoubleAnimation(
                                                                top, TimeSpan.FromMilliseconds(MoveMs)));
                }
                _gap.Visibility = Visibility.Visible;
                _gapShown       = true;
            }

            internal void HideGap() {
                _gap.Visibility = Visibility.Collapsed;
                _gapShown       = false;
            }

            // A row it would go into (blue edge) or can't (purple, as for a template); height 0 hides it.
            internal void Highlight(double y, double height, string note, bool refused) {
                if (height <= 0) {
                    _highlight.Visibility = Visibility.Collapsed;
                    return;
                }
                Brush tint                 = refused ? Genie.Theme.TypeTagBackground : Genie.Theme.InfoTagBackground;
                Brush ink                  = refused ? Genie.Theme.TypeTagText : Genie.Theme.InfoTagText;
                _highlight.Background      = new SolidColorBrush(((SolidColorBrush)tint).Color) { Opacity = 0.75 };
                _highlight.BorderBrush     = ink;
                _highlight.BorderThickness = new Thickness(refused ? 0 : 2);
                _highlight.Width           = AdornedElement.RenderSize.Width;
                _highlight.Height          = height;
                Canvas.SetTop(_highlight, y);
                _note.Visibility      = note == null ? Visibility.Collapsed : Visibility.Visible;
                _note.Background      = Genie.Theme.InputBackground;
                _note.BorderBrush     = refused ? Genie.Theme.TypeTagBorder : Genie.Theme.InfoTagBorder;
                _noteText.Text        = note ?? "";
                _noteText.Foreground  = ink;
                _noteText.FontWeight  = refused ? FontWeights.Normal : FontWeights.SemiBold;
                _highlight.Visibility = Visibility.Visible;
            }

            protected override int VisualChildrenCount {
                get { return 1; }
            }

            protected override Visual GetVisualChild(int index) {
                return _canvas;
            }

            protected override Size MeasureOverride(Size constraint) {
                _canvas.Measure(constraint);
                return AdornedElement.RenderSize;
            }

            protected override Size ArrangeOverride(Size finalSize) {
                _canvas.Arrange(new Rect(finalSize));
                return finalSize;
            }
        }

        /// <summary>The chevron's tooltip ("Show the stock folders").</summary>
        public string ExpandToolTip {
            get { return _expandToolTip; }
            set {
                _expandToolTip = value;
                if (_expander != null) Genie.ControlUtils.SetToolTip(_expander, value);
            }
        }

        /// <summary>A child row of cells in the list's columns (SetColumns). A null cell is empty.</summary>
        public GenieRow AddRow(params UIElement[] cells) {
            return AddRow(_list.Cells(cells, _depth + 1));
        }

        /// <summary>A child row whose content is entirely yours: no columns.</summary>
        public GenieRow AddRow(UIElement content) {
            GenieRow row = new GenieRow(_list, _depth + 1, content);
            _rows.Children.Add(row);
            Expandable = true;
            _list.Changed();
            return row;
        }

        /// <summary>Adds a strip after the child rows, on the panel background, for buttons such as "Add".</summary>
        public Border AddBar(UIElement content) {
            Border bar = _list.Bar(content, _depth + 1);
            _bars.Children.Add(bar);
            Expandable = true;
            return bar;
        }

        /// <summary>The child rows, in order.</summary>
        public List<GenieRow> GetRows() {
            return RowsIn(_rows);
        }

        /// <summary>Removes the child rows; bars stay.</summary>
        public void ClearRows() {
            _rows.Children.Clear();
            _list.Changed();
        }

        /// <summary>Takes the row, with its child rows, out of the list.</summary>
        public void Remove() {
            Panel owner = Parent as Panel;
            if (owner == null) return;
            owner.Children.Remove(this);
            _list.Changed();
        }

        internal static List<GenieRow> RowsIn(Panel panel) {
            List<GenieRow> rows = new List<GenieRow>();
            foreach (UIElement child in panel.Children) {
                GenieRow row = child as GenieRow;
                if (row != null) rows.Add(row);
            }
            return rows;
        }

        internal void ShowExpanderSpace(bool show) {
            _expanderSlot.Visibility = show ? Visibility.Visible : Visibility.Collapsed;
        }

        internal void UpdatePadding() {
            _line.Padding = _list.RowPadding(_depth);
            foreach (UIElement bar in _bars.Children) ((Border)bar).Padding = _list.RowPadding(_depth + 1);
            foreach (GenieRow row in GetRows()) row.UpdatePadding();
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateInfoCard. Add the card's content to Body.</summary>
    public sealed class GenieInfoCard : Border {
        private readonly StackPanel _body = new StackPanel { Margin = new Thickness(12, 10, 12, 12) };

        internal GenieInfoCard(string title, UIElement beside) {
            StackPanel head = new StackPanel { Orientation = Orientation.Horizontal };
            head.Children.Add(Genie.ControlUtils.CreateCaption(title, bold: true));
            FrameworkElement extra = beside as FrameworkElement;
            if (extra != null) {
                extra.Margin            = new Thickness(8, 0, 0, 0);
                extra.VerticalAlignment = VerticalAlignment.Center;
            }
            if (beside != null) head.Children.Add(beside);
            StackPanel inner = new StackPanel();
            inner.Children.Add(new Border {
                Child           = head,
                Padding         = new Thickness(12, 6, 12, 6),
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
            });
            inner.Children.Add(_body);
            Child               = inner;
            Background          = SystemColors.WindowBrush;
            BorderBrush         = Genie.Theme.Separator;
            BorderThickness     = new Thickness(1);
            CornerRadius        = new CornerRadius(Genie.Theme.ButtonCornerRadius);
            SnapsToDevicePixels = true;
        }

        public StackPanel Body {
            get { return _body; }
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreateList: a borderless single-selection list. Add rows with AddItem, which keeps
    /// your data in each row's Tag; read it back with SelectedTag, GetTags or TagOf.
    /// </summary>
    public sealed class GenieList : ListBox {
        private readonly RowGapConverter _gap;

        // Where the templates put things, read from the live elements, not assumed: the ListBox template pads
        // the rows' area in from the list's edges, and the scrollbar paints its thumb inside its strip (found by
        // rendering it: see PaintedSpan). In list
        // coordinates (its margin excluded): rows start ContentInset in and, with no bar, end _rightPad short of
        // the right edge; with a bar, the visible thumb starts _thumbGap right of the rows' area and ends
        // ThumbEdge short of the right edge.
        private ScrollViewer _viewer;
        private double       _contentInset, _rightPad, _thumbGap, _thumbEdge;
        private bool         _thumbMeasured, _measureQueued, _thumbMissed;

        /// <summary>Raised when a measured inset changes (ContentInset, ThumbEdge).</summary>
        internal event Action InsetsChanged;

        /// <summary>Raised when the first section is added: the pane drops its own label strip for them.</summary>
        internal event Action SectionsChanged;

        private readonly List<GenieListSection> _sections = new List<GenieListSection>();
        private double                          _rowLeft; // rows' left margin: a sectioned pane's inset

        // Tick boxes (Checkable): each row's box, and the rows that can't be ticked, with why.
        private bool _checkable;
        private readonly Dictionary<ListBoxItem, CheckBox> _checks   = new Dictionary<ListBoxItem, CheckBox>();
        private readonly Dictionary<ListBoxItem, string>   _noChecks = new Dictionary<ListBoxItem, string>();

        /// <summary>Raised when the ticked rows, or the rows that can be ticked, change (Checkable).</summary>
        internal event Action ChecksChanged;

        internal GenieList() {
            _gap                       = new RowGapConverter(this);
            BorderThickness            = new Thickness(0);
            Background                 = Brushes.Transparent;
            SelectionMode              = SelectionMode.Single;
            HorizontalContentAlignment = HorizontalAlignment.Stretch;
            // Below a header the list can land at a fractional y, and its clip there shaves the top row's
            // selection border.
            UseLayoutRounding = true;
            HorizontalScroll  = false;
            SizeChanged      += delegate {
                QueueMeasure();
            };
        }

        /// <summary>
        /// Space right of each row's selection: to the visible scrollbar thumb while one shows, else to the list's
        /// right edge, its right margin included, so rows end the same distance from either. Both are measured
        /// (MeasureInsets). Default Theme.ListRowGap.
        /// </summary>
        public double RowGap {
            get { return _gap.Gap; }
            set {
                _gap.Gap = value;
                UpdateRowGaps();
            }
        }

        /// <summary>How far the rows start in from the list's left edge: the template's padding, as measured.</summary>
        internal double ContentInset {
            get { return _contentInset; }
        }

        /// <summary>How far the visible thumb ends short of the list's right edge, once one is measured.</summary>
        internal double ThumbEdge {
            get { return _thumbEdge; }
        }

        internal bool ThumbMeasured {
            get { return _thumbMeasured; }
        }

        // The rows' gaps count the list's right margin.
        protected override void OnPropertyChanged(DependencyPropertyChangedEventArgs e) {
            base.OnPropertyChanged(e);
            if (e.Property == MarginProperty) UpdateRowGaps();
        }

        public override void OnApplyTemplate() {
            base.OnApplyTemplate();
            if (_viewer != null) _viewer.ScrollChanged -= OnScrollChanged;
            _viewer = FindVisual<ScrollViewer>(this);
            if (_viewer != null) _viewer.ScrollChanged += OnScrollChanged;
        }

        // The bar showing or hiding changes the viewport.
        private void OnScrollChanged(object sender, ScrollChangedEventArgs e) {
            if (e.ViewportWidthChange != 0 || e.ExtentHeightChange != 0 || e.ViewportHeightChange != 0)
                QueueMeasure();
        }

        // Measures once layout has settled: SizeChanged and ScrollChanged come mid-layout, before the bar that just
        // appeared is arranged, when its thumb has no size yet. Loaded priority runs after layout and render.
        private void QueueMeasure() {
            if (_measureQueued) return;
            _measureQueued = true;
            Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)delegate {
                _measureQueued = false;
                MeasureInsets();
            });
        }

        // Reads the insets from the elements as laid out; on a change, the rows' gaps follow. A change of row margin
        // changes nothing measured here, so this settles.
        private void MeasureInsets() {
            ScrollContentPresenter rows = _viewer == null ? null : FindVisual<ScrollContentPresenter>(_viewer);
            if (rows == null || rows.ActualWidth <= 0) return;
            double left    = rows.TranslatePoint(new Point(0, 0), this).X;
            double right   = rows.TranslatePoint(new Point(rows.ActualWidth, 0), this).X;
            bool   changed = Update(ref _contentInset, left);
            if (_viewer.ComputedVerticalScrollBarVisibility == Visibility.Visible) {
                FrameworkElement thumb = Thumb();
                double           paintedLeft, paintedRight;
                if (thumb != null && PaintedSpan(thumb, out paintedLeft, out paintedRight)) {
                    double thumbLeft = thumb.TranslatePoint(new Point(0, 0), this).X;
                    changed |= !_thumbMeasured;
                    changed |= Update(ref _thumbGap, thumbLeft + paintedLeft - right);
                    changed |= Update(ref _thumbEdge, ActualWidth - (thumbLeft + paintedRight));
                    _thumbMeasured = true;
                } else if (!_thumbMissed) {
                    _thumbMissed = true;
                    EngineThunks.Trace("GenieList: a scrollbar shows, but its thumb couldn't be measured (" +
                                       (thumb == null ? "not found" : "paints nothing") + ").");
                }
            } else {
                changed |= Update(ref _rightPad, ActualWidth - right);
            }
            if (!changed) return;
            UpdateRowGaps();
            if (InsetsChanged != null) InsetsChanged();
        }

        private static bool Update(ref double field, double value) {
            if (Math.Abs(field - value) < 0.01) return false;
            field = value;
            return true;
        }

        // The vertical bar's thumb, or null while it has none.
        private FrameworkElement Thumb() {
            System.Windows.Controls.Primitives.ScrollBar bar =
                _viewer.Template == null
                    ? null
                    : _viewer.Template.FindName("PART_VerticalScrollBar", _viewer) as
                          System.Windows.Controls.Primitives.ScrollBar;
            return (bar == null || bar.Track == null) ? null : bar.Track.Thumb;
        }

        // The columns an element actually paints, in its own coordinates, found by rendering it: a scrollbar
        // template paints its thumb narrower than the thumb's box, in ways its element tree doesn't show (the box
        // and its painted parts measure the full strip). False if nothing paints.
        private static bool PaintedSpan(FrameworkElement e, out double left, out double right) {
            left  = right = 0;
            int w = (int)Math.Ceiling(e.ActualWidth), h = (int)Math.Ceiling(e.ActualHeight);
            if (w <= 0 || h <= 0) return false;
            // Through a brush fixed to the element's own box: rendering the element itself would draw it at its
            // offset in its parent, and a brush's default viewbox would crop its blank edges, the very thing
            // measured.
            DrawingVisual drawing = new DrawingVisual();
            using (DrawingContext dc = drawing.RenderOpen()) {
                dc.DrawRectangle(new VisualBrush(e) {
                    Viewbox       = new Rect(0, 0, w, h),
                    ViewboxUnits  = BrushMappingMode.Absolute,
                    Viewport      = new Rect(0, 0, w, h),
                    ViewportUnits = BrushMappingMode.Absolute,
                    Stretch       = Stretch.None,
                }, null, new Rect(0, 0, w, h));
            }
            System.Windows.Media.Imaging.RenderTargetBitmap bitmap =
                new System.Windows.Media.Imaging.RenderTargetBitmap(w, h, 96, 96, PixelFormats.Pbgra32);
            bitmap.Render(drawing);
            int[] pixels = new int[w * h];
            bitmap.CopyPixels(pixels, w * 4, 0);
            int first = -1, last = -1;
            for (int x = 0; x < w; x++) {
                for (int y = 0; y < h; y++) {
                    if (((pixels[y * w + x] >> 24) & 0xFF) == 0) continue; // fully transparent
                    if (first < 0) first = x;
                    last = x;
                    break;
                }
            }
            if (first < 0) return false;
            left  = first;
            right = last + 1;
            return true;
        }

        private static T FindVisual<T>(DependencyObject d) where T : DependencyObject {
            int n = VisualTreeHelper.GetChildrenCount(d);
            for (int i = 0; i < n; i++) {
                DependencyObject child = VisualTreeHelper.GetChild(d, i);
                T                hit   = child as T ?? FindVisual<T>(child);
                if (hit != null) return hit;
            }
            return null;
        }

        private void UpdateRowGaps() {
            foreach (object item in Items) {
                ListBoxItem li = item as ListBoxItem;
                if (li == null) continue;
                BindingExpression b = BindingOperations.GetBindingExpression(li, MarginProperty);
                if (b != null) b.UpdateTarget();
            }
        }

        /// <summary>
        /// Off by default: rows get the list's width, so text set to trim ends in an ellipsis instead of the list
        /// scrolling sideways.
        /// </summary>
        public bool HorizontalScroll {
            get { return ScrollViewer.GetHorizontalScrollBarVisibility(this) != ScrollBarVisibility.Disabled; }
            set {
                ScrollBarVisibility bar = value ? ScrollBarVisibility.Auto : ScrollBarVisibility.Disabled;
                ScrollViewer.SetHorizontalScrollBarVisibility(this, bar);
            }
        }

        /// <summary>
        /// Off by default. On: each row added after starts with a tick box, and the selection is what's ticked. A
        /// click on a row selects just it, as before; its box, Ctrl+click and Shift+click add to the selection or take
        /// from it. A row that can't be ticked (SetCheckable) can still be selected, but only alone. Read the
        /// selection with SelectedTags; SelectionChanged reports changes. Set it before adding rows. Usually set by
        /// the pane (GenieListPane.EnableChecks), which adds a box ticking them all. Not for a list with sections.
        /// Example: Redirector Manager.
        /// </summary>
        public bool Checkable {
            get { return _checkable; }
            set {
                _checkable    = value;
                SelectionMode = value ? SelectionMode.Extended : SelectionMode.Single;
            }
        }

        /// <summary>
        /// Lets a row of a Checkable list be ticked, or not: its box disabled, with reason as its tooltip ("Not
        /// loaded: fully load this UPK to select it."). Untickable, it leaves a selection of several, and ticking all
        /// passes it by. Example: Redirector Manager's redirectors not loaded or not created yet.
        /// </summary>
        public void SetCheckable(ListBoxItem row, bool checkable, string reason = null) {
            CheckBox box;
            if (row == null || !_checks.TryGetValue(row, out box)) return;
            if (checkable) {
                if (!_noChecks.Remove(row)) return;
                Genie.ControlUtils.Unblock(box);
                BindCheck(box, row);
            } else {
                _noChecks[row] = reason ?? "";
                BindingOperations.ClearBinding(box, System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty);
                box.IsChecked = false;
                Genie.ControlUtils.Block(box, reason ?? "");
                if (row.IsSelected && SelectedItems.Count > 1) row.IsSelected = false;
            }
            RaiseChecksChanged();
        }

        /// <summary>The selected rows' tags that are a T, in list order: the ticked ones in a Checkable list.</summary>
        public List<T> SelectedTags<T>() {
            List<T> tags = new List<T>();
            foreach (object item in Items) {
                ListBoxItem li = item as ListBoxItem;
                if (li != null && li.IsSelected && li.Tag is T) tags.Add((T)li.Tag);
            }
            return tags;
        }

        /// <summary>
        /// Ticks every row shown that can be ticked (true), replacing the selection, or clears it (false). One
        /// SelectionChanged. Checkable lists only.
        /// </summary>
        public void CheckAll(bool check) {
            if (!_checkable) return;
            if (!check) {
                UnselectAll();
                return;
            }
            SetSelectedItems(TickableRows());
        }

        // Whether the shown rows that can be ticked are all ticked (true), none (false) or some (null).
        internal bool? CheckState {
            get {
                int all = 0, on = 0;
                foreach (ListBoxItem li in TickableRows()) {
                    all++;
                    if (li.IsSelected) on++;
                }
                return on == 0 ? false : on == all ? (bool?)true : null;
            }
        }

        internal bool HasTickableRows {
            get { return TickableRows().Count > 0; }
        }

        // The first shown row's box, to line the pane's select-all box up with.
        internal CheckBox FirstRowCheck() {
            foreach (object item in Items) {
                ListBoxItem li = item as ListBoxItem;
                CheckBox    box;
                if (li != null && li.Visibility == Visibility.Visible && _checks.TryGetValue(li, out box)) return box;
            }
            return null;
        }

        /// <summary>
        /// Selects these rows, replacing the selection, with one SelectionChanged: all of them in a Checkable list,
        /// the first otherwise. None: clears it. Example: Redirector Manager keeping its selection over a refresh.
        /// </summary>
        public void SelectRows(IList<ListBoxItem> rows) {
            if (rows == null || rows.Count == 0) {
                UnselectAll();
                return;
            }
            if (!_checkable) {
                SelectedItem = rows[0];
                return;
            }
            SetSelectedItems(rows);
        }

        // The rows shown (not hidden by a search) that can be ticked, in list order.
        private List<ListBoxItem> TickableRows() {
            List<ListBoxItem> rows = new List<ListBoxItem>();
            foreach (object item in Items) {
                ListBoxItem li = item as ListBoxItem;
                if (li != null && li.Visibility == Visibility.Visible && _checks.ContainsKey(li) &&
                    !_noChecks.ContainsKey(li))
                    rows.Add(li);
            }
            return rows;
        }

        // The box follows the row's selection both ways: ticking selects it beside the others, as Ctrl+click.
        private static void BindCheck(CheckBox box, ListBoxItem row) {
            box.SetBinding(System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty,
                           new Binding("IsSelected") { Source = row, Mode = BindingMode.TwoWay });
        }

        private void RaiseChecksChanged() {
            if (_checkable && ChecksChanged != null) ChecksChanged();
        }

        // A row that can't be ticked is selected only alone: a selection of several (Ctrl+click, Shift+click,
        // Ctrl+A) drops it. Dropping it raises the event again, so handlers see the selection settled.
        protected override void OnSelectionChanged(SelectionChangedEventArgs e) {
            if (_checkable && SelectedItems.Count > 1 && _noChecks.Count > 0) {
                List<ListBoxItem> drop = new List<ListBoxItem>();
                foreach (object item in SelectedItems) {
                    ListBoxItem li = item as ListBoxItem;
                    if (li != null && _noChecks.ContainsKey(li)) drop.Add(li);
                }
                foreach (ListBoxItem li in drop) li.IsSelected = false;
            }
            base.OnSelectionChanged(e);
            RaiseChecksChanged();
        }

        // Rows removed take their boxes and reasons with them.
        protected override void OnItemsChanged(System.Collections.Specialized.NotifyCollectionChangedEventArgs e) {
            base.OnItemsChanged(e);
            if (!_checkable) return;
            if (e.Action != System.Collections.Specialized.NotifyCollectionChangedAction.Add) {
                List<ListBoxItem> gone = new List<ListBoxItem>();
                foreach (ListBoxItem li in _checks.Keys)
                    if (!Items.Contains(li)) gone.Add(li);
                foreach (ListBoxItem li in gone) {
                    _checks.Remove(li);
                    _noChecks.Remove(li);
                }
            }
            RaiseChecksChanged();
        }

        /// <summary>
        /// Adds a row showing content, with tag as its data. Returns the row, to select or pad; the list sets its
        /// Margin (RowGap).
        /// </summary>
        public ListBoxItem AddItem(object content, object tag) {
            return InsertItem(Items.Count, content, tag);
        }

        /// <summary>
        /// A section of the list: a shaded strip with its caption, a count of its rows and room for a badge and
        /// actions (its own add icon), then the rows you add to it (GenieListSection.AddItem). Sections show in the
        /// order added; a list with sections takes no rows of its own. In a boxed pane the strips run edge to edge
        /// and replace the pane's label strip. Example: Package Loader's ON STARTUP, ON DEMAND and STEP TEMPLATES.
        /// </summary>
        public GenieListSection AddSection(string caption) {
            GenieListSection section = new GenieListSection(this, caption);
            _sections.Add(section);
            Items.Add(section);
            UpdateSections();
            if (_sections.Count == 1 && SectionsChanged != null) SectionsChanged();
            return section;
        }

        /// <summary>The sections, in order.</summary>
        public IList<GenieListSection> Sections {
            get { return _sections.AsReadOnly(); }
        }

        internal double RowLeft {
            get { return _rowLeft; }
            set {
                _rowLeft = value;
                UpdateRowGaps();
            }
        }

        // A row as AddItem makes it, inserted at index.
        internal ListBoxItem InsertItem(int index, object content, object tag) {
            // Content is given once: a row's content can't also go in the tick box's line (one parent only).
            ListBoxItem li = new ListBoxItem { Tag = tag };
            if (!_checkable) {
                li.Content = content;
            } else {
                // Not focusable, so the keyboard stays with the list (arrows, Space, Ctrl+A).
                CheckBox box  = Genie.ControlUtils.CreateCheckBox(null);
                box.Focusable = false;
                box.Margin    = new Thickness(0, 0, 7, 0);
                BindCheck(box, li);
                DockPanel line = new DockPanel();
                DockPanel.SetDock(box, Dock.Left);
                line.Children.Add(box);
                line.Children.Add(content as UIElement ?? new ContentControl { Content = content, Focusable = false });
                li.Content  = line;
                _checks[li] = box;
            }
            li.SetBinding(MarginProperty, new Binding("ComputedVerticalScrollBarVisibility") {
                RelativeSource = new RelativeSource(RelativeSourceMode.FindAncestor, typeof(ScrollViewer), 1),
                Converter      = _gap,
            });
            Items.Insert(index, li);
            return li;
        }

        // Each strip but the first shown gets a top line, where the rows above it have none.
        internal void UpdateSections() {
            bool first = true;
            foreach (GenieListSection section in _sections) {
                section.SetFirst(first);
                if (section.Visibility == Visibility.Visible) first = false;
            }
        }

        /// <summary>The selected row's tag as a T, or null.</summary>
        public T SelectedTag<T>() {
            return TagOf<T>(SelectedItem);
        }

        /// <summary>Every row's tag that is a T, in list order.</summary>
        public List<T> GetTags<T>() {
            List<T> tags = new List<T>();
            foreach (object item in Items) {
                ListBoxItem li = item as ListBoxItem;
                if (li != null && li.Tag is T) tags.Add((T)li.Tag);
            }
            return tags;
        }

        /// <summary>A row's tag as a T, or null. item: one of Items, or a selection event's.</summary>
        public static T TagOf<T>(object item) {
            ListBoxItem li = item as ListBoxItem;
            if (li != null && li.Tag is T) return (T)li.Tag;
            return default(T); // null for a class
        }

        // A row's right margin. With no bar, Gap less the list's own right margin and the template's right pad, both
        // part of the gap. Beside a bar, Gap less the measured space between the rows' area and the visible thumb.
        private sealed class RowGapConverter : IValueConverter {
            private readonly GenieList _list;
            public double              Gap = Genie.Theme.ListRowGap;

            public RowGapConverter(GenieList list) {
                _list = list;
            }

            public object Convert(object value, Type targetType, object parameter,
                                  System.Globalization.CultureInfo culture) {
                bool   hasBar = value is Visibility && (Visibility)value == Visibility.Visible;
                double right  = hasBar ? Gap - _list._thumbGap : Gap - _list.Margin.Right - _list._rightPad;
                return new Thickness(_list._rowLeft, 0, Math.Max(0, right), 0);
            }

            public object ConvertBack(object value, Type targetType, object parameter,
                                      System.Globalization.CultureInfo culture) {
                throw new NotSupportedException();
            }
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateListPane.</summary>
    public sealed class GenieListPane : DockPanel {
        private const double BoxedHeaderHeight = 28; // a field table row's height, so the two line up
        // The list's margin in the box. Rows sit this and the list's measured ContentInset from the border, and
        // the right side mirrors that gap: rows end it from the scrollbar's thumb or the border, the thumb ends it
        // from the border, and so do the header's actions.
        private const double BoxedInset = 4;

        private readonly bool _boxed;
        private Border        _box, _strip;
        private bool          _sectioned;
        private ListSearch    _search;

        private readonly TextBlock      _label;
        private readonly GenieCountPill _countPill;
        private readonly GenieList      _list;
        private readonly StackPanel     _actions = new StackPanel { Orientation = Orientation.Horizontal };
        private readonly StackPanel     _title   = new StackPanel { Orientation = Orientation.Horizontal };
        private CheckBox                _checkAll; // EnableChecks
        private bool                    _alignQueued;

        internal GenieListPane(string label, bool boxed) {
            _boxed = boxed;
            StackPanel title         = _title;
            _label                   = Genie.ControlUtils.CreateFieldLabel(label);
            _label.Margin            = new Thickness(0, 0, 8, 0);
            _label.VerticalAlignment = VerticalAlignment.Center;
            title.Children.Add(_label);
            _countPill            = Genie.ControlUtils.CreateCountPill("");
            _countPill.Visibility = Visibility.Collapsed;
            title.Children.Add(_countPill);

            DockPanel head                = new DockPanel();
            _actions.VerticalAlignment    = VerticalAlignment.Center;
            SetDock(_actions, Dock.Right);
            head.Children.Add(_actions);
            title.VerticalAlignment = VerticalAlignment.Center;
            head.Children.Add(title);

            _list                  = new GenieList();
            _list.SectionsChanged += delegate {
                _sectioned = true;
                if (_strip != null) _strip.Visibility = Visibility.Collapsed;
                MirrorMargin();
            };
            if (!boxed) {
                head.Margin = new Thickness(2, 0, 0, 5);
                SetDock(head, Dock.Top);
                Children.Add(head);
                Children.Add(_list);
                _list.InsetsChanged += MirrorMargin;
                MirrorMargin();
                return;
            }

            // Boxed: as GenieFieldTable, a shaded label strip over a line, all inside one rounded border.
            Border strip = _strip = new Border {
                Child           = head,
                MinHeight       = BoxedHeaderHeight,
                Background      = Genie.Theme.FieldLabelBackground,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
            };
            DockPanel inside = new DockPanel();
            SetDock(strip, Dock.Top);
            inside.Children.Add(strip);
            // A margin, not Padding, which the template doesn't pass to its scrollbar. Its right side is set from
            // the measured insets (MirrorMargin).
            _list.Margin = new Thickness(BoxedInset);
            inside.Children.Add(_list);
            _box = new Border {
                Child               = inside,
                UseLayoutRounding   = true, // as GenieFieldTable: lines and clip on whole pixels
                BorderBrush         = Genie.Theme.Separator,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(Genie.Theme.BoxCornerRadius),
                SnapsToDevicePixels = true,
            };
            Children.Add(_box);
            _list.InsetsChanged += MirrorMargin;
            MirrorMargin();
            // ClipToBounds clips square, so the shaded strip would cover the rounded corners.
            double inner        = Math.Max(0, Genie.Theme.BoxCornerRadius - 1);
            inside.SizeChanged += delegate {
                inside.Clip = new RectangleGeometry(new Rect(inside.RenderSize), inner, inner);
            };
        }

        // The pane's left margin, mirrored on the right, where the pane itself takes none: unboxed, rows end that far
        // (and the template's pad, as rows start) from the scrollbar's thumb or what's beside the pane; boxed, the
        // box ends that far from it.
        protected override void OnPropertyChanged(DependencyPropertyChangedEventArgs e) {
            base.OnPropertyChanged(e);
            if (e.Property == MarginProperty && _list != null) MirrorMargin();
        }

        // The left side's gaps, with the list's measured ContentInset, mirrored on the right.
        private void MirrorMargin() {
            if (!_boxed) {
                _list.RowGap = Margin.Left + _list.ContentInset;
                return;
            }
            if (_box == null) return;
            // The search field ends where the box does.
            if (_search != null) _search.Field.Margin = new Thickness(0, 0, Margin.Left, 6);
            if (_sectioned) {
                // Strips edge to edge: the list fills the box, and the rows take the inset themselves.
                _box.Margin   = new Thickness(0, 0, Margin.Left, 0);
                _list.Padding = new Thickness(0);
                _list.Margin  = new Thickness(0, 0, 0, BoxedInset);
                _list.RowLeft = BoxedInset;
                _list.RowGap  = BoxedInset;
                return;
            }
            double gap     = BoxedInset + _list.ContentInset;
            _box.Margin    = new Thickness(0, 0, Margin.Left, 0);
            _strip.Padding = new Thickness(10, 0, gap, 0);
            _list.RowGap   = gap;
            // Until a bar has been measured, a symmetric margin; with one, the thumb's own inset makes up the rest.
            double right = _list.ThumbMeasured ? gap - _list.ThumbEdge : BoxedInset;
            _list.Margin = new Thickness(BoxedInset, BoxedInset, Math.Max(0, right), BoxedInset);
        }

        /// <summary>
        /// A control at the label row's right end, such as an add icon (ControlUtils.CreateAddIcon). Several sit
        /// left to right in the order added.
        /// </summary>
        public void AddAction(UIElement action) {
            FrameworkElement fe = action as FrameworkElement;
            if (fe != null && _actions.Children.Count > 0) fe.Margin = new Thickness(2, 0, 0, 0);
            _actions.Children.Add(action);
        }

        /// <summary>
        /// Tick boxes on the rows (GenieList.Checkable), and one before the label that ticks every row shown that can
        /// be ticked, or clears them while any is: a dash while some are. Call it before adding rows. Example:
        /// Redirector Manager.
        /// </summary>
        public void EnableChecks() {
            if (_checkAll != null) return;
            _list.Checkable           = true;
            _checkAll                 = Genie.ControlUtils.CreateCheckBox(null);
            _checkAll.Focusable       = false;
            _checkAll.Margin          = new Thickness(0, 0, 8, 0);
            _checkAll.Click          += delegate {
                _list.CheckAll(_list.CheckState == false);
                UpdateCheckAll();
            };
            _title.Children.Insert(0, _checkAll);
            _list.ChecksChanged += UpdateCheckAll;
            _list.InsetsChanged += QueueAlignCheckAll;
            SizeChanged         += delegate {
                QueueAlignCheckAll();
            };
            UpdateCheckAll();
        }

        private void UpdateCheckAll() {
            bool? state           = _list.CheckState;
            _checkAll.IsChecked   = state;
            _checkAll.IsEnabled   = _list.HasTickableRows;
            Genie.ControlUtils.SetToolTip(_checkAll, state == false ? "Select all" : "Clear the selection");
            QueueAlignCheckAll();
        }

        // The select-all box sits over the rows' boxes, measured once laid out, as the list's insets are.
        private void QueueAlignCheckAll() {
            if (_alignQueued || _checkAll == null) return;
            _alignQueued = true;
            Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)delegate {
                _alignQueued = false;
                CheckBox row = _list.FirstRowCheck();
                if (row == null || !row.IsVisible || !_checkAll.IsVisible) return;
                double delta = row.TranslatePoint(new Point(0, 0), this).X -
                               _checkAll.TranslatePoint(new Point(0, 0), this).X;
                if (Math.Abs(delta) < 0.5) return;
                Thickness m      = _checkAll.Margin;
                _checkAll.Margin = new Thickness(m.Left + delta, m.Top, m.Right, m.Bottom);
            });
        }

        /// <summary>
        /// A search field over the pane's list: it filters the rows as you type, case-insensitively. onMatch gets a
        /// row's tag and the query; it returns null to hide the row, "" for a match on the row's name (the text in
        /// the TextBlocks passed to ControlUtils.SetSearchable is highlighted), or why it matched otherwise, shown
        /// under the row ("Loads X.upk"). Sections count what's shown and hide when they show nothing; with nothing
        /// shown at all, nothingText says so ({0}: the query). Ctrl+F in the window focuses the field; Esc and its ×
        /// clear it. Rows added while a query is in force are filtered too. Example: Package Loader's "Search jobs and
        /// templates".
        /// </summary>
        public void EnableSearch(string hint, Func<object, string, string> onMatch,
                                 string nothingText = "Nothing matches '{0}'.") {
            if (_search != null) return;
            _search              = new ListSearch(this, _list, hint, onMatch, nothingText);
            _search.Field.Margin = new Thickness(0, 0, _boxed ? Margin.Left : 0, 6);
            SetDock(_search.Field, Dock.Top);
            Children.Insert(0, _search.Field);
        }

        /// <summary>The query in force, trimmed; empty without one.</summary>
        public string SearchText {
            get { return _search == null ? "" : _search.Query; }
        }

        /// <summary>Filters the rows again, as after a change onMatch would see (a rename).</summary>
        public void ApplySearch() {
            if (_search != null) _search.Apply();
        }

        public TextBlock Label {
            get { return _label; }
        }
        public GenieCountPill CountPill {
            get { return _countPill; }
        }
        public GenieList List {
            get { return _list; }
        }
    }

    /// <summary>Made by GenieList.AddSection. Rows you add go after the section's last.</summary>
    public sealed class GenieListSection : ListBoxItem {
        private readonly GenieList      _list;
        private readonly TextBlock      _caption;
        private readonly GenieCountPill _count;
        private readonly ContentControl _badge   = new ContentControl { Focusable = false };
        private readonly StackPanel     _actions = new StackPanel { Orientation = Orientation.Horizontal };
        private readonly Border         _strip;
        private readonly List<ListBoxItem> _rows = new List<ListBoxItem>();
        private readonly GenieListNote     _empty;

        internal GenieListSection(GenieList list, string caption) {
            _list                      = list;
            Focusable                  = false;
            HorizontalContentAlignment = HorizontalAlignment.Stretch;
            Template                   = GenieListNote.PlainTemplate();

            _caption                 = Genie.ControlUtils.CreateCaption(caption);
            _count                   = Genie.ControlUtils.CreateCountPill("0");
            _count.Margin            = new Thickness(8, 0, 0, 0);
            _badge.Margin            = new Thickness(6, 0, 0, 0);
            _badge.VerticalAlignment = VerticalAlignment.Center;
            StackPanel title =
                new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };
            title.Children.Add(_caption);
            title.Children.Add(_count);
            title.Children.Add(_badge);
            DockPanel line             = new DockPanel();
            _actions.VerticalAlignment = VerticalAlignment.Center;
            DockPanel.SetDock(_actions, Dock.Right);
            line.Children.Add(_actions);
            line.Children.Add(title);
            _strip = new Border {
                Child           = line,
                MinHeight       = 34,
                Padding         = new Thickness(10, 0, 6, 0),
                Background      = Genie.Theme.FieldLabelBackground,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
            };
            Content = _strip;
            _empty  = new GenieListNote("");
        }

        public string Caption {
            get { return _caption.Text; }
            set { _caption.Text = (value ?? "").ToUpperInvariant(); }
        }

        /// <summary>Shows the rows shown; the section keeps it current.</summary>
        public GenieCountPill CountPill {
            get { return _count; }
        }

        /// <summary>Beside the count, such as a tag (Package Loader's amber Off). Null for none.</summary>
        public UIElement Badge {
            get { return _badge.Content as UIElement; }
            set { _badge.Content = value; }
        }

        /// <summary>Shown in place of rows while it has none ("None."). Null or empty shows nothing.</summary>
        public string EmptyText {
            get { return _empty.Text; }
            set {
                _empty.Text = value;
                UpdateEmpty();
            }
        }

        /// <summary>A control at the strip's right end, such as an add icon. Several sit in the order added.</summary>
        public void AddAction(UIElement action) {
            FrameworkElement fe = action as FrameworkElement;
            if (fe != null && _actions.Children.Count > 0) fe.Margin = new Thickness(2, 0, 0, 0);
            _actions.Children.Add(action);
        }

        /// <summary>The section's rows, in order.</summary>
        public IList<ListBoxItem> Rows {
            get { return _rows.AsReadOnly(); }
        }

        /// <summary>Adds a row at the section's end, as GenieList.AddItem does.</summary>
        public ListBoxItem AddItem(object content, object tag) {
            object      last = _rows.Count > 0 ? _rows[_rows.Count - 1] : (object)this;
            ListBoxItem li   = _list.InsertItem(_list.Items.IndexOf(last) + 1, content, tag);
            _rows.Add(li);
            UpdateEmpty();
            return li;
        }

        public void RemoveItem(ListBoxItem row) {
            if (!_rows.Remove(row)) return;
            _list.Items.Remove(row);
            UpdateEmpty();
        }

        public void ClearItems() {
            foreach (ListBoxItem row in _rows) _list.Items.Remove(row);
            _rows.Clear();
            UpdateEmpty();
        }

        // A strip isn't a row: a click on it selects nothing (its actions take their own clicks).
        protected override void OnMouseLeftButtonDown(System.Windows.Input.MouseButtonEventArgs e) {
            e.Handled = true;
        }

        internal void SetFirst(bool first) {
            _strip.BorderThickness = new Thickness(0, first ? 0 : 1, 0, 1);
        }

        // The count of rows shown, and the empty note while none exist and no search hides the section.
        internal void UpdateEmpty() {
            int shown   = _rows.FindAll(r => r.Visibility == Visibility.Visible).Count;
            _count.Text = shown.ToString();
            bool note   = _rows.Count == 0 && _empty.Text.Length > 0 && Visibility == Visibility.Visible;
            int  at     = _list.Items.IndexOf(_empty);
            if (note && at < 0) _list.Items.Insert(_list.Items.IndexOf(this) + 1, _empty);
            if (!note && at >= 0) _list.Items.Remove(_empty);
        }
    }

    // A line of muted text in a list that isn't a row: a click selects nothing, the keyboard skips it. A section's
    // "None.", the search's "Nothing matches".
    internal sealed class GenieListNote : ListBoxItem {
        private readonly TextBlock _text;

        [ThreadStatic]
        private static ControlTemplate _plain;

        internal GenieListNote(string text) {
            Focusable                  = false;
            HorizontalContentAlignment = HorizontalAlignment.Stretch;
            Template                   = PlainTemplate();
            _text                      = new TextBlock {
                Text         = text ?? "",
                FontSize     = Genie.Theme.FontSizeLabel,
                Foreground   = Genie.Theme.TextSecondary,
                TextWrapping = TextWrapping.Wrap,
                Margin       = new Thickness(10, 6, 10, 6),
            };
            Content = _text;
        }

        internal string Text {
            get { return _text.Text; }
            set { _text.Text = value ?? ""; }
        }

        protected override void OnMouseLeftButtonDown(System.Windows.Input.MouseButtonEventArgs e) {
            e.Handled = true;
        }

        // Just the content: no hover or selection look.
        internal static ControlTemplate PlainTemplate() {
            if (_plain == null) _plain = PlainTemplate(typeof(ListBoxItem));
