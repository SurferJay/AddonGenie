            /// <summary>
            /// A toned button's colours (ControlUtils.SetTone on a button), on the Danger button's ladder: face 50,
            /// edge 300, hovered 100 and 400, pressed 200, text the tone's tag text. Danger is the Danger button's;
            /// Neutral, a step darker than the standard button's.
            /// </summary>
            internal static void ToneButtonBrushes(ControlUtils.TagTone tone, out Brush fill, out Brush edge,
                                                   out Brush ink, out Brush hoverFill, out Brush hoverEdge,
                                                   out Brush pressedFill) {
                switch (tone) {
                    case ControlUtils.TagTone.Success:
                        Ladder(Palette.Green50, Palette.Green100, Palette.Green200, Palette.Green300, Palette.Green400,
                               SuccessTagText, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                               out pressedFill);
                        break;
                    case ControlUtils.TagTone.Danger:
                        Ladder(Palette.Red50, Palette.Red100, Palette.Red200, Palette.Red300, Palette.Red400,
                               DangerTagText, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                               out pressedFill);
                        break;
                    case ControlUtils.TagTone.Info:
                        Ladder(Palette.Blue50, Palette.Blue100, Palette.Blue200, Palette.Blue300, Palette.Blue400,
                               InfoTagText, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                               out pressedFill);
                        break;
                    case ControlUtils.TagTone.Type:
                        Ladder(Palette.Purple50, Palette.Purple100, Palette.Purple200, Palette.Purple300,
                               Palette.Purple400, TypeTagText, out fill, out edge, out ink, out hoverFill,
                               out hoverEdge, out pressedFill);
                        break;
                    case ControlUtils.TagTone.Caution:
                        Ladder(Palette.Yellow50, Palette.Yellow100, Palette.Yellow200, Palette.Yellow300,
                               Palette.Yellow400, CautionTagText, out fill, out edge, out ink, out hoverFill,
                               out hoverEdge, out pressedFill);
                        break;
                    case ControlUtils.TagTone.Warning:
                        Ladder(Palette.Orange50, Palette.Orange100, Palette.Orange200, Palette.Orange300,
                               Palette.Orange400, WarningTagText, out fill, out edge, out ink, out hoverFill,
                               out hoverEdge, out pressedFill);
                        break;
                    default:
                        Ladder(Palette.Gray150, Palette.Gray250, Palette.Gray300, Palette.Gray400, Palette.Gray500,
                               NeutralTagText, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                               out pressedFill);
                        break;
                }
            }

            /// <summary>A tone's hue ramp, palest first: 50 to 900 (Neutral's grays add 150, 250, 450).</summary>
            internal static Brush[] ToneRamp(ControlUtils.TagTone tone) {
                switch (tone) {
                    case ControlUtils.TagTone.Success:
                        return Palette.Greens;
                    case ControlUtils.TagTone.Danger:
                        return Palette.Reds;
                    case ControlUtils.TagTone.Info:
                        return Palette.Blues;
                    case ControlUtils.TagTone.Type:
                        return Palette.Purples;
                    case ControlUtils.TagTone.Caution:
                        return Palette.Yellows;
                    case ControlUtils.TagTone.Warning:
                        return Palette.Oranges;
                    default:
                        return Palette.Grays;
                }
            }

            private static void Ladder(Brush s50, Brush s100, Brush s200, Brush s300, Brush s400, Brush text,
                                       out Brush fill, out Brush edge, out Brush ink, out Brush hoverFill,
                                       out Brush hoverEdge, out Brush pressedFill) {
                fill        = s50;
                edge        = s300;
                ink         = text;
                hoverFill   = s100;
                hoverEdge   = s400;
                pressedFill = s200;
            }

