            /// <summary>
            /// Flat icons (CreateFindIcon and its kin) joined in one box, a line between each, as the window controls
            /// are. Each fills its square, hover included, and keeps its own behaviour (SetFindable, Block, SetTone).
            /// size: about as tall as an icon button of that size. Example: SWF Porter's rows.
            /// </summary>
            public static Border CreateIconGroup(ButtonSize size, params Border[] icons) {
                double     cell = size == ButtonSize.Small ? 20 : 25; // an icon button's height, less its border
                Border     box  = new Border();
                StackPanel row  = new StackPanel { Orientation = Orientation.Horizontal };
                StyleButtonBox(box);
                for (int i = 0; i < icons.Length; i++) {
                    icons[i].Width        = cell;
                    icons[i].Height       = cell;
                    icons[i].Margin       = new Thickness(0);
                    icons[i].CornerRadius = BoxedCorners(i, icons.Length);
                    if (i > 0) row.Children.Add(CreateSeparator(Orientation.Vertical));
                    row.Children.Add(icons[i]);
                }
                box.Child = row;
                return box;
            }

