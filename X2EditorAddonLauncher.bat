            /// <summary>
            /// Marks a row's name for GenieListPane.EnableSearch: a query its onMatch takes as a name match ("") is
            /// highlighted in it. Set its text before searching; the search keeps the text as it was.
            /// </summary>
            public static void SetSearchable(TextBlock text) {
                if (text != null) text.SetValue(SearchTextProperty, text.Text ?? "");
            }

            private static readonly DependencyProperty SearchTextProperty =
                DependencyProperty.RegisterAttached("GenieSearchText", typeof(string), typeof(ControlUtils));

            internal static bool IsSearchable(TextBlock text) {
                return text.GetValue(SearchTextProperty) != null;
            }

            // The text with its first hit of query marked, case-insensitively; query null or no hit: plain.
            internal static void ShowHit(TextBlock text, string query) {
                string all = (string)text.GetValue(SearchTextProperty);
                int    at  = string.IsNullOrEmpty(query) ? -1 : all.IndexOf(query, StringComparison.OrdinalIgnoreCase);
                text.Inlines.Clear();
                if (at < 0) {
                    text.Inlines.Add(new System.Windows.Documents.Run(all));
                    return;
                }
                text.Inlines.Add(new System.Windows.Documents.Run(all.Substring(0, at)));
                text.Inlines.Add(new System.Windows.Documents.Run(all.Substring(at, query.Length)) {
                    Background = Theme.WarningTagBackground,
                });
                text.Inlines.Add(new System.Windows.Documents.Run(all.Substring(at + query.Length)));
            }

