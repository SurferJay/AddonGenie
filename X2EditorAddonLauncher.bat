                DockPanel.SetDock(lead, Dock.Left);
                top.Children.Add(lead);
                TextBlock name    = CreateMonoText(text ?? pathName, Theme.FontSizeLabel);
                name.Margin       = new Thickness(4, 0, 0, 0);
