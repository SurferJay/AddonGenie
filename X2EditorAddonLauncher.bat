                // Frozen brushes are immutable, so every window can share them.
                private static SolidColorBrush Frozen(byte r, byte g, byte b) {
                    SolidColorBrush brush = new SolidColorBrush(Color.FromRgb(r, g, b));
                    brush.Freeze();
                    return brush;
                }
            }
        }

        // == Genie.ControlUtils =======================================================================
        // Themed controls. Optional style arguments default to null, meaning the theme's value, resolved at run
        // time so an addon follows later theme changes.

        public static class ControlUtils {
            // Primary: blue with white text, for a dialog's one go-ahead button (Save). Danger: throws something away.
            public enum ButtonTone { Standard, Danger, Primary }
            public enum ButtonSize { Regular, Small }

            // Danger, Warning and Caution are the safety-sign ladder (ANSI Z535): red, broken or thrown away; orange,
            // something to act on, or likely trouble; yellow, worth knowing but fine. Success: green. Info: blue, facts
            // such as sizes. Type: purple, what kind something is (a class), judging nothing. Colour never carries
            // meaning alone: tags have their words, prompt icons their shapes.
            public enum TagTone { Neutral, Danger, Warning, Caution, Success, Info, Type }

            /// <summary>A tray button's color (GenieTrayButton.Tone): its icon, hover tint and active fill.</summary>
            public enum TrayTone { Neutral, Accent, Success, Warning, Danger }
            public enum TagSize { Regular, Small }

            public enum ArrowDirection { Right, Left, Up, Down }

            /// <summary>
            /// The mark inside a dialog icon. Default: the tone's own (see CreateDialogIcon). Reload, FileMissing and
            /// FileNew: a package's file and what to do about it (Dependency Viewer's blocked view).
            /// </summary>
            public enum DialogSymbol {
                Default,
                Exclamation,
                Warning,
                Question,
                Info,
                Check,
                Reload,
                FileMissing,
                FileNew,
                None,
            }

            /// <summary>The buttons CreateWindowControls includes; combine with |.</summary>
            [Flags]
            public enum WindowControl { Refresh = 1, Pin = 2, Settings = 4, All = Refresh | Pin | Settings }

            /// <summary>
            /// Corner radius of buttons and dropdowns made here; their templates read it. Change it after creation
            /// with SetCornerRadius.
            /// </summary>
            public static readonly DependencyProperty CornerRadiusProperty = DependencyProperty.RegisterAttached(
                "CornerRadius", typeof(CornerRadius), typeof(ControlUtils),
                new FrameworkPropertyMetadata(new CornerRadius(Theme.ButtonCornerRadius)));

            // Templates are per thread, like any WPF object; the editor has one UI thread.
            [ThreadStatic]
            private static ControlTemplate _buttonTemplate, _dangerButtonTemplate, _primaryButtonTemplate;
            [ThreadStatic]
            private static Dictionary<TagTone, ControlTemplate> _tonedButtonTemplates;
            [ThreadStatic]
            private static ControlTemplate _checkBoxTemplate;
            [ThreadStatic]
            private static ControlTemplate _dropdownTemplate, _dropdownToggleTemplate;
            [ThreadStatic]
            private static Style _dropdownItemStyle;

            public static CornerRadius GetCornerRadius(DependencyObject element) {
                return (CornerRadius)element.GetValue(CornerRadiusProperty);
            }
            public static void SetCornerRadius(DependencyObject element, CornerRadius value) {
                element.SetValue(CornerRadiusProperty, value);
            }

            // == Buttons ==============================================================================

            /// <summary>
            /// A themed button. Disabled buttons look disabled (dimmed, grey text) even though the
            /// text color is set on the button. The tooltip also shows while the button is disabled. onClick: run
            /// on each click, as the icon buttons take theirs; or add your own Click handler.
            /// </summary>
            public static Button CreateButton(string text, ButtonTone tone = ButtonTone.Standard,
                                              ButtonSize size = ButtonSize.Regular, string tooltip = null,
                                              Thickness? padding = null, double? cornerRadius = null,
                                              double? fontSize = null, FrameworkElement icon = null,
                                              Action onClick = null) {
                bool  small = size == ButtonSize.Small;
                Brush fill, edge, ink, hoverFill, hoverEdge, pressedFill;
                ButtonBrushes(tone, out fill, out edge, out ink, out hoverFill, out hoverEdge, out pressedFill);
                Button b = new Button {
                    Content           = text,
                    Background        = fill,
                    Foreground        = ink,
                    BorderBrush       = edge,
                    BorderThickness   = new Thickness(1),
                    Padding           = padding ?? (small ? new Thickness(10, 2, 10, 2) : new Thickness(12, 4, 12, 4)),
                    FontSize          = fontSize ?? (small ? Theme.FontSizeLabel : Theme.FontSizeValue),
                    Margin            = new Thickness(0, 0, Theme.Spacing, 0),
                    VerticalAlignment = VerticalAlignment.Center,
                    SnapsToDevicePixels = true,
                    Template            = ButtonTemplate(tone),
                };
                SetCornerRadius(b, new CornerRadius(cornerRadius ?? Theme.ButtonCornerRadius));
                if (icon != null) { // before the text, in its own colours (CreatePencilIcon and the like)
                    StackPanel content = new StackPanel { Orientation = Orientation.Horizontal };
                    icon.Margin        = new Thickness(-2, 0, 5, 0);
                    content.Children.Add(icon);
                    content.Children.Add(
                        new TextBlock { Text = text ?? "", VerticalAlignment = VerticalAlignment.Center });
                    b.Content = content;
                }
                if (tooltip != null) SetToolTip(b, tooltip);
                if (onClick != null) b.Click += (sender, e) => onClick();
                b.SetValue(RepaintProperty, (Action)delegate { PaintButtonTone(b); }); // SetTone
                return b;
            }

            // A tone (SetTone) recolours a button at rest, hovered and pressed (Theme.ToneButtonBrushes) while set.
            // Its own look, colours and template, is kept aside and comes back with ClearTone, so a button coloured
            // by hand keeps its colours too. Disabled, it looks as any disabled button does, as a toned flat icon
            // just fades.
            private static void PaintButtonTone(Button b) {
                object      tone = b.GetValue(ToneProperty);
                UntonedLook own  = b.GetValue(UntonedLookProperty) as UntonedLook;
                if (tone != null) {
                    if (own == null) {
                        b.SetValue(UntonedLookProperty, new UntonedLook {
                            Fill = b.Background, Edge = b.BorderBrush, Ink = b.Foreground, Template = b.Template,
                        });
                    }
                    Brush fill, edge, ink, hoverFill, hoverEdge, pressedFill;
                    Theme.ToneButtonBrushes((TagTone)tone, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                                            out pressedFill);
                    b.Template    = TonedButtonTemplate((TagTone)tone);
                    b.Background  = fill;
                    b.BorderBrush = edge;
                    b.Foreground  = ink;
                } else if (own != null) {
                    b.Template    = own.Template;
                    b.Background  = own.Fill;
                    b.BorderBrush = own.Edge;
                    b.Foreground  = own.Ink;
                    b.ClearValue(UntonedLookProperty);
                }
            }

            private sealed class UntonedLook {
                public Brush           Fill, Edge, Ink;
                public ControlTemplate Template;
            }

            /// <summary>
            /// Changes a button's tone after creation, for a button whose meaning changes, such as one that turns from
            /// an ordinary action into one that throws something away.
            /// </summary>
            public static void SetButtonTone(Button button, ButtonTone tone) {
                if (button == null) return;
                Brush fill, edge, ink, hoverFill, hoverEdge, pressedFill;
                ButtonBrushes(tone, out fill, out edge, out ink, out hoverFill, out hoverEdge, out pressedFill);
                UntonedLook own = button.GetValue(UntonedLookProperty) as UntonedLook;
                if (own != null) { // toned (SetTone): this shows once it's cleared
                    own.Fill     = fill;
                    own.Edge     = edge;
                    own.Ink      = ink;
                    own.Template = ButtonTemplate(tone);
                    return;
                }
                button.Template    = ButtonTemplate(tone);
                button.Background  = fill;
                button.BorderBrush = edge;
                button.Foreground  = ink;
            }

            /// <summary>
            /// A count pill after a button's text, in tone: 1 to 999, "999+" past that. 0 or less: none, the plain
            /// button again. Example: Dependency Viewer's Reload linkers, counting the packages it reloads.
            /// </summary>
            public static void SetButtonCount(Button button, int count, TagTone tone = TagTone.Neutral) {
                if (button == null) return;
                GenieCountPill pill = button.GetValue(ButtonCountProperty) as GenieCountPill;
                if (pill == null) {
                    if (count <= 0) return;
                    object own        = button.Content;
                    button.Content    = null;
                    UIElement label   = own as UIElement ?? new TextBlock {
                        Text              = own as string ?? "",
                        VerticalAlignment = VerticalAlignment.Center,
                    };
                    pill              = CreateCountPill("", tone);
                    pill.Margin       = new Thickness(7, 0, 0, 0);
                    StackPanel both   = new StackPanel { Orientation = Orientation.Horizontal };
                    both.Children.Add(label);
                    both.Children.Add(pill);
                    button.Content = both;
                    button.SetValue(ButtonCountProperty, pill);
                    button.SetValue(ButtonPaddingProperty, button.Padding);
                }
                bool      shown = count > 0;
                Thickness before  = (Thickness)button.GetValue(ButtonPaddingProperty);
                pill.Text       = !shown ? "" : count > 999 ? "999+" : count.ToString();
                pill.Tone       = tone;
                pill.Visibility = shown ? Visibility.Visible : Visibility.Collapsed;
                // The pill's own padding stands in for the text's right margin.
                button.Padding = shown ? new Thickness(before.Left, before.Top, before.Right / 2, before.Bottom) : before;
            }

            private static readonly DependencyProperty ButtonCountProperty =
                DependencyProperty.RegisterAttached("GenieButtonCount", typeof(GenieCountPill), typeof(ControlUtils));
            private static readonly DependencyProperty ButtonPaddingProperty =
                DependencyProperty.RegisterAttached("GenieButtonPadding", typeof(Thickness), typeof(ControlUtils));

            /// <summary>
            /// A split button: the main part does the usual thing (Click), the ▾ part opens a menu of alternatives
            /// (AddMenuItem), right-aligned under the button. Each part can be enabled on its own (MainEnabled;
            /// menu items have their own IsEnabled), so the alternatives stay reachable when the usual thing isn't.
            /// </summary>
            public static GenieSplitButton CreateSplitButton(string text, ButtonSize size = ButtonSize.Regular,
                                                             string tooltip = null, Thickness? padding = null,
                                                             double? fontSize = null) {
                return new GenieSplitButton(text, size, tooltip, padding, fontSize);
            }

            /// <summary>
            /// A small chevron that turns down when expanded, for showing and hiding rows under a row. Place it left
            /// of the row's label; Toggled follows clicks. Showing and hiding the rows is yours to do.
            /// </summary>
            public static GenieExpandButton CreateExpandButton(bool isExpanded = false, string tooltip = null) {
                return new GenieExpandButton(isExpanded, tooltip);
            }

            /// <summary>A themed checkbox. The tooltip covers the box and its label.</summary>
            public static CheckBox CreateCheckBox(string text, bool isChecked = false, string tooltip = null) {
                // Left-aligned, so it's as wide as its box and label, not its cell: a tooltip centres on the control,
                // and in a wide shared column (a row list's) a stretched one centred far from the box.
                CheckBox box = new CheckBox {
                    Content             = text,
                    IsChecked           = isChecked,
                    Template            = CheckBoxTemplate(),
                    Foreground          = Theme.TextPrimary,
                    FontSize            = Theme.FontSizeLabel,
                    Background          = Brushes.Transparent, // the label's gaps take clicks too
                    VerticalAlignment   = VerticalAlignment.Center,
                    HorizontalAlignment = HorizontalAlignment.Left,
                };
                if (tooltip != null) SetToolTip(box, tooltip);
                return box;
            }

            /// <summary>
            /// A themed radio button, drawn as CreateCheckBox is. Those under one parent are one choice.
            /// Example: Package Loader's load error modes.
            /// </summary>
            public static RadioButton CreateRadioButton(string text, bool isChecked = false, string tooltip = null) {
                RadioButton button = new RadioButton {
                    Content             = text,
                    IsChecked           = isChecked,
                    Template            = RadioButtonTemplate(),
                    Foreground          = Theme.TextPrimary,
                    FontSize            = Theme.FontSizeLabel,
                    Background          = Brushes.Transparent, // the label's gaps take clicks too
                    VerticalAlignment   = VerticalAlignment.Center,
                    HorizontalAlignment = HorizontalAlignment.Left,
                };
                if (tooltip != null) SetToolTip(button, tooltip);
                return button;
            }

            private static ControlTemplate _radioButtonTemplate;

            // CheckBoxTemplate's look, round, with a dot for its mark.
            private static ControlTemplate RadioButtonTemplate() {
                if (_radioButtonTemplate != null) return _radioButtonTemplate;
                ControlTemplate         t    = new ControlTemplate(typeof(RadioButton));
                FrameworkElementFactory root = new FrameworkElementFactory(typeof(Border));
                root.Name                    = "root";
                root.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));
                root.SetValue(UIElement.SnapsToDevicePixelsProperty, true);
                FrameworkElementFactory row = new FrameworkElementFactory(typeof(StackPanel));
                row.SetValue(StackPanel.OrientationProperty, Orientation.Horizontal);
                FrameworkElementFactory box = new FrameworkElementFactory(typeof(Border));
                box.Name                    = "box";
                box.SetValue(FrameworkElement.WidthProperty, 14.0);
                box.SetValue(FrameworkElement.HeightProperty, 14.0);
                box.SetValue(Border.CornerRadiusProperty, new CornerRadius(7));
                box.SetValue(Border.BorderThicknessProperty, new Thickness(1));
                box.SetValue(Border.BackgroundProperty, Theme.CheckBoxBackground);
                box.SetValue(Border.BorderBrushProperty, Theme.CheckBoxBorder);
                box.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                FrameworkElementFactory dot = new FrameworkElementFactory(typeof(System.Windows.Shapes.Ellipse));
                dot.Name                    = "dot";
                dot.SetValue(FrameworkElement.WidthProperty, 6.0);
                dot.SetValue(FrameworkElement.HeightProperty, 6.0);
                dot.SetValue(System.Windows.Shapes.Shape.FillProperty, Theme.CheckMark);
                dot.SetValue(FrameworkElement.HorizontalAlignmentProperty, HorizontalAlignment.Center);
                dot.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                dot.SetValue(UIElement.VisibilityProperty, Visibility.Collapsed);
                box.AppendChild(dot);
                row.AppendChild(box);
                FrameworkElementFactory label = new FrameworkElementFactory(typeof(ContentPresenter));
                label.SetValue(FrameworkElement.MarginProperty, new Thickness(7, 0, 0, 0));
                label.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                row.AppendChild(label);
                root.AppendChild(row);
                t.VisualTree = root;

                Trigger over = new Trigger { Property = UIElement.IsMouseOverProperty, Value = true };
                over.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxHoverBorder, "box"));
                over.Setters.Add(new Setter(Border.BackgroundProperty, Theme.ButtonBackground, "box"));
                t.Triggers.Add(over);
                Trigger on = new Trigger {
                    Property = System.Windows.Controls.Primitives.ToggleButton.IsCheckedProperty,
                    Value    = true,
                };
                on.Setters.Add(new Setter(Border.BackgroundProperty, Theme.CheckBoxChecked, "box"));
                on.Setters.Add(new Setter(Border.BorderBrushProperty, Theme.CheckBoxChecked, "box"));
                on.Setters.Add(new Setter(UIElement.VisibilityProperty, Visibility.Visible, "dot"));
                t.Triggers.Add(on);
                Trigger off = new Trigger { Property = UIElement.IsEnabledProperty, Value = false };
                off.Setters.Add(new Setter(UIElement.OpacityProperty, 0.6, "root"));
                t.Triggers.Add(off);
                t.Seal();
                _radioButtonTemplate = t;
                return t;
            }

            /// <summary>A horizontal row of buttons (each CreateButton button carries its own spacing).</summary>
            public static StackPanel CreateButtonRow(params UIElement[] buttons) {
                StackPanel row = new StackPanel { Orientation = Orientation.Horizontal };
                foreach (UIElement b in buttons) row.Children.Add(b);
                return row;
            }

            /// <summary>
            /// A themed dropdown (a ComboBox styled to match the buttons). Use it like any ComboBox:
            /// Items, SelectedItem, SelectedIndex, SelectionChanged. Width null = fit the content. size: match the
            /// buttons beside it. For headers, checked choices with counts, lines and commands, fill it with
            /// AddDropdownHeader, AddDropdownChoice, AddDropdownSeparator and AddDropdownCommand instead of items.
            /// </summary>
            // clang-format off: it misaligns this wrapped parameter list
            public static ComboBox CreateDropdown(IEnumerable<string> items = null, double? width = null,
                                                  string tooltip = null, ButtonSize size = ButtonSize.Small) {
                // clang-format on
                bool      small   = size == ButtonSize.Small;
                Thickness padding = small ? new Thickness(9, 3, 26, 3) : new Thickness(10, 4, 26, 4); // right: chevron
                ComboBox  c       = new ComboBox {
                    Template            = DropdownTemplate(),
                    ItemContainerStyle  = DropdownItemStyle(),
                    Background          = Theme.ButtonBackground,
                    BorderBrush         = Theme.ButtonBorder,
                    BorderThickness     = new Thickness(1),
                    Foreground          = Theme.TextPrimary,
                    FontSize            = small ? Theme.FontSizeLabel : Theme.FontSizeValue,
                    Padding             = padding,
                    VerticalAlignment   = VerticalAlignment.Center,
                    SnapsToDevicePixels = true,
                    MaxDropDownHeight   = 320,
                };
                if (width.HasValue) c.Width = width.Value;
                SetCornerRadius(c, new CornerRadius(Theme.ButtonCornerRadius));
                if (items != null)
                    foreach (string item in items) c.Items.Add(item);
                if (tooltip != null) SetToolTip(c, tooltip);
                return c;
            }

            // Rich dropdowns: a CreateDropdown filled with these instead of plain strings. Example: Package Loader's
            // Template dropdown: "Own substeps (3)", a TEMPLATES header, the templates with their counts, a line,
            // then "New template from own substeps" and "Edit 'X'".

            /// <summary>A muted caption in a dropdown's list ("TEMPLATES"); it can't be chosen.</summary>
            public static void AddDropdownHeader(ComboBox dropdown, string caption) {
                TextBlock text = CreateCaption(caption);
                text.Margin    = new Thickness(8, 6, 8, 2);
                dropdown.Items.Add(Inert(text));
            }

            /// <summary>A line across a dropdown's list, between groups.</summary>
            public static void AddDropdownSeparator(ComboBox dropdown) {
                Border line = CreateSeparator();
                line.Margin = new Thickness(0, 4, 0, 4);
                dropdown.Items.Add(Inert(line));
            }

            /// <summary>
            /// A choice in a rich dropdown: its text (shown when chosen), a check while it's the chosen one, and count
            /// at the right, muted ("3 substeps"). tag: yours, as ComboBoxItem.Tag. Choose it with SelectedItem.
            /// icon: a 14px outline drawn before the text, in the list and in the box once chosen, stroked in
            /// iconStroke (default the text's colour). Example: Package Loader's templates, a layers icon.
            /// </summary>
            public static ComboBoxItem AddDropdownChoice(ComboBox dropdown, string text, object tag = null,
                                                         string count = null, string tooltip = null,
                                                         Geometry icon = null, Brush iconStroke = null) {
                ComboBoxItem item = new ComboBoxItem { Content = text ?? "", Tag = tag };
                item.SetValue(DropdownCountProperty, count ?? "");
                // The box shows a chosen item through its ContentTemplate (ComboBox.SelectionBoxItemTemplate).
                if (icon != null) item.ContentTemplate = IconTextTemplate(icon, iconStroke);
                item.Template = RichItemTemplate(true);
                KeepChoice(dropdown);
                if (tooltip != null) SetToolTip(item, tooltip);
                dropdown.Items.Add(item);
                return item;
            }

            /// <summary>
            /// An action in a dropdown's list ("New template from own substeps"): a click closes the list and calls
            /// onRun, and the choice stays as it was. Mouse only; the keyboard moves between choices.
            /// </summary>
            public static ComboBoxItem AddDropdownCommand(ComboBox dropdown, string text, Action onRun,
                                                          string tooltip = null) {
                ComboBoxItem item = new ComboBoxItem { Content = text ?? "", Focusable = false };
                item.SetValue(DropdownCountProperty, "");
                item.Template                  = RichItemTemplate(false);
                item.PreviewMouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled               = true; // never selected
                    dropdown.IsDropDownOpen = false;
                    if (onRun != null) onRun();
                };
                item.PreviewMouseLeftButtonDown += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled = true;
                };
                if (tooltip != null) SetToolTip(item, tooltip);
                dropdown.Items.Add(item);
                return item;
            }

            // icon, then the text it's given.
            private static DataTemplate IconTextTemplate(Geometry icon, Brush stroke) {
                FrameworkElementFactory row = new FrameworkElementFactory(typeof(StackPanel));
                row.SetValue(StackPanel.OrientationProperty, Orientation.Horizontal);
                FrameworkElementFactory path = new FrameworkElementFactory(typeof(System.Windows.Shapes.Path));
                path.SetValue(System.Windows.Shapes.Path.DataProperty, icon);
                if (stroke != null)
                    path.SetValue(System.Windows.Shapes.Shape.StrokeProperty, stroke);
                else
                    path.SetBinding(System.Windows.Shapes.Shape.StrokeProperty, new Binding("Foreground") {
                        RelativeSource = new RelativeSource(RelativeSourceMode.FindAncestor, typeof(Control), 1),
                    });
                path.SetValue(System.Windows.Shapes.Shape.StrokeThicknessProperty, 1.2);
                path.SetValue(System.Windows.Shapes.Shape.StrokeLineJoinProperty, PenLineJoin.Round);
                path.SetValue(FrameworkElement.WidthProperty, 14.0);
                path.SetValue(FrameworkElement.HeightProperty, 14.0);
                path.SetValue(FrameworkElement.MarginProperty, new Thickness(0, 0, 5, 0));
                path.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                row.AppendChild(path);
                FrameworkElementFactory text = new FrameworkElementFactory(typeof(TextBlock));
                text.SetBinding(TextBlock.TextProperty, new Binding());
                text.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                row.AppendChild(text);
                DataTemplate t = new DataTemplate { VisualTree = row };
                t.Seal();
                return t;
            }

            // A rich dropdown's choice can drop to none the first time its list opens, and its label goes with it
            // (seen in Package Loader's steps box). Only the user changes a choice, so it's put back.
            private static void KeepChoice(ComboBox dropdown) {
                if (dropdown.GetValue(KeepsChoiceProperty) != null) return;
                dropdown.SetValue(KeepsChoiceProperty, true);
                dropdown.SelectionChanged += delegate(object s, SelectionChangedEventArgs e) {
                    if (dropdown.SelectedItem != null || e.RemovedItems.Count != 1) return;
                    object last = e.RemovedItems[0];
                    if (dropdown.Items.Contains(last)) dropdown.SelectedItem = last;
                };
            }

            private static readonly DependencyProperty KeepsChoiceProperty =
                DependencyProperty.RegisterAttached("GenieKeepsChoice", typeof(object), typeof(ControlUtils));

            private static readonly DependencyProperty DropdownCountProperty =
                DependencyProperty.RegisterAttached("GenieDropdownCount", typeof(string), typeof(ControlUtils));

            // A list entry that takes no clicks or keyboard: headers and lines.
            private static ComboBoxItem Inert(UIElement content) {
                ComboBoxItem item = new ComboBoxItem {
                    Content          = content,
                    Focusable        = false,
                    IsHitTestVisible = false,
                    Template         = GenieListNote.PlainTemplate(typeof(ComboBoxItem)),
                };
                return item;
            }

            [ThreadStatic]
            private static ControlTemplate _choiceTemplate, _commandTemplate;

            // check | text | count, hover shaded as plain items are. A command keeps the check's room, unchecked.
            private static ControlTemplate RichItemTemplate(bool choice) {
                ControlTemplate cached = choice ? _choiceTemplate : _commandTemplate;
                if (cached != null) return cached;
                ControlTemplate         t  = new ControlTemplate(typeof(ComboBoxItem));
                FrameworkElementFactory bd = new FrameworkElementFactory(typeof(Border));
                bd.Name                    = "bd";
                bd.SetValue(Border.BackgroundProperty, Brushes.Transparent);
                bd.SetValue(Border.CornerRadiusProperty, new CornerRadius(3));
                bd.SetValue(Border.PaddingProperty, new Thickness(4, 4, 8, 4));
                FrameworkElementFactory row = new FrameworkElementFactory(typeof(DockPanel));

                FrameworkElementFactory check = new FrameworkElementFactory(typeof(System.Windows.Shapes.Path));
                check.Name                    = "check";
                check.SetValue(System.Windows.Shapes.Path.DataProperty, Geometry.Parse("M 1.5,5 L 4,7.5 L 8.5,2.5"));
                check.SetValue(System.Windows.Shapes.Shape.StrokeProperty, Theme.TextPrimary);
                check.SetValue(System.Windows.Shapes.Shape.StrokeThicknessProperty, 1.4);
                check.SetValue(System.Windows.Shapes.Shape.StrokeStartLineCapProperty, PenLineCap.Round);
                check.SetValue(System.Windows.Shapes.Shape.StrokeEndLineCapProperty, PenLineCap.Round);
                check.SetValue(System.Windows.Shapes.Shape.StrokeLineJoinProperty, PenLineJoin.Round);
                check.SetValue(FrameworkElement.WidthProperty, 16.0);
                check.SetValue(FrameworkElement.HeightProperty, 10.0);
                check.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                check.SetValue(UIElement.VisibilityProperty, Visibility.Hidden);
                check.SetValue(DockPanel.DockProperty, Dock.Left);
                row.AppendChild(check);

                FrameworkElementFactory count = new FrameworkElementFactory(typeof(TextBlock));
                count.SetBinding(TextBlock.TextProperty,
                                 new Binding { Path           = new PropertyPath(DropdownCountProperty),
                                               RelativeSource = RelativeSource.TemplatedParent });
                count.SetValue(TextBlock.ForegroundProperty, Theme.TextSecondary);
                count.SetValue(FrameworkElement.MarginProperty, new Thickness(12, 0, 0, 0));
                count.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                count.SetValue(DockPanel.DockProperty, Dock.Right);
                row.AppendChild(count);

                FrameworkElementFactory text = new FrameworkElementFactory(typeof(ContentPresenter));
                text.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
                row.AppendChild(text);
                bd.AppendChild(row);
                t.VisualTree = bd;

                Trigger hot = new Trigger { Property = ComboBoxItem.IsHighlightedProperty, Value = true };
                hot.Setters.Add(new Setter(Border.BackgroundProperty, Theme.NeutralTagBackground, "bd"));
                t.Triggers.Add(hot);
                Trigger over = new Trigger { Property = UIElement.IsMouseOverProperty, Value = true };
                over.Setters.Add(new Setter(Border.BackgroundProperty, Theme.NeutralTagBackground, "bd"));
                t.Triggers.Add(over);
                if (choice) {
                    Trigger sel = new Trigger { Property = ListBoxItem.IsSelectedProperty, Value = true };
                    sel.Setters.Add(new Setter(UIElement.VisibilityProperty, Visibility.Visible, "check"));
                    t.Triggers.Add(sel);
                }
                t.Seal();
                if (choice)
                    _choiceTemplate = t;
                else
                    _commandTemplate = t;
                return t;
            }

            // == Tags and Pills =======================================================================

            /// <summary>
            /// A small rounded tag after a name, such as an object's class or "Missing". size Small: compact, for
            /// rows of tags. outlined: the tone's border and text on the panel grey, lighter than a filled tag. icon:
            /// shown before the text in the text's colour (see GenieTag.Icon).
            /// </summary>
            public static GenieTag CreateTag(string text, TagTone tone = TagTone.Neutral, string tooltip = null,
                                             double? cornerRadius = null, double? fontSize = null,
                                             TagSize size = TagSize.Regular, bool outlined = false,
                                             FrameworkElement icon = null) {
                bool     small = size == TagSize.Small;
                GenieTag tag =
