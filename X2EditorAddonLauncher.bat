        // == Genie.WorkUtils ==========================================================================

        public static class WorkUtils {
            /// <summary>
            /// Run count steps on the UI thread in short slices: as many steps as fit in about 40 ms, then the
            /// window gets to draw (a spinner, a count) before the next slice. Engine calls must stay on this
            /// thread, so this is how long work stays responsive without slowing it much. step(i) does step i;
            /// onProgress(done), if given, runs after each slice; onFinished runs at the end, also after a step
            /// throws (logged), which stops the rest.
            /// </summary>
            public static void RunInSteps(int count, Action<int> step, Action<int> onProgress, Action onFinished) {
                const int  SliceMs = 40;
                Dispatcher d       = Dispatcher.CurrentDispatcher;
                int        next    = 0;
                Action     run     = null;
                run                = delegate {
                    System.Diagnostics.Stopwatch slice = System.Diagnostics.Stopwatch.StartNew();
                    try {
                        while (next < count && slice.ElapsedMilliseconds < SliceMs) {
                            step(next);
                            next++;
                        }
                    } catch (Exception ex) {
                        EngineThunks.Trace("A step failed: " + ex);
                        next = count;
                    }
                    if (next < count) {
                        if (onProgress != null) onProgress(next);
                        d.BeginInvoke(DispatcherPriority.Background, run);
                    } else {
                        if (onProgress != null) onProgress(next);
                        if (onFinished != null) onFinished();
                    }
                };
                d.BeginInvoke(DispatcherPriority.Background, run);
            }

            /// <summary>
            /// Runs work on a background thread, then onDone with its result on the UI thread. work must not touch
            /// the engine or any window: both belong to the UI thread (RunInSteps is for long engine work). If work
            /// throws, onFailed gets the exception on the UI thread; without onFailed it's logged as yours. Returns
            /// the running task, to tell whether it's finished. Example: Dependency Viewer's index of package files.
            /// </summary>
            public static Task RunInBackground<T>(Func<T> work, Action<T> onDone, Action<Exception> onFailed = null,
                                                  [CallerFilePath] string callerFile = null) {
                Dispatcher ui = GenieBootstrap.UiDispatcher;
                return Task.Factory.StartNew(delegate {
                    T         result = default(T);
                    Exception error  = null;
                    try {
                        result = work();
                    } catch (Exception ex) {
                        error = ex;
                    }
                    ui.BeginInvoke(new Action(delegate {
                        try {
                            if (error == null) {
                                if (onDone != null) onDone(result);
                            } else if (onFailed != null) {
                                onFailed(error);
                            } else {
                                Log("Background work failed: " + error.Message, callerFile);
                            }
                        } catch (Exception ex) {
                            Log("A background work handler failed: " + ex, callerFile);
                        }
                    }));
                });
            }

            /// <summary>
            /// Runs work on the UI thread once what's waiting has drawn and pending input is handled (ContextIdle).
            /// For UI-thread work that holds the thread, such as an engine load: the marks and spinners set up for
            /// it show while it runs, and a click made just before it isn't handled against a layout it then
            /// changes. Example: Package Loader's package loads.
            /// </summary>
            public static void RunAfterRender(Action work) {
                if (work == null) throw new ArgumentNullException("work");
                Dispatcher.CurrentDispatcher.BeginInvoke(work, DispatcherPriority.ContextIdle);
            }

            /// <summary>
            /// A call that runs handler once, on the UI thread after the work in progress, however many times it's
            /// called before then: one update for a burst of changes, such as Redirector Manager repairing a
            /// selection. Make it on the UI thread.
            /// The framework's own notifications are coalesced already.
            /// </summary>
            public static Action Coalesce(Action handler) {
                if (handler == null) throw new ArgumentNullException("handler");
                return new Coalescer(handler).Fire;
            }
        }

        // == Genie.ClipboardUtils =====================================================================

        public static class ClipboardUtils {
            private const uint CF_UNICODETEXT = 13;
            private const uint GMEM_MOVEABLE  = 0x0002;

            [DllImport("user32.dll", SetLastError = true)]
            private static extern bool OpenClipboard(IntPtr owner);
            [DllImport("user32.dll")]
            private static extern bool CloseClipboard();
            [DllImport("user32.dll")]
            private static extern bool EmptyClipboard();
            [DllImport("user32.dll")]
            private static extern IntPtr SetClipboardData(uint format, IntPtr data);
            [DllImport("kernel32.dll")]
            private static extern IntPtr GlobalAlloc(uint flags, UIntPtr bytes);
            [DllImport("kernel32.dll")]
            private static extern IntPtr GlobalLock(IntPtr mem);
            [DllImport("kernel32.dll")]
            private static extern bool GlobalUnlock(IntPtr mem);
            [DllImport("kernel32.dll")]
            private static extern IntPtr GlobalFree(IntPtr mem);
            [DllImport("user32.dll")]
            private static extern IntPtr GetClipboardData(uint format);
            [DllImport("user32.dll")]
            private static extern bool IsClipboardFormatAvailable(uint format);

            /// <summary>
            /// The clipboard's text, or null if it holds none. Retries briefly while another program has the
            /// clipboard open, as SetText does; null (logged) if it stays busy.
            /// </summary>
            public static string GetText() {
                if (!IsClipboardFormatAvailable(CF_UNICODETEXT)) return null;
                if (!Open()) {
                    EngineThunks.Trace("Couldn't read the clipboard: another program is holding it.");
                    return null;
                }
                try {
                    IntPtr mem = GetClipboardData(CF_UNICODETEXT);
                    if (mem == IntPtr.Zero) return null;
                    IntPtr text = GlobalLock(mem);
                    if (text == IntPtr.Zero) return null;
                    try {
                        return Marshal.PtrToStringUni(text); // up to its terminating null
                    } finally {
                        GlobalUnlock(mem);
                    }
                } finally {
                    CloseClipboard();
                }
            }

            /// <summary>
            /// Calls onChanged (UI thread, once per burst) whenever the clipboard's content changes, in any program,
            /// while owner is loaded: the owner's window listens for the system's clipboard notice, so there's no
            /// polling. Read it with GetText. Dispose to stop. Example: Package Loader's paste buttons.
            /// </summary>
            public static IDisposable WatchClipboard(FrameworkElement owner, Action onChanged) {
                if (owner == null || onChanged == null) return null;
                return new ClipboardWatch(owner, onChanged);
            }

            private static bool Open() {
                bool open = false;
                for (int attempt = 0; attempt < 10 && !(open = OpenClipboard(IntPtr.Zero)); attempt++) Thread.Sleep(20);
                return open;
            }

            /// <summary>
            /// Put text on the clipboard. Plain Win32, so it stays there after the editor closes and doesn't fail
            /// when another program (a clipboard manager, say) has the clipboard open for a moment: it retries
            /// briefly. False (logged) if the clipboard stayed busy.
            /// </summary>
            public static bool SetText(string text) {
                text = text ?? "";
                if (!Open()) {
                    EngineThunks.Trace("Couldn't copy: another program is holding the clipboard.");
                    return false;
                }
                try {
                    EmptyClipboard();
                    int    bytes = (text.Length + 1) * 2;
                    IntPtr mem   = GlobalAlloc(GMEM_MOVEABLE, new UIntPtr((uint)bytes));
                    if (mem == IntPtr.Zero) return false;
                    IntPtr dst = GlobalLock(mem);
                    Marshal.Copy(text.ToCharArray(), 0, dst, text.Length);
                    Marshal.WriteInt16(dst, text.Length * 2, 0);
                    GlobalUnlock(mem);
                    if (SetClipboardData(CF_UNICODETEXT, mem) != IntPtr.Zero) return true; // Windows owns mem now
                    GlobalFree(mem);
                    return false;
                } finally {
                    CloseClipboard();
                }
            }
        }

        // == Genie.ProcessUtils =======================================================================
        // Programs run beside the editor, never blocking it.

        public static class ProcessUtils {
            /// <summary>What RunScript runs. Only File is required.</summary>
            public sealed class ScriptRun {
                public string      File;           // a .bat or .cmd
                public string      Arguments;      // after the file, as typed at a prompt; cmd expands %VAR% in them
                public string      WorkingFolder;  // null or empty: the script's own folder
                public string      Input;          // typed in, a line per line, then input closes; null: closed at once
                public double      TimeoutSeconds; // 0: none; fractions count (2.5)
                public ExitCodeSet SuccessCodes;   // null: 0 only
                public bool        ExpandVariables; // %NAME% in a Variables value expanded as set does; else literal

                /// <summary>Added to the editor's environment, for this script only, in order.</summary>
                public List<KeyValuePair<string, string>> Variables = new List<KeyValuePair<string, string>>();
            }

            /// <summary>A line the script wrote: standard output, or standard error (IsError).</summary>
            public sealed class ProcessLine {
                public bool     IsError;
                public string   Text;
                public DateTime Time;
            }

            public sealed class ProcessResult {
                public int      ExitCode;
                public bool     IsSuccess;    // ran to its end with an exit code in SuccessCodes
                public bool     TimedOut;     // killed at its timeout
                public bool     Cancelled;    // killed by GenieProcess.Cancel
                public string   StartProblem; // why it didn't start, or null
                public TimeSpan Duration;
            }

            /// <summary>
            /// Runs a batch file through cmd /c with no window, as a double-click would but unattended. Its input is
            /// run.Input, a line per set /p, then ends, so pause and set /p return at once instead of waiting for a
            /// keyboard. Each line it writes reaches onLine as it comes, and onDone gets the outcome; both on the UI
            /// thread, lines first. A timeout or Cancel ends the script and everything it started, not just cmd. Read
            /// with the console's code page, as cmd writes. Never blocks the editor. Example: Package Loader's scripts.
            /// </summary>
            public static GenieProcess RunScript(ScriptRun run, Action<ProcessLine> onLine,
                                                 Action<ProcessResult> onDone) {
                if (run == null) throw new ArgumentNullException("run");
                GenieProcess process = new GenieProcess(run, onLine, onDone);
                process.Start();
                return process;
            }

            /// <summary>
            /// An environment variable name from text: letters, digits and _ only, never a leading digit, as cmd and
            /// most tools accept. For a box that cleans as typed (ControlUtils.FilterInput).
            /// </summary>
            public static string CleanVariableName(string text) {
                StringBuilder b = new StringBuilder();
                foreach (char c in text ?? "") {
                    bool ok = c == '_' || (c < 128 && char.IsLetterOrDigit(c));
                    if (ok && !(b.Length == 0 && char.IsDigit(c))) b.Append(c);
                }
                return b.ToString();
            }

            /// <summary>Exit-code text with only what ParseExitCodes reads: digits, commas, dashes and
            /// spaces.</summary>
            public static string CleanExitCodes(string text) {
                StringBuilder b = new StringBuilder();
                foreach (char c in text ?? "") {
                    if ((c >= '0' && c <= '9') || c == ',' || c == '-' || c == ' ') b.Append(c);
                }
                return b.ToString();
            }

            /// <summary>
            /// Exit codes from text: whole numbers and inclusive ranges, comma-separated ("0", "0-7", "0, 2").
            /// Empty: 0 only, the convention. Null, with problem saying why, if any part can't be read.
            /// </summary>
            public static ExitCodeSet ParseExitCodes(string text, out string problem) {
                problem         = null;
                ExitCodeSet set = new ExitCodeSet();
                if (string.IsNullOrEmpty(text) || text.Trim().Length == 0) return ExitCodeSet.Zero;
                foreach (string raw in text.Split(',')) {
                    string part = raw.Trim();
                    if (part.Length == 0) {
                        problem = "There\u2019s an empty item between commas.";
                        return null;
                    }
                    System.Text.RegularExpressions.Match m =
                        System.Text.RegularExpressions.Regex.Match(part, @"^(-?\d+)(?:\s*-\s*(-?\d+))?$");
                    int from, to;
                    if (!m.Success || !int.TryParse(m.Groups[1].Value, out from) ||
                        !int.TryParse(m.Groups[2].Success ? m.Groups[2].Value : m.Groups[1].Value, out to) ||
                        to < from) {
                        problem = "\u2018" + part + "\u2019 isn\u2019t a whole number or a range such as 0-7.";
                        return null;
                    }
                    set.Add(from, to);
                }
                return set;
            }
        }

        // == Genie.FileUtils ==========================================================================

        public static class FileUtils {
            /// <summary>
            /// Calls onChanged on the calling (UI) thread when anything under the folder is created, changed,
            /// renamed or deleted. A burst of changes (an editor saving in steps) gives one call, once the
            /// folder has been quiet for a moment. Null if the folder doesn't exist. Dispose to stop.
            /// </summary>
            public static IDisposable WatchFolder(string folder, Action onChanged) {
                if (onChanged == null || string.IsNullOrEmpty(folder) || !Directory.Exists(folder)) return null;
                try {
                    return new FolderWatch(folder, onChanged);
                } catch (Exception ex) {
                    GenieBootstrap.Log("Couldn't watch " + folder + ": " + ex.Message);
                    return null;
                }
            }

            /// <summary>
            /// Opens the folder in File Explorer. False (logged) if it's missing and create is off, or if it couldn't
            /// be created or Explorer couldn't start. create: make a missing folder first.
            /// </summary>
            public static bool OpenFolder(string folder, bool create = false) {
                try {
                    // Explorer quietly opens Documents for a path that doesn't exist, so check first.
                    if (string.IsNullOrEmpty(folder)) {
                        GenieBootstrap.Log("Can't open a folder: no path given.");
                        return false;
                    }
                    if (create) {
                        Directory.CreateDirectory(folder);
                    } else if (!Directory.Exists(folder)) {
                        GenieBootstrap.Log("Can't open " + folder + ": it doesn't exist.");
                        return false;
                    }
                    System.Diagnostics.Process.Start("explorer.exe", "\"" + folder + "\"");
                    return true;
                } catch (Exception ex) {
                    GenieBootstrap.Log("Couldn't open " + folder + ": " + ex.Message);
                    return false;
                }
            }

            /// <summary>
            /// Deletes all but the newest count files in folder matching pattern ("*.log"), newest by last write.
            /// For one file per session, kept for so many sessions. Returns how many it deleted; one it can't delete
            /// is logged and skipped. Nothing if the folder doesn't exist. Example: Package Loader's run logs.
            /// </summary>
            public static int KeepNewest(string folder, string pattern, int count) {
                if (string.IsNullOrEmpty(folder) || !Directory.Exists(folder)) return 0;
                FileInfo[] files;
                try {
                    files = new DirectoryInfo(folder).GetFiles(pattern, SearchOption.TopDirectoryOnly);
                } catch (Exception ex) {
                    GenieBootstrap.Log("Couldn't list " + folder + ": " + ex.Message);
                    return 0;
                }
                Array.Sort(files, (x, y) => y.LastWriteTimeUtc.CompareTo(x.LastWriteTimeUtc));
                int deleted = 0;
                for (int i = Math.Max(0, count); i < files.Length; i++) {
                    try {
                        files[i].Delete();
                        deleted++;
                    } catch (Exception ex) {
                        GenieBootstrap.Log("Couldn't delete " + files[i].FullName + ": " + ex.Message);
                    }
                }
                return deleted;
            }

            // == Paths ================================================================================
            // These compare strings only: nothing has to exist. Case, '/' or '\', a trailing '\' and relative parts
            // ("..") don't matter. A relative path is taken from the editor's current folder.

            /// <summary>
            /// The name made usable as a file or folder name: each character Windows forbids becomes
            /// swapForbiddenWith; trailing spaces and dots, which Windows would drop, are removed; a device name
            /// Windows reserves ("CON", "nul.txt") gets a leading "_". Never empty: "_" if nothing is left.
            /// </summary>
            public static string ToSafeFileName(string name, char swapForbiddenWith = '_') {
                if (IsForbiddenInFileName(swapForbiddenWith))
                    throw new ArgumentException("'" + swapForbiddenWith + "' isn't allowed in file names either.",
                                                "swapForbiddenWith");
                StringBuilder safe = new StringBuilder();
                foreach (char c in name ?? "") safe.Append(IsForbiddenInFileName(c) ? swapForbiddenWith : c);
                string result = safe.ToString().TrimEnd(' ', '.');
                if (result.Length == 0) return "_";

                // Reserved with any extension, and with spaces before it: "CON", "con.txt", "COM1 .log".
                int    dot  = result.IndexOf('.');
                string stem = (dot >= 0 ? result.Substring(0, dot) : result).TrimEnd(' ');
                if (Array.IndexOf(ReservedDeviceNames, stem.ToUpperInvariant()) >= 0) result = "_" + result;
                return result;
            }

            /// <summary>
            /// True for a character Windows won't allow in a file or folder name: \ / : * ? " &lt; &gt; | and control
            /// characters. A path's separators count, so check names, not paths.
            /// </summary>
            public static bool IsForbiddenInFileName(char c) {
                return Array.IndexOf(ForbiddenFileNameChars, c) >= 0;
            }

            // GetInvalidFileNameChars returns a new array on every call.
            private static readonly char[] ForbiddenFileNameChars = Path.GetInvalidFileNameChars();

            private static readonly string[] ReservedDeviceNames = {
                "CON",  "PRN",  "AUX",  "NUL",  "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7",
                "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9",
            };

            /// <summary>The absolute path, or null if path is empty or malformed. Never throws.</summary>
            public static string GetFullPath(string path) {
                if (string.IsNullOrEmpty(path)) return null;
                try {
                    return Path.GetFullPath(path);
                } catch (Exception) {
                    return null;
                }
            }

            /// <summary>
            /// Writes text to the file as UTF-8 without a BOM, making its folder first; append: adds to its end. Null
            /// if it worked, else why not, for your own log line: what a failure means differs by file. Never throws.
            /// </summary>
            public static string TryWriteText(string file, string text, bool append = false) {
                try {
                    Directory.CreateDirectory(Path.GetDirectoryName(file));
                    if (append)
                        File.AppendAllText(file, text ?? "", Utf8NoBom);
                    else
                        File.WriteAllText(file, text ?? "", Utf8NoBom);
                    return null;
                } catch (Exception ex) {
                    return ex.Message;
                }
            }

            private static readonly UTF8Encoding Utf8NoBom = new UTF8Encoding(false);

            /// <summary>
            /// The path if nothing is there, else the first of "name (2).ext", "name (3).ext" and on that's free.
            /// Example: Package Loader's log file for a second launch in the same minute.
            /// </summary>
            public static string GetFreePath(string path) {
                string folder = Path.GetDirectoryName(path), stem = Path.GetFileNameWithoutExtension(path),
                       ext = Path.GetExtension(path), free = path;
                for (int n = 2; File.Exists(free) || Directory.Exists(free); n++)
                    free = Path.Combine(folder, stem + " (" + n + ")" + ext);
                return free;
            }

            /// <summary>True if both name the same file or folder. Empty or malformed matches nothing.</summary>
            public static bool IsSamePath(string a, string b) {
                string fullA = Normalized(a), fullB = Normalized(b);
                return fullA != null && fullB != null &&
                       string.Equals(fullA, fullB, StringComparison.OrdinalIgnoreCase);
            }

            /// <summary>True if path is inside folder, at any depth. A folder isn't inside itself.</summary>
            public static bool IsUnder(string path, string folder) {
                return GetRelativePath(path, folder) != null;
            }

            /// <summary>
            /// path from inside folder ("Sub\File.swf"), or null if it isn't inside. Unlike Path.GetRelativePath in
            /// later .NET, never climbs out with "..\".
            /// </summary>
            public static string GetRelativePath(string path, string folder) {
                string fullPath = Normalized(path), fullFolder = Normalized(folder);
                if (fullPath == null || fullFolder == null) return null;
                fullFolder += "\\"; // so "Mods" doesn't contain "ModsOld"
                if (fullPath.Length <= fullFolder.Length ||
                    !fullPath.StartsWith(fullFolder, StringComparison.OrdinalIgnoreCase))
                    return null;
                return fullPath.Substring(fullFolder.Length);
            }

            /// <summary>
            /// The file's folder for display: the drive and its last keep folders, "C:\...\Mod\Repo\Lib". Whole
            /// if that hides no more than one folder.
            /// </summary>
            public static string ShortFolder(string file, int keep = 3) {
                string   folder = Path.GetDirectoryName(file) ?? "";
                string[] parts  = folder.Split('\\');
                if (parts.Length <= keep + 2) return folder;
                string[] last = new string[keep];
                Array.Copy(parts, parts.Length - keep, last, 0, keep);
                return parts[0] + "\\...\\" + string.Join("\\", last);
            }

            // Full, without a trailing '\' ("C:\" becomes "C:").
            private static string Normalized(string path) {
                string full = GetFullPath(path);
                return full == null ? null : full.TrimEnd('\\');
            }

            /// <summary>
            /// Opens the file's folder in File Explorer with the file selected. False (logged) if the file is missing
            /// or Explorer couldn't start.
            /// </summary>
            public static bool ShowInExplorer(string file) {
                try {
                    // Explorer quietly opens Documents for a path that doesn't exist, so check first.
                    if (string.IsNullOrEmpty(file)) {
                        GenieBootstrap.Log("Can't show a file in File Explorer: no path given.");
                        return false;
                    }
                    if (!File.Exists(file)) {
                        GenieBootstrap.Log("Can't show " + file + " in File Explorer: it doesn't exist.");
                        return false;
                    }
                    System.Diagnostics.Process.Start("explorer.exe", "/select,\"" + Path.GetFullPath(file) + "\"");
                    return true;
                } catch (Exception ex) {
                    GenieBootstrap.Log("Couldn't show " + file + " in File Explorer: " + ex.Message);
                    return false;
                }
            }

            /// <summary>True if both hold the same bytes. Null matches nothing, not even null.</summary>
            public static bool IsSameContent(byte[] a, byte[] b) {
                if (a == null || b == null || a.Length != b.Length) return false;
                for (int i = 0; i < a.Length; i++) {
                    if (a[i] != b[i]) return false;
                }
                return true;
            }

            /// <summary>True if the file exists and holds exactly these bytes. False if it can't be read.</summary>
            public static bool IsSameContent(string file, byte[] bytes) {
                if (bytes == null || string.IsNullOrEmpty(file)) return false;
                try {
                    return new FileInfo(file).Length == bytes.Length && IsSameContent(File.ReadAllBytes(file), bytes);
                } catch {
                    return false; // missing, or locked mid-save by another program
                }
            }

            /// <summary>True if both files exist and hold the same bytes. False if either can't be read.</summary>
            public static bool IsSameContent(string fileA, string fileB) {
                if (string.IsNullOrEmpty(fileA) || string.IsNullOrEmpty(fileB)) return false;
                try {
                    if (new FileInfo(fileA).Length != new FileInfo(fileB).Length) return false; // skips reading
                    return IsSameContent(File.ReadAllBytes(fileA), File.ReadAllBytes(fileB));
                } catch {
                    return false;
                }
            }
        }

        // == Genie.WindowUtils ========================================================================

        public static class WindowUtils {
            private delegate bool EnumWindowsProc(IntPtr h, IntPtr p);

            [DllImport("user32.dll")]
            private static extern bool EnumWindows(EnumWindowsProc cb, IntPtr p);
            [DllImport("user32.dll")]
            private static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
            [DllImport("user32.dll")]
            private static extern bool IsWindowVisible(IntPtr h);
            [DllImport("user32.dll")]
            private static extern IntPtr GetMenu(IntPtr h);
            [DllImport("user32.dll")]
            private static extern IntPtr GetWindow(IntPtr h, uint cmd);
            [DllImport("user32.dll", CharSet = CharSet.Unicode)]
            private static extern int GetWindowTextW(IntPtr h, StringBuilder s, int max);

            private const uint GW_OWNER = 4;

            /// <summary>
            /// A popup window owned by the editor: stays above it, closes cleanly and never affects the
            /// editor's WPF Application. Call on the editor UI thread. Size is in DIPs. Each window is
            /// single-use; GenieWindowSlot handles "create, or bring the open one to the front".
            /// Use this, never System.Windows.Window.
            /// </summary>
            /// <param name="settingsKey">Names the window in your settings file, for remembered position
            /// and size. Defaults to the title; pass one if your title changes.</param>
            /// <param name="callerFile">Leave out: the compiler fills it in, and it identifies your addon.</param>
            public static GenieWindow CreateWindow(string title, double width, double height, string settingsKey = null,
                                                   [CallerFilePath] string callerFile = null) {
                Assembly caller = AddonRegistry.AssemblyOf(callerFile);
                return new GenieWindow(title, width, height, AddonRegistry.ConfigFor(caller), settingsKey,
                                       AddonRegistry.AddonFor(caller));
            }

            /// <summary>
            /// A frameless window drawn as a rounded pill (corner radius half its height), dragged by any part of it no
            /// control takes, owned by the editor and spawned the same way as CreateWindow's. It has no addon info and
            /// no resize border; ResizeTo and CornerRadius change its shape. Example: Package Loader's launcher and
            /// running pill, 420x52, which expands into the running window.
            /// </summary>
            public static GenieWindow CreatePillWindow(string title, double width, double height,
                                                       string                  settingsKey = null,
                                                       [CallerFilePath] string callerFile  = null) {
                Assembly caller = AddonRegistry.AssemblyOf(callerFile);
                return new GenieWindow(title, width, height, AddonRegistry.ConfigFor(caller), settingsKey,
                                       AddonRegistry.AddonFor(caller), true);
            }

            /// <summary>
            /// CreatePillWindow's window on a UI thread of its own, so it keeps drawing and taking clicks while the
            /// editor's thread is busy, as during a package load. Call from the editor's thread. build gets the window
            /// on the new thread: fill it there, and it shows without taking the foreground. Everything in it belongs
            /// to that thread, and that thread must never touch the engine, the editor's windows or ConfigUtils, nor
            /// wait on the editor's: hand it finished data, and send clicks back with Genie.Dispatcher.BeginInvoke.
            /// It stays over the editor and under other apps, though the editor doesn't own it. An error in it is
            /// reported as any addon error, and closes it. Example: Package Loader's running pill.
            /// </summary>
            public static void ShowPillOnOwnThread(string title, double width, double height, Action<GenieWindow> build,
                                                   string                  settingsKey = null,
                                                   [CallerFilePath] string callerFile  = null) {
                if (build == null) throw new ArgumentNullException("build");
                Assembly caller = AddonRegistry.AssemblyOf(callerFile);
                GenieWindow.ShowOnOwnThread(title, width, height, AddonRegistry.ConfigFor(caller), settingsKey,
                                            AddonRegistry.AddonFor(caller), build);
            }

            /// <summary>
            /// Windows' folder picker, modal to the window that contains `within`. Returns the chosen
            /// folder, or null if cancelled. initialFolder: where it opens (null: Windows decides).
            /// </summary>
            public static string PickFolder(Visual within, string title, string initialFolder = null) {
                return Pick(within, title, initialFolder, true, null, null);
            }

            /// <summary>
            /// Windows' file picker, modal to the window that contains `within`. Returns the chosen file, or null
            /// if cancelled. filterName and patterns describe what it lists ("Movies", "*.swf;*.gfx").
            /// </summary>
            public static string PickFile(Visual within, string title, string filterName, string patterns,
                                          string initialFolder = null) {
                return Pick(within, title, initialFolder, false, filterName, patterns);
            }

            /// <summary>PickFile, choosing any number of files. Empty if cancelled.</summary>
            public static string[] PickFiles(Visual within, string title, string filterName, string patterns,
                                             string initialFolder = null) {
                return PickAll(within, title, initialFolder, false, filterName, patterns, true);
            }

            private static string Pick(Visual within, string title, string initialFolder, bool folders,
                                       string filterName, string patterns) {
                string[] picked = PickAll(within, title, initialFolder, folders, filterName, patterns, false);
                return picked.Length > 0 ? picked[0] : null;
            }

            private static string[] PickAll(Visual within, string title, string initialFolder, bool folders,
                                            string filterName, string patterns, bool many) {
                IntPtr owner = IntPtr.Zero;
                try {
                    System.Windows.Interop.HwndSource src =
                        (within == null) ? null
                                         : PresentationSource.FromVisual(within) as System.Windows.Interop.HwndSource;
                    if (src != null) owner = src.Handle;
                } catch {}
                FolderPicker.IFileDialog dlg  = null;
                IntPtr                   spec = IntPtr.Zero, specName = IntPtr.Zero, specPattern = IntPtr.Zero;
                try {
                    dlg = (FolderPicker.IFileDialog) new FolderPicker.FileOpenDialog();
                    uint options;
                    dlg.GetOptions(out options);
                    dlg.SetOptions(options | FolderPicker.FOS_FORCEFILESYSTEM |
                                   (folders ? FolderPicker.FOS_PICKFOLDERS : 0) |
                                   (many ? FolderPicker.FOS_MULTISELECT : 0));
                    if (!string.IsNullOrEmpty(title)) dlg.SetTitle(title);
                    if (!folders && !string.IsNullOrEmpty(patterns)) {
                        // One COMDLG_FILTERSPEC: { name, patterns }, both LPCWSTR.
                        specName    = Marshal.StringToHGlobalUni(filterName ?? patterns);
                        specPattern = Marshal.StringToHGlobalUni(patterns);
                        spec        = Marshal.AllocHGlobal(2 * IntPtr.Size);
                        Marshal.WriteIntPtr(spec, 0, specName);
                        Marshal.WriteIntPtr(spec, IntPtr.Size, specPattern);
                        dlg.SetFileTypes(1, spec);
                    }
                    if (!string.IsNullOrEmpty(initialFolder) && Directory.Exists(initialFolder)) {
                        FolderPicker.IShellItem start;
                        Guid                    iid = typeof(FolderPicker.IShellItem).GUID;
                        int                     hr =
                            FolderPicker.SHCreateItemFromParsingName(initialFolder, IntPtr.Zero, ref iid, out start);
                        if (hr == 0) dlg.SetFolder(start);
                    }
                    if (dlg.Show(owner) != 0) return new string[0]; // cancelled (or failed)
                    string path;
                    if (!many) {
                        FolderPicker.IShellItem result;
                        dlg.GetResult(out result);
                        result.GetDisplayName(FolderPicker.SIGDN_FILESYSPATH, out path);
                        return new[] { path };
                    }
                    FolderPicker.IShellItemArray results;
                    ((FolderPicker.IFileOpenDialog)dlg).GetResults(out results);
                    uint count;
                    results.GetCount(out count);
                    string[] paths = new string[count];
                    for (uint i = 0; i < count; i++) {
                        FolderPicker.IShellItem item;
                        results.GetItemAt(i, out item);
                        item.GetDisplayName(FolderPicker.SIGDN_FILESYSPATH, out path);
                        paths[i] = path;
                    }
                    return paths;
                } catch (Exception ex) {
                    GenieBootstrap.Log((folders ? "folder" : "file") + " picker failed: " + ex.Message);
                    return new string[0];
                } finally {
                    if (dlg != null) Marshal.ReleaseComObject(dlg);
                    if (spec != IntPtr.Zero) Marshal.FreeHGlobal(spec);
                    if (specName != IntPtr.Zero) Marshal.FreeHGlobal(specName);
                    if (specPattern != IntPtr.Zero) Marshal.FreeHGlobal(specPattern);
                }
            }

            /// <summary>
            /// The editor's main frame: this process's visible window with a menu bar and no owner, preferring a
            /// titled one. Floating editor windows (a floating Content Browser, Actor Classes) have menu bars too,
            /// but the frame owns them: without the owner test, whichever was in front was taken, and windows owned
            /// by it died with it. The launcher tells them apart the same way (EditorWindows.Find).
            /// </summary>
            public static IntPtr FindEditorFrame() {
                uint            me     = (uint)System.Diagnostics.Process.GetCurrentProcess().Id;
                IntPtr          titled = IntPtr.Zero, anyMenu = IntPtr.Zero;
                EnumWindowsProc cb = delegate(IntPtr h, IntPtr p) {
                    uint pid;
                    GetWindowThreadProcessId(h, out pid);
                    if (pid == me && IsWindowVisible(h) && GetMenu(h) != IntPtr.Zero &&
                        GetWindow(h, GW_OWNER) == IntPtr.Zero) {
                        if (anyMenu == IntPtr.Zero) anyMenu = h;
                        StringBuilder sb = new StringBuilder(256);
                        GetWindowTextW(h, sb, 256);
                        if (titled == IntPtr.Zero && sb.Length > 0) {
                            titled = h;
                            return false;
                        }
                    }
                    return true;
                };
                EnumWindows(cb, IntPtr.Zero);
                GC.KeepAlive(cb); // the callback must outlive the native call
                return titled != IntPtr.Zero ? titled : anyMenu;
            }
        }

        // == Genie.ConfigUtils ========================================================================
        // Addons\Config\<Addon Name>.ini, one file per addon: an addon can never edit another's settings, and
        // deleting a file resets just that addon. Values live under [Settings] unless you name a section.
        // callerFile: leave out. The compiler fills it in, and it identifies your addon, as for Genie.Log.
        // Before Initialize there's no settings file yet: reads return defaults and writes are dropped.

        public static class ConfigUtils {
            internal const string DefaultSection = "Settings";

            public static string Get(string key, string defaultValue, string section = null,
                                     [CallerFilePath] string callerFile = null) {
                return Read(callerFile, section, key) ?? defaultValue;
            }

            public static int GetInt(string key, int defaultValue, string section = null,
                                     [CallerFilePath] string callerFile = null) {
                int    r;
                string v = Read(callerFile, section, key);
                return (v != null && int.TryParse(v, out r)) ? r : defaultValue;
            }

            public static bool GetBool(string key, bool defaultValue, string section = null,
                                       [CallerFilePath] string callerFile = null) {
                bool   r;
                string v = Read(callerFile, section, key);
                return (v != null && bool.TryParse(v, out r)) ? r : defaultValue;
            }

            public static void Set(string key, string value, string section = null,
                                   [CallerFilePath] string callerFile = null) {
                Write(callerFile, section, key, value ?? "");
            }

            public static void SetInt(string key, int value, string section = null,
                                      [CallerFilePath] string callerFile = null) {
                Write(callerFile, section, key, value.ToString());
            }

            public static void SetBool(string key, bool value, string section = null,
                                       [CallerFilePath] string callerFile = null) {
                Write(callerFile, section, key, value ? "true" : "false");
            }

            /// <summary>
            /// A choice saved by its name (SetEnum), so reordering the enum can't change what was saved. A name it
            /// no longer has, or a number, gives defaultValue.
            /// </summary>
            public static T GetEnum<T>(string key, T defaultValue, string section = null,
                                       [CallerFilePath] string callerFile = null) where T : struct {
                return ParseEnum(Read(callerFile, section, key), defaultValue);
            }

            public static void SetEnum<T>(string key, T value, string section = null,
                                          [CallerFilePath] string callerFile = null) where T : struct {
                Write(callerFile, section, key, value.ToString());
            }

            internal static T ParseEnum<T>(string value, T defaultValue) where T : struct {
                T parsed;
                if (value == null || !Enum.TryParse(value, true, out parsed)) return defaultValue;
                return Enum.IsDefined(typeof(T), parsed) ? parsed : defaultValue; // TryParse takes "3" too
            }

            /// <summary>
            /// A list setting, or an empty list if it isn't set. Stored as JoinFields stores fields, so any text
            /// round-trips. Items are trimmed; empty ones are dropped.
            /// </summary>
            public static List<string> GetList(string key, string section = null,
                                               [CallerFilePath] string callerFile = null) {
                return ParseList(Read(callerFile, section, key));
            }

            internal static List<string> ParseList(string value) {
                List<string> items = new List<string>();
                foreach (string field in SplitFields(value)) {
                    string text = field.Trim();
                    if (text.Length > 0) items.Add(text);
                }
                return items;
            }

            /// <summary>Stores items as a list setting (see GetList). No items removes the setting.</summary>
            public static void SetList(string key, IEnumerable<string> items, string section = null,
                                       [CallerFilePath] string callerFile = null) {
                List<string> kept = new List<string>();
                foreach (string item in items ?? new string[0]) {
                    if (item != null && item.Trim().Length > 0) kept.Add(item);
                }
                if (kept.Count == 0)
                    Remove(key, section, callerFile);
                else
                    Write(callerFile, section, key, JoinFields(kept.ToArray()));
            }

            /// <summary>
            /// Fields as one setting value, "|" between them, empty ones kept: a record that a list setting would
            /// trim and thin out. In a field, ListEscape ('^') makes the next character literal ("^|", "^^"), and
            /// "^n" and "^r" stand for line breaks, which a value can't hold. Example: Package Loader's step lines.
            /// </summary>
            public static string JoinFields(params string[] fields) {
                StringBuilder b = new StringBuilder();
                for (int i = 0; i < fields.Length; i++) {
                    if (i > 0) b.Append(ListSeparator);
                    foreach (char c in fields[i] ?? "") {
                        if (c == ListEscape || c == ListSeparator)
                            b.Append(ListEscape).Append(c);
                        else if (c == '\n')
                            b.Append(ListEscape).Append('n');
                        else if (c == '\r')
                            b.Append(ListEscape).Append('r');
                        else
                            b.Append(c);
                    }
                }
                return b.ToString();
            }

            /// <summary>The fields JoinFields joined, as given. Null or empty: one empty field.</summary>
            public static List<string> SplitFields(string value) {
                List<string>  fields = new List<string>();
                StringBuilder field  = new StringBuilder();
                value                = value ?? "";
                for (int i = 0; i < value.Length; i++) {
                    char c = value[i];
                    if (c == ListEscape && i + 1 < value.Length) { // a "^" at the very end is itself
                        char n = value[++i];
                        field.Append(n == 'n' ? '\n' : n == 'r' ? '\r' : n);
                    } else if (c == ListSeparator) {
                        fields.Add(field.ToString());
                        field.Length = 0;
                    } else {
                        field.Append(c);
                    }
                }
                fields.Add(field.ToString());
                return fields;
            }

            /// <summary>
            /// An on/off setting under key, for showing in several places at once (GenieToggle). Make it in Initialize
            /// or later. Asking again for the same key gives the same toggle.
            /// </summary>
            public static GenieToggle CreateToggle(string key, bool defaultValue, string section = null,
                                                   [CallerFilePath] string callerFile = null) {
                return GenieToggle.For(AddonRegistry.AssemblyOf(callerFile), key, defaultValue,
                                       section ?? DefaultSection);
            }

            /// <summary>
            /// In a list or fields value (GetList, JoinFields): what splits items, and what makes a character literal.
            /// </summary>
            public const char ListSeparator = '|', ListEscape = '^';

            /// <summary>Deletes a setting, so Get returns its default again. Nothing happens if it isn't set.</summary>
            public static void Remove(string key, string section = null, [CallerFilePath] string callerFile = null) {
                IniFile config = For(callerFile);
                if (config != null) config.Remove(section ?? DefaultSection, key);
            }

            // == Sections ==============================================================================
            // For settings that come and go as a group, one section per item: a job and its steps, say. Values are
            // single lines, trimmed when read back, as for every setting: JoinFields escapes line breaks.

            /// <summary>
            /// Sections in your settings file, in file order, whose names start with prefix (all if null). Includes
            /// sections the framework keeps there for your windows ("Window: ...").
            /// </summary>
            public static List<string> GetSections(string prefix = null, [CallerFilePath] string callerFile = null) {
                List<string> found  = new List<string>();
                IniFile      config = For(callerFile);
                if (config == null) return found;
                foreach (string name in config.SectionNames()) {
                    if (prefix == null || name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) found.Add(name);
                }
                return found;
            }

            /// <summary>A section's keys and values in file order; empty if there's no such section.</summary>
            public static KeyValuePair<string, string>[] GetSection(string                  name,
                                                                    [CallerFilePath] string callerFile = null) {
                IniFile                            config  = For(callerFile);
                List<KeyValuePair<string, string>> entries = config == null ? null : config.GetSection(name);
                return entries == null ? new KeyValuePair<string, string>[0] : entries.ToArray();
            }

            /// <summary>
            /// Replaces a section's keys and values with these, in this order, written in one save: Set writes the
            /// file on every call. A key given twice keeps its last value.
            /// </summary>
            public static void SetSection(string section, IEnumerable<KeyValuePair<string, string>> entries,
                                          [CallerFilePath] string callerFile = null) {
                IniFile config = For(callerFile);
                if (config != null && !string.IsNullOrEmpty(section))
                    config.SetSection(section, entries ?? new KeyValuePair<string, string>[0]);
            }

            /// <summary>Deletes a whole section. Nothing happens if it isn't there.</summary>
            public static void RemoveSection(string section, [CallerFilePath] string callerFile = null) {
                IniFile config = For(callerFile);
                if (config != null && !string.IsNullOrEmpty(section)) config.RemoveSection(section);
            }

            // == Ini Text ==============================================================================
            // Settings as the file holds them, for text outside it: a section copied to the clipboard and pasted back,
            // say. Read and written by the file's own rules, so the two can't drift apart. Example: Package Loader's
            // copy and paste.

            /// <summary>
            /// The text's lines as the settings file reads them, numbered, blank lines and ; or # comments left out.
            /// A line that's neither a [section] nor Key=Value is kept, so you can say where the text goes wrong.
            /// </summary>
            public static List<GenieIniLine> ParseIniText(string text) {
                List<GenieIniLine> lines = new List<GenieIniLine>();
                string[] raw             = (text ?? "").Split('\n');
                for (int i = 0; i < raw.Length; i++) {
                    GenieIniLine line = GenieIniLine.Read(raw[i], i + 1);
                    if (line != null) lines.Add(line);
                }
                return lines;
            }

            /// <summary>
            /// Entries as the settings file writes them, a line each with line breaks after, under a [section] line
            /// unless section is null.
            /// </summary>
            public static string ToIniText(string section, IEnumerable<KeyValuePair<string, string>> entries) {
                StringBuilder b = new StringBuilder();
                if (section != null) b.Append(GenieIniLine.SectionText(section)).Append("\r\n");
                foreach (KeyValuePair<string, string> e in entries ?? new KeyValuePair<string, string>[0])
                    b.Append(GenieIniLine.SettingText(e.Key, e.Value)).Append("\r\n");
                return b.ToString();
            }

            // == Settings Backups ========================================================================
            // Copies of your settings file, one per editor launch, in Data\<Addon>\SettingsBackups.zip. How many are
            // kept is a setting the framework keeps in your file; the restore panel's footer and your gear's
            // AddBackupItem show it. Example: Package Loader, whose jobs live in its settings.

            /// <summary>
            /// Call once, in Initialize: copies your settings file into the backups as this launch's, then deletes the
            /// oldest past the number kept (defaultKeep until the user sets it). Nothing is copied before your first
            /// save.
            /// </summary>
            public static void BackUpSettings(int defaultKeep = 300, [CallerFilePath] string callerFile = null) {
                Assembly owner = AddonRegistry.AssemblyOf(callerFile);
                SettingsBackups.BackUpLaunch(owner, AddonRegistry.ConfigFor(owner), defaultKeep);
            }

            /// <summary>Your settings backups, newest first. Empty if there are none or they can't be read.</summary>
            public static List<GenieSettingsBackup> GetSettingsBackups([CallerFilePath] string callerFile = null) {
                return SettingsBackups.List(AddonRegistry.AssemblyOf(callerFile));
            }

            /// <summary>
            /// A backup's settings, read with the same getters as your live ones. Null if it can't be read (logged).
            /// </summary>
            public static GenieSettingsSnapshot ReadSettingsBackup(GenieSettingsBackup backup) {
                return backup == null ? null : SettingsBackups.Read(backup);
            }

            /// <summary>Your settings as they are now, kept as they are: later changes don't reach it.</summary>
            public static GenieSettingsSnapshot GetSettingsSnapshot([CallerFilePath] string callerFile = null) {
                return GenieSettingsSnapshot.Of(AddonRegistry.ConfigFor(AddonRegistry.AssemblyOf(callerFile)));
            }

            /// <summary>
            /// Replaces your settings with a backup's, after backing up the ones now (returned: restoring it undoes
            /// this). Keys the framework keeps for itself, such as window positions, keep their current values. Your
            /// GenieToggles raise Changed for what changed; reload the rest yourself. Throws IOException, saying why,
            /// if either step fails: nothing has changed then.
            /// </summary>
            public static GenieSettingsBackup RestoreSettingsBackup(GenieSettingsBackup backup) {
                if (backup == null) throw new ArgumentNullException("backup");
                return SettingsBackups.Restore(backup);
            }

            /// <summary>The zip your backups are in, which may not exist yet. Null before Initialize.</summary>
            public static string GetSettingsBackupFile([CallerFilePath] string callerFile = null) {
                return SettingsBackups.ZipPath(AddonRegistry.AssemblyOf(callerFile));
            }

            /// <summary>
            /// Full path of your addon's settings file (it may not exist until the first Set). Null before Initialize.
            /// </summary>
            public static string GetFilePath([CallerFilePath] string callerFile = null) {
                IniFile config = For(callerFile);
                return (config != null) ? config.FilePath : null;
            }

            private static string Read(string callerFile, string section, string key) {
                IniFile config = For(callerFile);
                return (config != null) ? config.Get(section ?? DefaultSection, key) : null;
            }

            private static void Write(string callerFile, string section, string key, string value) {
                IniFile config = For(callerFile);
                if (config != null) config.Set(section ?? DefaultSection, key, value);
            }

            // Null before the addon registers; see AddonRegistry.ConfigFor.
            private static IniFile For(string callerFile) {
                return AddonRegistry.ConfigFor(AddonRegistry.AssemblyOf(callerFile));
            }
        }
    }

    /// <summary>
    /// A set of exit codes, from ProcessUtils.ParseExitCodes. ToString gives it back in that form ("0, 2-5").
    /// </summary>
    public sealed class ExitCodeSet {
        /// <summary>0 only: success by convention.</summary>
        public static readonly ExitCodeSet Zero = new ExitCodeSet(0, 0);

        private readonly List<int[]> _ranges = new List<int[]>(); // inclusive [from, to], in the order given

        internal ExitCodeSet() {}

        private ExitCodeSet(int from, int to) {
            Add(from, to);
        }

        internal void Add(int from, int to) {
            _ranges.Add(new[] { from, to });
        }

        public bool Contains(int code) {
            return _ranges.Exists(r => code >= r[0] && code <= r[1]);
        }

        public override string ToString() {
            List<string> parts = new List<string>();
            foreach (int[] r in _ranges) parts.Add(r[0] == r[1] ? r[0].ToString() : r[0] + "-" + r[1]);
            return string.Join(", ", parts.ToArray());
        }
    }

    /// <summary>
    /// A script started by ProcessUtils.RunScript. Cancel ends it, and everything it started, early.
    /// </summary>
    public sealed class GenieProcess {
        [DllImport("kernel32.dll")]
        private static extern uint GetOEMCP();
        [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
        private static extern IntPtr CreateJobObject(IntPtr attributes, string name);
        [DllImport("kernel32.dll", SetLastError = true)]
        private static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
        [DllImport("kernel32.dll")]
        private static extern bool TerminateJobObject(IntPtr job, uint exitCode);
        [DllImport("kernel32.dll")]
        private static extern bool CloseHandle(IntPtr handle);

        private const int OutputGraceMs = 2000; // after exit, for the last lines; see OnExited

        private static bool _reportedNoJob;

        private readonly Genie.ProcessUtils.ScriptRun _run;
        private readonly Action<Genie.ProcessUtils.ProcessLine> _onLine;
        private readonly Action<Genie.ProcessUtils.ProcessResult> _onDone;

        private readonly Dispatcher       _ui                = GenieBootstrap.UiDispatcher;
        private readonly ManualResetEvent _outputEnded       = new ManualResetEvent(false);
        private readonly ManualResetEvent _errorEnded        = new ManualResetEvent(false);
        private readonly System.Diagnostics.Stopwatch _clock = new System.Diagnostics.Stopwatch();

        private readonly object            _jobLock = new object(); // Kill on a timer thread vs. Finish
        private System.Diagnostics.Process _process;
        private string                     _inputFile;
        private IntPtr                     _job;
        private Timer                      _timeout;
        private int                        _finished; // 0 until onDone is queued (Interlocked)
        private volatile bool              _timedOut, _cancelled;

        internal GenieProcess(Genie.ProcessUtils.ScriptRun run, Action<Genie.ProcessUtils.ProcessLine> onLine,
                              Action<Genie.ProcessUtils.ProcessResult> onDone) {
            _run    = run;
            _onLine = onLine;
            _onDone = onDone;
        }

        /// <summary>True from the start until onDone is queued.</summary>
        public bool IsRunning {
            get { return _process != null && _finished == 0; }
        }

        /// <summary>
        /// Ends the script and everything it started; its result has Cancelled set. Nothing if it's done.
        /// </summary>
        public void Cancel() {
            if (!IsRunning) return;
            _cancelled = true;
            Kill();
        }

        internal void Start() {
            string file = Genie.FileUtils.GetFullPath(_run.File);
            if (file == null || !File.Exists(file)) {
                Fail("No script at " + (_run.File ?? "(none)") + ".");
                return;
            }
            string extension = Path.GetExtension(file);
            if (!string.Equals(extension, ".bat", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(extension, ".cmd", StringComparison.OrdinalIgnoreCase)) {
                Fail("Not a batch file (.bat or .cmd).");
                return;
            }
            string folder = string.IsNullOrEmpty(_run.WorkingFolder) ? Path.GetDirectoryName(file) : _run.WorkingFolder;
            if (!Directory.Exists(folder)) {
                Fail("No working folder at " + folder + ".");
                return;
            }

            Encoding console = Encoding.GetEncoding((int)GetOEMCP());
            try {
                _inputFile = WriteInput(console);
            } catch (Exception ex) {
                Fail("Couldn\u2019t write its input to a temporary file: " + ex.Message);
                return;
            }

            // /s with the whole command in outer quotes: cmd strips those and keeps the rest exactly as typed.
            // /d: no AutoRun commands from the registry, which could print or change folders before the script.
            // Input comes from a file, not a pipe: set /p reads a pipe a buffer at a time, so the first one would take
            // every answer and the rest get none (seen). From a file, each reads one line.
            string command = "\"" + file + "\"" + (string.IsNullOrEmpty(_run.Arguments) ? "" : " " + _run.Arguments) +
                             (_inputFile != null ? " <\"" + _inputFile + "\"" : " <nul");
            System.Diagnostics.ProcessStartInfo info = new System.Diagnostics.ProcessStartInfo(
                Path.Combine(Environment.SystemDirectory, "cmd.exe"), "/d /s /c \"" + command + "\"");
            info.UseShellExecute        = false;
            info.CreateNoWindow         = true;
            info.RedirectStandardOutput = true;
            info.RedirectStandardError  = true;
            info.StandardOutputEncoding = console;
            info.StandardErrorEncoding  = console;
            info.WorkingDirectory       = folder;
            foreach (KeyValuePair<string, string> v in _run.Variables) {
                if (string.IsNullOrEmpty(v.Key)) continue;
                info.EnvironmentVariables[v.Key] = _run.ExpandVariables ? Expand(v.Value ?? "", info) : v.Value ?? "";
            }

            _process = new System.Diagnostics.Process { StartInfo = info, EnableRaisingEvents = true };
            _process.OutputDataReceived += delegate(object s, System.Diagnostics.DataReceivedEventArgs e) {
                Received(e.Data, false);
            };
            _process.ErrorDataReceived += delegate(object s, System.Diagnostics.DataReceivedEventArgs e) {
                Received(e.Data, true);
            };
            _process.Exited += delegate {
                OnExited();
            };
            try {
                _clock.Start();
                _process.Start();
            } catch (Exception ex) {
                _process = null;
                Fail("Couldn\u2019t start it: " + ex.Message);
                return;
            }
            Contain();
            _process.BeginOutputReadLine();
            _process.BeginErrorReadLine();
            if (_run.TimeoutSeconds > 0)
                _timeout = new Timer(delegate {
                    _timedOut = true;
                    Kill();
                }, null, (long)Math.Round(_run.TimeoutSeconds * 1000), Timeout.Infinite);
        }

        // A job holds the script and whatever it starts, so a timeout or Cancel ends them all: killing cmd alone
        // leaves its children (robocopy, say) running. Ending normally ends nothing: a program the script started
        // on purpose (start notepad) stays open.
        private void Contain() {
            _job = CreateJobObject(IntPtr.Zero, null);
            if (_job != IntPtr.Zero && AssignProcessToJobObject(_job, _process.Handle)) return;
            if (!_reportedNoJob)
                GenieBootstrap.Log("Scripts can't be grouped with what they start here (error " +
                                   Marshal.GetLastWin32Error() + "), so a timeout or Cancel ends only the script.");
            _reportedNoJob = true;
            if (_job != IntPtr.Zero) CloseHandle(_job);
            _job = IntPtr.Zero;
        }

        // The input as a temporary file in the console's code page, a line per line; null for none. Deleted by Finish.
        private string WriteInput(Encoding console) {
            if (string.IsNullOrEmpty(_run.Input)) return null;
            string text = _run.Input.Replace("\r\n", "\n").Replace("\n", "\r\n");
            if (!text.EndsWith("\r\n")) text += "\r\n";
            string file = Path.Combine(Path.GetTempPath(), "AddonGenie-input-" + Guid.NewGuid().ToString("N") + ".txt");
            File.WriteAllBytes(file, console.GetBytes(text));
            return file;
        }

        private void Received(string text, bool isError) {
            if (text == null) { // the stream's end
                (isError ? _errorEnded : _outputEnded).Set();
                return;
            }
            if (_onLine == null) return;
            Genie.ProcessUtils.ProcessLine line =
                new Genie.ProcessUtils.ProcessLine { IsError = isError, Text = text, Time = DateTime.Now };
            _ui.BeginInvoke(new Action(delegate { Deliver(delegate { _onLine(line); }); }));
        }

        // On a pool thread. The streams end after the process normally, but a program it started keeps them open
        // while it runs, so the wait is capped: past that, its later lines are dropped rather than holding the result.
        private void OnExited() {
            WaitHandle.WaitAll(new WaitHandle[] { _outputEnded, _errorEnded }, OutputGraceMs);
            _clock.Stop();
            int code = 0;
            try {
                code = _process.ExitCode;
            } catch (Exception) {}
            Genie.ProcessUtils.ProcessResult result = new Genie.ProcessUtils.ProcessResult {
                ExitCode  = code,
                TimedOut  = _timedOut,
                Cancelled = _cancelled,
                Duration  = _clock.Elapsed,
            };
            result.IsSuccess = !_timedOut && !_cancelled && (_run.SuccessCodes ?? ExitCodeSet.Zero).Contains(code);
            Finish(result);
        }

        private void Kill() {
            lock (_jobLock) {
                try {
                    if (_job != IntPtr.Zero)
                        TerminateJobObject(_job, 1);
                    else if (_process != null && !_process.HasExited)
                        _process.Kill();
                } catch (Exception) {} // ended meanwhile
            }
        }

        private void Fail(string problem) {
            Finish(new Genie.ProcessUtils.ProcessResult { ExitCode = -1, StartProblem = problem });
        }

        private void Finish(Genie.ProcessUtils.ProcessResult result) {
            if (Interlocked.Exchange(ref _finished, 1) != 0) return;
            if (_timeout != null) _timeout.Dispose();
            lock (_jobLock) {
                if (_job != IntPtr.Zero) CloseHandle(_job); // without killing: see Contain
                _job = IntPtr.Zero;
            }
            try {
                if (_inputFile != null) File.Delete(_inputFile);
            } catch (Exception) {} // a leftover temp file is harmless
            if (_onDone != null) _ui.BeginInvoke(new Action(delegate { Deliver(delegate { _onDone(result); }); }));
        }

        // An addon's callback throwing mustn't take the dispatcher down with it.
        private static void Deliver(Action callback) {
            try {
                callback();
            } catch (Exception ex) {
                GenieBootstrap.Log("A script callback failed: " + ex);
            }
        }

        // %NAME% from the environment built so far, as set expands it; an unknown one stays as typed.
        private static string Expand(string value, System.Diagnostics.ProcessStartInfo info) {
            return System.Text.RegularExpressions.Regex.Replace(value, "%([^%=]+)%", m => {
                string found = info.EnvironmentVariables[m.Groups[1].Value];
                return found ?? m.Value;
            });
        }
    }

    /// <summary>
    /// An on/off setting in your addon's settings file (Genie.ConfigUtils.CreateToggle) that any number of places can
    /// show: an item under Addons > Options (Genie.MenuUtils.AddCheck) and a checkbox in each window's gear
    /// (GenieSettingsButton.AddCheckItem). Each follows Value however it's changed, so nothing has to keep them in
    /// step, and a gear's checkbox is let go when its window closes. Changed is for your own response, such as showing
    /// or hiding a button. A window's Remember settings are toggles too (GenieWindow.RememberPositionToggle).
    /// One setting is one toggle: asking again for the same key in the same file gives the same toggle, so a change
    /// made through either reaches everything showing it. The first default asked for stays. UI thread only.
    /// </summary>
    // == Settings Backups ===============================================================================
    // Data\<Addon>\SettingsBackups.zip, one entry per backup: "<yyyy-MM-dd_HH-mm-ss>.ini" for a launch's, and
    // "<...> before restore.ini" for the copy a restore makes first. Each entry is the settings file's bytes as saved.
    // Every change rewrites the zip through a temp file, so a failed write leaves the old one whole. Pruned only at
    // launch, so the copy a restore makes survives until the next start. Zip work runs off the UI thread: the zip is
    // read and rewritten whole, which a few hundred backups make slow. The settings are read first, on the UI thread,
    // so a backup holds them as they were; whatever touches the zip waits for this launch's backup.

    internal static class SettingsBackups {
        internal const string Section = "Settings Backups"; // in the addon's own file; see IniFile.IsManagedSection
        internal const int    MinKeep = 1, MaxKeep = 9999;

        private const string KeepKey       = "Keep";
        private const string FileName      = "SettingsBackups.zip";
        private const string TimeFormat    = "yyyy-MM-dd_HH-mm-ss";
        private const string BeforeRestore = " before restore";
        private const int    FallbackKeep  = 300; // for a keep count read before BackUpSettings gives the default

        internal const string KeepHelp =
            "A copy of the settings is made each time the editor starts. Older copies " + "are deleted then.";

        private static readonly Dictionary<Assembly, int> _defaults    = new Dictionary<Assembly, int>();
        private static readonly Dictionary<Assembly, string> _launches = new Dictionary<Assembly, string>();
        private static readonly Dictionary<Assembly, Task> _launchWork = new Dictionary<Assembly, Task>();

        /// <summary>Raised with the owner when its keep count is set, so every box showing it follows.</summary>
        internal static event Action<Assembly> KeepChanged;

        private sealed class Entry {
            internal string   Name;
            internal DateTime Time;
            internal          byte[] Bytes;
        }

        internal static string ZipPath(Assembly owner) {
            string folder = AddonRegistry.DataFolderFor(owner);
            return folder == null ? null : Path.Combine(folder, FileName);
        }

        internal static int GetKeep(Assembly owner) {
            int fallback;
            if (!_defaults.TryGetValue(owner, out fallback)) fallback = FallbackKeep;
            IniFile config = AddonRegistry.ConfigFor(owner);
            string  text   = config == null ? null : config.Get(Section, KeepKey);
            int     keep;
            return text != null && int.TryParse(text, out keep) ? Clamp(keep) : fallback;
        }

        internal static void SetKeep(Assembly owner, int keep) {
            IniFile config = AddonRegistry.ConfigFor(owner);
            if (config == null || keep == GetKeep(owner)) return;
            config.Set(Section, KeepKey, Clamp(keep).ToString());
            if (KeepChanged != null) KeepChanged(owner);
        }

        private static int Clamp(int keep) {
            return Math.Max(MinKeep, Math.Min(MaxKeep, keep));
        }

        internal static void BackUpLaunch(Assembly owner, IniFile config, int defaultKeep) {
            lock (_launches) {
                if (config == null || _launches.ContainsKey(owner)) return; // once per launch
                _defaults[owner] = Clamp(defaultKeep);
                _launches[owner] = "";
            }
            if (!File.Exists(config.FilePath)) return; // never saved: nothing to keep
            string tag = AddonRegistry.TagFor(owner), zip = ZipPath(owner);
            int    keep = GetKeep(owner);
            try {
                Entry entry = NewEntry(File.ReadAllBytes(config.FilePath), false, null);
                lock (_launches) {
                    _launches[owner]   = entry.Name;
                    _launchWork[owner] = Task.Factory.StartNew(delegate {
                        try {
                            List<Entry> entries = ReadAll(zip);
                            entries.RemoveAll(
                                e => string.Equals(e.Name, entry.Name, StringComparison.OrdinalIgnoreCase));
                            entries.Insert(0, entry);
                            if (entries.Count > keep) entries.RemoveRange(keep, entries.Count - keep);
                            WriteAll(zip, entries);
                        } catch (Exception ex) {
                            LogStore.Write(tag, "Couldn't back up its settings: " + ex.Message);
                        }
                    });
                }
            } catch (Exception ex) {
                LogStore.Write(tag, "Couldn't back up its settings: " + ex.Message);
            }
        }

        // Errors are logged by the work itself. From the UI thread it holds things up only if a backup window opens
        // in the moments after launch.
        private static void WaitForLaunch(Assembly owner) {
            Task work;
            lock (_launches) _launchWork.TryGetValue(owner, out work);
            if (work != null) work.Wait();
        }

        /// <summary>Reads the zip: any thread.</summary>
        internal static List<GenieSettingsBackup> List(Assembly owner) {
            List<GenieSettingsBackup> backups = new List<GenieSettingsBackup>();
            if (ZipPath(owner) == null) return backups;
            try {
                WaitForLaunch(owner);
                foreach (Entry e in ReadAll(ZipPath(owner))) backups.Add(ToBackup(owner, e));
            } catch (Exception ex) {
                LogStore.Write(AddonRegistry.TagFor(owner), "Couldn't read its settings backups: " + ex.Message);
            }
            return backups;
        }

        internal static GenieSettingsSnapshot Read(GenieSettingsBackup backup) {
            IniFile live = AddonRegistry.ConfigFor(backup.Owner);
            if (live == null) return null;
            try {
                string text = new UTF8Encoding(false).GetString(backup.Bytes);
                return new GenieSettingsSnapshot(IniFile.FromLines(text.Split('\n')), live, backup);
            } catch (Exception ex) {
                LogStore.Write(AddonRegistry.TagFor(backup.Owner),
                               "Couldn't read the settings backup " + backup.EntryName + ": " + ex.Message);
                return null;
            }
        }

        internal static GenieSettingsBackup Restore(GenieSettingsBackup backup) {
            Assembly owner  = backup.Owner;
            IniFile  config = AddonRegistry.ConfigFor(owner);
            if (config == null) throw new IOException("Settings can't be restored before the addon's Initialize.");
            GenieSettingsSnapshot restored = Read(backup);
            if (restored == null) throw new IOException("This backup can't be read.");

            GenieSettingsBackup before = BackUpBeforeRestore(owner, ReadSettingsFile(config));
            Apply(restored, config, backup);
            return before;
        }

        /// <summary>The settings file's bytes as saved, for BackUpBeforeRestore. UI thread.</summary>
        internal static byte[] ReadSettingsFile(IniFile config) {
            return File.Exists(config.FilePath) ? File.ReadAllBytes(config.FilePath) : new byte[0];
        }

        /// <summary>Adds these settings as a restore's own backup; throws IOException if it can't. Any
        /// thread.</summary>
        internal static GenieSettingsBackup BackUpBeforeRestore(Assembly owner, byte[] settings) {
            try {
                WaitForLaunch(owner);
                string      zip     = ZipPath(owner);
                List<Entry> entries = ReadAll(zip);
                Entry       made    = NewEntry(settings, true, entries);
                entries.Insert(0, made);
                WriteAll(zip, entries);
                return ToBackup(owner, made);
            } catch (Exception ex) {
                throw new IOException("Couldn't back up the settings first, so nothing was restored: " + ex.Message,
                                      ex);
            }
        }

        /// <summary>Replaces the settings with a backup's, once they're backed up. UI thread.</summary>
        internal static void Apply(GenieSettingsBackup backup) {
            IniFile               config   = AddonRegistry.ConfigFor(backup.Owner);
            GenieSettingsSnapshot restored = Read(backup);
            if (config == null) throw new IOException("Settings can't be restored before the addon's Initialize.");
            if (restored == null) throw new IOException("This backup can't be read.");
            Apply(restored, config, backup);
        }

        private static void Apply(GenieSettingsSnapshot restored, IniFile config, GenieSettingsBackup backup) {
            List<KeyValuePair<string, List<KeyValuePair<string, string>>>> was     = config.GetAll();
            Dictionary<GenieToggle, bool>                                  toggles = GenieToggle.ValuesIn(config);
            if (!config.SetAll(Merge(restored.Data, config))) {
                config.SetAll(was);
                throw new IOException("Couldn't write the settings file, so nothing was restored. See the log.");
            }
            GenieToggle.Announce(toggles);
            LogStore.Write(AddonRegistry.TagFor(backup.Owner),
                           "Restored its settings from the backup " + backup.EntryName + ".");
        }

        // The backup's settings, but with the framework's own (window positions, the keep count, a split's place) as
        // they are now: they follow the windows, not the addon's data.
        private static List<KeyValuePair<string, List<KeyValuePair<string, string>>>> Merge(IniFile backup,
                                                                                            IniFile live) {
            List<KeyValuePair<string, List<KeyValuePair<string, string>>>> merged =
                new List<KeyValuePair<string, List<KeyValuePair<string, string>>>>();
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in backup.GetAll()) {
                if (IniFile.IsManagedSection(s.Key)) continue;
                string section = s.Key;
                merged.Add(new KeyValuePair<string, List<KeyValuePair<string, string>>>(
                    section, s.Value.FindAll(e => !live.IsManaged(section, e.Key))));
            }
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in live.GetAll()) {
                foreach (KeyValuePair<string, string> e in s.Value) {
                    if (live.IsManaged(s.Key, e.Key)) SectionIn(merged, s.Key).Add(e);
                }
            }
            return merged;
        }

        private static List<KeyValuePair<string, string>>
        SectionIn(List<KeyValuePair<string, List<KeyValuePair<string, string>>>> sections, string name) {
            KeyValuePair<string, List<KeyValuePair<string, string>>> found =
                sections.Find(s => string.Equals(s.Key, name, StringComparison.OrdinalIgnoreCase));
            if (found.Value != null) return found.Value;
            List<KeyValuePair<string, string>> entries = new List<KeyValuePair<string, string>>();
            sections.Add(new KeyValuePair<string, List<KeyValuePair<string, string>>>(name, entries));
            return entries;
        }

        // Named for now; among existing entries, a second backup in the same second gets " (2)".
        private static Entry NewEntry(byte[] settings, bool beforeRestore, List<Entry> existing) {
            DateTime now  = DateTime.Now;
            DateTime time = new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, now.Second);
            string   stem =
                time.ToString(TimeFormat, CultureInfo.InvariantCulture) + (beforeRestore ? BeforeRestore : "");
            string name = stem + ".ini";
            for (int n = 2; existing != null &&
                            existing.Exists(e => string.Equals(e.Name, name, StringComparison.OrdinalIgnoreCase));
                 n++)
                name = stem + " (" + n + ").ini";
            return new Entry { Name = name, Time = time, Bytes = settings };
        }

        private static GenieSettingsBackup ToBackup(Assembly owner, Entry e) {
            string launch;
            bool   isLaunch;
            lock (_launches) isLaunch = _launches.TryGetValue(owner, out launch) && launch == e.Name;
            bool   isBefore = e.Name.IndexOf(BeforeRestore, StringComparison.OrdinalIgnoreCase) >= 0;
            return new GenieSettingsBackup(owner, e.Name, e.Time, e.Bytes, isLaunch, isBefore);
        }

        // Newest first. Entries not named by time aren't ours and are left out (and dropped on the next write).
        private static List<Entry> ReadAll(string zip) {
            List<Entry> entries = new List<Entry>();
            if (!File.Exists(zip)) return entries;
            using (FileStream file = new FileStream(zip, FileMode.Open, FileAccess.Read, FileShare.Read)) using (
                ZipArchive archive = new ZipArchive(file, ZipArchiveMode.Read)) {
                foreach (ZipArchiveEntry z in archive.Entries) {
                    DateTime time;
                    if (z.Name.Length < TimeFormat.Length ||
                        !DateTime.TryParseExact(z.Name.Substring(0, TimeFormat.Length), TimeFormat,
                                                CultureInfo.InvariantCulture, DateTimeStyles.None, out time))
                        continue;
                    using (Stream data = z.Open()) using (MemoryStream bytes = new MemoryStream()) {
                        data.CopyTo(bytes);
                        entries.Add(new Entry { Name = z.Name, Time = time, Bytes = bytes.ToArray() });
                    }
                }
            }
            // Ties keep the zip's order, which is newest first: List.Sort isn't stable, so the index decides.
            Dictionary<Entry, int> order = new Dictionary<Entry, int>();
            for (int i = 0; i < entries.Count; i++) order[entries[i]] = i;
            entries.Sort((a, b) => a.Time != b.Time ? b.Time.CompareTo(a.Time) : order[a].CompareTo(order[b]));
            return entries;
        }

        private static void WriteAll(string zip, List<Entry> entries) {
            Directory.CreateDirectory(Path.GetDirectoryName(zip));
            string tmp = zip + ".tmp";
            using (FileStream file = new FileStream(tmp, FileMode.Create, FileAccess.Write)) using (
                ZipArchive archive = new ZipArchive(file, ZipArchiveMode.Create)) {
                foreach (Entry e in entries) {
                    ZipArchiveEntry z = archive.CreateEntry(e.Name, CompressionLevel.Optimal);
                    z.LastWriteTime   = new DateTimeOffset(e.Time);
                    using (Stream data = z.Open()) data.Write(e.Bytes, 0, e.Bytes.Length);
                }
            }
            SafeFile.Swap(tmp, zip);
        }
    }

    /// <summary>One copy of an addon's settings, from ConfigUtils.GetSettingsBackups.</summary>
    public sealed class GenieSettingsBackup {
        internal readonly Assembly Owner;
        internal readonly string   EntryName;
        internal readonly          byte[] Bytes;

        internal GenieSettingsBackup(Assembly owner, string entryName, DateTime time, byte[] bytes, bool isThisLaunch,
                                     bool isBeforeRestore) {
            Owner           = owner;
            EntryName       = entryName;
            Bytes           = bytes;
            Time            = time;
            IsThisLaunch    = isThisLaunch;
            IsBeforeRestore = isBeforeRestore;
        }

        /// <summary>When it was made, to the second.</summary>
        public DateTime Time { get; private set; }

        /// <summary>Made when the editor started this time.</summary>
        public bool IsThisLaunch { get; private set; }

        /// <summary>The settings as they were just before a restore replaced them.</summary>
        public bool IsBeforeRestore { get; private set; }

        /// <summary>Its time as a list shows it: "Today, 22:07", "Yesterday, 18:02", "Nov 14, 19:30".</summary>
        public string Title {
            get {
                CultureInfo en = CultureInfo.InvariantCulture;
                string      at = Time.ToString("HH:mm", en);
                if (Time.Date == DateTime.Today) return "Today, " + at;
                if (Time.Date == DateTime.Today.AddDays(-1)) return "Yesterday, " + at;
                return Time.ToString(Time.Year == DateTime.Today.Year ? "MMM d" : "MMM d yyyy", en) + ", " + at;
            }
        }
    }

    /// <summary>
    /// A line of settings text (ConfigUtils.ParseIniText): a [section], a Key=Value setting, or neither, which the
    /// settings file skips.
    /// </summary>
    public sealed class GenieIniLine {
        public int    Number;     // in the text, from 1
        public string Text;       // trimmed
        public string Section;    // a [section] line's name, trimmed; else null
        public string Key, Value; // a setting line's, trimmed; else null

        public bool IsSection {
            get { return Section != null; }
        }

        public bool IsSetting {
            get { return Key != null; }
        }

        // Null for a blank line or a comment. A setting needs a key: "=x" is neither.
        internal static GenieIniLine Read(string raw, int number) {
            string text = (raw ?? "").Trim();
            if (text.Length == 0 || text.StartsWith(";") || text.StartsWith("#")) return null;
            GenieIniLine line = new GenieIniLine { Number = number, Text = text };
            int          eq   = text.IndexOf('=');
            if (text.StartsWith("[") && text.EndsWith("]")) {
                line.Section = text.Substring(1, text.Length - 2).Trim();
            } else if (eq > 0) {
                line.Key   = text.Substring(0, eq).Trim();
                line.Value = text.Substring(eq + 1).Trim();
            }
            return line;
        }

        internal static string SectionText(string name) {
            return "[" + name + "]";
        }

        internal static string SettingText(string key, string value) {
            return key + "=" + value;
        }
    }

    /// <summary>
    /// Settings kept as they were: a backup's (ConfigUtils.ReadSettingsBackup), or the live ones at one moment
    /// (GetSettingsSnapshot). The getters read as ConfigUtils' do.
    /// </summary>
    public sealed class GenieSettingsSnapshot {
        internal readonly IniFile Data;
        internal readonly IniFile Live; // the owner's file, for which keys the framework keeps

        // The live settings as they are now, or null for none (before Initialize).
        internal static GenieSettingsSnapshot Of(IniFile live) {
            return live == null ? null : new GenieSettingsSnapshot(live.Copy(), live, null);
        }

        internal GenieSettingsSnapshot(IniFile data, IniFile live, GenieSettingsBackup backup) {
            Data   = data;
            Live   = live;
            Backup = backup;
        }

        /// <summary>The backup these came from; null for a snapshot of the live settings.</summary>
        public GenieSettingsBackup Backup { get; private set; }

        public string Get(string key, string defaultValue, string section = null) {
            return Data.Get(section ?? Genie.ConfigUtils.DefaultSection, key) ?? defaultValue;
        }

        public int GetInt(string key, int defaultValue, string section = null) {
            int value;
            return int.TryParse(Get(key, null, section), out value) ? value : defaultValue;
        }

        public bool GetBool(string key, bool defaultValue, string section = null) {
            bool value;
            return bool.TryParse(Get(key, null, section), out value) ? value : defaultValue;
        }

        public List<string> GetList(string key, string section = null) {
            return Genie.ConfigUtils.ParseList(Get(key, null, section));
        }

        public T GetEnum<T>(string key, T defaultValue, string section = null) where T : struct {
            return Genie.ConfigUtils.ParseEnum(Get(key, null, section), defaultValue);
        }

        public List<string> GetSections(string prefix = null) {
            return Data.SectionNames().FindAll(name => prefix == null ||
                                                       name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
        }

        public KeyValuePair<string, string>[] GetSection(string name) {
            List<KeyValuePair<string, string>> entries = Data.GetSection(name);
            return entries == null ? new KeyValuePair<string, string>[0] : entries.ToArray();
        }

        // Sections and settings an addon keeps, the framework's own left out, as a diff counts them.
        internal void CountOwn(out int sections, out int settings) {
            sections = settings = 0;
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in Data.GetAll()) {
                int own = s.Value.FindAll(e => !Live.IsManaged(s.Key, e.Key)).Count;
                if (own == 0) continue;
                sections++;
                settings += own;
            }
        }
    }

    /// <summary>What a restore does to one setting or section. Same: nothing; Changed: puts back the backup's
    /// value; ComesBack: adds what's only in the backup; Goes: removes what was added since.</summary>
    public enum GenieSettingChangeKind { Same, Changed, ComesBack, Goes }

    public sealed class GenieSettingChange {
        internal GenieSettingChange(string key, string now, string backup) {
            Key    = key;
            Now    = now;
            Backup = backup;
            Kind   = now == null      ? GenieSettingChangeKind.ComesBack
                     : backup == null ? GenieSettingChangeKind.Goes
                     : now == backup  ? GenieSettingChangeKind.Same
                                      : GenieSettingChangeKind.Changed;
        }

        public string                 Key { get; private set; }
        public GenieSettingChangeKind Kind { get; private set; }

        /// <summary>The value now; null if only the backup has it.</summary>
        public string Now { get; private set; }

        /// <summary>The backup's value; null if only the settings now have it.</summary>
        public string Backup { get; private set; }
    }

    /// <summary>A section's settings compared. Kind: ComesBack or Goes for a section only one side has, Changed if
    /// any setting differs.</summary>
    public sealed class GenieSectionChange {
        private readonly List<GenieSettingChange> _settings;

        internal GenieSectionChange(string name, bool inNow, bool inBackup, List<GenieSettingChange> settings) {
            _settings = settings;
            Name      = name;
            Settings  = settings.AsReadOnly();
            Kind      = !inNow                                                        ? GenieSettingChangeKind.ComesBack
                        : !inBackup                                                   ? GenieSettingChangeKind.Goes
                        : settings.Exists(c => c.Kind != GenieSettingChangeKind.Same) ? GenieSettingChangeKind.Changed
                                                                                      : GenieSettingChangeKind.Same;
        }

        public string                    Name { get; private set; }
        public GenieSettingChangeKind    Kind { get; private set; }
        public IList<GenieSettingChange> Settings { get; private set; }

        /// <summary>A setting's value as a restore leaves it, else as it is now: to name a section that goes.</summary>
        public string Get(string key) {
            GenieSettingChange c = _settings.Find(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase));
            return c == null ? null : c.Backup ?? c.Now;
        }
    }

    /// <summary>
    /// What restoring a backup would change, per section and setting (GenieSettingsDiff.Compare). The framework's own
    /// keys, such as window positions, are left out: a restore keeps them.
    /// </summary>
    public sealed class GenieSettingsDiff {
        private GenieSettingsDiff(GenieSettingsSnapshot backup, GenieSettingsSnapshot current,
                                  List<GenieSectionChange> sections) {
            Backup   = backup;
            Current  = current;
            Sections = sections.AsReadOnly();
        }

        public GenieSettingsSnapshot Backup { get; private set; }
        public GenieSettingsSnapshot Current { get; private set; }

        /// <summary>Sections in the current order, then those only the backup has, in its order.</summary>
        public IList<GenieSectionChange> Sections { get; private set; }

        /// <summary>True if a restore would change nothing.</summary>
        public bool IsSame {
            get { return Count(GenieSettingChangeKind.Same) == Total; }
        }

        /// <summary>Settings of this kind, across every section.</summary>
        public int Count(GenieSettingChangeKind kind) {
            int n = 0;
            foreach (GenieSectionChange s in Sections) {
                foreach (GenieSettingChange c in s.Settings) {
                    if (c.Kind == kind) n++;
                }
            }
            return n;
        }

        private int Total {
            get {
                int n = 0;
                foreach (GenieSectionChange s in Sections) n += s.Settings.Count;
                return n;
            }
        }

        public static GenieSettingsDiff Compare(GenieSettingsSnapshot backup, GenieSettingsSnapshot current) {
            if (backup == null) throw new ArgumentNullException("backup");
            if (current == null) throw new ArgumentNullException("current");
            IniFile                  live     = current.Live;
            List<GenieSectionChange> sections = new List<GenieSectionChange>();
            List<string>             names    = current.Data.SectionNames();
            foreach (string name in backup.Data.SectionNames()) {
                if (!names.Exists(n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase))) names.Add(name);
            }
            foreach (string name in names) {
                List<KeyValuePair<string, string>> now = current.Data.GetSection(name),
                                                   was = backup.Data.GetSection(name);
                List<GenieSettingChange> settings      = new List<GenieSettingChange>();
                List<string>             keys          = new List<string>();
                foreach (List<KeyValuePair<string, string>> side in new[] { now, was }) {
                    if (side == null) continue;
                    foreach (KeyValuePair<string, string> e in side) {
                        if (!live.IsManaged(name, e.Key) &&
                            !keys.Exists(k => string.Equals(k, e.Key, StringComparison.OrdinalIgnoreCase)))
                            keys.Add(e.Key);
                    }
                }
                foreach (string key in keys)
                    settings.Add(new GenieSettingChange(key, current.Data.Get(name, key), backup.Data.Get(name, key)));
                if (settings.Count > 0) sections.Add(new GenieSectionChange(name, now != null, was != null, settings));
            }
            return new GenieSettingsDiff(backup, current, sections);
        }
    }

    public sealed class GenieToggle {
        // Every toggle handed out, by settings file, then "section|key". Toggles hold only their handlers; a gear's
        // checkbox removes its own when its menu closes, so nothing here keeps a window.
        private static readonly Dictionary<IniFile, Dictionary<string, GenieToggle>> _shared =
            new Dictionary<IniFile, Dictionary<string, GenieToggle>>();

        private readonly Assembly _owner;  // whose settings file, looked up on use
        private readonly IniFile  _config; // or the file itself
        private readonly string   _section, _key;
        private readonly bool     _default;

        /// <summary>Raised with the new value when it changes, from anywhere.</summary>
        public event Action<bool> Changed;

        private GenieToggle(Assembly owner, IniFile config, string key, bool defaultValue, string section) {
            _owner   = owner;
            _config  = config;
            _key     = key;
            _default = defaultValue;
            _section = section;
        }

        /// <summary>The toggle for this setting in owner's settings file, made on first use.</summary>
        internal static GenieToggle For(Assembly owner, string key, bool defaultValue, string section) {
            IniFile config = AddonRegistry.ConfigFor(owner);
            // Before the owner registers there's no file to share by: a toggle that saves nothing, as ConfigUtils.
            if (config == null) return new GenieToggle(owner, null, key, defaultValue, section);
            return For(config, key, defaultValue, section);
        }

        /// <summary>The toggle for this setting in config, made on first use. A null config saves nothing.</summary>
        internal static GenieToggle For(IniFile config, string key, bool defaultValue, string section) {
            if (config == null) return new GenieToggle(null, null, key, defaultValue, section);
            Dictionary<string, GenieToggle> inFile;
            if (!_shared.TryGetValue(config, out inFile)) {
                inFile          = new Dictionary<string, GenieToggle>(StringComparer.OrdinalIgnoreCase);
                _shared[config] = inFile;
            }
            string      id = section + "|" + key;
            GenieToggle toggle;
            if (!inFile.TryGetValue(id, out toggle)) {
                toggle     = new GenieToggle(null, config, key, defaultValue, section);
                inFile[id] = toggle;
            }
            return toggle;
        }

        private IniFile Config() {
            if (_config != null) return _config;
            return _owner != null ? AddonRegistry.ConfigFor(_owner) : null;
        }

        // For a change made to the file as a whole (a settings restore): each toggle's value before it, then Announce
        // after it, which raises Changed on those it changed.
        internal static Dictionary<GenieToggle, bool> ValuesIn(IniFile config) {
            Dictionary<GenieToggle, bool>   values = new Dictionary<GenieToggle, bool>();
            Dictionary<string, GenieToggle> inFile;
            if (config == null || !_shared.TryGetValue(config, out inFile)) return values;
            foreach (GenieToggle toggle in inFile.Values) values[toggle] = toggle.Value;
            return values;
        }

        internal static void Announce(Dictionary<GenieToggle, bool> before) {
            foreach (KeyValuePair<GenieToggle, bool> t in before) {
                bool         now     = t.Key.Value;
                Action<bool> handler = t.Key.Changed;
                if (now != t.Value && handler != null) handler(now);
            }
        }

        public string Key {
            get { return _key; }
        }

        /// <summary>
        /// The saved value, or the default if none is saved. Setting it saves it and, if it differs, raises Changed.
        /// Before Initialize nothing is saved, as for ConfigUtils.
        /// </summary>
        public bool Value {
            get {
                IniFile config = Config();
                string  text   = config != null ? config.Get(_section, _key) : null;
                bool    value;
                return (text != null && bool.TryParse(text, out value)) ? value : _default;
            }
            set {
                if (value == Value) return;
                IniFile config = Config();
                if (config != null) config.Set(_section, _key, value ? "true" : "false");
                Action<bool> handler = Changed;
                if (handler != null) handler(value);
            }
        }
    }

