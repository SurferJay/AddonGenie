    internal static class Editor {
        private const string ManagerAssembly = "APPDOMAIN_MANAGER_ASM", ManagerType = "APPDOMAIN_MANAGER_TYPE";

        /// <summary>Starts the editor. withAddons: the two variables that load the framework, for it alone.</summary>
        internal static Process Start(Paths paths, bool withAddons, EventHandler exited) {
            ProcessStartInfo psi = new ProcessStartInfo(paths.Editor, "editor -noscriptcompile -nogadwarning") {
                UseShellExecute  = false, // needed for EnvironmentVariables
                WorkingDirectory = paths.BinDir,
            };
            psi.EnvironmentVariables.Remove(ManagerAssembly);
            psi.EnvironmentVariables.Remove(ManagerType);
            psi.EnvironmentVariables.Remove("LAUNCH_SELF"); // the launcher's own
            psi.EnvironmentVariables.Remove("LAUNCH_PS");
            psi.EnvironmentVariables.Remove("LAUNCH_HIDDEN");
            if (withAddons) {
                psi.EnvironmentVariables[ManagerAssembly] = "X2EditorAddonFramework";
                psi.EnvironmentVariables[ManagerType]     = "AddonGenie.GenieBootstrap";
            }
            Process editor = new Process { StartInfo = psi, EnableRaisingEvents = exited != null };
            if (exited != null) editor.Exited += exited;
            editor.Start();
            return editor;
        }
    }

    // Where the SDK's splash appears, from XComGame.exe (addresses in claude/Launcher-spec.md):
    // - 0x1402c66a0: XComGame\Splash\PC\EdSplash.bmp under the SDK, else Engine\Splash\PC\EdSplash.bmp.
    // - 0x1405cf930: the bitmap's own size, centered on SM_CXSCREEN x SM_CYSCREEN (the primary monitor, taskbar
    //   included), integer division. Not topmost; shown activated. No bitmap: no splash.
    internal static class NativeSplash {
        internal const string WindowClass = "SplashScreenClass";

        private static readonly Size NoBitmapSize = new Size(600, 340); // ours alone; the SDK shows none

        internal static Rectangle ExpectedBounds(string sdkDir) {
            Size size = BitmapSize(Path.Combine(sdkDir, @"XComGame\Splash\PC\EdSplash.bmp")) ??
                        BitmapSize(Path.Combine(sdkDir, @"Engine\Splash\PC\EdSplash.bmp")) ?? NoBitmapSize;
            int x = (Win32.GetSystemMetrics(Win32.SM_CXSCREEN) - size.Width) / 2;
            int y = (Win32.GetSystemMetrics(Win32.SM_CYSCREEN) - size.Height) / 2;
            return new Rectangle(x, y, size.Width, size.Height);
        }

        // From the BMP header, without loading it. Height is negative for top-down bitmaps.
        private static Size? BitmapSize(string file) {
            try {
                if (!File.Exists(file)) return null;
                using (BinaryReader r = new BinaryReader(File.OpenRead(file))) {
                    if (r.ReadUInt16() != 0x4D42) return null; // "BM"
                    r.BaseStream.Seek(14, SeekOrigin.Begin);
                    int header = r.ReadInt32();
                    if (header == 12) return new Size(r.ReadUInt16(), r.ReadUInt16()); // BITMAPCOREHEADER
                    return new Size(r.ReadInt32(), Math.Abs(r.ReadInt32()));
                }
            } catch (IOException) {
                return null;
            }
        }
    }

    internal static class EditorWindows {
        /// <summary>The editor's main window: a visible wx frame with a menu bar and no owner.</summary>
        internal static IntPtr FindMainFrame(uint pid) {
            return Find(pid, "wxWindowClassNR", true);
        }

        internal static IntPtr Find(uint pid, string windowClass) {
            return Find(pid, windowClass, false);
        }

        private static IntPtr Find(uint pid, string windowClass, bool isMainFrame) {
            IntPtr                found = IntPtr.Zero;
            Win32.EnumWindowsProc visit = delegate(IntPtr h, IntPtr l) {
                uint p;
                Win32.GetWindowThreadProcessId(h, out p);
                if (p != pid || !Win32.IsWindowVisible(h) || Win32.ClassName(h) != windowClass) return true;
                if (isMainFrame &&
                    (Win32.GetMenu(h) == IntPtr.Zero || Win32.GetWindow(h, Win32.GW_OWNER) != IntPtr.Zero))
                    return true;
                found = h;
                return false;
            };
            Win32.EnumWindows(visit, IntPtr.Zero);
            GC.KeepAlive(visit); // the callback must outlive the native call
            return found;
        }
    }

    // Calls back on this thread with the window, whenever one of the process's windows raises the event (a window
    // shows, comes to the foreground). The host has nothing to subscribe to, so this is the subscription: an
    // out-of-context WinEvent hook, delivered through our message loop after the event, never during it.
    internal sealed class WindowHook : IDisposable {
        private readonly Win32.WinEventProc _proc; // held: the hook calls it until unhooked
        private IntPtr                      _hook;

        internal WindowHook(uint pid, uint winEvent, Action<IntPtr> onEvent) {
            _proc = delegate(IntPtr hook, uint e, IntPtr h, int obj, int child, uint thread, uint time) {
                if (obj == Win32.OBJID_WINDOW && child == 0) onEvent(h);
            };
            _hook = Win32.SetWinEventHook(winEvent, winEvent, IntPtr.Zero, _proc, pid, 0, Win32.WINEVENT_OUTOFCONTEXT);
        }

        public void Dispose() {
            if (_hook == IntPtr.Zero) return;
            Win32.UnhookWinEvent(_hook);
            _hook = IntPtr.Zero;
        }
    }

    // The genie, drawn from the framework's WindowIcon.Layers, read out of this file so the art lives in one place.
    // Understands only what that art uses: absolute M L H V A Z, arcs unrotated.
    internal sealed class IconArt {
        private const float ArtSize = 512; // the art's coordinates, as WindowIcon.ArtSize

        private readonly List<KeyValuePair<Color, GraphicsPath>> _layers =
            new List<KeyValuePair<Color, GraphicsPath>>();

        /// <summary>Null if the art can't be read: no icon is fine.</summary>
        internal static IconArt Load(Paths paths) {
            try {
                string source = paths.FrameworkSource;
                if (source == null) return null;
                int from = source.IndexOf("class WindowIcon", StringComparison.Ordinal);
                if (from < 0) return null;
                from   = source.IndexOf("Layers = {", from, StringComparison.Ordinal);
                int to = source.IndexOf("};", from, StringComparison.Ordinal);

                IconArt art = new IconArt();
                foreach (Match m in Regex.Matches(source.Substring(from, to - from),
                                                  "\"#([0-9a-fA-F]{6}) ([^\"]+)\"")) {
                    Color color = Color.FromArgb(unchecked((int)0xff000000) | Convert.ToInt32(m.Groups[1].Value, 16));
                    art._layers.Add(new KeyValuePair<Color, GraphicsPath>(color, Parse(m.Groups[2].Value)));
                }
                return art._layers.Count > 0 ? art : null;
            } catch (Exception) {
                return null;
            }
        }

        internal void Draw(Graphics g, int x, int y, int size) {
            GraphicsState saved = g.Save();
            g.SmoothingMode     = SmoothingMode.AntiAlias;
            g.PixelOffsetMode   = PixelOffsetMode.HighQuality;
            g.TranslateTransform(x, y);
            g.ScaleTransform(size / ArtSize, size / ArtSize);
            foreach (KeyValuePair<Color, GraphicsPath> layer in _layers) {
                using (SolidBrush fill = new SolidBrush(layer.Key)) g.FillPath(fill, layer.Value);
            }
            g.Restore(saved);
        }

        internal Bitmap Render(int size) {
            Bitmap bitmap = new Bitmap(size, size);
            using (Graphics g = Graphics.FromImage(bitmap)) Draw(g, 0, 0, size);
            return bitmap;
        }

        private static GraphicsPath Parse(string data) {
            GraphicsPath path = new GraphicsPath(FillMode.Winding); // nonzero, as WPF's F1: same-colored paths overlap
            List<string> tokens = new List<string>();
            foreach (Match m in Regex.Matches(data, "[A-Za-z]|-?[0-9.]+")) tokens.Add(m.Value);

            int    i       = 0;
            char   command = 'M';
            PointF at      = PointF.Empty;
            while (i < tokens.Count) {
                if (char.IsLetter(tokens[i][0])) command = tokens[i++][0];
                switch (command) {
                    case 'M':
                        path.StartFigure();
                        at      = new PointF(Number(tokens, ref i), Number(tokens, ref i));
                        command = 'L'; // more points after M are lines, as in SVG
                        break;
                    case 'L':
                        at = Line(path, at, new PointF(Number(tokens, ref i), Number(tokens, ref i)));
                        break;
                    case 'H':
                        at = Line(path, at, new PointF(Number(tokens, ref i), at.Y));
                        break;
                    case 'V':
                        at = Line(path, at, new PointF(at.X, Number(tokens, ref i)));
                        break;
                    case 'A': {
                        float rx = Number(tokens, ref i);
                        float ry = Number(tokens, ref i);
                        Number(tokens, ref i); // rotation: always 0 in the art
                        bool   large = Number(tokens, ref i) != 0;
                        bool   sweep = Number(tokens, ref i) != 0;
                        PointF to    = new PointF(Number(tokens, ref i), Number(tokens, ref i));
                        AddArc(path, at, to, rx, ry, large, sweep);
                        at = to;
                        break;
                    }
                    case 'Z':
                        path.CloseFigure();
                        break;
                    default:
                        throw new FormatException("path command " + command + " isn't supported");
                }
            }
            return path;
        }

        private static float Number(List<string> tokens, ref int i) {
            return float.Parse(tokens[i++], System.Globalization.CultureInfo.InvariantCulture);
        }

        private static PointF Line(GraphicsPath path, PointF from, PointF to) {
            path.AddLine(from, to);
            return to;
        }

        // SVG's endpoint arc as GDI+'s bounds and angles (SVG spec F.6.5, unrotated). The angles come from the
        // endpoints: exact for circles, and for ellipses where they meet an axis, as all of the art's do.
        private static void AddArc(GraphicsPath path, PointF from, PointF to, double rx, double ry, bool large,
                                   bool sweep) {
            double hx = (from.X - to.X) / 2, hy = (from.Y - to.Y) / 2;
            double reach = hx * hx / (rx * rx) + hy * hy / (ry * ry);
            if (reach > 1) { // too small to span the endpoints: SVG scales it up
                rx *= Math.Sqrt(reach);
                ry *= Math.Sqrt(reach);
            }
            double rest = rx * rx * ry * ry - rx * rx * hy * hy - ry * ry * hx * hx;
            double k    = Math.Sqrt(Math.Max(0, rest / (rx * rx * hy * hy + ry * ry * hx * hx)));
            if (large == sweep) k = -k;
            double cx = k * rx * hy / ry + (from.X + to.X) / 2;
            double cy = -k * ry * hx / rx + (from.Y + to.Y) / 2;

            double start = Math.Atan2(from.Y - cy, from.X - cx) * 180 / Math.PI;
            double span  = Math.Atan2(to.Y - cy, to.X - cx) * 180 / Math.PI - start;
            if (sweep && span < 0) span += 360;
            if (!sweep && span > 0) span -= 360;
            path.AddArc((float)(cx - rx), (float)(cy - ry), (float)(2 * rx), (float)(2 * ry), (float)start,
                        (float)span);
        }
    }

