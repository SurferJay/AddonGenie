            // Dotted underline at rest; the link colour and a solid underline on hover, then back to the text's own
            // colour.
            private static TextBlock Link(TextBlock link, string tooltip, Action onClick) {
                Brush ink   = link.Foreground;
                link.Margin = new Thickness(0);
                link.Cursor = System.Windows.Input.Cursors.Hand;

                TextDecorationCollection rest = Underline(Theme.LinkUnderline, true);
                TextDecorationCollection hot  = Underline(Theme.LinkHover, false);
                link.TextDecorations          = rest;

                link.MouseEnter += delegate {
                    link.Foreground      = Theme.LinkHover;
                    link.TextDecorations = hot;
                };
                link.MouseLeave += delegate {
                    link.Foreground      = ink;
                    link.TextDecorations = rest;
                };
                link.MouseLeftButtonUp += delegate {
                    onClick();
                };
                if (tooltip != null) SetToolTip(link, tooltip);
                return link;
            }

