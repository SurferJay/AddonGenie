using System;
using System.Collections;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.IO.Compression;
using System.Reflection;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Media;
using System.Windows.Media.Animation;
using System.Windows.Threading;

// AddonGenie: an addon framework for the XCOM 2 War of the Chosen SDK's Unreal Editor.
// Icon: "Genie" by Magnific, from Flaticon (https://www.flaticon.com/free-icon/genie_3821133)
//
// The AddonGenie namespace is the framework's alone; the loader refuses addons that use it.
//
// For addon authors:
//   IGenieAddon                implement in a class named Addon, in your own namespace
//   Genie.Log(...)             write to the log, tagged with your addon's name
//   Genie.Dispatcher           the editor UI thread
//   Genie.AddonsFolder         SDK\Binaries\Win64\Addons
//   Genie.GetSdkFolder()       the SDK's own folder
//   Genie.GetDataFolder()      your addon's own folder, for exports and other files
//   Genie.ObjectUtils          engine objects and packages
//   Genie.RedirectorUtils      redirectors: where they point, and making them
//   Genie.PathUtils            object name strings ("Class Pkg.Group.Obj")
//   Genie.TextUtils            words for counts and times ("3 redirectors", "0:42", "Nov 14")
//   Genie.LinkerUtils          a loaded package's import, export and dependency tables
//   Genie.ContentBrowserUtils  the Content Browser: selection, show, open, notifications, header buttons
//   Genie.AssetDatabaseUtils   every asset the editor knows, loaded or not
//   Genie.PackageUtils         move objects between packages and unload packages, without dialogs
//   Genie.EditorUtils          run editor commands, as the editor's command line does
//   Genie.WorkUtils            long work on the UI thread without freezing it; coalesced calls
//   Genie.ClipboardUtils       text to the clipboard
//   Genie.FileUtils            compare and write files, show files, open and watch folders
//   Genie.WindowUtils          popup windows owned by the editor, file and folder pickers
//   Genie.ControlUtils         themed WPF controls and dialogs
//   Genie.Theme                the shared colours, fonts and sizes
//   Genie.ConfigUtils          your addon's own settings file, and its backups by launch
//
// Naming: Create... makes something new, Find... looks up something that exists, Get... reads,
// Is.../Can... answer yes or no, Show... brings something into view. Engine objects are raw IntPtrs
// (UObject*); Zero means none. Optional style arguments default to null, meaning "use the theme".
namespace AddonGenie {
    // == Addon Contract ===============================================================================

    /// <summary>
    /// Implemented by every addon, in a class named Addon in the addon's own namespace.
    /// Both methods run on the editor UI thread. Do setup in Initialize, not in a constructor or field
    /// initializer: those run before the addon is registered, off the UI thread, with no settings yet.
    /// </summary>
    public interface IGenieAddon {
        /// <summary>Menu label, and the tag on this addon's log lines.</summary>
        string Name { get; }

        /// <summary>Shown in the editor status bar while the menu item is highlighted.</summary>
        string Tooltip { get; }

        /// <summary>
        /// e.g. "1.0", shown as "v1.0" on its load line, in About and on its windows. A version that
        /// doesn't start with a digit is shown as written.
        /// </summary>
        string Version { get; }

        /// <summary>Shown on its load line, in About and on its windows.</summary>
        string Author { get; }

        /// <summary>Called once after loading, before the menu appears.</summary>
        void Initialize();

        /// <summary>Called when the menu item is clicked.</summary>
        void Invoke();
    }

    // == Genie: Entry Point ===========================================================================

    public static partial class Genie {
        public const string Version = "0.1.0";
        public const string Author  = "SurferJay";

        /// <summary>The editor UI thread's dispatcher.</summary>
        public static Dispatcher Dispatcher {
            get { return GenieBootstrap.UiDispatcher; }
        }

        /// <summary>
        /// SDK\Binaries\Win64\Addons. The loader only reads files directly in it. For your own files, use
        /// GetDataFolder.
        /// </summary>
        public static string AddonsFolder {
            get { return GenieBootstrap.AddonsDir; }
        }

        /// <summary>The SDK's own folder, full path: two up from the editor's (SDK\Binaries\Win64).</summary>
        public static string GetSdkFolder() {
            return GenieBootstrap.SdkDir;
        }

        /// <summary>
        /// Addons\Data\<Your Addon>, for exports and anything else that isn't a setting. Not created until you
        /// write to it, so create it first (Directory.CreateDirectory). Users may browse it and clear it out.
        /// Null before Initialize, when your addon's name isn't known yet.
        /// </summary>
        /// <param name="callerFile">Leave out: the compiler fills it in, and it identifies your addon.</param>
        public static string GetDataFolder([CallerFilePath] string callerFile = null) {
            return AddonRegistry.DataFolderFor(AddonRegistry.AssemblyOf(callerFile));
        }

        /// <summary>When this editor session began: the framework's start, moments into the editor's.</summary>
        public static DateTime GetSessionStart() {
            return GenieBootstrap.SessionStart;
        }

        /// <summary>This session as addons.log marks its lines ("S0012"), to tie your own logs to it.</summary>
        public static string GetSessionId() {
            return LogStore.CurrentSessionId;
        }

        /// <summary>
        /// Runs onReady once the editor is up, its Content Browser included: right after the windows left open last
        /// time reopen. Asked later, it runs at the next idle moment. Ask in Initialize for work at each launch.
        /// Example: Package Loader's startup jobs.
        /// </summary>
        /// <param name="callerFile">Leave out: the compiler fills it in, and it identifies your addon.</param>
        public static void WhenEditorReady(Action onReady, [CallerFilePath] string callerFile = null) {
            GenieBootstrap.WhenReady(onReady, AddonRegistry.TagFor(AddonRegistry.AssemblyOf(callerFile)));
        }

        /// <summary>Writes "[Your Addon] message" to Addons\Logs\addons.log. Safe from any thread.</summary>
        /// <param name="callerFile">Leave out: the compiler fills it in, and it identifies your addon.</param>
        public static void Log(string message, [CallerFilePath] string callerFile = null) {
            LogStore.Write(AddonRegistry.TagFor(AddonRegistry.AssemblyOf(callerFile)), message);
        }
    }

    // == Bootstrap ====================================================================================
    // Named by the launcher as the AppDomainManager, so .NET loads it into the editor at startup.

    public sealed class GenieBootstrap : AppDomainManager {
        private static bool       _started;
        private static Dispatcher _dispatcher;

        // Read-only check for addons that make their own System.Windows.Window, keyed by addon name.
        private static readonly Dictionary<string, bool> _warned = new Dictionary<string, bool>();

        internal static DateTime SessionStart;
        internal static string   AddonsDir;
        internal static string   ConfigDir;
        internal static string   LogsDir;
        internal static string   DataDir;
        internal static string   SdkDir;

        internal static Dispatcher UiDispatcher {
            get { return _dispatcher; }
        }

        public override void InitializeNewDomain(AppDomainSetup setup) {
            base.InitializeNewDomain(setup);
            try {
                Begin();
            } catch {}
        }

        internal static void Log(string message) {
            LogStore.Write(LogStore.FrameworkTag, message);
        }

        private static void Begin() {
            if (_started) return;
            _started     = true;
            SessionStart = DateTime.Now;

            AddonsDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Addons");
            ConfigDir = Path.Combine(AddonsDir, "Config");
            LogsDir   = Path.Combine(AddonsDir, "Logs");
            DataDir   = Path.Combine(AddonsDir, "Data");
            SdkDir    = Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, @"..\.."));
            try {
                Directory.CreateDirectory(ConfigDir);
                Directory.CreateDirectory(LogsDir);
            } catch {}

            IniFile config      = AddonRegistry.ConfigFor(typeof(GenieBootstrap).Assembly);
            int     keep        = ReadPositive(config, "KeepSessions", LogStore.DefaultKeepSessions);
            int     lastSession = ReadPositive(config, "LastSession", 0);
            int     session     = LogStore.Begin(Path.Combine(LogsDir, "addons.log"), keep, lastSession);
            config.Set("Logging", "LastSession", session.ToString());

            // The editor's window doesn't exist yet; wait for it off the startup thread.
            Thread thread       = new Thread(Run);
            thread.IsBackground = true;
            thread.Start();
        }

        // A true/false setting in AddonGenie.ini. Written with its default when missing, so users can find it.
        // The framework's own items under Addons > Options.
        private static void AddFrameworkOptions() {
            // Was ShowTray, under "Show Addon Toolbars"; that line is now unused.
            ReadOption("ContentBrowser", "ShowPackageToolbar", true); // writes the default if missing
            GenieToggle shown =
                GenieToggle.For(typeof(GenieBootstrap).Assembly, "ShowPackageToolbar", true, "ContentBrowser");
            GenieTray.SetShown(shown.Value);
            shown.Changed += GenieTray.SetShown;
            Genie.MenuUtils.AddCheck("Show Package Toolbar",
                                     "Show addon buttons above the package list", shown);

            ReadOption("ContentBrowser", "RerouteOpenPackage", false);
            GenieToggle reroute =
                GenieToggle.For(typeof(GenieBootstrap).Assembly, "RerouteOpenPackage", false, "ContentBrowser");
            OpenPackageReroute.Initialize(reroute);
            Genie.MenuUtils.AddCheck("Fix Dependency Handling for Open",
                                     "Content Browser opens dependent files together", reroute);
        }

        private static bool ReadOption(string section, string key, bool fallback) {
            IniFile config = AddonRegistry.ConfigFor(typeof(GenieBootstrap).Assembly);
            bool    value;
            string  text = config.Get(section, key);
            if (text != null && bool.TryParse(text, out value)) return value;
            config.Set(section, key, fallback ? "true" : "false");
            return fallback;
        }

        private static int ReadPositive(IniFile config, string key, int fallback) {
            int    n;
            string value = config.Get("Logging", key);
            return (value != null && int.TryParse(value, out n) && n > 0) ? n : fallback;
        }

        private static void Run() {
            try {
                IntPtr frame = IntPtr.Zero;
                for (int i = 0; i < 2400 && frame == IntPtr.Zero; i++) { // up to 10 minutes: cold starts are slow
                    frame = Genie.WindowUtils.FindEditorFrame();
                    if (frame == IntPtr.Zero) Thread.Sleep(250);
                }
                if (frame == IntPtr.Zero) {
                    Log("No editor frame found.");
                    return;
                }

                Application app = Application.Current;
                _dispatcher     = (app != null) ? app.Dispatcher : null;
                HookCrashLogging(app);

                AddonLoader.LoadAll(AddonsDir);

                Action setup = delegate {
                    AddFrameworkOptions(); // before the addons, so trays know whether they show before buttons arrive
                    foreach (LoadedAddon addon in AddonRegistry.Loaded) {
                        try {
                            addon.Instance.Initialize();
                        } catch (Exception ex) {
                            Log("Initialize '" + addon.Name + "' failed: " + ex.Message);
                        }
                    }
                    try {
                        MenuNative.Install(frame, AddonRegistry.Loaded, OnMenu, Log);
                        Log(ReadyLine());
                    } catch (Exception ex) {
                        Log("Menu failed: " + ex);
                    }
                };
                bool refreshTaskbar = ReadOption("Editor", "TaskbarIcon", true);
                if (_dispatcher == null) {
                    setup();
                    if (refreshTaskbar) TaskbarButton.Refresh(frame);
                    EditorReady();
                    return;
                }
                _dispatcher.Invoke(setup);
                // ApplicationIdle: the Content Browser is up by then, so reopened windows can use it, and the UI
                // thread is free to answer the taskbar when it asks the frame for its icon again.
                _dispatcher.BeginInvoke(DispatcherPriority.ApplicationIdle, (Action)delegate {
                    if (refreshTaskbar) TaskbarButton.Refresh(frame);
                    ReopenWindows();
                    EditorReady();
                });
            } catch (Exception ex) {
                Log("Run: " + ex);
            }
        }

        // So a crash leaves a reason in the log. Ours on the UI thread don't crash: AddonFaults.
        private static void HookCrashLogging(Application app) {
            try {
                AppDomain.CurrentDomain.UnhandledException += delegate(object s, UnhandledExceptionEventArgs e) {
                    Log("UNHANDLED: " + e.ExceptionObject);
                };
                if (app == null) return;
                app.DispatcherUnhandledException += delegate(object s, DispatcherUnhandledExceptionEventArgs e) {
                    if (AddonFaults.Handle(e.Exception))
                        e.Handled = true;
                    else
                        Log("DISPATCHER UNHANDLED: " + e.Exception);
                };
            } catch (Exception ex) {
                Log("exception hooks failed: " + ex.Message);
            }
        }

        // == Editor Ready ===========================================================================
        // Genie.WhenEditorReady. Asked on the UI thread (Initialize or later), run there.

        private static readonly List<KeyValuePair<string, Action>> _whenReady =
            new List<KeyValuePair<string, Action>>();
        private static bool _ready;

        internal static void WhenReady(Action onReady, string tag) {
            if (onReady == null) return;
            if (!_ready) {
                _whenReady.Add(new KeyValuePair<string, Action>(tag, onReady));
                return;
            }
            if (_dispatcher != null)
                _dispatcher.BeginInvoke(DispatcherPriority.ApplicationIdle,
                                        (Action)delegate { RunReady(tag, onReady); });
            else
                RunReady(tag, onReady);
        }

        private static void EditorReady() {
            _ready = true;
            foreach (KeyValuePair<string, Action> r in _whenReady) RunReady(r.Key, r.Value);
            _whenReady.Clear();
        }

        private static void RunReady(string tag, Action onReady) {
            try {
                onReady();
            } catch (Exception ex) {
                LogStore.Write(tag, "Work at editor start failed: " + ex);
            }
        }

        // Windows left open (and set to Remember if open) come back: the framework's directly, an addon's
        // through its Invoke(), as if its menu item was clicked.
        private static void ReopenWindows() {
            GenieWindow.IsReopening = true;
            try {
                ReopenAll();
            } finally {
                GenieWindow.IsReopening = false;
            }
        }

        // Back to front, as they were stacked when the editor closed, then stacked exactly (RestoreStacking).
        private static void ReopenAll() {
            List<Reopen> reopens = new List<Reopen>();
            try {
                IniFile config = AddonRegistry.ConfigFor(typeof(GenieBootstrap).Assembly);
                foreach (string title in new[] { FrameworkWindows.LogsTitle, FrameworkWindows.AboutTitle }) {
                    if (!GenieWindow.WasOpen(config, title)) continue;
                    Action show = title == FrameworkWindows.LogsTitle ? (Action)FrameworkWindows.ShowLogs
                                                                      : FrameworkWindows.ShowAbout;
                    reopens.Add(new Reopen(title, GenieWindow.SavedZOrder(config, title), reopens.Count, show));
                }
            } catch (Exception ex) {
                Log("Reopen failed: " + ex.Message);
            }

            // Invoke() opens an addon's main window, so once per addon, placed by its frontmost window.
            foreach (LoadedAddon addon in AddonRegistry.Loaded) {
                // Only the windows Invoke() opens bring it back: Invoke() can't reopen a subwindow, so one left open
                // would open the main window at every launch. With none known yet, any window counts.
                IniFile config = AddonRegistry.ConfigFor(addon.Assembly);
                int     front = int.MinValue, mainFront = int.MinValue;
                bool    hasMain = false;
                foreach (string section in config.SectionNames()) {
                    if (!section.StartsWith(GenieWindow.SectionPrefix)) continue;
                    string key   = section.Substring(GenieWindow.SectionPrefix.Length);
                    bool   main  = GenieWindow.OpensWithInvoke(config, key);
                    hasMain     |= main;
                    if (!GenieWindow.WasOpen(config, key)) continue;
                    int z = GenieWindow.SavedZOrder(config, key);
                    front = Math.Max(front, z);
                    if (main) mainFront = Math.Max(mainFront, z);
                }
                if (hasMain) front = mainFront;
                if (front == int.MinValue) continue;
                LoadedAddon a = addon; // one per closure
                reopens.Add(new Reopen(addon.Name, front, reopens.Count, delegate { GenieWindow.Invoke(a); }));
            }

            reopens.Sort(delegate(Reopen x, Reopen y) {
                return x.ZOrder != y.ZOrder ? x.ZOrder.CompareTo(y.ZOrder) : x.Index.CompareTo(y.Index);
            });
            foreach (Reopen r in reopens) {
                try {
                    r.Open();
                } catch (Exception ex) {
                    Log("Reopen '" + r.Name + "' failed: " + ex.Message);
                }
            }
            GenieWindow.RestoreStacking();
        }

        private sealed class Reopen {
            internal readonly string Name;
            internal readonly int    ZOrder, Index; // Index: the order found, for ties (an older settings file)
            internal readonly Action Open;

            internal Reopen(string name, int zOrder, int index, Action open) {
                Name   = name;
                ZOrder = zOrder;
                Index  = index;
                Open   = open;
            }
        }

        // "Ready: 1 addon.", "Ready: 1 addon, 3 not loaded.", or where addons go if there are none.
        private static string ReadyLine() {
            int loaded = AddonRegistry.Loaded.Count;
            int failed = AddonRegistry.Refused.Count;
            if (loaded == 0 && failed == 0) return "Ready: no addons in SDK\\Binaries\\Win64\\Addons.";
            return "Ready: " + loaded + (loaded == 1 ? " addon" : " addons") +
                   (failed > 0 ? ", " + failed + " not loaded." : ".");
        }

        // From the editor frame's WM_COMMAND, on the UI thread.
        private static void OnMenu(int index) {
            try {
                switch (index) {
                    case MenuNative.ViewLogs:
                        FrameworkWindows.ShowLogs();
                        return;
                    case MenuNative.ViewConfigs:
                        Genie.FileUtils.OpenFolder(ConfigDir, true);
                        return;
                    case MenuNative.ResetWindows:
                        GenieWindow.ForgetSavedBounds();
                        return;
                    case MenuNative.AboutHelp:
                        FrameworkWindows.ShowAbout();
                        return;
                }
                if (index < 0 || index >= AddonRegistry.Loaded.Count) return;

                LoadedAddon addon = AddonRegistry.Loaded[index];
                if (AddonFaults.IsOff(addon)) return; // its item is greyed; this is in case a click gets through
                int before = AppWindowCount();
                GenieWindow.Invoke(addon);
                WarnIfAppWindowCreated(addon, before);
            } catch (Exception ex) {
                Log("Invoke: " + ex);
            }
        }

        // A System.Windows.Window joins Application.Windows. The editor has none of its own and its
        // ShutdownMode is OnLastWindowClose, so closing that window shuts down the WPF dispatcher and the
        // editor hangs. We only warn: the editor's settings are never ours to change.
        private static void WarnIfAppWindowCreated(LoadedAddon addon, int before) {
            Action check = delegate {
                if (_warned.ContainsKey(addon.Name) || AppWindowCount() <= before) return;
                _warned[addon.Name] = true;
                Log("WARNING: '" + addon.Name + "' created a System.Windows.Window. Closing it can shut down the " +
                    "editor's WPF dispatcher (hang, then crash). Use Genie.WindowUtils.CreateWindow instead.");
            };
            // Deferred, so an addon that BeginInvokes its window creation is still caught.
            try {
                if (_dispatcher != null)
                    _dispatcher.BeginInvoke(DispatcherPriority.ApplicationIdle, check);
                else
                    check();
            } catch {}
        }

        private static int AppWindowCount() {
            try {
                Application app = Application.Current;
                return (app == null) ? 0 : app.Windows.Count;
            } catch {
                return 0;
            }
        }
    }

    // == Addon Loading ================================================================================
    // Addons are .cs source compiled at startup. Compiled DLLs are refused, so every addon can be read.

    internal static class AddonLoader {
        private const string    ReservedNamespace      = "AddonGenie";
        private static readonly string[] ReservedNames = { LogStore.FrameworkTag, "Global" };

        internal static void LoadAll(string dir) {
            string[] files;
            try {
                files = Directory.GetFiles(dir);
            } catch (Exception ex) {
                GenieBootstrap.Log("Couldn't read SDK\\Binaries\\Win64\\Addons: " + ex.Message);
                return;
            }
            // Alphabetical, so load order, menu order and which file keeps a contested name are predictable.
            Array.Sort(files, StringComparer.OrdinalIgnoreCase);

            foreach (string path in files) {
                string ext  = Path.GetExtension(path).ToLowerInvariant();
                string file = Path.GetFileName(path);
                if (ext == ".dll") {
                    Refuse(file, "compiled addons aren't supported. Use the addon's .cs source.");
                    continue;
                }
                if (ext != ".cs") {
                    // Archives, readmes and the like are the user's business. "Foo.cs.txt" (Windows hiding the
                    // extension) or "Foo.cs.bak" was meant as an addon, or is a copy of one.
                    if (file.IndexOf(".cs.", StringComparison.OrdinalIgnoreCase) >= 0)
                        GenieBootstrap.Log("Skipped " + file + ": addons must end in .cs.");
                    continue;
                }
                try {
                    LoadFile(path, file);
                } catch (Exception ex) {
                    Fail(file, ex.Message);
                }
            }
        }

        private static void LoadFile(string path, string file) {
            List<string> errors   = new List<string>();
            Assembly     assembly = Compile(path, errors);
            if (assembly == null) {
                Fail(file, "compile error.");
                foreach (string e in errors) GenieBootstrap.Log(e);
                return;
            }
            AddonRegistry.Claim(assembly, file);
            List<Type> types = LoadableTypes(assembly);

            // Reserved so a namespace in a log line or stack trace always says which side the code is on.
            List<string> clash = new List<string>();
            foreach (Type t in types) {
                if (t.Namespace == ReservedNamespace || (t.Namespace ?? "").StartsWith(ReservedNamespace + "."))
                    clash.Add(t.FullName);
            }
            if (clash.Count > 0) {
                Refuse(file, "uses the reserved AddonGenie namespace (" + string.Join(", ", clash.ToArray()) +
                                 "). Use your own.");
                return;
            }

            int found = 0;
            foreach (Type t in types) {
                if (t.IsAbstract || t.IsInterface || !typeof(IGenieAddon).IsAssignableFrom(t)) continue;
                found++;
                if (t.GetConstructor(Type.EmptyTypes) == null) {
                    Refuse(file, t.FullName + " has no public parameterless constructor.");
                    continue;
                }

                IGenieAddon instance = (IGenieAddon)Activator.CreateInstance(t);
                string      name     = ReadSafely(delegate { return instance.Name; });
                string      problem  = CheckName(name);
                if (problem != null) {
                    Refuse(file, problem);
                    continue;
                }

                LoadedAddon addon = new LoadedAddon {
                    Instance = instance,
                    Name     = name.Trim(),
                    Tooltip  = ReadSafely(delegate { return instance.Tooltip; }) ?? "",
                    Version       = (ReadSafely(delegate { return instance.Version; }) ?? "").Trim(),
                    Author        = (ReadSafely(delegate { return instance.Author; }) ?? "").Trim(),
                    FileName      = file,
                    Assembly      = assembly,
                };
                AddonRegistry.Register(addon);
                GenieBootstrap.Log("Loaded " + addon.Describe() + " (" + file + ")");
            }
            if (found == 0) Refuse(file, "no class implements IGenieAddon.");
        }

        // An addon's property getter is its code; a throwing one shouldn't stop the load.
        private static string ReadSafely(Func<string> read) {
            try {
                return read();
            } catch {
                return null;
            }
        }

        // Null if usable, else why not.
        private static string CheckName(string name) {
            if (name == null || name.Trim().Length == 0) return "its Name is empty.";
            name = name.Trim();
            foreach (string reserved in ReservedNames) {
                if (string.Equals(name, reserved, StringComparison.OrdinalIgnoreCase))
                    return "the name '" + name + "' is reserved.";
            }
            foreach (LoadedAddon addon in AddonRegistry.Loaded) {
                if (string.Equals(addon.Name, name, StringComparison.OrdinalIgnoreCase))
                    return "the name '" + name + "' is taken by " + addon.FileName + ".";
            }
            return null;
        }

        // Refused: a valid addon that breaks a rule. Failed: it couldn't be loaded at all.
        private static void Refuse(string file, string reason) {
            NotLoaded(file, "Refused", reason);
        }
        private static void Fail(string file, string reason) {
            NotLoaded(file, "Failed", reason);
        }

        private static void NotLoaded(string file, string verb, string reason) {
            AddonRegistry.Refused.Add(new KeyValuePair<string, string>(file, reason));
            GenieBootstrap.Log(verb + " " + file + ": " + reason);
        }

        private static Assembly Compile(string file, List<string> errors) {
            Microsoft.CSharp.CSharpCodeProvider        provider = new Microsoft.CSharp.CSharpCodeProvider();
            System.CodeDom.Compiler.CompilerParameters p        = new System.CodeDom.Compiler.CompilerParameters();
            p.GenerateInMemory                                  = true;
            p.GenerateExecutable                                = false;
            p.CompilerOptions                                   = "/unsafe"; // addons may do native engine interop

            string fw = Environment.GetEnvironmentVariable("windir") + @"\Microsoft.NET\Framework64\v4.0.30319";
            p.ReferencedAssemblies.Add(Assembly.GetExecutingAssembly().Location); // the framework
            p.ReferencedAssemblies.Add("System.dll");
            p.ReferencedAssemblies.Add("System.Core.dll"); // HashSet, LINQ
            p.ReferencedAssemblies.Add(FrameworkAssembly(fw, "PresentationFramework.dll"));
            p.ReferencedAssemblies.Add(FrameworkAssembly(fw, "PresentationCore.dll"));
            p.ReferencedAssemblies.Add(FrameworkAssembly(fw, "WindowsBase.dll"));
            p.ReferencedAssemblies.Add(FrameworkAssembly(fw, "System.Xaml.dll"));

            System.CodeDom.Compiler.CompilerResults results = provider.CompileAssemblyFromFile(p, file);
            if (!results.Errors.HasErrors) return results.CompiledAssembly;

            // "MyAddon.cs(42,17): error CS0246: ...", file name only.
            foreach (System.CodeDom.Compiler.CompilerError e in results.Errors) {
                if (e.IsWarning) continue;
                errors.Add(Path.GetFileName(e.FileName ?? file) + "(" + e.Line + "," + e.Column + "): error " +
                           e.ErrorNumber + ": " + e.ErrorText);
            }
            return null;
        }

        // The WPF assemblies live in a WPF subfolder of the .NET folder.
        private static string FrameworkAssembly(string fw, string name) {
            string wpf = fw + "\\WPF\\" + name;
            if (File.Exists(wpf)) return wpf;
            string root = fw + "\\" + name;
            if (File.Exists(root)) return root;
            return name;
        }

        private static List<Type> LoadableTypes(Assembly assembly) {
            try {
                return new List<Type>(assembly.GetTypes());
            } catch (ReflectionTypeLoadException ex) {
                List<Type> loaded = new List<Type>();
                foreach (Type t in ex.Types) {
                    if (t != null) loaded.Add(t);
                }
                return loaded;
            }
        }
    }

    // Errors that reach the UI thread unhandled. One with the framework or an addon in its stack trace is ours: it's
    // logged, the editor carries on, and the user is told once per addon. An addon's third turns it off for the
    // session: windows closed, tray buttons gone, menu item greyed. Its event handlers can't be unhooked, so later
    // errors are still caught, quietly. An error with none of ours in its stack is the editor's and crashes as before.
    // Access violations never come here (.NET 4 keeps corrupted-state exceptions from managed handlers), so a bad
    // write to host memory still ends the editor, as it should.
    internal static class AddonFaults {
        private const int MaxFaults  = 3;  // an addon's errors before it's turned off
        private const int MaxHandled = 50; // the session's, before we stop holding the editor up: something is looping

        private static readonly Dictionary<LoadedAddon, int> _counts = new Dictionary<LoadedAddon, int>();
        private static readonly List<LoadedAddon> _told              = new List<LoadedAddon>();
        private static readonly List<LoadedAddon> _off               = new List<LoadedAddon>();
        private static readonly Queue<KeyValuePair<LoadedAddon, bool>> _notices =
            new Queue<KeyValuePair<LoadedAddon, bool>>(); // addon, turned off
        private static int  _handled;
        private static bool _showing;

        internal static bool IsOff(LoadedAddon addon) {
            return _off.Contains(addon);
        }

        /// <summary>True if the error was ours and is handled: the editor carries on.</summary>
        internal static bool Handle(Exception error) {
            try {
                LoadedAddon owner = OwnerOf(error);
                if (owner == null) return false;
                if (++_handled > MaxHandled) {
                    if (_handled == MaxHandled + 1)
                        GenieBootstrap.Log(MaxHandled + " errors caught this session; no longer keeping the editor " +
                                           "up after one.");
                    return false;
                }
                int count;
                _counts.TryGetValue(owner, out count);
                _counts[owner] = ++count;

                if (IsOff(owner)) { // already said, at length
                    GenieBootstrap.Log(owner.Name + " (off) error: " + error.GetType().Name + ": " + error.Message);
                    return true;
                }
                GenieBootstrap.Log(owner.Name + " error " + count + ", caught; the editor carries on: " + error);
                bool turnOff = owner != AddonRegistry.Framework && count >= MaxFaults;
                if (turnOff) TurnOff(owner);
                if (turnOff || !_told.Contains(owner)) {
                    _told.Add(owner);
                    Tell(owner, turnOff);
                }
                return true;
            } catch (Exception ex) {
                GenieBootstrap.Log("Handling an error failed: " + ex);
                return false;
            }
        }

        // The addon nearest the throw, else the framework if it's in the stack, else null. Inner exceptions too: a
        // handler run through reflection comes wrapped. An addon's frame can be missing (the JIT turns a last-statement
        // call into a tail call), so an error caused by an addon can look like the framework's or the editor's.
        private static LoadedAddon OwnerOf(Exception error) {
            bool framework = false;
            for (Exception e = error; e != null; e = e.InnerException) {
                System.Diagnostics.StackFrame[] frames = new System.Diagnostics.StackTrace(e, false).GetFrames();
                if (frames == null) continue;
                foreach (System.Diagnostics.StackFrame f in frames) {
                    MethodBase method = f.GetMethod();
                    Type       type   = method == null ? null : method.DeclaringType;
                    if (type == null) continue;
                    LoadedAddon addon = AddonRegistry.AddonFor(type.Assembly);
                    if (addon == AddonRegistry.Framework)
                        framework = true;
                    else if (addon != null)
                        return addon;
                }
            }
            return framework ? AddonRegistry.Framework : null;
        }

        private static void TurnOff(LoadedAddon addon) {
            _off.Add(addon);
            GenieBootstrap.Log("Turned off " + addon.Name + " for this session after " + MaxFaults + " errors.");
            GenieWindow.CloseAllOf(addon);
            GenieTray.RemoveButtonsOf(addon.Assembly);
            MenuNative.Disable(AddonRegistry.Loaded.IndexOf(addon),
                               "Turned off after " + MaxFaults + " errors. Restart the editor to use it again.");
        }

        // After the error's handler returns, one dialog at a time: errors while one is open queue behind it.
        private static void Tell(LoadedAddon addon, bool turnedOff) {
            _notices.Enqueue(new KeyValuePair<LoadedAddon, bool>(addon, turnedOff));
            if (_showing || Application.Current == null) return;
            _showing = true;
            Application.Current.Dispatcher.BeginInvoke(DispatcherPriority.Background, (Action)ShowQueued);
        }

        private static void ShowQueued() {
            try {
                while (_notices.Count > 0) {
                    KeyValuePair<LoadedAddon, bool> n = _notices.Dequeue();
                    if (Show(n.Key, n.Value)) FrameworkWindows.ShowLogs();
                }
            } catch (Exception ex) {
                GenieBootstrap.Log("Error notice failed: " + ex.Message);
            } finally {
                _showing = false;
            }
        }

        // True if the user chose View Logs.
        private static bool Show(LoadedAddon addon, bool turnedOff) {
            string question, detail, note;
            if (turnedOff) {
                question = addon.Name + " was turned off";
                detail   = "It hit " + MaxFaults + " errors this session.";
                note     = "Its windows are closed and its menu item is off until the editor restarts. Its last " +
                       "action may not have finished, so check your work and save.";
            } else {
                question = addon.Name + " hit an error";
                detail   = "The editor is still running.";
                note     = "Its last action may not have finished, so check your work and save. " +
                       (addon == AddonRegistry.Framework
                            ? "Further errors are logged without this notice."
                            : "After " + MaxFaults + " errors it's turned off until the editor restarts.");
            }
            // Warning, so View Logs isn't red as Danger would make it; the icon is Danger's.
            FrameworkElement icon = Genie.ControlUtils.CreateDialogIcon(Genie.ControlUtils.TagTone.Danger);
            return GenieDialog.Show(null, question, detail, new[] { "View Logs" }, note, null,
                                    Genie.ControlUtils.TagTone.Warning, icon, "OK") == 0;
        }
    }

    internal sealed class LoadedAddon {
        internal IGenieAddon Instance;
        internal Assembly    Assembly;
        internal string      Name;
        internal string      Tooltip;
        internal string      Version;
        internal string      Author;
        internal string      FileName;

        // "1.0" -> "v1.0". Anything not starting with a digit ("v1.0", "beta 3") is shown as written,
        // so a "v" is never doubled.
        internal static string FormatVersion(string version) {
            return (!string.IsNullOrEmpty(version) && char.IsDigit(version[0])) ? "v" + version : (version ?? "");
        }

        internal string DisplayVersion {
            get { return FormatVersion(Version); }
        }

        // "v1.0 by SurferJay", "v1.0", "by SurferJay", or null when both are empty.
        internal string Credit {
            get {
                bool hasVersion = !string.IsNullOrEmpty(Version);
                bool hasAuthor  = !string.IsNullOrEmpty(Author);
                if (!hasVersion && !hasAuthor) return null;
                return (hasVersion ? DisplayVersion : "") + (hasVersion && hasAuthor ? " " : "") +
                       (hasAuthor ? "by " + Author : "");
            }
        }

        // "Redirector Manager v1.0 by SurferJay"
        internal string Describe() {
            string credit = Credit;
            return (credit == null) ? Name : Name + " " + credit;
        }
    }

    // Which addons are loaded, and which code belongs to which.
    internal static class AddonRegistry {
        private static readonly Assembly _framework = typeof(AddonRegistry).Assembly;

        internal static readonly List<LoadedAddon> Loaded = new List<LoadedAddon>();
        internal static readonly List<KeyValuePair<string, string>> Refused =
            new List<KeyValuePair<string, string>>(); // file, reason

        private static readonly Dictionary<Assembly, string> _tags = new Dictionary<Assembly, string>();
        private static readonly Dictionary<string, Assembly> _files =
            new Dictionary<string, Assembly>(StringComparer.OrdinalIgnoreCase); // file name, not path
        private static readonly Dictionary<string, IniFile> _configs =
            new Dictionary<string, IniFile>(StringComparer.OrdinalIgnoreCase);
        private static readonly Dictionary<Assembly, bool> _warnedEarly = new Dictionary<Assembly, bool>();

        // Described like an addon, so its windows get the same name, version and author handling.
        internal static readonly LoadedAddon Framework = new LoadedAddon {
            Name = LogStore.FrameworkTag, Version = Genie.Version, Author = Genie.Author, FileName = "",
            Assembly = _framework,
        };

        // Right after a file compiles, before any of its code runs. Lines logged before Register (from a constructor
        // or a Name getter) are tagged with the file name, and lines from a file that's then refused keep it.
        internal static void Claim(Assembly assembly, string fileName) {
            lock (_tags) {
                _files[fileName] = assembly;
                _tags[assembly]  = fileName;
            }
        }

        internal static void Register(LoadedAddon addon) {
            Loaded.Add(addon);
            lock (_tags) {
                string tag;
                if (!_tags.TryGetValue(addon.Assembly, out tag) || tag == addon.FileName)
                    _tags[addon.Assembly] = addon.Name; // first addon names the file
            }
        }

        // Public methods that act for "your addon" take a [CallerFilePath] parameter and look the addon up here,
        // rather than using Assembly.GetCallingAssembly: when the call is the last statement of an addon method,
        // the JIT can make it a tail call, which removes the addon's frame, so the caller looks like whoever called
        // the addon (WPF, or the framework running a callback).
        private static readonly string FrameworkFile = SourceFile();

        private static string SourceFile([CallerFilePath] string file = null) {
            return file;
        }

        /// <summary>The assembly compiled from this source file (an addon's, or the framework's), or null.</summary>
        internal static Assembly AssemblyOf(string callerFile) {
            if (string.IsNullOrEmpty(callerFile)) return null;
            if (string.Equals(callerFile, FrameworkFile, StringComparison.OrdinalIgnoreCase)) return _framework;
            Assembly assembly;
            lock (_tags) {
                return _files.TryGetValue(Path.GetFileName(callerFile), out assembly) ? assembly : null;
            }
        }

        /// <summary>The addon whose code this is: a loaded addon, the framework, or null.</summary>
        internal static LoadedAddon AddonFor(Assembly caller) {
            if (caller == _framework) return Framework;
            foreach (LoadedAddon addon in Loaded) {
                if (addon.Assembly == caller) return addon;
            }
            return null;
        }

        internal static string TagFor(Assembly caller) {
            if (caller == _framework) return LogStore.FrameworkTag;
            string tag;
            lock (_tags) {
                if (caller != null && _tags.TryGetValue(caller, out tag)) return tag;
            }
            return "unknown";
        }

        // Null for a file whose addon isn't registered yet: its settings file is named after the addon, and the name
        // isn't known until then. Callers treat null as no settings: defaults, nothing saved.
        internal static IniFile ConfigFor(Assembly caller) {
            if (IsUnregistered(caller)) {
                WarnEarlySettings(caller);
                return null;
            }
            string owner = TagFor(caller);
            lock (_configs) {
                IniFile config;
                if (_configs.TryGetValue(owner, out config)) return config;
                string name     = Genie.FileUtils.ToSafeFileName(owner) + ".ini";
                config          = new IniFile(Path.Combine(GenieBootstrap.ConfigDir, name), ConfigHeader(owner));
                _configs[owner] = config;
                return config;
            }
        }

        // Named as the settings file is, so an addon's two places on disk match.
        internal static string DataFolderFor(Assembly caller) {
            if (caller == null || IsUnregistered(caller)) return null;
            return Path.Combine(GenieBootstrap.DataDir, Genie.FileUtils.ToSafeFileName(TagFor(caller)));
        }

        // Compiled and claimed, but no addon registered: still loading, or refused.
        private static bool IsUnregistered(Assembly caller) {
            if (caller == null || caller == _framework || AddonFor(caller) != null) return false;
            lock (_tags) {
                return _tags.ContainsKey(caller);
            }
        }

        private static void WarnEarlySettings(Assembly caller) {
            lock (_warnedEarly) {
                if (_warnedEarly.ContainsKey(caller)) return;
                _warnedEarly[caller] = true;
            }
            GenieBootstrap.Log(TagFor(caller) + " used its settings before Initialize, so it got defaults and " +
                               "nothing was saved. Move that code to Initialize.");
        }

        private static string[] ConfigHeader(string owner) {
            if (owner == LogStore.FrameworkTag) {
                return new string[] {
                    "; AddonGenie: the addon framework's own settings.",
                    "; This file belongs to the framework, not to an addon. Each addon keeps its",
                    "; settings in its own file in this folder. Delete a file to reset its defaults."
                };
            }
            return new string[] { "; Settings for the \"" + owner + "\" addon (loaded by AddonGenie).",
                                  "; Delete this file to reset this addon's settings to their defaults.",
                                  "; Lists separate items with |. In an item, ^| is a | and ^^ is a ^." };
        }

    }

    // == Addons Menu ==================================================================================
    // On the editor's menu bar:
    //   <each addon>
    //   ─────────────
    //   Options        ▸ (MenuOptions)
    //   ─────────────
    //   View Logs
    //   View Configs
    //   Clear Window Positions
    //   ─────────────
    //   About & Help

    internal static class MenuNative {
        private const uint MF_BYPOSITION = 0x400;

        [DllImport("user32.dll")]
        private static extern int GetMenuItemCount(IntPtr hMenu);
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern int GetMenuStringW(IntPtr hMenu, uint item, StringBuilder text, int max, uint flags);
        [DllImport("user32.dll")]
        private static extern uint GetMenuItemID(IntPtr hMenu, int position);
        [DllImport("user32.dll")]
        private static extern bool PostMessageW(IntPtr hWnd, uint msg, IntPtr w, IntPtr l);

        // The command id of one of the editor's own menu items, found by its English labels ("View", "Browser Windows",
        // "Log"), or -1. The ids aren't ours to assume; the menu is what the editor itself offers.
        internal static int FindEditorCommand(IntPtr frame, params string[] path) {
            IntPtr menu = frame == IntPtr.Zero ? IntPtr.Zero : GetMenu(frame);
            for (int level = 0; level < path.Length && menu != IntPtr.Zero; level++) {
                int at = FindItem(menu, path[level]);
                if (at < 0) return -1;
                if (level == path.Length - 1) return (int)GetMenuItemID(menu, at);
                menu = GetSubMenu(menu, at);
            }
            return -1;
        }

        private static int FindItem(IntPtr menu, string label) {
            int           count = GetMenuItemCount(menu);
            StringBuilder text  = new StringBuilder(128);
            for (int i = 0; i < count; i++) {
                text.Length = 0;
                if (GetMenuStringW(menu, (uint)i, text, text.Capacity, MF_BYPOSITION) <= 0) continue;
                string item  = text.ToString();
                int    tab   = item.IndexOf('\t'); // an accelerator follows
                string shown = (tab >= 0 ? item.Substring(0, tab) : item).Replace("&", "").Trim();
                if (string.Equals(shown, label, StringComparison.OrdinalIgnoreCase)) return i;
            }
            return -1;
        }

        // As choosing the item does. Posted, so it runs from the message loop, not inside the caller.
        internal static void RunEditorCommand(IntPtr frame, int command) {
            PostMessageW(frame, WM_COMMAND, new IntPtr(command), IntPtr.Zero);
        }

        internal delegate void   CommandHandler(int index);
        internal delegate IntPtr SubclassProc(IntPtr hWnd, uint msg, IntPtr w, IntPtr l, UIntPtr id, IntPtr data);
        private delegate bool    EnumProc(IntPtr h, IntPtr p);

        // Handler indices for the framework's own entries; addons get 0..n-1.
        internal const int ViewLogs     = -1;
        internal const int AboutHelp    = -2;
        internal const int ViewConfigs  = -3;
        internal const int ResetWindows = -4;

        private const int IdBase    = 0xE100;
        private const int MaxAddons = 0x1F0;
        private const int IdLogs    = IdBase + MaxAddons;
        private const int IdAbout   = IdBase + MaxAddons + 1;
        private const int IdConfigs = IdBase + MaxAddons + 2;

        internal const int IdOptions  = IdBase + MaxAddons + 3; // MenuOptions' block, up to the limit below
        internal const int MaxOptions = 500;

        private const int IdResetWindows = IdOptions + MaxOptions; // after Options' block

        private const string LogsTip    = "Show the addons-specific log";
        private const string ConfigsTip = "Open the addons settings folder";
        private const string ResetTip   = "Forget where windows were and their sizes";
        private const string AboutTip   = "What addons are and how to write them";
        private const string OptionsTip = "Settings for AddonGenie and each addon";

        private const uint MF_STRING         = 0x0;
        private const uint MF_GRAYED         = 0x1;
        private const uint MF_POPUP          = 0x10;
        private const uint MF_SEPARATOR      = 0x800;
        private const uint WM_COMMAND        = 0x0111;
        private const uint WM_MENUSELECT     = 0x011F;
        private const uint SB_GETPARTS       = 0x0406;
        private const uint SB_SETTEXTW       = 0x040B;
        private const uint SB_GETTEXTLENGTHW = 0x040C;
        private const uint SB_GETTEXTW       = 0x040D;

        // The editor (wxWidgets) shows the highlighted item's help in status bar part 5 of 17 (measured with
        // a diagnostic build), blanks it for items it doesn't know (ours), and restores the part's text when
        // the menu closes. We fill it for our items only, after the editor has handled the highlight, and only
        // ever clear text we wrote, so the editor's own help text is never overwritten.
        private const int HelpPart      = 5;
        private const int ExpectedParts = 17;

        private static CommandHandler _onCommand;
        private static SubclassProc   _proc;     // static: the GC must not collect a live subclass callback
        private static EnumProc       _enumProc; // likewise, during EnumChildWindows
        private static string[] _tooltips = new string[0];
        private static int    _count;
        private static IntPtr _statusBar = IntPtr.Zero;
        private static bool   _helpUsable;
        private static string _shownHelp;   // our text currently in the help part, or null
        private static IntPtr _optionsMenu; // Addons > Options, for its help
        private static IntPtr _addonsMenu;  // the Addons menu, for greying an item

        [DllImport("user32.dll")]
        private static extern IntPtr GetMenu(IntPtr hWnd);
        [DllImport("user32.dll")]
        private static extern IntPtr GetSubMenu(IntPtr hMenu, int position);
        [DllImport("user32.dll")]
        private static extern IntPtr CreatePopupMenu();
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern bool AppendMenuW(IntPtr hMenu, uint flags, UIntPtr id, string item);
        [DllImport("user32.dll")]
        private static extern bool DrawMenuBar(IntPtr hWnd);
        [DllImport("user32.dll")]
        private static extern bool EnableMenuItem(IntPtr hMenu, uint id, uint flags);
        [DllImport("user32.dll")]
        private static extern bool EnumChildWindows(IntPtr parent, EnumProc cb, IntPtr p);
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern int GetClassNameW(IntPtr h, StringBuilder s, int max);
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern IntPtr SendMessageW(IntPtr h, uint msg, IntPtr w, string l);
        [DllImport("user32.dll", CharSet = CharSet.Unicode, EntryPoint = "SendMessageW")]
        private static extern IntPtr SendMessageBuf(IntPtr h, uint msg, IntPtr w, StringBuilder l);
        [DllImport("user32.dll", EntryPoint = "SendMessageW")]
        private static extern IntPtr SendMessagePtr(IntPtr h, uint msg, IntPtr w, IntPtr l);
        [DllImport("comctl32.dll")]
        private static extern bool SetWindowSubclass(IntPtr h, SubclassProc proc, UIntPtr id, IntPtr data);
        [DllImport("comctl32.dll")]
        private static extern IntPtr DefSubclassProc(IntPtr h, uint msg, IntPtr w, IntPtr l);

        // Subclassing (comctl32) adds our handler in front of the editor's; everything else passes through.
        internal static void Install(IntPtr frame, List<LoadedAddon> addons, CommandHandler onCommand,
                                     Action<string> log) {
            _onCommand = onCommand;
            _count     = Math.Min(addons.Count, MaxAddons);
            _tooltips  = new string[_count];

            IntPtr bar = GetMenu(frame);
            if (bar == IntPtr.Zero) {
                log("Install: no menu bar.");
                return;
            }

            IntPtr menu = CreatePopupMenu();
            _addonsMenu = menu;
            if (_count == 0)
                AppendMenuW(menu, MF_STRING | MF_GRAYED, new UIntPtr(1), "(no addons: put .cs files in Addons\\)");
            for (int i = 0; i < _count; i++) {
                _tooltips[i] = addons[i].Tooltip;
                AppendMenuW(menu, MF_STRING, new UIntPtr((uint)(IdBase + i)), addons[i].Name);
            }
            AppendMenuW(menu, MF_SEPARATOR, UIntPtr.Zero, null);
            IntPtr options = CreatePopupMenu();
            _optionsMenu   = options;
            AppendMenuW(menu, MF_POPUP | MF_STRING, new UIntPtr((ulong)options.ToInt64()), "Options");
            AppendMenuW(menu, MF_SEPARATOR, UIntPtr.Zero, null);
            AppendMenuW(menu, MF_STRING, new UIntPtr((uint)IdLogs), "View Logs");
            AppendMenuW(menu, MF_STRING, new UIntPtr((uint)IdConfigs), "View Configs");
            AppendMenuW(menu, MF_STRING, new UIntPtr((uint)IdResetWindows), "Clear Window Positions");
            AppendMenuW(menu, MF_SEPARATOR, UIntPtr.Zero, null);
            AppendMenuW(menu, MF_STRING, new UIntPtr((uint)IdAbout), "About && Help"); // && is a literal &
            AppendMenuW(bar, MF_POPUP | MF_STRING, new UIntPtr((ulong)menu.ToInt64()), "Addons");
            DrawMenuBar(frame);
            MenuOptions.Attach(options);

            _statusBar  = FindStatusBar(frame);
            int parts   = (_statusBar == IntPtr.Zero)
                              ? 0
                              : (int)SendMessagePtr(_statusBar, SB_GETPARTS, IntPtr.Zero, IntPtr.Zero);
            _helpUsable = (parts == ExpectedParts);
            if (!_helpUsable)
                log("Menu help off: the status bar has " + parts + " parts, not the expected " + ExpectedParts + ".");

            _proc = new SubclassProc(Proc);
            SetWindowSubclass(frame, _proc, new UIntPtr(1), IntPtr.Zero);
        }

        /// <summary>Greys an addon's item (its index in AddonRegistry.Loaded); help: its status-bar text now.</summary>
        internal static void Disable(int index, string help) {
            if (_addonsMenu == IntPtr.Zero || index < 0 || index >= _count) return;
            EnableMenuItem(_addonsMenu, (uint)(IdBase + index), MF_GRAYED); // MF_BYCOMMAND is 0
            _tooltips[index] = help;
        }

        private static IntPtr FindStatusBar(IntPtr frame) {
            IntPtr found = IntPtr.Zero;
            _enumProc    = delegate(IntPtr child, IntPtr p) {
                StringBuilder cls = new StringBuilder(64);
                GetClassNameW(child, cls, 64);
                if (cls.ToString().IndexOf("msctls_statusbar32", StringComparison.OrdinalIgnoreCase) < 0) return true;
                found = child;
                return false;
            };
            try {
                EnumChildWindows(frame, _enumProc, IntPtr.Zero);
            } catch {}
            return found;
        }

        private static IntPtr Proc(IntPtr h, uint msg, IntPtr w, IntPtr l, UIntPtr id, IntPtr data) {
            if (msg == WM_COMMAND) {
                if (MenuOptions.Run((int)((long)w & 0xFFFF))) return IntPtr.Zero;
                int? index = IndexOf((int)((long)w & 0xFFFF));
                if (index.HasValue) {
                    try {
                        if (_onCommand != null) _onCommand(index.Value);
                    } catch {}
                    return IntPtr.Zero;
                }
            } else if (msg == WM_MENUSELECT && _helpUsable) {
                IntPtr result = DefSubclassProc(h, msg, w, l); // the editor updates its help part first
                try {
                    SetMenuHelp(w, l);
                } catch {}
                return result;
            }
            return DefSubclassProc(h, msg, w, l);
        }

        // Our item or submenu highlighted: show its help. Anything else (an editor item, a separator, the menu
        // closing): remove our text if it's still showing, and nothing else. For a submenu, the low word is its
        // position in menu, not an id.
        private static void SetMenuHelp(IntPtr wParam, IntPtr menu) {
            long   w     = (long)wParam;
            uint   flags = (uint)((w >> 16) & 0xFFFF);
            int    low   = (int)(w & 0xFFFF);
            string tip   = null;
            bool   open  = flags != 0xFFFF; // 0xFFFF: the menu closed
            if (open && (flags & MF_POPUP) != 0) {
                IntPtr sub = GetSubMenu(menu, low);
                tip        = sub == _optionsMenu ? OptionsTip : MenuOptions.HelpForMenu(sub);
            } else if (open) {
                int? index = IndexOf(low);
                tip        = index.HasValue ? TipFor(index.Value) : MenuOptions.HelpFor(low);
            }
            if (tip != null) {
                SendMessageW(_statusBar, SB_SETTEXTW, new IntPtr(HelpPart), tip);
                _shownHelp = tip;
            } else if (_shownHelp != null) {
                if (string.Equals(ReadPart(HelpPart), _shownHelp, StringComparison.Ordinal))
                    SendMessageW(_statusBar, SB_SETTEXTW, new IntPtr(HelpPart), "");
                _shownHelp = null;
            }
        }

        private static string TipFor(int index) {
            switch (index) {
                case ViewLogs:
                    return LogsTip;
                case ViewConfigs:
                    return ConfigsTip;
                case ResetWindows:
                    return ResetTip;
                case AboutHelp:
                    return AboutTip;
                default:
                    return _tooltips[index] ?? "";
            }
        }

        private static string ReadPart(int part) {
            IntPtr        length = SendMessagePtr(_statusBar, SB_GETTEXTLENGTHW, new IntPtr(part), IntPtr.Zero);
            StringBuilder sb     = new StringBuilder((int)((long)length & 0xFFFF) + 1); // low word: the length
            SendMessageBuf(_statusBar, SB_GETTEXTW, new IntPtr(part), sb);
            return sb.ToString();
        }

        // Menu command id -> handler index, or null if the item isn't ours.
        private static int? IndexOf(int id) {
            if (id >= IdBase && id < IdBase + _count) return id - IdBase;
            switch (id) {
                case IdLogs:
                    return ViewLogs;
                case IdConfigs:
                    return ViewConfigs;
                case IdResetWindows:
                    return ResetWindows;
                case IdAbout:
                    return AboutHelp;
                default:
                    return null;
            }
        }
    }

    // == Open packages dialogs ========================================================================
    // ContentBrowserUtils.OpenPackages: before the load, which copy of a name; after it, what opened and what it needs.

    internal static class OpenPackagesDialogs {
        internal const string OpenPackagesTitle = "Open packages";

        private const double ChoiceWidth      = 580;
        private const double ChoiceListHeight = 340;

        // One name, one file, and a load can't be taken back, so the user picks first. The files to open, or null if
        // cancelled.
        internal static string[] ChooseCopies(Visual within, string[] files) {
            List<string>                     names = new List<string>();
            Dictionary<string, List<string>> copies =
                new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
            foreach (string file in files) {
                string       name = Path.GetFileNameWithoutExtension(file);
                List<string> list;
                if (!copies.TryGetValue(name, out list)) {
                    copies[name] = list = new List<string>();
                    names.Add(name);
                }
                if (!list.Exists(o => Genie.FileUtils.IsSamePath(o, file))) list.Add(file);
            }
            names.RemoveAll(n => copies[n].Count < 2);
            if (names.Count == 0) return files;

            Dictionary<string, string> chosen = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            Button                     open   = null;
            List<UIElement>            items  = new List<UIElement>();
            foreach (string name in names) {
                items.Add(CopyGroup(name, copies[name], delegate(string file) {
                    chosen[name]   = file;
                    open.IsEnabled = chosen.Count == names.Count;
                }));
            }
            bool   twice = names.TrueForAll(n => copies[n].Count == 2);
            string title = Genie.TextUtils.Count(names.Count, "package") + (names.Count == 1 ? " was" : " were") +
                           (twice ? " selected twice" : " selected more than once");
            int answer =
                GenieDialog.Show(within, title, "A package name can come from only one file. Choose which to open.",
                                 new[] { "Open" }, null, items, Genie.ControlUtils.TagTone.Warning,
                                 Genie.ControlUtils.CreateDialogIcon(Genie.ControlUtils.TagTone.Warning,
                                                                     Genie.ControlUtils.DialogSymbol.Default),
                                 null, ChoiceWidth, ChoiceListHeight, delegate(Button go) {
                                     open         = go;
                                     go.IsEnabled = false;
                                 }, OpenPackagesTitle);
            if (answer != 0) return null;
            return Array.FindAll(files, delegate(string file) {
                string pick;
                return !chosen.TryGetValue(Path.GetFileNameWithoutExtension(file), out pick) ||
                       Genie.FileUtils.IsSamePath(pick, file);
            });
        }

        private static UIElement CopyGroup(string name, List<string> files, Action<string> onChosen) {
            string extension = Path.GetExtension(files[0]);
            bool   sameKind  = files.TrueForAll(
                f => string.Equals(Path.GetExtension(f), extension, StringComparison.OrdinalIgnoreCase));
            TextBlock heading =
                Genie.ControlUtils.CreateMonoText(sameKind ? name + extension : name, Genie.Theme.FontSizeLabel);
            heading.FontWeight = FontWeights.SemiBold;
            StackPanel group   = new StackPanel();
            group.Children.Add(new Border {
                Child      = heading,
                Background = Genie.Theme.FieldLabelBackground,
                Padding    = new Thickness(9, 5, 9, 5),
            });
            foreach (string file in files) {
                string shown =
                    Genie.FileUtils.ShortFolder(file) + (sameKind ? "" : "  (" + Path.GetExtension(file) + ")");
                RadioButton copy  = Genie.ControlUtils.CreateRadioButton(shown, false, file);
                copy.GroupName    = name;
                copy.FontFamily   = Genie.Theme.MonoFont;
                copy.Margin       = new Thickness(9, 5, 9, 5);
                copy.Checked     += delegate {
                    onChosen(file);
                };
                group.Children.Add(new Border {
                    Child           = copy,
                    BorderBrush     = Genie.Theme.Separator,
                    BorderThickness = new Thickness(0, 1, 0, 0),
                });
            }
            return new Border {
                Child               = group,
                BorderBrush         = Genie.Theme.Separator,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(Genie.Theme.BoxCornerRadius),
                SnapsToDevicePixels = true,
            };
        }
    }

    // What an open did, as a tree: each package, and under it what it needs. The load errors say what failed; the
    // import tables of what opened say which package needs what.
    internal sealed class OpenPackagesReport {
        private const double Width = 640, ListHeight = 340;

        private static GenieWindow _window;

        private const int    NamedObjects = 2;

        private static readonly System.Text.RegularExpressions.Regex MissingFile =
            new System.Text.RegularExpressions.Regex("^Can't find file for package '([^']+)' while loading (.+)$");

        private sealed class Dependency {
            internal string Name;
            internal bool   IsMissing;
            internal List<string> Unresolved = new List<string>(), Absent = new List<string>();
        }

        private sealed class Entry {
            internal string Name, Tag = "Dependency";
            internal Genie.ControlUtils.TagTone Tone = Genie.ControlUtils.TagTone.Neutral;
            internal bool                       IsOpened;
            internal List<string> Notes     = new List<string>();
            internal List<Dependency> Needs = new List<Dependency>();
        }

        private readonly List<Entry> _entries = new List<Entry>();
        private readonly Dictionary<string, string> _missing = // name: the package reported as needing it
            new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        private readonly List<KeyValuePair<string, Genie.PackageUtils.LoadError>> _objects =
            new List<KeyValuePair<string, Genie.PackageUtils.LoadError>>();

        internal void AddListed(string name, string file) {
            Entry e = EntryFor(name);
            e.Tag   = "Already listed";
            e.Tone  = Genie.ControlUtils.TagTone.Warning;
            e.Notes.Add("From " + file);
            GenieBootstrap.Log("Open packages: " + name + " is already listed, from " + file);
        }

        internal void Add(Genie.PackageUtils.LoadResult r) {
            Entry e    = EntryFor(r.PackageName);
            e.IsOpened = r.IsLoaded;
            e.Tag      = r.IsLoaded ? "Opened" : "Failed";
            e.Tone     = r.IsLoaded ? Genie.ControlUtils.TagTone.Success : Genie.ControlUtils.TagTone.Danger;
            if (r.Problem != null) {
                e.Notes.Add(r.Problem);
                GenieBootstrap.Log("Open packages: " + r.PackageName + ": " + r.Problem);
            }
            foreach (Genie.PackageUtils.LoadError error in r.Errors) {
                GenieBootstrap.Log("Open packages: " + r.PackageName + ": " + error.Description);
                if (error.Kind == Genie.PackageUtils.LoadErrorKind.MissingObject)
                    _objects.Add(new KeyValuePair<string, Genie.PackageUtils.LoadError>(r.PackageName, error));
                else if (!AddMissingPackage(error, r.PackageName))
                    e.Notes.Add(error.Description);
            }
        }

        // The errors say what failed; only their text names the package. Who needs it comes from the import tables
        // (Place): the file here, NULL in the same load's second report, is just the fallback.
        private bool AddMissingPackage(Genie.PackageUtils.LoadError error, string loading) {
            if (error.Kind != Genie.PackageUtils.LoadErrorKind.MissingPackage) return false;
            System.Text.RegularExpressions.Match m = MissingFile.Match(error.Text);
            if (!m.Success) return false;
            string name = m.Groups[1].Value, file = m.Groups[2].Value.Trim();
            if (file != "NULL")
                _missing[name] = Path.GetFileNameWithoutExtension(file);
            else if (!_missing.ContainsKey(name))
                _missing[name] = loading;
            return true;
        }

        // Each opened package's dependencies and missing objects, from its linker's import table.
        private void Place() {
            Dictionary<Entry, HashSet<string>> imported = new Dictionary<Entry, HashSet<string>>();
            foreach (Entry e in _entries.ToArray()) {
                IntPtr linker = e.IsOpened ? Genie.LinkerUtils.GetLinker(e.Name) : IntPtr.Zero;
                if (linker == IntPtr.Zero) continue;
                HashSet<string> paths = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                imported[e]           = paths;
                int count             = Genie.LinkerUtils.GetImportCount(linker);
                for (int i = 0; i < count; i++) {
                    string path = Genie.LinkerUtils.GetImport(linker, i).PathName;
                    if (path != null) paths.Add(path);
                }
                foreach (string package in Genie.LinkerUtils.GetImportedPackages(linker)) {
                    if (_missing.ContainsKey(package))
                        Need(e, package).IsMissing = true;
                    else if (!IsName(package, e.Name) && _entries.Exists(o => o.IsOpened && IsName(o.Name, package)))
                        Need(e, package);
                }
            }
            foreach (KeyValuePair<string, string> m in _missing) {
                bool placed = _entries.Exists(e => e.Needs.Exists(n => n.IsMissing && IsName(n.Name, m.Key)));
                if (!placed) Need(EntryFor(m.Value), m.Key).IsMissing = true;
            }
            foreach (KeyValuePair<string, Genie.PackageUtils.LoadError> o in _objects)
                PlaceObject(o.Key, o.Value, imported);
        }

        // "Pkg.Group.Object (Check the log...)", under every package importing it. The editor's other forms ("Class X
        // in Y") stay as they are, on the package whose load reported them.
        private void PlaceObject(string reporter, Genie.PackageUtils.LoadError error,
                                 Dictionary<Entry, HashSet<string>> imported) {
            string text = error.Text;
            int    cut  = text.IndexOf(" (", StringComparison.Ordinal);
            string path = cut > 0 ? text.Substring(0, cut) : text;
            int    dot  = path.IndexOf('.');
            if (dot <= 0 || path.IndexOf(' ') >= 0) {
                EntryFor(reporter).Notes.Add(error.Description);
                return;
            }
            string      package = path.Substring(0, dot), name = path.Substring(dot + 1);
            List<Entry> holders = new List<Entry>();
            foreach (KeyValuePair<Entry, HashSet<string>> i in imported) {
                if (i.Value.Contains(path)) holders.Add(i.Key);
            }
            if (holders.Count == 0) holders.Add(EntryFor(reporter));
            foreach (Entry holder in holders) {
                Dependency need    = Need(holder, package);
                need.IsMissing    |= _missing.ContainsKey(package);
                List<string> list  = need.IsMissing ? need.Unresolved : need.Absent;
                if (!list.Contains(name)) list.Add(name);
            }
        }

        internal void Show() {
            bool hasProblem =
                _missing.Count > 0 || _objects.Count > 0 || _entries.Exists(e => !e.IsOpened || e.Notes.Count > 0);
            if (!hasProblem) return;
            Place();

            HashSet<string> missing = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (Entry e in _entries) {
                foreach (Dependency d in e.Needs) {
                    if (d.IsMissing) missing.Add(d.Name);
                }
            }
            int    opened = _entries.FindAll(e => e.IsOpened).Count;
            string title = "Some packages didn't open cleanly", detail = null;
            if (missing.Count > 0) {
                title = Genie.TextUtils.Count(opened, "package") + " opened, " + missing.Count +
                        (missing.Count == 1 ? " dependency" : " dependencies") + " missing";
                detail = "Missing when these packages loaded, so references to them are unresolved.";
            }
            ShowWindow(title, detail);
        }

        // A window, not a modal dialog: a dialog's message loop keeps the editor's own from running, and the Log window
        // the button opens doesn't draw without it (black, or garbage when scrolled).
        private void ShowWindow(string title, string detail) {
            if (_window != null && _window.IsOpen) _window.Close();
            GenieWindow w        = Genie.WindowUtils.CreateWindow(OpenPackagesDialogs.OpenPackagesTitle, Width, 300);
            _window              = w;
            w.MinWidth           = 480;
            w.FitHeightToContent = true;
            w.ShowAddonInfo      = false;
            w.RememberIfOpen     = false; // about one open

            StackPanel text = new StackPanel();
            text.Children.Add(new TextBlock {
                Text         = title,
                FontSize     = Genie.Theme.FontSizeTitle - 1,
                FontWeight   = FontWeights.SemiBold,
                Foreground   = Genie.Theme.TextPrimary,
                TextWrapping = TextWrapping.Wrap,
                Margin       = new Thickness(0, 3, 0, 0),
            });
            if (detail != null) {
                TextBlock line = Genie.ControlUtils.CreateNoteText(detail);
                line.FontSize  = Genie.Theme.FontSizeBody;
                line.Margin    = new Thickness(0, 2, 0, 0);
                text.Children.Add(line);
            }
            StackPanel boxes = new StackPanel();
            foreach (UIElement box in Tree()) {
                ((FrameworkElement)box).Margin = new Thickness(0, 0, 0, 4);
                boxes.Children.Add(box);
            }
            text.Children.Add(new ScrollViewer {
                Content                     = boxes,
                MaxHeight                   = ListHeight,
                Margin                      = new Thickness(0, 10, 0, 0),
                VerticalScrollBarVisibility = ScrollBarVisibility.Auto,
                Focusable                   = false,
            });

            FrameworkElement icon  = Genie.ControlUtils.CreateDialogIcon(Genie.ControlUtils.TagTone.Warning);
            icon.Margin            = new Thickness(0, 0, 14, 0);
            icon.VerticalAlignment = VerticalAlignment.Top;
            Grid main              = new Grid { Margin = new Thickness(18, 18, 20, 14) };
            main.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
            main.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            main.Children.Add(icon);
            Grid.SetColumn(text, 1);
            main.Children.Add(text);

            DockPanel buttons = new DockPanel();
            IntPtr    frame   = Genie.WindowUtils.FindEditorFrame();
            int       log     = MenuNative.FindEditorCommand(frame, "View", "Browser Windows", "Log");
            if (log >= 0) {
                Button open = Genie.ControlUtils.CreateButton(
                    "Open log", tooltip: "The editor's log, which names the objects referring to what's missing");
                open.Margin  = new Thickness(0);
                open.Click  += delegate {
                    MenuNative.RunEditorCommand(frame, log);
                };
                DockPanel.SetDock(open, Dock.Left);
                buttons.Children.Add(open);
            }
            Button ok               = Genie.ControlUtils.CreateButton("OK");
            ok.MinWidth             = 84;
            ok.Margin               = new Thickness(0);
            ok.IsDefault            = true;
            ok.IsCancel             = true;
            ok.HorizontalAlignment  = HorizontalAlignment.Right;
            ok.Click               += delegate {
                w.Close();
            };
            buttons.Children.Add(ok);

            DockPanel root = new DockPanel();
            Border    strip =
                Genie.ControlUtils.CreateFooter(buttons, new Thickness(14, 10, 14, 10), Genie.Theme.PanelBackground);
            DockPanel.SetDock(strip, Dock.Bottom);
            root.Children.Add(strip);
            root.Children.Add(main);
            w.Content = root;
            w.Show();
        }

        // A box per package, as Package Renamer's prompt draws one; the dialog's list scrolls them.
        private List<UIElement> Tree() {
            List<UIElement> boxes = new List<UIElement>();
            foreach (Entry e in _entries) {
                GenieTreeBox box      = Genie.ControlUtils.CreateTreeBox(null, Genie.Theme.FontSizeLabel);
                box.MaxChildrenHeight = double.PositiveInfinity;
                box.SetRoot(e.Name, null, Tag(e.Tag, e.Tone));
                foreach (string note in e.Notes) box.AddNote(note, Genie.Theme.WarningTagText);
                e.Needs.Sort((a, b) => a.IsMissing.CompareTo(b.IsMissing));
                foreach (Dependency d in e.Needs) {
                    box.AddChild(d.Name,
                                 d.IsMissing ? Genie.ControlUtils.CreatePackageIcon(null, Genie.Theme.WarningTagText)
                                             : null,
                                 d.IsMissing ? Tag("Missing", Genie.ControlUtils.TagTone.Warning) : null);
                    if (d.Unresolved.Count > 0)
                        box.AddNote("Unresolved: " + Objects(d.Unresolved), Genie.Theme.WarningTagText);
                    if (d.Absent.Count > 0)
                        box.AddNote("Not in package: " + Objects(d.Absent), Genie.Theme.WarningTagText);
                }
                boxes.Add(box);
            }
            return boxes;
        }

        private static FrameworkElement Tag(string text, Genie.ControlUtils.TagTone tone) {
            return Genie.ControlUtils.CreateTag(text, tone, size: Genie.ControlUtils.TagSize.Small);
        }

        private static string Objects(List<string> names) {
            if (names.Count <= NamedObjects) return string.Join(", ", names);
            return string.Join(", ", names.GetRange(0, NamedObjects)) + " +" + (names.Count - NamedObjects);
        }

        private Entry EntryFor(string name) {
            Entry e = _entries.Find(o => IsName(o.Name, name));
            if (e == null) _entries.Add(e = new Entry { Name = name });
            return e;
        }

        private static Dependency Need(Entry entry, string name) {
            Dependency d = entry.Needs.Find(n => IsName(n.Name, name));
            if (d == null) entry.Needs.Add(d = new Dependency { Name = name });
            return d;
        }

        private static bool IsName(string a, string b) {
            return string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
        }
    }

    // == Open package button ==========================================================================
    // Addons > Options > Fix Dependency Handling for Open. Off, nothing is attached and the button is stock.

    internal static class OpenPackageReroute {
        private static GenieToggle _option;
        private const string       HookedTip = "Open external packages. AddonGenie resolves dependencies among them.";

        private static IDisposable    _taken;
        private static OpenButtonMark _mark;
        private static bool           _isEditorReady;

        internal static void Initialize(GenieToggle option) {
            _option         = option;
            option.Changed += delegate {
                Apply();
            };
            GenieBootstrap.WhenReady(delegate {
                _isEditorReady = true;
                Apply();
            }, "AddonGenie");
        }

        private static void Apply() {
            if (!_isEditorReady || _option.Value == (_taken != null)) return;
            if (_taken != null) {
                _taken.Dispose();
                _taken = null;
                if (_mark != null) _mark.Dispose();
                _mark = null;
                return;
            }
            _taken =
                Genie.ContentBrowserUtils.TakeOverPackageCommand("OpenPackage", Genie.ContentBrowserUtils.OpenPackages);
            if (_taken == null) {
                GenieBootstrap.Log("Couldn't reroute the Open package button: no such command.");
                return;
            }
            _mark = OpenButtonMark.Create(HookedTip);
        }
    }

    // A dot on the Open button's corner and its tooltip swapped, so a glance says the reroute is on: addons load after
    // the button appears. The browser has no adorner layer, so the dot sits in a zero-size canvas beside the button, as
    // the tray's GENIE tab does: it takes no room or clicks, and leaves the button as it was.
    internal sealed class OpenButtonMark : IDisposable {
        private const double DotSize = 8, DotOverhang = 3;

        private readonly Button _button;
        private readonly Panel  _parent;
        private readonly object _ownTip;
        private readonly Canvas _layer = new Canvas {
            Width               = 0,
            Height              = 0,
            IsHitTestVisible    = false,
            HorizontalAlignment = HorizontalAlignment.Left,
            VerticalAlignment   = VerticalAlignment.Top,
        };
        private readonly System.Windows.Shapes.Ellipse _dot = new System.Windows.Shapes.Ellipse {
            Width = DotSize,     Height = DotSize, Fill = Genie.Theme.TrayAccent, Stroke = Genie.Theme.TrayBadgeRing,
            StrokeThickness = 1,
        };

        // btnOpenPackage: an internal field of ContentBrowser.SourcesPanel. Null, logged, if it can't be marked.
        internal static OpenButtonMark Create(string tooltip) {
            const BindingFlags Any    = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
            object             main   = BrowserReflection.MainControl();
            object             panel  = BrowserReflection.Invoke0(main, "get_MySourcesPanel");
            FieldInfo          field  = panel != null ? panel.GetType().GetField("btnOpenPackage", Any) : null;
            Button             button = field != null ? field.GetValue(panel) as Button : null;
            Panel              parent = button != null ? button.Parent as Panel : null;
            if (parent == null || parent.IsItemsHost) {
                GenieBootstrap.Log("Couldn't mark the Open package button: it isn't where it was expected.");
                return null;
            }
            return new OpenButtonMark(button, parent, tooltip);
        }

        private OpenButtonMark(Button button, Panel parent, string tooltip) {
            _button = button;
            _parent = parent;
            _layer.Children.Add(_dot);
            Grid.SetRow(_layer, Grid.GetRow(button));
            Grid.SetColumn(_layer, Grid.GetColumn(button));
            DockPanel.SetDock(_layer, DockPanel.GetDock(button));
            Panel.SetZIndex(_layer, int.MaxValue);
            parent.Children.Insert(parent.Children.IndexOf(button), _layer); // before it: a DockPanel fills its last
            _ownTip               = button.ReadLocalValue(FrameworkElement.ToolTipProperty);
            button.ToolTip        = tooltip;
            button.LayoutUpdated += OnLayoutUpdated;
        }

        private void OnLayoutUpdated(object sender, EventArgs e) {
            if (!_button.IsVisible || !_layer.IsVisible) return;
            Point  at   = _button.TranslatePoint(new Point(_button.ActualWidth, 0), _layer);
            double left = at.X + DotOverhang - DotSize, top = at.Y - DotOverhang;
            if (Canvas.GetLeft(_dot) != left) Canvas.SetLeft(_dot, left);
            if (Canvas.GetTop(_dot) != top) Canvas.SetTop(_dot, top);
        }

        public void Dispose() {
            _button.LayoutUpdated -= OnLayoutUpdated;
            _parent.Children.Remove(_layer);
            if (_ownTip == DependencyProperty.UnsetValue)
                _button.ClearValue(FrameworkElement.ToolTipProperty);
            else
                _button.ToolTip = _ownTip;
        }
    }

    // == Addons > Options ==============================================================================
    // Settings and commands addons add through Genie.MenuUtils, under Addons > Options: the framework's own first,
    // then one submenu per addon that has any, in menu order. Rebuilt whole on every change; a few dozen items at most.

    internal static class MenuOptions {
        private const uint MF_STRING     = 0x0;
        private const uint MF_GRAYED     = 0x1;
        private const uint MF_CHECKED    = 0x8;
        private const uint MF_POPUP      = 0x10;
        private const uint MF_BYPOSITION = 0x400;
        private const uint MF_SEPARATOR  = 0x800;

        private static readonly List<GenieMenuOption> _options = new List<GenieMenuOption>();
        private static readonly Dictionary<IntPtr, string> _menuHelp = new Dictionary<IntPtr, string>(); // submenus
        private static IntPtr                         _menu;
        private static int                            _nextId = MenuNative.IdOptions, _added;
        private static bool                           _reportedFull;

        [DllImport("user32.dll")]
        private static extern IntPtr CreatePopupMenu();
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern bool AppendMenuW(IntPtr hMenu, uint flags, UIntPtr id, string item);
        [DllImport("user32.dll")]
        private static extern int GetMenuItemCount(IntPtr hMenu);
        [DllImport("user32.dll")]
        private static extern bool DeleteMenu(IntPtr hMenu, uint position, uint flags); // destroys submenus too
        [DllImport("user32.dll")]
        private static extern bool CheckMenuRadioItem(IntPtr hMenu, uint first, uint last, uint check, uint flags);

        // Ids for it, or false when the block is used up (logged once); such an option is never shown.
        internal static bool Add(GenieMenuOption option) {
            if (_nextId + option.IdCount > MenuNative.IdOptions + MenuNative.MaxOptions) {
                if (!_reportedFull) GenieBootstrap.Log("Addons > Options is full; later options aren't shown.");
                _reportedFull = true;
                return false;
            }
            option.Id       = _nextId;
            option.Sequence = _added++;
            _nextId        += option.IdCount;
            _options.Add(option);
            Rebuild();
            return true;
        }

        internal static void Attach(IntPtr menu) {
            _menu = menu;
            Rebuild();
        }

        internal static void Rebuild() {
            if (_menu == IntPtr.Zero) return;
            for (int n = GetMenuItemCount(_menu); n > 0; n--) DeleteMenu(_menu, 0, MF_BYPOSITION);
            _menuHelp.Clear(); // those submenus are gone; Windows may reuse their handles
            bool any = false;
            foreach (GenieMenuOption o in Shown(AddonRegistry.Framework)) {
                Append(_menu, o);
                any = true;
            }
            bool separated = !any;
            foreach (LoadedAddon addon in AddonRegistry.Loaded) {
                List<GenieMenuOption> own = Shown(addon);
                if (own.Count == 0) continue;
                if (!separated) AppendMenuW(_menu, MF_SEPARATOR, UIntPtr.Zero, null);
                separated  = true;
                IntPtr sub = CreatePopupMenu();
                foreach (GenieMenuOption o in own) Append(sub, o);
                _menuHelp[sub] = "Settings for " + addon.Name;
                AppendMenuW(_menu, MF_POPUP | MF_STRING, new UIntPtr((ulong)sub.ToInt64()), addon.Name);
                any = true;
            }
            if (!any) AppendMenuW(_menu, MF_STRING | MF_GRAYED, new UIntPtr(1), "(none)");
        }

        private static List<GenieMenuOption> Shown(LoadedAddon owner) {
            List<GenieMenuOption> list = _options.FindAll(o => o.Owner == owner && o.Visible);
            list.Sort(delegate(GenieMenuOption x, GenieMenuOption y) {
                return x.Order != y.Order ? x.Order.CompareTo(y.Order) : x.Sequence.CompareTo(y.Sequence);
            });
            return list;
        }

        private static void Append(IntPtr menu, GenieMenuOption o) {
            uint           grayed = o.IsEnabled ? 0 : MF_GRAYED;
            GenieMenuCheck check  = o as GenieMenuCheck;
            GenieMenuChoice choice = o as GenieMenuChoice;
            if (choice != null) {
                IntPtr sub = CreatePopupMenu();
                for (int i = 0; i < choice.Items.Count; i++)
                    AppendMenuW(sub, MF_STRING, new UIntPtr((uint)(o.Id + i)), choice.Items[i]);
                if (choice.Items.Count > 0 && choice.Selected >= 0 && choice.Selected < choice.Items.Count)
                    CheckMenuRadioItem(sub, (uint)o.Id, (uint)(o.Id + choice.Items.Count - 1),
                                       (uint)(o.Id + choice.Selected), 0); // MF_BYCOMMAND
                _menuHelp[sub] = o.Help ?? "";
                AppendMenuW(menu, MF_POPUP | MF_STRING | grayed, new UIntPtr((ulong)sub.ToInt64()), o.Title);
                return;
            }
            uint checkedFlag = (check != null && check.IsChecked) ? MF_CHECKED : 0;
            AppendMenuW(menu, MF_STRING | grayed | checkedFlag, new UIntPtr((uint)o.Id), o.Title);
        }

        private static GenieMenuOption Find(int id) {
            return _options.Find(o => id >= o.Id && id < o.Id + o.IdCount);
        }

        // WM_COMMAND: true if the id is an option's (run, or ignored while it's greyed out).
        internal static bool Run(int id) {
            GenieMenuOption o = Find(id);
            if (o == null) return false;
            if (!o.IsEnabled || !o.Visible) return true;
            try {
                o.Run(id - o.Id);
            } catch (Exception ex) {
                LogStore.Write(o.Owner.Name, "Options > " + o.Title + " failed: " + ex.Message);
            }
            return true;
        }

        internal static string HelpFor(int id) {
            GenieMenuOption o = Find(id);
            return o == null ? null : o.Help ?? "";
        }

        /// <summary>Help for one of our submenus (an addon's, or a choice), or null if it isn't ours.</summary>
        internal static string HelpForMenu(IntPtr menu) {
            string help;
            return _menuHelp.TryGetValue(menu, out help) ? help : null;
        }
    }

    public static partial class Genie {
        // == Genie.MenuUtils ==========================================================================

        /// <summary>
        /// Items under Addons > Options, grouped by addon: your own submenu, named after your addon, which no other
        /// addon can add to. Title Case like the editor's menus; end an action that opens a window or asks with "…".
        /// help shows in the editor's status bar. Add them in Initialize or later; UI thread only. For an on/off
        /// setting, pass a GenieToggle (ConfigUtils.CreateToggle): it's saved for you, and the item follows it
        /// wherever else it's changed, such as a window's gear. The other items store nothing: keep the setting
        /// yourself (ConfigUtils) and pass its current value in.
        /// </summary>
        public static class MenuUtils {
            /// <summary>A command: onClick runs when it's chosen.</summary>
            public static GenieMenuOption AddAction(string title, string help, Action onClick, int order = 0,
                                                    [CallerFilePath] string callerFile = null) {
                GenieMenuOption o = new GenieMenuOption(title, help, order);
                o.OnClick         = onClick;
                return Register(o, callerFile);
            }

            /// <summary>
            /// An on/off setting kept in toggle (ConfigUtils.CreateToggle): choosing it sets toggle.Value, and the
            /// check mark follows toggle.Value however it changes. React to the change with toggle.Changed.
            /// </summary>
            public static GenieMenuCheck AddCheck(string title, string help, GenieToggle toggle, int order = 0,
                                                  [CallerFilePath] string callerFile = null) {
                if (toggle == null) throw new ArgumentNullException("toggle");
                GenieMenuCheck o = new GenieMenuCheck(title, help, order, toggle.Value);
                o.OnToggle       = delegate(bool on) {
                    toggle.Value = on;
                };
                toggle.Changed += delegate(bool on) {
                    if (o.IsChecked != on) o.IsChecked = on;
                };
                return Register(o, callerFile);
            }

            /// <summary>An on/off setting you keep yourself: onToggle gets the new value when it's chosen.</summary>
            public static GenieMenuCheck AddCheck(string title, string help, bool isChecked, Action<bool> onToggle,
                                                  int order = 0, [CallerFilePath] string callerFile = null) {
                GenieMenuCheck o = new GenieMenuCheck(title, help, order, isChecked);
                o.OnToggle       = onToggle;
                return Register(o, callerFile);
            }

            /// <summary>
            /// One of several, as radio items in a submenu titled title: onPick gets the chosen index.
            /// </summary>
            public static GenieMenuChoice AddChoice(string title, string help, string[] items, int selected,
                                                    Action<int> onPick, int order = 0,
                                                    [CallerFilePath] string callerFile = null) {
                GenieMenuChoice o = new GenieMenuChoice(title, help, order, items, selected);
                o.OnPick          = onPick;
                return Register(o, callerFile);
            }

            private static T Register<T>(T option, string callerFile) where T : GenieMenuOption {
                option.Owner = AddonRegistry.AddonFor(AddonRegistry.AssemblyOf(callerFile));
                if (option.Owner == null)
                    GenieBootstrap.Log("Options > " + option.Title + ": not from a loaded addon, so not shown.");
                else
                    MenuOptions.Add(option);
                return option;
            }
        }
    }

    /// <summary>
    /// An item under Addons > Options (Genie.MenuUtils). Changing a property updates the menu without calling the
    /// item's handler, so the same setting can be shown elsewhere too, such as a window's gear.
    /// </summary>
    public class GenieMenuOption {
        private string _title;
        private bool   _isEnabled = true, _visible = true;
        private int    _order;

        internal LoadedAddon Owner;
        internal int         Id, Sequence;
        internal Action      OnClick;

        internal GenieMenuOption(string title, string help, int order) {
            _title = title ?? "";
            Help   = help;
            _order = order;
        }

        public string Title {
            get { return _title; }
            set {
                _title = value ?? "";
                MenuOptions.Rebuild();
            }
        }

        /// <summary>Shown in the editor's status bar while it's highlighted.</summary>
        public string Help { get; set; }

        /// <summary>False: greyed out, still listed.</summary>
        public bool IsEnabled {
            get { return _isEnabled; }
            set {
                _isEnabled = value;
                MenuOptions.Rebuild();
            }
        }

        /// <summary>False: not listed.</summary>
        public bool Visible {
            get { return _visible; }
            set {
                _visible = value;
                MenuOptions.Rebuild();
            }
        }

        /// <summary>Lower is higher up; ties keep the order added.</summary>
        public int Order {
            get { return _order; }
            set {
                _order = value;
                MenuOptions.Rebuild();
            }
        }

        internal virtual int IdCount {
            get { return 1; }
        }

        internal virtual void Run(int offset) {
            if (OnClick != null) OnClick();
        }
    }

    /// <summary>An on/off item under Addons > Options (Genie.MenuUtils.AddCheck).</summary>
    public sealed class GenieMenuCheck : GenieMenuOption {
        private bool          _isChecked;
        internal Action<bool> OnToggle;

        internal GenieMenuCheck(string title, string help, int order, bool isChecked) : base(title, help, order) {
            _isChecked = isChecked;
        }

        /// <summary>Setting it updates the check mark only; the handler runs when the user picks the item.</summary>
        public bool IsChecked {
            get { return _isChecked; }
            set {
                _isChecked = value;
                MenuOptions.Rebuild();
            }
        }

        internal override void Run(int offset) {
            IsChecked = !_isChecked;
            if (OnToggle != null) OnToggle(_isChecked);
        }
    }

    /// <summary>A pick-one submenu under Addons > Options (Genie.MenuUtils.AddChoice).</summary>
    public sealed class GenieMenuChoice : GenieMenuOption {
        private readonly string[] _items;
        private int               _selected;
        internal Action<int>      OnPick;

        internal GenieMenuChoice(string title, string help, int order, string[] items, int selected)
            : base(title, help, order) {
            _items    = (string[])(items ?? new string[0]).Clone();
            _selected = selected;
        }

        public IList<string> Items {
            get { return Array.AsReadOnly(_items); }
        }

        /// <summary>The bulleted item's index. Setting it moves the bullet only; the handler runs on a pick.</summary>
        public int Selected {
            get { return _selected; }
            set {
                _selected = value;
                MenuOptions.Rebuild();
            }
        }

        internal override int IdCount {
            get { return Math.Max(1, _items.Length); }
        }

        internal override void Run(int offset) {
            if (offset < 0 || offset >= _items.Length) return;
            Selected = offset;
            if (OnPick != null) OnPick(offset);
        }
    }

    // == Log File =====================================================================================
    // Addons\Logs\addons.log. Each line: "D2026-11-08T16:34:17S0001 [Tag] text" (date, time, session).
    // Continuation lines, such as stack traces, don't start with the stamp.

    internal static class LogStore {
        internal const string FrameworkTag        = "AddonGenie";
        internal const int    DefaultKeepSessions = 30;
        internal const int    MaxSession          = 9999; // four digits, then back to 0001
        internal const int    MaxKeepSessions     = MaxSession; // no more, so a number has gone before it comes back

        private static readonly object _lock = new object();
        private static string          _path;
        private static int             _session;

        /// <summary>Raised after every write, on the writing thread: (tag, full line).</summary>
        internal static event Action<string, string> Written;

        internal static int CurrentSession {
            get { return _session; }
        }

        internal static string CurrentSessionId {
            get { return "S" + _session.ToString("D4"); }
        }

        // The next session follows the log's last one, or the one in settings if the log is empty. After 9999 it
        // wraps to 0001: the log keeps at most MaxKeepSessions, so a number never appears twice in it.
        // Keeps the last keepSessions, this one included.
        internal static int Begin(string path, int keepSessions, int lastRecordedSession) {
            _path    = path;
            int last = 0;
            try {
                if (File.Exists(path)) {
                    string[] lines = File.ReadAllLines(path);
                    for (int i = lines.Length - 1; i >= 0 && last == 0; i--) last = SessionOf(lines[i]);
                    TrimSessions(path, lines, Math.Max(1, Math.Min(keepSessions, MaxKeepSessions)) - 1);
                }
            } catch {}
            if (last == 0) last = lastRecordedSession;
            _session = last % MaxSession + 1;
            // "Session 0001 started (AddonGenie v0.1.0 by SurferJay)": IsSessionStart matches this.
            Write(FrameworkTag,
                  "Session " + _session.ToString("D4") + " started (" + AddonRegistry.Framework.Describe() + ")");
            return _session;
        }

        internal static void Write(string tag, string message) {
            string line = "D" + DateTime.Now.ToString("s") + CurrentSessionId + " [" + (tag ?? "unknown") +
                          "] " + (message ?? "");
            lock (_lock) {
                try {
                    if (_path != null) File.AppendAllText(_path, line + Environment.NewLine);
                } catch {}
            }
            Action<string, string> written = Written;
            if (written == null) return;
            try {
                written(tag, line);
            } catch {}
        }

        internal static string[] ReadAllLines() {
            lock (_lock) {
                try {
                    return (_path != null && File.Exists(_path)) ? File.ReadAllLines(_path) : new string[0];
                } catch {
                    return new string[0];
                }
            }
        }

        internal static bool IsEntryStart(string line) {
            return line != null && line.Length > 22 && line[0] == 'D' && line[11] == 'T' && line[20] == 'S';
        }

        // 0 for a line without a session number.
        internal static int SessionOf(string line) {
            if (!IsEntryStart(line)) return 0;
            int end = line.IndexOf(' ', 21);
            int n;
            return (end > 21 && int.TryParse(line.Substring(21, end - 21), out n)) ? n : 0;
        }

        // Null for a line without a tag.
        internal static string TagOf(string line) {
            if (!IsEntryStart(line)) return null;
            int open = line.IndexOf(" [", 20, StringComparison.Ordinal);
            if (open < 0) return null;
            int close = line.IndexOf(']', open + 2);
            return (close < 0) ? null : line.Substring(open + 2, close - open - 2);
        }

        internal static bool IsSessionStart(string line) {
            return string.Equals(TagOf(line), FrameworkTag) &&
                   line.IndexOf("] Session ", StringComparison.Ordinal) > 0 &&
                   line.IndexOf(" started (AddonGenie ", StringComparison.Ordinal) > 0;
        }

        private static void TrimSessions(string path, string[] lines, int keepPrevious) {
            List<int> starts = new List<int>();
            for (int i = 0; i < lines.Length; i++) {
                if (IsSessionStart(lines[i])) starts.Add(i);
            }
            if (starts.Count <= keepPrevious) return;

            int from      = (keepPrevious == 0) ? lines.Length : starts[starts.Count - keepPrevious];
            string[] kept = new string[lines.Length - from];
            Array.Copy(lines, from, kept, 0, kept.Length);
            SafeFile.WriteAllLines(path, kept);
        }
    }

    // == Settings Files ===============================================================================
    // Addons\Config\<owner>.ini, one per addon plus AddonGenie.ini for the framework.

    // Writes a temporary file, then swaps it in, so a crash mid-save can't leave a half-written file.
    internal static class SafeFile {
        internal static void WriteAllLines(string path, IEnumerable<string> lines) {
            string tmp = path + ".tmp";
            File.WriteAllLines(tmp, lines);
            Swap(tmp, path);
        }

        // Puts a finished temp file in place of path, so a failed write never leaves path half-written.
        internal static void Swap(string tmp, string path) {
            if (!File.Exists(path)) {
                File.Move(tmp, path);
                return;
            }
            try {
                File.Replace(tmp, path, null);
            } catch { // File.Replace fails on some file systems
                File.Copy(tmp, path, true);
                File.Delete(tmp);
            }
        }
    }

    internal sealed class IniFile {
        private readonly string _path;
        private readonly        string[] _header;

        // section -> (key -> value), in file order
        private readonly List<KeyValuePair<string, List<KeyValuePair<string, string>>>> _sections =
            new List<KeyValuePair<string, List<KeyValuePair<string, string>>>>();

        // Keys the framework keeps for itself in an addon's file (a split panel's position), by "section|key". A
        // settings diff leaves them out and a restore keeps their current values, as for the sections IsManaged names.
        private readonly HashSet<string> _managed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        /// <summary>Raised after each save.</summary>
        internal event Action Saved;

        internal IniFile(string path, string[] header) {
            _path   = path;
            _header = header;
            if (File.Exists(_path)) Parse(File.ReadAllLines(_path));
        }

        // A copy that never saves: a settings backup read back, or a snapshot of the live file.
        private IniFile(IEnumerable<string> lines) {
            Parse(lines);
        }

        internal static IniFile FromLines(IEnumerable<string> lines) {
            return new IniFile(lines);
        }

        internal IniFile Copy() {
            IniFile copy = new IniFile(new string[0]);
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in _sections)
                copy._sections.Add(new KeyValuePair<string, List<KeyValuePair<string, string>>>(
                    s.Key, new List<KeyValuePair<string, string>>(s.Value)));
            return copy;
        }

        internal string FilePath {
            get { return _path; }
        }

        internal void Manage(string section, string key) {
            _managed.Add(section + "|" + key);
        }

        internal bool IsManaged(string section, string key) {
            return IsManagedSection(section) || _managed.Contains(section + "|" + key);
        }

        internal static bool IsManagedSection(string section) {
            return section.StartsWith(GenieWindow.SectionPrefix, StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(section, SettingsBackups.Section, StringComparison.OrdinalIgnoreCase);
        }

        // Every section and its entries, in file order, copied.
        internal List<KeyValuePair<string, List<KeyValuePair<string, string>>>> GetAll() {
            return Copy()._sections;
        }

        // Replaces the whole file's settings with these, saved once. False if the save failed (logged).
        internal bool SetAll(List<KeyValuePair<string, List<KeyValuePair<string, string>>>> sections) {
            _sections.Clear();
            _sections.AddRange(sections);
            return Save();
        }

        internal string Get(string section, string key) {
            List<KeyValuePair<string, string>> entries = Section(section, false);
            if (entries == null) return null;
            int i = IndexOfKey(entries, key);
            return (i < 0) ? null : entries[i].Value;
        }

        internal void Set(string section, string key, string value) {
            Put(Section(section, true), key, value);
            Save();
        }

        // Drops the key, so Get returns null again. Saves only if the key was there.
        internal void Remove(string section, string key) {
            List<KeyValuePair<string, string>> entries = Section(section, false);
            int                                i       = (entries == null) ? -1 : IndexOfKey(entries, key);
            if (i < 0) return;
            entries.RemoveAt(i);
            Save();
        }

        // Drops several keys from one section, saved once. False if none was there.
        internal bool RemoveMany(string section, string[] keys) {
            List<KeyValuePair<string, string>> entries = Section(section, false);
            if (entries == null) return false;
            int before = entries.Count;
            entries.RemoveAll(
                e => Array.Exists(keys, k => string.Equals(k, e.Key, StringComparison.OrdinalIgnoreCase)));
            if (entries.Count == before) return false;
            Save();
            return true;
        }

        // Several keys in one section, saved once.
        internal void SetMany(string section, string[] keys, string[] values) {
            List<KeyValuePair<string, string>> entries = Section(section, true);
            for (int k = 0; k < keys.Length; k++) Put(entries, keys[k], values[k]);
            Save();
        }

        // A section's entries in file order, copied. Null if there's no such section.
        internal List<KeyValuePair<string, string>> GetSection(string section) {
            List<KeyValuePair<string, string>> entries = Section(section, false);
            return entries == null ? null : new List<KeyValuePair<string, string>>(entries);
        }

        // Replaces a section's entries, saved once. The section keeps its place; a new one goes last.
        internal void SetSection(string section, IEnumerable<KeyValuePair<string, string>> entries) {
            List<KeyValuePair<string, string>> target = Section(section, true);
            target.Clear();
            foreach (KeyValuePair<string, string> e in entries) Put(target, e.Key, e.Value ?? "");
            Save();
        }

        // Drops a whole section. Saves only if it was there.
        internal void RemoveSection(string section) {
            int removed = _sections.RemoveAll(s => string.Equals(s.Key, section, StringComparison.OrdinalIgnoreCase));
            if (removed > 0) Save();
        }

        internal List<string> SectionNames() {
            List<string> names = new List<string>();
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in _sections) names.Add(s.Key);
            return names;
        }

        private static int IndexOfKey(List<KeyValuePair<string, string>> entries, string key) {
            for (int i = 0; i < entries.Count; i++) {
                if (string.Equals(entries[i].Key, key, StringComparison.OrdinalIgnoreCase)) return i;
            }
            return -1;
        }

        // Replaces the value, keeping the key's original spelling and position.
        private static void Put(List<KeyValuePair<string, string>> entries, string key, string value) {
            int i = IndexOfKey(entries, key);
            if (i < 0)
                entries.Add(new KeyValuePair<string, string>(key, value));
            else
                entries[i] = new KeyValuePair<string, string>(entries[i].Key, value);
        }

        private List<KeyValuePair<string, string>> Section(string name, bool create) {
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in _sections) {
                if (string.Equals(s.Key, name, StringComparison.OrdinalIgnoreCase)) return s.Value;
            }
            if (!create) return null;
            List<KeyValuePair<string, string>> entries = new List<KeyValuePair<string, string>>();
            _sections.Add(new KeyValuePair<string, List<KeyValuePair<string, string>>>(name, entries));
            return entries;
        }

        private void Parse(IEnumerable<string> lines) {
            string current = "Settings"; // keys before any [section]
            int    number  = 0;
            foreach (string raw in lines) {
                GenieIniLine line = GenieIniLine.Read(raw, ++number);
                if (line == null) continue;
                if (line.IsSection) {
                    current = line.Section;
                    Section(current, true);
                } else if (line.IsSetting) {
                    Section(current, true).Add(new KeyValuePair<string, string>(line.Key, line.Value));
                }
            }
        }

        // The header is rewritten on every save, so it can't be lost by hand edits.
        private bool Save() {
            if (_path == null) return true; // a copy
            List<string> lines = new List<string>(_header);
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in _sections) {
                lines.Add("");
                lines.Add(GenieIniLine.SectionText(s.Key));
                foreach (KeyValuePair<string, string> kv in s.Value)
                    lines.Add(GenieIniLine.SettingText(kv.Key, kv.Value));
            }
            try {
                Directory.CreateDirectory(Path.GetDirectoryName(_path));
                SafeFile.WriteAllLines(_path, lines);
            } catch (Exception ex) {
                GenieBootstrap.Log("couldn't save " + Path.GetFileName(_path) + ": " + ex.Message);
                return false;
            }
            if (Saved != null) Saved();
            return true;
        }
    }

    // == Windows ======================================================================================
    // Addon windows are owned HwndSource popups, never System.Windows.Window: a Window joins the editor's
    // Application.Windows, and closing it would trigger the editor's OnLastWindowClose shutdown.

    // The genie ("Genie" by Magnific, from Flaticon), traced as paths so no image file ships or goes missing.
    // Rendered once, at the sizes Windows uses for title bars and the taskbar; Windows' icon maker reads PNG data.
    internal static class WindowIcon {
        internal const double ArtSize = 512; // the art's coordinates

        // One "#rrggbb path" per layer, back to front. Same-colored paths overlap, so they're filled nonzero ("F1"):
        // WPF's default, even-odd, would cut holes. The launcher's splash reads these strings out of this file
        // (IconArt.Load): keep one literal per layer, and only absolute M L H V A Z with unrotated arcs.
        // clang-format off: one literal per layer
        internal static readonly string[] Layers = {
            "#f6f6f6 M145 81A92 81 0 0 1 329 81A92 81 0 0 1 145 81Z",
            "#e2dff4 M237 0A92 81 0 0 1 237 162Z",
            "#1f2e52 M146 370V376A137 137 0 0 0 258.4 510.5A161.2 161.2 0 0 0 424.3 454.7A73.7 73.7 0 0 1 328.4 384.4V370Z",
            "#3d4478 M146 376A137 137 0 0 0 237 504.8V370H146Z",
            "#aaa5d3 M95 307V277A92 85 0 0 1 187 192H287A92 85 0 0 1 379 277V307H328V380H146V307Z",
            "#938ec8 M237 192H287A92 85 0 0 1 379 277V307H328V380H237Z M162 153V128L237 94L312 128V153A75 75 0 0 1 162 153Z M170 275V340H131A40 40 0 0 1 91 300V295L95 275Z",
            "#8078be M237 94L312 128V153A75 75 0 0 1 237 228Z M305 275V340H343A40 40 0 0 0 383 300V295L379 275Z",
            "#fddc65 M222 68H252V100H222Z M162 275H200V340H162Z",
            "#fcb365 M237 68H252V100H237Z M275 275H313V340H275Z",
            "#cfcfde M192 275H204.5A32.5 32.5 0 0 1 204.5 340H192Z",
            "#aaa5d3 M283 275H269.5A32.5 32.5 0 0 0 269.5 340H283Z",
            "#fb254a M146 370H328V400H148L146 380Z",
            "#b6283e M237 370H328V400H237Z",
        };
        // clang-format on

        private const uint WM_SETICON  = 0x0080;
        private const int  ICON_SMALL  = 0;
        private const int  ICON_BIG    = 1;
        private const int  SM_CXICON   = 11;
        private const int  SM_CYICON   = 12;
        private const int  SM_CXSMICON = 49;
        private const int  SM_CYSMICON = 50;
        private const uint IconVersion = 0x00030000; // required by CreateIconFromResourceEx

        private static bool   _made;
        private static IntPtr _small, _big; // kept for the editor's lifetime, shared by every window

        [DllImport("user32.dll")]
        private static extern IntPtr CreateIconFromResourceEx(byte[] data, uint size, bool icon, uint version, int cx,
                                                              int cy, uint flags);
        [DllImport("user32.dll")]
        private static extern int GetSystemMetrics(int index);
        [DllImport("user32.dll")]
        private static extern IntPtr SendMessageW(IntPtr h, uint msg, IntPtr w, IntPtr l);

        internal static void Apply(IntPtr hwnd) {
            if (!_made) {
                _made = true;
                Make();
            }
            if (_big != IntPtr.Zero) SendMessageW(hwnd, WM_SETICON, new IntPtr(ICON_BIG), _big);
            if (_small != IntPtr.Zero) SendMessageW(hwnd, WM_SETICON, new IntPtr(ICON_SMALL), _small);
        }

        private static void Make() {
            try {
                _big   = Create(GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON));
                _small = Create(GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON));
                if (_big == IntPtr.Zero && _small == IntPtr.Zero)
                    GenieBootstrap.Log("Windows use the default icon: the genie couldn't be made into an icon.");
            } catch (Exception ex) {
                GenieBootstrap.Log("window icon failed: " + ex.Message);
            }
        }

        private static IntPtr Create(int width, int height) {
            byte[] png = Render(width, height);
            return CreateIconFromResourceEx(png, (uint)png.Length, true, IconVersion, width, height, 0);
        }

        /// <summary>The genie as PNG data, scaled to fit width by height.</summary>
        internal static byte[] Render(int width, int height) {
            double        scale  = Math.Min(width, height) / ArtSize;
            DrawingVisual visual = new DrawingVisual();
            using (DrawingContext dc = visual.RenderOpen()) {
                dc.PushTransform(new ScaleTransform(scale, scale));
                foreach (string layer in Layers) {
                    int   split = layer.IndexOf(' ');
                    Color color = (Color)ColorConverter.ConvertFromString(layer.Substring(0, split));
                    dc.DrawGeometry(new SolidColorBrush(color), null,
                                    Geometry.Parse("F1 " + layer.Substring(split + 1)));
                }
            }
            System.Windows.Media.Imaging.RenderTargetBitmap bitmap =
                new System.Windows.Media.Imaging.RenderTargetBitmap(width, height, 96, 96, PixelFormats.Pbgra32);
            bitmap.Render(visual);
            System.Windows.Media.Imaging.PngBitmapEncoder encoder = new System.Windows.Media.Imaging.PngBitmapEncoder();
            encoder.Frames.Add(System.Windows.Media.Imaging.BitmapFrame.Create(bitmap));
            using (MemoryStream png = new MemoryStream()) {
                encoder.Save(png);
                return png.ToArray();
            }
        }
    }

    // The taskbar works out a button's icon once, when the button is made. With the framework loaded it sometimes
    // settles on a generic icon for the editor's frame and keeps it, even if the window's icon is set again.
    // Re-adding the button makes it look again; the window, its icon and its app ID are untouched.
    // Off through [Editor] TaskbarIcon=false in AddonGenie.ini.
    internal static class TaskbarButton {
        // Every method is listed: COM calls by vtable slot.
        [ComImport, Guid("56FDF342-FD6D-11d0-958A-006097C9A090"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
        private interface ITaskbarList {
            void HrInit();
            void AddTab(IntPtr hwnd);
            void DeleteTab(IntPtr hwnd);
            void ActivateTab(IntPtr hwnd);
            void SetActiveAlt(IntPtr hwnd);
        }

        [ComImport, Guid("56FDF344-FD6D-11d0-958A-006097C9A090")]
        private class TaskbarList {}

        internal static void Refresh(IntPtr frame) {
            ITaskbarList list = null;
            try {
                list = (ITaskbarList)new TaskbarList();
                list.HrInit();
                list.DeleteTab(frame);
                list.AddTab(frame);
            } catch (Exception ex) {
                GenieBootstrap.Log("Taskbar button refresh failed: " + ex.Message);
            } finally {
                if (list != null) Marshal.ReleaseComObject(list);
            }
        }
    }

    /// <summary>
    /// A popup window owned by the editor. Make one with Genie.WindowUtils.CreateWindow; use it from the
    /// UI thread (one from ShowPillOnOwnThread: from its own). Single-use: once closed, create a new one
    /// (GenieWindowSlot does that for you).
    /// </summary>
    public sealed class GenieWindow {
        internal const string SectionPrefix = "Window: ";

        private const int  WS_CAPTION               = 0x00C00000;
        private const int  WS_SYSMENU               = 0x00080000;
        private const int  WS_THICKFRAME            = 0x00040000;
        private const int  WS_MAXIMIZEBOX           = 0x00010000;
        private const int  WS_CLIPCHILDREN          = 0x02000000;
        private const int  WS_CLIPSIBLINGS          = 0x04000000;
        private const int  WS_POPUP                 = unchecked((int)0x80000000);
        private const int  WS_EX_TOOLWINDOW         = 0x00000080;
        private const int  WM_NCLBUTTONDOWN         = 0x00A1;
        private const int  HTCAPTION                = 2;
        private const int  WM_DESTROY               = 0x0002;
        private const int  WM_CLOSE                 = 0x0010;
        private const int  WM_GETMINMAXINFO         = 0x0024;
        private const int  WM_ACTIVATE              = 0x0006;
        private const int  WM_EXITSIZEMOVE          = 0x0232;
        private const int  SW_SHOWNOACTIVATE        = 4;
        private const int  SW_SHOW                  = 5;
        private const int  SW_RESTORE               = 9;
        private const uint SWP_NOSIZE               = 0x0001;
        private const uint SWP_NOMOVE               = 0x0002;
        private const uint SWP_NOZORDER             = 0x0004;
        private const uint SWP_NOACTIVATE           = 0x0010;
        private const uint SWP_NOOWNERZORDER        = 0x0200;
        private const uint MONITOR_DEFAULTTONEAREST = 2;

        // Each window and its hook delegate stay reachable while the HWND exists, even if the addon drops it.
        private static readonly List<GenieWindow> _live = new List<GenieWindow>();

        // Those on threads of their own (ShowOnOwnThread), apart: _live and what reads it stay the UI thread's.
        private static readonly List<GenieWindow> _onOwnThreads = new List<GenieWindow>();

        // Remembered bounds live in the owner's settings file (the addon's, or AddonGenie.ini for the
        // framework's windows), one section per window.
        private readonly IniFile _config;
        private readonly string  _section;

        private readonly IntPtr _owner;
        internal readonly LoadedAddon Addon; // whose window: an addon, the framework, or null
        private readonly System.Windows.Interop.HwndSourceHook _hook;
        private readonly Border                                _root;
        private readonly ContentHost                           _contentHost;
        private readonly Border                                _footer; // "v1.0 by SurferJay", bottom-left
        private readonly bool                                  _hasInfo;

        private System.Windows.Interop.HwndSource _src;
        private IntPtr                            _hwnd;
        private string                            _title;
        private double                            _w, _h;               // requested size, DIPs
        private double                            _sx = 1.0, _sy = 1.0; // DIP -> device pixel scale
        private bool                              _positioned, _closeRequested, _destroyed;

        // Stacking: which of ours was in front when the editor closed. Each Show or activation brings a window to
        // the front of ours, so the latest of them is the front one; saved as ZOrder, higher in front, compared
        // across settings files at the next start (GenieBootstrap.ReopenAll, RestoreStacking).
        private static int                        _fronts;
        private int                               _front;
        private readonly int                      _savedZOrder; // last session's, or -1
        private bool                              _reopened;    // shown by ReopenAll, to be stacked
        private bool                              _footerHidden;
        private bool                              _fitHeight;
        private int                               _fitOuterHeight; // device pixels, frame included; 0 until fitted

        /// <summary>Raised before closing (X button, Alt+F4 or Close()). Set Cancel to keep it open.</summary>
        public event System.ComponentModel.CancelEventHandler Closing;

        /// <summary>Raised once, after the window is gone, including when the editor closes it.</summary>
        public event EventHandler Closed;

        internal GenieWindow(string title, double width, double height, IniFile config, string settingsKey,
                             LoadedAddon addon)
            : this(title, width, height, config, settingsKey, addon, false) {}

        // pill: frameless and rounded, its own chrome drawn by WPF on a see-through window, dragged by its body.
        internal GenieWindow(string title, double width, double height, IniFile config, string settingsKey,
                             LoadedAddon addon, bool pill)
            : this(title, width, height, config, settingsKey, addon, pill, null) {}

        // home: on a thread of its own. It gets no settings file (that's the UI thread's) and no owner.
        private GenieWindow(string title, double width, double height, IniFile config, string settingsKey,
                            LoadedAddon addon, bool pill, OwnThreadHome home) {
            _pill         = pill;
            _home         = home;
            Dispatcher ui = (Application.Current != null) ? Application.Current.Dispatcher : null;
            if (home == null && ui != null && !ui.CheckAccess())
                throw new InvalidOperationException("GenieWindow must be created on the editor UI thread " +
                                                    "(use Genie.Dispatcher.BeginInvoke).");

            Addon        = addon;
            _config      = home == null ? config : null;
            _section     = SectionPrefix + (string.IsNullOrEmpty(settingsKey) ? (title ?? "") : settingsKey);
            _savedZOrder = (_config == null) ? -1 : SavedZOrder(_config, _section.Substring(SectionPrefix.Length));
            _title   = title ?? "";
            _w       = width;
            _h       = height;
            _owner       = home == null ? Genie.WindowUtils.FindEditorFrame() : IntPtr.Zero;
            if (_owner == IntPtr.Zero && home == null)
                GenieBootstrap.Log("GenieWindow '" + _title + "': editor frame not found; window will be unowned.");

            System.Windows.Interop.HwndSourceParameters p = new System.Windows.Interop.HwndSourceParameters(_title);
            // No WS_CHILD, so ParentWindow is the owner. No WS_VISIBLE: Show() reveals it once it's placed.
            p.WindowStyle =
                pill ? WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
                     : WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN | WS_CLIPSIBLINGS;
            p.ExtendedWindowStyle = home != null ? WS_EX_TOOLWINDOW : 0; // unowned: this keeps it off the taskbar
            p.UsesPerPixelOpacity = pill; // the rounded corners show what's behind
            p.ParentWindow        = _owner;
            p.PositionX           = 0;
            p.PositionY           = 0;
            p.Width               = Math.Max(1, (int)width); // corrected for DPI in Place()
            p.Height              = Math.Max(1, (int)height);
            _hook                 = new System.Windows.Interop.HwndSourceHook(Hook);
            p.HwndSourceHook      = _hook;

            _src  = new System.Windows.Interop.HwndSource(p);
            _hwnd = _src.Handle;
            if (home == null) WindowIcon.Apply(_hwnd); // a frameless window shows no icon
            _src.SizeToContent = SizeToContent.Manual; // content follows the client area on resize
            try {
                _src.CompositionTarget.BackgroundColor = pill ? Colors.Transparent : SystemColors.WindowColor;
            } catch {}
            try {
                Matrix m = _src.CompositionTarget.TransformToDevice;
                if (m.M11 > 0) _sx = m.M11;
                if (m.M22 > 0) _sy = m.M22;
            } catch {}

            // A transparent background makes the whole frame get mouse moves, so the footer fades wherever the
            // pointer nears it; without one only drawn elements do, leaving gaps.
            Grid frame                = new Grid { Background = Brushes.Transparent };
            _contentHost                      = new ContentHost();
            _contentHost.WantedHeightChanged += delegate {
                // Raised mid-layout: resize after it, not inside it.
                _contentHost.Dispatcher.BeginInvoke((Action)FitHeight);
            };
            frame.Children.Add(_contentHost);

            string info = (addon == null) ? null : addon.Credit;
            _hasInfo    = (info != null);

            // Over the content, hiding as little of it as it can: no background, just a halo in the window's colour
            // round the letters, so they read over whatever is under them. Ignores the mouse, so clicks always reach
            // the content underneath.
            TextBlock credit = new TextBlock {
                Text       = info ?? "",
                FontSize   = Genie.Theme.FontSizeCaption,
                Foreground = Genie.Theme.TextSecondary,
            };
            Grid lettering = new Grid();
            lettering.Children.Add(CreateHalo(credit));
            lettering.Children.Add(credit);
            _footer = new Border {
                Child               = lettering,
                Padding             = new Thickness(4, 2, 4, 2), // room for the halo
                Margin              = new Thickness(6, 0, 0, 4),
                HorizontalAlignment = HorizontalAlignment.Left,
                VerticalAlignment   = VerticalAlignment.Bottom,
                IsHitTestVisible    = false,
                Visibility          = _hasInfo ? Visibility.Visible : Visibility.Collapsed,
            };
            frame.Children.Add(_footer);
            frame.PreviewMouseMove += OnFrameMouseMove;
            frame.MouseLeave       += delegate {
                SetFooterHidden(false);
            };

            _root            = new Border();
            _root.Background = pill ? Brushes.Transparent : SystemColors.WindowBrush;
            // WPF's scrollbar template sizes itself from these, so every scrollbar inside gets slimmer.
            _root.Resources[SystemParameters.VerticalScrollBarWidthKey]    = Genie.Theme.ScrollBarThickness;
            _root.Resources[SystemParameters.HorizontalScrollBarHeightKey] = Genie.Theme.ScrollBarThickness;

            // Adorners (a row list's insert buttons) draw over the content, past the edges of what they adorn.
            UIElement body = frame;
            if (pill) {
                _chrome = new Border {
                    Child           = frame,
                    Background      = SystemColors.WindowBrush,
                    BorderBrush     = Genie.Theme.InputBorder,
                    BorderThickness = new Thickness(1),
                    CornerRadius    = new CornerRadius(height / 2),
                    ClipToBounds    = true,
                };
                _chromeContent       = frame;
                _chrome.SizeChanged += delegate {
                    ClipToCorners();
                };
                // A press no control took is a click, or a drag as on a title bar once the pointer goes past
                // PillDragDistance or off the window. Not a drag at the press: the move loop would swallow the release,
                // and flat icons and chevrons act on the release.
                _chrome.MouseLeftButtonDown += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    if (!e.Handled) _pressedAt = e.GetPosition(_chrome);
                };
                System.Windows.Input.MouseButtonEventHandler released =
                    delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    bool pressed = _pressedAt.HasValue;
                    _pressedAt   = null;
                    if (pressed && !e.Handled && BodyClicked != null) BodyClicked();
                };
                _chrome.AddHandler(UIElement.MouseLeftButtonUpEvent, released, true); // a control's click ends it too
                _chrome.PreviewMouseMove += delegate(object s, System.Windows.Input.MouseEventArgs e) {
                    if (!_pressedAt.HasValue) return;
                    if (e.LeftButton != System.Windows.Input.MouseButtonState.Pressed)
                        _pressedAt = null;
                    else if ((e.GetPosition(_chrome) - _pressedAt.Value).Length >= PillDragDistance)
                        StartDrag();
                };
                _chrome.MouseLeave += delegate(object s, System.Windows.Input.MouseEventArgs e) {
                    if (_pressedAt.HasValue && e.LeftButton == System.Windows.Input.MouseButtonState.Pressed)
                        StartDrag();
                };
                _footer.Visibility = Visibility.Collapsed;
                _hasInfo           = false;
                body               = _chrome;
            }
            _root.Child     = new System.Windows.Documents.AdornerDecorator { Child = body };
            _src.RootVisual = _root;
            if (home != null) {
                lock (_onOwnThreads) _onOwnThreads.Add(this);
                return;
            }
            _live.Add(this);
            BrowserBelowOurs.Start();
        }

        private readonly bool          _pill;
        private readonly OwnThreadHome _home; // null: on the UI thread, as nearly every window is
        private EditorFollower         _follower;
        private Border                 _chrome;        // a pill window's rounded outline
        private FrameworkElement       _chromeContent; // what it clips to its corners
        private POINT? _pillSpot;                      // where the user left it; null until next needed after a drag
        private Point? _pressedAt;                     // a press no control took: a click or drag so far

        private const double PillDragDistance = 8; // DIPs, so a slightly shaky click is still a click

        /// <summary>
        /// A pill window's body was clicked: pressed and released on a part no control takes, moving less than a drag
        /// takes. Example: Package Loader's running pill, which expands.
        /// </summary>
        public event Action BodyClicked;

        private const string PillWidthKey  = "PillWidth";
        private const double WidthGripSize = 6;

        private double _minPillWidth, _maxPillWidth;

        /// <summary>A pill window's width in DIPs: what it opens at, then wherever the user drags it.</summary>
        public double PillWidth {
            get { return _w; }
        }

        /// <summary>
        /// Lets the user drag a pill window's left and right edges, between min and max DIPs, and remembers the width
        /// (PillWidth). Call while building it, and pass PillWidth to ResizeTo from then on. Example: Package Loader's
        /// running pill and launcher.
        /// </summary>
        public void EnableWidthDrag(double min, double max) {
            if (_chromeContent == null || _maxPillWidth > 0) return;
            _minPillWidth = min;
            _maxPillWidth = max;
            int saved     = _home != null ? _home.PillWidth : ReadInt(PillWidthKey, 0);
            if (saved > 0) _w = saved;
            _w         = Math.Max(min, Math.Min(max, _w));
            Grid frame = (Grid)_chromeContent;
            frame.Children.Add(WidthGrip(true));
            frame.Children.Add(WidthGrip(false));
        }

        // An edge strip over the content. Follows the cursor on the screen, not in the window, as the left edge moves
        // the window under it.
        private Border WidthGrip(bool left) {
            Border grip = new Border {
                Width               = WidthGripSize,
                Background          = Brushes.Transparent,
                HorizontalAlignment = left ? HorizontalAlignment.Left : HorizontalAlignment.Right,
                Cursor              = System.Windows.Input.Cursors.SizeWE,
            };
            POINT from                = new POINT();
            RECT  start               = new RECT();
            grip.MouseLeftButtonDown += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled = true;
                if (GetCursorPos(out from) && GetWindowRect(_hwnd, out start)) grip.CaptureMouse();
            };
            grip.MouseMove += delegate {
                POINT now;
                RECT  rect;
                if (!grip.IsMouseCaptured || !GetCursorPos(out now) || !GetWindowRect(_hwnd, out rect)) return;
                int moved = now.X - from.X, wide = start.R - start.L + (left ? -moved : moved);
                wide  = Math.Max((int)Math.Round(_minPillWidth * _sx),
                                 Math.Min((int)Math.Round(_maxPillWidth * _sx), wide));
                int x = left ? start.R - wide : start.L;
                _w    = wide / _sx;
                if (_pillSpot.HasValue) _pillSpot = new POINT { X = x, Y = _pillSpot.Value.Y };
                SetWindowPos(_hwnd, IntPtr.Zero, x, rect.T, wide, rect.B - rect.T, SWP_NOZORDER | SWP_NOACTIVATE);
            };
            grip.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled = true;
                if (!grip.IsMouseCaptured) return;
                grip.ReleaseMouseCapture();
                SavePillPlace();
            };
            return grip;
        }

        private void SavePillPlace() {
            RECT r;
            int  wide = (int)Math.Round(_w);
            if (_home == null) {
                if (_config != null) _config.Set(_section, PillWidthKey, wide.ToString());
                return;
            }
            _home.SavePillWidth(wide);
            if (GetWindowRect(_hwnd, out r)) _home.SavePosition(r.L, r.T);
        }

        [DllImport("user32.dll")]
        private static extern bool GetCursorPos(out POINT p);

        private void StartDrag() {
            _pressedAt = null;
            ReleaseCapture();
            SendMessageW(_hwnd, WM_NCLBUTTONDOWN, (IntPtr)HTCAPTION, IntPtr.Zero);
        }

        // Inside the outline's border. Layout can run inside ResizeTo, so a size change alone may see the old radius.
        private void ClipToCorners() {
            double r            = Math.Max(0, _chrome.CornerRadius.TopLeft - 1);
            _chromeContent.Clip = new RectangleGeometry(new Rect(_chromeContent.RenderSize), r, r);
        }

        // == On a thread of its own ===================================================================

        // Runs on the UI thread; everything the window needs from it is read here. FindEditorFrame especially: it
        // asks windows for their titles, which would wait on a UI thread busy loading.
        internal static void ShowOnOwnThread(string title, double width, double height, IniFile config,
                                             string settingsKey, LoadedAddon addon, Action<GenieWindow> build) {
            Dispatcher ui       = GenieBootstrap.UiDispatcher;
            string     section  = SectionPrefix + (string.IsNullOrEmpty(settingsKey) ? (title ?? "") : settingsKey);
            Func<bool> remember = delegate {
                return config != null && GenieToggle.For(config, "RememberPosition", true, section).Value;
            };
            OwnThreadHome home = new OwnThreadHome { Frame = Genie.WindowUtils.FindEditorFrame() };
            int           left, top;
            if (remember() && int.TryParse(config.Get(section, "Left"), out left) &&
                int.TryParse(config.Get(section, "Top"), out top)) {
                home.Left = left;
                home.Top  = top;
            }
            int pillWidth;
            if (config != null && int.TryParse(config.Get(section, PillWidthKey), out pillWidth))
                home.PillWidth = pillWidth;
            home.SavePillWidth = delegate(int w) {
                ui.BeginInvoke((Action)delegate { config.Set(section, PillWidthKey, w.ToString()); });
            };
            home.SavePosition = delegate(int x, int y) {
                ui.BeginInvoke((Action)delegate {
                    if (remember())
                        config.SetMany(section, new[] { "Left", "Top" }, new[] { x.ToString(), y.ToString() });
                });
            };
            Action<Exception> report = delegate(Exception error) {
                ui.BeginInvoke((Action)delegate {
                    if (!AddonFaults.Handle(error)) GenieBootstrap.Log("'" + title + "' failed: " + error);
                });
            };

            Thread thread       = new Thread(delegate() {
                Dispatcher  own    = Dispatcher.CurrentDispatcher;
                GenieWindow window = null;
                // Here an unhandled error would end the editor: nothing else is watching this thread.
                own.UnhandledException += delegate(object s, DispatcherUnhandledExceptionEventArgs e) {
                    e.Handled = true;
                    report(e.Exception);
                    if (window != null) window.Close();
                };
                try {
                    window         = new GenieWindow(title, width, height, null, settingsKey, addon, true, home);
                    window.Closed += delegate {
                        own.BeginInvokeShutdown(DispatcherPriority.Background);
                    };
                    own.BeginInvoke((Action)delegate { // inside the loop, so its errors reach the handler above
                        build(window);
                        window.Show();
                          });
                    Dispatcher.Run();
                } catch (Exception ex) {
                    report(ex);
                }
                  });
            thread.Name         = "AddonGenie window: " + title;
            thread.IsBackground = true; // never keeps the editor from exiting
            thread.SetApartmentState(ApartmentState.STA);
            thread.Start();
        }

        // Shows it without taking the foreground: it opens because of work, not a request to look at it.
        private void ShowOnOwnThread() {
            if (!_positioned) {
                Place();
                _positioned = true;
            }
            ShowWindow(_hwnd, SW_SHOWNOACTIVATE);
            if (_follower == null) _follower = new EditorFollower(_hwnd, _home.Frame, Close);
        }

        /// <summary>
        /// A pill window's corner radius (WindowUtils.CreatePillWindow sets half its height). Set it when the window
        /// changes shape, as the running pill does when it expands.
        /// </summary>
        public double CornerRadius {
            get { return _chrome == null ? 0 : _chrome.CornerRadius.TopLeft; }
            set {
                if (_chrome == null) return;
                _chrome.CornerRadius = new CornerRadius(value);
                ClipToCorners();
            }
        }

        /// <summary>
        /// Resizes the window to w by h DIPs, keeping its top left corner where it is: a pill that grows into a window
        /// grows down and right, from where the user left it, moving only as far as staying on the screen takes, and
        /// returns there as it shrinks.
        /// Before Show, sets the size it opens at.
        /// </summary>
        public void ResizeTo(double w, double h) {
            _w = w;
            _h = h;
            if (!IsOpen) return;
            RECT now;
            int  cw = (int)Math.Round(w * _sx), ch = (int)Math.Round(h * _sy);
            if (!_pill || !_positioned || !GetWindowRect(_hwnd, out now)) {
                SetWindowPos(_hwnd, IntPtr.Zero, 0, 0, cw, ch, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
                return;
            }
            if (!_pillSpot.HasValue) _pillSpot = new POINT { X = now.L, Y = now.T };
            int x = _pillSpot.Value.X, y = _pillSpot.Value.Y; // so shrinking again undoes a push back onto the screen
            KeepInWorkArea(new RECT(), ref x, ref y, ref cw, ref ch); // a pill has no invisible frame
            SetWindowPos(_hwnd, IntPtr.Zero, x, y, cw, ch, SWP_NOZORDER | SWP_NOACTIVATE);
        }

