            /// <summary>
            /// A clickable arrow that points something at the Content Browser's selection, like the host's own "Use
            /// selected object" button: dark green on light green by default, as the host's. Disables itself, saying
            /// so, while nothing is selected there; a click loads the selection first, so onClick can read it with
            /// GetSelectedObjects. selectionChanged: called with the selected assets, loaded or not, on each change and
            /// on RecheckUseIcon, while there are any, to judge them with SetTone (by BrowserAsset.Type, the class);
            /// with none, the tone is cleared. Order on a row: Use, Find, Open, Export, Import.
            /// </summary>
            public static Border CreateUseIcon(Action onClick,
                                               string tooltip = "Use the Content Browser's selected object",
                                               Brush stroke = null, Brush fill = null,
                                               Action<ContentBrowserUtils.BrowserAsset[]> selectionChanged = null) {
                System.Windows.Shapes.Path arrow = IconPath(UseArrow, 1.2);
                // An asset can be selected without being loaded, and GetSelectedObjects lists loaded ones only. So
                // any selected asset makes it available, and a click first loads the selection as the Content
                // Browser does before acting on one (LoadSelectedAssets), so onClick finds it loaded.
                Action click = delegate {
                    ContentBrowserUtils.LoadSelectedAssets();
                    if (onClick != null) onClick();
                };
                Border use = FlatIcon(arrow, new[] { arrow }, new[] { arrow }, click, tooltip,
                                      stroke ?? Theme.UseIconStroke, fill ?? Theme.UseIconFill);

                // Follows the selection only while shown, so a closed window leaves no subscription behind.
                IDisposable selection = null;
                Action      update    = delegate {
                    ContentBrowserUtils.BrowserAsset[] selected = ContentBrowserUtils.GetSelectedAssets();
                    SetAvailable(use, selected.Length > 0, "Nothing is selected in the Content Browser");
                    if (selectionChanged == null) return;
                    if (selected.Length > 0)
                        selectionChanged(selected);
                    else
                        ClearTone(use);
                };
                use.SetValue(RecheckProperty, update);
                WhileLoaded(use, delegate {
                    selection = ContentBrowserUtils.SubscribeToObjectSelection(update);
                    update();
                }, delegate {
                    if (selection != null) selection.Dispose();
                    selection = null;
                });
                return use;
            }

            /// <summary>
            /// Runs a Use icon's selectionChanged again, for when what it judges the selection against changes.
            /// Example: Redirector Manager, when another redirector is selected.
            /// </summary>
            public static void RecheckUseIcon(FrameworkElement use) {
                Action recheck = use == null ? null : use.GetValue(RecheckProperty) as Action;
                if (recheck != null && use.IsLoaded) recheck(); // unloaded: it rechecks when shown
            }

