            /// <summary>
            /// A text box that reads as a field table's value (GenieFieldTable): the code font, no border, no
            /// background, so an editable value looks like its read-only neighbours. hint shows, muted and in
            /// italics, while it's empty.
            /// </summary>
            public static TextBox CreateFieldTextBox(string text = null, string hint = null) {
                TextBox box = new TextBox {
                    Text                     = text ?? "",
                    FontFamily               = Theme.MonoFont,
                    FontSize                 = Theme.FontSizeValue,
                    Foreground               = Theme.TextPrimary,
                    BorderThickness          = new Thickness(0),
                    Padding                  = new Thickness(-2, 0, -2, 0), // the template insets text 2px each side
                    VerticalContentAlignment = VerticalAlignment.Center,
                    VerticalAlignment        = VerticalAlignment.Center,
                };
                // The hint is the background while it's empty, so it takes no layout and never becomes text.
                Brush empty = hint == null ? (Brush)Brushes.Transparent : new VisualBrush {
                    Visual = new TextBlock {
                        Text       = hint,
                        FontFamily = Theme.MonoFont,
                        FontSize   = Theme.FontSizeValue,
                        FontStyle  = FontStyles.Italic,
                        Foreground = Theme.TextDisabled,
                    },
                    AlignmentX = AlignmentX.Left,
                    AlignmentY = AlignmentY.Center,
                    Stretch    = Stretch.None,
                };
                Action paint = delegate {
                    box.Background = box.Text.Length == 0 ? empty : Brushes.Transparent;
                };
                box.TextChanged += delegate {
                    paint();
                };
                paint();
                return box;
            }

