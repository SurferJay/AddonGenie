            /// <summary>
            /// A relation table cell for an asset: a find icon and its path, its class in a tag under it. The path
            /// leaves out the package, which the column header usually names; showPackage keeps it. The full path
            /// shows on hover. afterFind: as CreateFindAssetIcon's.
            /// </summary>
            public static FrameworkElement CreateAssetCell(string pathName, string className,
                                                           bool showPackage = false, Action afterFind = null) {
                StackPanel cell = new StackPanel { Margin = new Thickness(4, 5, 4, 5) };
                DockPanel  top  = new DockPanel();
                Border     find = CreateFindAssetIcon(className + " " + pathName, afterFind);
                DockPanel.SetDock(find, Dock.Left);
                top.Children.Add(find);
                string    shown   = showPackage ? pathName : PathUtils.RemovePackageName(pathName) ?? pathName;
                TextBlock name    = CreateMonoText(shown, Theme.FontSizeLabel);
                name.Margin       = new Thickness(4, 0, 0, 0);
                name.TextTrimming = TextTrimming.CharacterEllipsis;
                SetToolTip(name, pathName);
                top.Children.Add(name);
                cell.Children.Add(top);
                if (!string.IsNullOrEmpty(className)) {
                    GenieTag cls            = CreateTag(className, TagTone.Type);
                    cls.HorizontalAlignment = HorizontalAlignment.Left;
