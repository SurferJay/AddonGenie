            private static readonly Geometry DragDots =
                FrozenGeometry("M 1,2 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0 M 5,2 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0 " +
                               "M 1,7 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0 M 5,7 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0 " +
                               "M 1,12 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0 M 5,12 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0");

            /// <summary>
            /// Six dots to drag a row by, for a cell of the row: pass it to GenieRow.SetDragHandle. Example: Package
            /// Loader's steps and substeps.
            /// </summary>
            public static FrameworkElement CreateDragHandle(string tooltip = "Drag to move") {
                System.Windows.Shapes.Path dots = new System.Windows.Shapes.Path {
                    Data                = DragDots,
                    Fill                = Theme.TextDisabled,
                    Width               = 8,
                    Height              = 14,
                    Stretch             = Stretch.None,
                    HorizontalAlignment = HorizontalAlignment.Center,
                    VerticalAlignment   = VerticalAlignment.Center,
                };
                Border handle = new Border {
                    Child      = dots,
                    Width      = 8,
                    Height     = 18,
                    Background = Brushes.Transparent, // the whole strip takes the press, not just the dots
                    Cursor     = System.Windows.Input.Cursors.SizeAll, // Windows' own move cursor; it has no hand
                };
                handle.MouseEnter += delegate {
                    dots.Fill = Theme.TextSecondary;
                };
                handle.MouseLeave += delegate {
                    dots.Fill = Theme.TextDisabled;
                };
                SetToolTip(handle, tooltip);
                return handle;
            }

            /// <summary>How far short of what it points at an elbow's arm stops.</summary>
            public const double BranchArmGap = 6;

            /// <summary>
            /// GenieTreeBox's elbow lines, for rows of any height laid out by hand, in an OnRender: a trunk at x from
            /// top down to the last arm, and an arm out to each of armEnds, top to bottom. End arms BranchArmGap short
            /// of their rows. Example: GenieRow.ShowBranchLines.
            /// </summary>
            public static void DrawBranchLines(DrawingContext dc, double x, double top, IList<Point> armEnds) {
                if (armEnds.Count == 0) return;
                Pen    pen   = new Pen(Theme.BranchLine, 1);
                double trunk = Math.Round(x) + 0.5, y = top; // half a pixel in, so a 1px line falls on one pixel
                foreach (Point end in armEnds) {
                    y = Math.Round(end.Y) + 0.5;
                    dc.DrawLine(pen, new Point(trunk, y), new Point(Math.Round(end.X) + 0.5, y));
                }
                dc.DrawLine(pen, new Point(trunk, top), new Point(trunk, y));
            }

