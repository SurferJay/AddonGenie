        /// <summary>
        /// Show and activate. The first Show places it: remembered bounds, else centred over the editor. While the
        /// editor is starting, windows reopened from last session show without activating: nobody asked for them.
        /// </summary>
        public void Show() {
            if (!IsOpen) throw new InvalidOperationException("GenieWindow is closed; create a new one.");
            if (_home != null) {
                ShowOnOwnThread();
                return;
            }
            bool placing = !_positioned;
            if (placing) {
                Place();
                _positioned = true;
            }
            SetWasOpen(true);
            if (_isInvoking && _config != null && !OpensWithInvoke(_config, _section.Substring(SectionPrefix.Length)))
                _config.Set(_section, OpensWithInvokeKey, "true");
            _front    = ++_fronts;
            _reopened = IsReopening;
            ShowWindow(_hwnd, IsReopening ? SW_SHOWNOACTIVATE : SW_SHOW);
            if (placing) Settle();
            if (!IsReopening) Activate();
        }

        // Set while the framework reopens last session's windows (GenieBootstrap.ReopenWindows).
        internal static bool IsReopening;

        private const string OpensWithInvokeKey = "OpensWithInvoke";
        private static bool  _isInvoking;

        // Runs an addon's Invoke(), noting which windows it shows: the ones that can come back next session.
        internal static void Invoke(LoadedAddon addon) {
            _isInvoking = true;
            try {
                addon.Instance.Invoke();
            } finally {
                _isInvoking = false;
            }
        }

        internal static bool OpensWithInvoke(IniFile config, string settingsKey) {
            return string.Equals(config.Get(SectionPrefix + settingsKey, OpensWithInvokeKey), "true",
                                 StringComparison.OrdinalIgnoreCase);
        }

        public void Activate() {
            if (!IsOpen) return;
            if (IsIconic(_hwnd)) ShowWindow(_hwnd, SW_RESTORE);
            SetForegroundWindow(_hwnd);
        }

        /// <summary>Raises Closing (cancellable), then destroys the window and raises Closed.</summary>
        // AddonFaults turning an addon off. Its Closing handlers still run; one that throws doesn't stop the rest.
        internal static void CloseAllOf(LoadedAddon addon) {
            foreach (GenieWindow w in _live.ToArray()) {
                if (w.Addon != addon) continue;
                try {
                    w.Close();
                } catch (Exception ex) {
                    GenieBootstrap.Log("Closing '" + w._title + "' failed: " + ex.Message);
                }
            }
            lock (_onOwnThreads) {
                foreach (GenieWindow w in _onOwnThreads) {
                    if (w.Addon == addon) w._contentHost.Dispatcher.BeginInvoke((Action)w.Close);
                }
            }
        }

        public void Close() {
            if (!IsOpen) return;
            System.ComponentModel.CancelEventArgs    args    = new System.ComponentModel.CancelEventArgs();
            System.ComponentModel.CancelEventHandler closing = Closing;
            if (closing != null) {
                try {
                    closing(this, args);
                } catch (Exception ex) {
                    GenieBootstrap.Log("GenieWindow Closing handler: " + ex);
                }
            }
            if (args.Cancel) return;

            _closeRequested = true;
            SetWasOpen(false); // closed on purpose: don't reopen next session

            // Hand activation to the editor first, or Windows may give it to another app.
            if (_owner != IntPtr.Zero && IsWindow(_owner) && GetActiveWindow() == _hwnd) SetActiveWindow(_owner);

            // Deferred: Close() usually runs inside our own WndProc (the X button, a click handler).
            System.Windows.Interop.HwndSource src = _src;
            src.Dispatcher.BeginInvoke((Action)delegate {
                try {
                    src.Dispose(); // DestroyWindow -> WM_DESTROY -> OnDestroyed
                } catch (Exception ex) {
                    GenieBootstrap.Log("GenieWindow dispose: " + ex);
                }
            });
        }

        // Its place in last session's stacking (higher in front), or -1.
        internal static int SavedZOrder(IniFile config, string settingsKey) {
            int z;
            return int.TryParse(config.Get(SectionPrefix + settingsKey, "ZOrder"), out z) ? z : -1;
        }

        // Stacks the windows ReopenAll just showed as they were saved, each under the one saved in front of it.
        // Opening them back to front isn't enough: a window shown without activating doesn't reliably come to the
        // front. Neither moves nor activates them, and leaves the editor's own windows where they are.
        internal static void RestoreStacking() {
            List<GenieWindow> reopened = _live.FindAll(delegate(GenieWindow w) { return w._reopened && w.IsOpen; });
            reopened.Sort(delegate(GenieWindow a, GenieWindow b) {
                int byZ = b._savedZOrder.CompareTo(a._savedZOrder); // front first
                return byZ != 0 ? byZ : b._front.CompareTo(a._front);
            });
            for (int i = 1; i < reopened.Count; i++)
                SetWindowPos(reopened[i]._hwnd, reopened[i - 1]._hwnd, 0, 0, 0, 0,
                             SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
            // Front values in the same order, so a window never touched this session is saved where it sits.
            for (int i = reopened.Count - 1; i >= 0; i--) {
                reopened[i]._front    = ++_fronts;
                reopened[i]._reopened = false;
            }
        }

        // True if the window was open when the editor last closed, and set to Remember if open.
        internal static bool WasOpen(IniFile config, string settingsKey) {
            string section = SectionPrefix + settingsKey;
            return string.Equals(config.Get(section, "WasOpen"), "true", StringComparison.OrdinalIgnoreCase) &&
                   !string.Equals(config.Get(section, "RememberIfOpen"), "false", StringComparison.OrdinalIgnoreCase);
        }

        private IntPtr Hook(IntPtr hwnd, int msg, IntPtr w, IntPtr l, ref bool handled) {
            if (_home == null) { // on its own thread, the wx message loop this answers isn't there
                IntPtr typed = WxKeyboard.Hook(hwnd, msg, w, l, ref handled);
                if (handled) return typed;
            }
            switch (msg) {
                case WM_CLOSE:
                    // X and Alt+F4 go through Close(), so Closing runs and teardown takes one path.
                    handled = true;
                    Close();
                    return IntPtr.Zero;

                case WM_GETMINMAXINFO: {
                    bool fit = _fitHeight && _fitOuterHeight > 0;
                    if (MinWidth <= 0 && MinHeight <= 0 && !fit) return IntPtr.Zero;
                    // MINMAXINFO.ptMinTrackSize: x at +24, y at +28; ptMaxTrackSize: y at +36.
                    if (MinWidth > 0) Marshal.WriteInt32(l, 24, (int)Math.Round(MinWidth * _sx));
                    if (MinHeight > 0) Marshal.WriteInt32(l, 28, (int)Math.Round(MinHeight * _sy));
                    if (fit) { // only the width can be dragged
                        Marshal.WriteInt32(l, 28, _fitOuterHeight);
                        Marshal.WriteInt32(l, 36, _fitOuterHeight);
                    }
                    handled = true;
                    return IntPtr.Zero;
                }

                case WM_ACTIVATE:
                    if (_home == null && ((long)w & 0xFFFF) != 0)
                        _front = ++_fronts; // WA_ACTIVE or WA_CLICKACTIVE: now in front
                    return IntPtr.Zero;

                case WM_EXITSIZEMOVE: { // dragged: saved now, as the editor can exit with this thread still going
                    RECT moved;
                    _pillSpot = null;
                    if (_home != null && GetWindowRect(_hwnd, out moved)) _home.SavePosition(moved.L, moved.T);
                    return IntPtr.Zero;
                }

                case WM_DESTROY:
                    OnDestroyed();      // also reached when the editor destroys us as our owner
                    return IntPtr.Zero; // not handled: HwndSource finishes its own teardown
            }
            return IntPtr.Zero;
        }

        private void OnDestroyed() {
            if (_destroyed) return;
            try {
                SaveBounds();
                // Only for a window the editor takes down with it: one closed on purpose isn't reopened.
                if (!_closeRequested && _config != null) _config.Set(_section, "ZOrder", _front.ToString());
            } catch (Exception ex) {
                GenieBootstrap.Log("couldn't save window bounds: " + ex.Message);
            }
            _destroyed                            = true;
            System.Windows.Interop.HwndSource src = _src;
            _src                                  = null;
            if (_home == null) {
                _live.Remove(this);
            } else {
                lock (_onOwnThreads) _onOwnThreads.Remove(this);
                if (_follower != null) _follower.Stop();
            }

            // After the HWND teardown finishes, outside the WndProc.
            Dispatcher d = (src != null) ? src.Dispatcher : Dispatcher.CurrentDispatcher;
            d.BeginInvoke((Action)delegate {
                try {
                    _contentHost.Child = null; // frees the content for reuse in a new window
                } catch {}
                EventHandler closed = Closed;
                if (closed == null) return;
                try {
                    closed(this, EventArgs.Empty);
                } catch (Exception ex) {
                    GenieBootstrap.Log("GenieWindow Closed handler: " + ex);
                }
            });
        }

        private void OnFrameMouseMove(object sender, System.Windows.Input.MouseEventArgs e) {
            if (_footer.Visibility != Visibility.Visible) return;
            const double Near = 6;
            Point        pt   = e.GetPosition(_footer);
            SetFooterHidden(pt.X >= -Near && pt.Y >= -Near && pt.X <= _footer.ActualWidth + Near &&
                            pt.Y <= _footer.ActualHeight + Near);
        }

        // The text's own letter outlines, stroked thick in the window's colour and softened, to sit under it. A drop
        // shadow glow was tried first: at caption size it spreads too thin to show. Built once the text has its
        // font, inherited from the window.
        private static FrameworkElement CreateHalo(TextBlock text) {
            System.Windows.Shapes.Path halo = new System.Windows.Shapes.Path {
                Stroke              = SystemColors.WindowBrush,
                Fill                = SystemColors.WindowBrush,
                StrokeThickness     = 3,
                StrokeLineJoin      = PenLineJoin.Round,
                HorizontalAlignment = HorizontalAlignment.Left,
                VerticalAlignment   = VerticalAlignment.Top,
                Effect              = new System.Windows.Media.Effects.BlurEffect { Radius = 2 },
            };
            text.Loaded += delegate {
#pragma warning disable 618 // the pixelsPerDip overload isn't in every framework this builds against
                FormattedText shape = new FormattedText(
                    text.Text, System.Globalization.CultureInfo.CurrentUICulture, text.FlowDirection,
                    new Typeface(text.FontFamily, text.FontStyle, text.FontWeight, text.FontStretch), text.FontSize,
                    Brushes.Black);
#pragma warning restore 618
                halo.Data = shape.BuildGeometry(new Point(0, 0));
            };
            return halo;
        }

        private void SetFooterHidden(bool hidden) {
            if (hidden == _footerHidden) return;
            _footerHidden                                       = hidden;
            System.Windows.Media.Animation.DoubleAnimation fade = new System.Windows.Media.Animation.DoubleAnimation(
                hidden ? 0.0 : 1.0, new Duration(TimeSpan.FromMilliseconds(120)));
            _footer.BeginAnimation(UIElement.OpacityProperty, fade);
        }

        // Remembered size and position if any, else the requested size centred over the editor. Its visible frame is
        // kept inside the nearest monitor's work area, so a window saved on an unplugged monitor still shows.
        private void Place() {
            int cw = (int)Math.Round(_w * _sx);
            int ch = (int)Math.Round(_h * _sy);
            if (RememberSize && !_pill) { // a pill's size is its state's, not the user's
                int sw = ReadInt("Width", 0), sh = ReadInt("Height", 0);
                if (sw > 0 && sh > 0) {
                    cw = sw;
                    ch = sh;
                }
            }

            RECT   o;
            IntPtr over = _home != null ? _home.Frame : _owner;
            if (over == IntPtr.Zero || !GetWindowRect(over, out o)) {
                o.L = 0;
                o.T = 0;
                o.R = cw;
                o.B = ch;
            }
            int x = o.L + ((o.R - o.L) - cw) / 2;
            int y = o.T + ((o.B - o.T) - ch) / 2;
            if (_home != null && _home.Left.HasValue) {
                x = _home.Left.Value;
                y = _home.Top.Value;
            } else if (RememberPosition) {
                int sx = ReadInt("Left", int.MinValue), sy = ReadInt("Top", int.MinValue);
                if (sx != int.MinValue && sy != int.MinValue) {
                    x = sx;
                    y = sy;
                }
            }

            RECT inset = new RECT(); // measured by Settle once shown; none on a thread of its own, which has no frame
            if (_home == null) _insets.TryGetValue(InsetKey(), out inset);
            KeepInWorkArea(inset, ref x, ref y, ref cw, ref ch);
            SetWindowPos(_hwnd, IntPtr.Zero, x, y, cw, ch, SWP_NOZORDER | SWP_NOACTIVATE);
            if (_fitHeight) FitHeight(); // the content may already be laid out, so no resize would trigger it
        }

        // The invisible part of a window's frame on each side: Windows 10 and later draw a thin edge and leave the
        // rest of the resize border invisible, so GetWindowRect (and the saved bounds) reach past what's seen, by
        // about 7 px at 100% scale. Measured by Settle and kept for the session, by scale: a window that was never
        // shown may not report its visible frame yet, so Place uses the last one measured.
        private static readonly Dictionary<int, RECT> _insets = new Dictionary<int, RECT>();

        private int InsetKey() {
            return (int)Math.Round(_sx * 100);
        }

        // Once first shown: measures the frame's insets and, if Place's guess was off, places the window again with
        // them. Before the window first paints, so it doesn't visibly jump.
        private void Settle() {
            RECT outer, visible;
            int  size = Marshal.SizeOf(typeof(RECT));
            if (IsZoomed(_hwnd) || !GetWindowRect(_hwnd, out outer) ||
                DwmGetWindowAttribute(_hwnd, DWMWA_EXTENDED_FRAME_BOUNDS, out visible, size) != 0)
                return;
            RECT inset;
            inset.L = visible.L - outer.L;
            inset.T = visible.T - outer.T;
            inset.R = outer.R - visible.R;
            inset.B = outer.B - visible.B;
            // Not a frame's: the two rectangles disagree (one scaled for DPI, the other not, say). Place's stands.
            const int MaxInset = 64;
            if (inset.L < 0 || inset.T < 0 || inset.R < 0 || inset.B < 0 || inset.L > MaxInset || inset.T > MaxInset ||
                inset.R > MaxInset || inset.B > MaxInset)
                return;
            _insets[InsetKey()] = inset;

            int x = outer.L, y = outer.T, cw = outer.R - outer.L, ch = outer.B - outer.T;
            KeepInWorkArea(inset, ref x, ref y, ref cw, ref ch);
            if (x != outer.L || y != outer.T || cw != outer.R - outer.L || ch != outer.B - outer.T)
                SetWindowPos(_hwnd, IntPtr.Zero, x, y, cw, ch, SWP_NOZORDER | SWP_NOACTIVATE);
        }

        // Moves and shrinks outer bounds so their visible frame (outer less inset) fits the nearest monitor's work
        // area. The invisible borders may hang past it, as they do on a window snapped to a screen edge.
        private static void KeepInWorkArea(RECT inset, ref int x, ref int y, ref int cw, ref int ch) {
            RECT want;
            want.L         = x + inset.L;
            want.T         = y + inset.T;
            want.R         = x + cw - inset.R;
            want.B         = y + ch - inset.B;
            MONITORINFO mi = new MONITORINFO();
            mi.cbSize      = Marshal.SizeOf(typeof(MONITORINFO));
            if (!GetMonitorInfoW(MonitorFromRect(ref want, MONITOR_DEFAULTTONEAREST), ref mi)) return;
            RECT work = mi.rcWork;
            cw        = Math.Min(cw, work.R - work.L + inset.L + inset.R);
            ch        = Math.Min(ch, work.B - work.T + inset.T + inset.B);
            x         = Math.Max(work.L - inset.L, Math.Min(x, work.R + inset.R - cw));
            y         = Math.Max(work.T - inset.T, Math.Min(y, work.B + inset.B - ch));
        }

        // The window's frame plus the height the content asks for; WM_GETMINMAXINFO then holds the frame to it.
        private void FitHeight() {
            if (!_fitHeight || _src == null || _destroyed || _contentHost.WantedHeight <= 0) return;
            RECT window, client;
            if (!GetWindowRect(_hwnd, out window) || !GetClientRect(_hwnd, out client)) return;
            int frame       = (window.B - window.T) - (client.B - client.T);
            _fitOuterHeight = (int)Math.Ceiling(_contentHost.WantedHeight * _sy) + frame;
            if (_fitOuterHeight == window.B - window.T || IsZoomed(_hwnd)) return;
            SetWindowPos(_hwnd, IntPtr.Zero, 0, 0, window.R - window.L, _fitOuterHeight,
                         SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
        }

        // Holds the content. While fitting, it measures the content at unlimited height and keeps what it asks for.
        // WPF clamps DesiredSize and ActualHeight to the client area, so neither can show the content outgrowing a
        // window that has shrunk to it, and the window would stay short.
        private sealed class ContentHost : Border {
            public bool   Fit;
            public double WantedHeight; // DIPs; 0 until measured while fitting

            public event Action WantedHeightChanged;

            protected override Size MeasureOverride(Size available) {
                if (!Fit) {
                    WantedHeight = 0;
                    return base.MeasureOverride(available);
                }
                Size want = base.MeasureOverride(new Size(available.Width, double.PositiveInfinity));
                if (want.Height != WantedHeight) {
                    WantedHeight = want.Height;
                    if (WantedHeightChanged != null) WantedHeightChanged();
                }
                return want;
            }
        }

        // Bounds are saved only as a window is destroyed (SaveBounds), so Clear Window Positions leaves open windows
        // where they are and notes their bounds: one still so when it closes saves none, and opens where a new
        // window does. Moved or resized since, by any means, it saves as usual.
        private bool _forgotten;
        private RECT _forgottenBounds;

        private static readonly string[] BoundsKeys = { "Left", "Top", "Width", "Height" };

        /// <summary>
        /// Clear Window Positions (Addons menu): removes every window's saved position and size from the framework's
        /// and each loaded addon's settings file, keeping the Remember settings. Moves nothing. Windows open now keep
        /// their place unless moved or resized before they close.
        /// </summary>
        internal static void ForgetSavedBounds() {
            List<IniFile>  configs = new List<IniFile>();
            List<Assembly> owners  = new List<Assembly> { typeof(GenieWindow).Assembly }; // the framework's windows
            foreach (LoadedAddon addon in AddonRegistry.Loaded) owners.Add(addon.Assembly);
            foreach (Assembly owner in owners) {
                IniFile config = AddonRegistry.ConfigFor(owner);
                if (config != null && !configs.Contains(config)) configs.Add(config);
            }

            int cleared = 0;
            foreach (IniFile config in configs) {
                foreach (string section in config.SectionNames()) {
                    if (section.StartsWith(SectionPrefix, StringComparison.OrdinalIgnoreCase) &&
                        config.RemoveMany(section, BoundsKeys))
                        cleared++;
                }
            }
            foreach (GenieWindow w in _live) {
                RECT r;
                if (w._destroyed || !w.GetRestoredBounds(out r)) continue;
                w._forgotten       = true;
                w._forgottenBounds = r;
            }
            GenieBootstrap.Log("Clear window positions: cleared the saved bounds of " +
                               Genie.TextUtils.Count(cleared, "window") + ".");
        }

        // The bounds it returns to when restored: its own unless maximized or minimized.
        private bool GetRestoredBounds(out RECT r) {
            if (IsZoomed(_hwnd) || IsIconic(_hwnd)) {
                WINDOWPLACEMENT wp = new WINDOWPLACEMENT();
                wp.length          = Marshal.SizeOf(typeof(WINDOWPLACEMENT));
                r                  = new RECT();
                if (!GetWindowPlacement(_hwnd, ref wp)) return false;
                r = wp.rcNormal;
                return true;
            }
            return GetWindowRect(_hwnd, out r);
        }

        // Runs while the HWND still exists (WM_DESTROY). Saves the restored bounds, not the maximized or
        // minimized ones, and only what's being remembered. Not for a window left as it was since Reset Window
        // Positions (ForgetSavedBounds), so the reset holds.
        private void SaveBounds() {
            if (_config == null || _hwnd == IntPtr.Zero) return;
            bool position = RememberPosition, size = RememberSize;
            if (!position && !size) return;

            RECT r;
            if (!GetRestoredBounds(out r)) return;
            if (_forgotten && r.L == _forgottenBounds.L && r.T == _forgottenBounds.T && r.R == _forgottenBounds.R &&
                r.B == _forgottenBounds.B)
                return;

            List<string> keys = new List<string>(), values = new List<string>();
            if (position) {
                keys.Add("Left");
                values.Add(r.L.ToString());
                keys.Add("Top");
                values.Add(r.T.ToString());
            }
            if (size) {
                keys.Add("Width");
                values.Add((r.R - r.L).ToString());
                keys.Add("Height");
                values.Add((r.B - r.T).ToString());
            }
            _config.SetMany(_section, keys.ToArray(), values.ToArray());
        }

        private void SetWasOpen(bool open) {
            if (_config == null) return;
            string value = open ? "true" : "false";
            if (!string.Equals(_config.Get(_section, "WasOpen"), value, StringComparison.OrdinalIgnoreCase))
                _config.Set(_section, "WasOpen", value);
        }

        // Missing or unreadable: true, the default for every Remember setting.
        private int ReadInt(string key, int fallback) {
            int    n;
            string value = (_config == null) ? null : _config.Get(_section, key);
            return (value != null && int.TryParse(value, out n)) ? n : fallback;
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct RECT {
            public int L, T, R, B;
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct POINT {
            public int X, Y;
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct MONITORINFO {
            public int  cbSize;
            public RECT rcMonitor, rcWork;
            public uint dwFlags;
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct WINDOWPLACEMENT {
            public int   length, flags, showCmd;
            public POINT ptMin, ptMax;
            public RECT  rcNormal;
        }

