    /// <summary>
    /// Made by Genie.ControlUtils.CreateSettingsButton: a gear opening a menu of checkbox settings and actions.
    /// The menu stays open as checkboxes are toggled and closes when an action is picked.
    /// </summary>
    public sealed class GenieSettingsButton : Decorator {
        // Six round-topped teeth and a hub, drawn in a 14px box like the other icons.
        private const string Gear =
            "M 5.38,2.54 L 5.69,0.84 A 6.3,6.3 0 0 1 8.31,0.84 L 8.62,2.54 A 4.75,4.75 0 0 1 10.05,3.36 L " +
            "11.68,2.78 A 6.3,6.3 0 0 1 12.99,5.05 L 11.68,6.18 A 4.75,4.75 0 0 1 11.68,7.82 L 12.99,8.95 A " +
            "6.3,6.3 0 0 1 11.68,11.22 L 10.05,10.64 A 4.75,4.75 0 0 1 8.62,11.46 L 8.31,13.16 A 6.3,6.3 0 0 1 " +
            "5.69,13.16 L 5.38,11.46 A 4.75,4.75 0 0 1 3.95,10.64 L 2.32,11.22 A 6.3,6.3 0 0 1 1.01,8.95 L " +
            "2.32,7.82 A 4.75,4.75 0 0 1 2.32,6.18 L 1.01,5.05 A 6.3,6.3 0 0 1 2.32,2.78 L 3.95,3.36 A 4.75,4.75 " +
            "0 0 1 5.38,2.54 Z M 9.1,7 A 2.1,2.1 0 1 1 4.9,7 A 2.1,2.1 0 1 1 9.1,7 Z";

        private readonly GenieMenuPopup _menu;
        private readonly StackPanel     _own    = new StackPanel();
        private readonly StackPanel     _window = new StackPanel();
        private readonly Border         _divider;

        internal GenieSettingsButton(GenieWindow window, string tooltip, Genie.ControlUtils.ButtonSize size)
            : this(window, Genie.ControlUtils.CreateIconButton(GearIcon(), size, tooltip, "Settings")) {}

        // face: the button that opens the menu, which lines up with its edges.
        internal GenieSettingsButton(GenieWindow window, Button face) {
            VerticalAlignment = VerticalAlignment.Center;
            Margin            = new Thickness(0, 0, Genie.Theme.Spacing, 0);
            Child             = face;

            _divider            = Genie.ControlUtils.CreateSeparator();
            _divider.Margin     = new Thickness(0, 4, 0, 4);
            _divider.Visibility = Visibility.Collapsed;

            _menu = new GenieMenuPopup(face);
            _menu.Items.Children.Add(_own);
            _menu.Items.Children.Add(_divider);
            _menu.Items.Children.Add(_window);
            face.Click += delegate {
                _menu.Open();
            };

            if (window == null) return;
            AddToggle(_window, "Remember position", window.RememberPositionToggle, "Reopens where you left it");
            AddToggle(_window, "Remember size", window.RememberSizeToggle, "Reopens at the size you left it");
            AddToggle(_window, "Remember if open", window.RememberIfOpenToggle, "Reopens next session if left open");
        }

        internal static System.Windows.Shapes.Path GearIcon() {
            return Genie.ControlUtils.IconPath(Gear, 1.2);
        }

        /// <summary>
        /// A checkbox setting you keep yourself, above the window's own. onChanged gets the new state. It shows only
        /// what it was given and what it's clicked to: for a setting that can change any other way, pass a GenieToggle.
        /// </summary>
        public CheckBox AddCheckItem(string text, bool isChecked, Action<bool> onChanged, string tooltip = null) {
            return Add(_own, text, isChecked, onChanged, tooltip);
        }

        /// <summary>
        /// A checkbox for toggle (Genie.ConfigUtils.CreateToggle), above the window's own: ticking it sets
        /// toggle.Value, and it shows toggle.Value however that changes. React to the change with toggle.Changed.
        /// </summary>
        public CheckBox AddCheckItem(string text, GenieToggle toggle, string tooltip = null) {
            if (toggle == null) throw new ArgumentNullException("toggle");
            return AddToggle(_own, text, toggle, tooltip);
        }

        /// <summary>The "Show tray shortcut" checkbox for your addon's shortcut (GenieTray.AddShortcut).</summary>
        public CheckBox AddTrayShortcutItem([CallerFilePath] string callerFile = null) {
            return AddCheckItem("Show tray shortcut", GenieTray.ShortcutToggle(AddonRegistry.AssemblyOf(callerFile)),
                                GenieTray.ShortcutHelp);
        }

        /// <summary>
        /// A number setting you keep yourself, above the window's own: "text [box] unit". onCommitted gets each value
        /// typed or stepped to; anything out of range puts the last one back. Set the box's Value to show a change
        /// made elsewhere.
        /// </summary>
        public GenieNumberBox AddNumberItem(string text, string unit, int value, int min, int max,
                                            Action<int> onCommitted, string tooltip = null) {
            return AddNumber(text, unit, value, min, max, onCommitted, tooltip, null);
        }

        /// <summary>
        /// A choice setting you keep yourself, above the window's own: "text [dropdown]", the dropdown right after its
        /// text as a number item's box is. onChanged gets the picked index. Set the dropdown's SelectedIndex to show a
        /// change made elsewhere. Example: Package Loader's Auto-expand.
        /// </summary>
        public ComboBox AddChoiceItem(string text, string[] choices, int selected, Action<int> onChanged,
                                      string tooltip = null) {
            ComboBox box = Genie.ControlUtils.CreateDropdown(choices, null, null, Genie.ControlUtils.ButtonSize.Small);
            box.SelectedIndex     = selected;
            box.Margin            = new Thickness(6, 0, 0, 0);
            box.SelectionChanged += delegate {
                if (box.SelectedIndex >= 0 && onChanged != null) onChanged(box.SelectedIndex);
            };
            StackPanel row =
                new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(12, 5, 14, 5) };
            row.Children.Add(MenuText(text));
            row.Children.Add(box);
            if (tooltip != null) Genie.ControlUtils.SetToolTip(row, tooltip);
            _own.Children.Add(row);
            UpdateDivider();
            return box;
        }

        /// <summary>
        /// "Back up settings for [N] sessions", with a find icon for the backups, for an addon that calls
        /// ConfigUtils.BackUpSettings. The same setting as the restore panel's footer.
        /// </summary>
        public GenieNumberBox AddBackupItem([CallerFilePath] string callerFile = null) {
            Assembly       owner = AddonRegistry.AssemblyOf(callerFile);
            Border         find  = SettingsBackupFind(owner);
            GenieNumberBox box   = AddNumber("Back up settings for", "sessions", SettingsBackups.GetKeep(owner),
                                             SettingsBackups.MinKeep, SettingsBackups.MaxKeep, delegate(int keep) {
                                               SettingsBackups.SetKeep(owner, keep);
                                             }, SettingsBackups.KeepHelp, find);
            FollowKeep(box, owner);
            return box;
        }

        // The zip in File Explorer, disabled while there's none.
        internal static Border SettingsBackupFind(Assembly owner) {
            string zip  = SettingsBackups.ZipPath(owner);
            Border find = Genie.ControlUtils.CreateFindIcon(delegate { Genie.FileUtils.ShowInExplorer(zip); },
                                                            "Show the backups in File Explorer: " + zip);
            Genie.ControlUtils.WhileLoaded(find, delegate {
                if (zip != null && File.Exists(zip))
                    Genie.ControlUtils.Unblock(find);
                else
                    Genie.ControlUtils.Block(find, "No backups yet");
            }, null);
            return find;
        }

        // The keep count can be set from the gear and the restore panel at once; each box shows the latest.
        internal static void FollowKeep(GenieNumberBox box, Assembly owner) {
            Action<Assembly> follow = delegate(Assembly changed) {
                if (changed == owner) box.Value = SettingsBackups.GetKeep(owner);
            };
            Genie.ControlUtils.WhileLoaded(box,
                                           delegate {
                                               box.Value                    = SettingsBackups.GetKeep(owner);
                                               SettingsBackups.KeepChanged += follow;
                                           },
                                           delegate { SettingsBackups.KeepChanged -= follow; });
        }

        // A menu has no room for a problem line, so a bad value is put back (RevertInvalid).
        private GenieNumberBox AddNumber(string text, string unit, int value, int min, int max, Action<int> onCommitted,
                                         string tooltip, UIElement after) {
            GenieNumberBox box = Genie.ControlUtils.CreateNumberBox(value, min, max, delegate(int? n) {
                if (n.HasValue && onCommitted != null) onCommitted(n.Value);
            });
            box.RevertInvalid = true;
            box.Margin         = new Thickness(6, 0, 6, 0);

            StackPanel row =
                new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(12, 5, 14, 5) };
            row.Children.Add(MenuText(text));
            row.Children.Add(box);
            row.Children.Add(MenuText(unit));
            if (after != null) {
                FrameworkElement fe = after as FrameworkElement;
                if (fe != null) fe.Margin = new Thickness(6, 0, 0, 0);
                row.Children.Add(after);
            }
            if (tooltip != null) Genie.ControlUtils.SetToolTip(row, tooltip);
            _own.Children.Add(row);
            UpdateDivider();
            return box;
        }

        private static TextBlock MenuText(string text) {
            return new TextBlock {
                Text              = text ?? "",
                FontSize          = Genie.Theme.FontSizeBody,
                Foreground        = Genie.Theme.TextPrimary,
                VerticalAlignment = VerticalAlignment.Center,
            };
        }

        private CheckBox AddToggle(StackPanel group, string text, GenieToggle toggle, string tooltip) {
            CheckBox item = Add(group, text, toggle.Value, delegate(bool on) {
                toggle.Value = on;
            }, tooltip);
            Action<bool> follow = delegate(bool on) {
                if (item.IsChecked != on) item.IsChecked = on;
            };
            // Listens only while the menu is open (its popup loads and unloads with it), and catches up each time it
            // opens: the toggle never holds a closed window.
            Genie.ControlUtils.WhileLoaded(item, delegate {
                follow(toggle.Value);
                toggle.Changed += follow;
            }, delegate {
                toggle.Changed -= follow;
            });
            return item;
        }

        /// <summary>
        /// An action above the window's settings, such as opening a help window: a title and an optional muted
        /// line under it (monoSubtitle for paths). Picking it closes the menu.
        /// </summary>
        public GenieMenuItem AddMenuItem(string title, string subtitle, Action onClick, bool monoSubtitle = false) {
            GenieMenuItem item = _menu.AddItem(_own, title, subtitle, onClick, monoSubtitle);
            UpdateDivider();
            return item;
        }

        /// <summary>A line between your groups of settings.</summary>
        public void AddSeparator() {
            Border line = Genie.ControlUtils.CreateSeparator();
            line.Margin = new Thickness(0, 4, 0, 4);
            _own.Children.Add(line);
        }

        // The whole row is the checkbox: padding, box and label all toggle it, highlight it and show its tooltip.
        private CheckBox Add(StackPanel group, string text, bool isChecked, Action<bool> onChanged, string tooltip) {
            CheckBox item             = Genie.ControlUtils.CreateCheckBox(text, isChecked, tooltip);
            item.Padding              = new Thickness(12, 6, 14, 6);
            item.FontSize             = Genie.Theme.FontSizeBody;
            item.HorizontalAlignment  = HorizontalAlignment.Stretch;
            item.MouseEnter          += delegate {
                if (item.IsEnabled) item.Background = Genie.Theme.InfoTagBackground;
            };
            item.MouseLeave += delegate {
                item.Background = Brushes.Transparent;
            };
            item.Checked += delegate {
                if (onChanged != null) onChanged(true);
            };
            item.Unchecked += delegate {
                if (onChanged != null) onChanged(false);
            };
            group.Children.Add(item);
            UpdateDivider();
            return item;
        }

        // Only between the addon's own entries and the window's; either group can be empty.
        private void UpdateDivider() {
            _divider.Visibility =
                (_own.Children.Count > 0 && _window.Children.Count > 0) ? Visibility.Visible : Visibility.Collapsed;
        }
    }

    /// <summary>An entry in a split or settings button's menu.</summary>
    public sealed class GenieMenuItem : Border {
        private readonly TextBlock _title, _subtitle;

        internal GenieMenuItem(string title, string subtitle, bool monoSubtitle) {
            Padding          = new Thickness(12, 5, 14, 6);
            Background       = Brushes.Transparent;
            StackPanel lines = new StackPanel();
            _title           = new TextBlock {
                Text       = title ?? "",
                FontSize   = Genie.Theme.FontSizeBody,
                Foreground = Genie.Theme.TextPrimary,
            };
            double subtitleSize = Genie.Theme.FontSizeTag + 0.5;
            if (monoSubtitle)
                _subtitle = Genie.ControlUtils.CreateMonoText(subtitle, subtitleSize);
            else
                _subtitle = new TextBlock { Text = subtitle ?? "", FontSize = subtitleSize };
            _subtitle.Foreground = Genie.Theme.TextSecondary;
            _subtitle.Margin     = new Thickness(0, 1, 0, 0);
            Subtitle             = subtitle; // hides an empty one
            lines.Children.Add(_title);
            lines.Children.Add(_subtitle);
            Child       = lines;
            MouseEnter += delegate {
                if (IsEnabled) Background = Genie.Theme.InfoTagBackground;
            };
            MouseLeave += delegate {
                Background = Brushes.Transparent;
            };
            IsEnabledChanged += delegate {
                Opacity = IsEnabled ? 1 : 0.45;
                if (!IsEnabled) Background = Brushes.Transparent;
            };
        }

        public string Title {
            get { return _title.Text; }
            set { _title.Text = value ?? ""; }
        }
        /// <summary>The muted line under the title. Empty or null: no line.</summary>
        public string Subtitle {
            get { return _subtitle.Text; }
            set {
                _subtitle.Text       = value ?? "";
                _subtitle.Visibility = (_subtitle.Text.Length > 0) ? Visibility.Visible : Visibility.Collapsed;
            }
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreateWindowControls. Members of a part left out do nothing: its event never fires,
    /// its properties read false or null.
    /// </summary>
    public sealed class GenieWindowControls : Border {
        // In a 14px box, like the gear. The pin leans over while unpinned and stands upright, filled, when pinned.
        private const string RefreshIcon =
            "M 12.92,2.66 L 12.92,5.9 L 9.68,5.9 M 11.56,8.6 A 4.86,4.86 0 1 1 10.42,3.55 L 12.92,5.9";
        private const string PinIcon = "M 4.55,1.58 L 9.45,1.58 M 5.43,1.58 L 5.43,4.73 L 3.5,7.53 L 10.5,7.53 L " +
                                       "8.58,4.73 L 8.58,1.58 Z M 7,7.53 L 7,12.43";
        private const double PinLean = 40;

        private readonly Button              _refresh, _pin;
        private readonly GenieSettingsButton _settings;

        private readonly System.Windows.Shapes.Path _pinIcon;
        private readonly RotateTransform            _pinTurn = new RotateTransform(PinLean);

        private bool   _isPinned, _canPin = true;
        private string _refreshToolTip = "Refresh";
        private string _pinToolTip     = "Pin: stay on what's shown";
        private string _unpinToolTip   = "Unpin: follow the Content Browser's selection again";

        /// <summary>Raised when the refresh button is clicked.</summary>
        public event Action Refresh;

        /// <summary>Raised when the pin button is clicked, after IsPinned has flipped; gets the new state.</summary>
        public event Action<bool> PinChanged;

        internal GenieWindowControls(GenieWindow window, Genie.ControlUtils.WindowControl show, bool windowOptions,
                                     Genie.ControlUtils.ButtonSize size) {
            Genie.ControlUtils.StyleButtonBox(this);

            List<Button> parts = new List<Button>();
            if ((show & Genie.ControlUtils.WindowControl.Refresh) != 0) {
                _refresh = Genie.ControlUtils.CreateIconButton(Genie.ControlUtils.IconPath(RefreshIcon, 1.3), size,
                                                               _refreshToolTip, "Refresh");
                _refresh.Click += delegate {
                    if (Refresh != null) Refresh();
                };
                parts.Add(_refresh);
            }
            if ((show & Genie.ControlUtils.WindowControl.Pin) != 0) {
                _pinIcon                        = Genie.ControlUtils.IconPath(PinIcon, 1.2);
                _pinIcon.RenderTransform        = _pinTurn;
                _pinIcon.RenderTransformOrigin  = new Point(0.5, 0.5);
                _pin                            = Genie.ControlUtils.CreateIconButton(_pinIcon, size, null, "Pin");
                _pin.Click                     += delegate {
                    IsPinned = !_isPinned;
                    if (PinChanged != null) PinChanged(_isPinned);
                };
                parts.Add(_pin);
            }
            Button gear = null;
            if ((show & Genie.ControlUtils.WindowControl.Settings) != 0) {
                gear             = Genie.ControlUtils.CreateIconButton(GenieSettingsButton.GearIcon(), size,
                                                                       "Settings for this addon", "Settings");
                _settings        = new GenieSettingsButton(windowOptions ? window : null, gear);
                _settings.Margin = new Thickness(0);
                parts.Add(gear);
            }

            // The box draws the outline; the buttons fill it, rounded only on its outer corners, a line between each.
            StackPanel row = new StackPanel { Orientation = Orientation.Horizontal };
            for (int i = 0; i < parts.Count; i++) {
                Button part          = parts[i];
                part.BorderThickness = new Thickness(0);
                Genie.ControlUtils.SetCornerRadius(part, Genie.ControlUtils.BoxedCorners(i, parts.Count));
                if (i > 0) row.Children.Add(Genie.ControlUtils.CreateSeparator(Orientation.Vertical));
                row.Children.Add(part == gear ? (UIElement)_settings : part);
            }
            Child = row;
            PaintPin();
        }

        /// <summary>The gear, for your own menu entries (AddMenuItem, AddCheckItem). Null without Settings.</summary>
        public GenieSettingsButton Settings {
            get { return _settings; }
        }

        public string RefreshToolTip {
            get { return _refreshToolTip; }
            set {
                _refreshToolTip = value;
                if (_refresh != null) Genie.ControlUtils.SetToolTip(_refresh, value);
            }
        }

        public bool IsRefreshEnabled {
            get { return _refresh != null && _refresh.IsEnabled; }
            set {
                if (_refresh != null) _refresh.IsEnabled = value;
            }
        }

        /// <summary>Whether the view is pinned. Setting it in code raises no PinChanged. Not saved.</summary>
        public bool IsPinned {
            get { return _isPinned; }
            set {
                _isPinned = value && _pin != null;
                PaintPin();
            }
        }

        /// <summary>False while there's nothing to pin. A pinned view can always be unpinned.</summary>
        public bool IsPinEnabled {
            get { return _pin != null && _canPin; }
            set {
                _canPin = value;
                PaintPin();
            }
        }

        /// <summary>The pin's tooltip while unpinned: what pinning holds ("Pin: stay on this package").</summary>
        public string PinToolTip {
            get { return _pinToolTip; }
            set {
                _pinToolTip = value;
                PaintPin();
            }
        }

        /// <summary>The pin's tooltip while pinned.</summary>
        public string UnpinToolTip {
            get { return _unpinToolTip; }
            set {
                _unpinToolTip = value;
                PaintPin();
            }
        }

        private void PaintPin() {
            if (_pin == null) return;
            _pin.IsEnabled  = _canPin || _isPinned;
            _pinTurn.Angle  = _isPinned ? 0 : PinLean;
            _pin.Foreground = _isPinned ? Genie.Theme.ToggleOnText : Genie.Theme.TextPrimary;
            _pin.Background = _isPinned ? Genie.Theme.ToggleOnBackground : Genie.Theme.ButtonBackground;
            if (_isPinned)
                _pinIcon.SetBinding(System.Windows.Shapes.Shape.FillProperty, Genie.ControlUtils.InkBinding());
            else
                _pinIcon.ClearValue(System.Windows.Shapes.Shape.FillProperty);
            Genie.ControlUtils.SetToolTip(_pin, _isPinned ? _unpinToolTip : _pinToolTip);
            System.Windows.Automation.AutomationProperties.SetName(_pin, _isPinned ? "Unpin" : "Pin");
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreatePanelHeader. With a package: its name in the code font, its loaded file on
    /// hover, and the pills. Without: NoPackageText, muted, and no pills. Each pill's own visibility stays yours.
    /// </summary>
    public sealed class GenieHeader : Border {
        private readonly TextBlock           _caption, _name;
        private readonly ContentControl      _captionExtra;
        private readonly StackPanel          _pills, _actions;
        private readonly GenieWindowControls _controls;

        private string _package, _title;
        private bool   _refused, _showFileExtension;
        private string _noPackageText    = "No package selected";
        private string _multiPackageText = "Too many packages selected";

        internal GenieHeader(GenieWindow window, string caption, Genie.ControlUtils.WindowControl show,
                             bool windowOptions, Genie.ControlUtils.ButtonSize size) {
            BorderBrush     = Genie.Theme.Separator;
            BorderThickness = new Thickness(0, 0, 0, 1);

            // Docked right in reverse: the controls at the edge, the actions before them, in the order added.
            DockPanel bar = new DockPanel { Margin = new Thickness(12, 8, 10, 9) };
            _controls     = Genie.ControlUtils.CreateWindowControls(window, show, windowOptions, size);
            DockPanel.SetDock(_controls, Dock.Right);
            bar.Children.Add(_controls);
            _actions =
                new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };
            DockPanel.SetDock(_actions, Dock.Right);
            bar.Children.Add(_actions);

            StackPanel head = new StackPanel { VerticalAlignment = VerticalAlignment.Center };
            StackPanel captionLine =
                new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 0, 0, 3) };
            _caption = Genie.ControlUtils.CreateCaption(caption);
            captionLine.Children.Add(_caption);
            _captionExtra = new ContentControl { Focusable = false, VerticalAlignment = VerticalAlignment.Center };
            captionLine.Children.Add(_captionExtra);
            head.Children.Add(captionLine);

            WrapPanel nameLine = new WrapPanel();
            _name = new TextBlock { VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(0, 0, 10, 0) };
            nameLine.Children.Add(_name);
            _pills =
                new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };
            nameLine.Children.Add(_pills);
            head.Children.Add(nameLine);
            bar.Children.Add(head);
            Child = bar;
            Render();
        }

        /// <summary>The refresh, pin and gear box at the right end.</summary>
        public GenieWindowControls Controls {
            get { return _controls; }
        }

        /// <summary>The caption, in capitals whatever the text's case. Can change as what's shown does.</summary>
        public string Caption {
            get { return _caption.Text; }
            set { _caption.Text = (value ?? "").ToUpperInvariant(); }
        }

        /// <summary>The package named, or null for none. A PackageFollower sets it for you.</summary>
        public string Package {
            get { return _package; }
            set { Show(value, false); }
        }

        /// <summary>
        /// For a header that doesn't name a package (JOB, RUN, BACKUP): shown in its place, in the window's font, with
        /// the pills. Null (the default) names the package.
        /// </summary>
        public string Title {
            get { return _title; }
            set {
                _title = value;
                Render();
            }
        }

        /// <summary>Shown, muted, while there's no package. Default "No package selected".</summary>
        public string NoPackageText {
            get { return _noPackageText; }
            set {
                _noPackageText = value ?? "";
                Render();
            }
        }

        /// <summary>
        /// Shown, muted, while a PackageFollower refuses a selection spanning several packages (MultiPackage.Refuse).
        /// Default "Too many packages selected".
        /// </summary>
        public string MultiPackageText {
            get { return _multiPackageText; }
            set {
                _multiPackageText = value ?? "";
                Render();
            }
        }

        /// <summary>
        /// Name the package as its file: "Pkg.upk", or "Pkg.umap" for a map. A package that isn't loaded from a file
        /// reads .upk. Default false.
        /// </summary>
        public bool ShowFileExtension {
            get { return _showFileExtension; }
            set {
                _showFileExtension = value;
                Render();
            }
        }

        /// <summary>Your own element after the caption, such as a second caption and its value.</summary>
        public UIElement CaptionExtra {
            get { return _captionExtra.Content as UIElement; }
            set { _captionExtra.Content = value; }
        }

        /// <summary>A pill after the name, such as a count. Hidden with the name; otherwise as you set it.</summary>
        public void AddPill(UIElement pill) {
            _pills.Children.Add(pill);
        }

        /// <summary>A button before the window controls. Several sit left to right in the order added.</summary>
        public void AddAction(UIElement action) {
            _actions.Children.Add(action);
        }

        /// <summary>
        /// Line up texts in CaptionExtra with the caption's baseline (ControlUtils.AlignBaselines). Call it for each
        /// new text, newest first, since the alignment waits for the first one to load.
        /// </summary>
        public void AlignWithCaption(params TextBlock[] texts) {
            List<TextBlock> all = new List<TextBlock>(texts);
            all.Add(_caption);
            Genie.ControlUtils.AlignBaselines(all.ToArray());
        }

        internal bool IsRefused {
            get { return _refused; }
        }

        internal void Show(string package, bool refused) {
            _package = string.IsNullOrEmpty(package) ? null : package;
            _refused = _package == null && refused;
            Render();
        }

        // Also when the package loads or unloads, which can change its file.
        internal void Render() {
            if (_title != null) {
                _name.Text = _title;
                _name.ClearValue(TextBlock.FontFamilyProperty);
                _name.FontWeight = FontWeights.SemiBold;
                _name.FontSize   = Genie.Theme.FontSizeTitle;
                _name.Foreground = Genie.Theme.TextPrimary;
                Genie.ControlUtils.SetToolTip(_name, null);
                _pills.Visibility = Visibility.Visible;
                return;
            }
            bool   has  = _package != null;
            string file = has ? Genie.PackageUtils.GetPackageFile(_package) : null;
            if (has) {
                string extension = (file == null) ? "" : Path.GetExtension(file);
                _name.Text = _showFileExtension ? _package + (extension.Length > 0 ? extension : ".upk") : _package;
                _name.FontFamily = Genie.Theme.MonoFont;
                _name.FontWeight = FontWeights.SemiBold;
                _name.FontSize   = Genie.Theme.FontSizeTitle;
                _name.Foreground = Genie.Theme.TextPrimary;
            } else {
                _name.Text = _refused ? _multiPackageText : _noPackageText;
                _name.ClearValue(TextBlock.FontFamilyProperty); // the window's font
                _name.FontWeight = FontWeights.Normal;
                _name.FontSize   = Genie.Theme.FontSizeValue;
                _name.Foreground = Genie.Theme.TextSecondary;
            }
            Genie.ControlUtils.SetToolTip(_name, file);
            _pills.Visibility = has ? Visibility.Visible : Visibility.Collapsed;
        }
    }

