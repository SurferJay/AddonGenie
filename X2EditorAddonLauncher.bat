    // GenieListPane.EnableSearch: the field over the list, and the filtering it does.
    internal sealed class ListSearch {
        private static readonly DependencyProperty WhyProperty =
            DependencyProperty.RegisterAttached("GenieSearchWhy", typeof(TextBlock), typeof(ListSearch));

        private readonly GenieListPane _pane;
        private readonly GenieList     _list;
        private readonly Func<object, string, string> _onMatch;
        private readonly string                       _nothingText;
        private readonly TextBox                      _box;
        private readonly Border                       _clear;
        private readonly GenieListNote                _nothing = new GenieListNote("");
        private UIElement                             _keysRoot;
        private bool                                  _queued;

        internal readonly Border Field;

        internal ListSearch(GenieListPane pane, GenieList list, string hint, Func<object, string, string> onMatch,
                            string nothingText) {
            _pane        = pane;
            _list        = list;
            _onMatch     = onMatch;
            _nothingText = nothingText ?? "";

            System.Windows.Shapes.Path lens = Genie.ControlUtils.IconPath(
                "M 6,1.9 A 4.1,4.1 0 1 1 6,10.1 A 4.1,4.1 0 1 1 6,1.9 Z M 9.1,9.1 L 12.4,12.4", 1.3);
            lens.Stroke            = Genie.Theme.TextSecondary;
            lens.Margin            = new Thickness(0, 0, 6, 0);
            lens.VerticalAlignment = VerticalAlignment.Center;
            _box                   = new TextBox {
                BorderThickness          = new Thickness(0),
                Background               = Brushes.Transparent,
                FontSize                 = Genie.Theme.FontSizeLabel,
                Foreground               = Genie.Theme.TextPrimary,
                VerticalContentAlignment = VerticalAlignment.Center,
            };
            TextBlock hintText = new TextBlock {
                Text              = hint ?? "",
                FontSize          = Genie.Theme.FontSizeLabel,
                Foreground        = Genie.Theme.TextDisabled,
                IsHitTestVisible  = false,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(2, 0, 0, 0),
            };
            _clear            = Genie.ControlUtils.CreateCloseIcon(Clear, "Clear the search (Esc)");
            _clear.Visibility = Visibility.Collapsed;
            DockPanel line    = new DockPanel();
            DockPanel.SetDock(lens, Dock.Left);
            DockPanel.SetDock(_clear, Dock.Right);
            line.Children.Add(lens);
            line.Children.Add(_clear);
            Grid entry = new Grid();
            entry.Children.Add(hintText);
            entry.Children.Add(_box);
            line.Children.Add(entry);
            Field = new Border {
                Child           = line,
                Height          = 26,
                Padding         = new Thickness(7, 0, 4, 0),
                BorderThickness = new Thickness(1),
                BorderBrush     = Genie.Theme.InputBorder,
                Background      = Genie.Theme.InputBackground,
                CornerRadius    = new CornerRadius(5),
            };
            Genie.ControlUtils.SetToolTip(Field, (hint ?? "Search") + ". Ctrl+F");

            _box.TextChanged += delegate {
                hintText.Visibility = _box.Text.Length > 0 ? Visibility.Collapsed : Visibility.Visible;
                _clear.Visibility   = _box.Text.Length > 0 ? Visibility.Visible : Visibility.Collapsed;
                Apply();
            };
            _box.IsKeyboardFocusWithinChanged += delegate {
                Field.BorderBrush = _box.IsKeyboardFocusWithin ? Genie.Theme.InfoTagText : Genie.Theme.InputBorder;
            };
            _box.PreviewKeyDown += delegate(object s, System.Windows.Input.KeyEventArgs e) {
                if (e.Key != System.Windows.Input.Key.Escape || _box.Text.Length == 0) return;
                Clear();
                e.Handled = true;
            };
            ((System.Collections.Specialized.INotifyCollectionChanged)_list.Items).CollectionChanged += delegate {
                QueueApply();
            };
            Genie.ControlUtils.WhileLoaded(pane, HookKeys, UnhookKeys);
        }

        internal string Query {
            get { return _box.Text.Trim(); }
        }

        private void Clear() {
            _box.Text = "";
            _box.Focus();
        }

        // Ctrl+F anywhere in the pane's window.
        private void HookKeys() {
            PresentationSource source = PresentationSource.FromVisual(_pane);
            _keysRoot                 = source == null ? null : source.RootVisual as UIElement;
            if (_keysRoot != null) _keysRoot.PreviewKeyDown += OnWindowKey;
        }

        private void UnhookKeys() {
            if (_keysRoot != null) _keysRoot.PreviewKeyDown -= OnWindowKey;
            _keysRoot = null;
        }

        private void OnWindowKey(object sender, System.Windows.Input.KeyEventArgs e) {
            if (e.Key != System.Windows.Input.Key.F ||
                System.Windows.Input.Keyboard.Modifiers != System.Windows.Input.ModifierKeys.Control)
                return;
            _box.Focus();
            _box.SelectAll();
            e.Handled = true;
        }

        // Rows come and go in bursts (a rebuild): filter once after.
        private void QueueApply() {
            if (_queued) return;
            _queued = true;
            _list.Dispatcher.BeginInvoke(DispatcherPriority.Background, (Action)delegate {
                _queued = false;
                Apply();
            });
        }

        internal void Apply() {
            string query   = Query;
            int    shown   = 0;
            object[] items = new object[_list.Items.Count];
            _list.Items.CopyTo(items, 0);
            foreach (object item in items) {
                ListBoxItem row = item as ListBoxItem;
                if (row == null || row is GenieListSection || row is GenieListNote) continue;
                string why     = query.Length == 0 ? "" : Match(row.Tag, query);
                row.Visibility = why == null ? Visibility.Collapsed : Visibility.Visible;
                if (why != null) shown++;
                SetWhy(row, why == null || why.Length == 0 ? null : why);
                Highlight(row.Content, why == "" ? query : null);
            }
            foreach (GenieListSection section in _list.Sections) {
                bool any = false;
                foreach (ListBoxItem row in section.Rows) any |= row.Visibility == Visibility.Visible;
                section.Visibility = query.Length == 0 || any ? Visibility.Visible : Visibility.Collapsed;
                section.UpdateEmpty();
            }
            _list.UpdateSections();
            bool nothing  = query.Length > 0 && shown == 0;
            _nothing.Text = nothing ? string.Format(_nothingText, query) : "";
            int at        = _list.Items.IndexOf(_nothing);
            if (nothing && at < 0) _list.Items.Add(_nothing);
            if (!nothing && at >= 0) _list.Items.Remove(_nothing);
        }

        private string Match(object tag, string query) {
            try {
                return _onMatch(tag, query);
            } catch (Exception ex) {
                EngineThunks.Trace("List search: onMatch failed: " + ex.Message);
                return "";
            }
        }

        // The why line under a row's content, made the first time a row needs one.
        private static void SetWhy(ListBoxItem row, string why) {
            TextBlock line = row.GetValue(WhyProperty) as TextBlock;
            if (line == null) {
                if (why == null) return;
                line = new TextBlock {
                    FontSize     = Genie.Theme.FontSizeTag,
                    Foreground   = Genie.Theme.InfoTagText,
                    TextTrimming = TextTrimming.CharacterEllipsis,
                    Margin       = new Thickness(0, 2, 0, 0),
                };
                object     content = row.Content;
                StackPanel both    = new StackPanel();
                row.Content        = both;
                both.Children.Add(content as UIElement ?? new TextBlock { Text = Convert.ToString(content) });
                both.Children.Add(line);
                row.SetValue(WhyProperty, line);
            }
            line.Text       = why ?? "";
            line.Visibility = why == null ? Visibility.Collapsed : Visibility.Visible;
        }

        // Every SetSearchable text under content, its first hit of query highlighted; query null: plain again.
        private static void Highlight(object content, string query) {
            DependencyObject root = content as DependencyObject;
            if (root == null) return;
            TextBlock text = root as TextBlock;
            if (text != null && Genie.ControlUtils.IsSearchable(text)) Genie.ControlUtils.ShowHit(text, query);
            foreach (object child in LogicalTreeHelper.GetChildren(root)) Highlight(child, query);
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateMoveButtons.</summary>
    public sealed class GenieMoveButtons : StackPanel {
        private readonly Border _up, _down;

        internal GenieMoveButtons(Action onUp, Action onDown, string upTip, string downTip) {
            VerticalAlignment = VerticalAlignment.Center;
            _up               = Arrow("M 1,4 L 4,1 L 7,4", onUp, upTip);
            _down             = Arrow("M 1,1 L 4,4 L 7,1", onDown, downTip);
            _down.Margin      = new Thickness(0, 1, 0, 0);
            Children.Add(_up);
            Children.Add(_down);
        }

        public bool CanMoveUp {
            get { return _up.IsEnabled; }
            set { _up.IsEnabled = value; }
        }

        public bool CanMoveDown {
            get { return _down.IsEnabled; }
            set { _down.IsEnabled = value; }
        }

        private static Border Arrow(string data, Action onClick, string tooltip) {
            System.Windows.Shapes.Path chevron = new System.Windows.Shapes.Path {
                Data               = Geometry.Parse(data),
                StrokeThickness    = 1.3,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
                StrokeLineJoin     = PenLineJoin.Round,
                Width              = 8,
                Height             = 5,
                Stretch            = Stretch.None,
            };
            Border button = new Border {
                Child        = chevron,
                Width        = 13,
                Height       = 10,
                CornerRadius = new CornerRadius(2),
                Cursor       = System.Windows.Input.Cursors.Hand,
            };
            Action paint = delegate {
                bool hot          = button.IsMouseOver && button.IsEnabled;
                button.Background = hot ? Genie.Theme.ButtonHoverBackground : Brushes.Transparent;
                chevron.Stroke    = hot ? Genie.Theme.TextPrimary : Genie.Theme.TextSecondary;
                button.Opacity    = button.IsEnabled ? 1 : 0.3;
            };
            button.MouseEnter += delegate {
                paint();
            };
            button.MouseLeave += delegate {
                paint();
            };
            button.IsEnabledChanged += delegate {
                paint();
            };
            button.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled = true; // a list row under it would take the click as a selection
                if (onClick != null) onClick();
            };
            paint();
            Genie.ControlUtils.SetToolTip(button, tooltip);
            return button;
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateFieldGroup.</summary>
    public sealed class GenieFieldGroup : Border {
        private readonly Border    _label;
        private readonly TextBlock _text;
        private readonly TextBox   _labelBox; // a typed label, in _text's place
        private readonly CheckBox  _check;

        internal GenieFieldGroup(CheckBox check, string label, UIElement field, bool enableWithCheck,
                                 TextBox labelBox) {
            _check    = check;
            _labelBox = labelBox;
            _text = new TextBlock {
                Text              = label ?? "",
                FontSize          = Genie.Theme.FontSizeLabel,
                Foreground        = Genie.Theme.TextSecondary,
                VerticalAlignment = VerticalAlignment.Center,
            };
            // Rounded on the left like the group's inside, or its square shade covers the group's corners there.
            double inner = Math.Max(0, Genie.Theme.ButtonCornerRadius - 1);
            _label       = new Border {
                Child           = _text,
                Padding         = new Thickness(8, 0, 7, 0),
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 1, 0),
                CornerRadius    = new CornerRadius(inner, 0, 0, inner),
            };
            if (labelBox != null) {
                labelBox.BorderThickness          = new Thickness(0);
                labelBox.Padding                  = new Thickness(0);
                labelBox.Background               = Brushes.Transparent;
                labelBox.VerticalContentAlignment = VerticalAlignment.Center;
                _label.Child                      = labelBox;
                _label.Padding = new Thickness(6, 0, 5, 0); // the box insets its text 2px: level with a label's
            }
            DockPanel row = new DockPanel();
            if (check != null) {
                // The checkbox's part takes the group's rounding; the label's shade is square beside it.
                Border lead = new Border {
                    Child           = check,
                    Padding         = new Thickness(8, 0, 10, 0),
                    BorderBrush     = Genie.Theme.Separator,
                    BorderThickness = new Thickness(0, 0, 1, 0),
                };
                check.VerticalAlignment = VerticalAlignment.Center;
                _label.CornerRadius     = new CornerRadius(0);
                DockPanel.SetDock(lead, Dock.Left);
                row.Children.Add(lead);
            }
            DockPanel.SetDock(_label, Dock.Left);
            row.Children.Add(_label);
            Control control = field as Control;
            if (control is TextBox || control is ComboBox) {
                control.BorderThickness = new Thickness(0);
                control.Background      = Brushes.Transparent;
            }
            if (field != null) row.Children.Add(field);
            Child               = row;
            MinHeight           = 24;
            BorderThickness     = new Thickness(1);
            CornerRadius        = new CornerRadius(Genie.Theme.ButtonCornerRadius);
            ClipToBounds        = true;
            SnapsToDevicePixels = true;
            VerticalAlignment   = VerticalAlignment.Center;
            Paint();
            if (check == null || !enableWithCheck) return;
            Action follow = delegate {
                bool on          = check.IsChecked == true;
                _text.Foreground = on ? Genie.Theme.TextSecondary : Genie.Theme.TextDisabled;
                if (field != null) field.IsEnabled = on;
            };
            check.Checked += delegate {
                follow();
            };
            check.Unchecked += delegate {
                follow();
            };
            follow();
        }

        /// <summary>The leading checkbox, or null for a plain [Label | field] group.</summary>
        public CheckBox Check {
            get { return _check; }
        }

        /// <summary>The label's text, or a typed label's.</summary>
        public string Label {
            get { return _labelBox != null ? _labelBox.Text : _text.Text; }
            set {
                if (_labelBox != null)
                    _labelBox.Text = value ?? "";
                else
                    _text.Text = value ?? "";
            }
        }

        /// <summary>The label part's width, so groups in a column line up their fields. NaN (default): fits the
        /// label.</summary>
        public double LabelWidth {
            get { return _label.Width; }
            set { _label.Width = value; }
        }

        // The input look, or a tone's (SetTone): its fill behind the field, its text colour as the border.
        internal void Paint() {
            object tone = GetValue(Genie.ControlUtils.ToneValueProperty);
            Brush  fill = Genie.Theme.InputBackground, edge = Genie.Theme.InputBorder,
                  label = Genie.Theme.PanelBackground;
            if (tone != null) {
                Brush unused;
                Genie.ControlUtils.ToneBrushes((Genie.ControlUtils.TagTone)tone, out fill, out unused, out edge);
                label = fill;
            }
            Background        = fill;
            BorderBrush       = edge;
            _label.Background = _labelBox != null ? fill : label; // a typed label reads as a field
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateFileNameText. Path can change later.</summary>
    public sealed class GenieFileNameText : TextBlock {
        private readonly string _noneText;
        private string          _path;

        internal GenieFileNameText(string path, string noneText) {
            _noneText         = noneText ?? "";
            FontFamily        = Genie.Theme.MonoFont;
            FontSize          = Genie.Theme.FontSizeLabel;
            TextTrimming      = TextTrimming.CharacterEllipsis;
            VerticalAlignment = VerticalAlignment.Center;
            Margin            = new Thickness(6, 0, 6, 0);
            Path              = path;
        }

        /// <summary>The full path shown by its file name; null or empty shows noneText.</summary>
        public string Path {
            get { return _path; }
            set {
                _path = string.IsNullOrEmpty(value) ? null : value;
                Inlines.Clear();
                if (_path == null) {
                    Inlines.Add(new System.Windows.Documents.Run(_noneText) { Foreground = Genie.Theme.TextSecondary });
                    Genie.ControlUtils.SetToolTip(this, null);
                    return;
                }
                string name = System.IO.Path.GetFileName(_path), ext = System.IO.Path.GetExtension(name);
                Inlines.Add(new System.Windows.Documents.Run(name.Substring(0, name.Length - ext.Length)) {
                    Foreground = Genie.Theme.TextPrimary,
                });
                Inlines.Add(new System.Windows.Documents.Run(ext) { Foreground = Genie.Theme.TextDisabled });
                Genie.ControlUtils.SetToolTip(this, _path);
            }
        }
    }

