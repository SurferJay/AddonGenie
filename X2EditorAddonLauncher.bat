    // == Folder Notifications (internal) ==============================================================

    // Windows' change notifications for a folder (FileSystemWatcher), raised on a pool thread and possibly
    // several per save; debounced onto the dispatcher that created the watch.
    // WM_CLIPBOARDUPDATE for a watcher's window, while the watcher's element is loaded. A window is registered with
    // the system once, however many watchers it holds.
    internal sealed class ClipboardWatch : IDisposable {
        private const int WM_CLIPBOARDUPDATE = 0x031D;

        [DllImport("user32.dll", SetLastError = true)]
        private static extern bool AddClipboardFormatListener(IntPtr hwnd);
        [DllImport("user32.dll", SetLastError = true)]
        private static extern bool RemoveClipboardFormatListener(IntPtr hwnd);

        private static readonly Dictionary<IntPtr, int> _listeners = new Dictionary<IntPtr, int>();

        private readonly Coalescer                _coalescer;
        private System.Windows.Interop.HwndSource _source;
        private bool                              _disposed;

        internal ClipboardWatch(FrameworkElement owner, Action onChanged) {
            _coalescer = new Coalescer(onChanged);
            Genie.ControlUtils.WhileLoaded(owner, delegate {
                if (!_disposed) Attach(owner);
            }, Detach);
        }

        public void Dispose() {
            _disposed = true;
            _coalescer.Dispose();
            Detach();
        }

        private void Attach(FrameworkElement owner) {
            _source = PresentationSource.FromVisual(owner) as System.Windows.Interop.HwndSource;
            if (_source == null) return;
            IntPtr hwnd = _source.Handle;
            int    count;
            _listeners.TryGetValue(hwnd, out count);
            if (count == 0 && !AddClipboardFormatListener(hwnd)) {
                GenieBootstrap.Log("Couldn't listen for clipboard changes (error " + Marshal.GetLastWin32Error() +
                                   ").");
                _source = null;
                return;
            }
            _listeners[hwnd] = count + 1;
            _source.AddHook(Hook);
        }

        private void Detach() {
            if (_source == null) return;
            _source.RemoveHook(Hook);
            IntPtr hwnd = _source.Handle;
            _source     = null;
            int count;
            if (!_listeners.TryGetValue(hwnd, out count)) return;
            if (count > 1) {
                _listeners[hwnd] = count - 1;
                return;
            }
            _listeners.Remove(hwnd);
            RemoveClipboardFormatListener(hwnd); // fails harmlessly if the window is already gone
        }

        // Not handled: the window's other listeners get it too.
        private IntPtr Hook(IntPtr hwnd, int msg, IntPtr wParam, IntPtr lParam, ref bool handled) {
            if (msg == WM_CLIPBOARDUPDATE) _coalescer.Fire();
            return IntPtr.Zero;
        }
    }

    internal sealed class FolderWatch : IDisposable {
        private const int QuietMs = 300;

        private readonly FileSystemWatcher _watcher;
        private readonly DispatcherTimer   _quiet;
        private readonly Dispatcher        _dispatcher;
        private bool                       _disposed;

        internal FolderWatch(string folder, Action handler) {
            _dispatcher      = Dispatcher.CurrentDispatcher;
            _quiet           = new DispatcherTimer(DispatcherPriority.Background, _dispatcher);
            _quiet.Interval  = TimeSpan.FromMilliseconds(QuietMs);
            _quiet.Tick     += delegate {
                _quiet.Stop();
                if (_disposed) return;
                try {
                    handler();
                } catch (Exception ex) {
                    GenieBootstrap.Log("folder notification handler: " + ex);
                }
            };

            _watcher                       = new FileSystemWatcher(folder);
            _watcher.IncludeSubdirectories = true;
            _watcher.NotifyFilter =
                NotifyFilters.FileName | NotifyFilters.DirectoryName | NotifyFilters.LastWrite | NotifyFilters.Size;
            _watcher.Changed             += OnChange;
            _watcher.Created             += OnChange;
            _watcher.Deleted             += OnChange;
            _watcher.Renamed             += OnChange;
            _watcher.EnableRaisingEvents  = true;
        }

        public void Dispose() {
            if (_disposed) return;
            _disposed                    = true;
            _watcher.EnableRaisingEvents = false;
            _watcher.Dispose();
            _dispatcher.BeginInvoke((Action)delegate { _quiet.Stop(); });
        }

        // Each change restarts the quiet period, so the handler runs once after the last one.
        private void OnChange(object sender, FileSystemEventArgs e) {
            if (_disposed) return;
            _dispatcher.BeginInvoke((Action)delegate {
                if (_disposed) return;
                _quiet.Stop();
                _quiet.Start();
            });
        }
    }

    // == Content Browser Notifications (internal) =====================================================
    // Change notifications from the Content Browser's own WPF objects, instead of polling. Ordinary .NET event
    // handlers and WPF property listeners: nothing in the editor is modified, and Dispose() removes them.
    //   Package selection: SourcesPanel.SelectionChanged, the event MainControl itself uses.
    //   Object selection:  AssetView.AssetSelectionChanged.
    //   Package state:     the package's tree node. ObjectContainerNode.Status is a DependencyProperty the
    //                      backend sets as packages load and unload (MContentBrowserControl.UpdatePackagesTreeUI);
    //                      Package.IsModified goes through INotifyPropertyChanged.
    //   Packages appearing or disappearing: each folder node's Children ObservableCollection.
    // Handlers run on the UI thread, coalesced: a burst of changes gives one call.

    // The framework's own changes to packages (ObjectUtils.SetPackageDirty, ForceDelete), for PackageWatch: the browser
    // raises Package.IsModified only when the unsaved flag turns on, so a second change to an unsaved package would
    // go unheard.
    internal static class PackageEdits {
        internal static event Action<string> Changed;

        internal static void Notify(string packageName) {
            Action<string> handler = Changed;
            if (handler != null && !string.IsNullOrEmpty(packageName)) handler(packageName);
        }
    }

    internal sealed class Coalescer {
        private readonly Action     _handler;
        private readonly Dispatcher _dispatcher;
        private bool                _pending, _disposed;

        internal Coalescer(Action handler) {
            _handler    = handler;
            _dispatcher = Dispatcher.CurrentDispatcher;
        }

        internal void Fire() {
            if (_pending || _disposed) return;
            _pending = true;
            _dispatcher.BeginInvoke(DispatcherPriority.Background, (Action)delegate {
                _pending = false;
                if (_disposed) return;
                try {
                    _handler();
                } catch (Exception ex) {
                    GenieBootstrap.Log("A coalesced handler failed: " + ex);
                }
            });
        }

        internal void Dispose() {
            _disposed = true;
        }
    }

    // A subscription to a Content Browser event, through reflection: the events aren't public API. Subscriptions may
    // share a coalescer, so several events give one call; disposing any of them stops it for all.
    internal sealed class SelectionSubscription : IDisposable {
        private readonly object     _source;
        private readonly MethodInfo _remove;
        private readonly Delegate   _handler;
        private readonly Coalescer  _coalescer;

        private SelectionSubscription(object source, MethodInfo remove, Type handlerType, Coalescer coalescer) {
            _source    = source;
            _remove    = remove;
            _coalescer = coalescer;
            // Bind to the event's shape: SourcesPanel's SelectionChangedDelegate is void(); AssetView's
            // AssetSelectionChangedEventHandler is (sender, args).
            bool       noArgs = handlerType.GetMethod("Invoke").GetParameters().Length == 0;
            MethodInfo target =
                typeof(SelectionSubscription)
                    .GetMethod(noArgs ? "Fire" : "FireArgs", BindingFlags.Instance | BindingFlags.NonPublic);
            _handler = Delegate.CreateDelegate(handlerType, this, target);
        }

        internal static SelectionSubscription Create(object source, string eventName, Coalescer coalescer) {
            const BindingFlags Flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
            EventInfo          ev    = source.GetType().GetEvent(eventName, Flags);
            if (ev == null) return null;
            MethodInfo add = ev.GetAddMethod(true), remove = ev.GetRemoveMethod(true);
            if (add == null || remove == null) return null;
            SelectionSubscription s = new SelectionSubscription(source, remove, ev.EventHandlerType, coalescer);
            add.Invoke(source, new object[] { s._handler });
            return s;
        }

        public void Dispose() {
            _coalescer.Dispose();
            try {
                _remove.Invoke(_source, new object[] { _handler });
            } catch {}
        }

        private void Fire() {
            _coalescer.Fire();
        }

        // object binds to any args type.
        private void FireArgs(object sender, object e) {
            _coalescer.Fire();
        }
    }

    // Watches the package tree's folder nodes for children being added or removed. Shared by every
    // PackageWatch and reference counted, so the hooks exist only while needed.
    internal static class PackageTreeStructure {
        private static readonly List<System.Collections.Specialized.INotifyCollectionChanged> _hooked =
            new List<System.Collections.Specialized.INotifyCollectionChanged>();

        private static int    _refs;
        private static object _root;
        private static Type   _folderType;

        internal static event Action Changed;

        internal static void AddRef(object rootFolder, Type folderType) {
            if (_refs++ > 0) return;
            _root       = rootFolder;
            _folderType = folderType;
            HookTree();
        }

        internal static void Release() {
            if (_refs == 0 || --_refs > 0) return;
            UnhookAll();
            _root = null;
        }

        private static void HookTree() {
            UnhookAll();
            if (_root != null) Hook(_root, 0);
        }

        private static void Hook(object folder, int depth) {
            if (folder == null || depth > 64) return; // guards against a cycle we don't expect
            object children = BrowserReflection.Invoke0(folder, "get_Children");
            System.Collections.Specialized.INotifyCollectionChanged observable =
                children as System.Collections.Specialized.INotifyCollectionChanged;
            if (observable == null) return;
            observable.CollectionChanged += OnChildrenChanged;
            _hooked.Add(observable);
            foreach (object child in (IEnumerable)children) {
                if (_folderType != null && _folderType.IsInstanceOfType(child)) Hook(child, depth + 1);
            }
        }

        private static void UnhookAll() {
            foreach (System.Collections.Specialized.INotifyCollectionChanged observable in _hooked) {
                try {
                    observable.CollectionChanged -= OnChildrenChanged;
                } catch {}
            }
            _hooked.Clear();
        }

        private static void OnChildrenChanged(object                                                          sender,
                                              System.Collections.Specialized.NotifyCollectionChangedEventArgs e) {
            // Folders come and go rarely; re-hooking the whole folder skeleton keeps this simple and exact.
            if (e.Action == System.Collections.Specialized.NotifyCollectionChangedAction.Reset ||
                ContainsFolder(e.NewItems) || ContainsFolder(e.OldItems))
                HookTree();
            Action changed = Changed;
            if (changed != null) changed();
        }

        private static bool ContainsFolder(IList items) {
            if (items == null || _folderType == null) return false;
            foreach (object item in items) {
                if (_folderType.IsInstanceOfType(item)) return true;
            }
            return false;
        }
    }

    // == Content Browser Tray (internal) ==============================================================
    // Where ContentBrowserUtils.PackagesTray shows: left of the Packages header's tree/list switch
    // (SourcesPanel.mPackageViewMode_Tree and _List, two RadioButtons in a SlateBorder docked right in the header's
    // DockPanel). The browser is hosted in a bare HwndSource with no adorner layer anywhere (probed), so the tray goes
    // into that DockPanel itself, docked right after the switch's border: the one change to the browser's tree.
    // Nothing of the browser's reads that panel's children; it reaches its controls through named fields.
    // The whole header is a Button that collapses the section, so the tray takes the left clicks on it (TrayView) and
    // the header never sees them. Placed once the browser is up (at idle, as reopened windows are), and again whenever
    // the switch loads (the browser rebuilt or redocked). Centred on the switch to the device pixel, and taking no
    // height in the header (TrayView), so the header keeps its own height: the tray's box is taller than the switch.

    internal static class PackagesTrayHost {
        internal static readonly GenieTray Tray = new GenieTray(RequestAttach);

        private const double Gap = 4; // between the tray and the switch

        private static bool             _attached, _pending;
        private static FrameworkElement _slot;  // the switch's slot in the header, which the tray centres on
        private static DockPanel        _panel; // the header's DockPanel

        static PackagesTrayHost() {
            Tray.View.IsVisibleChanged += OnVisibleChanged; // a hidden tray's box isn't measured, so isn't aligned
        }

        private static void RequestAttach() {
            if (_attached || _pending) return;
            _pending     = true;
            Dispatcher d = GenieBootstrap.UiDispatcher ?? Dispatcher.CurrentDispatcher;
            d.BeginInvoke(DispatcherPriority.ApplicationIdle, (Action)Attach);
        }

        private static void Attach() {
            _pending              = false;
            object           src  = BrowserReflection.Invoke0(BrowserReflection.MainControl(), "get_MySourcesPanel");
            FrameworkElement tree = Field(src, "mPackageViewMode_Tree");
            if (tree == null) {
                GenieBootstrap.Log("The Content Browser's package view switch wasn't found, so addon buttons don't " +
                                   "show in its Packages header.");
                return;
            }
            _attached   = true;
            tree.Loaded += delegate {
                Place(tree);
            };
            if (tree.IsLoaded) Place(tree);
        }

        // Into the DockPanel holding the switch, right after the switch's own slot in it. Right-aligned: if it ends up
        // the panel's last child, LastChildFill would stretch it over the title.
        private static void Place(FrameworkElement tree) {
            UIElement slot  = tree;
            DockPanel panel = null;
            for (DependencyObject d = VisualTreeHelper.GetParent(tree); d != null; d = VisualTreeHelper.GetParent(d)) {
                panel = d as DockPanel;
                if (panel != null) break;
                slot = d as UIElement ?? slot;
            }
            if (panel == null) {
                GenieBootstrap.Log("The Content Browser's Packages header wasn't found, so addon buttons don't show " +
                                   "there.");
                return;
            }
            TrayView view = Tray.View;
            if (view.Parent != panel) {
                Panel old = view.Parent as Panel;
                if (old != null) old.Children.Remove(view);
                view.HorizontalAlignment = HorizontalAlignment.Right;
                view.VerticalAlignment   = VerticalAlignment.Top; // Align sets the top margin
                view.Margin              = new Thickness(0, 0, Gap, 0);
                Conceal(view, true); // until Align has placed it: it would show at the header's top, then jump
                DockPanel.SetDock(view, Dock.Right);
                int at = panel.Children.IndexOf(slot);
                panel.Children.Insert(at < 0 ? 0 : at + 1, view);
            }
            // After the tray is in the header: Align does nothing while it isn't.
            Follow(slot as FrameworkElement, panel);
            Align();
            Tray.OnAttached();
        }

        // Realigns whenever the switch or the header changes size, and when the switch shows again (the Packages
        // section expanded): the only times the switch can move in the header. A rebuilt browser has a new switch,
        // so the old ones are let go.
        private static void Follow(FrameworkElement slot, DockPanel panel) {
            if (slot == _slot && panel == _panel) return;
            if (_slot != null) {
                _slot.SizeChanged      -= OnSizeChanged;
                _slot.IsVisibleChanged -= OnVisibleChanged;
            }
            if (_panel != null) _panel.SizeChanged -= OnSizeChanged;
            _slot  = slot;
            _panel = panel;
            if (_slot != null) {
                _slot.SizeChanged      += OnSizeChanged;
                _slot.IsVisibleChanged += OnVisibleChanged;
            }
            if (_panel != null) _panel.SizeChanged += OnSizeChanged;
        }

        private static void OnVisibleChanged(object sender, DependencyPropertyChangedEventArgs e) {
            Align();
        }

        private static void OnSizeChanged(object sender, SizeChangedEventArgs e) {
            if (e.HeightChanged || sender == _panel) Align();
        }

        // The tray's box centred on the switch, to the device pixel: worked out from the window's root, since the
        // header itself may sit between pixels, and an exact tie goes up. A pixel off is plain beside the switch.
        // Applied after the layout pass in progress, and revealed with it: the margin and the opacity reach the
        // screen in the same frame. Waits, still concealed, while the switch or the tray isn't showing; shown where it
        // is if the window can't be measured, rather than lost.
        private static void Align() {
            TrayView view = Tray.View;
            if (_slot == null || _panel == null || view.Parent != _panel || !_slot.IsLoaded) return;
            view.Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)delegate {
                if (view.Parent != _panel || !_slot.IsVisible || !view.IsVisible || view.BoxHeight <= 0) return;
                PresentationSource source = PresentationSource.FromVisual(_panel);
                if (source == null || source.RootVisual == null || source.CompositionTarget == null) {
                    Conceal(view, false);
                    return;
                }
                Visual root  = source.RootVisual;
                double scale = source.CompositionTarget.TransformToDevice.M22;
                double panelTop, slotTop;
                try {
                    panelTop = _panel.TransformToAncestor(root).Transform(new Point(0, 0)).Y;
                    slotTop  = _slot.TransformToAncestor(root).Transform(new Point(0, 0)).Y;
                } catch (InvalidOperationException) {
                    return; // not in the header any more: the next Place hides and aligns it again
                }
                double boxTop = slotTop + (_slot.ActualHeight - view.BoxHeight) / 2;
                double pixel  = Math.Ceiling(boxTop * scale - 0.5); // the nearest device pixel; a tie goes up
                double top    = pixel / scale - panelTop;
                if (Math.Abs(view.Margin.Top - top) > 0.01) view.Margin = new Thickness(0, top, Gap, 0);
                Conceal(view, false);
            });
        }

        // Invisible and unclickable, but still measured and laid out, so Align can place it. (Hidden visibility
        // would do, but a hidden element reads as not visible, which Align waits on.)
        private static void Conceal(TrayView view, bool concealed) {
            view.Opacity          = concealed ? 0 : 1;
            view.IsHitTestVisible = !concealed;
        }

        private static FrameworkElement Field(object owner, string name) {
            if (owner == null) return null;
            FieldInfo f = owner.GetType().GetField(name, BindingFlags.Instance | BindingFlags.Public |
                                                             BindingFlags.NonPublic);
            return (f == null) ? null : f.GetValue(owner) as FrameworkElement;
        }
    }

    // == Engine Interop (internal) ====================================================================

    // Native engine functions through the C++/CLI thunks XComGame.exe exposes as static methods of its
    // module, by name ("UObject.GetFullName"). Each thunk's parameter types come from reflection, so pointer
    // arguments are boxed to exactly the type the thunk declares.
    internal static class EngineThunks {
        internal const int MaxTable = 1000000; // sanity cap on table counts read from engine memory

        private static readonly Dictionary<string, MethodInfo> _byName = new Dictionary<string, MethodInfo>();
        private static Assembly                                _xcom;

        internal static void Trace(string message) {
            GenieBootstrap.Log(message);
        }

        internal static Assembly XCom() {
            if (_xcom != null) return _xcom;
            foreach (Assembly a in AppDomain.CurrentDomain.GetAssemblies()) {
                try {
                    if (a.GetName().Name == "XComGame") {
                        _xcom = a;
                        break;
                    }
                } catch {} // dynamic assemblies can throw here
            }
            return _xcom;
        }

        // The thunk with exactly this name, cached. Null (logged once) if this build lacks it.
        internal static MethodInfo Find(string name) {
            lock (_byName) {
                MethodInfo method;
                if (_byName.TryGetValue(name, out method)) return method;
                Assembly xcom = XCom();
                if (xcom == null) return null;
                foreach (MethodInfo m in xcom.ManifestModule.GetMethods(BindingFlags.Static | BindingFlags.Public |
                                                                        BindingFlags.NonPublic)) {
                    if (m.Name == name) {
                        method = m;
                        break;
                    }
                }
                if (method == null) Trace("engine thunk not found: " + name);
                _byName[name] = method;
                return method;
            }
        }

        // The thunk with this name and parameter count, for overloads (FName.{ctor} has three). Cached; null (logged
        // once) if this build lacks it.
        internal static MethodInfo Find(string name, int paramCount) {
            string key = name + "/" + paramCount;
            lock (_byName) {
                MethodInfo method;
                if (_byName.TryGetValue(key, out method)) return method;
                Assembly xcom = XCom();
                if (xcom == null) return null;
                foreach (MethodInfo m in xcom.ManifestModule.GetMethods(BindingFlags.Static | BindingFlags.Public |
                                                                        BindingFlags.NonPublic)) {
                    if (m.Name == name && m.GetParameters().Length == paramCount) {
                        method = m;
                        break;
                    }
                }
                if (method == null) Trace("engine thunk not found: " + key);
                _byName[key] = method;
                return method;
            }
        }

        // A pointer-valued engine global by name: C++/CLI keeps them as <Module> RVA statics (GError at 0x538EF28 in
        // this build). Its value, unboxed: reflection's box has the field's own pointer type, which a thunk's
        // parameter of the same C++ type doesn't accept, so re-box it with Box for the parameter. Zero if missing.
        internal static IntPtr Global(string name) {
            Assembly  xcom = XCom();
            FieldInfo f    = (xcom == null) ? null
                                            : xcom.ManifestModule.GetField(name, BindingFlags.Static |
                                                                                     BindingFlags.Public |
                                                                                     BindingFlags.NonPublic);
            if (f == null) {
                Trace("engine global not found: " + name);
                return IntPtr.Zero;
            }
            try {
                return Unbox(f.GetValue(null));
            } catch (Exception ex) {
                Trace("Reading " + name + " failed: " + ex.Message);
                return IntPtr.Zero;
            }
        }

        // An FName to pass by value, as fnameType (the thunk's own 8-byte FName: name index, number). Made by the
        // engine's FName(const TCHAR*, EFindName, UBOOL bSplitName) with FNAME_Add (1) and TRUE, as ObjectTools::
        // ConsolidateObjects makes one. Null (logged) if it can't be.
        internal static object NewFName(string text, Type fnameType) {
            MethodInfo ctor = Find("FName.{ctor}", 4);
            if (ctor == null) return null;
            if (Marshal.SizeOf(fnameType) != 8) {
                Trace("FName isn't 8 bytes as " + fnameType);
                return null;
            }
            IntPtr buf = Marshal.AllocHGlobal(8), chars = Marshal.StringToHGlobalUni(text);
            try {
                Marshal.WriteInt64(buf, 0);
                ParameterInfo[] p    = ctor.GetParameters();
                Type            find = p[2].ParameterType;
                ctor.Invoke(null, new object[] {
                    Box(buf, p[0].ParameterType),
                    Box(chars, p[1].ParameterType),
                    find.IsEnum ? Enum.ToObject(find, 1) : (object)1,
                    (uint)1,
                });
                return Marshal.PtrToStructure(buf, fnameType);
            } catch (Exception ex) {
                Trace("FName " + text + " failed: " + ex.Message);
                return null;
            } finally {
                Marshal.FreeHGlobal(chars);
                Marshal.FreeHGlobal(buf);
            }
        }

        internal static IntPtr Offset(IntPtr p, int bytes) {
            return new IntPtr(p.ToInt64() + bytes);
        }

        internal static unsafe object Box(IntPtr p, Type pointerType) {
            return Pointer.Box(p.ToPointer(), pointerType);
        }

        internal static unsafe IntPtr Unbox(object boxedPointer) {
            return (boxedPointer == null) ? IntPtr.Zero : new IntPtr(Pointer.Unbox(boxedPointer));
        }

        // T* f()
        internal static IntPtr CallPtr0(string name) {
            MethodInfo m = Find(name);
            if (m == null) return IntPtr.Zero;
            try {
                return Unbox(m.Invoke(null, null));
            } catch (Exception ex) {
                Trace(name + " failed: " + ex.Message);
                return IntPtr.Zero;
            }
        }

        // T* f(U*)
        internal static IntPtr CallPtr1(string name, IntPtr arg) {
            if (arg == IntPtr.Zero) return IntPtr.Zero;
            MethodInfo m = Find(name);
            if (m == null) return IntPtr.Zero;
            try {
                return Unbox(m.Invoke(null, new object[] { Box(arg, m.GetParameters()[0].ParameterType) }));
            } catch (Exception ex) {
                Trace(name + " failed: " + ex.Message);
                return IntPtr.Zero;
            }
        }

        // FString* f(UObject*, FString* result, UObject* stopOuter): GetFullName and GetPathName.
        internal static string CallObjectName(string name, IntPtr obj) {
            if (obj == IntPtr.Zero) return null;
            MethodInfo m = Find(name);
            if (m == null) return null;
            IntPtr result = NewFString();
            try {
                ParameterInfo[] p = m.GetParameters();
                m.Invoke(null, new object[] {
                    Box(obj, p[0].ParameterType),
                    Box(result, p[1].ParameterType),
                    Box(IntPtr.Zero, p[2].ParameterType),
                });
                return TakeFString(result);
            } catch (Exception ex) {
                Trace(name + " failed: " + ex.Message);
                return null;
            } finally {
                Marshal.FreeHGlobal(result);
            }
        }

        // An empty FString (Data, Num, Max) in our memory, for the engine to fill.
        internal static IntPtr NewFString() {
            IntPtr f = Marshal.AllocHGlobal(16);
            Marshal.WriteIntPtr(f, 0, IntPtr.Zero);
            Marshal.WriteInt64(f, 8, 0);
            return f;
        }

        // An FString's text, left in place: for strings the engine owns.
        internal static string ReadFString(IntPtr fstr) {
            IntPtr data  = Marshal.ReadIntPtr(fstr, 0);
            int    count = Marshal.ReadInt32(fstr, 8); // includes the terminating null
            if (data == IntPtr.Zero || count <= 0 || count > MaxTable) return null;
            return Marshal.PtrToStringUni(data, count - 1);
        }

        // Reads an engine-filled FString, then frees its characters with the engine's own FString destructor,
        // since the engine allocated them. The 16-byte holder stays the caller's to free.
        internal static string TakeFString(IntPtr fstr) {
            IntPtr data = Marshal.ReadIntPtr(fstr, 0);
            string s    = ReadFString(fstr);
            if (data == IntPtr.Zero) return s;

            MethodInfo dtor = Find("FString.{dtor}");
            if (dtor == null) return s;
            try {
                dtor.Invoke(null, new object[] { Box(fstr, dtor.GetParameters()[0].ParameterType) });
            } catch (Exception ex) {
                Trace("FString dtor failed: " + ex.Message);
            }
            return s;
        }

        // FString is a TArray<TCHAR>: same layout.
        internal static IntPtr NewEmptyArray() {
            return NewFString();
        }

        // A TArray<T*> (Data, Num, Max) in our memory holding these pointers, for passing to the engine.
        // The caller frees both arr and data.
        internal static IntPtr NewPointerArray(IntPtr[] items, out IntPtr data) {
            data = Marshal.AllocHGlobal(IntPtr.Size * Math.Max(1, items.Length));
            for (int i = 0; i < items.Length; i++) Marshal.WriteIntPtr(data, i * IntPtr.Size, items[i]);
            IntPtr arr = Marshal.AllocHGlobal(16);
            Marshal.WriteIntPtr(arr, 0, items.Length > 0 ? data : IntPtr.Zero);
            Marshal.WriteInt32(arr, 8, items.Length);
            Marshal.WriteInt32(arr, 12, items.Length);
            return arr;
        }
    }

    // Native engine functions the managed side doesn't expose, called by their address in XComGame.exe.
    // The SDK's editor is a frozen build, so each address is fixed. Still, before first use the code there and
    // a string the function uses are compared with what was read from that build; on any mismatch the
    // function is disabled (logged once) rather than calling code we haven't read.
    internal static class EngineNative {
        private static readonly Dictionary<string, IntPtr> _resolved = new Dictionary<string, IntPtr>();

        [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
        private static extern IntPtr GetModuleHandleW(string name);

        internal static IntPtr Resolve(string name, int rva, string codeHex, int stringRva, string expectedString) {
            lock (_resolved) {
                IntPtr fn;
                if (_resolved.TryGetValue(name, out fn)) return fn;
                fn = IntPtr.Zero;
                try {
                    IntPtr exe  = GetModuleHandleW(null);
                    IntPtr at   = EngineThunks.Offset(exe, rva);
                    byte[] code = new byte[codeHex.Length / 2];
                    Marshal.Copy(at, code, 0, code.Length);
                    bool codeMatches = BitConverter.ToString(code).Replace("-", "").ToLowerInvariant() == codeHex;
                    bool textMatches = stringRva < 0 || Marshal.PtrToStringUni(EngineThunks.Offset(exe, stringRva),
                                                                               expectedString.Length) == expectedString;
                    if (codeMatches && textMatches)
                        fn = at;
                    else
                        EngineThunks.Trace(name + " isn't where this build keeps it (code " +
                                           (codeMatches ? "matches" : "differs") + ", string " +
                                           (textMatches ? "matches" : "differs") + "); not calling it.");
                } catch (Exception ex) {
                    EngineThunks.Trace(name + ": couldn't check it: " + ex.Message);
                }
                _resolved[name] = fn;
                return fn;
            }
        }

        // Code only, for a function with no string of its own to check.
        internal static IntPtr Resolve(string name, int rva, string codeHex) {
            return Resolve(name, rva, codeHex, -1, null);
        }

        // A package's linker, looked up as UObject::GetPackageLinker looks first, without its fallback: that opens
        // the package's file to make one (ReloadLinker). Its loop (checked below) walks GObjLoaders, a
        // TArray<ULinkerLoad*>, via GetLoader(i) = Data[i], and compares each linker's LinkerRoot (+0x60) with the
        // package.
        private const int GObjLoadersDataRva = 0x54B4FD8;
        private const int GObjLoadersNumRva  = 0x54B4FE0;
        private const int LinkerRootOffset   = 0x60;

        internal static IntPtr FindLinker(IntPtr package) {
            if (package == IntPtr.Zero) return IntPtr.Zero;
            foreach (IntPtr linker in Loaders()) {
                if (Marshal.ReadIntPtr(linker, LinkerRootOffset) == package) return linker;
            }
            return IntPtr.Zero;
        }

        // Every linker in GObjLoaders, as that loop reads them. Empty if the loop doesn't match this build: the RVAs
        // come from it, so they can't be trusted either.
        internal static List<IntPtr> Loaders() {
            List<IntPtr> linkers = new List<IntPtr>();
            IntPtr       loop    = Resolve("GetPackageLinker's linker search", 0x2903E7,
                                           "391df34b22057e31904885ff75298bcbe874eeffff4839706075128bcbe867eeffff" +
                                               "488bf848898424a0000000ffc33b1dc44b22057cd2",
                                           0x3788C18, "PackageResolveFailed");
            if (loop == IntPtr.Zero) return linkers;
            IntPtr exe  = GetModuleHandleW(null);
            IntPtr data = Marshal.ReadIntPtr(EngineThunks.Offset(exe, GObjLoadersDataRva));
            int    num  = Marshal.ReadInt32(EngineThunks.Offset(exe, GObjLoadersNumRva));
            if (data == IntPtr.Zero || num < 0 || num > EngineThunks.MaxTable) return linkers;
            for (int i = 0; i < num; i++) {
                IntPtr linker = Marshal.ReadIntPtr(data, i * IntPtr.Size);
                if (linker != IntPtr.Zero) linkers.Add(linker);
            }
            return linkers;
        }

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate void BeginLoadFn();

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate void EndLoadFn(IntPtr loadContext);

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate IntPtr GetPackageLinkerFn(IntPtr outer, IntPtr name, uint loadFlags, IntPtr sandbox,
                                                   IntPtr guid);

        // What UObject::LoadPackage (0x2994E0) passes GetPackageLinker for a load with no flags of its own.
        private const uint LoadPackageLinkerFlags = 8;

        // Makes a linker for each package in memory, as UObject::LoadPackage does: BeginLoad (0x27F2A0) raises
        // GObjBeginLoadCount (0x53AC928), GetPackageLinker makes the linker, EndLoad (0x2874C0) lowers the count.
        // GetPackageLinker checks the count before it makes one (0x290A5F): called outside the pair it failed that
        // check, and the editor crashed at the next garbage collection. Given the package and no name, it finds the
        // file by the package's name in GPackageFileCache, as the editor's save does. EndLoad only works when the
        // count reaches 0 with objects, imports or forced exports pending (0x287595). LoadPackage's LoadAllObjects is
        // left out: on a new linker, CreateExport builds each export over the object already in memory (0x234C31),
        // which would reread the whole package from disk. One pair for all, as nested loads share one: BeginLoad
        // sets up only when the count leaves 0, EndLoad works only when it returns there. False if a piece isn't
        // where this build keeps it; then nothing is called.
        internal static bool ReloadLinkers(IList<IntPtr> packages) {
            IntPtr begin = Resolve("UObject::BeginLoad", 0x27F2A0, "4883ec388b057ed61205ffc0890576d6");
            IntPtr end   = Resolve("UObject::EndLoad", 0x2874C0, "488bc45741544155415641574881ece0");
            IntPtr get   = Resolve("UObject::GetPackageLinker", 0x290360, "4053565741544155415641574881ece0");
            if (begin == IntPtr.Zero || end == IntPtr.Zero || get == IntPtr.Zero) return false;
            BeginLoadFn beginLoad = (BeginLoadFn)Marshal.GetDelegateForFunctionPointer(begin, typeof(BeginLoadFn));
            EndLoadFn   endLoad   = (EndLoadFn)Marshal.GetDelegateForFunctionPointer(end, typeof(EndLoadFn));
            GetPackageLinkerFn getLinker =
                (GetPackageLinkerFn)Marshal.GetDelegateForFunctionPointer(get, typeof(GetPackageLinkerFn));
            beginLoad();
            try {
                foreach (IntPtr package in packages) {
                    try {
                        getLinker(package, IntPtr.Zero, LoadPackageLinkerFlags, IntPtr.Zero, IntPtr.Zero);
                    } catch (Exception ex) {
                        EngineThunks.Trace("GetPackageLinker failed: " + ex.Message);
                    }
                }
            } finally {
                endLoad(IntPtr.Zero);
            }
            return true;
        }

        // UObject::Rename(const TCHAR* NewName, UObject* NewOuter, ERenameFlags Flags), virtual at +0x1A0, as OBJ
        // RENAME calls it. Read from this build:
        //   Flags & 1 (REN_ForceNoResetLoaders): else it calls ResetLoaders(GetOuter()) first. A top-level package's
        //     outer is NULL, and ResetLoaders(NULL) detaches every loader in the editor, so packages always pass it.
        //   Flags & 2 (REN_Test): returns after the name check (StaticFindObject in the new outer), changing nothing.
        //   Flags & 4 (REN_DoNotDirty): else it calls Modify(TRUE), which dirties the package.
        //   A top-level package gets no redirector; other public objects can.
        // A NULL NewOuter keeps the outer. Returns nonzero on success.
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        internal delegate uint RenameFn(IntPtr obj, IntPtr newName, IntPtr newOuter, uint flags);

        // UObject::ResetLoaders(UObject* InPkg), static. Flushes async loading, then Detach(TRUE)es the loader whose
        // LinkerRoot is InPkg's outermost (TRUE: bulk data is loaded first, so nothing needs the file afterwards) and
        // clears other loaders' imports that point at it. NULL resets every loader.
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        internal delegate void ResetLoadersFn(IntPtr package);

        internal const uint RenForceNoResetLoaders = 1;
        internal const uint RenTest                = 2;

        private const int RenameRva       = 0x2A45E0;
        private const int RenameSlot      = 0x1A0;
        private const int ResetLoadersRva = 0x2A5A70;

        private static RenameFn       _rename;
        private static ResetLoadersFn _resetLoaders;

        // Rename for this object, or null. Called through the object's vtable as the editor does; the slot must hold
        // UObject::Rename as read from this build (UPackage doesn't override it).
        internal static RenameFn Rename(IntPtr obj) {
            IntPtr site = Resolve("OBJ RENAME's Rename call", 0x1A4B02D, "4533c94d8bc6488b4c2450ff97a0010000",
                                  0x3F68F70, "NEWNAME=");
            IntPtr fn   = Resolve("UObject::Rename", RenameRva,
                                  "48895424105556574154415541564157488d6c24d94881ece000000048c74517feffffff" +
                                      "48899c2420010000458be94d8be0488bda4c8bf933ff448bf7897d774d85c00f841c030000",
                                  0x3789D10, "Cannot rename %s into Outer %s as it is not of type %s");
            if (site == IntPtr.Zero || fn == IntPtr.Zero || obj == IntPtr.Zero) return null;
            if (Marshal.ReadIntPtr(Marshal.ReadIntPtr(obj), RenameSlot) != fn) {
                EngineThunks.Trace("This object's Rename isn't UObject's, as read from this build; not calling it.");
                return null;
            }
            if (_rename == null) _rename = (RenameFn)Marshal.GetDelegateForFunctionPointer(fn, typeof(RenameFn));
            return _rename;
        }

        // Checked at Rename's own call: "test r13b,1; jnz; mov rcx,[r15+0x40]; call ResetLoaders".
        internal static ResetLoadersFn ResetLoaders() {
            if (_resetLoaders != null) return _resetLoaders;
            IntPtr site = Resolve("Rename's ResetLoaders call", 0x2A4B96, "41f6c5017509498b4f40e8cb0e0000",
                                  0x3789D10, "Cannot rename %s into Outer %s as it is not of type %s");
            if (site == IntPtr.Zero) return null;
            IntPtr fn     = EngineThunks.Offset(GetModuleHandleW(null), ResetLoadersRva);
            _resetLoaders = (ResetLoadersFn)Marshal.GetDelegateForFunctionPointer(fn, typeof(ResetLoadersFn));
            return _resetLoaders;
        }

        // The Content Browser refresh OBJ RENAME sends after a rename, sent the same way:
        //   GCallbackEvent->Send(FCallbackEventParameters(NULL, 0x18 (CALLBACK_RefreshContentBrowser), 0xD5, Object))
        // GCallbackEvent is a pointer at 0x5383558, Send its second virtual; the parameters' constructor is at
        // 0x101530 (this, Sender, EventType, EventFlags, EventObject). The checked call site fixes all of these.
        // 0xD5 includes 0x10, which makes the browser's handler (FContentBrowser.Send) queue a full rebuild of its
        // package list on the next tick (RequestPackageListUpdate with bQuick false): that lists the new name, and
        // also every file in GPackageFileCache outside the external folders, a renamed-away one included.
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate IntPtr CallbackParamsCtorFn(IntPtr self, IntPtr sender, uint type, uint flags, IntPtr obj);

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate void SendCallbackFn(IntPtr callbackEvent, IntPtr parameters);

        private const int  GCallbackEventRva     = 0x5383558;
        private const int  CallbackParamsCtor    = 0x101530;
        private const int  CallbackParamsSize    = 0x40; // the constructor writes up to +0x3C
        private const uint RefreshContentBrowser = 0x18;
        private const uint RefreshRenameFlags    = 0xD5;
        private const uint RefreshLoadFlags      = 0x91; // what PackageTools.LoadPackage sends per package
        private const uint RefreshAssetFlags     = 0x04; // LoadSelectedObjectsIfNeeded, per object it loads
        private const uint RefreshFullyFlags     = 0x01; // the same, for that object's package once fully loaded

        internal static bool SendRenameRefresh(IntPtr obj) {
            return SendBrowserRefresh(obj, RefreshRenameFlags);
        }

        internal static bool SendLoadRefresh(IntPtr package) {
            return SendBrowserRefresh(package, RefreshLoadFlags);
        }

        internal static bool SendAssetLoadRefresh(IntPtr obj) {
            return SendBrowserRefresh(obj, RefreshAssetFlags);
        }

        internal static bool SendFullyLoadedRefresh(IntPtr package) {
            return SendBrowserRefresh(package, RefreshFullyFlags);
        }

        // Only the flags differ between callers; the checked site fixes the addresses for all of them.
        private static bool SendBrowserRefresh(IntPtr obj, uint flags) {
            IntPtr site = Resolve("OBJ RENAME's browser refresh", 0x1A4B056,
                                  "488b05fb849303488b3848894c242033d241b9d5000000448d4218488d4dd0e8b6646bfe" +
                                      "488bd0488b0dd4849303ff5708",
                                  0x3F68F70, "NEWNAME=");
            if (site == IntPtr.Zero) return false;
            IntPtr exe   = GetModuleHandleW(null);
            IntPtr cb    = Marshal.ReadIntPtr(EngineThunks.Offset(exe, GCallbackEventRva));
            if (cb == IntPtr.Zero) return false;
            IntPtr parms = Marshal.AllocHGlobal(CallbackParamsSize);
            try {
                for (int i = 0; i < CallbackParamsSize; i += 8) Marshal.WriteInt64(parms, i, 0);
                CallbackParamsCtorFn ctor = (CallbackParamsCtorFn)Marshal.GetDelegateForFunctionPointer(
                    EngineThunks.Offset(exe, CallbackParamsCtor), typeof(CallbackParamsCtorFn));
                ctor(parms, IntPtr.Zero, RefreshContentBrowser, flags, obj);
                SendCallbackFn send = (SendCallbackFn)Marshal.GetDelegateForFunctionPointer(
                    Marshal.ReadIntPtr(Marshal.ReadIntPtr(cb), 8), typeof(SendCallbackFn));
                send(cb, parms);
                return true;
            } catch (Exception ex) {
                EngineThunks.Trace("Browser refresh failed: " + ex.Message);
                return false;
            } finally {
                Marshal.FreeHGlobal(parms);
            }
        }

        // == Package Loading ==========================================================================
        // PackageTools::LoadPackage (0x1BD8310) taken apart, so a batch pays its per-call cost once:
        //   FGlobalComponentReattachContext   detaches every component in the editor; its destructor reattaches
        //   EdClearLoadErrors                 empties GEdLoadErrors
        //   UObject::LoadPackage(NULL, File, 0)
        // Its other steps are left out: the Load Errors dialog (addons own their dialogs), ResetLoaders on a package of
        // that name already in memory (PackageUtils.CheckLoadFromFile refuses those instead), and UserOpenedFile.
        // Each address is checked by its first 16 bytes, read from this build.
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate IntPtr ReattachCtorFn(IntPtr self);

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate void ReattachDtorFn(IntPtr self);

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate IntPtr LoadPackageFn(IntPtr outer, IntPtr fileName, uint loadFlags);

        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate void ClearLoadErrorsFn();

        // FPackageFileCache::FindPackageFile(const TCHAR* Name, const FGuid* Guid, FString& OutFileName,
        // const TCHAR* Language), virtual at +0x10: GetPackageLinker's lookup. Given a full path it adds that file to
        // the cache for the session, replacing an entry of the same name (probes 4 and 6).
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate uint FindPackageFileFn(IntPtr cache, IntPtr name, IntPtr guid, IntPtr outFileName,
                                                IntPtr language);

        // TArray<FString> FPackageFileCache::GetPackageFileList(), virtual at +0x28, returned by value: the caller
        // passes the array to fill, as the Open handler does. Never asks GFileManager, so it keeps entries whose file
        // is gone (FileCacheProbe).
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        private delegate IntPtr GetPackageFileListFn(IntPtr cache, IntPtr result);

        private const int ReattachStorage      = 0x40; // the constructor writes under 0x10
        private const int GEdLoadErrorsDataRva = 0x539F410;
        private const int GEdLoadErrorsNumRva  = 0x539F418;
        private const int LoadErrorSize        = 0x14; // +0 INT Type, +4 FString Desc, packed to 4
        private const int FindPackageFileSlot  = 0x10;
        private const int FileListSlot         = 0x28;

        internal sealed class LoadError {
            internal int    Type; // 0: a package's file not found, 1: an object not found in its package
            internal string Text;
        }

        private static ReattachCtorFn    _reattachCtor;
        private static ReattachDtorFn    _reattachDtor;
        private static LoadPackageFn     _loadPackage;
        private static ClearLoadErrorsFn _clearLoadErrors;

        private static bool _loadChecked;

        // True if every piece of a batch load is where this build keeps it. Checked once; a mismatch is logged.
        internal static bool CanLoadPackageFiles() {
            if (_loadChecked) return _loadPackage != null;
            _loadChecked = true;
            IntPtr ctor  = Resolve("FGlobalComponentReattachContext()", 0x69C120, "48894c2408565741564883ec4048c744");
            IntPtr dtor  = Resolve("~FGlobalComponentReattachContext", 0x6A62A0, "40534883ec3048c7442420feffffff48");
            IntPtr load  = Resolve("UObject::LoadPackage", 0x2994E0, "4053565741544155415641574881ecd0");
            IntPtr clear = Resolve("EdClearLoadErrors", 0x2E3F50, "33d2488d0db7b40b05448d4201e94e1e");
            if (ctor == IntPtr.Zero || dtor == IntPtr.Zero || load == IntPtr.Zero || clear == IntPtr.Zero) return false;
            if (PackageFileCache() == IntPtr.Zero) return false;
            _reattachCtor = (ReattachCtorFn)Marshal.GetDelegateForFunctionPointer(ctor, typeof(ReattachCtorFn));
            _reattachDtor = (ReattachDtorFn)Marshal.GetDelegateForFunctionPointer(dtor, typeof(ReattachDtorFn));
            _clearLoadErrors =
                (ClearLoadErrorsFn)Marshal.GetDelegateForFunctionPointer(clear, typeof(ClearLoadErrorsFn));
            _loadPackage = (LoadPackageFn)Marshal.GetDelegateForFunctionPointer(load, typeof(LoadPackageFn));
            return true;
        }

        private static bool _reportedBadCache;

        // GPackageFileCache, once its FindPackageFile slot is seen to point into the editor's code. Zero otherwise.
        // Read by name from XComGame's globals, not by address.
        private static IntPtr PackageFileCache() {
            IntPtr cache = EngineThunks.Global("GPackageFileCache");
            if (cache == IntPtr.Zero) return IntPtr.Zero;
            IntPtr exe    = GetModuleHandleW(null);
            IntPtr vtable = Marshal.ReadIntPtr(cache);
            if (InExe(exe, vtable) && InExe(exe, Marshal.ReadIntPtr(vtable, FindPackageFileSlot))) return cache;
            if (!_reportedBadCache)
                EngineThunks.Trace("GPackageFileCache doesn't point into the editor's code; not calling it.");
            _reportedBadCache = true;
            return IntPtr.Zero;
        }

        // Adds a file to the package file cache, as the editor's open does. False if the cache didn't take it.
        internal static bool RegisterPackageFile(string file) {
            Genie.PackageUtils.ForgetListed(); // the list it keeps lacks this file
            return FindPackageFile(file) != null;
        }

        // The file the cache lists for a package name, as GetPackageLinker looks it up, or null; stock entries are
        // relative to the exe's folder. Given a full path it also adds that file (RegisterPackageFile). Given a name
        // whose file is gone it deletes the entry (FileCacheProbe v2), so names go through PackageUtils.GetPackageFile,
        // which reads the list instead.
        internal static string FindPackageFile(string nameOrFile) {
            IntPtr cache = PackageFileCache();
            if (cache == IntPtr.Zero) return null;
            FindPackageFileFn find = (FindPackageFileFn)Marshal.GetDelegateForFunctionPointer(
                Marshal.ReadIntPtr(Marshal.ReadIntPtr(cache), FindPackageFileSlot), typeof(FindPackageFileFn));
            IntPtr name = Marshal.StringToHGlobalUni(nameOrFile), found = EngineThunks.NewFString();
            try {
                bool   ok   = find(cache, name, IntPtr.Zero, found, IntPtr.Zero) != 0;
                string file = EngineThunks.TakeFString(found);
                return ok ? (file ?? "") : null;
            } catch (Exception ex) {
                EngineThunks.Trace("FindPackageFile " + nameOrFile + " failed: " + ex.Message);
                return null;
            } finally {
                Marshal.FreeHGlobal(name);
                Marshal.FreeHGlobal(found);
            }
        }

        // Every file the package file cache lists, missing ones included; stock entries are relative to the exe's
        // folder. Empty if the cache can't be called.
        internal static List<string> GetPackageFileList() {
            List<string> files = new List<string>();
            IntPtr       cache = PackageFileCache();
            if (cache == IntPtr.Zero) return files;
            IntPtr slot = Marshal.ReadIntPtr(Marshal.ReadIntPtr(cache), FileListSlot);
            if (!InExe(GetModuleHandleW(null), slot)) return files;
            MethodInfo dtor = EngineThunks.Find("TArray<FString,FDefaultAllocator>.{dtor}");
            if (dtor == null) return files; // without it the engine's strings would leak
            GetPackageFileListFn list =
                (GetPackageFileListFn)Marshal.GetDelegateForFunctionPointer(slot, typeof(GetPackageFileListFn));
            IntPtr arr = EngineThunks.NewEmptyArray();
            try {
                list(cache, arr);
                IntPtr data = Marshal.ReadIntPtr(arr, 0);
                int    n    = Marshal.ReadInt32(arr, 8);
                for (int i = 0; i < n && data != IntPtr.Zero && i < EngineThunks.MaxTable; i++) {
                    string file = EngineThunks.ReadFString(EngineThunks.Offset(data, i * 16));
                    if (!string.IsNullOrEmpty(file)) files.Add(file);
                }
            } catch (Exception ex) {
                EngineThunks.Trace("GetPackageFileList failed: " + ex.Message);
            } finally {
                // The engine allocated the strings and their array: its destructor frees both.
                if (Marshal.ReadIntPtr(arr, 0) != IntPtr.Zero) {
                    try {
                        dtor.Invoke(null,
                                    new object[] { EngineThunks.Box(arr, dtor.GetParameters()[0].ParameterType) });
                    } catch (Exception ex) {
                        EngineThunks.Trace("TArray<FString> dtor failed: " + ex.Message);
                    }
                }
                Marshal.FreeHGlobal(arr);
            }
            return files;
        }

        // Detaches every component until EndReattach; one pair around a whole batch. Call CanLoadPackageFiles first.
        internal static IntPtr BeginReattach() {
            IntPtr context = Marshal.AllocHGlobal(ReattachStorage);
            for (int i = 0; i < ReattachStorage; i += 8) Marshal.WriteInt64(context, i, 0);
            _reattachCtor(context);
            return context;
        }

        internal static void EndReattach(IntPtr context) {
            try {
                _reattachDtor(context);
            } finally {
                Marshal.FreeHGlobal(context);
            }
        }

        // Loads a package from its file; errors gets what this load raised. GEdLoadErrors skips an entry equal to one
        // already listed, so it's cleared first, or a file would miss errors an earlier file raised too (probe 7).
        internal static IntPtr LoadPackageFile(string file, List<LoadError> errors) {
            IntPtr name = Marshal.StringToHGlobalUni(file);
            try {
                _clearLoadErrors();
                IntPtr package = _loadPackage(IntPtr.Zero, name, 0);
                ReadLoadErrors(errors);
                return package;
            } finally {
                Marshal.FreeHGlobal(name);
            }
        }

        private static void ReadLoadErrors(List<LoadError> errors) {
            IntPtr exe  = GetModuleHandleW(null);
            IntPtr data = Marshal.ReadIntPtr(EngineThunks.Offset(exe, GEdLoadErrorsDataRva));
            int    num  = Marshal.ReadInt32(EngineThunks.Offset(exe, GEdLoadErrorsNumRva));
            if (data == IntPtr.Zero || num <= 0 || num > EngineThunks.MaxTable) return;
            for (int i = 0; i < num; i++) {
                IntPtr entry = EngineThunks.Offset(data, i * LoadErrorSize);
                errors.Add(new LoadError {
                    Type = Marshal.ReadInt32(entry),
                    Text = EngineThunks.ReadFString(EngineThunks.Offset(entry, 4)),
                });
            }
        }

        // UExporter::ExportToFileEx(FExportToFileParams&), Core\Src\UExporter.cpp. The params, as it reads them:
        //   +0x00 Object             +0x08 Exporter (null: chosen by the file's extension)
        //   +0x10 Filename           +0x18 InSelectedOnly       +0x1C NoReplaceIdentical
        //   +0x20 Prompt             +0x24 bUseFileArchive      +0x28 IgnoreObjectList (TArray)
        //   +0x38 WriteEmptyFiles
        // Returns 1 when written.
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        internal delegate int ExportToFileExFn(IntPtr exportParams);

        internal const int ExportParamsSize = 0x40;

        private static ExportToFileExFn _exportToFileEx;

        internal static ExportToFileExFn ExportToFileEx() {
            if (_exportToFileEx != null) return _exportToFileEx;
            IntPtr fn = Resolve("UExporter::ExportToFileEx", 0x1B1530,
                                "488bc4554154415541564157488da808ffffff4881ecd001000048c745b0feffffff4889581048897018" +
                                    "48897820488b05abb71a054833c4488985c00000004c",
                                0x3753298, "No %s exporter found for %s");
            if (fn == IntPtr.Zero) return null;
            _exportToFileEx = (ExportToFileExFn)Marshal.GetDelegateForFunctionPointer(fn, typeof(ExportToFileExFn));
            return _exportToFileEx;
