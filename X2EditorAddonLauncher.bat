@echo off
setlocal enableextensions disabledelayedexpansion
REM ===================================================================
REM  X2EditorAddonLauncher: launches the XCOM 2 War of the Chosen SDK's
REM  Unreal Editor with AddonGenie, an addon framework.
REM
REM  Put this file in ...\Binaries\Win64 and double-click it.
REM  It shows AddonGenie's splash where the SDK's own will appear, compiles
REM  the C# source at the bottom of this file into X2EditorAddonFramework.dll
REM  (again whenever this file changes), makes the Addons\ folder, has the
REM  .NET runtime load the DLL into the editor at startup (as its
REM  AppDomainManager), and launches the editor. Addons go in Addons\ as .cs
REM  files; subfolders aren't read, so archives or set-aside addons can go
REM  in one. Nothing in the SDK is modified.
REM    Addons\Config\   settings, one .ini per addon
REM    Addons\Logs\     addons.log
REM    Addons\Data\     each addon's own files, in a folder named after it
REM  Without full PowerShell, this window does the same, plainer.
REM  Icon: "Genie" by Magnific, from Flaticon
REM  (https://www.flaticon.com/free-icon/genie_3821133)
REM ===================================================================

title X2 Editor Addon Launcher
set "HERE=%~dp0"
set "LAUNCH_SELF=%~f0"

if not exist "%HERE%XComGame.exe" ( echo XComGame.exe isn't in this folder. Put this file in SDK\Binaries\Win64. & pause & exit /b 1 )
if not exist "%HERE%Addons\Config" mkdir "%HERE%Addons\Config"
if /i "%~1"=="/plain" goto plain

REM The splash: the PowerShell part below compiles and runs the C# launcher after it, which builds, waits for an
REM update and launches. Run from here, it only starts a windowless copy of itself and returns 7, so this window
REM closes at once; without full PowerShell (constrained language mode can't compile C#) it fails, and plain mode
REM runs. The launcher comes back with /plain if it can't start the editor.
set "LAUNCH_PS=$t = [IO.File]::ReadAllText($env:LAUNCH_SELF); $i = $t.IndexOf('#PS' + 'BEGIN'); $j = $t.IndexOf('#LAUNCHER' + 'CS', $i); Invoke-Expression $t.Substring($i, $j - $i)"
powershell -NoProfile -ExecutionPolicy Bypass -Command "%LAUNCH_PS%"
if errorlevel 8 goto plain
if not errorlevel 7 goto plain
endlocal
exit /b 0

REM == Plain mode ======================================================
REM This window does it all: build, refuse an update an open editor holds, launch.
:plain
set "FW=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319"
set "CSC=%FW%\csc.exe"
set "SRC=%TEMP%\X2EditorAddonFramework.cs"
set "DLL=%HERE%X2EditorAddonFramework.dll"
set "STAMPFILE=%HERE%X2EditorAddonFramework.stamp"

REM Pull the framework source out of this file (everything after the marker line).
set "MARK="
for /f "delims=:" %%N in ('findstr /n /b /c:"::CSHARP::" "%~f0"') do if not defined MARK set "MARK=%%N"
if not defined MARK ( echo This file is damaged: its framework source is missing. & pause & exit /b 1 )

REM Rebuild when the DLL is missing, or this file has changed (size and modified time). The splash keeps its
REM own stamp format: switching between the two modes rebuilds once.
for %%F in ("%~f0") do set "STAMP=%%~zF %%~tF"
set "OLDSTAMP="
if exist "%STAMPFILE%" set /p OLDSTAMP=<"%STAMPFILE%"
set "BUILD="
if not exist "%DLL%" set "BUILD=1"
if not "%STAMP%"=="%OLDSTAMP%" set "BUILD=1"

REM A running editor keeps the DLL loaded (locked). Never fight it: with an update waiting, launch
REM nothing, so no editor runs the old framework; the stamp stays old until a launch can build.
REM With no update, launch alongside it as usual. The lock test's own error is hidden: the screen
REM below says what it means.
set "INUSE="
if defined BUILD if exist "%DLL%" ( ( (call ) >>"%DLL%" ) 2>nul || set "INUSE=1" )
if defined INUSE goto plaininuse

if defined BUILD (
  if not exist "%CSC%" ( echo The C# compiler that ships with .NET Framework 4 wasn't found: "%CSC%" & pause & exit /b 1 )
  more +%MARK% "%~f0" > "%SRC%"
  "%CSC%" /nologo /target:library /unsafe /out:"%DLL%" /lib:"%FW%","%FW%\WPF" /r:PresentationFramework.dll /r:PresentationCore.dll /r:WindowsBase.dll /r:System.Xaml.dll /r:System.dll /r:System.IO.Compression.dll "%SRC%"
  if errorlevel 1 ( echo Building the addon framework failed. Close the editor if it is running. If this folder is read-only, run this file as administrator once. & pause & exit /b 1 )
  >"%STAMPFILE%" echo %STAMP%
  echo Built the addon framework.
)
goto plainlaunch

:plaininuse
echo X2 Editor Addon Launcher
echo.
echo The editor wasn't started. The addon framework has an update, but an open
echo editor is still using it, so it can't be replaced yet.
echo.
echo To update and start the editor, close every open Unreal Editor, then run
echo this launcher again.
echo.
pause
endlocal
exit /b 1

:plainlaunch
set "APPDOMAIN_MANAGER_ASM=X2EditorAddonFramework"
set "APPDOMAIN_MANAGER_TYPE=AddonGenie.GenieBootstrap"
echo Starting the editor. Addons load from: "%HERE%Addons"
start "" /d "%HERE%" "%HERE%XComGame.exe" editor -noscriptcompile -nogadwarning
endlocal
exit /b 0

#PSBEGIN
# Run twice. From the batch's console it starts a copy with no window at all and returns 7. CREATE_NO_WINDOW gives
# that copy a console that's never shown, not even as a Windows Terminal tab; -WindowStyle Hidden still flashes one.
if (-not $env:LAUNCH_HIDDEN) {
    if ($ExecutionContext.SessionState.LanguageMode -ne 'FullLanguage') { exit 1 }   # can't compile C#: plain mode
    $copy = New-Object Diagnostics.ProcessStartInfo 'powershell.exe', ('-NoProfile -ExecutionPolicy Bypass -Command "' + $env:LAUNCH_PS + '"')
    $copy.UseShellExecute = $false
    $copy.CreateNoWindow  = $true
    $copy.EnvironmentVariables['LAUNCH_HIDDEN'] = '1'
    [void][Diagnostics.Process]::Start($copy)
    exit 7
}

# Compiles the C# launcher below into %TEMP% (once per version of it, named by its hash), loads it and runs it.
# It returns 3 when it couldn't start the editor: the batch then does it all in a window of its own (/plain).
$code = 3
try {
    $from   = $t.IndexOf("`n", $t.IndexOf('#LAUNCHER' + 'CS')) + 1
    $source = $t.Substring($from, $t.IndexOf("`n::CS" + 'HARP::', $from) - $from)
    $sha    = [Security.Cryptography.SHA1]::Create()
    $hash   = -join ($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($source))[0..7] | ForEach-Object { $_.ToString('x2') })
    $dll    = Join-Path $env:TEMP ('X2EditorAddonLauncher-' + $hash + '.dll')
    try {
        if (-not (Test-Path $dll)) {
            Add-Type -TypeDefinition $source -ReferencedAssemblies System.Windows.Forms, System.Drawing -OutputAssembly $dll -OutputType Library -ErrorAction Stop
        }
        Add-Type -Path $dll -ErrorAction Stop
    } catch {
        Remove-Item $dll -ErrorAction SilentlyContinue   # a bad build mustn't stick: the next run compiles again
        throw
    }
    $code = [AddonGenie.Launcher.LauncherApp]::Run($env:LAUNCH_SELF)
} catch { }
if ($code -eq 3) { Start-Process -FilePath $env:LAUNCH_SELF -ArgumentList '/plain' }
exit $code

#LAUNCHERCS
// AddonGenie launcher: our splash, the framework build, the editor launch and the token on the SDK's splash.
// Spec: claude/Launcher-spec.md. The PowerShell part above compiles this (cached in %TEMP% by content) and calls
// LauncherApp.Run. C# 5: Add-Type compiles with .NET Framework 4's compiler.
//
// WinForms, not WPF: windows made on a DPI-unaware thread share XComGame.exe's coordinates and scaling exactly
// (it's DPI-unaware too), so our splash and token line up with its splash on any display.
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using System.Windows.Forms;

namespace AddonGenie.Launcher {
    // == Entry =======================================================================================================

    public static class LauncherApp {
        /// <summary>Runs the launcher to the end. 3: it broke before launching; the batch takes over.</summary>
        public static int Run(string launcherPath) {
            int    code = 3;
            Thread ui   = new Thread(() => code = RunSession(launcherPath));
            ui.SetApartmentState(ApartmentState.STA); // WinForms and the clipboard
            ui.Start();
            ui.Join();
            return code;
        }

        private static int RunSession(string launcherPath) {
            Session session = null;
            try {
                Win32.UseHostDpiMode();
                // An error ends the run instead of showing WinForms' dialog; before a launch, the batch takes over.
                Application.SetUnhandledExceptionMode(UnhandledExceptionMode.ThrowException);
                Application.EnableVisualStyles();
                session = new Session(launcherPath);
                session.Start();
                Application.Run();
                return 0; // ended on purpose: launched, cancelled, or a failure the splash showed
            } catch (Exception) {
                return (session != null && session.HasLaunched) ? 0 : 3; // never start a second editor
            }
        }
    }

    // == Session =====================================================================================================
    // One launch, start to end: build or wait for an update, launch, follow the editor's windows.

    internal sealed class Session {
        private enum Phase { Building, Waiting, Failed, Launching, ClosedEarly }

        private const int SlowTipAfterSeconds = 10; // on the "Waiting for the SDK splash" clock
        private const int ClosedEarlySeconds  = 4;

        private readonly Paths      _paths;
        private readonly Settings   _settings;
        private readonly SplashForm _splash;
        private readonly IconArt    _icon;
        private readonly System.Windows.Forms.Timer _tick       = new System.Windows.Forms.Timer();
        private readonly Stopwatch                  _phaseClock = new Stopwatch();

        private Phase      _phase;
        private Process    _editor;
        private uint       _editorId;
        private DateTime   _launchedUtc;
        private WindowHook _showHook;
        private TokenForm  _token;
        private IntPtr     _nativeSplash;
        private bool       _isQuitting, _isSplashClosed;

        internal bool HasLaunched { get; private set; }

        internal Session(string launcherPath) {
            _paths          = new Paths(launcherPath);
            _settings       = Settings.Load(_paths.SettingsFile);
            _icon           = IconArt.Load(_paths);
            _splash         = new SplashForm(NativeSplash.ExpectedBounds(_paths.SdkDir), _icon, Footer());
            _tick.Interval  = 500;
            _tick.Tick     += delegate {
                OnTick();
            };
        }

        internal void Start() {
            _splash.FormClosed += delegate {
                _isSplashClosed = true;
                Quit(); // closed by the user: stop; a started editor carries on
            };
            _splash.Show();
            _tick.Start();
            if (!FrameworkBuild.IsNeeded(_paths))
                Launch();
            else if (FrameworkBuild.IsLocked(_paths))
                Wait();
            else
                Build();
        }

        // == Build ===================================================================================================

        private void Wait() {
            Enter(Phase.Waiting);
            _splash.ShowView("An update is ready, but an open editor is using the framework. Close every open Unreal " +
                                 "Editor and this carries on by itself.",
                             false, null, null, new SplashAction("Cancel", Quit));
            _splash.SetBar(SplashForm.Bar.Busy);
        }

        private void Build() {
            Enter(Phase.Building);
            _splash.ShowView("Building the addon framework...", false, null, null);
            _splash.SetBar(SplashForm.Bar.Busy);
            ThreadPool.QueueUserWorkItem(delegate {
                BuildResult result = FrameworkBuild.Run(_paths);
                Post(delegate { OnBuilt(result); });
            });
        }

        private void OnBuilt(BuildResult result) {
            if (_isQuitting) return;
            if (result.IsSuccess) {
                Launch();
                return;
            }
            Enter(Phase.Failed);
            _splash.ShowView("Building the addon framework failed.", true, result.FirstError,
                             "If this folder is read-only, run the launcher as administrator once.",
                             new SplashAction("Copy errors", delegate { CopyText(result.Output); }),
                             new SplashAction("Close", Quit));
            _splash.SetBar(SplashForm.Bar.None);
            _splash.SetStatus("Failed at " + Clock(_phaseClock.Elapsed));
        }

        // == Launch ==================================================================================================

        private void Launch() {
            Enter(Phase.Launching);
            // Set before the tip can open, so the message doesn't rewrap under someone reading it.
            if (_settings.ShowSlowTip)
                _splash.SetRightMargin(TokenForm.TipWidth + TokenForm.OwnInset + SplashForm.ColumnGap);
            _splash.ShowView("Starting the editor", false, null, "XCOM 2 War of the Chosen SDK");
            _splash.SetBar(SplashForm.Bar.None);
            _launchedUtc = DateTime.UtcNow;
            _editor      = Editor.Start(_paths, true, delegate { Post(OnEditorExited); });
            _editorId    = (uint)_editor.Id;
            HasLaunched  = true;
            _showHook    = new WindowHook(_editorId, Win32.EVENT_OBJECT_SHOW, delegate { CheckEditor(); });
            CheckEditor(); // a window may have shown before the hook
            UpdateStatus();
        }

        // Called when any of the editor's windows shows, and on each tick: the frame's menu can arrive after it shows.
        private void CheckEditor() {
            if (_phase != Phase.Launching || _isQuitting) return;
            if (EditorWindows.FindMainFrame(_editorId) != IntPtr.Zero) {
                Finish();
                return;
            }
            if (_nativeSplash != IntPtr.Zero) return;
            IntPtr splash = EditorWindows.Find(_editorId, NativeSplash.WindowClass);
            if (splash != IntPtr.Zero) ShowToken(splash);
        }

        // A token already on our splash carries its open tip over: same window, same screen spot.
        private void ShowToken(IntPtr nativeSplash) {
            _nativeSplash = nativeSplash;
            if (_token != null)
                _token.MoveTo(nativeSplash, TokenForm.NativeInset);
            else
                CreateToken(nativeSplash, TokenForm.NativeInset, true).Show();
            _splash.Hide(); // the native splash now covers its spot; after the move, or the token would hide with it
            UpdateToken();
        }

        // Only while waiting for the native splash: once it's up, a tip that wasn't open stays closed.
        private void OpenSlowTip() {
            CreateToken(_splash.Handle, TokenForm.OwnInset, false).ShowTip(true);
            _token.Show();
            _splash.SetColumn(_token.Bounds);
        }

        private void CloseOwnTip() {
            CloseToken();
            _splash.SetColumn(Rectangle.Empty);
        }

        private TokenForm CreateToken(IntPtr splash, int inset, bool isBoxed) {
            _token = new TokenForm(splash, inset, isBoxed, _icon, ShortPath(_paths.ScriptSourceDir),
                                   ShortPath(_paths.ShadersDir));
            _token.CopyPaths += delegate {
                CopyText(_paths.ScriptSourceDir + "\r\n" + _paths.ShadersDir);
            };
            _token.DismissTip += delegate {
                _settings.ShowSlowTip = false;
                _settings.Save();
                if (_nativeSplash == IntPtr.Zero)
                    Post(CloseOwnTip); // deferred: this runs in the token's own button click
                else
                    _token.ShowTip(false);
            };
            UpdateToken();
            return _token;
        }

        private void UpdateToken() {
            if (_token != null) _token.SetTime(Clock(_phaseClock.Elapsed));
        }

        private void CloseToken() {
            if (_token == null) return;
            TokenForm token = _token;
            _token          = null;
            token.Dispose();
        }

        private void Finish() {
            Quit();
        }

        // Killed or crashed before its window: a kill and a crash look the same, so no exit code. The one we can act
        // on is the framework never loading, which leaves addons.log untouched.
        private void OnEditorExited() {
            if (_phase != Phase.Launching || _isQuitting) return;
            CloseToken();
            _splash.SetColumn(Rectangle.Empty);
            _splash.SetRightMargin(0);
            Enter(Phase.ClosedEarly);
            bool hasFrameworkStarted =
                File.Exists(_paths.AddonsLog) && File.GetLastWriteTimeUtc(_paths.AddonsLog) >= _launchedUtc;
            SplashAction[] actions = hasFrameworkStarted
                                         ? new SplashAction[0]
                                         : new[] { new SplashAction("Start without addons", StartWithoutAddons) };
            _splash.ShowView("The editor closed before its window appeared.", false, null, null, actions);
            _splash.SetBar(SplashForm.Bar.Countdown, TimeSpan.FromSeconds(ClosedEarlySeconds));
            _splash.Show();
            UpdateStatus();
        }

        private void StartWithoutAddons() {
            Editor.Start(_paths, false, null);
            Quit();
        }

        // == Clock ===================================================================================================

        private void OnTick() {
            switch (_phase) {
                case Phase.Waiting:
                    if (!FrameworkBuild.IsLocked(_paths)) {
                        Build();
                        return;
                    }
                    break;
                case Phase.Launching:
                    CheckEditor();
                    if (_isQuitting) return;
                    if (_nativeSplash == IntPtr.Zero && _token == null && _settings.ShowSlowTip &&
                        _phaseClock.Elapsed.TotalSeconds >= SlowTipAfterSeconds)
                        OpenSlowTip();
                    // Belt and braces: a cross-process child goes with its parent, but our form must be disposed.
                    if (_token != null && _nativeSplash != IntPtr.Zero && !Win32.IsWindow(_nativeSplash))
                        CloseToken();
                    UpdateToken();
                    break;
                case Phase.ClosedEarly:
                    if (_phaseClock.Elapsed.TotalSeconds >= ClosedEarlySeconds) {
                        Quit();
                        return;
                    }
                    break;
            }
            UpdateStatus();
        }

        private void UpdateStatus() {
            string time = Clock(_phaseClock.Elapsed);
            switch (_phase) {
                case Phase.Building:
                    _splash.SetStatus("Building... " + time);
                    break;
                case Phase.Waiting:
                    _splash.SetStatus("Waiting for open editors to close... " + time);
                    break;
                case Phase.Launching:
                    _splash.SetStatus("Waiting for the SDK splash... " + time);
                    break;
                case Phase.ClosedEarly:
                    int left = (int)Math.Ceiling(ClosedEarlySeconds - _phaseClock.Elapsed.TotalSeconds);
                    _splash.SetStatus("Closing in " + Math.Max(left, 1) + " s");
                    break;
            }
        }

        // == Plumbing ================================================================================================

        private void Enter(Phase phase) {
            _phase = phase;
            _phaseClock.Restart();
        }

        private void Quit() {
            if (_isQuitting) return;
            _isQuitting = true;
            _tick.Stop();
            if (_showHook != null) _showHook.Dispose();
            CloseToken();
            if (!_isSplashClosed) _splash.Close();
            Application.ExitThread();
        }

        // From a worker thread to the UI thread. Dropped once the splash is gone: the session is over.
        private void Post(MethodInvoker action) {
            try {
                if (!_splash.IsDisposed) _splash.BeginInvoke(action);
            } catch (InvalidOperationException) {}
        }

        private static void CopyText(string text) {
            try {
                Clipboard.SetText(text);
            } catch (ExternalException) { // another app has the clipboard open
            }
        }

        private string Footer() {
            string version = _paths.FrameworkConstant("Version");
            string author  = _paths.FrameworkConstant("Author");
            int    count = Directory.Exists(_paths.AddonsDir) ? Directory.GetFiles(_paths.AddonsDir, "*.cs").Length : 0;
            string text  = count + (count == 1 ? " addon" : " addons");
            if (author != null) text = "by " + author + " \u00b7 " + text;
            if (version != null) text = "v" + version + " " + text;
            return text;
        }

        // From the SDK's own folder on: ...\XCOM 2 War of the Chosen SDK\Development\Src
        private string ShortPath(string path) {
            string sdk = _paths.SdkDir.TrimEnd('\\');
            if (!path.StartsWith(sdk, StringComparison.OrdinalIgnoreCase)) return path;
            return "...\\" + Path.GetFileName(sdk) + path.Substring(sdk.Length);
        }

        private static string Clock(TimeSpan t) {
            return string.Format("{0}:{1:00}", (int)t.TotalMinutes, t.Seconds);
        }
    }

    // == Paths and Settings ==========================================================================================

    internal sealed class Paths {
        internal readonly string Launcher, BinDir, SdkDir, Editor, Dll, StampFile, Csc, FrameworkDir;
        internal readonly string AddonsDir, AddonsLog, SettingsFile, ScriptSourceDir, ShadersDir;
        private string           _launcherText;

        internal Paths(string launcher) {
            Launcher        = Path.GetFullPath(launcher);
            BinDir          = Path.GetDirectoryName(Launcher);
            SdkDir          = Path.GetFullPath(Path.Combine(BinDir, @"..\.."));
            Editor          = Path.Combine(BinDir, "XComGame.exe");
            Dll             = Path.Combine(BinDir, "X2EditorAddonFramework.dll");
            StampFile       = Path.Combine(BinDir, "X2EditorAddonFramework.stamp");
            FrameworkDir    = Path.Combine(Environment.GetEnvironmentVariable("WINDIR") ?? @"C:\Windows",
                                           @"Microsoft.NET\Framework64\v4.0.30319");
            Csc             = Path.Combine(FrameworkDir, "csc.exe");
            AddonsDir       = Path.Combine(BinDir, "Addons");
            AddonsLog       = Path.Combine(AddonsDir, @"Logs\addons.log");
            SettingsFile    = Path.Combine(AddonsDir, @"Config\Launcher.ini");
            ScriptSourceDir = Path.Combine(SdkDir, @"Development\Src");
            ShadersDir      = Path.Combine(SdkDir, @"Engine\Shaders");
        }

        internal string LauncherText {
            get { return _launcherText ?? (_launcherText = File.ReadAllText(Launcher)); }
        }

        /// <summary>The framework's source: everything after its marker line.</summary>
        internal string FrameworkSource {
            get {
                // The marker is split so this file holds it once: the PowerShell part ends this source there.
                Match m = Regex.Match(LauncherText, "^::CS" + @"HARP::\r?\n", RegexOptions.Multiline);
                return m.Success ? LauncherText.Substring(m.Index + m.Length) : null;
            }
        }

        /// <summary>A const string from the framework's source, as Version or Author; null if missing.</summary>
        internal string FrameworkConstant(string name) {
            Match m = Regex.Match(LauncherText, @"const string " + name + @"\s*=\s*""([^""]+)""");
            return m.Success ? m.Groups[1].Value : null;
        }
    }

    // Addons\Config\Launcher.ini. Not AddonGenie.ini: the framework writes that while the editor starts.
    internal sealed class Settings {
        internal bool  ShowSlowTip = true;
        private string _file;

        internal static Settings Load(string file) {
            Settings s = new Settings { _file = file };
            if (!File.Exists(file)) return s;
            try {
                foreach (string line in File.ReadAllLines(file)) {
                    int eq = line.IndexOf('=');
                    if (eq < 0) continue;
                    string key = line.Substring(0, eq).Trim(), value = line.Substring(eq + 1).Trim();
                    bool   b;
                    if (key == "ShowSlowTip" && bool.TryParse(value, out b)) s.ShowSlowTip = b;
                }
            } catch (IOException) {}
            return s;
        }

        internal void Save() {
            try {
                Directory.CreateDirectory(Path.GetDirectoryName(_file));
                File.WriteAllText(_file, "[Launcher]\r\nShowSlowTip=" + (ShowSlowTip ? "true" : "false") + "\r\n");
            } catch (IOException) {
            } catch (UnauthorizedAccessException) {}
        }
    }

    // == Framework Build =============================================================================================

    internal sealed class BuildResult {
        internal bool   IsSuccess;
        internal string Output;     // all of csc's output, for Copy errors
        internal string FirstError; // one line for the splash
    }

    internal static class FrameworkBuild {
        // The batch's plain mode builds too, with its own stamp format: a switch between the two rebuilds once.
        private static string Stamp(Paths paths) {
            FileInfo info = new FileInfo(paths.Launcher);
            return "launcher " + info.Length + " " + info.LastWriteTimeUtc.Ticks;
        }

        /// <summary>The DLL is missing, or this file changed since it was built.</summary>
        internal static bool IsNeeded(Paths paths) {
            if (!File.Exists(paths.Dll) || !File.Exists(paths.StampFile)) return true;
            return File.ReadAllText(paths.StampFile).Trim() != Stamp(paths);
        }

        /// <summary>A running editor has the DLL loaded, so it can't be replaced.</summary>
        internal static bool IsLocked(Paths paths) {
            if (!File.Exists(paths.Dll)) return false;
            try {
                using (new FileStream(paths.Dll, FileMode.Open, FileAccess.ReadWrite, FileShare.None)) {}
                return false;
            } catch (IOException) {
                return true;
            } catch (UnauthorizedAccessException) {
                return false; // read-only: the build fails and says so
            }
        }

        /// <summary>Builds the DLL with .NET Framework 4's csc. Never throws.</summary>
        internal static BuildResult Run(Paths paths) {
            try {
                if (!File.Exists(paths.Csc))
                    return Failure("The C# compiler that ships with .NET Framework 4 wasn't found: " + paths.Csc);
                string source = paths.FrameworkSource;
                if (source == null) return Failure("This launcher is damaged: its framework source is missing.");

                string sourceFile = Path.Combine(Path.GetTempPath(), "X2EditorAddonFramework.cs");
                File.WriteAllText(sourceFile, source, new UTF8Encoding(true)); // the BOM: csc reads it as UTF-8

                string args = "/nologo /target:library /unsafe /out:" + Quote(paths.Dll) +
                              " /lib:" + Quote(paths.FrameworkDir) + "," +
                              Quote(Path.Combine(paths.FrameworkDir, "WPF")) +
                              " /r:PresentationFramework.dll /r:PresentationCore.dll /r:WindowsBase.dll" +
                              " /r:System.Xaml.dll /r:System.dll /r:System.IO.Compression.dll";
                args += " " + Quote(sourceFile);

                ProcessStartInfo psi = new ProcessStartInfo(paths.Csc, args) {
                    UseShellExecute        = false,
                    CreateNoWindow         = true,
                    RedirectStandardOutput = true,
                };
                string output;
                int    exitCode;
                using (Process csc = Process.Start(psi)) {
                    output = csc.StandardOutput.ReadToEnd(); // csc writes its errors here
                    csc.WaitForExit();
                    exitCode = csc.ExitCode;
                }
                if (exitCode != 0)
                    return Failure(output.Trim().Length > 0 ? output : "csc exited with code " + exitCode);

                File.WriteAllText(paths.StampFile, Stamp(paths));
                return new BuildResult { IsSuccess = true, Output = output };
            } catch (Exception ex) {
                return Failure(ex.Message);
            }
        }

        private static BuildResult Failure(string output) {
            string first = null;
            foreach (string line in output.Split('\n')) {
                string trimmed = line.Trim();
                if (trimmed.Length == 0) continue;
                if (first == null) first = trimmed;
                if (trimmed.Contains("error CS")) {
                    first = trimmed;
                    break;
                }
            }
            return new BuildResult { Output = output, FirstError = first };
        }

        private static string Quote(string path) {
            return "\"" + path + "\"";
        }
    }

