            private const string ImportArrow  = OpenBox + " M 7,1.5 L 7,9 M 4.2,6.2 L 7,9 L 9.8,6.2";
            private const string ExportArrow  = OpenBox + " M 7,9.5 L 7,2 M 4.2,4.8 L 7,2 L 9.8,4.8";
            private const string BrowseFolder = "M 1.8,3.2 L 5.3,3.2 L 6.6,4.6 L 12.2,4.6 L 12.2,11 L 1.8,11 Z";
            private const string OpenWindow = "M 3,2.5 L 11,2.5 A 1,1 0 0 1 12,3.5 L 12,10.5 A 1,1 0 0 1 11,11.5 " +
                                              "L 3,11.5 A 1,1 0 0 1 2,10.5 L 2,3.5 A 1,1 0 0 1 3,2.5 Z " +
