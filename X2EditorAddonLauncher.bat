                    VerticalAlignment  = VerticalAlignment.Center,
                };
            }

            /// <summary>An arrow, drawn (no font dependency).</summary>
            public static FrameworkElement CreateArrowIcon(ArrowDirection direction, Brush color = null,
                                                           double? size = null) {
                double                     s     = size ?? 14;
                System.Windows.Shapes.Path arrow = new System.Windows.Shapes.Path {
                    Data                = Geometry.Parse("M 2,7 L 12,7 M 8.5,3.5 L 12,7 L 8.5,10.5"),
                    Stroke              = color ?? Theme.TextSecondary,
                    StrokeThickness     = 1.6,
                    StrokeStartLineCap  = PenLineCap.Round,
                    StrokeEndLineCap    = PenLineCap.Round,
                    StrokeLineJoin      = PenLineJoin.Round,
                    Width               = 14,
                    Height              = 14,
                    Stretch             = Stretch.None,
                    VerticalAlignment   = VerticalAlignment.Center,
                    HorizontalAlignment = HorizontalAlignment.Center,
                };
                // Drawn pointing right, centred in its 14 box, then turned and scaled as a whole.
                TransformGroup turn = new TransformGroup();

                double angle = direction == ArrowDirection.Down   ? 90
                               : direction == ArrowDirection.Left ? 180
                               : direction == ArrowDirection.Up   ? 270
                                                                  : 0;
                turn.Children.Add(new RotateTransform(angle));
                turn.Children.Add(new ScaleTransform(s / 14, s / 14));
                arrow.LayoutTransform = turn;
                return arrow;
            }

