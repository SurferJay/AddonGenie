    /// <summary>
    /// Made by Genie.ControlUtils.CreateEmptyState. Title, Body, Content and Hint can change later; AddPoint adds
    /// lines between them.
    /// </summary>
    public sealed class GenieEmptyState : StackPanel {
        // Icons sit in this column, centred on their line's first row of text; all text starts after it.
        private const double IconColumn = 20;
        private const double LineHeight = 18;

        private readonly TextBlock      _title, _body, _hint;
        private readonly ContentControl _content;
        private readonly Grid           _bodyLine, _contentLine, _hintLine;
        private readonly StackPanel     _points = new StackPanel();

        internal GenieEmptyState(string title, string body, string hint) {
            VerticalAlignment = VerticalAlignment.Top; // no margin: the pane's inset places it

            _title = Text(Genie.Theme.TextPrimary, Genie.Theme.FontSizeValue);
            _title.FontWeight = FontWeights.SemiBold;
            Children.Add(Line(Genie.ControlUtils.CreateInfoIcon(), _title, 0));
            _body     = Text(Genie.Theme.TextPrimary, Genie.Theme.FontSizeBody);
            _bodyLine = Line(null, _body, 4);
            Children.Add(_bodyLine);
            _content     = new ContentControl { Focusable = false };
            _contentLine = Line(null, _content, 6);
            _contentLine.Visibility = Visibility.Collapsed;
            Children.Add(_contentLine);
            Children.Add(_points);
            _hint     = Text(Genie.Theme.TextSecondary, Genie.Theme.FontSizeLabel);
            _hintLine = Line(null, _hint, 12);
            Children.Add(_hintLine);
            Title = title;
            Body  = body;
            Hint  = hint;
        }

        public string Title {
            get { return _title.Text; }
            set { _title.Text = value ?? ""; }
        }
        public string Body {
            get { return _body.Text; }
            set {
                _body.Text           = value ?? "";
                _bodyLine.Visibility = string.IsNullOrEmpty(value) ? Visibility.Collapsed : Visibility.Visible;
            }
        }
        /// <summary>Your own element under the body (steps, say), lined up with the text.</summary>
        public UIElement Content {
            get { return _content.Content as UIElement; }
            set {
                _content.Content        = value;
                _contentLine.Visibility = value == null ? Visibility.Collapsed : Visibility.Visible;
            }
        }
        /// <summary>The muted last line; hidden when empty.</summary>
        public string Hint {
            get { return _hint.Text; }
            set {
                _hint.Text           = value ?? "";
                _hintLine.Visibility = string.IsNullOrEmpty(value) ? Visibility.Collapsed : Visibility.Visible;
            }
        }

        /// <summary>
        /// A point under the body, its icon in the title's column: Danger, Warning and Caution a triangle in their
        /// colour, the rest a muted i (and muted text). lead: bold words that start it ("Broken").
        /// </summary>
        public void AddPoint(Genie.ControlUtils.TagTone tone, string text, string lead = null) {
            bool warn = tone == Genie.ControlUtils.TagTone.Caution || tone == Genie.ControlUtils.TagTone.Warning;
            FrameworkElement icon;
            Brush            fill, edge, ink;
            Genie.ControlUtils.ToneBrushes(tone, out fill, out edge, out ink);
            if (tone == Genie.ControlUtils.TagTone.Danger)
                icon = Genie.ControlUtils.CreateWarningIcon();
            else if (warn)
                icon = Genie.ControlUtils.CreateWarningIcon(ink);
            else
                icon = Genie.ControlUtils.CreateInfoIcon(Genie.Theme.TextSecondary);
            bool      muted = tone != Genie.ControlUtils.TagTone.Danger && !warn;
            TextBlock line  = Text(muted ? Genie.Theme.TextSecondary : Genie.Theme.TextPrimary,
                                   Genie.Theme.FontSizeBody);
            if (!string.IsNullOrEmpty(lead))
                line.Inlines.Add(new System.Windows.Documents.Run(lead + " ") { FontWeight = FontWeights.SemiBold });
            line.Inlines.Add(new System.Windows.Documents.Run(text ?? ""));
            _points.Children.Add(Line(icon, line, _points.Children.Count == 0 ? 12 : 8));
        }

        /// <summary>Removes the points AddPoint added.</summary>
        public void ClearPoints() {
            _points.Children.Clear();
        }

        // icon | content, the icon centred on the first line. A null icon leaves its column empty.
        private static Grid Line(FrameworkElement icon, UIElement content, double top) {
            Grid line = new Grid { Margin = new Thickness(0, top, 0, 0) };
            line.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(IconColumn) });
            line.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            if (icon != null) {
                icon.HorizontalAlignment = HorizontalAlignment.Left;
                icon.VerticalAlignment   = VerticalAlignment.Center;
                line.Children.Add(new Border { Height = LineHeight, VerticalAlignment = VerticalAlignment.Top,
                                               Child = icon });
            }
            Grid.SetColumn(content, 1);
            line.Children.Add(content);
            return line;
        }

        private static TextBlock Text(Brush color, double size) {
            return new TextBlock {
                Foreground        = color,
                FontSize          = size,
                TextWrapping      = TextWrapping.Wrap,
                LineHeight        = LineHeight,
                VerticalAlignment = VerticalAlignment.Top,
            };
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateBanner. Text can change later.</summary>
    public sealed class GenieBanner : Border {
        private readonly TextBlock        _text;
        private readonly FrameworkElement _icon, _spinner;

        internal GenieBanner(Genie.ControlUtils.TagTone tone, string text) {
            Brush fill, edge, ink;
            Genie.ControlUtils.ToneBrushes(tone, out fill, out edge, out ink);
            bool warn = tone == Genie.ControlUtils.TagTone.Danger || tone == Genie.ControlUtils.TagTone.Warning ||
                        tone == Genie.ControlUtils.TagTone.Caution;
            _icon = warn ? Genie.ControlUtils.CreateWarningIcon(ink) : Genie.ControlUtils.CreateInfoIcon(ink, 13);
            _icon.Margin = new Thickness(0, 0, 6, 0);
