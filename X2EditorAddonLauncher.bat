        // FExec::Exec(const TCHAR* Cmd, FOutputDevice& Ar) on GEngine, the editor's command line. The editor's own
        // call (ObjectTools::RenameObjectsWithRefs running OBJ SAVEPACKAGE) shows where everything lives:
        //   mov rcx,[GEngine]; mov rbx,[rcx+0x60]; ...; mov rcx,[GEngine]; add rcx,0x60; mov r8,[GLog]; call [rbx]
        // so the engine's FExec part is at +0x60 and Exec is its first virtual. That call site is checked, then Exec
        // is called as it calls it: through the live vtable. Not pinned to UUnrealEdEngine's: GEngine can be a game's
        // own editor engine, whose Exec takes its commands and passes the rest on to UUnrealEdEngine::Exec.
        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
        internal delegate uint ExecFn(IntPtr exec, IntPtr command, IntPtr outputDevice);

        private const int GEngineRva  = 0x557DE78; // UEngine* GEngine
        private const int GLogRva     = 0x51ED7A8; // FOutputDevice* GLog
        private const int FExecOffset = 0x60;

        private static ExecFn _exec;
        private static IntPtr _execFn; // what _exec calls
        private static bool   _reportedBadExec;

        internal static bool CanExec() {
            IntPtr fexec, log;
            return ResolveExec(out fexec, out log) != null;
        }

        internal static bool Exec(string command) {
            IntPtr fexec, log;
            ExecFn exec = ResolveExec(out fexec, out log);
            if (exec == null) return false;
            IntPtr text = Marshal.StringToHGlobalUni(command);
            try {
                return exec(fexec, text, log) != 0;
            } catch (Exception ex) {
                EngineThunks.Trace("Exec \"" + command + "\" failed: " + ex.Message);
                return false;
            } finally {
                Marshal.FreeHGlobal(text);
            }
        }

        // The delegate, the engine's FExec and GLog, or null while any check fails (logged once each).
        private static ExecFn ResolveExec(out IntPtr fexec, out IntPtr log) {
            fexec = log = IntPtr.Zero;
            IntPtr site = Resolve("RenameObjectsWithRefs's Exec call", 0x1B59CD5,
                                  "488b0d9c41a203488b5960488bc8e808565bfe488bd0488b0d8641a203" +
                                      "4883c1604c8b05ab3a6903ff13",
                                  0x3FA4260, "OBJ SAVEPACKAGE PACKAGE=\"%s\" FILE=\"%s\"");
            if (site == IntPtr.Zero) return null;

            IntPtr exe    = GetModuleHandleW(null);
            IntPtr engine = Marshal.ReadIntPtr(EngineThunks.Offset(exe, GEngineRva));
            log           = Marshal.ReadIntPtr(EngineThunks.Offset(exe, GLogRva));
            if (engine == IntPtr.Zero || log == IntPtr.Zero) return null; // the editor isn't up yet
            fexec         = EngineThunks.Offset(engine, FExecOffset);
            IntPtr vtable = Marshal.ReadIntPtr(fexec);
            IntPtr fn     = InExe(exe, vtable) ? Marshal.ReadIntPtr(vtable) : IntPtr.Zero;
            if (!InExe(exe, fn)) {
                if (!_reportedBadExec)
                    EngineThunks.Trace("GEngine's FExec doesn't point into the editor's code; not calling it.");
                _reportedBadExec = true;
                return null;
            }
            if (fn != _execFn) {
                _exec   = (ExecFn)Marshal.GetDelegateForFunctionPointer(fn, typeof(ExecFn));
                _execFn = fn;
                EngineThunks.Trace("Exec goes to " + (Genie.ObjectUtils.GetClassPathName(engine) ?? "GEngine") +
                                   " (vtable +0x" + Rva(exe, vtable) + ", Exec +0x" + Rva(exe, fn) + ").");
            }
            return _exec;
        }

        // True if p lies in the exe's image; its size is SizeOfImage, at +0x50 in the PE header.
        private static bool InExe(IntPtr exe, IntPtr p) {
            long size = (uint)Marshal.ReadInt32(exe, Marshal.ReadInt32(exe, 0x3C) + 0x50);
            long rva  = p.ToInt64() - exe.ToInt64();
            return rva > 0 && rva < size;
        }

        private static string Rva(IntPtr exe, IntPtr p) {
            return (p.ToInt64() - exe.ToInt64()).ToString("X");
        }
    }

    // The editor's managed Content Browser through reflection: UnrealEdCSharp's WPF controls and the
    // MContentBrowserControl backend in XComGame.exe.
    internal static class BrowserReflection {
        private const BindingFlags Members = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance;

        private static object _mainControl;

        // PickMethod's answers, misses included: reading many browser items asks for the same few methods per item,
        // and searching a type's method list each time cost three times the read itself.
        private static readonly Dictionary<MethodKey, MethodInfo> _methods = new Dictionary<MethodKey, MethodInfo>();

        private struct MethodKey : IEquatable<MethodKey> {
            private readonly Type   _type;
            private readonly string _name;
            private readonly int    _paramCount;

            internal MethodKey(Type type, string name, int paramCount) {
                _type       = type;
                _name       = name;
                _paramCount = paramCount;
            }

            public bool Equals(MethodKey other) {
                return _type == other._type && _paramCount == other._paramCount && string.Equals(_name, other._name);
            }

            public override bool Equals(object obj) {
                return obj is MethodKey && Equals((MethodKey)obj);
            }

            public override int GetHashCode() {
                return (_type.GetHashCode() * 31 + _name.GetHashCode()) * 31 + _paramCount;
            }
        }

        internal static Type FindType(string fullName) {
            foreach (Assembly a in AppDomain.CurrentDomain.GetAssemblies()) {
                try {
                    Type t = a.GetType(fullName, false);
                    if (t != null) return t;
                } catch {}
            }
            return null;
        }

        // The live ContentBrowser.MainControl, or null. Cached once found.
        internal static object MainControl() {
            if (_mainControl != null) return _mainControl;
            Type t = FindType("ContentBrowser.MainControl");
            if (t != null) _mainControl = FindVisual(t);
            return _mainControl;
        }

        // The MContentBrowserControl backend behind the Content Browser, or null.
        internal static object Backend() {
            object main = MainControl();
            if (main == null) return null;
            try {
                PropertyInfo p = main.GetType().GetProperty("Backend", Members);
                if (p != null) return p.GetValue(main, null);
                MethodInfo m = main.GetType().GetMethod("get_Backend", Members);
                if (m != null) return m.Invoke(main, null);
            } catch {}
            return null;
        }

        // Calls a backend method that takes one TArray<T*>* argument, with these pointers.
        internal static bool CallBackendWithArray(string method, IntPtr[] items) {
            object backend = Backend();
            if (backend == null) return false;
            MethodInfo m = PickMethod(backend.GetType(), method, 1);
            if (m == null) {
                EngineThunks.Trace("Content Browser backend has no " + method);
                return false;
            }
            IntPtr data;
            IntPtr arr = EngineThunks.NewPointerArray(items, out data);
            try {
                m.Invoke(backend, new object[] { EngineThunks.Box(arr, m.GetParameters()[0].ParameterType) });
                return true;
            } catch (Exception ex) {
                EngineThunks.Trace(method + " failed: " + ex.Message);
                return false;
            } finally {
                Marshal.FreeHGlobal(data);
                Marshal.FreeHGlobal(arr);
            }
        }

        // Calls a no-argument method; null if it's missing or throws.
        internal static object Invoke0(object target, string name) {
            if (target == null) return null;
            try {
                MethodInfo m = PickMethod(target.GetType(), name, 0);
                return (m == null) ? null : m.Invoke(target, null);
            } catch {
                return null;
            }
        }

        // By name and parameter count: C++/CLI overloads differ in pointer types we can't name here.
        internal static MethodInfo PickMethod(Type t, string name, int paramCount) {
            MethodKey  key = new MethodKey(t, name, paramCount);
            MethodInfo found;
            lock (_methods) {
                if (_methods.TryGetValue(key, out found)) return found;
            }
            foreach (MethodInfo m in t.GetMethods(Members)) {
                if (m.Name != name || m.GetParameters().Length != paramCount) continue;
                found = m;
                break;
            }
            lock (_methods) {
                _methods[key] = found;
            }
            return found;
        }

        internal static string NameOf(object o) {
            if (o == null) return null;
            MethodInfo m = PickMethod(o.GetType(), "get_Name", 0);
            if (m != null) {
                try {
                    object name = m.Invoke(o, null);
                    if (name != null) return name.ToString();
                } catch {}
            }
            return o.ToString();
        }

        private static object FindVisual(Type t) {
            int[] budget = new int[] { 200000 }; // visuals to visit at most, across every window
            foreach (PresentationSource src in PresentationSource.CurrentSources) {
                object hit = Search(src.RootVisual as DependencyObject, t, budget);
                if (hit != null) return hit;
            }
            return null;
        }

        private static object Search(DependencyObject d, Type t, int[] budget) {
            if (d == null || budget[0] <= 0) return null;
            budget[0]--;
            if (t.IsInstanceOfType(d)) return d;
            int n = 0;
            try {
                n = VisualTreeHelper.GetChildrenCount(d);
            } catch {
                return null;
            }
            for (int i = 0; i < n; i++) {
                DependencyObject child = null;
                try {
                    child = VisualTreeHelper.GetChild(d, i) as DependencyObject;
                } catch {}
                object hit = Search(child, t, budget);
                if (hit != null) return hit;
            }
            return null;
        }
    }

