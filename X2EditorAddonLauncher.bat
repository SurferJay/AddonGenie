            /// <summary>
            /// Lines up the baselines of texts side by side in one row, such as a caption beside a name in the code
            /// font: centring alone leaves the code font sitting high, since fonts place their baselines
            /// differently. Each text keeps its own margins except the top, which this sets.
            /// </summary>
            public static void AlignBaselines(params TextBlock[] texts) {
                if (texts.Length == 0) return;
                // Fonts are only known once inherited from the window, so this waits for layout.
                texts[0].Loaded += delegate {
                    double deepest = 0;
                    foreach (TextBlock t in texts) deepest = Math.Max(deepest, t.FontFamily.Baseline * t.FontSize);
                    foreach (TextBlock t in texts) {
                        t.VerticalAlignment = VerticalAlignment.Top;
                        t.Margin = new Thickness(t.Margin.Left, deepest - t.FontFamily.Baseline * t.FontSize,
                                                 t.Margin.Right, t.Margin.Bottom);
                    }
                };
            }

