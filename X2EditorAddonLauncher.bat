            /// <summary>
            /// A note in a tone's colours: a small icon, a bold lead, then the text ("Images are exported so...").
            /// Info and Neutral show an i, Success a check, the rest an exclamation mark. With
            /// onDismiss, a × at the right calls it; removing the note is yours to do. below: content under the text,
            /// in line with it, such as a list and a button (Dependency Viewer's blocked Unreferenced check).
            /// **Words** in text are stressed: semibold and underlined (Dependency Viewer's "If this package **gets
            /// cooked**, ...").
            /// </summary>
            public static Border CreateNote(TagTone tone, string lead, string text, Action onDismiss = null,
                                            UIElement below = null) {
                Brush fill, edge, ink;
                ToneBrushes(tone, out fill, out edge, out ink);
                string mark;
                if (tone == TagTone.Success)
                    mark = "M 4.2,7.2 L 6.2,9.2 L 9.8,5.4"; // check
                else if (tone == TagTone.Caution || tone == TagTone.Warning || tone == TagTone.Danger)
                    mark = "M 7,3.8 L 7,7.8 M 7,10.2 L 7,10.3"; // exclamation mark
                else
                    mark = "M 7,6.2 L 7,10.2 M 7,3.9 L 7,4"; // i

                System.Windows.Shapes.Path icon = new System.Windows.Shapes.Path {
                    Data   = Geometry.Parse("M 7,0.75 A 6.25,6.25 0 1 1 7,13.25 A 6.25,6.25 0 1 1 7,0.75 Z " + mark),
                    Stroke = ink,
                    StrokeThickness    = 1.3,
                    StrokeLineJoin     = PenLineJoin.Round,
                    StrokeStartLineCap = PenLineCap.Round,
                    StrokeEndLineCap   = PenLineCap.Round,
                    Width              = 14,
                    Height             = 14,
                    Stretch            = Stretch.None,
                    VerticalAlignment  = VerticalAlignment.Top,
                    Margin             = new Thickness(0, 1, 8, 0),
                };
                DockPanel d = new DockPanel();
                DockPanel.SetDock(icon, Dock.Left);
                d.Children.Add(icon);
                if (onDismiss != null) {
                    Button dismiss  = DismissButton(ink, edge);
                    dismiss.Click  += delegate {
                        onDismiss();
                    };
                    DockPanel.SetDock(dismiss, Dock.Right);
                    d.Children.Add(dismiss);
                }
                // Natural line height: an 18px line box leaves the glyphs sitting above centre.
                TextBlock words = LeadText(lead, text, Theme.FontSizeLabel, ink);
                words.ClearValue(TextBlock.LineHeightProperty);
                if (below == null) {
                    d.Children.Add(words);
                } else {
                    StackPanel stack = new StackPanel();
                    stack.Children.Add(words);
                    FrameworkElement fe = below as FrameworkElement;
                    if (fe != null) fe.Margin = new Thickness(0, 8, 0, 2);
                    stack.Children.Add(below);
                    d.Children.Add(stack);
                }
                return new Border {
                    Child               = d,
                    Background          = fill,
                    BorderBrush         = edge,
                    BorderThickness     = new Thickness(1),
                    CornerRadius        = new CornerRadius(5),
                    Padding             = new Thickness(10, 7, (onDismiss != null) ? 5 : 10, 7),
                    SnapsToDevicePixels = true,
                };
            }

