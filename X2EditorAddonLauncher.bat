            _text = new TextBlock {
                Text              = text ?? "",
                Foreground        = ink,
                FontSize          = Genie.Theme.FontSizeLabel,
                TextWrapping      = TextWrapping.Wrap,
                VerticalAlignment = VerticalAlignment.Center,
            };
            DockPanel line = new DockPanel();
            line.Children.Add(_icon);
            line.Children.Add(_spinner);
            line.Children.Add(_text);
            Child           = line;
            Background      = fill;
            BorderBrush     = edge;
            BorderThickness = new Thickness(0, 0, 0, 1);
            Padding         = new Thickness(12, 5, 12, 5);
        }

        public string Text {
            get { return _text.Text; }
            set { _text.Text = value ?? ""; }
        }

        /// <summary>A spinner in place of the icon, for work going on (Package Loader's "Running." band).</summary>
        public bool IsBusy {
            get { return _spinner.Visibility == Visibility.Visible; }
            set {
                _spinner.Visibility = value ? Visibility.Visible : Visibility.Collapsed;
                _icon.Visibility    = value ? Visibility.Collapsed : Visibility.Visible;
            }
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreateNumberBox: a whole number, typed (digits only) or stepped with Up and Down or
    /// the spinner, which repeats while held. Commits on Enter, on leaving the box, and on each step.
    /// </summary>
    public sealed class GenieNumberBox : StackPanel {
        private readonly TextBox _text;
        private readonly Border  _frame;
        private readonly System.Windows.Controls.Primitives.RepeatButton _up, _down;
        private readonly TextBlock                                       _problem;
        private readonly double                                          _min, _max, _step;
        private readonly int                                             _decimals; // 0: whole numbers
        private readonly bool                                            _allowEmpty;
        private readonly string                                          _tooltip;

        private readonly Action<double?> _onCommitted;
        private readonly Func<double?, string> _onValidate;
        private double? _value;

        internal GenieNumberBox(int? value, int min, int max, Action<int?> onCommitted, Func<int?, string> onValidate,
                                bool allowEmpty, bool showSpinner, int step, string tooltip)
            : this(value, min, max, 0,
                   onCommitted == null ? (Action<double?>)null : delegate(double? v) { onCommitted(Whole(v)); },
                   onValidate == null ? (Func<double?, string>)null
                                      : delegate(double? v) { return onValidate(Whole(v)); },
                   allowEmpty, showSpinner, Math.Max(1, step), tooltip) {}

        internal GenieNumberBox(double? value, double min, double max, int decimals, Action<double?> onCommitted,
                                Func<double?, string> onValidate, bool allowEmpty, bool showSpinner, double step,
                                string tooltip) {
            _min                = Math.Min(min, max);
            _max                = Math.Max(min, max);
            _decimals           = Math.Max(0, decimals);
            _step               = step > 0 ? step : 1;
            _allowEmpty         = allowEmpty;
            _onCommitted        = onCommitted;
            _onValidate         = onValidate;
            _tooltip            = tooltip;
            HorizontalAlignment = HorizontalAlignment.Left;
            VerticalAlignment   = VerticalAlignment.Center;

            int digits = Math.Max(Format(_min).Length, Format(_max).Length) + (_decimals > 0 ? _decimals + 1 : 0);
            _text      = new TextBox {
                FontFamily               = Genie.Theme.MonoFont,
                FontSize                 = Genie.Theme.FontSizeLabel,
                Foreground               = Genie.Theme.TextPrimary,
                Background               = Brushes.Transparent,
                BorderThickness          = new Thickness(0),
                Padding                  = new Thickness(2, 2, 2, 2),
                MinWidth                 = digits * 7 + 10,
                MaxLength                = digits,
                VerticalContentAlignment = VerticalAlignment.Center,
            };
            _text.PreviewTextInput += delegate(object s, System.Windows.Input.TextCompositionEventArgs e) {
                e.Handled = !IsTypable(e.Text);
            };
            _text.PreviewKeyDown += OnKey;
            _text.PreviewKeyUp   += delegate(object s, System.Windows.Input.KeyEventArgs e) {
                if (e.Key == System.Windows.Input.Key.Up || e.Key == System.Windows.Input.Key.Down) Commit(false);
            };
            DataObject.AddPastingHandler(_text, delegate(object s, DataObjectPastingEventArgs e) {
                if (!IsTypable(e.DataObject.GetData(typeof(string)) as string)) e.CancelCommand();
            });
            _text.LostKeyboardFocus += delegate {
                Commit();
            };

            DockPanel inside = new DockPanel();
            if (showSpinner) {
                _up                = SpinButton(true);
                _down              = SpinButton(false);
                StackPanel spinner = new StackPanel();
                spinner.Children.Add(_up);
                spinner.Children.Add(new Border { Height = 1, Background = Genie.Theme.Separator });
                spinner.Children.Add(_down);
                Border column = new Border {
                    Child           = spinner,
                    BorderBrush     = Genie.Theme.InputBorder,
                    BorderThickness = new Thickness(1, 0, 0, 0),
                };
                DockPanel.SetDock(column, Dock.Right);
                inside.Children.Add(column);
            }
            inside.Children.Add(_text);
            _frame = new Border {
                Child               = inside,
                Height              = 22,
                BorderBrush         = Genie.Theme.InputBorder,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(3),
                Background          = Genie.Theme.InputBackground,
                ClipToBounds        = true,
                SnapsToDevicePixels = true,
                HorizontalAlignment = HorizontalAlignment.Left, // a wider problem line mustn't stretch it
            };
            Children.Add(_frame);
            _problem = new TextBlock {
                FontSize   = Genie.Theme.FontSizeTag,
                Foreground = Genie.Theme.DangerTagText,
                Margin     = new Thickness(0, 3, 0, 0),
                Visibility = Visibility.Collapsed,
            };
            Children.Add(_problem);

            IsEnabledChanged += delegate {
                Paint();
            };
            DecimalValue = value;
        }

        /// <summary>
        /// The committed value; null while empty (allowEmpty). Setting it shows it without calling onCommitted, and
        /// clears a problem. A decimal box's, rounded: use DecimalValue.
        /// </summary>
        public int? Value {
            get { return Whole(_value); }
            set { DecimalValue = value; }
        }

        /// <summary>Value, with its decimal places (CreateDecimalBox).</summary>
        public double? DecimalValue {
            get { return _value; }
            set {
                _value     = value.HasValue ? Math.Max(_min, Math.Min(_max, Math.Round(value.Value, _decimals)))
                                            : (_allowEmpty ? (double?)null : _min);
                _text.Text = _value.HasValue ? Format(_value.Value) : "";
                SetProblem(null);
            }
        }

        private static int? Whole(double? v) {
            return v.HasValue ? (int ?)(int) Math.Round(v.Value): null;
        }

        // Invariant: '.' is the only decimal mark typed.
        private string Format(double v) {
            return v.ToString(_decimals > 0 ? "0." + new string('#', _decimals) : "0",
                              System.Globalization.CultureInfo.InvariantCulture);
        }

        /// <summary>
        /// Puts the last value back for a bad one instead of keeping it red with its problem under the box. For a box
        /// with no room under it: a menu, a footer. Default false.
        /// </summary>
        public bool RevertInvalid { get; set; }

        /// <summary>Why the text typed can't be the value, while it's shown; null otherwise.</summary>
        public string Problem { get; private set; }

        private void OnKey(object sender, System.Windows.Input.KeyEventArgs e) {
            switch (e.Key) {
                case System.Windows.Input.Key.Space: // never reaches PreviewTextInput: TextBox takes it as a key
                    e.Handled = true;
                    break;
                case System.Windows.Input.Key.Up:
                    Step(_step);
                    e.Handled = true;
                    break;
                case System.Windows.Input.Key.Down:
                    Step(-_step);
                    e.Handled = true;
                    break;
                case System.Windows.Input.Key.Enter:
                    Commit();
                    break;
            }
        }

        // From the number typed, if any, else the value: stepping fixes a bad entry rather than adding to it. Quiet
        // while held: a refused value passed on the way would flash its problem. The release commits (Commit(false)).
        private void Step(double delta) {
            double typed;
            double from = TryRead(_text.Text.Trim(), out typed) ? typed : (_value ?? _min);
            double next = Math.Max(_min, Math.Min(_max, Math.Round(from + delta, _decimals)));
            _text.Text  = Format(next);
            Commit(true);
        }

        private void Commit() {
            Commit(false);
        }

        // quiet: a refused value is left as typed, neither shown nor put back.
        private void Commit(bool quiet) {
            double? value  = null;
            string problem = Check(_text.Text.Trim(), out value);
            if (problem == null && _onValidate != null) problem = _onValidate(value);
            if (problem != null) {
                if (quiet) return;
                if (RevertInvalid)
                    DecimalValue = _value;
                else
                    SetProblem(problem);
                return;
            }
            _text.Text = value.HasValue ? Format(value.Value) : ""; // "007" reads 7
            SetProblem(null);
            if (value == _value) return;
            _value = value;
            Paint();
            if (_onCommitted != null) _onCommitted(value);
        }

        private string Check(string text, out double? value) {
            value = null;
            if (text.Length == 0) return _allowEmpty ? null : Range();
            double n;
            int    dot = text.IndexOf('.');
            if (!TryRead(text, out n) || n < _min || n > _max || (dot >= 0 && text.Length - dot - 1 > _decimals))
                return Range();
            value = n;
            return null;
        }

        private bool TryRead(string text, out double n) {
            return double.TryParse(text, System.Globalization.NumberStyles.AllowDecimalPoint,
                                   System.Globalization.CultureInfo.InvariantCulture, out n);
        }

        private string Range() {
            string what = _decimals == 0 ? "a whole number" : "a number, up to " + _decimals + " decimal places,";
            return "Enter " + what + " from " + Format(_min) + " to " + Format(_max) + ".";
        }

        private void SetProblem(string problem) {
            Problem             = problem;
            _problem.Text       = problem ?? "";
            _problem.Visibility = problem == null ? Visibility.Collapsed : Visibility.Visible;
            Paint();
        }

        // Red while it has a problem, grey while disabled; the spinner's ends stop at min and max.
        private void Paint() {
            bool bad           = Problem != null;
            _frame.BorderBrush = bad ? Genie.Theme.DangerTagText : Genie.Theme.InputBorder;
            _frame.Background  = !IsEnabled ? Genie.Theme.DisabledButtonBackground
                                 : bad      ? Genie.Theme.DangerTagBackground
                                            : Genie.Theme.InputBackground;
            _text.Foreground   = IsEnabled ? Genie.Theme.TextPrimary : Genie.Theme.TextDisabled;
            Genie.ControlUtils.SetToolTip(_frame, Problem ?? _tooltip);
            if (_up == null) return;
            _up.IsEnabled   = !_value.HasValue || _value.Value < _max;
            _down.IsEnabled = !_value.HasValue || _value.Value > _min;
        }

        // Digits, and in a decimal box one '.' in all.
        private bool IsTypable(string text) {
            if (string.IsNullOrEmpty(text)) return false;
            string kept = _text.Text.Remove(_text.SelectionStart, _text.SelectionLength); // what typing leaves
            int    dots = _decimals > 0 && kept.IndexOf('.') >= 0 ? 1 : 0;
            foreach (char c in text) {
                if (c == '.' && _decimals > 0 && ++dots == 1) continue;
                if (c < '0' || c > '9') return false;
            }
            return true;
        }

        // A chevron in a flat half-height button. Keyboard focus stays in the text, so Enter and arrows keep working.
        private System.Windows.Controls.Primitives.RepeatButton SpinButton(bool up) {
            System.Windows.Shapes.Path chevron = new System.Windows.Shapes.Path {
                Data               = Geometry.Parse(up ? "M 1,4 L 4,1 L 7,4" : "M 1,1 L 4,4 L 7,1"),
                Stroke             = Genie.Theme.TextSecondary,
                StrokeThickness    = 1.3,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
                Width              = 8,
                Height             = 5,
                Stretch            = Stretch.None,
            };
            FrameworkElementFactory face = new FrameworkElementFactory(typeof(Border));
            face.SetBinding(Border.BackgroundProperty,
                            new Binding("Background") { RelativeSource = RelativeSource.TemplatedParent });
            FrameworkElementFactory content = new FrameworkElementFactory(typeof(ContentPresenter));
            content.SetValue(HorizontalAlignmentProperty, HorizontalAlignment.Center);
            content.SetValue(VerticalAlignmentProperty, VerticalAlignment.Center);
            face.AppendChild(content);

            System.Windows.Controls.Primitives.RepeatButton button =
                new System.Windows.Controls.Primitives.RepeatButton {
                    Content    = chevron,
                    Width      = 14,
                    Height     = 10,
                    Focusable  = false,
                    Delay      = 400,
                    Interval   = 60,
                    Background = Genie.Theme.ButtonBackground,
                    Template   = new ControlTemplate(
                        typeof(System.Windows.Controls.Primitives.RepeatButton)) { VisualTree = face },
                };
            Action paint = delegate {
                button.Background = button.IsEnabled && button.IsMouseOver ? Genie.Theme.ButtonHoverBackground
                                                                           : Genie.Theme.ButtonBackground;
                chevron.Stroke    = button.IsEnabled ? Genie.Theme.TextSecondary : Genie.Theme.TextDisabled;
            };
            button.MouseEnter += delegate {
                paint();
            };
            button.MouseLeave += delegate {
                paint();
            };
            button.IsEnabledChanged += delegate {
                paint();
            };
            button.Click += delegate {
                Step(up ? _step : -_step);
            };
            button.LostMouseCapture += delegate {
                Commit(false);
            };
            return button;
        }
    }

    /// <summary>
    /// A group in CreateSettingsDiffList: the sections whose names start with SectionPrefix, one row each, under
    /// Caption. Package Loader: ("Jobs", "Job."), ("Step templates", "Template.").
    /// </summary>
    public sealed class GenieSettingsGroup {
        public GenieSettingsGroup(string caption, string sectionPrefix) {
            Caption       = caption ?? "";
            SectionPrefix = sectionPrefix ?? "";
        }

        public string Caption { get; private set; }
        public string SectionPrefix { get; private set; }
    }

    // CreateSettingsDiffList: a lead line with "Show unchanged", then one box of groups. Grouped sections are a row
    // each, named by onSectionName; every other section is its own group, a row per setting with its values.
    internal sealed class SettingsDiffList : StackPanel {
        private const double KeyWidth = 150;

        private sealed class Row {
            internal string                 Name, Now, Backup, Tip, Detail;
            internal GenieSettingChangeKind Kind;
            internal bool                   ShowsValues;
        }

        private sealed class Group {
            internal string Caption;
            internal List<Row> Rows = new List<Row>();
        }

        private readonly List<Group> _groups = new List<Group>();
        private readonly CheckBox    _showSame;
        private readonly StackPanel  _box = new StackPanel();
        private readonly Border      _frame;

        internal SettingsDiffList(GenieSettingsDiff diff, Func<GenieSectionChange, string> onSectionName,
                                  Func<GenieSectionChange, string> onSectionDetail, GenieSettingsGroup[] groups) {
            Build(diff, onSectionName, onSectionDetail, groups ?? new GenieSettingsGroup[0]);
            int[] counts = new int[4];
            foreach (Group g in _groups) {
                foreach (Row r in g.Rows) counts[(int)r.Kind]++;
            }

            DockPanel lead = new DockPanel { Margin = new Thickness(0, 0, 0, 6) };
            _showSame =
                Genie.ControlUtils.CreateCheckBox("Show unchanged (" + counts[(int)GenieSettingChangeKind.Same] + ")",
                                                  false, "Also list what a restore leaves as it is");
            _showSame.VerticalAlignment  = VerticalAlignment.Center;
            _showSame.Checked           += delegate {
                Render();
            };
            _showSame.Unchecked += delegate {
                Render();
            };
            DockPanel.SetDock(_showSame, Dock.Right);
            lead.Children.Add(_showSame);
            TextBlock text         = Genie.ControlUtils.CreateNoteText(LeadText(counts));
            text.TextWrapping      = TextWrapping.Wrap;
            text.VerticalAlignment = VerticalAlignment.Center;
            text.Margin            = new Thickness(0, 0, 8, 0);
            lead.Children.Add(text);
            Children.Add(lead);

            _frame = new Border {
                Child               = _box,
                BorderBrush         = Genie.Theme.Separator,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(Genie.Theme.BoxCornerRadius),
                SnapsToDevicePixels = true,
                UseLayoutRounding   = true,
            };
            Children.Add(_frame);
            TextBlock note = Genie.ControlUtils.CreateNoteText(
                "Window positions and sizes aren’t listed: a restore keeps them as they are.");
            note.TextWrapping = TextWrapping.Wrap;
            note.Margin       = new Thickness(0, 6, 0, 0);
            Children.Add(note);
            Render();
        }

        private void Build(GenieSettingsDiff diff, Func<GenieSectionChange, string> onSectionName,
                           Func<GenieSectionChange, string> onSectionDetail, GenieSettingsGroup[] groups) {
            Group[] grouped = new Group[groups.Length];
            for (int i = 0; i < groups.Length; i++) grouped[i] = new Group { Caption = groups[i].Caption };
            List<Group> rest = new List<Group>();
            foreach (GenieSectionChange s in diff.Sections) {
                int at = Array.FindIndex(groups,
                                         g => g.SectionPrefix.Length > 0 &&
                                              s.Name.StartsWith(g.SectionPrefix, StringComparison.OrdinalIgnoreCase));
                if (at >= 0) {
                    string name = onSectionName != null ? onSectionName(s) : null;
                    grouped[at].Rows.Add(new Row {
                        Name   = string.IsNullOrEmpty(name) ? s.Name.Substring(groups[at].SectionPrefix.Length) : name,
                        Kind   = s.Kind,
                        Tip    = SectionTip(s),
                        Detail = onSectionDetail != null ? onSectionDetail(s) : null,
                    });
                    continue;
                }
                Group own = new Group { Caption = "[" + s.Name + "]" };
                foreach (GenieSettingChange c in s.Settings)
                    own.Rows.Add(
                        new Row { Name = c.Key, Kind = c.Kind, Now = c.Now, Backup = c.Backup, ShowsValues = true });
                rest.Add(own);
            }
            _groups.AddRange(grouped);
            _groups.AddRange(rest);
        }

        // What a restore changes in a grouped section, a line per setting.
        private static string SectionTip(GenieSectionChange s) {
            if (s.Kind == GenieSettingChangeKind.Same) return null;
            List<string> lines = new List<string>();
            foreach (GenieSettingChange c in s.Settings) {
                if (c.Kind == GenieSettingChangeKind.Same) continue;
                if (lines.Count == 12) {
                    lines.Add("...");
                    break;
                }
                lines.Add(c.Key + ": " +
                          (c.Kind == GenieSettingChangeKind.Changed ? c.Now + " → " + c.Backup
                           : c.Kind == GenieSettingChangeKind.Goes  ? "goes (" + c.Now + ")"
                                                                    : "comes back (" + c.Backup + ")"));
            }
            return string.Join("\n", lines.ToArray());
        }

        private static string LeadText(int[] counts) {
            int changed = counts[(int)GenieSettingChangeKind.Changed],
                back    = counts[(int)GenieSettingChangeKind.ComesBack];
            int goes    = counts[(int)GenieSettingChangeKind.Goes];
            if (changed + back + goes == 0) return "Matches your settings now. Restoring changes nothing.";
            List<string> parts = new List<string>();
            if (changed > 0) parts.Add(changed + " changed");
            if (back > 0) parts.Add(back + (back == 1 ? " comes back" : " come back"));
            if (goes > 0) parts.Add(goes + (goes == 1 ? " goes" : " go"));
            return "Restoring this backup, against your settings now: " + string.Join(", ", parts.ToArray()) + ".";
        }

        private void Render() {
            bool showSame = _showSame.IsChecked == true;
            _box.Children.Clear();
            foreach (Group g in _groups) {
                List<Row> shown = g.Rows.FindAll(r => showSame || r.Kind != GenieSettingChangeKind.Same);
                if (shown.Count == 0) continue;
                int changes = g.Rows.FindAll(r => r.Kind != GenieSettingChangeKind.Same).Count;
                _box.Children.Add(Header(g.Caption,
                                         changes == 0 ? "no changes" : Genie.TextUtils.Count(changes, "change"),
                                         _box.Children.Count == 0));
                foreach (Row r in shown) _box.Children.Add(Line(r));
            }
            _frame.Visibility = _box.Children.Count > 0 ? Visibility.Visible : Visibility.Collapsed;
        }

        private static Border Header(string caption, string count, bool first) {
            DockPanel line  = new DockPanel();
            TextBlock right = Genie.ControlUtils.CreateCaption(count, false);
            DockPanel.SetDock(right, Dock.Right);
            line.Children.Add(right);
            line.Children.Add(Genie.ControlUtils.CreateCaption(caption, false));
            return new Border {
                Child           = line,
                MinHeight       = 28,
                Padding         = new Thickness(10, 6, 10, 6),
                Background      = Genie.Theme.FieldLabelBackground,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, first ? 0 : 1, 0, 1),
            };
        }

        // name | old → new | tag, values only for a setting's row.
        private static Border Line(Row r) {
            DockPanel line = new DockPanel();
            GenieTag  tag  = KindTag(r.Kind);
            tag.Margin     = new Thickness(8, 0, 0, 0);
            DockPanel.SetDock(tag, Dock.Right);
            line.Children.Add(tag);

            TextBlock name    = Genie.ControlUtils.CreateMonoText(r.Name, Genie.Theme.FontSizeLabel - 0.5);
            name.Margin       = new Thickness(0);
            name.TextTrimming = TextTrimming.CharacterEllipsis;
            if (r.Kind == GenieSettingChangeKind.Goes) Strike(name);
            if (r.ShowsValues) {
                name.Width = KeyWidth;
                Genie.ControlUtils.SetToolTip(name, r.Name);
                DockPanel.SetDock(name, Dock.Left);
                line.Children.Add(name);
                line.Children.Add(Values(r));
            } else {
                Genie.ControlUtils.SetToolTip(name, r.Tip);
                DockPanel.SetDock(name, Dock.Left);
                line.Children.Add(name);
                TextBlock detail         = Genie.ControlUtils.CreateNoteText(r.Detail);
                detail.Margin            = new Thickness(8, 0, 0, 0);
                detail.TextTrimming      = TextTrimming.CharacterEllipsis;
                detail.TextWrapping      = TextWrapping.NoWrap;
                detail.VerticalAlignment = VerticalAlignment.Center;
                line.Children.Add(detail);
            }
            return new Border {
                Child           = line,
                MinHeight       = 28,
                Padding         = new Thickness(10, 4, 10, 4),
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(0, 0, 0, 1),
            };
        }

        // Changed: now, struck, then the backup's. Goes: now, struck. Comes back: the backup's. Same: the value.
        private static FrameworkElement Values(Row r) {
            StackPanel values =
                new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(8, 0, 0, 0) };
            bool showNow = r.Kind == GenieSettingChangeKind.Changed || r.Kind == GenieSettingChangeKind.Goes;
            if (showNow) {
                TextBlock now  = Value(r.Now);
                now.Foreground = Genie.Theme.TextDisabled;
                Strike(now);
                values.Children.Add(now);
            }
            if (r.Kind == GenieSettingChangeKind.Changed) {
                TextBlock arrow  = Value("→");
                arrow.Foreground = Genie.Theme.TextDisabled;
                arrow.Margin     = new Thickness(6, 0, 6, 0);
                values.Children.Add(arrow);
            }
            if (r.Kind != GenieSettingChangeKind.Goes)
                values.Children.Add(Value(r.Kind == GenieSettingChangeKind.Same ? r.Now : r.Backup));
            Genie.ControlUtils.SetToolTip(
                values, r.Kind == GenieSettingChangeKind.Changed ? "Now: " + r.Now + "\nAfter a restore: " + r.Backup
                        : r.Kind == GenieSettingChangeKind.Goes  ? "Now: " + r.Now
                        : r.Kind == GenieSettingChangeKind.ComesBack ? "After a restore: " + r.Backup
                                                                     : r.Now);
            return values;
        }

        private static TextBlock Value(string text) {
            TextBlock value    = Genie.ControlUtils.CreateMonoText(text, Genie.Theme.FontSizeTag);
            value.Margin       = new Thickness(0);
            value.TextTrimming = TextTrimming.CharacterEllipsis;
            return value;
        }

        private static void Strike(TextBlock text) {
            text.TextDecorations = TextDecorations.Strikethrough;
        }

        internal static GenieTag KindTag(GenieSettingChangeKind kind) {
            switch (kind) {
                case GenieSettingChangeKind.Changed:
                    return Genie.ControlUtils.CreateTag("Changed", Genie.ControlUtils.TagTone.Info,
                                                        "A restore puts back the value in this backup");
                case GenieSettingChangeKind.ComesBack:
                    return Genie.ControlUtils.CreateTag("Comes back", Genie.ControlUtils.TagTone.Success,
                                                        "Not in your settings now. A restore adds it.");
                case GenieSettingChangeKind.Goes:
                    return Genie.ControlUtils.CreateTag("Goes", Genie.ControlUtils.TagTone.Danger,
                                                        "Added since this backup. A restore removes it.");
                default:
                    return Genie.ControlUtils.CreateTag("Same", Genie.ControlUtils.TagTone.Neutral,
                                                        "Unchanged by a restore");
            }
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreateSettingsRestorePanel: an addon's settings backups, what restoring one would
    /// change, and Restore. Follows the settings file as it's saved.
    /// </summary>
    public sealed class GenieRestorePanel : UserControl {
        private readonly Assembly _owner;
        private readonly string   _addonName;
        private readonly Func<GenieSettingsSnapshot, string> _onDescribe;
        private readonly Func<GenieSettingsDiff, IEnumerable<UIElement>> _onHeader;
        private readonly Func<GenieSettingsDiff, UIElement> _onPreview;
        private readonly Func<string> _onCheckRestore;
        private readonly Action       _onRestored;

        private readonly GenieHeader     _header;
        private readonly StackPanel      _pills = new StackPanel { Orientation = Orientation.Horizontal };
        private readonly GenieListPane   _launches;
        private readonly ContentControl  _preview = new ContentControl { Focusable = false };
        private readonly Border          _band;
        private readonly TextBlock       _bandText;
        private readonly Button          _bandCancel, _bandRestore;
        private readonly Button          _restore;
        private readonly GenieStatusPill _toast;

        private GenieSettingsDiff _diff;     // the selected backup's, or null
        private string            _compared; // the settings _diff was made against (Signature)
        private bool              _refreshQueued, _filling, _isLoaded, _isRestoring;
        private int               _loads; // the latest read of the zip; an older one's result is dropped

        internal GenieRestorePanel(GenieWindow window, Assembly owner, Func<GenieSettingsSnapshot, string> onDescribe,
                                   Func<GenieSettingsDiff, IEnumerable<UIElement>> onHeader,
                                   Func<GenieSettingsDiff, UIElement> onPreview, Func<string> onCheckRestore,
                                   Action onRestored) {
            _owner            = owner;
            _onDescribe       = onDescribe;
            _onHeader         = onHeader;
            _onPreview        = onPreview;
            _onCheckRestore   = onCheckRestore;
            _onRestored       = onRestored;
            LoadedAddon addon = AddonRegistry.AddonFor(owner);
            _addonName        = addon != null ? addon.Name : AddonRegistry.TagFor(owner);
            if (window != null) window.ShowAddonInfo = false; // the footer's left end is the keep setting

            Grid root = new Grid();
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            root.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });

            // No controls: nothing here to refresh or pin, and the Remember options belong to the addon's own windows.
            _header                     = Genie.ControlUtils.CreatePanelHeader(window, "BACKUP", 0);
            _header.Controls.Visibility = Visibility.Collapsed;
            _header.AddPill(_pills);
            Grid.SetRow(_header, 0);
            root.Children.Add(_header);

            // Launches | divider | preview
            Grid body = new Grid();
            body.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(220) });
            body.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
            body.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            _launches                        = Genie.ControlUtils.CreateListPane("Launches", true);
            _launches.Margin                 = new Thickness(10, 10, 0, 10);
            _launches.CountPill.Visibility   = Visibility.Visible;
            _launches.List.SelectionChanged += delegate {
                if (!_filling) Select();
            };
            body.Children.Add(_launches);
            Border divider = Genie.ControlUtils.CreateSeparator(Orientation.Vertical);
            divider.Margin = new Thickness(0, 10, 0, 10);
            Grid.SetColumn(divider, 1);
            body.Children.Add(divider);
            ScrollViewer right = new ScrollViewer {
                Content                       = _preview,
                Padding                       = Genie.Theme.PaneInset,
                VerticalScrollBarVisibility   = ScrollBarVisibility.Auto,
                HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled,
            };
            _toast           = Genie.ControlUtils.CreateStatusPill(); // bottom right, over the preview
            Grid previewArea = new Grid();
            previewArea.Children.Add(right);
            previewArea.Children.Add(_toast);
            Grid.SetColumn(previewArea, 2);
            body.Children.Add(previewArea);
            Grid.SetRow(body, 1);
            root.Children.Add(body);

            // Confirm band, over the footer while asking.
            _bandText = new TextBlock {
                FontSize          = Genie.Theme.FontSizeLabel,
                TextWrapping      = TextWrapping.Wrap,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(0, 0, 8, 0),
            };
            _bandCancel        = Genie.ControlUtils.CreateButton("Cancel");
            _bandCancel.Click += delegate {
                HideBand();
            };
            _bandRestore         = Genie.ControlUtils.CreateButton("Restore", Genie.ControlUtils.ButtonTone.Primary);
            _bandRestore.Margin  = new Thickness(0);
            _bandRestore.Click  += delegate {
                Restore();
            };
            StackPanel bandButtons = Genie.ControlUtils.CreateButtonRow(_bandCancel, _bandRestore);
            DockPanel  band        = new DockPanel();
            DockPanel.SetDock(bandButtons, Dock.Right);
            band.Children.Add(bandButtons);
            band.Children.Add(_bandText);
            _band = new Border {
                Child           = band,
                Padding         = new Thickness(12, 8, 12, 8),
                BorderThickness = new Thickness(0, 1, 0, 0),
                Visibility      = Visibility.Collapsed,
            };
            Grid.SetRow(_band, 2);
            root.Children.Add(_band);

            // Footer: Back up settings for [N] sessions (find) ... toast, Restore…
            StackPanel keep =
                new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };
            keep.Children.Add(FooterText("Back up settings for"));
            GenieNumberBox count = Genie.ControlUtils.CreateNumberBox(
                SettingsBackups.GetKeep(owner), SettingsBackups.MinKeep, SettingsBackups.MaxKeep, delegate(int? n) {
                if (n.HasValue) SettingsBackups.SetKeep(_owner, n.Value);
                });
            count.RevertInvalid = true;
            count.Margin        = new Thickness(6, 0, 6, 0);
            GenieSettingsButton.FollowKeep(count, owner);
            keep.Children.Add(count);
            keep.Children.Add(FooterText("sessions"));
            Border find = GenieSettingsButton.SettingsBackupFind(owner);
            find.Margin = new Thickness(6, 0, 0, 0);
            keep.Children.Add(find);
            Genie.ControlUtils.SetToolTip(keep, SettingsBackups.KeepHelp);

            _restore         = Genie.ControlUtils.CreateButton("Restore…");
            _restore.Margin  = new Thickness(0);
            _restore.Click  += delegate {
                Ask();
            };
            DockPanel bar = new DockPanel();
            DockPanel.SetDock(_restore, Dock.Right);
            bar.Children.Add(_restore);
            bar.Children.Add(keep);
            Border footer = Genie.ControlUtils.CreateFooter(bar, new Thickness(12, 8, 12, 8));
            Grid.SetRow(footer, 3);
            root.Children.Add(footer);
            Content = root;

            IniFile config = AddonRegistry.ConfigFor(owner);
            Action  saved  = QueueRefresh;
            Genie.ControlUtils.WhileLoaded(this,
                                           delegate {
                                               if (config != null) config.Saved += saved;
                                               Refresh();
                                           },
                                           delegate {
                                               if (config != null) config.Saved -= saved;
                                           });
        }

        private static TextBlock FooterText(string text) {
            return new TextBlock {
                Text              = text,
                FontSize          = Genie.Theme.FontSizeLabel,
                Foreground        = Genie.Theme.TextPrimary,
                VerticalAlignment = VerticalAlignment.Center,
            };
        }

        // Settings saved anywhere change what a restore would do. Saves come in bursts, so once per burst.
        private void QueueRefresh() {
            if (_refreshQueued) return;
            _refreshQueued = true;
            Dispatcher.BeginInvoke(DispatcherPriority.Background, (Action)delegate {
                _refreshQueued = false;
                if (IsLoaded && Signature() != _compared) Refresh();
            });
        }

        // The addon's own settings as one string: a save that only moved a window or set the keep count changes
        // nothing a restore would do, and mustn't redraw the panel under the user.
        private string Signature() {
            IniFile config = AddonRegistry.ConfigFor(_owner);
            if (config == null) return "";
            StringBuilder all = new StringBuilder();
            foreach (KeyValuePair<string, List<KeyValuePair<string, string>>> s in config.GetAll()) {
                all.Append('[').Append(s.Key).Append("]\n");
                foreach (KeyValuePair<string, string> e in s.Value) {
                    if (!config.IsManaged(s.Key, e.Key)) all.Append(e.Key).Append('=').Append(e.Value).Append('\n');
                }
            }
            return all.ToString();
        }

        /// <summary>
        /// Reads the backups and settings again, keeping the selection, and asks onCheckRestore again: call it when
        /// something your onCheckRestore reads changes (a job starts or ends).
        /// </summary>
        public void Refresh() {
            _compared      = Signature();
            int      load  = ++_loads;
            Assembly owner = _owner;
            // The zip and every backup in it are read off the UI thread, parsed too; rows are made back on it.
            Genie.WorkUtils.RunInBackground(
                delegate {
                    List<KeyValuePair<GenieSettingsBackup, GenieSettingsSnapshot>> read =
                        new List<KeyValuePair<GenieSettingsBackup, GenieSettingsSnapshot>>();
                    foreach (GenieSettingsBackup b in SettingsBackups.List(owner))
                        read.Add(
                            new KeyValuePair<GenieSettingsBackup, GenieSettingsSnapshot>(b, SettingsBackups.Read(b)));
                    return read;
                },
                delegate(List<KeyValuePair<GenieSettingsBackup, GenieSettingsSnapshot>> read) {
                    if (load == _loads) ShowBackups(read);
                });
            if (!_isLoaded) Select();
        }

        private void ShowBackups(List<KeyValuePair<GenieSettingsBackup, GenieSettingsSnapshot>> backups) {
            _isLoaded                = true;
            GenieSettingsBackup kept = _launches.List.SelectedTag<GenieSettingsBackup>();
            _filling                 = true;
            try {
                _launches.List.Items.Clear();
                ListBoxItem reselect = null;
                foreach (KeyValuePair<GenieSettingsBackup, GenieSettingsSnapshot> b in backups) {
                    ListBoxItem item = _launches.List.AddItem(LaunchRow(b.Key, b.Value), b.Key);
                    item.Padding     = new Thickness(4, 5, 4, 5);
                    if (kept != null && b.Key.EntryName == kept.EntryName) reselect = item;
                }
                _launches.CountPill.Text = backups.Count.ToString();
                // At first the launch before this one: this launch's matches the settings unless they changed since.
                if (reselect == null && _launches.List.Items.Count > 0)
                    reselect = (ListBoxItem)_launches.List.Items[Math.Min(1, _launches.List.Items.Count - 1)];
                _launches.List.SelectedItem = reselect;
            } finally {
                _filling = false;
            }
            Select();
        }

        // Time, a note for this launch's or a restore's own backup, and onDescribe's line.
        private UIElement LaunchRow(GenieSettingsBackup b, GenieSettingsSnapshot snapshot) {
            StackPanel row   = new StackPanel();
            WrapPanel  title = new WrapPanel();
            title.Children.Add(new TextBlock {
                Text       = b.Title,
                FontSize   = Genie.Theme.FontSizeBody,
                Foreground = Genie.Theme.TextPrimary,
                Margin     = new Thickness(0, 0, 6, 0),
            });
            string note = b.IsThisLaunch ? "this launch" : b.IsBeforeRestore ? "before restore" : null;
            if (note != null)
                title.Children.Add(new TextBlock {
                    Text              = note,
                    FontSize          = Genie.Theme.FontSizeTag,
                    Foreground        = Genie.Theme.InfoTagText,
                    VerticalAlignment = VerticalAlignment.Bottom,
                });
            row.Children.Add(title);
            row.Children.Add(new TextBlock {
                Text         = snapshot == null ? "Can't be read" : Describe(snapshot),
                FontSize     = Genie.Theme.FontSizeTag,
                Foreground   = Genie.Theme.TextSecondary,
                TextTrimming = TextTrimming.CharacterEllipsis,
                Margin       = new Thickness(0, 3, 0, 0),
            });
            Genie.ControlUtils.SetToolTip(row,
                                          b.Time.ToString("dddd, MMMM d, yyyy HH:mm:ss", CultureInfo.InvariantCulture));
            return row;
        }

        private string Describe(GenieSettingsSnapshot snapshot) {
            if (_onDescribe != null) {
                try {
                    return _onDescribe(snapshot) ?? "";
                } catch (Exception ex) {
                    LogStore.Write(AddonRegistry.TagFor(_owner), "onDescribe failed: " + ex);
                }
            }
            int sections, settings;
            snapshot.CountOwn(out sections, out settings);
            return Genie.TextUtils.Count(sections, "section") + " · " + Genie.TextUtils.Count(settings, "setting");
        }

        // The selected backup: header, preview and Restore.
        private void Select() {
            HideBand();
            GenieSettingsBackup   b        = _launches.List.SelectedTag<GenieSettingsBackup>();
            GenieSettingsSnapshot snapshot = b == null ? null : SettingsBackups.Read(b);
            GenieSettingsSnapshot now      = GenieSettingsSnapshot.Of(AddonRegistry.ConfigFor(_owner));
            _diff         = snapshot == null || now == null ? null : GenieSettingsDiff.Compare(snapshot, now);
            _header.Title = b == null ? "None" : b.Title;
            _pills.Children.Clear();
            if (_diff != null) {
                foreach (UIElement pill in HeaderPills()) {
                    FrameworkElement fe = pill as FrameworkElement;
                    if (fe != null) fe.Margin = new Thickness(0, 0, Genie.Theme.Spacing, 0);
                    _pills.Children.Add(pill);
                }
                if (_diff.IsSame)
                    _pills.Children.Add(
                        Genie.ControlUtils.CreateCountPill("Same as now", Genie.ControlUtils.TagTone.Success));
            }
            _preview.Content = Preview(b);
            UpdateRestore();
        }

        private IEnumerable<UIElement> HeaderPills() {
            if (_onHeader != null) {
                try {
                    return _onHeader(_diff) ?? new UIElement[0];
                } catch (Exception ex) {
                    LogStore.Write(AddonRegistry.TagFor(_owner), "onHeader failed: " + ex);
                }
            }
            int changes = _diff.Count(GenieSettingChangeKind.Changed) + _diff.Count(GenieSettingChangeKind.ComesBack) +
                          _diff.Count(GenieSettingChangeKind.Goes);
            return new UIElement[] {
                Genie.ControlUtils.CreateCountPill(changes == 0 ? "no changes"
                                                                : Genie.TextUtils.Count(changes, "change")),
            };
        }

        private UIElement Preview(GenieSettingsBackup b) {
            if (!_isLoaded) return Genie.ControlUtils.CreateEmptyState("Reading the backups\u2026", null);
            if (b == null)
                return Genie.ControlUtils.CreateEmptyState(
                    "No backups yet", "One is made each time the editor starts, once " + _addonName + " has settings.");
            if (_diff == null)
                return Genie.ControlUtils.CreateEmptyState("Can't read this backup",
                                                           "Its copy in the zip is damaged. Pick another.");
            if (_onPreview != null) {
                try {
                    return _onPreview(_diff);
                } catch (Exception ex) {
                    LogStore.Write(AddonRegistry.TagFor(_owner), "onPreview failed: " + ex);
                }
            }
            return Genie.ControlUtils.CreateSettingsDiffList(_diff);
        }

        // Off, saying why, while there's nothing to restore or onCheckRestore says not now.
        private string WhyNot() {
            if (_isRestoring) return "Restoring\u2026";
            if (_diff == null) return "Pick a backup that can be read";
            if (_diff.IsSame) return "Nothing to restore: this backup matches your settings now";
            if (_onCheckRestore == null) return null;
            try {
                return _onCheckRestore();
            } catch (Exception ex) {
                LogStore.Write(AddonRegistry.TagFor(_owner), "onCheckRestore failed: " + ex);
                return "Can't check whether a restore is safe now; see the log";
            }
        }

        private void UpdateRestore() {
            string why         = WhyNot();
            _restore.IsEnabled = why == null;
            Genie.ControlUtils.SetToolTip(_restore, why ?? "Restore this backup");
        }

        private void Ask() {
            UpdateRestore(); // the addon's reason may have changed since the selection
            if (!_restore.IsEnabled) return;
            ShowBand(Genie.ControlUtils.TagTone.Warning,
                     "Replace your " + _addonName + " settings with the ones from " + _diff.Backup.Backup.Title +
                         "? Your settings now are backed up first, so you can restore them from here.",
                     true);
        }

        private void Restore() {
            HideBand();
            if (WhyNot() != null) {
                UpdateRestore();
                return;
            }
            GenieSettingsBackup b      = _diff.Backup.Backup;
            IniFile             config = AddonRegistry.ConfigFor(_owner);
            Assembly            owner  = _owner;
            byte[] now;
            try {
                now = SettingsBackups.ReadSettingsFile(config);
            } catch (IOException ex) {
                ShowBand(Genie.ControlUtils.TagTone.Danger, ex.Message, false);
                return;
            }
            _isRestoring = true;
            UpdateRestore();
            Genie.WorkUtils.RunInBackground(delegate { return SettingsBackups.BackUpBeforeRestore(owner, now); },
                                            delegate {
                                                _isRestoring = false;
                                                // Edited during the backup: back those edits up too.
                                                if (!Genie.FileUtils.IsSameContent(config.FilePath, now))
                                                    Restore();
                                                else
                                                    FinishRestore(b);
                                            },
                                            delegate(Exception ex) {
                                                _isRestoring = false;
                                                ShowBand(Genie.ControlUtils.TagTone.Danger, ex.Message, false);
                                            });
        }

        private void FinishRestore(GenieSettingsBackup b) {
            string why = WhyNot(); // a job may have started while it was backing up
            if (why != null) {
                UpdateRestore();
                return;
            }
            try {
                SettingsBackups.Apply(b);
            } catch (IOException ex) {
                ShowBand(Genie.ControlUtils.TagTone.Danger, ex.Message, false);
                return;
            }
            if (_onRestored != null) {
                try {
                    _onRestored();
                } catch (Exception ex) {
                    LogStore.Write(AddonRegistry.TagFor(_owner), "onRestored failed: " + ex);
                }
            }
            Refresh();
            _toast.ShowDone("Restored " + b.Title + ". Your previous settings are the top backup.");
        }

        // asking: Cancel and Restore; otherwise a problem with only Close.
        private void ShowBand(Genie.ControlUtils.TagTone tone, string text, bool asking) {
            Brush fill, edge, ink;
            Genie.ControlUtils.ToneBrushes(tone, out fill, out edge, out ink);
            _band.Background        = fill;
            _band.BorderBrush       = edge;
            _bandText.Foreground    = ink;
            _bandText.Text          = text;
            _bandCancel.Content     = asking ? "Cancel" : "Close";
            _bandRestore.Visibility = asking ? Visibility.Visible : Visibility.Collapsed;
            _band.Visibility        = Visibility.Visible;
            _restore.IsEnabled      = false;
        }

        private void HideBand() {
            if (_band.Visibility != Visibility.Visible) return;
            _band.Visibility = Visibility.Collapsed;
            UpdateRestore();
        }
    }

    // == Dialogs and Tooltips (internal) ==============================================================

    // Genie.ControlUtils.Confirm and Choose: a small owned window, run modally. An HwndSource like GenieWindow, never a
    // System.Windows.Window. The owner is disabled while it's open, as Windows does for its own message boxes.
    internal static class GenieDialog {
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern bool SetWindowTextW(IntPtr hwnd, string text);

        private const int  WM_DESTROY          = 0x0002;
        private const int  WS_POPUP            = unchecked((int)0x80000000);
        private const int  WS_CAPTION          = 0x00C00000;
        private const int  WS_SYSMENU          = 0x00080000;
        private const int  WS_CLIPCHILDREN     = 0x02000000;
        private const int  WS_EX_DLGMODALFRAME = 0x1;
        private const int  WM_CLOSE            = 0x0010;
        private const int  SW_SHOW             = 5;
        private const uint SWP_NOSIZE          = 0x1;
        private const uint SWP_NOZORDER        = 0x4;
        private const uint SWP_NOACTIVATE      = 0x10;

        private struct RECT {
            public int Left, Top, Right, Bottom;
        }

        [DllImport("user32.dll")]
        private static extern bool EnableWindow(IntPtr h, bool enable);
        [DllImport("user32.dll")]
        private static extern IntPtr GetActiveWindow();
        [DllImport("user32.dll")]
        private static extern IntPtr SetActiveWindow(IntPtr h);
        [DllImport("user32.dll")]
        private static extern bool GetWindowRect(IntPtr h, out RECT r);
        [DllImport("user32.dll")]
        private static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int cx, int cy, uint flags);
        [DllImport("user32.dll")]
        private static extern bool ShowWindow(IntPtr h, int cmd);
        [DllImport("user32.dll", CharSet = CharSet.Unicode)]
        private static extern int GetWindowTextW(IntPtr h, StringBuilder s, int max);
        [DllImport("comctl32.dll")]
        private static extern bool SetWindowSubclass(IntPtr h, MenuNative.SubclassProc proc, UIntPtr id, IntPtr data);
        [DllImport("comctl32.dll")]
        private static extern bool RemoveWindowSubclass(IntPtr h, MenuNative.SubclassProc proc, UIntPtr id);
        [DllImport("comctl32.dll")]
        private static extern IntPtr DefSubclassProc(IntPtr h, uint msg, IntPtr w, IntPtr l);

        // A dialog's modal loop runs on top of the editor's own, which can't go on until it returns: closing the
        // editor while one was open left the editor, and every addon window, waiting on it. So each open dialog
        // cancels when the editor's frame is asked to close (WM_CLOSE, the X or File > Exit), before the frame
        // handles it, and when its own window is destroyed under it. Watched through a subclass on the frame
        // while any dialog is open; id 3: the menu's is 1, the taskbar identity's 2.
        private static readonly List<Action> _cancels = new List<Action>(); // open dialogs, innermost last
        private static MenuNative.SubclassProc _frameProc; // static: the GC must not collect a live subclass
        private static IntPtr                  _frame;

        private static void WatchFrame(Action cancel) {
            _cancels.Add(cancel);
            if (_frame != IntPtr.Zero) return;
            IntPtr frame = Genie.WindowUtils.FindEditorFrame();
            if (frame == IntPtr.Zero) return;
            if (_frameProc == null) _frameProc = new MenuNative.SubclassProc(FrameProc);
            if (SetWindowSubclass(frame, _frameProc, new UIntPtr(3), IntPtr.Zero)) _frame = frame;
        }

        private static void UnwatchFrame(Action cancel) {
            _cancels.Remove(cancel);
            if (_cancels.Count > 0 || _frame == IntPtr.Zero) return;
            RemoveWindowSubclass(_frame, _frameProc, new UIntPtr(3));
            _frame = IntPtr.Zero;
        }

        private static IntPtr FrameProc(IntPtr h, uint msg, IntPtr w, IntPtr l, UIntPtr id, IntPtr data) {
            if (msg == WM_CLOSE)
                foreach (Action cancel in _cancels.ToArray()) cancel();
            return DefSubclassProc(h, msg, w, l);
        }

        // The index of the action chosen, or -1 for Cancel.
        // cancelText: the default button's label; "Cancel" unless given. windowTitle: the owner's title unless given,
        // which for the Content Browser is its internal "ContentBrowserHost".
        internal static int Show(Visual within, string question, string detail, string[] actions, object note,
                                 IEnumerable<UIElement> items, Genie.ControlUtils.TagTone tone, FrameworkElement icon,
                                 string cancelText = null, double maxWidth = 460, double listHeight = 220,
                                 Action<Button> onFirstAction = null, string windowTitle = null) {
            IntPtr owner = IntPtr.Zero;
            try {
                System.Windows.Interop.HwndSource ownerSrc =
                    (within == null) ? null
                                     : PresentationSource.FromVisual(within) as System.Windows.Interop.HwndSource;
                if (ownerSrc != null) owner = ownerSrc.Handle;
            } catch {}
            if (owner == IntPtr.Zero) owner = GetActiveWindow();
            StringBuilder title = new StringBuilder(256);
            if (owner != IntPtr.Zero) GetWindowTextW(owner, title, title.Capacity);

            int                               result = -1;
            DispatcherFrame                   frame  = new DispatcherFrame();
            System.Windows.Interop.HwndSource src    = null;

            // Content: icon | question, items, note (CreateDialogPanel); then the button strip.
            Genie.ControlUtils.ButtonTone goTone = (tone == Genie.ControlUtils.TagTone.Danger)
                                                       ? Genie.ControlUtils.ButtonTone.Danger
                                                       : Genie.ControlUtils.ButtonTone.Standard;

            Action<int> finish  = null;
            StackPanel  buttons = new StackPanel {
                Orientation         = Orientation.Horizontal,
                HorizontalAlignment = HorizontalAlignment.Right,
            };
            if (actions == null) actions = new[] { "OK" }; // empty: only the cancel button, as Inform
            for (int i = 0; i < actions.Length; i++) {
                int    index = i; // a for loop's i is one variable shared by every closure
                Button go =
                    Genie.ControlUtils.CreateButton(actions[i] ?? "OK", goTone, padding: new Thickness(16, 4, 16, 4));
                go.MinWidth  = 84;
                go.Click    += delegate {
                    finish(index);
                };
                buttons.Children.Add(go);
                if (i == 0 && onFirstAction != null) onFirstAction(go);
            }
            Button cancel =
                Genie.ControlUtils.CreateButton(cancelText ?? "Cancel", padding: new Thickness(16, 4, 16, 4));
            cancel.MinWidth   = 84;
            cancel.Margin     = new Thickness(0);
            cancel.IsDefault  = true;
            cancel.IsCancel   = true;
            cancel.Click     += delegate {
                finish(-1);
            };
            buttons.Children.Add(cancel);

            StackPanel body = new StackPanel();
            if (items != null) {
                StackPanel list = new StackPanel();
                foreach (UIElement item in items) {
                    FrameworkElement fe = item as FrameworkElement;
                    if (fe != null) fe.Margin = new Thickness(0, 0, 0, 4);
                    list.Children.Add(item);
                }
                // A long list scrolls rather than growing the dialog past the screen.
                if (list.Children.Count > 0)
                    body.Children.Add(new ScrollViewer {
                        Content                     = list,
                        MaxHeight                   = listHeight,
                        Margin                      = new Thickness(0, 10, 0, 0),
                        VerticalScrollBarVisibility = ScrollBarVisibility.Auto,
                        Focusable                   = false,
                    });
            }
            FrameworkElement noteText = note as FrameworkElement;
            if (noteText == null && note != null && note.ToString().Length > 0)
                noteText = Genie.ControlUtils.CreateParagraph(note.ToString());
            if (noteText != null) {
                noteText.Margin = new Thickness(0, 8, 0, 0);
                body.Children.Add(noteText);
            }
            FrameworkElement layout = Genie.ControlUtils.CreateDialogPanel(icon, question, detail, body, buttons);
            Border root = new Border { Child = layout, Background = SystemColors.WindowBrush, MinWidth = 360,
                                       MaxWidth = maxWidth };
            root.Resources[SystemParameters.VerticalScrollBarWidthKey] = Genie.Theme.ScrollBarThickness;

            // The window.
            System.Windows.Interop.HwndSourceParameters p = new System.Windows.Interop.HwndSourceParameters(
                windowTitle ?? (title.Length > 0 ? title.ToString() : "Addons"));
            p.WindowStyle         = WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN;
            p.ExtendedWindowStyle = WS_EX_DLGMODALFRAME;
            p.ParentWindow        = owner; // owned (no WS_CHILD): stays above its owner
            p.Width               = 1;
            p.Height              = 1;
            p.HwndSourceHook      = delegate(IntPtr h, int msg, IntPtr w, IntPtr l, ref bool handled) {
                if (msg == WM_DESTROY) {
                    finish(-1); // destroyed with its owner: nothing is left to answer
                } else if (msg == WM_CLOSE) {
                    handled = true;
                    finish(-1); // the title bar's X cancels
                }
                return IntPtr.Zero;
            };
            src               = new System.Windows.Interop.HwndSource(p);
            src.SizeToContent = SizeToContent.WidthAndHeight;
            src.RootVisual    = root;
            try {
                src.CompositionTarget.BackgroundColor = SystemColors.WindowColor;
            } catch {}
            WindowIcon.Apply(src.Handle);
            if (windowTitle != null) SetWindowTextW(src.Handle, windowTitle);

            bool closed = false;
            finish      = delegate(int chosen) {
                if (closed) return;
                closed = true;
                result = chosen;
                // Re-enable the owner before the dialog goes, so Windows hands activation back to it.
                if (owner != IntPtr.Zero) {
                    EnableWindow(owner, true);
                    SetActiveWindow(owner);
                }
                frame.Continue = false;
            };

            // Centre over the owner (or leave where Windows put it), then show modally.
            RECT o, d;
            if (owner != IntPtr.Zero && GetWindowRect(owner, out o) && GetWindowRect(src.Handle, out d)) {
                int w = d.Right - d.Left, h = d.Bottom - d.Top;
                SetWindowPos(src.Handle, IntPtr.Zero, o.Left + ((o.Right - o.Left) - w) / 2,
                             o.Top + ((o.Bottom - o.Top) - h) / 2, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
            }
            if (owner != IntPtr.Zero) EnableWindow(owner, false);
            ShowWindow(src.Handle, SW_SHOW);
            SetActiveWindow(src.Handle);
            cancel.Focus();
            Action cancelForEditor = delegate {
                finish(-1);
            };
            WatchFrame(cancelForEditor);
            try {
                Dispatcher.PushFrame(frame);
            } finally {
                UnwatchFrame(cancelForEditor);
                if (!closed && owner != IntPtr.Zero) EnableWindow(owner, true);
                src.Dispose();
            }
            return result;
        }
    }

    // The themed tooltip (Genie.ControlUtils.SetToolTip). An ordinary ToolTip whose template is bare, so the card,
    // pointer and shadow are its content. WPF places it above the element (Placement Top), or below when there's no
    // room; once it's open we centre it and move the pointer to face the element.
    internal static class GenieToolTip {
        private const double ShadowRoom = 5; // margin around the card for its shadow; also the gap to the element
        [ThreadStatic]
        private static ControlTemplate _bare;

        // Per thread, as tooltips are: pill windows have their own.
        [ThreadStatic]
        private static DispatcherTimer _reopen;
        [ThreadStatic]
        private static DependencyObject _reopening;

        private static readonly DependencyProperty ClosedOnLeaveProperty = DependencyProperty.RegisterAttached(
            "GenieToolTipClosedOnLeave", typeof(bool), typeof(GenieToolTip), new PropertyMetadata(false));

        // What Set was given, since ToolTip holds the built card.
        private static readonly DependencyProperty ContentProperty =
            DependencyProperty.RegisterAttached("GenieToolTipContent", typeof(object), typeof(GenieToolTip));

        // element: a FrameworkElement, or a FrameworkContentElement such as a Run (GenieParagraph's tags).
        internal static object Get(DependencyObject element) {
            return element == null ? null : element.GetValue(ContentProperty);
        }

        internal static void Set(DependencyObject element, object content) {
            IInputElement input = element as IInputElement;
            if (input == null) return;
            element.SetValue(ContentProperty, content);
            input.MouseLeave -= CloseOnLeave; // Set can run again on the same element
            input.MouseEnter -= ReopenOnEnter;
            if (content == null) {
                ToolTipService.SetToolTip(element, null);
                return;
            }
            input.MouseLeave += CloseOnLeave;
            input.MouseEnter += ReopenOnEnter;

            // A zero-width space after each backslash lets a long path wrap at folder boundaries only.
            UIElement body = content as UIElement ?? new TextBlock {
                Text         = content.ToString().Replace("\\", "\\\u200B"),
                FontSize     = Genie.Theme.FontSizeTag + 0.5,
                Foreground   = Genie.Theme.TextPrimary,
                TextWrapping = TextWrapping.Wrap,
                MaxWidth     = 320,
            };
            Border card = new Border {
                Child               = body,
                Background          = Genie.Theme.ToolTipBackground,
                BorderBrush         = Genie.Theme.ToolTipBorder,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(5),
                Padding             = new Thickness(9, 4, 9, 5),
                SnapsToDevicePixels = true,
                Effect =
                    new System.Windows.Media.Effects.DropShadowEffect {
                        BlurRadius  = 8,
                        ShadowDepth = 2,
                        Direction   = 270,
                        Opacity     = 0.12,
                        Color       = Colors.Black,
                    },
            };
            Canvas up = Pointer(false), down = Pointer(true);
            up.Visibility = Visibility.Collapsed;
            Grid root     = new Grid { Margin = new Thickness(ShadowRoom), Opacity = 0 };
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            Grid.SetRow(up, 0);
            Grid.SetRow(card, 1);
            Grid.SetRow(down, 2);
            root.Children.Add(card); // pointers after the card, so they cover its border where they join
            root.Children.Add(up);
            root.Children.Add(down);

            ToolTip tip = new ToolTip {
                Content         = root,
                Template        = Bare(),
                Placement       = System.Windows.Controls.Primitives.PlacementMode.Top,
                Background      = Brushes.Transparent,
                BorderThickness = new Thickness(0),
                Padding         = new Thickness(0),
                HasDropShadow   = false,
            };
            tip.Opened += delegate {
                Arrange(tip, root, up, down);
            };
            tip.Closed += delegate {
                root.Opacity = 0;
            };
            ToolTipService.SetToolTip(element, tip);
            ToolTipService.SetInitialShowDelay(element, Genie.Theme.ToolTipDelay);
            ToolTipService.SetShowOnDisabled(element, true);
        }

        // WPF's tooltip service misses the pointer leaving while a popup holds the mouse (a menu that closes on an
        // outside click), so the tooltip stayed up until the menu closed. The element's own MouseLeave still fires.
        private static void CloseOnLeave(object sender, System.Windows.Input.MouseEventArgs e) {
            DependencyObject element = (DependencyObject)sender;
            ToolTip          tip     = ToolTipService.GetToolTip(element) as ToolTip;
            if (_reopening == element) StopReopen();
            if (tip == null || !tip.IsOpen) return;
            tip.IsOpen = false;
            element.SetValue(ClosedOnLeaveProperty, true);
        }

        // The element can lose the pointer with no mouse move reaching the service (onto a border's last pixel), which
        // then still counts it as over the element and won't open the tip when it returns. So we do, after the usual
        // delay; if the service got there first, this changes nothing.
        private static void ReopenOnEnter(object sender, System.Windows.Input.MouseEventArgs e) {
            DependencyObject element = (DependencyObject)sender;
            if (!(bool)element.GetValue(ClosedOnLeaveProperty)) return;
            element.SetValue(ClosedOnLeaveProperty, false);
            StopReopen();
            _reopening    = element;
            _reopen       = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(Genie.Theme.ToolTipDelay) };
            _reopen.Tick += delegate {
                StopReopen();
                ToolTip       tip   = ToolTipService.GetToolTip(element) as ToolTip;
                IInputElement input = element as IInputElement;
                if (tip == null || tip.IsOpen || !input.IsMouseOver) return;
                if (element is UIElement) tip.PlacementTarget = (UIElement)element;
                tip.IsOpen = true;
            };
            _reopen.Start();
        }

        private static void StopReopen() {
            if (_reopen != null) _reopen.Stop();
            _reopen    = null;
            _reopening = null;
        }

        // Two steps, each after WPF has laid the popup out: centre it on the element, then face the pointer. A
        // PlacementRectangle, in the target's space, stands in for the element: a tag's piece of a paragraph.
        private static void Arrange(ToolTip tip, Grid root, Canvas up, Canvas down) {
            FrameworkElement target = tip.PlacementTarget as FrameworkElement;
            if (target == null) {
                root.Opacity = 1;
                return;
            }
            tip.Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)delegate {
                Rect area = tip.PlacementRectangle.IsEmpty ? new Rect(target.RenderSize) : tip.PlacementRectangle;
                tip.HorizontalOffset = area.Width / 2 - ShadowRoom - root.ActualWidth / 2;
                tip.Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)delegate {
                    try {
                        PresentationSource src = PresentationSource.FromVisual(root);
                        if (src != null && PresentationSource.FromVisual(target) != null) {
                            Matrix toDevice = src.CompositionTarget.TransformToDevice;
                            Point  t        = target.PointToScreen(new Point(area.Left + area.Width / 2, area.Top));
                            Point  r        = root.PointToScreen(new Point(0, 0));
                            bool   above    = r.Y < t.Y;
                            up.Visibility   = above ? Visibility.Collapsed : Visibility.Visible;
                            down.Visibility = above ? Visibility.Visible : Visibility.Collapsed;
                            // Near a screen edge WPF slides the card along, so the pointer follows the element.
                            double x = (t.X - r.X) / toDevice.M11;
                            x        = Math.Max(10, Math.Min(root.ActualWidth - 10, x));
                            Canvas.SetLeft(above ? down : up, 0);
                            foreach (UIElement p in (above ? down : up).Children) Canvas.SetLeft(p, x - 5);
                        }
                    } catch {} // placement is cosmetic; never let it break the tooltip
                    root.Opacity = 1;
                });
            });
        }

        // A 10 x 6 pointer: a border-coloured triangle with a white one inside, overlapping the card's edge by 1px.
        internal static Canvas Pointer(bool pointsDown) {
            Canvas c = new Canvas {
                Height           = 6,
                Margin           = pointsDown ? new Thickness(0, -1, 0, 0) : new Thickness(0, 0, 0, -1),
                IsHitTestVisible = false,
            };
            string outer = pointsDown ? "M 0,0 L 5,5.5 L 10,0 Z" : "M 0,6 L 5,0.5 L 10,6 Z";
            string inner = pointsDown ? "M 1,0 L 5,4.2 L 9,0 Z" : "M 1,6 L 5,1.8 L 9,6 Z";
            c.Children.Add(
                new System.Windows.Shapes.Path { Data = Geometry.Parse(outer), Fill = Genie.Theme.ToolTipBorder });
            c.Children.Add(
                new System.Windows.Shapes.Path { Data = Geometry.Parse(inner), Fill = Genie.Theme.ToolTipBackground });
            return c;
        }

        private static ControlTemplate Bare() {
            if (_bare != null) return _bare;
            ControlTemplate t = new ControlTemplate(typeof(ToolTip));
            t.VisualTree      = new FrameworkElementFactory(typeof(ContentPresenter));
            t.Seal();
            _bare = t;
            return t;
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateStatusPill.</summary>
    public sealed class GenieStatusPill : Border {
        private readonly TextBlock        _text, _action;
        private readonly FrameworkElement _spinner, _check, _info;
        private Action                    _onAction;
        private double                    _seconds;
        private readonly DispatcherTimer  _hold;
        private int                       _fades; // a fade's Completed acts only if no hover or show came since
        private const double              DoneSeconds = 3;
        private const double              FadeSeconds = 0.4;

        private readonly System.Windows.Media.RotateTransform _turn = new System.Windows.Media.RotateTransform(0, 7, 7);

        internal GenieStatusPill() {
            HorizontalAlignment = HorizontalAlignment.Right;
            VerticalAlignment   = VerticalAlignment.Bottom;
            Margin              = new Thickness(0, 0, 14, 10);
            Padding             = new Thickness(10, 5, 12, 5);
            CornerRadius        = new CornerRadius(14);
            BorderThickness     = new Thickness(1);
            IsHitTestVisible    = false;
            Focusable           = false;
            Visibility          = Visibility.Collapsed;
            SnapsToDevicePixels = true;
            Effect              = new System.Windows.Media.Effects.DropShadowEffect {
                BlurRadius = 8, ShadowDepth = 2, Direction = 270, Opacity = 0.10, Color = Colors.Black,
            };

            Canvas spin = new Canvas { Width = 14, Height = 14, RenderTransform = _turn };
            spin.Children.Add(new System.Windows.Shapes.Path {
                Data            = Geometry.Parse("M 7,1 A 6,6 0 1 1 6.99,1"),
                Stroke          = Genie.Theme.NeutralTagBorder,
                StrokeThickness = 2,
            });
            spin.Children.Add(new System.Windows.Shapes.Path {
                Data               = Geometry.Parse("M 7,1 A 6,6 0 0 1 13,7"),
                Stroke             = Genie.Theme.NeutralTagText,
                StrokeThickness    = 2,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
            });
            _spinner = spin;
            _check   = new System.Windows.Shapes.Path {
                Data = Geometry.Parse(
                    "M 7,0.75 A 6.25,6.25 0 1 1 7,13.25 A 6.25,6.25 0 1 1 7,0.75 Z M 4.2,7.2 L 6.2,9.2 L 9.8,5.4"),
                Stroke             = Genie.Theme.SuccessTagText,
                StrokeThickness    = 1.3,
                StrokeLineJoin     = PenLineJoin.Round,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
                Width              = 14,
                Height             = 14,
                Stretch            = Stretch.None,
            };
            _info = new System.Windows.Shapes.Path {
                Data = Geometry.Parse(
                    "M 7,0.75 A 6.25,6.25 0 1 1 7,13.25 A 6.25,6.25 0 1 1 7,0.75 Z M 7,6.2 L 7,10.2 M 7,3.9 L 7,4"),
                Stroke             = Genie.Theme.InfoTagText,
                StrokeThickness    = 1.3,
                StrokeStartLineCap = PenLineCap.Round,
                StrokeEndLineCap   = PenLineCap.Round,
                Width              = 14,
                Height             = 14,
                Stretch            = Stretch.None,
                Visibility         = Visibility.Collapsed,
            };
            _text = new TextBlock {
                FontSize          = Genie.Theme.FontSizeLabel,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(8, 0, 0, 0),
            };
            StackPanel row             = new StackPanel { Orientation = Orientation.Horizontal };
            _spinner.VerticalAlignment = VerticalAlignment.Center;
            _check.VerticalAlignment   = VerticalAlignment.Center;
            _info.VerticalAlignment    = VerticalAlignment.Center;
            row.Children.Add(_spinner);
            row.Children.Add(_check);
            row.Children.Add(_info);
            row.Children.Add(_text);
            _action                   = Genie.ControlUtils.CreateLink("", delegate {
                Action onAction = _onAction;
                Hide();
                if (onAction != null) onAction();
            });
            _action.Margin            = new Thickness(10, 0, 0, 0);
            _action.VerticalAlignment = VerticalAlignment.Center;
            _action.FontWeight        = FontWeights.SemiBold;
            _action.Visibility        = Visibility.Collapsed;
            row.Children.Add(_action);
            Child = row;

            _hold       = new DispatcherTimer();
            _hold.Tick += delegate {
                _hold.Stop();
                if (!IsHeld()) StartFade(); // held: MouseLeave starts the hold again
            };

            // An action stays while the pointer is on the pill, so it can't fade out from under a click.
            MouseEnter += delegate {
                if (_action.Visibility == Visibility.Visible) Hold();
            };
            MouseLeave += delegate {
                if (_action.Visibility == Visibility.Visible && Visibility == Visibility.Visible) Fade();
            };
        }

        /// <summary>Show the spinner and this text (call again to update it, e.g. with a count).</summary>
        public void ShowBusy(string text) {
            ClearAction();
            _text.Text = text ?? "";
            Hold();
            if (_spinner.Visibility != Visibility.Visible || Visibility != Visibility.Visible) {
                Background          = Genie.Theme.ToolTipBackground;
                BorderBrush         = Genie.Theme.NeutralTagBorder; // busy is grey: blue is for news (ShowInfo)
                _text.Foreground    = Genie.Theme.NeutralTagText;
                _spinner.Visibility = Visibility.Visible;
                _check.Visibility   = Visibility.Collapsed;
                _info.Visibility    = Visibility.Collapsed;
                BeginAnimation(OpacityProperty, null);
                Opacity    = 1;
                Visibility = Visibility.Visible;
                System.Windows.Media.Animation.DoubleAnimation spin =
                    new System.Windows.Media.Animation.DoubleAnimation(0, 360, new Duration(TimeSpan.FromSeconds(0.9)));
                spin.RepeatBehavior = System.Windows.Media.Animation.RepeatBehavior.Forever;
                _turn.BeginAnimation(System.Windows.Media.RotateTransform.AngleProperty, spin);
            }
        }

        /// <summary>Show a check and this text, then fade out after a few seconds.</summary>
        public void ShowDone(string text) {
            ShowDone(text, null, null, DoneSeconds);
        }

        /// <summary>
        /// Show a check, this text and a link (actionText) that hides the pill and calls onAction, then fade out after
        /// seconds; the pointer on the pill holds it. The pill takes clicks only while it shows an action. Example:
        /// Package Loader's "Deleted 'Content'." with Undo, for 8 seconds.
        /// </summary>
        public void ShowDone(string text, string actionText, Action onAction, double seconds = 8) {
            _onAction          = onAction;
            _action.Text       = actionText ?? "";
            _action.Visibility = string.IsNullOrEmpty(actionText) ? Visibility.Collapsed : Visibility.Visible;
            IsHitTestVisible   = _action.Visibility == Visibility.Visible;
            _seconds           = seconds;
            Settle(text, Genie.Theme.SuccessTagBackground, Genie.Theme.SuccessTagBorder, Genie.Theme.SuccessTagText,
                   _check);
        }

        /// <summary>Show an "i" and this text, then fade out: news that isn't a result ("Nothing to import").</summary>
        public void ShowInfo(string text) {
            ClearAction();
            _seconds = DoneSeconds;
            Settle(text, Genie.Theme.InfoTagBackground, Genie.Theme.InfoTagBorder, Genie.Theme.InfoTagText, _info);
        }

        private void Settle(string text, Brush fill, Brush edge, Brush ink, FrameworkElement icon) {
            _turn.BeginAnimation(System.Windows.Media.RotateTransform.AngleProperty, null);
            _text.Text          = text ?? "";
            _text.Foreground    = ink;
            Background          = fill;
            BorderBrush         = edge;
            _spinner.Visibility = Visibility.Collapsed;
            _check.Visibility   = (icon == _check) ? Visibility.Visible : Visibility.Collapsed;
            _info.Visibility    = (icon == _info) ? Visibility.Visible : Visibility.Collapsed;
            Visibility          = Visibility.Visible;

            Fade();
        }

        // Holds for _seconds, then fades and collapses. The hold is a timer, not the fade's BeginTime, so a hover
        // can cancel it outright.
        private void Fade() {
            Hold();
            _hold.Interval = TimeSpan.FromSeconds(_seconds);
            _hold.Start();
        }

        // Stops any hold or fade, fully shown. A fade still running holds opacity, so it's removed, not just left.
        private void Hold() {
            _hold.Stop();
            _fades++;
            BeginAnimation(OpacityProperty, null);
            Opacity = 1;
        }

        private void StartFade() {
            System.Windows.Media.Animation.DoubleAnimation fade = new System.Windows.Media.Animation.DoubleAnimation(
                1, 0, new Duration(TimeSpan.FromSeconds(FadeSeconds)));
            int token       = ++_fades;
            fade.Completed += delegate {
                if (token == _fades) Visibility = Visibility.Collapsed;
            };
            BeginAnimation(OpacityProperty, fade);
        }

        // The pointer on a pill with an action. Bounds as well as IsMouseOver, in case the pointer arrived without a
        // MouseEnter.
        private bool IsHeld() {
            if (_action.Visibility != Visibility.Visible) return false;
            if (IsMouseOver) return true;
            Point at = System.Windows.Input.Mouse.GetPosition(this);
            return at.X >= 0 && at.Y >= 0 && at.X < ActualWidth && at.Y < ActualHeight;
        }

        private void ClearAction() {
            _onAction          = null;
            _action.Visibility = Visibility.Collapsed;
            IsHitTestVisible   = false;
        }

        /// <summary>Hide it now.</summary>
        public void Hide() {
            ClearAction();
            Hold();
            _turn.BeginAnimation(System.Windows.Media.RotateTransform.AngleProperty, null);
            BeginAnimation(OpacityProperty, null);
            Visibility = Visibility.Collapsed;
        }
    }

    // The card a split or settings button opens under itself: right edges aligned, closed by any outside click.
    internal sealed class GenieMenuPopup {
        private const double ShadowRoom = 6;
        private const double Gap        = 2;

        // For a number item's box, as GeniePopover: typing goes through the editor's message loop (WxKeyboard).
        private static readonly System.Windows.Interop.HwndSourceHook KeysHook = WxKeyboard.Hook;
        private System.Windows.Interop.HwndSource                     _hooked;

        internal readonly StackPanel Items = new StackPanel();

        private readonly FrameworkElement _target;
        private readonly Border           _card;
        private readonly System.Windows.Controls.Primitives.Popup _popup;
        private DateTime                                          _closedAt;

        internal GenieMenuPopup(FrameworkElement target) {
            _target = target;
            _card   = new Border {
                Child               = Items,
                Background          = Genie.Theme.ToolTipBackground,
                BorderBrush         = Genie.Theme.ToolTipBorder,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(6),
                Padding             = new Thickness(0, 4, 0, 4),
                Margin              = new Thickness(ShadowRoom),
                SnapsToDevicePixels = true,
                Effect =
                    new System.Windows.Media.Effects.DropShadowEffect {
                        BlurRadius  = 10,
                        ShadowDepth = 3,
                        Direction   = 270,
                        Opacity     = 0.14,
                        Color       = Colors.Black,
                    },
            };
            _popup = new System.Windows.Controls.Primitives.Popup {
                Child                        = _card,
                PlacementTarget              = target,
                Placement                    = System.Windows.Controls.Primitives.PlacementMode.Custom,
                CustomPopupPlacementCallback = Place,
                StaysOpen                    = false,
                AllowsTransparency           = true,
            };
            _popup.Opened += delegate {
                System.Windows.Interop.HwndSource src =
                    PresentationSource.FromVisual(_card) as System.Windows.Interop.HwndSource;
                if (src != null && src != _hooked) {
                    src.AddHook(KeysHook);
                    _hooked = src;
                }
                if (Opened != null) Opened();
            };
            _popup.Closed += delegate {
                _closedAt = DateTime.Now;
                if (Closed != null) Closed();
            };
        }

        internal event Action Opened, Closed;

        internal void Open() {
            // A click that just closed the menu (it closes on any outside click, the button included) mustn't
            // reopen it.
            if (!_popup.IsOpen && (DateTime.Now - _closedAt).TotalMilliseconds > 200) _popup.IsOpen = true;
        }

        internal void Close() {
            _popup.IsOpen = false;
        }

        // An entry that closes the menu, then runs action once it's gone (a window it opens must not land
        // under a menu still on screen).
        internal GenieMenuItem AddItem(Panel group, string title, string subtitle, Action action, bool monoSubtitle) {
            GenieMenuItem item      = new GenieMenuItem(title, subtitle, monoSubtitle);
            item.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                if (!item.IsEnabled) return;
                e.Handled = true;
                Close();
                item.Dispatcher.BeginInvoke((Action)delegate { action(); });
            };
            group.Children.Add(item);
            return item;
        }

        // The card's right edge under the target's, Gap below it, or above it when there's no room below. Custom
        // placement, because Bottom follows the Windows handedness setting, which flips which edges line up.
        // Sizes come from the card itself: WPF's popup size leaves out the card's margin (its shadow room), which
        // put the menu that much too far right. The callback works in device pixels, hence the scale.
        private System.Windows.Controls.Primitives.CustomPopupPlacement[] Place(Size popup, Size target, Point offset) {
            double scale  = (_target.ActualWidth > 0) ? target.Width / _target.ActualWidth : 1;
            double shadow = ShadowRoom * scale, gap = Gap * scale;
            double width  = (_card.DesiredSize.Width - 2 * ShadowRoom) * scale; // the card alone
            double height = (_card.DesiredSize.Height - 2 * ShadowRoom) * scale;
            double x      = target.Width - width - shadow; // the popup starts ShadowRoom left of the card
            return new System.Windows.Controls.Primitives.CustomPopupPlacement[] {
                new System.Windows.Controls.Primitives.CustomPopupPlacement(
                    new Point(x, target.Height + gap - shadow),
                    System.Windows.Controls.Primitives.PopupPrimaryAxis.Horizontal),
                new System.Windows.Controls.Primitives.CustomPopupPlacement(
                    new Point(x, -height - gap - shadow),
                    System.Windows.Controls.Primitives.PopupPrimaryAxis.Horizontal),
            };
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreatePopover. Show opens it under an element; Content can change while it's open,
    /// and it moves to fit.
    /// </summary>
    public sealed class GeniePopover {
        private const double ShadowRoom = 6;
        private const double Gap        = 1; // between the element and the pointer's tip

        // Typing in a popup goes through the editor's message loop too (WxKeyboard). Static: a window holds its hooks
        // weakly.
        private static readonly System.Windows.Interop.HwndSourceHook KeysHook = WxKeyboard.Hook;

        private readonly System.Windows.Controls.Primitives.Popup _popup;
        private readonly Grid                                     _root;
        private readonly Border                                   _card;
        private readonly Canvas                                   _up, _down;
        private System.Windows.Interop.HwndSource                 _hooked;
        private DateTime                                          _closedAt;

        /// <summary>Raised once it's on screen, to focus something in it.</summary>
        public event Action Opened;

        /// <summary>Raised when it closes: Close, a click outside it, or Escape.</summary>
        public event Action Closed;

        /// <summary>
        /// Raised on Escape, before it closes. Set Handled to keep it open, as to step back to the content before.
        /// Example: Package Renamer's shortcut, whose prompt goes back to its form.
        /// </summary>
        public event Action<System.ComponentModel.HandledEventArgs> EscapePressed;

        internal GeniePopover() {
            _card = new Border {
                Background          = Genie.Theme.ToolTipBackground,
                BorderBrush         = Genie.Theme.ToolTipBorder,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(6),
                Padding             = new Thickness(12, 10, 12, 10),
                SnapsToDevicePixels = true,
                Effect =
                    new System.Windows.Media.Effects.DropShadowEffect {
                        BlurRadius  = 10,
                        ShadowDepth = 3,
                        Direction   = 270,
                        Opacity     = 0.14,
                        Color       = Colors.Black,
                    },
            };
            _up              = GenieToolTip.Pointer(false);
            _down            = GenieToolTip.Pointer(true);
            _down.Visibility = Visibility.Collapsed;
            _root            = new Grid { Margin = new Thickness(ShadowRoom), Opacity = 0 };
            _root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            _root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            _root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            Grid.SetRow(_up, 0);
            Grid.SetRow(_card, 1);
            Grid.SetRow(_down, 2);
            _root.Children.Add(_card); // pointers after the card, so they cover its border where they join
            _root.Children.Add(_up);
            _root.Children.Add(_down);
            _root.PreviewKeyDown += delegate(object s, System.Windows.Input.KeyEventArgs e) {
                if (e.Key != System.Windows.Input.Key.Escape) return;
                e.Handled = true;
                System.ComponentModel.HandledEventArgs args = new System.ComponentModel.HandledEventArgs();
                if (EscapePressed != null) EscapePressed(args);
                if (!args.Handled) Close();
            };
            _root.SizeChanged += delegate {
                if (_popup.IsOpen) AimPointer(); // new content: the card moved
            };

            _popup = new System.Windows.Controls.Primitives.Popup {
                Child                        = _root,
                Placement                    = System.Windows.Controls.Primitives.PlacementMode.Custom,
                CustomPopupPlacementCallback = Place,
                StaysOpen                    = false,
                AllowsTransparency           = true,
            };
            _popup.Opened += delegate {
                OnOpened();
            };
            _popup.Closed += delegate {
                _closedAt     = DateTime.Now;
                _root.Opacity = 0;
                if (Closed != null) Closed();
            };
        }

        /// <summary>What the card shows.</summary>
        public UIElement Content {
            get { return _card.Child; }
            set { _card.Child = value; }
        }

        public bool IsOpen {
            get { return _popup.IsOpen; }
        }

        /// <summary>The element it points at, or null before the first Show.</summary>
        public FrameworkElement Target {
            get { return _popup.PlacementTarget as FrameworkElement; }
        }

        /// <summary>
        /// Opens under target, pointing at it, or above it if there's no room below; already open, moves to it.
        /// Right after a click outside closed it, Show does nothing: that click may have been on target itself, as a
        /// toggle, and must leave it shut.
        /// </summary>
        public void Show(FrameworkElement target) {
            if (target == null) return;
            if (!_popup.IsOpen && (DateTime.Now - _closedAt).TotalMilliseconds < 200) return;
            _popup.PlacementTarget = target;
            if (_popup.IsOpen)
                AimPointer();
            else
                _popup.IsOpen = true;
        }

        public void Close() {
            _popup.IsOpen = false;
        }

        private void OnOpened() {
            System.Windows.Interop.HwndSource src =
                PresentationSource.FromVisual(_root) as System.Windows.Interop.HwndSource;
            if (src != null && src != _hooked) {
                src.AddHook(KeysHook);
                _hooked = src;
            }
            AimPointer();
            if (Opened != null) Opened();
        }

        // Centred under the target, the card's own size: WPF's popup size leaves out the shadow room around it. The
        // callback works in device pixels, hence the scale.
        private System.Windows.Controls.Primitives.CustomPopupPlacement[] Place(Size popup, Size target, Point offset) {
            FrameworkElement t      = Target;
            double           scale  = (t != null && t.ActualWidth > 0) ? target.Width / t.ActualWidth : 1;
            double           shadow = ShadowRoom * scale, gap = Gap * scale;
            double           width  = (_root.DesiredSize.Width - 2 * ShadowRoom) * scale;
            double           height = (_root.DesiredSize.Height - 2 * ShadowRoom) * scale;
            double           x      = (target.Width - width) / 2 - shadow;
            return new System.Windows.Controls.Primitives.CustomPopupPlacement[] {
                new System.Windows.Controls.Primitives.CustomPopupPlacement(
                    new Point(x, target.Height + gap - shadow),
                    System.Windows.Controls.Primitives.PopupPrimaryAxis.Horizontal),
                new System.Windows.Controls.Primitives.CustomPopupPlacement(
                    new Point(x, -height - gap - shadow),
                    System.Windows.Controls.Primitives.PopupPrimaryAxis.Horizontal),
            };
        }

        // After WPF has placed it: the pointer on the side facing the target, under its centre. Near a screen edge
        // WPF slides the card along, so the pointer follows the target, not the card's middle.
        private void AimPointer() {
            _root.Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)delegate {
                FrameworkElement target = Target;
                try {
                    PresentationSource src = PresentationSource.FromVisual(_root);
                    if (target != null && src != null && PresentationSource.FromVisual(target) != null) {
                        Matrix toDevice  = src.CompositionTarget.TransformToDevice;
                        Point  t         = target.PointToScreen(new Point(target.ActualWidth / 2, 0));
                        Point  r         = _root.PointToScreen(new Point(0, 0));
                        bool   above     = r.Y < t.Y;
                        _up.Visibility   = above ? Visibility.Collapsed : Visibility.Visible;
                        _down.Visibility = above ? Visibility.Visible : Visibility.Collapsed;
                        double x         = (t.X - r.X) / toDevice.M11;
                        x                = Math.Max(12, Math.Min(_root.ActualWidth - 12, x));
                        foreach (UIElement p in (above ? _down : _up).Children) Canvas.SetLeft(p, x - 5);
                    }
                } catch {} // placement is cosmetic; never let it break the popover
                _root.Opacity = 1;
            });
        }
    }

    /// <summary>
    /// A small bordered tree of one item and the items under it (Genie.ControlUtils.CreateTreeBox): the root row,
    /// then child rows joined to it by elbow lines, the last one's line stopping at its own row. Each row is an icon
    /// (a package unless given), a monospace name at TextSize, cut short with the whole on hover, and an optional tag
    /// at the right. EmptyText stands in for no children; the children scroll past MaxChildrenHeight. Example: Package
    /// Renamer's prompt, a package under its new name and the loaded packages that use it. UI thread only.
    /// </summary>
    public sealed class GenieTreeBox : StackPanel {
        private const double ElbowInset   = 6;  // the elbow's line under the root's icon
        private const double ElbowWidth   = 18;
        private const double ElbowReach   = ElbowWidth - Genie.ControlUtils.BranchArmGap;
        private const double RowIconWidth = 20; // a row's icon and its gap to the name
        private const double NoteHeight   = 17;

        private readonly TextBlock      _caption;
        private readonly ContentControl _captionExtra;
        private readonly StackPanel     _captionLine;
        private readonly Border       _rootSlot = new Border();
        private readonly StackPanel   _children = new StackPanel();
        private readonly ScrollViewer _scroll;
        private readonly DockPanel    _empty;
        private readonly TextBlock    _emptyText;
        private readonly List<Canvas> _elbows = new List<Canvas>(); // one per child, in order
        private readonly List<Canvas> _noteRails = new List<Canvas>(); // under the last row, until a child follows
        private readonly double       _textSize, _rowHeight;

        internal GenieTreeBox(string caption, double textSize) {
            _textSize  = textSize;
            _rowHeight = Math.Max(Genie.Theme.TreeRowHeight, Math.Ceiling(textSize * 1.85)); // 25 at the default 13
            _caption      = Genie.ControlUtils.CreateCaption("");
            _captionExtra = new ContentControl {
                Focusable         = false,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(4, 0, 0, 0),
            };
            _captionLine = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 0, 0, 3) };
            _captionLine.Children.Add(_caption);
            _captionLine.Children.Add(_captionExtra);
            Children.Add(_captionLine);
            Caption = caption;

            _emptyText = new TextBlock {
                FontSize          = textSize - 0.5, // FontSizeBody at the default: plain text runs larger than code
                FontStyle         = FontStyles.Italic,
                Foreground        = Genie.Theme.TextSecondary,
                VerticalAlignment = VerticalAlignment.Center,
            };
            _empty = new DockPanel { Height = _rowHeight };
            Canvas emptyElbow = Elbow(true);
            DockPanel.SetDock(emptyElbow, Dock.Left);
            _empty.Children.Add(emptyElbow);
            _empty.Children.Add(_emptyText);
            _children.Children.Add(_empty);
            EmptyText = null;

            _scroll = new ScrollViewer {
                Content                       = _children,
                MaxHeight                     = 6 * _rowHeight,
                VerticalScrollBarVisibility   = ScrollBarVisibility.Auto,
                HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled,
            };
            _scroll.PreviewMouseWheel += PassWheelWhenIdle;
            StackPanel inside = new StackPanel();
            inside.Children.Add(_rootSlot);
            inside.Children.Add(_scroll);
            Children.Add(new Border {
                Child           = inside,
                Background      = Genie.Theme.PanelBackground,
                BorderBrush     = Genie.Theme.Separator,
                BorderThickness = new Thickness(1),
                CornerRadius    = new CornerRadius(Genie.Theme.BoxCornerRadius),
                Padding         = new Thickness(8, 4, 8, 4),
            });
        }

        // A ScrollViewer takes the wheel even with nothing to scroll, which would stop a list of these from scrolling.
        private void PassWheelWhenIdle(object sender, System.Windows.Input.MouseWheelEventArgs e) {
            if (e.Handled || _scroll.ScrollableHeight > 0) return;
            e.Handled = true;
            RaiseEvent(new System.Windows.Input.MouseWheelEventArgs(e.MouseDevice, e.Timestamp, e.Delta) {
                RoutedEvent = MouseWheelEvent,
                Source      = this,
            });
        }

        /// <summary>The caption above the box, shown in capitals. Null or empty: none.</summary>
        public string Caption {
            get { return _caption.Text; }
            set {
                _caption.Text       = string.IsNullOrEmpty(value) ? "" : value.ToUpperInvariant();
                _caption.Visibility = string.IsNullOrEmpty(value) ? Visibility.Collapsed : Visibility.Visible;
                UpdateCaptionLine();
            }
        }

        /// <summary>
        /// Your own element after the caption, such as a find icon for what the tree shows (CreateFindIcon).
        /// Example: SWF Porter's replace prompt.
        /// </summary>
        public UIElement CaptionExtra {
            get { return _captionExtra.Content as UIElement; }
            set {
                _captionExtra.Content = value;
                UpdateCaptionLine();
            }
        }

        private void UpdateCaptionLine() {
            bool any                 = _caption.Text.Length > 0 || _captionExtra.Content != null;
            _captionExtra.Visibility = _captionExtra.Content != null ? Visibility.Visible : Visibility.Collapsed;
            _captionLine.Visibility  = any ? Visibility.Visible : Visibility.Collapsed;
        }

        /// <summary>
        /// The line under the root while it has no children ("No loaded package uses it."). Null: none.
        /// </summary>
        public string EmptyText {
            get { return string.IsNullOrEmpty(_emptyText.Text) ? null : _emptyText.Text; }
            set {
                _emptyText.Text = value ?? "";
                UpdateEmpty();
            }
        }

        /// <summary>The names' font size, from CreateTreeBox.</summary>
        public double TextSize {
            get { return _textSize; }
        }

        /// <summary>How tall the children get before they scroll. Default: six rows.</summary>
        public double MaxChildrenHeight {
            get { return _scroll.MaxHeight; }
            set { _scroll.MaxHeight = value; }
        }

        /// <summary>
        /// The top row, replacing any before it. icon: null for a package; showIcon false for none. tag: at the
        /// right, a tag or several things in a row (ControlUtils.CreateButtonRow), or null. bold: the name in bold,
        /// as the item the tree is about. Returns the row.
        /// </summary>
        public FrameworkElement SetRoot(string name, FrameworkElement icon = null, FrameworkElement tag = null,
                                        bool bold = true, bool showIcon = true) {
            DockPanel row   = Row(name, RowIcon(icon, showIcon), tag, bold, null);
            _rootSlot.Child = row;
            return row;
        }

        /// <summary>
        /// A row under the root, after the others. icon, tag and showIcon: as SetRoot's. lead: muted text before the
        /// name, such as its folder ("gfxAlerts\"). Returns the row.
        /// </summary>
        public FrameworkElement AddChild(string name, FrameworkElement icon = null, FrameworkElement tag = null,
                                         string lead = null, bool showIcon = true) {
            if (_elbows.Count > 0) Redraw(_elbows[_elbows.Count - 1], false); // no longer the last
            foreach (Canvas rail in _noteRails) rail.Children.Add(Stroke(0, 0, 0, rail.Height));
            _noteRails.Clear();
            Canvas    elbow = Elbow(true);
            DockPanel row   = Row(name, RowIcon(icon, showIcon), tag, false, lead);
            DockPanel line  = new DockPanel { Height = _rowHeight };
            DockPanel.SetDock(elbow, Dock.Left);
            line.Children.Add(elbow);
            line.Children.Add(row);
            _elbows.Add(elbow);
            _children.Children.Add(line);
            UpdateEmpty();
            return row;
        }

        /// <summary>
        /// A line of small text under the row added last, lined up with its name, cut short with the whole on hover.
        /// color: the note grey unless given. Example: what's wrong with a dependency in the Open packages report.
        /// </summary>
        public void AddNote(string text, Brush color = null) {
            bool   underChild = _elbows.Count > 0;
            Canvas rail       = new Canvas {
                Width  = underChild ? ElbowWidth : RowIconWidth - ElbowInset,
                Height = NoteHeight,
                Margin = new Thickness(ElbowInset, 0, 0, 0),
            };
            _noteRails.Add(rail);
            TextBlock note    = Genie.ControlUtils.CreateNoteText(text);
            note.TextWrapping = TextWrapping.NoWrap;
            note.TextTrimming = TextTrimming.CharacterEllipsis;
            note.Margin       = new Thickness(underChild ? RowIconWidth : 0, 0, 0, 0);
            if (color != null) note.Foreground = color;
            Genie.ControlUtils.SetToolTip(note, text);
            DockPanel line = new DockPanel { Height = NoteHeight };
            DockPanel.SetDock(rail, Dock.Left);
            line.Children.Add(rail);
            line.Children.Add(note);
            _children.Children.Add(line);
        }

        /// <summary>Removes every child row, leaving the root.</summary>
        public void ClearChildren() {
            _children.Children.Clear();
            _children.Children.Add(_empty);
            _elbows.Clear();
            _noteRails.Clear();
            UpdateEmpty();
        }

        private void UpdateEmpty() {
            bool show         = _elbows.Count == 0 && !string.IsNullOrEmpty(_emptyText.Text);
            _empty.Visibility = show ? Visibility.Visible : Visibility.Collapsed;
        }

        // A row's icon as asked: a package unless given, or none.
        private static FrameworkElement RowIcon(FrameworkElement icon, bool showIcon) {
            if (!showIcon) return null;
            return icon ?? Genie.ControlUtils.CreatePackageIcon();
        }

        // [icon] lead name ... [tag]. icon: null for none, the name then meeting the elbow.
        private DockPanel Row(string name, FrameworkElement icon, FrameworkElement tag, bool bold, string lead) {
            DockPanel row = new DockPanel { Height = _rowHeight };
            if (icon != null) {
                icon.Margin            = new Thickness(0, 0, 6, 0);
                icon.VerticalAlignment = VerticalAlignment.Center;
                DockPanel.SetDock(icon, Dock.Left);
                row.Children.Add(icon);
            }
            if (tag != null) {
                tag.Margin            = new Thickness(8, 0, 0, 0);
                tag.VerticalAlignment = VerticalAlignment.Center;
                DockPanel.SetDock(tag, Dock.Right);
                row.Children.Add(tag);
            }
            TextBlock text         = Genie.ControlUtils.CreateMonoText(name ?? "", _textSize);
            text.Margin            = new Thickness(0);
            text.FontWeight        = bold ? FontWeights.SemiBold : FontWeights.Normal;
            text.TextTrimming      = TextTrimming.CharacterEllipsis;
            text.VerticalAlignment = VerticalAlignment.Center;
            if (!string.IsNullOrEmpty(lead)) {
                text.Inlines.Clear();
                text.Inlines.Add(new System.Windows.Documents.Run(lead) { Foreground = Genie.Theme.TextSecondary });
                text.Inlines.Add(new System.Windows.Documents.Run(name ?? ""));
            }
            Genie.ControlUtils.SetToolTip(text, (lead ?? "") + name);
            row.Children.Add(text);
            return row;
        }

        // The line down from the row above and the arm out to this row. last: the line stops at the arm.
        private Canvas Elbow(bool last) {
            Canvas elbow = new Canvas {
                Width  = ElbowWidth,
                Height = _rowHeight,
                Margin = new Thickness(ElbowInset, 0, 0, 0),
            };
            Redraw(elbow, last);
            return elbow;
        }

        private void Redraw(Canvas elbow, bool last) {
            double h = _rowHeight;
            elbow.Children.Clear();
            elbow.Children.Add(Stroke(0, 0, 0, last ? h / 2 : h));
            elbow.Children.Add(Stroke(0, h / 2, ElbowReach, h / 2));
        }

        // Half a pixel in, so a 1px line falls on one pixel.
        private static System.Windows.Shapes.Line Stroke(double x1, double y1, double x2, double y2) {
            return new System.Windows.Shapes.Line {
                X1              = x1 + 0.5,
                Y1              = y1,
                X2              = x2 + 0.5,
                Y2              = y2,
                Stroke          = Genie.Theme.BranchLine,
                StrokeThickness = 1,
            };
        }
    }

    /// <summary>
    /// A row of icon buttons in one of the Content Browser's headers: ContentBrowserUtils.PackagesTray. Sorted by
    /// Order, lowest left; ties keep the order added. What doesn't fit goes under a « button at the left end, lowest
    /// orders first. A GENIE tab sits above it. The user can hide the whole tray, buttons and all (Addons > Options >
    /// Show Package Toolbar), which is no addon's to change. UI thread only.
    /// </summary>
    public sealed class GenieTray {
        private static readonly List<GenieTray> _all = new List<GenieTray>();
        internal static bool                    Shown = true;

        private readonly List<GenieTrayButton> _buttons = new List<GenieTrayButton>();
        private readonly Action                _requestAttach;
        private int                            _added;
        internal readonly TrayView             View;

        /// <summary>Raised once, when the tray first shows in the browser.</summary>
        public event Action Attached;

        internal GenieTray(Action requestAttach) {
            _requestAttach = requestAttach;
            View           = new TrayView(this);
            _all.Add(this);
        }

        /// <summary>
        /// A new button. iconData: path geometry in a 16px box, drawn as strokes. tooltip: what a click does, or why it
        /// can't; keep it current (GenieTrayButton.Tooltip).
        /// </summary>
        public GenieTrayButton AddButton(string iconData, string tooltip, int order = 0,
                                         [CallerFilePath] string callerFile = null) {
            GenieTrayButton button = new GenieTrayButton(this, iconData, tooltip, order, _added++);
            button.Owner           = AddonRegistry.AssemblyOf(callerFile);
            _buttons.Add(button);
            Reorder();
            _requestAttach();
            return button;
        }

        /// <summary>
        /// Your addon's button, as AddButton, shown per its "Show tray shortcut" setting: ShowTrayShortcut in your
        /// settings file, default on, an item under Addons > Options > your addon, and a checkbox in any window's gear
        /// that adds it (GenieSettingsButton.AddTrayShortcutItem). The setting sets the button's Visibility, so leave
        /// that alone; react with GenieTrayButton.ShownChanged. One per addon, made in Initialize.
        /// </summary>
        public GenieTrayButton AddShortcut(string iconData, string tooltip, int order = 0,
                                           [CallerFilePath] string callerFile = null) {
            Assembly        owner  = AddonRegistry.AssemblyOf(callerFile);
            GenieToggle     shown  = ShortcutToggle(owner);
            GenieTrayButton button = AddButton(iconData, tooltip, order);
            button.Owner           = owner; // AddButton saw this file as its caller
            button.FollowShown(shown);
            if (!_shortcutOwners.Contains(owner)) {
                _shortcutOwners.Add(owner);
                Genie.MenuUtils.AddCheck("Show Tray Shortcut", ShortcutHelp, shown, 0, callerFile);
            }
            return button;
        }

        internal const string ShortcutHelp = "Show its button in the package toolbar";

        private static readonly List<Assembly> _shortcutOwners = new List<Assembly>(); // each has its Options item

        internal static GenieToggle ShortcutToggle(Assembly owner) {
            return GenieToggle.For(owner, "ShowTrayShortcut", true, Genie.ConfigUtils.DefaultSection);
        }

        // AddonFaults turning an addon off: its buttons leave every tray.
        internal static void RemoveButtonsOf(Assembly owner) {
            foreach (GenieTray tray in _all.ToArray()) {
                foreach (GenieTrayButton b in tray._buttons.ToArray()) {
                    if (b.Owner == owner) tray.Remove(b);
                }
            }
        }

        public void Remove(GenieTrayButton button) {
            if (!_buttons.Remove(button)) return;
            button.Detach();
            View.Relayout();
        }

        /// <summary>In display order, hidden ones included.</summary>
        public IList<GenieTrayButton> Buttons {
            get { return _buttons.AsReadOnly(); }
        }

        /// <summary>False until the browser is up, and for good if its header wasn't found (logged).</summary>
        public bool IsAttached { get; private set; }

        internal void OnAttached() {
            if (IsAttached) return;
            IsAttached     = true;
            Action handler = Attached;
            if (handler != null) handler();
        }

        internal void Reorder() {
            _buttons.Sort(delegate(GenieTrayButton x, GenieTrayButton y) {
                return x.Order != y.Order ? x.Order.CompareTo(y.Order) : x.Sequence.CompareTo(y.Sequence);
            });
            View.Relayout();
        }

        internal static void SetShown(bool shown) {
            Shown = shown;
            foreach (GenieTray tray in _all) tray.View.Relayout();
        }
    }

    // A tray on screen: a dark box holding the « button and the buttons that fit, the GENIE tab above it. Collapsed
    // while the user hides trays, or while no button shows. It takes no height in the header: the box is taller than
    // the header's own row, which grew to fit it, so the view is a line of no height at the box's top, which
    // PackagesTrayHost places to centre the box on the switch. The box hangs below the line, the tab above it.
    // Buttons are taken out of the row, not hidden, when they don't fit: Visibility stays the addon's. The room it
    // may take is what its panel leaves it, less the natural width of the siblings after it (the header's title),
    // read from the last pass.
    internal sealed class TrayView : Grid {
        private const double Slot     = 26; // a button and its 2px gap
        private const double MoreSlot = 18;
        private const double Chrome   = 4;  // the box's border and right padding
        private const double TitleGap = 8;  // clear of the header's title
        private const double TabRise  = 10; // the tab's height less the box border it covers
        private const string MoreIcon = "M 7,4 L 4,8 L 7,12 M 11,4 L 8,8 L 11,12";

        private readonly GenieTray             _tray;
        private readonly Border                _tab, _box;
        private readonly Canvas                _above; // the tab's zero-size host, at the box's top
        private readonly StackPanel            _row = new StackPanel { Orientation = Orientation.Horizontal };
        private readonly GenieTrayButton       _more;
        private readonly GenieMenuPopup        _menu;
        private readonly List<GenieTrayButton> _overflow = new List<GenieTrayButton>();
        private double                         _room = double.PositiveInfinity;
        private int                            _shown = -1;
        private bool                           _relayoutQueued;

        internal TrayView(GenieTray tray) {
            _tray = tray;

            _box = new Border {
                Child           = _row,
                Background      = Genie.Theme.TrayBackground,
                BorderBrush     = Genie.Theme.TrayBorder,
                BorderThickness = new Thickness(1),
                CornerRadius    = new CornerRadius(0, 3, 3, 3),
                Padding         = new Thickness(0, 1, 2, 1),
            };
            Children.Add(_box);

            TextBlock label = new TextBlock {
                Text              = "GENIE",
                FontSize          = 8,
                FontWeight        = FontWeights.Bold,
                Foreground        = Genie.Theme.TrayLabel,
                VerticalAlignment = VerticalAlignment.Center,
            };
            _tab = new Border {
                Child           = label,
                Height          = TabRise + 1,
                Padding         = new Thickness(5, 0, 5, 0),
                Background      = Genie.Theme.TrayBackground,
                BorderBrush     = Genie.Theme.TrayBorder,
                BorderThickness = new Thickness(1, 1, 1, 0),
                CornerRadius    = new CornerRadius(3, 3, 0, 0),
                Cursor          = System.Windows.Input.Cursors.Hand,
            };
            _tab.MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled = true;
                FrameworkWindows.ShowAbout();
            };
            Genie.ControlUtils.SetToolTip(_tab, "About AddonGenie");
            _above = new Canvas();
            Canvas.SetTop(_tab, -TabRise);
            _above.Children.Add(_tab);
            Children.Add(_above); // after the box, so the tab covers its top border

            // The header behind is a Button: left clicks anywhere on the tray stop here.
            System.Windows.Input.MouseButtonEventHandler keep =
                delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled = true;
                };
            MouseLeftButtonDown += keep;
            MouseLeftButtonUp   += keep;

            _more        = new GenieTrayButton(null, MoreIcon, "More addon buttons", 0, -1) { Width = 16 };
            _menu        = new GenieMenuPopup(_more);
            _more.Click += OpenOverflow;
            Relayout();
        }

        protected override Size MeasureOverride(Size available) {
            Panel host = VisualTreeHelper.GetParent(this) as Panel;
            if (host != null && !double.IsInfinity(available.Width)) {
                double after = 0;
                bool   past  = false;
                foreach (UIElement sibling in host.Children) {
                    if (past) after += sibling.DesiredSize.Width;
                    if (sibling == this) past = true;
                }
                SetRoom(available.Width - after - TitleGap);
            }
            _box.Measure(new Size(available.Width, double.PositiveInfinity));
            _above.Measure(new Size(0, 0));
            return new Size(_box.DesiredSize.Width, 0); // as wide as the box, no height
        }

        // The box below this view's line and the tab's canvas on it. Children drawn outside a parent aren't clipped
        // by it, so the box shows in full, as the tab always has.
        protected override Size ArrangeOverride(Size final) {
            Size box = _box.DesiredSize;
            _box.Arrange(new Rect(0, 0, box.Width, box.Height));
            _above.Arrange(new Rect(0, 0, 0, 0));
            return new Size(final.Width, 0);
        }

        /// <summary>The box's height, which the header doesn't make room for. 0 until measured.</summary>
        internal double BoxHeight {
            get { return _box.DesiredSize.Height; }
        }

        // A change in what fits is applied after the layout pass that found it.
        private void SetRoom(double room) {
            _room = room;
            if (FitCount(VisibleButtons().Count) == _shown || _relayoutQueued) return;
            _relayoutQueued = true;
            Dispatcher.BeginInvoke(DispatcherPriority.Loaded, (Action)Relayout);
        }

        internal void Relayout() {
            _relayoutQueued               = false;
            List<GenieTrayButton> visible = VisibleButtons();
            _shown                        = FitCount(visible.Count);
            int hidden                    = visible.Count - _shown;
            _overflow.Clear();
            _overflow.AddRange(visible.GetRange(0, hidden));
            _row.Children.Clear();
            if (hidden > 0) _row.Children.Add(_more);
            for (int i = hidden; i < visible.Count; i++) _row.Children.Add(visible[i]);
            Visibility = GenieTray.Shown && _row.Children.Count > 0 ? Visibility.Visible : Visibility.Collapsed;
        }

        private List<GenieTrayButton> VisibleButtons() {
            return new List<GenieTrayButton>(_tray.Buttons).FindAll(b => b.Visibility == Visibility.Visible);
        }

        private int FitCount(int count) {
            if (double.IsInfinity(_room) || count * Slot + Chrome <= _room) return count;
            return Math.Max(0, Math.Min(count, (int)((_room - Chrome - MoreSlot) / Slot)));
        }

        private void OpenOverflow() {
            _menu.Items.Children.Clear();
            foreach (GenieTrayButton button in _overflow) {
                GenieTrayButton b    = button;
                GenieMenuItem   item = _menu.AddItem(_menu.Items, b.Tooltip, null, b.RaiseClick, false);
                item.IsEnabled       = b.Available;
            }
            _menu.Open();
        }
    }

    /// <summary>
    /// A button in a GenieTray (GenieTray.AddButton). Click is raised on a click while Available. Keep Tooltip
    /// current, including why it's unavailable. Collapse it (Visibility) to take it out of the row.
    /// </summary>
    public sealed class GenieTrayButton : Border {
        private static readonly Dictionary<Genie.ControlUtils.TrayTone, Brush[]> _tones =
            new Dictionary<Genie.ControlUtils.TrayTone, Brush[]>(); // icon, active fill, hover fill, hover edge

        private readonly System.Windows.Shapes.Path _icon, _fill;
        private readonly Border                     _badge;
        private readonly TextBlock                  _badgeText;
        private readonly System.Windows.Shapes.Ellipse _dot;
        private GenieTray                           _tray;
        private Genie.ControlUtils.TrayTone         _tone;
        private Genie.ControlUtils.TrayTone?        _badgeTone;
        private bool                                _isActive, _available = true, _badgeDot;
        private int                                 _order, _badgeCount;
        private string                              _tooltip, _fillData;
        internal readonly int                       Sequence;
        internal Assembly                           Owner; // the addon that added it

        public event Action Click;

        internal GenieTrayButton(GenieTray tray, string iconData, string tooltip, int order, int sequence) {
            _tray    = tray;
            _order   = order;
            Sequence = sequence;
            _fill    = IconPath(null);
            _fill.Opacity = 0.28;
            _icon    = IconPath(iconData);
            _badgeText = new TextBlock {
                FontSize            = 8,
                FontWeight          = FontWeights.Bold,
                Foreground          = Genie.Theme.TrayBadgeText,
                HorizontalAlignment = HorizontalAlignment.Center,
                VerticalAlignment   = VerticalAlignment.Center,
            };
            // Greyscale smoothing: ClearType's colour fringes smear digits this small on a coloured pill.
            System.Windows.Media.TextOptions.SetTextFormattingMode(_badgeText, TextFormattingMode.Display);
            System.Windows.Media.TextOptions.SetTextRenderingMode(_badgeText, TextRenderingMode.Grayscale);
            // 13 tall with room each side, so two or three digits don't touch the edge. The extra height goes up, clear
            // of the icon; the right overhang stays, as more would crowd the tree/list switch beside the tray.
            _badge = new Border {
                Child               = _badgeText,
                Height              = 13,
                MinWidth            = 13,
                Padding             = new Thickness(3, 0, 3, 0),
                CornerRadius        = new CornerRadius(6.5),
                BorderBrush         = Genie.Theme.TrayBadgeRing,
                BorderThickness     = new Thickness(1),
                HorizontalAlignment = HorizontalAlignment.Right,
                VerticalAlignment   = VerticalAlignment.Top,
                Margin              = new Thickness(0, -6, -5, 0),
                IsHitTestVisible    = false,
            };
            _dot = new System.Windows.Shapes.Ellipse {
                Width               = 7,
                Height              = 7,
                Stroke              = Genie.Theme.TrayBadgeRing,
                StrokeThickness     = 1,
                HorizontalAlignment = HorizontalAlignment.Right,
                VerticalAlignment   = VerticalAlignment.Top,
                Margin              = new Thickness(0, 0, 0, 0),
                IsHitTestVisible    = false,
            };
            Grid face = new Grid();
            face.Children.Add(_fill);
            face.Children.Add(_icon);
            face.Children.Add(_badge);
            face.Children.Add(_dot);
            Child             = face;
            Width             = 24;
            Height            = 22;
            CornerRadius      = new CornerRadius(3);
            BorderThickness   = new Thickness(1);
            Margin            = new Thickness(2, 0, 0, 0);
            VerticalAlignment = VerticalAlignment.Center;
            // Enabled always: a disabled element gets no mouse, so hover reached only the icon and the tooltip lingered
            // over the switch beside it. Available stands in for it.
            MouseEnter += delegate {
                Paint();
            };
            MouseLeave += delegate {
                Paint();
            };
            MouseLeftButtonUp += delegate(object s, System.Windows.Input.MouseButtonEventArgs e) {
                e.Handled = true;
                RaiseClick();
            };
            System.ComponentModel.DependencyPropertyDescriptor
                .FromProperty(VisibilityProperty, typeof(GenieTrayButton))
                .AddValueChanged(this, delegate {
                    if (_tray != null) _tray.View.Relayout();
                });
            Tooltip = tooltip;
            Paint();
        }

        /// <summary>The icon's color, hover tint and active fill. Default Neutral.</summary>
        public Genie.ControlUtils.TrayTone Tone {
            get { return _tone; }
            set {
                _tone = value;
                Paint();
            }
        }

        /// <summary>Optional path filled under the icon at 28%, so its main shape reads at a glance.</summary>
        public string FillData {
            get { return _fillData; }
            set {
                _fillData  = value;
                _fill.Data = string.IsNullOrEmpty(value) ? null : Geometry.Parse(value);
            }
        }

        /// <summary>A count in a pill at the top right, in BadgeTone: 1 to 999, "…" from 1000. 0: none.</summary>
        public int BadgeCount {
            get { return _badgeCount; }
            set {
                _badgeCount = Math.Max(0, value);
                Paint();
            }
        }

        /// <summary>
        /// The badge's color (BadgeCount's pill and BadgeDot), apart from the icon's: a neutral icon can carry a red
        /// or green count. Null, the default: Tone's.
        /// </summary>
        public Genie.ControlUtils.TrayTone? BadgeTone {
            get { return _badgeTone; }
            set {
                _badgeTone = value;
                Paint();
            }
        }

        /// <summary>A dot at the top right instead, for "something new". A BadgeCount wins over it.</summary>
        public bool BadgeDot {
            get { return _badgeDot; }
            set {
                _badgeDot = value;
                Paint();
            }
        }

        /// <summary>Shows it pressed, filled in its tone, such as while its popover is open.</summary>
        public bool IsActive {
            get { return _isActive; }
            set {
                _isActive = value;
                Paint();
            }
        }

        /// <summary>
        /// False: dimmed, no hover fill, clicks ignored, never shown active; hover and the tooltip still work, so it
        /// can say why. Use this, not IsEnabled. Default true.
        /// </summary>
        public bool Available {
            get { return _available; }
            set {
                _available = value;
                Paint();
            }
        }

        /// <summary>
        /// False while the user hides this shortcut (GenieTray.AddShortcut). Always true for other buttons.
        /// </summary>
        public bool IsShown {
            get { return _shown == null || _shown.Value; }
        }

        /// <summary>Raised when the user shows or hides this shortcut, after its Visibility follows.</summary>
        public event Action ShownChanged;

        private GenieToggle _shown;

        internal void FollowShown(GenieToggle shown) {
            _shown     = shown;
            Visibility = shown.Value ? Visibility.Visible : Visibility.Collapsed;
            shown.Changed += delegate(bool on) {
                Visibility     = on ? Visibility.Visible : Visibility.Collapsed;
                Action handler = ShownChanged;
                if (handler != null) handler();
            };
        }

        /// <summary>What a click does, or why it can't. Also its entry in the « menu.</summary>
        public string Tooltip {
            get { return _tooltip; }
            set {
                _tooltip = value ?? "";
                Genie.ControlUtils.SetToolTip(this, _tooltip);
            }
        }

        /// <summary>Lower sits further left; negatives further still. Ties keep the order added.</summary>
        public int Order {
            get { return _order; }
            set {
                _order = value;
                if (_tray != null) _tray.Reorder();
            }
        }

        internal void RaiseClick() {
            Action click = Click;
            if (_available && click != null) click();
        }

        internal void Detach() {
            _tray = null;
        }

        private static System.Windows.Shapes.Path IconPath(string data) {
            return new System.Windows.Shapes.Path {
                Data                = string.IsNullOrEmpty(data) ? null : Geometry.Parse(data),
                StrokeThickness     = 1.3,
                StrokeLineJoin      = PenLineJoin.Round,
                StrokeStartLineCap  = PenLineCap.Round,
                StrokeEndLineCap    = PenLineCap.Round,
                Width               = 16,
                Height              = 16,
                Stretch             = Stretch.None,
                HorizontalAlignment = HorizontalAlignment.Center,
                VerticalAlignment   = VerticalAlignment.Center,
            };
        }

        private void Paint() {
            Brush[] tone   = ToneBrushes(_tone);
            bool    active = _isActive && _available;
            bool    hot    = IsMouseOver && _available && !active;
            Background     = active ? tone[1] : hot ? tone[2] : Brushes.Transparent;
            BorderBrush    = active ? tone[1] : hot ? tone[3] : Brushes.Transparent;
            Brush ink      = active ? Genie.Theme.PrimaryButtonText : tone[0];
            _icon.Stroke   = ink;
            _fill.Fill     = ink;
            Opacity        = _available ? 1 : 0.4;
            Cursor         = _available ? System.Windows.Input.Cursors.Hand : System.Windows.Input.Cursors.Arrow;

            Brush badge          = _badgeTone.HasValue ? ToneBrushes(_badgeTone.Value)[0] : tone[0];
            _badge.Background    = badge;
            _badgeText.Text      = _badgeCount > 999 ? "…" : _badgeCount.ToString();
            _badge.Visibility    = _badgeCount > 0 ? Visibility.Visible : Visibility.Collapsed;
            _dot.Fill            = badge;
            _dot.Visibility      = (_badgeDot && _badgeCount == 0) ? Visibility.Visible : Visibility.Collapsed;
        }

        // Neutral hovers in greys; the others in their own color, faint fill and half-strength edge.
        private static Brush[] ToneBrushes(Genie.ControlUtils.TrayTone tone) {
            Brush[] brushes;
            if (_tones.TryGetValue(tone, out brushes)) return brushes;
            Brush ink, active;
            switch (tone) {
                case Genie.ControlUtils.TrayTone.Accent:
                    ink    = Genie.Theme.TrayAccent;
                    active = Genie.Theme.TrayAccentActive;
                    break;
                case Genie.ControlUtils.TrayTone.Success:
                    ink    = Genie.Theme.TraySuccess;
                    active = Genie.Theme.TraySuccessActive;
                    break;
                case Genie.ControlUtils.TrayTone.Warning:
                    ink    = Genie.Theme.TrayWarning;
                    active = Genie.Theme.TrayWarningActive;
                    break;
                case Genie.ControlUtils.TrayTone.Danger:
                    ink    = Genie.Theme.TrayDanger;
                    active = Genie.Theme.TrayDangerActive;
                    break;
                default:
                    ink    = Genie.Theme.TrayNeutral;
                    active = Genie.Theme.TrayNeutralActive;
                    break;
            }
            bool neutral = tone == Genie.ControlUtils.TrayTone.Neutral;
            brushes      = new Brush[] {
                ink, active, neutral ? Genie.Theme.TrayHoverBackground : Faded(ink, 0x29),
                neutral ? Genie.Theme.TrayHoverBorder : Faded(ink, 0x80),
            };
            _tones[tone] = brushes;
            return brushes;
        }

        private static Brush Faded(Brush brush, byte alpha) {
            Color           c     = ((SolidColorBrush)brush).Color;
            SolidColorBrush faded = new SolidColorBrush(Color.FromArgb(alpha, c.R, c.G, c.B));
            faded.Freeze();
            return faded;
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateSplitButton.</summary>
    public sealed class GenieSplitButton : StackPanel {
        /// <summary>The main part. Its Click is the split button's Click.</summary>
        public readonly Button Main;

        private readonly Button         _more;
        private readonly GenieMenuPopup _menu;

        internal GenieSplitButton(string text, Genie.ControlUtils.ButtonSize size, string tooltip, Thickness? padding,
                                  double? fontSize) {
            Orientation       = Orientation.Horizontal;
            VerticalAlignment = VerticalAlignment.Center;
            Margin            = new Thickness(0, 0, Genie.Theme.Spacing, 0);
            bool   small      = size == Genie.ControlUtils.ButtonSize.Small;
            double r          = Genie.Theme.ButtonCornerRadius;

            Main = Genie.ControlUtils.CreateButton(text, Genie.ControlUtils.ButtonTone.Standard, size, tooltip, padding,
                                                   null, fontSize);
            Main.Margin            = new Thickness(0);
            Main.VerticalAlignment = VerticalAlignment.Stretch; // both halves take the pair's height
            Main.BorderThickness   = new Thickness(1, 1, 0, 1);
            Genie.ControlUtils.SetCornerRadius(Main, new CornerRadius(r, 0, 0, r));
            Children.Add(Main);

            Thickness morePadding = new Thickness(small ? 5 : 7, 0, small ? 5 : 7, 0);
            _more = Genie.ControlUtils.CreateButton("", Genie.ControlUtils.ButtonTone.Standard, size, null, morePadding,
                                                    null, fontSize);
            _more.Content = new System.Windows.Shapes.Path {
                Data              = Geometry.Parse("M 0.5,0.5 L 4,4 L 7.5,0.5"),
                Stroke            = Genie.Theme.TextPrimary,
                StrokeThickness   = 1.3,
                Width             = 8,
                Height            = 5,
                Stretch           = Stretch.None,
                VerticalAlignment = VerticalAlignment.Center,
            };
            _more.Margin            = new Thickness(0);
            _more.VerticalAlignment = VerticalAlignment.Stretch;
            Genie.ControlUtils.SetCornerRadius(_more, new CornerRadius(0, r, r, 0));
            Children.Add(_more);

            _menu        = new GenieMenuPopup(this);
            _more.Click += delegate {
                _menu.Open();
            };
        }

        /// <summary>Whether the main part can be clicked. The ▾ menu stays available either way.</summary>
        public bool MainEnabled {
            get { return Main.IsEnabled; }
            set { Main.IsEnabled = value; }
        }

        /// <summary>The main part's Click.</summary>
        public event RoutedEventHandler Click {
            add {
                Main.Click += value;
            }
            remove {
                Main.Click -= value;
            }
        }

        /// <summary>A menu entry: a title, a muted line under it (monoSubtitle for paths), and what it does.</summary>
        public GenieMenuItem AddMenuItem(string title, string subtitle, Action onClick, bool monoSubtitle = false) {
            return _menu.AddItem(_menu.Items, title, subtitle, onClick, monoSubtitle);
        }

        public void ClearMenu() {
            _menu.Items.Children.Clear();
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateMenu.</summary>
