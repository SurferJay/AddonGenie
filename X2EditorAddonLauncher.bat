    public static partial class Genie {
        // == Genie.TweenUtils =========================================================================
        // Animations on WPF's own timelines, key frames and easing functions. Two kinds: cues draw the eye, then
        // repeat or settle (Cue); transitions take an element from one state to another once (FadeIn and the rest).
        // Spec: claude/Tween-spec.md.
        //
        // A cue never writes the target's own values. It pins its brushes (and a shake's transform) over the
        // properties with a zero-length animation, which outranks local values, styles and bindings; Stop takes the
        // pins off, so whatever was there shows again, even if its owner changed it meanwhile. Theme brushes are
        // frozen and shared, so a cue paints with brushes of its own. Transitions do write their end state
        // (Visibility; ColorTo's brush), as setting it by hand would.
        //
        // No tween changes layout. Each moves only how its target is drawn (opacity, a render transform, brushes), and
        // an Out ends Hidden, keeping its space: neighbours never move while one plays or when it ends.

        public static class TweenUtils {
            public enum CuePattern {
                Pulse,   // holds the tint, then lightens Dips times; repeats. A state that needs you
                Flash,   // Count flashes, then holds the tint. "This just changed"
                Breathe, // slow, continuous lightening and back. Working, waiting
                Blink,   // hard on and off. Loud, and a motion-discomfort risk: brief, urgent cues; set Repeat low
                Shake,   // Count short sideways nudges: a rejected input. Keep it short, for the same reason
            }

            [Flags]
            public enum TweenParts { Background = 1, Border = 2, Foreground = 4, Opacity = 8 }

            /// <summary>What a cue shows while Windows animations are off: its steady tint, or nothing.</summary>
            public enum CueFallback { Steady, None }

            /// <summary>Where Expand grows from and Collapse shrinks to: top/left, middle, bottom/right.</summary>
            public enum Origin { Start, Center, End }

            /// <summary>A cue's dip: Lighter, toward white; Darker, richer in the tone's own hue.</summary>
            public enum DipDirection { Lighter, Darker }

            /// <summary>How a cue looks and moves. Start from Pulse, Flash, Breathe or Shake and adjust.</summary>
            public sealed class CueOptions {
                // clang-format off: aligned as one table
                public CuePattern               Pattern      = CuePattern.Pulse;
                public TweenParts               Parts        = TweenParts.Background | TweenParts.Border;
                public Color?                   Color;           // the tint, every part; null: Tone's
                public ControlUtils.TagTone     Tone         = ControlUtils.TagTone.Caution; // a toned button's rest
                public Color?                   DipColor;        // null: the tint, lightened by Intensity
                public double                   Intensity    = 0.8;  // dip depth: share of the way there
                public DipDirection             Direction    = DipDirection.Lighter; // colours; Opacity only fades
                public TimeSpan                 Cycle        = TimeSpan.FromSeconds(5); // one cycle, flash or nudge
                public TimeSpan                 DipDuration  = TimeSpan.FromMilliseconds(450); // Pulse: down and back
                public int                      Dips         = 2;    // Pulse
                public int                      Count        = 3;    // Flash, Shake
                public RepeatBehavior           Repeat       = RepeatBehavior.Forever; // Pulse, Breathe, Blink
                public TimeSpan                 Delay        = TimeSpan.Zero;
                public IEasingFunction          Easing       = new SineEase { EasingMode = EasingMode.EaseInOut };
                public bool                     PauseOnHover = true; // also while it holds keyboard focus
                public bool                     StopOnClick;
                public CueFallback              Fallback     = CueFallback.Steady;
                // clang-format on

                /// <summary>Holds, lightens twice every 5 s. Restart it when what it points at grows.</summary>
                public static CueOptions Pulse(ControlUtils.TagTone tone) {
                    return new CueOptions { Tone = tone };
                }

                public static CueOptions Flash(ControlUtils.TagTone tone, int count = 3) {
                    return new CueOptions {
                        Pattern = CuePattern.Flash, Tone = tone, Count = count, Cycle = TimeSpan.FromMilliseconds(500),
                        PauseOnHover = false,
                    };
                }

                public static CueOptions Breathe(ControlUtils.TagTone tone) {
                    return new CueOptions {
                        Pattern = CuePattern.Breathe,
                        Tone    = tone,
                        Cycle   = TimeSpan.FromSeconds(3),
                    };
                }

                public static CueOptions Shake() {
                    return new CueOptions {
                        Pattern      = CuePattern.Shake,
                        Cycle        = TimeSpan.FromMilliseconds(120),
                        PauseOnHover = false,
                    };
                }
            }

            /// <summary>How a transition moves. Delay holds the start state: a delayed FadeIn stays hidden.</summary>
            public sealed class TransitionOptions {
                public TimeSpan        Duration = TimeSpan.FromMilliseconds(200);
                public TimeSpan        Delay    = TimeSpan.Zero;
                public IEasingFunction Easing   = new CubicEase { EasingMode = EasingMode.EaseOut };
            }

            /// <summary>A running cue or transition, made by Cue, FadeIn and the rest.</summary>
            public sealed class Tween {
                private readonly System.Windows.Threading.Dispatcher _dispatcher;
                private TweenRun                                     _run;
                private int                                          _starts; // Completed belongs to one start
                private bool                                         _completed;

                internal Tween(System.Windows.Threading.Dispatcher dispatcher) {
                    _dispatcher = dispatcher;
                }

                /// <summary>Not stopped and not past its end. Paused counts as running.</summary>
                public bool IsRunning {
                    get { return _run.IsRunning; }
                }

                /// <summary>
                /// Its end: a transition's or a finite cue's (Flash, Shake), or Stop. Once per start, after the call
                /// that ended it returns, so a handler added right after FadeIn still hears an instant end (Windows
                /// animations off). A transition replaced by another on its property never raises it.
                /// </summary>
                public event EventHandler Completed;

                public void Pause() {
                    _run.SetPaused(true);
                }

                public void Resume() {
                    _run.SetPaused(false);
                }

                /// <summary>From the start (a cue's cycle, a transition's start state), also after the end.</summary>
                public void Restart() {
                    NewStart();
                    _run.Restart();
                }

                /// <summary>A cue comes off, leaving what its owner set; a transition jumps to its end.</summary>
                public void Stop() {
                    _run.Stop();
                }

                internal void Begin(TweenRun run) {
                    _run = run;
                    NewStart();
                    run.Start();
                }

                internal void RaiseCompleted() {
                    if (_completed) return;
                    _completed = true;
                    int start  = _starts;
                    _dispatcher.BeginInvoke((Action)delegate {
                        if (start == _starts && Completed != null) Completed(this, EventArgs.Empty);
                    });
                }

                private void NewStart() {
                    _starts++;
                    _completed = false;
                }
            }

            // == Cues =================================================================================

            /// <summary>
            /// Starts a cue on target, replacing one already on it. Stops when target unloads; holds still while it's
            /// hidden. With Windows animations off it shows options.Fallback instead, following the setting live.
            /// </summary>
            public static Tween Cue(FrameworkElement target, CueOptions options) {
                if (target == null) return null;
                Tween old = target.GetValue(CueProperty) as Tween;
                if (old != null) old.Stop();
                Tween tween = new Tween(target.Dispatcher);
                target.SetValue(CueProperty, tween);
                tween.Begin(new CueRun(tween, target, options ?? new CueOptions()));
                return tween;
            }

            private static readonly DependencyProperty CueProperty =
                DependencyProperty.RegisterAttached("GenieCue", typeof(Tween), typeof(TweenUtils));

            // == Transitions ==========================================================================
            // A new transition on a property a running one holds takes over from its current value: a FadeOut during a
            // FadeIn turns around without a jump. Windows animations off: the end state at once, Completed still
            // raised, so chained code runs. Stop and unloading jump to the end state.

            /// <summary>Shows target and fades it in, to its own opacity.</summary>
            public static Tween FadeIn(FrameworkElement target, TransitionOptions options = null) {
                return Transition(target, options, new TransitionRun.Spec { Kind = TransitionKind.FadeIn });
            }

            /// <summary>Shows target at its own opacity, fades it out, hides it. Its opacity is kept.</summary>
            public static Tween FadeOut(FrameworkElement target, TransitionOptions options = null) {
                return Transition(target, options, new TransitionRun.Spec { Kind = TransitionKind.FadeOut });
            }

            /// <summary>Shows target, sliding it in by distance from that side. Its layout place stays put.</summary>
            public static Tween SlideIn(FrameworkElement target, Dock from, double distance,
                                        TransitionOptions options = null) {
                return Transition(
                    target, options,
                    new TransitionRun.Spec { Kind = TransitionKind.SlideIn, Side = from, Distance = distance });
            }

            /// <summary>Shows target in place, slides it out by distance toward that side, hides it.</summary>
            public static Tween SlideOut(FrameworkElement target, Dock to, double distance,
                                         TransitionOptions options = null) {
                return Transition(
                    target, options,
                    new TransitionRun.Spec { Kind = TransitionKind.SlideOut, Side = to, Distance = distance });
            }

            /// <summary>
            /// Shows target, scaling its height (Vertical) or width up from nothing at origin to its full size. Drawn
            /// only: its layout size never changes, so nothing around it moves.
            /// </summary>
            public static Tween Expand(FrameworkElement target, Orientation orientation, Origin origin = Origin.Center,
                                       TransitionOptions options = null) {
                TransitionRun.Spec spec = new TransitionRun.Spec {
                    Kind        = TransitionKind.Expand,
                    Orientation = orientation,
                    Origin      = origin,
                };
                return Transition(target, options, spec);
            }

            /// <summary>Shows target at full size, scales its height (Vertical) or width to origin, hides it.</summary>
            public static Tween Collapse(FrameworkElement target, Orientation orientation,
                                         Origin origin = Origin.Center, TransitionOptions options = null) {
                TransitionRun.Spec spec = new TransitionRun.Spec {
                    Kind        = TransitionKind.Collapse,
                    Orientation = orientation,
                    Origin      = origin,
                };
                return Transition(target, options, spec);
            }

            /// <summary>
            /// Takes the parts' colours to the colour given and leaves them there, each as a brush of its own set on
            /// the target, as setting the property would. Opacity isn't a colour: left out.
            /// </summary>
            public static Tween ColorTo(FrameworkElement target, TweenParts parts, Color to,
                                        TransitionOptions options = null) {
                return Transition(target, options,
                                  new TransitionRun.Spec { Kind = TransitionKind.ColorTo, Parts = parts, To = to });
            }

            private static Tween Transition(FrameworkElement target, TransitionOptions options,
                                            TransitionRun.Spec spec) {
                if (target == null) return null;
                Tween tween = new Tween(target.Dispatcher);
                tween.Begin(new TransitionRun(tween, target, options ?? new TransitionOptions(), spec));
                return tween;
            }

            // == Engine ===============================================================================

            internal abstract class TweenRun {
                internal abstract bool IsRunning { get; }
                internal abstract void Start(); // the first run; a transition from the target's current state
                internal abstract void Restart();
                internal abstract void SetPaused(bool paused);
                internal abstract void Stop();
            }

            // Animations under one root timeline, each child's clock applied to its object by hand, as GenieRow.Flash
            // animates its brush. Aimed by Storyboard.SetTarget at objects outside the tree (a cue's own brushes, a
            // nudge), the pins showed but nothing moved (Tween Lab).
            internal sealed class Motion {
                private struct Moved {
                    public IAnimatable        On;
                    public DependencyProperty Property;
                }

                private readonly ParallelTimeline _root = new ParallelTimeline();

                private readonly List<Moved> _moved = new List<Moved>(); // in _root.Children' order
                private ClockGroup           _clock;                     // while begun

                internal Action Completed; // a finite run's own end; never on End or Abandon

                internal bool IsEmpty {
                    get { return _moved.Count == 0; }
                }

                internal bool IsBegun {
                    get { return _clock != null; }
                }

                internal void Add(AnimationTimeline animation, IAnimatable on, DependencyProperty property) {
                    _root.Children.Add(animation);
                    _moved.Add(new Moved { On = on, Property = property });
                }

                internal void Clear() {
                    End();
                    _root.Children.Clear();
                    _moved.Clear();
                }

                // A new clock tree from the start (the timeline is copied and frozen), each child clock on its object.
                internal void Begin() {
                    _clock = _root.CreateClock();
                    int i  = 0;
                    foreach (Clock child in _clock.Children) {
                        _moved[i].On.ApplyAnimationClock(_moved[i].Property, (AnimationClock)child);
                        i++;
                    }
                    ClockGroup mine  = _clock;
                    mine.Completed  += delegate {
                        if (mine == _clock && Completed != null) Completed(); // not a clock since replaced
                    };
                }

                internal void Pause() {
                    if (_clock != null) _clock.Controller.Pause();
                }

                internal void Resume() {
                    if (_clock != null) _clock.Controller.Resume();
                }

                internal void SeekToStart() {
                    if (_clock != null)
                        _clock.Controller.SeekAlignedToLastTick(TimeSpan.Zero, TimeSeekOrigin.BeginTime);
                }

                // Stops the clocks and takes them off their properties, so the base values show.
                internal void End() {
                    if (_clock == null) return;
                    _clock.Controller.Stop();
                    foreach (Moved m in _moved) m.On.ApplyAnimationClock(m.Property, null);
                    _clock = null;
                }

                // Stops the clocks only: another run's clocks have replaced them on the properties.
                internal void Abandon() {
                    if (_clock == null) return;
                    _clock.Controller.Stop();
                    _clock = null;
                }
            }

            // Holds one value over a property from its start, for good, so the clock settles at once and nothing
            // ticks. The value sits in a field: WPF clones and freezes a timeline before running it, which would copy
            // a brush held in a dependency property and leave ours unanimated.
            private sealed class PinTo : AnimationTimeline {
                private readonly Type   _type;
                private readonly object _value;

                internal PinTo(DependencyProperty property, object value) : this(property.PropertyType, value) {}

                private PinTo(Type type, object value) {
                    _type    = type;
                    _value   = value;
                    Duration = new Duration(TimeSpan.Zero);
                }

                public override Type TargetPropertyType {
                    get { return _type; }
                }

                public override object GetCurrentValue(object from, object to, AnimationClock clock) {
                    return _value;
                }

                protected override Freezable CreateInstanceCore() {
                    return new PinTo(_type, _value);
                }
            }

            private static readonly TweenParts[] BrushParts = {
                TweenParts.Background,
                TweenParts.Border,
                TweenParts.Foreground,
            };

            // The target's own property for a part, or null if it has none (a TextBlock has no border).
            private static DependencyProperty BrushProperty(FrameworkElement t, TweenParts part) {
                switch (part) {
                    case TweenParts.Background:
                        if (t is Control) return Control.BackgroundProperty;
                        if (t is Border) return Border.BackgroundProperty;
                        if (t is Panel) return Panel.BackgroundProperty;
                        return t is TextBlock ? TextBlock.BackgroundProperty : null;
                    case TweenParts.Border:
                        if (t is Control) return Control.BorderBrushProperty;
                        return t is Border ? Border.BorderBrushProperty : null;
                    case TweenParts.Foreground:
                        // Control's and TextBlock's Foreground are this one; inherited, so a Border's text takes it
                        return System.Windows.Documents.TextElement.ForegroundProperty;
                    default:
                        return null;
                }
            }

            // The target's own transform, not another tween's pinned group over it.
            private static Transform OwnTransform(FrameworkElement t) {
                return t.GetAnimationBaseValue(UIElement.RenderTransformProperty) as Transform;
            }

            private static KeyTime At(TimeSpan total, double share) {
                return KeyTime.FromTimeSpan(TimeSpan.FromTicks((long)(total.Ticks * share)));
            }

            // == Cue internals ========================================================================

            internal sealed class CueRun : TweenRun {
                private const double ShakeDistance = 4;

                // A brush part: the property, our brush pinned over it, and the two colours it moves between.
                private sealed class Paint {
                    public DependencyProperty Property;
                    public SolidColorBrush    Brush;
                    public Color              Tint, Dip;
                }

                private readonly Tween            _tween;
                private readonly FrameworkElement _target;
                private readonly CueOptions       _o;
                private readonly Motion           _motion = new Motion();

                private readonly List<Paint> _paints = new List<Paint>();
                private TransformGroup       _shaken; // the target's own transform, then our nudge

                private readonly System.Windows.Controls.Primitives.ButtonBase _button; // the target, if a button

                private bool _started, _stopped, _finished, _held, _pinned, _paused, _watching;

                internal CueRun(Tween tween, FrameworkElement target, CueOptions options) {
                    _tween            = tween;
                    _target           = target;
                    _button           = target as System.Windows.Controls.Primitives.ButtonBase;
                    _o                = options;
                    _motion.Completed = Finish;
                    Build();
                }

                internal override bool IsRunning {
                    get { return _started && !_stopped && !_finished; }
                }

                private bool IsFinite {
                    get { return _o.Pattern == CuePattern.Flash || _o.Pattern == CuePattern.Shake; }
                }

                internal override void SetPaused(bool paused) {
                    _paused = paused;
                    Update();
                }

                internal override void Start() {
                    Restart();
                }

                internal override void Restart() {
                    if (_motion.IsEmpty) { // nothing on this target it can move
                        Stop();
                        return;
                    }
                    if (!_started || _stopped) Subscribe();
                    _started = true;
                    _stopped = _finished = _paused = _held = false;
                    _motion.End();
                    Update();
                }

                internal override void Stop() {
                    if (_stopped) return;
                    _stopped = true;
                    _motion.End();
                    Unpin();
                    Unsubscribe();
                    if (_target.GetValue(CueProperty) == _tween) _target.ClearValue(CueProperty);
                    _tween.RaiseCompleted();
                }

                // Shows the tint and moves, holds still, or falls back, from the current state. Every event lands here.
                private void Update() {
                    if (_stopped || !_started) return;
                    bool moving = SystemParameters.ClientAreaAnimation;
                    if (moving || _o.Fallback == CueFallback.Steady)
                        Pin();
                    else
                        Unpin();
                    if (!moving) {
                        _motion.End();
                        _held = false;
                        if (IsFinite) Finish(); // its end state, at once
                        return;
                    }
                    if (_finished) return;
                    if (!_motion.IsBegun) {
                        _motion.Begin();
                        _held = false;
                    }
                    bool hovered = _o.PauseOnHover && (_target.IsMouseOver || _target.IsKeyboardFocusWithin);
                    bool hold    = _paused || hovered || !_target.IsVisible;
                    if (hold == _held) return;
                    _held = hold;
                    if (!hold) {
                        _motion.Resume();
                        return;
                    }
                    _motion.Pause();
                    if (!IsFinite) _motion.SeekToStart(); // holds at its steady tint, not mid-dip
                }

                private void Finish() {
                    if (_finished || _stopped) return;
                    _finished = true;
                    if (_o.Pattern == CuePattern.Shake)
                        Stop(); // nothing to hold
                    else
                        _tween.RaiseCompleted(); // Flash holds its tint until Stop
                }

                // == Events ===========================================================================

                private void Subscribe() {
                    _target.Loaded                       += OnLoaded;
                    _target.Unloaded                     += OnUnloaded;
                    _target.IsVisibleChanged             += OnStateChanged;
                    _target.IsKeyboardFocusWithinChanged += OnStateChanged;
                    _target.MouseEnter                   += OnMouse;
                    _target.MouseLeave                   += OnMouse;
                    if (_o.StopOnClick) {
                        _target.AddHandler(UIElement.PreviewMouseLeftButtonUpEvent,
                                           new System.Windows.Input.MouseButtonEventHandler(OnClickUp), true);
                        if (_button != null) _button.Click += OnClick; // a keyboard click too
                    }
                    if (_target.IsLoaded) Watch(); // else on Loaded: a target never shown never holds the static event
                }

                private void Unsubscribe() {
                    _target.Loaded                       -= OnLoaded;
                    _target.Unloaded                     -= OnUnloaded;
                    _target.IsVisibleChanged             -= OnStateChanged;
                    _target.IsKeyboardFocusWithinChanged -= OnStateChanged;
                    _target.MouseEnter                   -= OnMouse;
                    _target.MouseLeave                   -= OnMouse;
                    _target.RemoveHandler(
                        UIElement.PreviewMouseLeftButtonUpEvent,
                        new System.Windows.Input.MouseButtonEventHandler(OnClickUp)); // equal by method
                    if (_button != null) _button.Click -= OnClick;
                    if (_watching) SystemParameters.StaticPropertyChanged -= OnSetting;
                    _watching = false;
                }

                // Static, so held only while loaded; a closed window unloads its content, which stops the cue.
                private void Watch() {
                    if (_watching) return;
                    SystemParameters.StaticPropertyChanged += OnSetting;
                    _watching                               = true;
                }

                private void OnLoaded(object sender, RoutedEventArgs e) {
                    Watch();
                    Update();
                }

                private void OnUnloaded(object sender, RoutedEventArgs e) {
                    Stop();
                }

                private void OnStateChanged(object sender, DependencyPropertyChangedEventArgs e) {
                    Update();
                }

                private void OnMouse(object sender, System.Windows.Input.MouseEventArgs e) {
                    Update();
                }

                private void OnClick(object sender, RoutedEventArgs e) {
                    Stop();
                }

                private void OnClickUp(object sender, System.Windows.Input.MouseButtonEventArgs e) {
                    Stop();
                }

                // Raised on whichever thread saw WM_SETTINGCHANGE. An empty name means every setting changed.
                private void OnSetting(object sender, System.ComponentModel.PropertyChangedEventArgs e) {
                    if (!string.IsNullOrEmpty(e.PropertyName) && e.PropertyName != "ClientAreaAnimation") return;
                    _target.Dispatcher.BeginInvoke((Action)Update);
                }

                // == Pins =============================================================================

                private void Pin() {
                    if (_pinned) return;
                    _pinned = true;
                    foreach (Paint p in _paints) _target.BeginAnimation(p.Property, new PinTo(p.Property, p.Brush));
                    if (_shaken != null)
                        _target.BeginAnimation(UIElement.RenderTransformProperty,
                                               new PinTo(UIElement.RenderTransformProperty, _shaken));
                }

                // Clears every animation on these properties, not only the pins: one tween per property.
                private void Unpin() {
                    if (!_pinned) return;
                    _pinned = false;
                    foreach (Paint p in _paints) _target.BeginAnimation(p.Property, null);
                    if (_shaken != null) _target.BeginAnimation(UIElement.RenderTransformProperty, null);
                }

                // == Build ============================================================================

                private void Build() {
                    TimeSpan       total  = _o.Cycle;
                    RepeatBehavior repeat = _o.Repeat;
                    if (IsFinite) {
                        total  = TimeSpan.FromTicks(_o.Cycle.Ticks * Math.Max(1, _o.Count));
                        repeat = new RepeatBehavior(1);
                    }

                    if (_o.Pattern == CuePattern.Shake) {
                        BuildShake(total);
                        return;
                    }
                    List<Step> steps = Steps();
                    foreach (TweenParts part in BrushParts) {
                        DependencyProperty property = (_o.Parts & part) != 0 ? BrushProperty(_target, part) : null;
                        if (property == null) continue;
                        Paint p = new Paint { Property = property };
                        TintOf(part, out p.Tint, out p.Dip);
                        p.Brush = new SolidColorBrush(p.Tint);
                        _paints.Add(p);

                        ColorAnimationUsingKeyFrames colors = new ColorAnimationUsingKeyFrames();
                        foreach (Step s in steps) {
                            Color   c  = s.IsDip ? p.Dip : p.Tint;
                            KeyTime at = At(total, s.At);
                            colors.KeyFrames.Add(s.IsHard ? (ColorKeyFrame) new DiscreteColorKeyFrame(c, at)
                                                          : new EasingColorKeyFrame(c, at, _o.Easing));
                        }
                        Add(colors, p.Brush, SolidColorBrush.ColorProperty, total, repeat);
                    }
                    if ((_o.Parts & TweenParts.Opacity) != 0) {
                        // Its own opacity, not a fade's current value.
                        double rest = (double)_target.GetAnimationBaseValue(UIElement.OpacityProperty);
                        DoubleAnimationUsingKeyFrames opacity = new DoubleAnimationUsingKeyFrames();
                        foreach (Step s in steps) {
                            double  v  = s.IsDip ? rest * (1 - Depth) : rest;
                            KeyTime at = At(total, s.At);
                            opacity.KeyFrames.Add(s.IsHard ? (DoubleKeyFrame) new DiscreteDoubleKeyFrame(v, at)
                                                           : new EasingDoubleKeyFrame(v, at, _o.Easing));
                        }
                        Add(opacity, _target, UIElement.OpacityProperty, total, repeat);
                    }
                }

                // Right, left, back to centre, Count times. The target's own transform is kept, under the nudge.
                private void BuildShake(TimeSpan total) {
                    TranslateTransform nudge = new TranslateTransform();
                    _shaken                  = new TransformGroup();
                    Transform own            = OwnTransform(_target);
                    if (own != null) _shaken.Children.Add(own);
                    _shaken.Children.Add(nudge);
                    int                           n = Math.Max(1, _o.Count);
                    DoubleAnimationUsingKeyFrames x = new DoubleAnimationUsingKeyFrames();
                    for (int i = 0; i < n; i++) {
                        x.KeyFrames.Add(new EasingDoubleKeyFrame(ShakeDistance, At(total, (i + 0.25) / n), _o.Easing));
                        x.KeyFrames.Add(new EasingDoubleKeyFrame(-ShakeDistance, At(total, (i + 0.75) / n), _o.Easing));
                        x.KeyFrames.Add(new EasingDoubleKeyFrame(0, At(total, (i + 1.0) / n), _o.Easing));
                    }
                    Add(x, nudge, TranslateTransform.XProperty, total, new RepeatBehavior(1));
                }

                private void Add(AnimationTimeline a, IAnimatable on, DependencyProperty property, TimeSpan total,
                                 RepeatBehavior repeat) {
                    a.Duration       = total;
                    a.RepeatBehavior = repeat;
                    a.BeginTime      = _o.Delay;
                    _motion.Add(a, on, property);
                }

                // A key frame: when (a share of the whole run) and whether it goes to the dip. Every pattern starts and
                // ends on the tint, so a cue at rest, paused or seeked to 0 shows the tint.
                private struct Step {
                    public double At;
                    public bool   IsDip, IsHard;

                    public Step(double at, bool isDip, bool isHard = false) {
                        At     = at;
                        IsDip  = isDip;
                        IsHard = isHard;
                    }
                }

                private List<Step> Steps() {
                    List<Step> steps = new List<Step>();
                    switch (_o.Pattern) {
                        case CuePattern.Pulse: {
                            // Each dip a share of the cycle; the hold is what's left. Dips longer than the cycle
                            // fill it, with no hold.
                            int    n    = Math.Max(1, _o.Dips);
                            double dip  = Math.Min(1.0 / n, (double)_o.DipDuration.Ticks / Math.Max(1, _o.Cycle.Ticks));
                            double hold = 1 - n * dip;
                            double half = dip / 2;
                            steps.Add(new Step(hold, false));
                            for (int i = 0; i < n; i++) {
                                steps.Add(new Step(hold + (2 * i + 1) * half, true));
                                steps.Add(new Step(hold + (2 * i + 2) * half, false));
                            }
                            break;
                        }
                        case CuePattern.Flash: {
                            int n = Math.Max(1, _o.Count);
                            for (int i = 0; i < n; i++) {
                                steps.Add(new Step((i + 0.5) / n, true));
                                steps.Add(new Step((i + 1.0) / n, false));
                            }
                            break;
                        }
                        case CuePattern.Blink:
                            steps.Add(new Step(0, false, true));
                            steps.Add(new Step(0.5, true, true));
                            break;
                        default: // Breathe
                            steps.Add(new Step(0.5, true));
                            steps.Add(new Step(1, false));
                            break;
                    }
                    return steps;
                }

                // From Tone: a toned button's resting colours (SetTone), so a cue on one matches its own look. The
                // other colour, unless DipColor sets it, is the tint moved Intensity of the way to where Direction
                // points. Lighter: toward white. Darker: richer, not just darker: toward the most vivid step of the
                // tone's ramp deeper than the part's own (Caution's pale face toward lemon Yellow300), mixed in OKLab,
                // which keeps the colour where an RGB mix greys the middle. Toward the 900 in RGB looked washed out.
                private void TintOf(TweenParts part, out Color tint, out Color dip) {
                    Brush fill, edge, ink, hoverFill, hoverEdge, pressedFill;
                    Theme.ToneButtonBrushes(_o.Tone, out fill, out edge, out ink, out hoverFill, out hoverEdge,
                                            out pressedFill);
                    Brush own = part == TweenParts.Background ? fill : part == TweenParts.Border ? edge : ink;
                    tint      = _o.Color ?? ((SolidColorBrush)own).Color; // theme brushes are all solid
                    if (_o.DipColor.HasValue) {
                        dip = _o.DipColor.Value;
                    } else if (_o.Direction == DipDirection.Lighter) {
                        dip = Toward(tint, Color.FromRgb(255, 255, 255), Depth);
                    } else {
                        Color rich = _o.Color.HasValue ? Deepen(tint) : Richest(Theme.ToneRamp(_o.Tone), own);
                        dip        = Shade.Mix(tint, rich, Depth);
                    }
                }

                // Intensity, kept short of 1 so the target never vanishes: all the way to white or clear would.
                private double Depth {
                    get { return Math.Max(0, Math.Min(0.95, _o.Intensity)); }
                }

                // share of the way from c to end, in RGB; alpha kept.
                private static Color Toward(Color c, Color end, double share) {
                    return Color.FromArgb(c.A, (byte)(c.R + (end.R - c.R) * share), (byte)(c.G + (end.G - c.G) * share),
                                          (byte)(c.B + (end.B - c.B) * share));
                }

                // The most vivid step deeper than own on its ramp. Grays have no colour to deepen into: the deepest.
                private static Color Richest(Brush[] ramp, Brush own) {
                    Color  deepest = ((SolidColorBrush)ramp[ramp.Length - 1]).Color;
                    Color  best    = deepest;
                    double most    = 0;
                    for (int i = Array.IndexOf(ramp, own) + 1; i < ramp.Length; i++) {
                        Color  step   = ((SolidColorBrush)ramp[i]).Color;
                        double chroma = Shade.Chroma(step);
                        if (chroma <= most) continue;
                        most = chroma;
                        best = step;
                    }
                    return most >= 0.03 ? best : deepest; // OKLab chroma: below this reads as grey
                }

                // A custom Color has no ramp: its own lightness cut by more than half, its colour kept as far as sRGB
                // allows. Toward black in RGB would grey it.
                private static Color Deepen(Color c) {
                    return Shade.WithLightness(c, Shade.Lightness(c) * 0.45);
                }
            }

            // == Colour =================================================================================
            // OKLab (Björn Ottosson's), where equal steps look equal and a mix of two colours of one hue keeps its
            // colour. An sRGB mix of a pale and a deep colour greys the middle.

            internal static class Shade {
                private struct Lab {
                    public double L, A, B;
                }

                internal static double Lightness(Color c) {
                    return ToLab(c).L;
                }

                internal static double Chroma(Color c) {
                    Lab p = ToLab(c);
                    return Math.Sqrt(p.A * p.A + p.B * p.B);
                }

                /// <summary>share of the way from one colour to another, in OKLab; from's alpha kept.</summary>
                internal static Color Mix(Color from, Color to, double share) {
                    Lab a = ToLab(from), b = ToLab(to);
                    Lab m = new Lab { L = a.L + (b.L - a.L) * share, A = a.A + (b.A - a.A) * share,
                                      B = a.B + (b.B - a.B) * share };
                    return FromLab(m, from.A);
                }

                /// <summary>c at another lightness, its hue kept and its chroma as far as sRGB allows.</summary>
                internal static Color WithLightness(Color c, double lightness) {
                    Lab p = ToLab(c);
                    for (double keep = 1; keep > 0; keep -= 0.05) {
                        Lab q = new Lab { L = lightness, A = p.A * keep, B = p.B * keep };
                        if (InGamut(q)) return FromLab(q, c.A);
                    }
                    return FromLab(new Lab { L = lightness }, c.A);
                }

                private static Lab ToLab(Color c) {
                    double r = Linear(c.R), g = Linear(c.G), b = Linear(c.B);
                    double l = Math.Pow(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b, 1.0 / 3);
                    double m = Math.Pow(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b, 1.0 / 3);
                    double s = Math.Pow(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b, 1.0 / 3);
                    return new Lab {
                        L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                        A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                        B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
                    };
                }

                // Linear sRGB, unclamped: a channel outside 0 to 1 is out of gamut.
                private static double[] ToLinear(Lab p) {
                    double l  = p.L + 0.3963377774 * p.A + 0.2158037573 * p.B;
                    double m  = p.L - 0.1055613458 * p.A - 0.0638541728 * p.B;
                    double s  = p.L - 0.0894841775 * p.A - 1.2914855480 * p.B;
                    double l3 = l * l * l, m3 = m * m * m, s3 = s * s * s;
                    return new[] {
                        4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3,
                        -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3,
                        -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076146010 * s3,
                    };
                }

                private static bool InGamut(Lab p) {
                    foreach (double v in ToLinear(p)) {
                        if (v < -0.0001 || v > 1.0001) return false;
                    }
                    return true;
                }

                private static Color FromLab(Lab p, byte alpha) {
                    double[] rgb = ToLinear(p);
                    return Color.FromArgb(alpha, Encode(rgb[0]), Encode(rgb[1]), Encode(rgb[2]));
                }

                private static double Linear(byte channel) {
                    double c = channel / 255.0;
                    return c <= 0.04045 ? c / 12.92 : Math.Pow((c + 0.055) / 1.055, 2.4);
                }

                private static byte Encode(double linear) {
                    double v = Math.Max(0, Math.Min(1, linear));
                    double c = v <= 0.0031308 ? 12.92 * v : 1.055 * Math.Pow(v, 1 / 2.4) - 0.055;
                    return (byte)Math.Round(c * 255);
                }
            }

            // == Transition internals =================================================================

            internal enum TransitionKind { FadeIn, FadeOut, SlideIn, SlideOut, Expand, Collapse, ColorTo }

            internal sealed class TransitionRun : TweenRun {
                // What a transition does; only its kind's fields matter.
                internal struct Spec {
                    public TransitionKind Kind;
                    public Dock           Side;
                    public double         Distance;
                    public Orientation    Orientation;
                    public Origin         Origin;
                    public TweenParts     Parts;
                    public Color          To;
                }

                private readonly Tween             _tween;
                private readonly FrameworkElement  _target;
                private readonly TransitionOptions _o;
                private readonly Spec              _spec;
                private readonly Motion            _motion = new Motion();

                private readonly List<Motion> _replaced = new List<Motion>(); // runs taken over; stopped once ours runs

                // Slides and sizes: our scale, the target's own transform, then our shift, as one group pinned over
                // RenderTransform. The scale goes first, so its origin is in the target's own coordinates.
                private ScaleTransform     _scale;
                private TranslateTransform _shift;
                private TransformGroup     _transform;

                // ColorTo: our brush per property, and its colour at the first start, which Restart goes back to.
                private readonly Dictionary<DependencyProperty, SolidColorBrush> _brushes =
                    new Dictionary<DependencyProperty, SolidColorBrush>();
                private readonly Dictionary<DependencyProperty, Color> _startColors =
                    new Dictionary<DependencyProperty, Color>();

                private bool _running;

                internal TransitionRun(Tween tween, FrameworkElement target, TransitionOptions options, Spec spec) {
                    _tween            = tween;
                    _target           = target;
                    _o                = options;
                    _spec             = spec;
                    _motion.Completed = Finish;
                }

                internal override bool IsRunning {
                    get { return _running; }
                }

                internal override void Start() {
                    Begin(false); // the first start
                }

                internal override void Restart() {
                    Begin(true);
                }

                internal override void SetPaused(bool paused) {
                    if (paused)
                        _motion.Pause();
                    else
                        _motion.Resume();
                }

                internal override void Stop() {
                    Finish();
                }

                private bool IsVertical {
                    get { return _spec.Orientation == Orientation.Vertical; }
                }

                // Every transition sets its own start state and plays from it, whatever the target's state: an In
                // from transparent, offset or zero scale; an Out from shown, in place, at its own opacity and full
                // size; ColorTo from the colour shown now. Only a run taking over one in progress on its properties
                // starts where that run had got to, so it turns around without a jump. Restart: the start state always.
                private void Begin(bool restart) {
                    _motion.Clear();
                    bool fromStart = !TakeOver() || restart;
                    if (!_running) _target.Unloaded += OnUnloaded;
                    _running = true;
                    switch (_spec.Kind) {
                        case TransitionKind.FadeIn:
                        case TransitionKind.FadeOut:
                            BuildFade(fromStart);
                            break;
                        case TransitionKind.SlideIn:
                        case TransitionKind.SlideOut:
                            BuildSlide(fromStart);
                            break;
                        case TransitionKind.Expand:
                        case TransitionKind.Collapse:
                            BuildSize(fromStart);
                            break;
                        default:
                            BuildColor(fromStart);
                            break;
                    }
                    if (_motion.IsEmpty || !SystemParameters.ClientAreaAnimation) {
                        Finish(); // already there, or animations off: the end state at once
                    } else {
                        _motion.Begin();
                    }
                    foreach (Motion m in _replaced) m.Abandon(); // after ours replaced their clocks
                    _replaced.Clear();
                }

                // To the end state, then off its properties. Runs once per start: the end, Stop or unloading.
                private void Finish() {
                    if (!_running) return;
                    _running          = false;
                    _target.Unloaded -= OnUnloaded;
                    switch (_spec.Kind) {
                        case TransitionKind.FadeIn:
                        case TransitionKind.SlideIn:
                        case TransitionKind.Expand:
                            _target.Visibility = Visibility.Visible;
                            break;
                        case TransitionKind.ColorTo:
                            foreach (SolidColorBrush b in _brushes.Values) b.Color = _spec.To; // under the clocks
                            break;
                        default:
                            _target.Visibility = Visibility.Hidden; // keeps its space: Collapsed would move neighbours
                            break;
                    }
                    _motion.End();
                    if (_transform != null) _target.BeginAnimation(UIElement.RenderTransformProperty, null);
                    _scale     = null;
                    _shift     = null;
                    _transform = null;
                    Release();
                    _tween.RaiseCompleted();
                }

                private void OnUnloaded(object sender, RoutedEventArgs e) {
                    Finish();
                }

                // == One run per property =============================================================

                private static readonly DependencyProperty RunsProperty = DependencyProperty.RegisterAttached(
                    "GenieTransitions", typeof(Dictionary<DependencyProperty, TransitionRun>), typeof(TransitionRun));

                private Dictionary<DependencyProperty, TransitionRun> Runs() {
                    Dictionary<DependencyProperty, TransitionRun> runs =
                        _target.GetValue(RunsProperty) as Dictionary<DependencyProperty, TransitionRun>;
                    if (runs != null) return runs;
                    runs = new Dictionary<DependencyProperty, TransitionRun>();
                    _target.SetValue(RunsProperty, runs);
                    return runs;
                }

                // The target's properties this run moves; another run on any of them gives way.
                private List<DependencyProperty> Keys() {
                    List<DependencyProperty> keys = new List<DependencyProperty>();
                    switch (_spec.Kind) {
                        case TransitionKind.FadeIn:
                        case TransitionKind.FadeOut:
                            keys.Add(UIElement.OpacityProperty);
                            break;
                        case TransitionKind.SlideIn:
                        case TransitionKind.SlideOut:
                        case TransitionKind.Expand:
                        case TransitionKind.Collapse:
                            keys.Add(UIElement.RenderTransformProperty);
                            break;
                        default:
                            foreach (TweenParts part in BrushParts) {
                                DependencyProperty p = (_spec.Parts & part) != 0 ? BrushProperty(_target, part) : null;
                                if (p != null) keys.Add(p);
                            }
                            break;
                    }
                    return keys;
                }

                // Claims this run's properties; true if it took one over from a run in progress.
                private bool TakeOver() {
                    Dictionary<DependencyProperty, TransitionRun> runs = Runs();
                    bool                                          took = false;
                    foreach (DependencyProperty key in Keys()) {
                        TransitionRun other;
                        if (runs.TryGetValue(key, out other) && other != this && other._running) {
                            other.GiveWay(this);
                            took = true;
                        }
                        runs[key] = this;
                    }
                    return took;
                }

                // Replaced: no end state and no Completed. What next carries on from (a slide's shift, ColorTo's
                // brushes) passes to it; its clocks stop once next's have replaced them.
                private void GiveWay(TransitionRun next) {
                    if (!_running) return;
                    _running          = false;
                    _target.Unloaded -= OnUnloaded;
                    if (_transform != null) {
                        next._scale     = _scale;
                        next._shift     = _shift;
                        next._transform = _transform;
                        _scale          = null;
                        _shift          = null;
                        _transform      = null;
                    }
                    List<DependencyProperty> nextKeys = next.Keys();
                    foreach (KeyValuePair<DependencyProperty, SolidColorBrush> b in _brushes) {
                        if (nextKeys.Contains(b.Key))
                            next._brushes[b.Key] = b.Value;
                        else
                            b.Value.Color = _spec.To; // a part next leaves alone ends where this was going
                    }
                    _brushes.Clear();
                    next._replaced.Add(_motion);
                    Release();
                }

                private void Release() {
                    Dictionary<DependencyProperty, TransitionRun> runs = Runs();
                    List<DependencyProperty>                      mine = new List<DependencyProperty>();
                    foreach (KeyValuePair<DependencyProperty, TransitionRun> r in runs) {
                        if (r.Value == this) mine.Add(r.Key);
                    }
                    foreach (DependencyProperty key in mine) runs.Remove(key);
                }

                // == Build ============================================================================
                // Every animation names its from and to values: a property's current value is the animated one, so a
                // run taking over starts where the last one was. The start value is held through Delay.

                private void BuildFade(bool fromStart) {
                    double own         = (double)_target.GetAnimationBaseValue(UIElement.OpacityProperty);
                    bool   fadeIn      = _spec.Kind == TransitionKind.FadeIn;
                    double from        = !fromStart ? _target.Opacity : fadeIn ? 0 : own;
                    _target.Visibility = Visibility.Visible;
                    Add(DoubleFrames(from, fadeIn ? own : 0), _target, UIElement.OpacityProperty);
                }

                private void BuildSlide(bool fromStart) {
                    bool   slideIn = _spec.Kind == TransitionKind.SlideIn;
                    bool   back    = _spec.Side == Dock.Left || _spec.Side == Dock.Top; // toward negative x or y
                    bool   across  = _spec.Side == Dock.Left || _spec.Side == Dock.Right;
                    double away    = back ? -_spec.Distance : _spec.Distance;
                    double offX    = across ? away : 0;
                    double offY    = across ? 0 : away;
                    bool   carried = PinTransform();
                    double fromX = slideIn ? offX : 0, fromY = slideIn ? offY : 0;
                    if (carried && !fromStart) {
                        fromX = _shift.X;
                        fromY = _shift.Y;
                    }
                    _shift.X           = fromX; // before the first frame, so nothing shows at the wrong place
                    _shift.Y           = fromY;
                    _target.Visibility = Visibility.Visible;
                    Add(DoubleFrames(fromX, slideIn ? 0 : offX), _shift, TranslateTransform.XProperty);
                    Add(DoubleFrames(fromY, slideIn ? 0 : offY), _shift, TranslateTransform.YProperty);
                }

                // A scale from origin, on the axis given. Its centre is from the target's drawn size; a target that
                // was Collapsed has none until laid out, so it's laid out now, before the first frame.
                private void BuildSize(bool fromStart) {
                    bool expand        = _spec.Kind == TransitionKind.Expand;
                    bool carried       = PinTransform();
                    _target.Visibility = Visibility.Visible;
                    if (_target.RenderSize.Width == 0 && _target.RenderSize.Height == 0) _target.UpdateLayout();
                    double size   = IsVertical ? _target.RenderSize.Height : _target.RenderSize.Width;
                    double centre = _spec.Origin == Origin.Start ? 0 : _spec.Origin == Origin.End ? size : size / 2;
                    DependencyProperty axis =
                        IsVertical ? ScaleTransform.ScaleYProperty : ScaleTransform.ScaleXProperty;
                    double from = expand ? 0 : 1;
                    if (carried && !fromStart) from = (double)_scale.GetValue(axis);
                    if (IsVertical)
                        _scale.CenterY = centre;
                    else
                        _scale.CenterX = centre;
                    _scale.SetValue(axis, from); // before the first frame
                    Add(DoubleFrames(from, expand ? 1 : 0), _scale, axis);
                }

                // Pins our scale and shift over the target's own transform; true if carried over from a running one.
                private bool PinTransform() {
                    if (_transform != null) return true;
                    _scale        = new ScaleTransform();
                    _shift        = new TranslateTransform();
                    _transform    = new TransformGroup();
                    Transform own = OwnTransform(_target);
                    _transform.Children.Add(_scale);
                    if (own != null) _transform.Children.Add(own);
                    _transform.Children.Add(_shift);
                    _target.BeginAnimation(UIElement.RenderTransformProperty,
                                           new PinTo(UIElement.RenderTransformProperty, _transform));
                    return false;
                }

                // Each part gets a brush of ours, set as its value, starting at the colour it shows now.
                private void BuildColor(bool fromStart) {
                    foreach (DependencyProperty property in Keys()) {
                        SolidColorBrush brush;
                        if (!_brushes.TryGetValue(property, out brush)) {
                            SolidColorBrush now = _target.GetValue(property) as SolidColorBrush;
                            brush               = new SolidColorBrush(now != null ? now.Color : _spec.To);
                            _target.SetValue(property, brush);
                            _brushes[property] = brush;
                        }
                        if (!_startColors.ContainsKey(property)) _startColors[property] = brush.Color;
                        Color from = fromStart ? _startColors[property] : brush.Color;
                        Add(ColorFrames(from, _spec.To), brush, SolidColorBrush.ColorProperty);
                    }
                }

                private void Add(AnimationTimeline a, IAnimatable on, DependencyProperty property) {
                    _motion.Add(a, on, property);
                }

                // from, held through Delay, then eased to to over Duration.
                private DoubleAnimationUsingKeyFrames DoubleFrames(double from, double to) {
                    DoubleAnimationUsingKeyFrames a = new DoubleAnimationUsingKeyFrames { Duration = Total };
                    a.KeyFrames.Add(new DiscreteDoubleKeyFrame(from, KeyTime.FromTimeSpan(TimeSpan.Zero)));
                    a.KeyFrames.Add(new DiscreteDoubleKeyFrame(from, KeyTime.FromTimeSpan(_o.Delay)));
                    a.KeyFrames.Add(new EasingDoubleKeyFrame(to, KeyTime.FromTimeSpan(Total), _o.Easing));
                    return a;
                }

                private ColorAnimationUsingKeyFrames ColorFrames(Color from, Color to) {
                    ColorAnimationUsingKeyFrames a = new ColorAnimationUsingKeyFrames { Duration = Total };
                    a.KeyFrames.Add(new DiscreteColorKeyFrame(from, KeyTime.FromTimeSpan(TimeSpan.Zero)));
                    a.KeyFrames.Add(new DiscreteColorKeyFrame(from, KeyTime.FromTimeSpan(_o.Delay)));
                    a.KeyFrames.Add(new EasingColorKeyFrame(to, KeyTime.FromTimeSpan(Total), _o.Easing));
                    return a;
                }

                private TimeSpan Total {
                    get { return _o.Delay + _o.Duration; }
                }
            }
        }
    }

    // == Controls =====================================================================================
    // Made by Genie.ControlUtils; each exposes what an addon may change after creation.

    /// <summary>
    /// Made by Genie.ControlUtils.CreateTag. Its colours come from Tone; Fill, Outline and Foreground override them
    /// one at a time (null: back to the tone's). Given less room than its text needs (a fixed Width, a narrow
    /// column), the text ends in "…" and shows whole on hover, above the tag's own tooltip.
    /// </summary>
    public sealed class GenieTag : Border {
        private readonly TextBlock         _text;
        private readonly ContentControl    _iconSlot;
        private Genie.ControlUtils.TagTone _tone;
        private bool                       _outlined;
        private Brush                      _fill, _outline, _foreground;
        private object                     _ownTip;   // the tooltip given from outside, or null
        private string                     _wholeTip; // what this tag shows while its text is cut, or null
        private FontFamily                 _textFont;

        internal GenieTag(string text, Genie.ControlUtils.TagTone tone, bool small, bool outlined,
                          FrameworkElement icon, double cornerRadius, double fontSize) {
            _iconSlot = new ContentControl {
                Focusable         = false,
                VerticalAlignment = VerticalAlignment.Center,
                Margin            = new Thickness(0, 0, 3, 0),
            };
            _text = new TextBlock {
                Text              = text ?? "",
                FontSize          = fontSize,
                VerticalAlignment = VerticalAlignment.Center,
                TextTrimming      = TextTrimming.CharacterEllipsis,
            };
            // Not a StackPanel: it measures its children with unlimited width, so a narrow tag clipped its text
            // instead of trimming it. A DockPanel hands the text what's left.
            DockPanel content           = new DockPanel();
            content.HorizontalAlignment = HorizontalAlignment.Center; // a tag given a fixed Width keeps it centred
            DockPanel.SetDock(_iconSlot, Dock.Left);
            content.Children.Add(_iconSlot);
            content.Children.Add(_text);
            Child             = content;
            BorderThickness   = new Thickness(1);
            CornerRadius      = new CornerRadius(cornerRadius);
            Padding           = small ? new Thickness(5, 0, 5, 0) : new Thickness(6, 1, 6, 1);
            Margin            = new Thickness(0, 0, small ? Genie.Theme.SmallTagSpacing : Genie.Theme.Spacing, 0);
            VerticalAlignment = VerticalAlignment.Center;
            _tone             = tone;
            _outlined         = outlined;
            Icon              = icon;
        }

        /// <summary>The text's weight, in a paragraph too.</summary>
        public FontWeight TextWeight {
            get { return _text.FontWeight; }
            set { _text.FontWeight = value; }
        }

        /// <summary>The text's font, in a paragraph too; null: the surrounding one.</summary>
        public FontFamily TextFont {
            get { return _textFont; }
            set {
                _textFont = value;
                if (value != null)
                    _text.FontFamily = value;
                else
                    _text.ClearValue(TextBlock.FontFamilyProperty);
            }
        }

        public string Text {
            get { return _text.Text; }
            set {
                _text.Text = value ?? "";
                InvalidateArrange(); // at a fixed width the size stays put, so only this rechecks the cut
            }
        }

        internal double TextSize {
            get { return _text.FontSize; }
        }

        protected override Size ArrangeOverride(Size arrangeSize) {
            Size size = base.ArrangeOverride(arrangeSize);
            ShowWholeTextIfCut();
            return size;
        }

        // A tooltip set from outside since the last check replaces the own one. An element tooltip can't share the
        // card, so it stays as it is.
        private void ShowWholeTextIfCut() {
            object current = GenieToolTip.Get(this);
            if (_wholeTip == null || !ReferenceEquals(current, _wholeTip)) _ownTip = current;
            bool   cut   = _text.Text.Length > 0 && WholeTextWidth() > _text.ActualWidth + 0.5;
            string whole = !cut || _ownTip is UIElement ? null
                           : _ownTip == null            ? _text.Text
                                                        : _text.Text + "\n" + _ownTip;
            if (whole == null) {
                if (_wholeTip == null) return;
                _wholeTip = null;
                GenieToolTip.Set(this, _ownTip);
                return;
            }
            if (whole == _wholeTip && ReferenceEquals(current, _wholeTip)) return;
            _wholeTip = whole;
            GenieToolTip.Set(this, whole);
        }

        private double WholeTextWidth() {
            Typeface face = new Typeface(_text.FontFamily, _text.FontStyle, _text.FontWeight, _text.FontStretch);
            return new FormattedText(_text.Text, System.Globalization.CultureInfo.CurrentUICulture, FlowDirection, face,
                                     _text.FontSize, _text.Foreground, VisualTreeHelper.GetDpi(this).PixelsPerDip)
                .WidthIncludingTrailingWhitespace;
        }

        // For a place among words as one box (GenieParagraph, a tag with an icon): the small size's padding, and no
        // gap after it, which the words' own spaces give. Its text's own line height: TextBlock.LineHeight is
        // inherited, so it took the paragraph's, which made the box a full line tall, the extra all below its text.
        internal void MakeInline() {
            Padding          = new Thickness(5, 0, 5, 0);
            Margin           = new Thickness(0);
            _text.LineHeight = double.NaN; // auto, from its font
        }

        /// <summary>Its text's baseline, down from its top, as laid out; 0 before layout.</summary>
        internal double TextBaseline {
            get {
                if (!_text.IsArrangeValid || _text.ActualHeight <= 0) return 0;
                return _text.TranslatePoint(new Point(0, _text.BaselineOffset), this).Y;
            }
        }

        public Genie.ControlUtils.TagTone Tone {
            get { return _tone; }
            set {
                _tone = value;
                Restyle();
            }
        }
        /// <summary>The tone's border and text on the panel grey, instead of the tone's fill.</summary>
        public bool Outlined {
            get { return _outlined; }
            set {
                _outlined = value;
                Restyle();
            }
        }
        /// <summary>Shown before the text, or null. Drawn shapes and text in it take the text's colour.</summary>
        public FrameworkElement Icon {
            get { return _iconSlot.Content as FrameworkElement; }
            set {
                _iconSlot.Content    = value;
                _iconSlot.Visibility = value != null ? Visibility.Visible : Visibility.Collapsed;
                Restyle();
            }
        }
        public Brush Fill {
            get { return _fill; }
            set {
                _fill = value;
                Restyle();
            }
        }
        public Brush Outline {
            get { return _outline; }
            set {
                _outline = value;
                Restyle();
            }
        }
        /// <summary>The text's colour, and the icon's.</summary>
        public Brush Foreground {
            get { return _foreground; }
            set {
                _foreground = value;
                Restyle();
            }
        }

        /// <summary>Its colours as drawn: the tone's, with Outlined, Fill, Outline and Foreground applied.</summary>
        internal void GetBrushes(out Brush fill, out Brush edge, out Brush ink) {
            Genie.ControlUtils.ToneBrushes(_tone, out fill, out edge, out ink);
            fill = _fill ?? (_outlined ? Genie.Theme.PanelBackground : fill);
            edge = _outline ?? edge;
            ink  = _foreground ?? ink;
        }

        private void Restyle() {
            Brush fill, edge, ink;
            GetBrushes(out fill, out edge, out ink);
            Background       = fill;
            BorderBrush      = edge;
            _text.Foreground = ink;
            Recolor(_iconSlot.Content as DependencyObject, ink);
        }

        private static void Recolor(DependencyObject element, Brush brush) {
            System.Windows.Shapes.Shape shape = element as System.Windows.Shapes.Shape;
            if (shape != null) shape.Stroke = brush;
            TextBlock text = element as TextBlock;
            if (text != null) text.Foreground = brush;
            Panel panel = element as Panel;
            if (panel != null) {
                foreach (UIElement child in panel.Children) Recolor(child, brush);
            }
            Decorator box = element as Decorator;
            if (box != null) Recolor(box.Child, brush);
        }
    }

    /// <summary>
    /// Made by Genie.ControlUtils.CreateParagraph. SetParts replaces what it says. Tags are read when they're
    /// added, so to change one, set the parts again.
    /// </summary>
    // A Decorator around a TextBlock, which seals OnRender. A tag without an icon is a run of its text among the
    // words, so it wraps as they do, and its pill is drawn under the text, a piece per line. The run has a figure
    // space at each end: no-break, so it keeps to the tag's first and last words, and about a digit wide, room for
    // the pill's inset clear of the words beside it. Every line is LineHeight tall (BlockLineHeight), so a character's
    // line and that line's baseline follow from where the character is.
    /// <summary>Made by Genie.ControlUtils.CreateCode.</summary>
    public sealed class GenieCode : Border {
        internal GenieCode(string text, Brush fill) {
            Text                = text ?? "";
            Background          = fill;
            CornerRadius        = new CornerRadius(Genie.Theme.SmallTagCornerRadius);
            Padding             = new Thickness(4, 0, 4, 0);
            HorizontalAlignment = HorizontalAlignment.Left;
            Child               = Genie.ControlUtils.CreateMonoText(Text, Genie.Theme.FontSizeCode);
        }

        public string Text { get; private set; }
    }

    /// <summary>Made by Genie.ControlUtils.CreateParagraphLink.</summary>
    public sealed class GenieParagraphLink {
        internal GenieParagraphLink(string text, Action onClick, object tooltip, string blocked) {
            Text    = text ?? "";
            OnClick = onClick;
            ToolTip = tooltip;
            Blocked = blocked;
        }

        public string   Text { get; private set; }
        internal Action OnClick { get; private set; }
        internal object ToolTip { get; private set; }
        internal string Blocked { get; private set; }
    }

    public sealed class GenieParagraph : Decorator {
        private const double CodeInset = 4;
        private const double TagInset  = 6; // a tag's text to its pill's outer edge, as GenieTag's: 5 padding, 1 border
        private const double IconGap   = 5;
        private const string Room      = " ";

        private readonly TextBlock _text;
        private readonly List<InlineTag> _tags = new List<InlineTag>();

        private sealed class InlineTag {
            public System.Windows.Documents.Run Run;
            public Brush                        Fill, Edge;
            public double                       Radius;
            public double                       Inset = TagInset;
            public int                          Pad   = Room.Length; // spaces around the text in Run
            public List<Pill>                   Pills = new List<Pill>();
        }

        private struct Pill {
            public Rect Box;       // in the text's space
            public bool OpenLeft;  // the tag goes on from the line above
            public bool OpenRight; // the tag goes on to the line below
        }

        internal GenieParagraph() {
            _text = new TextBlock {
                Foreground           = Genie.Theme.TextPrimary,
                TextWrapping         = TextWrapping.Wrap,
                LineStackingStrategy = LineStackingStrategy.BlockLineHeight,
            };
            Child    = _text;
            FontSize = Genie.Theme.FontSizeBody;
        }

        /// <summary>The words' size; the line height follows it. Tags keep their own.</summary>
        public double FontSize {
            get { return _text.FontSize; }
            set {
                _text.FontSize   = value;
                _text.LineHeight = Math.Round(value * 1.45); // 18 at the body's size, room for a tag or an icon
            }
        }

        /// <summary>The words' colour. Tags keep their own; icons, theirs.</summary>
        public Brush Foreground {
            get { return _text.Foreground; }
            set { _text.Foreground = value; }
        }

        /// <summary>Replaces what it says: strings, tags and icons, as CreateParagraph takes them.</summary>
        public void SetParts(params object[] parts) {
            // An element still held by an old container can't join a new one, so the old ones let go. After the
            // Clear: emptying a container while enumerating the inlines changes them, which throws.
            List<System.Windows.Documents.InlineUIContainer> old =
                new List<System.Windows.Documents.InlineUIContainer>();
            foreach (System.Windows.Documents.Inline inline in _text.Inlines) {
                System.Windows.Documents.InlineUIContainer box = inline as System.Windows.Documents.InlineUIContainer;
                if (box != null) old.Add(box);
            }
            _text.Inlines.Clear();
            foreach (System.Windows.Documents.InlineUIContainer box in old) box.Child = null;
            _tags.Clear();
            List<object> shown = new List<object>();
            if (parts != null) {
                foreach (object part in parts) {
                    if (part != null && !"".Equals(part)) shown.Add(part);
                }
            }
            for (int i = 0; i < shown.Count; i++) {
                GenieCode code    = shown[i] as GenieCode;
                GenieTag  tag     = shown[i] as GenieTag;
                UIElement element = shown[i] as UIElement;
                if (code != null)
                    AddCode(code);
                else if (tag != null && tag.Icon == null)
                    AddTag(tag);
                else if (tag != null)
                    AddWholeTag(tag);
                else if (element != null)
                    AddIcon(element, i > 0, i < shown.Count - 1);
                else if (shown[i] is GenieParagraphLink)
                    AddLink((GenieParagraphLink)shown[i]);
                else
                    _text.Inlines.Add(new System.Windows.Documents.Run(shown[i].ToString()));
            }
            InvalidateMeasure();
            InvalidateVisual();
        }

        private void AddTag(GenieTag tag) {
            Brush fill, edge, ink;
            tag.GetBrushes(out fill, out edge, out ink);
            System.Windows.Documents.Run run = new System.Windows.Documents.Run(Room + tag.Text + Room) {
                FontSize   = tag.TextSize,
                FontWeight = tag.TextWeight,
                Foreground = ink,
            };
            if (tag.TextFont != null) run.FontFamily = tag.TextFont;
            InlineTag t   = new InlineTag { Run = run, Fill = fill, Edge = edge, Radius = tag.CornerRadius.TopLeft };
            object    tip = GenieToolTip.Get(tag);
            if (tip != null) {
                GenieToolTip.Set(run, tip);
                run.MouseEnter += delegate(object sender, System.Windows.Input.MouseEventArgs e) {
                    PointTip(t, e.GetPosition(_text));
                };
            }
            _tags.Add(t);
            _text.Inlines.Add(run);
        }

        private void AddCode(GenieCode code) {
            System.Windows.Documents.Run run = new System.Windows.Documents.Run(Room + code.Text + Room) {
                FontFamily = Genie.Theme.MonoFont,
                FontSize   = Genie.Theme.FontSizeCode,
            };
            _tags.Add(new InlineTag {
                Run    = run,
                Fill   = code.Background,
                Edge   = code.Background,
                Radius = code.CornerRadius.TopLeft,
                Inset  = CodeInset,
            });
            _text.Inlines.Add(run);
        }

        // CreateLink's look on a run of the words' own text. Its pills are never drawn (no Fill): like a tag's, they
        // place its tooltip over the piece under the pointer.
        private void AddLink(GenieParagraphLink link) {
            System.Windows.Documents.Run run = new System.Windows.Documents.Run(link.Text);
            TextDecorationCollection     rest = Genie.ControlUtils.Underline(Genie.Theme.LinkUnderline, true);
            TextDecorationCollection     hot  = Genie.ControlUtils.Underline(Genie.Theme.LinkHover, false);
            InlineTag                    t    = new InlineTag { Run = run, Inset = 0, Pad = 0 };
            run.TextDecorations              = rest;
            if (link.Blocked != null) {
                run.Foreground = Genie.Theme.TextDisabled;
            } else {
                run.Cursor      = System.Windows.Input.Cursors.Hand;
                run.MouseEnter += delegate {
                    run.Foreground      = Genie.Theme.LinkHover;
                    run.TextDecorations = hot;
                };
                run.MouseLeave += delegate {
                    run.ClearValue(System.Windows.Documents.TextElement.ForegroundProperty); // the words' colour
                    run.TextDecorations = rest;
                };
                run.MouseLeftButtonUp += delegate(object sender, System.Windows.Input.MouseButtonEventArgs e) {
                    e.Handled = true;
                    if (link.OnClick != null) link.OnClick();
                };
            }
            object tip = link.Blocked ?? link.ToolTip;
            if (tip != null) {
                GenieToolTip.Set(run, tip);
                run.MouseEnter += delegate(object sender, System.Windows.Input.MouseEventArgs e) {
                    PointTip(t, e.GetPosition(_text));
                };
            }
            _tags.Add(t);
            _text.Inlines.Add(run);
        }

        // The tooltip points at the piece under the pointer, not the paragraph.
        private void PointTip(InlineTag t, Point at) {
            ToolTip tip = ToolTipService.GetToolTip(t.Run) as ToolTip;
            if (tip == null || t.Pills.Count == 0) return;
            Rect area = t.Pills[0].Box;
            foreach (Pill p in t.Pills) {
                if (p.Box.Contains(at)) area = p.Box;
            }
            tip.PlacementTarget    = _text;
            tip.PlacementRectangle = area;
        }

        // A tag with an icon stays one box: its icon could wrap away from its text. It sits on the baseline at its
        // own text's, read once laid out: an element has no baseline, so it would sit on the line by its bottom.
        private void AddWholeTag(GenieTag tag) {
            tag.MakeInline();
            tag.SizeChanged += delegate {
                double baseline = tag.TextBaseline;
                if (baseline <= 0 || Math.Abs(TextBlock.GetBaselineOffset(tag) - baseline) < 0.01) return;
                TextBlock.SetBaselineOffset(tag, baseline);
                _text.InvalidateMeasure();
            };
            _text.Inlines.Add(new System.Windows.Documents.InlineUIContainer(tag) {
                BaselineAlignment = BaselineAlignment.Baseline,
            });
        }

        // afterSome, beforeSome: something is on that side, so it keeps a gap there.
        private void AddIcon(UIElement icon, bool afterSome, bool beforeSome) {
            FrameworkElement fe = icon as FrameworkElement;
            if (fe != null) fe.Margin = new Thickness(afterSome ? IconGap : 0, 0, beforeSome ? IconGap : 0, 0);
            _text.Inlines.Add(new System.Windows.Documents.InlineUIContainer(icon) {
                BaselineAlignment = BaselineAlignment.Center,
            });
        }

        // The text is laid out by now, so the pills can be placed; redrawn only if one moved.
        protected override Size ArrangeOverride(Size arrangeSize) {
            Size size  = base.ArrangeOverride(arrangeSize);
            bool moved = false;
            foreach (InlineTag t in _tags) moved |= Place(t);
            if (moved) InvalidateVisual();
            return size;
        }

        // A pill per line the tag is on, around its glyphs there. Spaces are left out, so a piece ends at its last
        // word where the tag breaks. False if none moved.
        private bool Place(InlineTag t) {
            List<Pill> pills = new List<Pill>();
            try {
                double     lineHeight = _text.LineHeight;
                FontFamily family     = _text.FontFamily;
                // A fixed-height line's baseline sits in proportion to its font's (WPF's FullTextLine).
                double baseline = lineHeight * family.Baseline / family.LineSpacing;
                double size     = t.Run.FontSize;
                // The run's font: code's differs from the words'. As GenieTag: a 1px border, no padding.
                double top      = baseline - size * t.Run.FontFamily.Baseline - 1;
                double height   = size * t.Run.FontFamily.LineSpacing + 2;
                string text     = t.Run.Text;
                int    line     = -1;
                double left = 0, right = 0;
                for (int i = t.Pad; i < text.Length - t.Pad; i++) {
                    if (char.IsWhiteSpace(text[i])) continue;
                    System.Windows.Documents.TextPointer at = t.Run.ContentStart.GetPositionAtOffset(i);
                    Rect lead = at.GetCharacterRect(System.Windows.Documents.LogicalDirection.Forward);
                    Rect trail =
                        at.GetPositionAtOffset(1).GetCharacterRect(System.Windows.Documents.LogicalDirection.Backward);
                    if (lead.IsEmpty || trail.IsEmpty) return false;
                    int on = (int)Math.Floor((lead.Top + lead.Height / 2) / lineHeight);
                    if (on != line) {
                        if (line >= 0) pills.Add(Piece(left, right, line * lineHeight + top, height, t.Inset));
                        line = on;
                        left = right = lead.X;
                    }
                    left  = Math.Min(left, Math.Min(lead.X, trail.X));
                    right = Math.Max(right, Math.Max(lead.X, trail.X));
                }
                if (line >= 0) pills.Add(Piece(left, right, line * lineHeight + top, height, t.Inset));
            } catch {
                return false; // not laid out yet
            }
            for (int k = 0; k < pills.Count; k++) {
                Pill p      = pills[k];
                p.OpenLeft  = k > 0;
                p.OpenRight = k < pills.Count - 1;
                pills[k]    = p;
            }
            if (Same(pills, t.Pills)) return false;
            t.Pills = pills;
            return true;
        }

        private static Pill Piece(double left, double right, double top, double height, double inset) {
            return new Pill { Box = new Rect(left - inset, top, right - left + 2 * inset, height) };
        }

        private static bool Same(List<Pill> a, List<Pill> b) {
            if (a.Count != b.Count) return false;
            for (int i = 0; i < a.Count; i++) {
                if (a[i].OpenLeft != b[i].OpenLeft || a[i].OpenRight != b[i].OpenRight) return false;
                if (Math.Abs(a[i].Box.Left - b[i].Box.Left) > 0.01 || Math.Abs(a[i].Box.Top - b[i].Box.Top) > 0.01 ||
                    Math.Abs(a[i].Box.Width - b[i].Box.Width) > 0.01)
                    return false;
            }
            return true;
        }

        // Under the text, which the child draws over this.
        protected override void OnRender(DrawingContext dc) {
            Vector offset = VisualTreeHelper.GetOffset(_text);
            foreach (InlineTag t in _tags) {
                if (t.Fill == null) continue; // a link's
                Pen edge = new Pen(t.Edge, 1);
                foreach (Pill p in t.Pills) {
                    // On whole pixels, its 1px edge just inside.
                    Rect box = new Rect(Math.Round(p.Box.Left + offset.X), Math.Round(p.Box.Top + offset.Y),
                                        Math.Round(p.Box.Width), Math.Round(p.Box.Height));
                    dc.DrawGeometry(t.Fill, null, Outline(box, t.Radius, p, false));
                    box.Inflate(-0.5, -0.5);
                    dc.DrawGeometry(null, edge, Outline(box, Math.Max(0, t.Radius - 0.5), p, true));
                }
            }
        }

        // A pill's shape, rounded at its closed ends, clockwise from the bottom left. edgeOnly: its edge, left off at
        // an open end.
        private static Geometry Outline(Rect box, double radius, Pill p, bool edgeOnly) {
            double         l = box.Left, t = box.Top, r = box.Right, b = box.Bottom;
            double         rl = p.OpenLeft ? 0 : radius, rr = p.OpenRight ? 0 : radius;
            bool           skipLeft = edgeOnly && p.OpenLeft, skipRight = edgeOnly && p.OpenRight;
            StreamGeometry shape = new StreamGeometry();
            using (StreamGeometryContext c = shape.Open()) {
                if (skipLeft) {
                    c.BeginFigure(new Point(l, t), false, false);
                } else {
                    c.BeginFigure(new Point(l, b - rl), !edgeOnly, !edgeOnly);
                    c.LineTo(new Point(l, t + rl), true, false);
                    Corner(c, l + rl, t, rl);
                }
                c.LineTo(new Point(r - rr, t), true, false);
                if (skipRight) {
                    c.BeginFigure(new Point(r, b), false, false); // the bottom, as a line of its own
                } else {
                    Corner(c, r, t + rr, rr);
                    c.LineTo(new Point(r, b - rr), true, false);
                    Corner(c, r - rr, b, rr);
                }
                c.LineTo(new Point(l + rl, b), true, false);
                if (!skipLeft) Corner(c, l, b - rl, rl);
            }
            shape.Freeze();
            return shape;
        }

        private static void Corner(StreamGeometryContext c, double x, double y, double radius) {
            if (radius > 0)
                c.ArcTo(new Point(x, y), new Size(radius, radius), 0, false, SweepDirection.Clockwise, true, false);
            else
                c.LineTo(new Point(x, y), true, false);
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreateHelpPanel.</summary>
    public sealed class GenieHelpPanel : Grid {
        private readonly GenieListPane _topics;
        private readonly ScrollViewer  _page;

        internal GenieHelpPanel() {
            ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(190) });
            ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
            ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            _topics        = Genie.ControlUtils.CreateListPane("Topics", true);
            _topics.Margin = new Thickness(10, 10, 0, 10);
            Children.Add(_topics);
            Border divider = Genie.ControlUtils.CreateSeparator(Orientation.Vertical);
            divider.Margin = new Thickness(0, 10, 0, 10);
            SetColumn(divider, 1);
            Children.Add(divider);
            _page = new ScrollViewer {
                Padding                       = Genie.Theme.PaneInset,
                VerticalScrollBarVisibility   = ScrollBarVisibility.Auto,
                HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled,
            };
            SetColumn(_page, 2);
            Children.Add(_page);
            _topics.List.SelectionChanged += delegate {
                GenieHelpTopic topic = _topics.List.SelectedTag<GenieHelpTopic>();
                if (topic == null) return;
                _page.Content = topic.Page;
                _page.ScrollToTop();
            };
        }

        /// <summary>Adds a topic with its bullet points. The tip and examples go on what this returns.</summary>
        public GenieHelpTopic AddTopic(string title, params string[] points) {
            GenieHelpTopic topic = new GenieHelpTopic(title, points);
            ListBoxItem    item  = _topics.List.AddItem(title, topic);
            if (_topics.List.SelectedItem == null) _topics.List.SelectedItem = item;
            return topic;
        }
    }

    /// <summary>Made by GenieHelpPanel.AddTopic. What you add goes on the page in the order added.</summary>
    public sealed class GenieHelpTopic {
        private const double Gap = 10; // between the page's blocks

        internal readonly StackPanel Page = new StackPanel();
        private Grid                 _examples;

        internal GenieHelpTopic(string title, string[] points) {
            Page.Children.Add(new TextBlock {
                Text         = title,
                FontSize     = Genie.Theme.FontSizeTitle - 1,
                FontWeight   = FontWeights.SemiBold,
                Foreground   = Genie.Theme.TextPrimary,
                TextWrapping = TextWrapping.Wrap,
                Margin       = new Thickness(0, 0, 0, Gap),
            });
            foreach (string point in points) Page.Children.Add(Point(point));
        }

        /// <summary>A tinted box with a bulb: a heading ("Did you know?") over paragraphs.</summary>
        public void AddTip(string heading, params string[] paragraphs) {
            Brush fill, edge, ink;
            Genie.ControlUtils.ToneBrushes(Genie.ControlUtils.TagTone.Info, out fill, out edge, out ink);
            FrameworkElement bulb = Genie.ControlUtils.CreateBulbIcon(ink);
            bulb.Margin           = new Thickness(0, 0, 6, 0);
            StackPanel head       = new StackPanel { Orientation = Orientation.Horizontal };
            head.Children.Add(bulb);
            head.Children.Add(new TextBlock {
                Text              = heading,
                FontSize          = Genie.Theme.FontSizeLabel,
                FontWeight        = FontWeights.SemiBold,
                Foreground        = ink,
                VerticalAlignment = VerticalAlignment.Center,
            });
            StackPanel body = new StackPanel();
            body.Children.Add(head);
            foreach (string paragraph in paragraphs) {
                GenieParagraph p = Paragraph(paragraph, Genie.Theme.CodeOnTintBackground);
                p.Foreground     = ink;
                p.Margin         = new Thickness(0, 6, 0, 0);
                body.Children.Add(p);
            }
            Page.Children.Add(new Border {
                Child               = body,
                Background          = fill,
                BorderBrush         = edge,
                BorderThickness     = new Thickness(1),
                CornerRadius        = new CornerRadius(6),
                Padding             = new Thickness(12, 9, 12, 10),
                Margin              = new Thickness(0, 4, 0, Gap),
                SnapsToDevicePixels = true,
            });
        }

        /// <summary>A row of the topic's bordered table: code, and what it does.</summary>
        public void AddExample(string code, string text) {
            if (_examples == null) {
                _examples = new Grid();
                _examples.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
                _examples.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
                Page.Children.Add(new Border {
                    Child               = _examples,
                    BorderBrush         = Genie.Theme.Separator,
                    BorderThickness     = new Thickness(1),
                    CornerRadius        = new CornerRadius(Genie.Theme.BoxCornerRadius),
                    Margin              = new Thickness(0, 0, 0, Gap),
                    SnapsToDevicePixels = true,
                });
            }
            int row = _examples.RowDefinitions.Count;
            _examples.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            if (row > 0) {
                Border line = new Border {
                    BorderBrush     = Genie.Theme.Separator,
                    BorderThickness = new Thickness(0, 1, 0, 0),
                };
                Grid.SetRow(line, row);
                Grid.SetColumnSpan(line, 2);
                _examples.Children.Add(line);
            }
            GenieCode chip           = Genie.ControlUtils.CreateCode(code);
            chip.HorizontalAlignment = HorizontalAlignment.Stretch; // the column's width, so the chips line up
            chip.VerticalAlignment   = VerticalAlignment.Top;
            chip.Margin              = new Thickness(10, 6, 10, 5);
            Grid.SetRow(chip, row);
            _examples.Children.Add(chip);
            GenieParagraph words = Paragraph(text, Genie.Theme.CodeBackground);
            words.FontSize       = Genie.Theme.FontSizeLabel;
            words.Margin         = new Thickness(0, 5, 10, 5);
            Grid.SetRow(words, row);
            Grid.SetColumn(words, 1);
            _examples.Children.Add(words);
        }

        private static FrameworkElement Point(string text) {
            Grid g = new Grid { Margin = new Thickness(0, 0, 0, Gap) };
            g.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(14) });
            g.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            g.Children.Add(new System.Windows.Shapes.Ellipse {
                Width = 4, Height = 4, Fill = Genie.Theme.TextDisabled, HorizontalAlignment = HorizontalAlignment.Left,
                VerticalAlignment = VerticalAlignment.Top,
                Margin            = new Thickness(3, 7, 0, 0), // centred on the first line
            });
            GenieParagraph words = Paragraph(text, Genie.Theme.CodeBackground);
            Grid.SetColumn(words, 1);
            g.Children.Add(words);
            return g;
        }

        private static GenieParagraph Paragraph(string text, Brush codeFill) {
            string[] pieces = text.Split('`'); // odd pieces are inside backticks
            object[] parts  = new object[pieces.Length];
            for (int i = 0; i < pieces.Length; i++)
                parts[i] = i % 2 == 1 ? (object)Genie.ControlUtils.CreateCode(pieces[i], codeFill) : pieces[i];
            return Genie.ControlUtils.CreateParagraph(parts);
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreatePathText. Set Path to change it.</summary>
    // A Decorator around a TextBlock: TextBlock's own MeasureOverride is sealed.
    public sealed class GeniePathText : Decorator {
        private const string       Ellipsis = "\u2026";
        private readonly TextBlock _text;
        private string             _path = "";

        internal GeniePathText(string path, double fontSize) {
            _text = new TextBlock {
                FontFamily   = Genie.Theme.MonoFont,
                FontSize     = fontSize,
                Foreground   = Genie.Theme.TextPrimary,
                TextWrapping = TextWrapping.NoWrap,
            };
            Child             = _text;
            VerticalAlignment = VerticalAlignment.Center;
            Path              = path;
        }

        public string Path {
            get { return _path; }
            set {
                _path = value ?? "";
                InvalidateMeasure(); // refitted on the next measure
                Genie.ControlUtils.SetToolTip(this, _path.Length > 0 ? _path : null);
            }
        }

        // Fitted while measuring, against the width the parent offers. After layout, ActualWidth can't be used:
        // an element arranged narrower than it asked for keeps its asked-for width and is clipped instead.
        protected override Size MeasureOverride(Size constraint) {
            _text.Text = double.IsInfinity(constraint.Width) ? _path : Fit(constraint.Width);
            return base.MeasureOverride(constraint);
        }

        // TextTrimming only cuts the end. Keep whole trailing folders while they fit, else the tail characters.
        private string Fit(double room) {
            if (TextWidth(_path) <= room) return _path;
            int cut = _path.IndexOf('\\');
            while (cut >= 0 && TextWidth(Ellipsis + _path.Substring(cut)) > room) cut = _path.IndexOf('\\', cut + 1);
            if (cut >= 0) return Ellipsis + _path.Substring(cut);
            for (int start = 1; start < _path.Length; start++) {
                if (TextWidth(Ellipsis + _path.Substring(start)) <= room) return Ellipsis + _path.Substring(start);
            }
            return Ellipsis;
        }

        // In DIPs. pixelsPerDip only affects glyph rounding, so the scale at measure time is close enough.
        private double TextWidth(string text) {
            Typeface face  = new Typeface(_text.FontFamily, _text.FontStyle, _text.FontWeight, _text.FontStretch);
            double   scale = VisualTreeHelper.GetDpi(this).PixelsPerDip;
            return new FormattedText(text, System.Globalization.CultureInfo.CurrentUICulture, FlowDirection, face,
                                     _text.FontSize, _text.Foreground, scale)
                .WidthIncludingTrailingWhitespace;
        }
    }

    /// <summary>Made by Genie.ControlUtils.CreatePathBox. Text is always the whole path.</summary>
    // A TextBox can't show anything but its Text, so the shortened path is a TextBlock laid over the text area,
    // which hides while it's showing. Own template: the host's default one has no room for the overlay.
    public sealed class GeniePathBox : TextBox {
        private const string Gap       = "...";
        private const double TextInset = 2; // TextBox draws its text 2px in from the content host's edges

        [ThreadStatic]
        private static ControlTemplate _template;

        private ScrollViewer _host;
        private TextBlock    _shortened;

        internal GeniePathBox() {
            Template     = PathBoxTemplate();
            SizeChanged += delegate {
                Refit();
            };
            TextChanged += delegate {
                Refit();
            };
            IsKeyboardFocusedChanged += delegate {
                Refit();
            };
            Loaded += delegate {
                Refit(); // fonts and DPI are only known once in the window
            };
        }

        public override void OnApplyTemplate() {
            base.OnApplyTemplate();
            _host      = GetTemplateChild("PART_ContentHost") as ScrollViewer;
            _shortened = GetTemplateChild("shortened") as TextBlock;
            Refit();
        }

        // The whole path while editing or when it fits; otherwise the overlay, with the real text hidden under it.
        private void Refit() {
            if (_host == null || _shortened == null) return;
            double room  = _host.ActualWidth - 2 * TextInset;
            string shown = (IsKeyboardFocused || room <= 0) ? Text : Fit(Text, room);
            bool   cut   = shown != Text;

            _shortened.Text       = cut ? shown : "";
            _shortened.Visibility = cut ? Visibility.Visible : Visibility.Collapsed;
            _host.Opacity         = cut ? 0 : 1;
        }

        // "C:\...\Mods": the root, then whole trailing folders while they fit; else "..." and the tail characters.
        private string Fit(string path, double room) {
            if (TextWidth(path) <= room) return path;
            string root;
            try {
                root = System.IO.Path.GetPathRoot(path) ?? "";
            } catch (ArgumentException) {
                root = ""; // characters a path can't hold
            }
            string head = root.Length == 0 ? "" : root.TrimEnd('\\') + "\\"; // "C:\", or a share's "\\pc\share\"
            string rest = path.Substring(root.Length);
            for (int cut = rest.IndexOf('\\'); cut >= 0; cut = rest.IndexOf('\\', cut + 1)) {
                string candidate = head + Gap + rest.Substring(cut);
                if (TextWidth(candidate) <= room) return candidate;
            }
            for (int start = 1; start < path.Length; start++) {
                if (TextWidth(Gap + path.Substring(start)) <= room) return Gap + path.Substring(start);
            }
            return Gap;
        }

        private double TextWidth(string text) {
            Typeface face  = new Typeface(FontFamily, FontStyle, FontWeight, FontStretch);
            double   scale = VisualTreeHelper.GetDpi(this).PixelsPerDip;
            return new FormattedText(text, System.Globalization.CultureInfo.CurrentUICulture, FlowDirection, face,
                                     FontSize, Foreground, scale)
                .WidthIncludingTrailingWhitespace;
        }

        // Border > Grid > { content host, overlay }. Hover and focus darken the border, like the host's own boxes.
        private static ControlTemplate PathBoxTemplate() {
            if (_template != null) return _template;
            ControlTemplate t = new ControlTemplate(typeof(TextBox));

            FrameworkElementFactory bd = new FrameworkElementFactory(typeof(Border));
            bd.Name                    = "bd";
            bd.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));
            bd.SetValue(Border.BorderBrushProperty, new TemplateBindingExtension(Control.BorderBrushProperty));
            bd.SetValue(Border.BorderThicknessProperty, new TemplateBindingExtension(Control.BorderThicknessProperty));
            bd.SetValue(Border.PaddingProperty, new TemplateBindingExtension(Control.PaddingProperty));
            bd.SetValue(UIElement.SnapsToDevicePixelsProperty, true);

            FrameworkElementFactory grid = new FrameworkElementFactory(typeof(Grid));
            FrameworkElementFactory host = new FrameworkElementFactory(typeof(ScrollViewer));
            host.Name                    = "PART_ContentHost";
            host.SetValue(UIElement.FocusableProperty, false);
            host.SetValue(ScrollViewer.HorizontalScrollBarVisibilityProperty, ScrollBarVisibility.Hidden);
            host.SetValue(ScrollViewer.VerticalScrollBarVisibilityProperty, ScrollBarVisibility.Hidden);
            host.SetValue(FrameworkElement.VerticalAlignmentProperty,
                          new TemplateBindingExtension(Control.VerticalContentAlignmentProperty));
            grid.AppendChild(host);

            FrameworkElementFactory overlay = new FrameworkElementFactory(typeof(TextBlock));
            overlay.Name                    = "shortened";
            overlay.SetValue(TextBlock.ForegroundProperty, new TemplateBindingExtension(Control.ForegroundProperty));
            overlay.SetValue(FrameworkElement.MarginProperty, new Thickness(TextInset, 0, TextInset, 0));
            overlay.SetValue(FrameworkElement.VerticalAlignmentProperty, VerticalAlignment.Center);
            overlay.SetValue(UIElement.IsHitTestVisibleProperty, false); // clicks reach the box underneath
            overlay.SetValue(UIElement.VisibilityProperty, Visibility.Collapsed);
            grid.AppendChild(overlay);
            bd.AppendChild(grid);
            t.VisualTree = bd;

            Trigger over = new Trigger { Property = UIElement.IsMouseOverProperty, Value = true };
            over.Setters.Add(new Setter(Border.BorderBrushProperty, Genie.Theme.ButtonHoverBorder, "bd"));
            t.Triggers.Add(over);
            Trigger focus = new Trigger { Property = UIElement.IsKeyboardFocusedProperty, Value = true };
            focus.Setters.Add(new Setter(Border.BorderBrushProperty, Genie.Theme.LinkHover, "bd"));
            t.Triggers.Add(focus);
            Trigger dis = new Trigger { Property = UIElement.IsEnabledProperty, Value = false };
            dis.Setters.Add(new Setter(UIElement.OpacityProperty, 0.6, "bd"));
            t.Triggers.Add(dis);

            t.Seal();
            _template = t;
            return t;
        }
    }

