            /// <summary>
            /// Two panes side by side with a draggable divider, which remembers where the user left it: saved in your
            /// settings file under settingsKey, as the left pane's share of the width, so it keeps its proportion when
            /// the window resizes. defaultShare is that share until the user drags (0.25: a quarter).
            /// </summary>
            /// <param name="callerFile">Leave out: the compiler fills it in, and it identifies your addon.</param>
            public static Grid CreateSplitPanel(UIElement left, UIElement right, double defaultShare,
                                                double leftMinWidth = 0, double rightMinWidth = 0,
                                                string settingsKey = "SplitPosition",
                                                [CallerFilePath] string callerFile = null) {
                IniFile config = AddonRegistry.ConfigFor(AddonRegistry.AssemblyOf(callerFile));
                string  saved  = (config != null) ? config.Get(ConfigUtils.DefaultSection, settingsKey) : null;
                if (config != null) config.Manage(ConfigUtils.DefaultSection, settingsKey); // kept by settings restores
                double  share;
                if (saved == null || !double.TryParse(saved, System.Globalization.NumberStyles.Float,
                                                      System.Globalization.CultureInfo.InvariantCulture, out share))
                    share = defaultShare;
                share = Math.Max(0.05, Math.Min(0.95, share)); // never collapse a pane out of reach

                ColumnDefinition leftColumn =
                    new ColumnDefinition { Width = new GridLength(share, GridUnitType.Star), MinWidth = leftMinWidth };
                ColumnDefinition rightColumn = new ColumnDefinition {
                    Width    = new GridLength(1 - share, GridUnitType.Star),
                    MinWidth = rightMinWidth,
                };
                GridSplitter splitter = new GridSplitter {
                    Width               = 6,
                    HorizontalAlignment = HorizontalAlignment.Stretch,
                    VerticalAlignment   = VerticalAlignment.Stretch,
                    Background          = Theme.SplitterBackground,
                    ResizeBehavior      = GridResizeBehavior.PreviousAndNext,
                };
                splitter.DragCompleted += delegate {
                    double total = leftColumn.ActualWidth + rightColumn.ActualWidth;
                    if (total <= 0 || config == null) return;
                    double dragged = Math.Round(leftColumn.ActualWidth / total, 3);
                    config.Set(ConfigUtils.DefaultSection, settingsKey,
                               dragged.ToString(System.Globalization.CultureInfo.InvariantCulture));
                };

                Grid grid = new Grid();
                grid.ColumnDefinitions.Add(leftColumn);
                grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
                grid.ColumnDefinitions.Add(rightColumn);
                Grid.SetColumn(left, 0);
                Grid.SetColumn(splitter, 1);
                Grid.SetColumn(right, 2);
                grid.Children.Add(left);
                grid.Children.Add(splitter);
                grid.Children.Add(right);
                return grid;
            }

            /// <summary>
            /// A grey bar standing in for a line of content that can't be shown, so a blocked pane keeps its shape.
            /// width NaN: stretches. Round at the ends up to the box radius, so an 8 by 8 bar is a dot. Put bars on
            /// CreatePlaceholderStripes, under a CreateVeil. Example: Dependency Viewer's blocked view.
            /// </summary>
            public static Border CreatePlaceholderBar(double width, double height = 8) {
                return new Border {
                    Width               = width,
                    Height              = height,
                    CornerRadius        = new CornerRadius(Math.Min(height / 2, Theme.BoxCornerRadius)),
                    Background          = Theme.PlaceholderFill,
                    HorizontalAlignment = double.IsNaN(width) ? HorizontalAlignment.Stretch : HorizontalAlignment.Left,
                    VerticalAlignment   = VerticalAlignment.Center,
                };
            }

            /// <summary>
            /// Faint diagonal stripes, a pane's background while its content can't be shown: unavailable, not
            /// loading. Shared and frozen.
            /// </summary>
            public static Brush CreatePlaceholderStripes() {
                if (_stripes != null) return _stripes;
                // A hard-stopped gradient, repeated: 6px stripe, 6px gap, at 135 degrees as the mockup's.
                Color          ink = ((SolidColorBrush)Theme.PlaceholderStripe).Color;
                Color          off = Color.FromArgb(0, ink.R, ink.G, ink.B);
                double         run = 12 / Math.Sqrt(2); // the period across the stripes, along a 45 degree axis
                LinearGradientBrush b = new LinearGradientBrush {
                    StartPoint    = new Point(0, 0),
                    EndPoint      = new Point(run, run),
                    MappingMode   = BrushMappingMode.Absolute,
                    SpreadMethod  = GradientSpreadMethod.Repeat,
                };
                b.GradientStops.Add(new GradientStop(ink, 0));
                b.GradientStops.Add(new GradientStop(ink, 0.5));
                b.GradientStops.Add(new GradientStop(off, 0.5));
                b.GradientStops.Add(new GradientStop(off, 1));
                b.Freeze();
                _stripes = b;
                return b;
            }

            [ThreadStatic]
            private static Brush _stripes;

            /// <summary>
            /// A white veil over what it covers, its content centred (CreateCard): for a whole view that can't be
            /// used until something's done. Place it over the panes in the same grid cell. Clicks on the veil stop
            /// there; what's under it stays drawn but can't be reached. Collapse it to lift it.
